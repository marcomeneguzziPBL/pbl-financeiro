function ppContratos(id,p){
  var ctx=contratoCtx(p);
  var mods=CONTRATO_MODELOS().filter(function(m){return m.grupo!=='Cessão de Crédito';});
  var grupos={};
  mods.forEach(function(m){ (grupos[m.grupo]=grupos[m.grupo]||[]).push(m); });
  var lista=Object.keys(grupos).map(function(g){
    return '<div style="font-size:12px;font-weight:700;color:var(--v);margin:12px 0 4px">'+esc(g)+'</div>'+
      grupos[g].map(function(m){
        return '<label style="display:flex;align-items:center;gap:8px;padding:6px 8px;border:.5px solid var(--bd);border-radius:6px;margin-bottom:5px;cursor:pointer;font-size:13px"><input type="checkbox" class="cx-mod" value="'+m.id+'"> '+esc(m.nome)+'</label>';
      }).join('');
  }).join('');
  var resumo='<div style="font-size:12px;color:var(--mt);line-height:1.6">Serão puxados: <b style="color:var(--tx)">Autor</b> '+esc(ctx.AUTOR||'—')+(ctx.CED_CPF?(' (CPF '+esc(ctx.CED_CPF)+')'):' <span style="color:var(--red)">(sem cadastro em Partes)</span>')+' · <b style="color:var(--tx)">Advogado</b> '+esc(ctx.ADV_NOME||'—')+' · <b style="color:var(--tx)">Processo</b> '+esc(ctx.NPROC||'—')+' · <b style="color:var(--tx)">Valor</b> '+esc(ctx.VALOR||'—')+'</div>';
  var ck='display:flex;align-items:center;gap:7px;font-size:13px';
  var matRadio='<div style="display:flex;gap:16px;flex-wrap:wrap;margin:6px 0 10px">'+
    '<label style="'+ck+'"><input type="radio" name="cx-mat" value="civel" checked onclick="cxMat(\'civel\')"> Cível / Comum (cessão)</label>'+
    '<label style="'+ck+'"><input type="radio" name="cx-mat" value="trab" onclick="cxMat(\'trab\')"> Trabalhista</label>'+
    '<label style="'+ck+'"><input type="radio" name="cx-mat" value="prec" onclick="cxMat(\'prec\')"> Precatório / RPV (Escritura)</label>'+
  '</div>';
  var panelObj='<div id="cx-obj-panel">'+
    '<div style="margin:4px 0 5px;font-size:12px;color:var(--mt);font-weight:600">Objeto — o que está sendo comprado:</div>'+
    '<div style="display:flex;gap:16px;flex-wrap:wrap">'+
      '<label style="'+ck+'"><input type="checkbox" class="cx-obj" value="principal" onchange="cxObjHint()"> Crédito principal</label>'+
      '<label style="'+ck+'"><input type="checkbox" class="cx-obj" value="contratuais" checked onchange="cxObjHint()"> Honorários contratuais</label>'+
      '<label style="'+ck+'"><input type="checkbox" class="cx-obj" value="sucumbenciais" onchange="cxObjHint()"> Honorários sucumbenciais</label>'+
    '</div>'+
    '<div style="margin:11px 0 5px;font-size:12px;color:var(--mt);font-weight:600">Abrangência:</div>'+
    '<div style="display:flex;gap:16px;flex-wrap:wrap">'+
      '<label style="'+ck+'"><input type="radio" name="cx-abr" value="todo" checked> Crédito todo</label>'+
      '<label style="'+ck+'"><input type="radio" name="cx-abr" value="morais"> Somente danos morais</label>'+
      '<label style="'+ck+'"><input type="radio" name="cx-abr" value="materiais"> Somente danos materiais</label>'+
    '</div>'+
  '</div>';
  var panelCivel='<div class="cx-mat-panel" id="cx-mat-civel">'+
    '<div style="font-size:11px;color:var(--mt);margin-top:8px">Com crédito principal → 2 cedentes (autor + advogado). Só honorários → 1 cedente (advogado).</div>'+
  '</div>';
  var panelTrab='<div class="cx-mat-panel" id="cx-mat-trab" style="display:none">'+
    '<div style="font-size:11px;color:var(--mt);margin-top:8px">Modelo trabalhista: <b id="cx-trab-hint" style="color:var(--v)">—</b> (definido pelo objeto acima). Inclui a ressalva de FGTS quando há crédito principal, cláusula de liquidez e Vara do Trabalho/TRT. Ajuste PIX e nº do cumprimento no documento.</div>'+
  '</div>';
  var panelPrec='<div class="cx-mat-panel" id="cx-mat-prec" style="display:none">'+
    '<div style="font-size:12px;color:var(--mt);line-height:1.5">Gera a <b>Escritura Pública de Cessão de Crédito em Precatório</b> (para casos em que o estado exige escritura). Os dados do cartório, nº do precatório e ofício requisitório você completa no documento (campos destacados).</div>'+
  '</div>';
  return partesDatalistHTML()+'<div style="font-size:12px;color:var(--mt);margin-bottom:10px">Escolha a <b>matéria</b> do crédito (muda o modelo do contrato) e, se quiser, marque documentos extras. O sistema preenche nome, CPF, endereço, processo, réu e valor; os campos <span style="background:var(--dl);color:var(--d);padding:0 4px;border-radius:3px">destacados</span> você completa.</div>'+
    '<div style="border:.5px solid var(--bd);border-radius:8px;padding:10px 12px;margin-bottom:12px;background:var(--row-alt)">'+resumo+'</div>'+
    '<div style="border:.5px solid var(--bd);border-radius:8px;padding:12px;margin-bottom:12px">'+
      '<label style="'+ck+';font-weight:700;color:var(--v)"><input type="checkbox" id="cx-main-on" checked> Gerar contrato principal</label>'+
      '<div style="margin:11px 0 5px;font-size:12px;color:var(--mt);font-weight:600">Matéria do crédito:</div>'+
      matRadio+panelObj+panelCivel+panelTrab+panelPrec+
    '</div>'+
    '<div style="border:.5px solid var(--bd);border-radius:8px;padding:12px;margin-bottom:12px">'+
      '<label style="'+ck+';font-weight:700;color:var(--v)"><input type="checkbox" id="cx-anu-on"> Há anuente (assina consentindo)</label>'+
      '<div style="margin-top:10px;display:flex;gap:6px;align-items:flex-end;flex-wrap:wrap">'+
        '<div class="fg" style="flex:1;min-width:220px"><label>Nome do anuente</label><input id="cx-anu-nome" list="dl-partes" placeholder="Nome (busca no cadastro de Partes)"/></div>'+
        '<button type="button" class="btn" title="Cadastrar dados do anuente" onclick="abrirParteDoCampo(\'cx-anu-nome\')">＋ cadastrar</button>'+
      '</div>'+
      '<div style="font-size:11px;color:var(--mt);margin-top:6px">Marque e informe o nome. Se não estiver cadastrado, clique em <b>＋ cadastrar</b>. O contrato puxa nome, CPF, OAB e endereço do anuente e inclui a cláusula de anuência.</div>'+
    '</div>'+
    '<div style="font-size:12px;font-weight:700;color:var(--v);margin:6px 0 2px">Documentos extras</div>'+
    lista+
    '<div style="margin-top:14px;display:flex;gap:8px"><button class="btn bp" onclick="gerarContratos(\''+id+'\')">📄 Gerar documento(s)</button></div>';
}
function cxMat(m){ window._cxMateria=m; ['civel','trab','prec'].forEach(function(k){ var el=document.getElementById('cx-mat-'+k); if(el) el.style.display=(k===m)?'':'none'; });
  var op=document.getElementById('cx-obj-panel'); if(op) op.style.display=(m==='prec')?'none':'';
  cxObjHint();
}
// Objeto/abrangência selecionados (compartilhado por cível e trabalhista)
function cxObjArr(){ return [].slice.call(document.querySelectorAll('.cx-obj')).filter(function(c){return c.checked;}).map(function(c){return c.value;}); }
function cxAbr(){ var el=document.querySelector('input[name=cx-abr]:checked'); return el?el.value:'todo'; }
function cxTrabTipo(objArr){ var p=objArr.indexOf('principal')>=0, h=objArr.indexOf('contratuais')>=0||objArr.indexOf('sucumbenciais')>=0; return p?(h?'triplo':'autor'):'adv'; }
function cxObjHint(){ var el=document.getElementById('cx-trab-hint'); if(!el) return; var t=cxTrabTipo(cxObjArr());
  el.textContent=(t==='triplo')?'Triplo (Autor + Advogado)':(t==='adv')?'Advogado (honorários)':'Autor (crédito principal)'; }
function slugDoc(s){ return String(s||'doc').normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^A-Za-z0-9]+/g,'_').replace(/^_+|_+$/g,'').slice(0,40)||'doc'; }
function gerarContratos(id){
  var p=(S.processos||[]).find(function(x){return x.id===id;}); if(!p)return;
  var ctx=contratoCtx(p);
  var docs=[];
  // Anuente (opcional): puxa dados e injeta a cláusula de anuência antes das testemunhas
  var anuOn=document.getElementById('cx-anu-on');
  var anuNome=(document.getElementById('cx-anu-nome')?document.getElementById('cx-anu-nome').value:'').trim();
  var temAnu=!!(anuOn&&anuOn.checked&&anuNome);
  if(temAnu){ ctx=Object.assign({}, ctx, contratoAnuenteCtx(anuNome)); }
  function comAnu(corpo){ return temAnu ? corpo.split(CX_TESTE).join(anuenteBloco()+CX_TESTE) : corpo; }
  var mainOn=document.getElementById('cx-main-on');
  if(mainOn&&mainOn.checked){
    var mat=window._cxMateria||'civel';
    if(mat==='trab'){
      var objT=cxObjArr();
      if(!objT.length){ showToast('Marque o objeto da cessão (principal, contratuais e/ou sucumbenciais).'); return; }
      var abrT=cxAbr(), tipo=cxTrabTipo(objT);
      var titT='CONTRATO DE CESSÃO DE CRÉDITO DE AÇÃO JUDICIAL';
      docs.push({ nome:'Contrato_Trabalhista_'+tipo, titulo:titT, sub:'Trabalhista — '+cessaoTituloObjeto(objT,abrT), html:fillContrato(comAnu(montarTrabCorpo(objT,abrT)),ctx) });
    } else if(mat==='prec'){
      docs.push({ nome:'Escritura_Precatorio', titulo:'ESCRITURA PÚBLICA DE CESSÃO DE CRÉDITO EM PRECATÓRIO JUDICIÁRIO', sub:'', html:fillContrato(comAnu(montarEscrituraCorpo()),ctx) });
    } else {
      var objArr=cxObjArr();
      if(!objArr.length){ showToast('Marque o objeto da cessão (principal, contratuais e/ou sucumbenciais).'); return; }
      var abr=cxAbr();
      docs.push({ nome:'Contrato_Cessao', titulo:'CONTRATO DE CESSÃO DE CRÉDITO DE AÇÃO JUDICIAL', sub:cessaoTituloObjeto(objArr,abr), html:fillContrato(comAnu(montarCessaoCorpo(objArr,abr)),ctx) });
    }
  }
  var mods=CONTRATO_MODELOS();
  [].slice.call(document.querySelectorAll('.cx-mod')).filter(function(c){return c.checked;}).forEach(function(c){
    var m=mods.find(function(x){return x.id===c.value;});
    if(m) docs.push({ nome:slugDoc(m.nome), titulo:m.titulo, sub:'', html:fillContrato(m.corpo,ctx) });
  });
  if(!docs.length){ showToast('Marque o contrato principal e/ou documentos extras.'); return; }
  abrirEditorContratos(p.numero||'', docs);
}
var _cxDocs=[], _cxNumero='';
function abrirEditorContratos(numero, docs){
  _cxDocs=docs||[]; _cxNumero=String(numero||'');
  if(!document.getElementById('cx-style')){
    var st=document.createElement('style'); st.id='cx-style';
    st.textContent='.cx-ov{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:950;display:flex;flex-direction:column}'+
      '.cx-bar{background:var(--card);border-bottom:1px solid var(--bd);padding:10px 16px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}'+
      '.cx-bar .t{font-weight:700;color:var(--v)}'+
      '.cx-scroll{flex:1;overflow:auto;padding:24px;display:flex;flex-direction:column;align-items:center;gap:28px;background:#5b6b67}'+
      '.cx-docwrap{width:210mm;max-width:96%}'+
      '.cx-docbar{background:var(--card);border:1px solid var(--bd);border-bottom:none;border-radius:8px 8px 0 0;padding:8px 12px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}'+
      '.cx-docbar .t{font-weight:700;color:var(--v);font-size:13px}'+
      '.cx-docbar .btn{padding:5px 11px;font-size:12px}'+
      '.cx-paper{background:#fff;min-height:120mm;padding:22mm 20mm;box-shadow:0 4px 20px rgba(0,0,0,.3);color:#111;font-family:"Times New Roman",Georgia,serif;font-size:12pt;line-height:1.5;text-align:justify;border-radius:0 0 4px 4px}'+
      '.cx-paper .cx-tit{text-align:center;font-size:13pt;font-weight:700;text-transform:uppercase;margin:0 0 18px}'+
      '.cx-paper p{margin:0 0 10px}'+
      '.cx-todo{background:#FDF6E3;color:#8a6508;border-radius:3px;padding:0 2px}';
    document.head.appendChild(st);
  }
  var blocos=_cxDocs.map(function(d,i){
    var subhtml=d.sub?'<p style="text-align:center;margin-top:-10px;font-size:11pt"><i>'+esc(d.sub)+'</i></p>':'';
    return '<div class="cx-docwrap">'+
      '<div class="cx-docbar"><span class="t">'+(i+1)+'. '+esc(d.titulo)+'</span><span style="flex:1"></span>'+
        '<button class="btn" onclick="imprimirContratoUn('+i+')">🖨️ Imprimir / PDF</button>'+
        '<button class="btn bp" onclick="baixarContratoUn('+i+')">⬇ Baixar Word</button>'+
      '</div>'+
      '<div class="cx-paper" id="cx-paper-'+i+'" contenteditable="true"><h2 class="cx-tit">'+esc(d.titulo)+'</h2>'+subhtml+d.html+'</div>'+
    '</div>';
  }).join('');
  var ov=document.createElement('div'); ov.className='cx-ov'; ov.id='cx-ov';
  ov.innerHTML='<div class="cx-bar"><span class="t">📄 Documentos — Processo '+esc(_cxNumero)+' <span style="font-weight:400;color:var(--mt)">('+_cxDocs.length+' documento(s) separado(s))</span></span><span style="flex:1"></span>'+
    '<button class="btn" onclick="imprimirTodosContratos()">🖨️ Imprimir todos</button>'+
    '<button class="btn" onclick="var o=document.getElementById(\'cx-ov\');if(o)o.remove()">Fechar</button></div>'+
    '<div class="cx-scroll">'+blocos+'</div>';
  document.body.appendChild(ov);
}
function _cxPrintHtml(inner){
  return '<!doctype html><html><head><meta charset="utf-8"><title>Documento</title><style>body{font-family:"Times New Roman",Georgia,serif;font-size:12pt;line-height:1.5;text-align:justify;margin:22mm 20mm;color:#111}.cx-tit{text-align:center;font-weight:700;text-transform:uppercase;font-size:13pt;margin:0 0 18px}p{margin:0 0 10px}.cx-todo{background:none}</style></head><body>'+inner+'</body></html>';
}
function imprimirContratoUn(i){
  var paper=document.getElementById('cx-paper-'+i); if(!paper)return;
  var w=window.open('','_blank'); if(!w){ showToast('Permita pop-ups para imprimir.'); return; }
  w.document.write(_cxPrintHtml(paper.innerHTML)); w.document.close();
  setTimeout(function(){ try{w.focus();w.print();}catch(e){} },300);
}
function imprimirTodosContratos(){
  var all=_cxDocs.map(function(d,i){ var p=document.getElementById('cx-paper-'+i); return '<div style="page-break-after:always">'+(p?p.innerHTML:'')+'</div>'; }).join('');
  var w=window.open('','_blank'); if(!w){ showToast('Permita pop-ups para imprimir.'); return; }
  w.document.write(_cxPrintHtml(all)); w.document.close();
  setTimeout(function(){ try{w.focus();w.print();}catch(e){} },300);
}
function baixarContratoUn(i){
  var paper=document.getElementById('cx-paper-'+i); if(!paper)return;
  var d=_cxDocs[i]||{};
  var head='<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40"><head><meta charset="utf-8"><title>'+esc(d.titulo||'Documento')+'</title>'+
    '<style>@page{margin:2.2cm 2cm}body{font-family:"Times New Roman",serif;font-size:12pt;line-height:1.5;text-align:justify}.cx-tit{text-align:center;font-weight:700;text-transform:uppercase;font-size:13pt;margin:0 0 18px}p{margin:0 0 10px}.cx-todo{background:none}</style></head><body>';
  var content='﻿'+head+paper.innerHTML+'</body></html>';
  var blob=new Blob([content],{type:'application/msword'});
  var url=URL.createObjectURL(blob); var a=document.createElement('a');
  var fn=(d.nome||'documento')+(_cxNumero?('_'+_cxNumero.replace(/[^0-9A-Za-z._-]/g,'')):'')+'.doc';
  a.href=url; a.download=fn; document.body.appendChild(a); a.click();
  setTimeout(function(){ document.body.removeChild(a); URL.revokeObjectURL(url); },500);
}
function escHtml(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function stripRich(t){ return decodeEntities(String(t==null?'':t).replace(/<br\s*\/?>/gi,' / ').replace(/<[^>]+>/g,'')).replace(/ /g,' '); }
// Decodifica entidades HTML (&nbsp; &amp; etc.). Roda em laço para tratar dados ja duplo-escapados (&amp;nbsp;).
function decodeEntities(str){ str=String(str==null?'':str); if(str.indexOf('&')<0)return str; var t=document.createElement('textarea'); for(var i=0;i<3;i++){ t.innerHTML=str; var v=t.value; if(v===str)break; str=v; } return str; }
function richClean(html){
  var s=String(html==null?'':html);
  if(s.indexOf('<')<0){ return escHtml(decodeEntities(s)).replace(/\r?\n/g,'<br>'); }
  var tmp=document.createElement('div'); tmp.innerHTML=s;
  function walk(node){
    var out=''; var kids=node.childNodes;
    for(var i=0;i<kids.length;i++){ var n=kids[i];
      if(n.nodeType===3){ out+=escHtml(decodeEntities(n.nodeValue)).replace(/\r?\n/g,'<br>'); }
      else if(n.nodeType===1){ var tag=n.tagName.toLowerCase();
        if(tag==='br'){ out+='<br>'; }
        else if(tag==='b'||tag==='strong'){ out+='<b>'+walk(n)+'</b>'; }
        else if(tag==='i'||tag==='em'){ out+='<i>'+walk(n)+'</i>'; }
        else if(tag==='u'){ out+='<u>'+walk(n)+'</u>'; }
        else if(tag==='div'||tag==='p'){ if(out&&!/<br>$/.test(out))out+='<br>'; out+=walk(n); }
        else { out+=walk(n); }
      }
    }
    return out;
  }
  return walk(tmp).replace(/(?:<br>\s*){3,}/g,'<br><br>').replace(/^(?:<br>)+/,'').replace(/(?:<br>)+$/,'');
}
// Exclusão LÓGICA: a timeline é log de auditoria, então o registro não sai do banco — ele é
// marcado como excluído (com autor e data) e some da tela. A regra do Firestore só aceita a
// mudança desses três campos, e só de admin; apagar de verdade é proibido para todos.
async function ppDelAndam(procId, entryId){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode excluir movimentações.'); return; }
  if(!entryId){ showToast('Movimentação sem identificador — não é possível excluir.'); return; }
  if(!confirm('Excluir esta movimentação da timeline? Ela some da tela, mas fica registrada no histórico de auditoria.')) return;
  try{ await fb.updateDoc(fb.doc(fb.db,'processos',procId,'timeline',entryId),
        { excluida:true, excluidaPor:(currentUser&&currentUser.id)||'', excluidaEm:fb.serverTimestamp() }); }
  catch(e){ showToast('Erro ao excluir: '+(e.code||e.message)); return; }
  showToast('Movimentação excluída.');
  openProcPanel(procId);
}
function ppTimeline(id,tl){
  var m=ppMon(id);
  tl=(tl||[]).filter(function(e){return !e.excluida;}); // excluída logicamente: fica no banco, sai da tela
  if(!document.getElementById('tl-rich-style')){ var _st=document.createElement('style'); _st.id='tl-rich-style'; _st.textContent='#pp-an-txt:empty:before{content:attr(data-ph);color:var(--mt)} #pp-an-txt:focus{outline:none;border-color:var(--v)!important;box-shadow:0 0 0 2px var(--vl)} .tl-txt{white-space:pre-wrap}'; document.head.appendChild(_st); }
  var desdobrOpts=(m.desdobr||[]).map(function(d){return '<option value="'+esc(d.numero)+'">Desdobr.: '+esc(d.numero)+(d.tipo?(' ('+esc(d.tipo)+')'):'')+'</option>';}).join('');
  var logRows=tl.map(function(e){
    var tag=(e.tipo&&e.tipo!=='andamento')?(' <span class="badge" style="background:var(--vl);color:var(--v)">'+esc(e.tipo)+'</span>'):'';
    var refb=e.ref?(' <span class="badge" style="background:var(--bluel);color:var(--blue)">🔗 '+esc(e.ref)+'</span>'):' <span class="badge" style="background:var(--greenl);color:var(--green)">Principal</span>';
    var barra=e.ref?'border-left:3px solid var(--blue)':'border-left:3px solid var(--green)';
    var del=(isFullAccess(currentUser)&&e.id)?'<button class="xbtn" title="Excluir movimentação (admin)" style="margin-left:auto" onclick="ppDelAndam(\''+id+'\',\''+esc(e.id)+'\')">×</button>':'';
    return'<div class="tl-entry" style="'+barra+';padding-left:8px"><div class="when" style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">'+fmtTs(e.ts)+' · <b>'+esc(e.autor||'—')+'</b>'+refb+tag+del+'</div><div class="tl-txt">'+richClean(e.texto||'')+'</div></div>';}).join('')||'<div style="color:var(--mt);font-size:12px">Sem registros.</div>';
  return '<div style="font-size:11px;color:var(--mt);margin-bottom:8px">Resumo processual (log de auditoria — apenas o <b>administrador</b> pode excluir movimentações). Marque se o andamento é do <b>Principal</b> ou de um <b>Desdobramento</b> — cada entrada fica identificada (verde = principal, azul = desdobramento).</div>'+
    '<div style="display:flex;gap:6px;margin-bottom:5px">'+
      '<button type="button" class="btn" style="font-size:13px;font-weight:800;padding:3px 11px" title="Negrito (Ctrl+B)" onmousedown="event.preventDefault();document.execCommand(\'bold\')">B</button>'+
      '<button type="button" class="btn" style="font-size:13px;font-style:italic;padding:3px 11px" title="Itálico (Ctrl+I)" onmousedown="event.preventDefault();document.execCommand(\'italic\')"><span style="font-family:serif">I</span></button>'+
      '<span style="font-size:11px;color:var(--mt);align-self:center">Enter = nova linha · selecione o texto e use B / I</span>'+
    '</div>'+
    '<div id="pp-an-txt" contenteditable="true" data-ph="Descreva a movimentação / andamento..." style="min-height:54px;width:100%;padding:8px;border:.5px solid var(--bd);border-radius:8px;font-size:14px;line-height:1.45;background:#fff;color:var(--tx);overflow:auto"></div>'+
    '<div style="display:flex;gap:8px;align-items:flex-end;margin:6px 0 12px;flex-wrap:wrap"><div class="fg" style="min-width:220px"><label>Referente a</label><select id="pp-an-ref"><option value="">Principal</option>'+desdobrOpts+'</select></div><div style="flex:1"></div><button class="btn bp" id="pp-an-btn" onclick="ppAddAndam(\''+id+'\')">Registrar andamento</button></div>'+
    '<div style="max-height:340px;overflow:auto">'+logRows+'</div>';
}
/* ===== Documentos do processo (Firebase Storage — até 50 MB) ===== */
async function procDocsLoad(id){
  try{ var qs=await fb.getDocs(fb.collection(fb.db,'processos',id,'docs')); var arr=[]; qs.forEach(function(d){arr.push(Object.assign({id:d.id},d.data()));}); arr.sort(function(a,b){return String(b.ts).localeCompare(String(a.ts));}); return arr; }
  catch(e){ return []; }
}
function fmtDocTam(n){ n=Number(n||0); if(n<1024)return n+' B'; if(n<1048576)return (n/1024).toFixed(1)+' KB'; return (n/1048576).toFixed(2)+' MB'; }
var _DOC_MAX = 50*1024*1024; // 50 MB
function ppDocumentos(id,p,docs){
  var podeExcluir=isFullAccess(currentUser); // excluir documento é admin-only (como todo delete no app)
  var rows=(docs||[]).map(function(d){
    var del=podeExcluir?(' <button class="xbtn" onclick="excluirDoc(\''+id+'\',\''+d.id+'\')">×</button>'):'';
    return '<tr><td style="font-size:12px">'+esc(d.nome||'—')+'</td><td style="font-size:11px;color:var(--mt);white-space:nowrap">'+fmtDocTam(d.tamanho)+'</td><td style="font-size:11px;color:var(--mt);white-space:nowrap">'+fmtTs(d.ts)+(d.autor?(' · '+esc(d.autor)):'')+'</td><td class="r" style="white-space:nowrap"><button class="btn" style="font-size:11px;padding:4px 9px" onclick="baixarDoc(\''+id+'\',\''+d.id+'\')">⬇ Baixar</button>'+del+'</td></tr>';
  }).join('')||'<tr><td colspan="4" style="color:var(--mt);text-align:center">Nenhum documento anexado.</td></tr>';
  var upl = canWriteProcessos(currentUser)
    ? '<div style="border:1px dashed var(--bd);border-radius:8px;padding:14px;text-align:center;margin-bottom:12px;background:var(--row-alt)">'+
        '<input type="file" id="pp-doc-file" multiple style="display:none" onchange="ppUploadDocs(\''+id+'\')"/>'+
        '<button class="btn bp" id="pp-doc-btn" onclick="document.getElementById(\'pp-doc-file\').click()">📎 Importar arquivo(s)</button>'+
        '<div id="pp-doc-prog" style="font-size:12px;color:var(--v);margin-top:8px"></div>'+
        '<div style="font-size:11px;color:var(--mt);margin-top:6px">PDF, imagens, Word, planilhas... até 50 MB por arquivo. Vários de uma vez.</div>'+
      '</div>'
    : '<div style="font-size:12px;color:var(--mt);margin-bottom:10px">Somente leitura (sem permissão para importar).</div>';
  return upl+'<div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr><th>Documento</th><th>Tamanho</th><th>Enviado</th><th></th></tr></thead><tbody>'+rows+'</tbody></table></div>';
}
function _docProg(msg){ var el=document.getElementById('pp-doc-prog'); if(el) el.textContent=msg||''; }
async function ppUploadDocs(id){
  if(!canWriteProcessos(currentUser)){showToast('Sem permissão para importar.');return;}
  var inp=document.getElementById('pp-doc-file'); if(!inp||!inp.files||!inp.files.length)return;
  var files=[].slice.call(inp.files);
  var grandes=files.filter(function(f){return f.size>_DOC_MAX;});
  if(grandes.length){ showToast(grandes.length+' arquivo(s) acima de 50 MB — não serão enviados.'); }
  files=files.filter(function(f){return f.size<=_DOC_MAX;});
  if(!files.length){ inp.value=''; return; }
  var btn=document.getElementById('pp-doc-btn'); if(btn){btn.disabled=true;}
  var okc=0;
  for(var i=0;i<files.length;i++){
    var f=files[i];
    try{
      _docProg('Enviando "'+f.name+'" ('+(i+1)+'/'+files.length+')… aguarde');
      var docId=fb.doc(fb.collection(fb.db,'processos',id,'docs')).id;
      var path='processos/'+id+'/docs/'+docId+'-'+f.name.replace(/[^\w.\-]+/g,'_');
      // uploadBytes (simples) — mesmo método da IA, que funciona. O retomável exigiria CORS no bucket.
      var snap=await fb.uploadBytes(fb.storageRef(fb.storage,path), f, {contentType:f.type||'application/octet-stream'});
      var url=await fb.getDownloadURL(snap.ref);
      await fb.setDoc(fb.doc(fb.db,'processos',id,'docs',docId),{ nome:f.name, tipo:f.type||'', tamanho:f.size||0, storagePath:path, downloadURL:url, ts:new Date().toISOString(), autor:(currentUser&&currentUser.name)||'—' });
      try{ await procTimelineAdd(id,'documento','Documento anexado: '+f.name); }catch(_e){}
      okc++;
    }catch(e){ console.error('upload doc',e); showToast('Falha em "'+f.name+'": '+(e.code||e.message)); }
  }
  _docProg(''); inp.value='';
  if(okc)showToast(okc+' documento(s) importado(s).');
  openProcPanel(id);
}
async function baixarDoc(id,docId){
  try{
    var s=await fb.getDoc(fb.doc(fb.db,'processos',id,'docs',docId)); var d=s.exists()?s.data():null;
    if(!d){showToast('Documento não encontrado.');return;}
    var url=d.downloadURL || (d.storagePath?await fb.getDownloadURL(fb.storageRef(fb.storage,d.storagePath)):null);
    if(!url){showToast('Arquivo indisponível.');return;}
    var a=document.createElement('a'); a.href=url; a.target='_blank'; a.rel='noopener'; a.download=d.nome||'documento'; document.body.appendChild(a); a.click();
    setTimeout(function(){document.body.removeChild(a);},400);
  }catch(e){ showToast('Erro ao baixar: '+(e.code||e.message)); }
}
async function excluirDoc(id,docId){
  if(!isFullAccess(currentUser)){showToast('Apenas o administrador pode excluir.');return;}
  if(!confirm('Excluir este documento?'))return;
  try{
    var s=await fb.getDoc(fb.doc(fb.db,'processos',id,'docs',docId)); var d=s.exists()?s.data():null;
    if(d&&d.storagePath){ try{ await fb.deleteObject(fb.storageRef(fb.storage,d.storagePath)); }catch(_e){ console.warn('storage delete falhou (segue):',_e&&(_e.code||_e.message)); } }
    await fb.deleteDoc(fb.doc(fb.db,'processos',id,'docs',docId));
  }catch(e){ showToast('Erro: '+(e.code||e.message)); return; }
  openProcPanel(id);
}
async function openProcPanel(id){
  var p=S.processos.find(function(x){return x.id===id;});if(!p)return;
  if(id!==_ppCur){_ppTab='dados';_ppCur=id;}
  await procMonLoad(id);
  var tl=await procTimelineLoad(id);
  var docsList=(_ppTab==='documentos')?await procDocsLoad(id):[];
  var f=procFin(p);
  var adv=(S.lawyers.find(function(l){return l.id===p.advogadoId;})||{name:p.advogadoId||'—'}).name;
  var m=ppMon(id);
  var head='<button class="modal-close" onclick="closeModal();_ppCur=\'\'">×</button>'+
    '<div class="modal-title" style="padding-right:30px">'+esc(p.numero)+'</div>'+
    '<div style="font-size:12px;color:var(--mt);margin-bottom:8px">'+ppFaseBadge(p.status)+' · <b>'+esc(adv)+'</b></div>'+
    '<div style="display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:var(--mt)">'+
      '<span>Cliente: <b style="color:var(--tx)">'+esc(p.cliente||'—')+'</b></span>'+
      '<span>Réu: <b style="color:var(--tx)">'+esc(p.reu||'—')+'</b></span>'+
      (p.comarca?'<span>Comarca: <b style="color:var(--tx)">'+esc(p.comarca)+'</b></span>':'')+
    '</div>';
  var tabs=[['dados','Principal'],['valores','Valores'],['desdobr','Desdobramentos'],['agenda','Agenda'],['diligencias','Diligências'],['timeline','Timeline'],['skillobs','Observações EvIA'],['contratos','Contratos'],['documentos','Documentos']];
  if(podeVerAtuacao(currentUser)){ var _nErAt=(S.skillErros||[]).filter(function(o){return o.procId===id&&o.status==='nova';}).length; tabs.push(['atuacao','⚠️ Atuação do advogado'+(_nErAt?(' ('+_nErAt+')'):'')]); }
  if(podeVerCalculo(currentUser)) tabs.push(['calculo','Cálculo']);
  var _skNova=(typeof skillObsFor==='function'?skillObsFor(id):[]).filter(function(o){return o.status==='nova';}).length;
  var tabbar='<div class="ptabs">'+tabs.map(function(t){
    var b='';
    if(t[0]==='desdobr'&&(m.desdobr||[]).length)b=' ('+(m.desdobr||[]).length+')';
    if(t[0]==='agenda'&&(m.agenda||[]).length)b=' ('+(m.agenda||[]).length+')';
    if(t[0]==='diligencias'){ var _npD=diligNormProc(p.numero); var _nd=_npD?(S.diligencias||[]).filter(function(d){return diligNormProc(d.proc)===_npD;}).length:0; if(_nd)b=' ('+_nd+')'; }
    if(t[0]==='valores'&&recebOf(p).length)b=' ('+recebOf(p).length+')';
    if(t[0]==='timeline'&&tl.length)b=' ('+tl.length+')';
    if(t[0]==='skillobs'&&_skNova)b=' ('+_skNova+')';
    return'<button class="'+(_ppTab===t[0]?'on':'')+'" onclick="setPPanelTab(\''+id+'\',\''+t[0]+'\')">'+t[1]+b+'</button>';
  }).join('')+'</div>';
  var body;
  if(_ppTab==='valores'){ body=ppValores(id,p,f); setTimeout(function(){ppCustasCSCarregar(id,p);},0); }
  else if(_ppTab==='desdobr')body=ppDesdobr(id,p);
  else if(_ppTab==='agenda')body=ppAgenda(id,p);
  else if(_ppTab==='diligencias')body=ppProcDilig(id,p);
  else if(_ppTab==='timeline')body=ppTimeline(id,tl);
  else if(_ppTab==='skillobs')body=ppSkillObs(id,p);
  else if(_ppTab==='contratos')body=ppContratos(id,p);
  else if(_ppTab==='atuacao')body=ppAtuacao(id,p);
  else if(_ppTab==='documentos')body=ppDocumentos(id,p,docsList);
  else if(_ppTab==='calculo'){ body=ppCalculo(id,p); setTimeout(function(){afterCalculo(id,p);},0); }
  else body=ppDados(id,p,f);
  showModal(head+tabbar+'<div class="pbody">'+body+'</div><div style="text-align:right;margin-top:14px"><button class="btn" onclick="closeModal();_ppCur=\'\'">Fechar</button></div>',{wide:true});
}
async function setPPanelTab(id,tab){_ppTab=tab;await openProcPanel(id);}
async function ppSalvarEstim(id){
  var v=document.getElementById('pp-estim').value;
  var patch={valorEstim:v===''?null:Number(v)};
  try{await procMonSave(id,patch);await procTimelineAdd(id,'valorEstim','Valor estimado atualizado: '+fmt(Number(v)||0));}catch(e){showToast('Erro: '+(e.code||e.message));return;}
  openProcPanel(id);
}
async function ppAddDesdobr(id){
  var num=(document.getElementById('pp-dd-num').value||'').trim();
  var tipo=(document.getElementById('pp-dd-tipo').value||'').trim();
  var obs=(document.getElementById('pp-dd-obs').value||'').trim();
  if(!num){showToast('Informe o número do processo.');return;}
  var m=ppMon(id);var arr=(m.desdobr||[]).slice();arr.push({numero:num,tipo:tipo,obs:obs});
  try{await procMonSave(id,{desdobr:arr});await procTimelineAdd(id,'desdobr','Desdobramento vinculado: '+num);}catch(e){showToast('Erro: '+(e.code||e.message));return;}
  openProcPanel(id);
}
async function ppDelDesdobr(id,i){
  var m=ppMon(id);var arr=(m.desdobr||[]).slice();arr.splice(i,1);
  try{await procMonSave(id,{desdobr:arr});}catch(e){showToast('Erro: '+(e.code||e.message));return;}
  openProcPanel(id);
}
async function ppAddAg(id){
  var data=(document.getElementById('pp-ag-data').value||'').trim();
  var desc=(document.getElementById('pp-ag-desc').value||'').trim();
  var resp=(document.getElementById('pp-ag-resp')?document.getElementById('pp-ag-resp').value:'').trim();
  if(!data||!desc){showToast('Informe data e tarefa.');return;}
  var m=ppMon(id);var arr=(m.agenda||[]).slice();arr.push({data:data,desc:desc,feito:false,resp:resp});
  try{await procMonSave(id,{agenda:arr});await procTimelineAdd(id,'agenda','Tarefa adicionada: '+desc+' ('+fmtDate(data)+')'+(resp?(' · responsável: '+resp):''));}catch(e){showToast('Erro: '+(e.code||e.message));return;}
  openProcPanel(id);
}
// ── Barreiras de exclusão na agenda ────────────────────────────────
// Ninguém exclui item de agenda de outra pessoa. Podem excluir: o responsável do item,
// e os perfis de gestão (admin/gestora/supervisora). Item sem responsável: livre p/ quem edita.
function podeExcluirAg(resp){
  if(isFullAccess(currentUser)||isGestora(currentUser)||(currentUser&&currentUser.role==='supervisora')) return true;
  var r=String(resp||'').trim();
  if(!r||r==='—') return true;
  return _agMatchName(r, agMyIdentities());
}
// Idem para eventos do módulo Agenda (usa responsaveis[]/criadoPor/resp).
function podeExcluirEvento(e){
  if(isFullAccess(currentUser)||isGestora(currentUser)||(currentUser&&currentUser.role==='supervisora')) return true;
  if(!e) return false;
  var em=(currentUser&&currentUser.email)?String(currentUser.email).toLowerCase():'';
  if(em && Array.isArray(e.responsaveis) && e.responsaveis.some(function(r){return String(r.email||'').toLowerCase()===em;})) return true;
  var ids=agMyIdentities();
  if(_agMatchName(e.criadoPor,ids)) return true;
  if(_agMatchName(e.resp,ids)) return true;
  return false;
}
async function ppDelAg(id,i){
  var m=ppMon(id);var arr=(m.agenda||[]).slice();
  if(arr[i] && !podeExcluirAg(arr[i].resp)){ showToast('Só o responsável (ou a gestão) pode excluir este item da agenda.'); return; }
  arr.splice(i,1);
  try{await procMonSave(id,{agenda:arr});}catch(e){showToast('Erro: '+(e.code||e.message));return;}
  openProcPanel(id);
}
async function ppToggleAg(id,i){
  var m=ppMon(id);var arr=(m.agenda||[]).slice();if(!arr[i])return;
  arr[i]=Object.assign({},arr[i],{feito:!arr[i].feito});
  var txt=(arr[i].feito?'Tarefa concluída: ':'Tarefa reaberta: ')+arr[i].desc;
  try{await procMonSave(id,{agenda:arr});await procTimelineAdd(id,'agenda',txt);}catch(e){showToast('Erro: '+(e.code||e.message));return;}
  openProcPanel(id);
}
// Alterar APENAS a data de um item da agenda (empurrar a atividade pra frente quando não foi feita).
// Mesma barreira de permissão da exclusão: responsável do item + gestão.
async function ppSetAgData(id,i,novaData){
  novaData=(novaData||'').trim();
  var m=ppMon(id);var arr=(m.agenda||[]).slice();if(!arr[i])return;
  if(!podeExcluirAg(arr[i].resp)){ showToast('Só o responsável (ou a gestão) pode alterar a data deste item.'); openProcPanel(id); return; }
  if(!novaData){ showToast('Informe a nova data.'); openProcPanel(id); return; }
  var antiga=arr[i].data;
  if(antiga===novaData){ return; }
  arr[i]=Object.assign({},arr[i],{data:novaData});
  try{await procMonSave(id,{agenda:arr});await procTimelineAdd(id,'agenda','Data da tarefa alterada: '+arr[i].desc+' — de '+fmtDate(antiga)+' para '+fmtDate(novaData));}catch(e){showToast('Erro: '+(e.code||e.message));return;}
  showToast('Data atualizada.');
  openProcPanel(id);
}
// Compromissos da coleção 'agenda' vinculados ao processo (ex.: criados na aprovação da EvIA).
// Marcar feito / excluir a partir da aba Agenda do processo, reabrindo o painel em seguida.
async function ppAgEvToggle(procId, evId){
  var e=(S.agenda||[]).find(function(x){return x.id===evId;}); if(!e)return;
  e.feito=!e.feito;
  try{ await saveAgendaEvent(e); }catch(err){ showToast('Erro: '+(err.code||err.message)); return; }
  openProcPanel(procId);
}
async function ppAgEvDel(procId, evId){
  var e=(S.agenda||[]).find(function(x){return x.id===evId;});
  if(e && !podeExcluirEvento(e)){ showToast('Só o responsável (ou a gestão) pode excluir este compromisso.'); return; }
  if(!confirm('Excluir este compromisso vinculado ao processo?'))return;
  try{ await deleteAgendaEvent(evId); }catch(err){ showToast('Erro: '+(err.code||err.message)); return; }
  openProcPanel(procId);
}
async function ppAddAndam(id){
  if(_andamBusy)return; // trava anti-duplo-clique (evita registrar 2x)
  var _el=document.getElementById('pp-an-txt');
  var plain=_el?((_el.innerText||_el.textContent||'').replace(/ /g,' ').trim()):'';
  if(!plain){showToast('Descreva o andamento.');return;}
  var txt=richClean(_el?_el.innerHTML:'');
  var ref=(document.getElementById('pp-an-ref')?document.getElementById('pp-an-ref').value:'')||'';
  _andamBusy=true;
  var btn=document.getElementById('pp-an-btn'); if(btn){btn.disabled=true;btn.textContent='Registrando...';}
  var ok=await procTimelineAdd(id,'andamento',txt,ref);
  _andamBusy=false;
  if(!ok){ if(btn){btn.disabled=false;btn.textContent='Registrar andamento';} showToast('Não foi possível registrar o andamento — o servidor negou a gravação (permissão). Avise o administrador do sistema.'); return; }
  openProcPanel(id);
}

async function addRec(procId){ if(!canWriteProcessos(currentUser)){showToast("Sem permissão para esta ação.");return;}
  if(currentUser.role==='juridico'||currentUser.role==='comercial'){showToast("Financeiro é somente leitura para o seu perfil.");return;}
  var p=S.processos.find(function(x){return x.id===procId;});if(!p)return;
  var data=document.getElementById('rec-data').value,banco=document.getElementById('rec-banco').value.trim(),valor=parseFloat(document.getElementById('rec-valor').value)||0,dev=parseFloat(document.getElementById('rec-dev').value)||0;
  if(!data||!banco||!valor){alert('Preencha Data, Banco e Valor.');return;}
  var recId=fb.doc(fb.collection(fb.db,'processos',procId,'recebimentos')).id;
  var rec={id:recId,data:data,banco:banco,valor:valor,valorDevolucao:dev||null};
  try{
    await fb.setDoc(fb.doc(fb.db,'processos',procId,'recebimentos',recId), Object.assign({},rec,{createdAt:fb.serverTimestamp(),createdBy:currentUser.id}));
  }catch(e){showToast('Erro ao salvar recebimento: '+(e.code||e.message));return;}
  (S.recebByProc[procId]=S.recebByProc[procId]||[]).push(rec);
  try{ await procTimelineAdd(procId,'recebimento','Recebimento lançado: '+fmt(valor)+' ('+banco+')'); }catch(_e){}
  if(_ppCur===procId){ openProcPanel(procId); }else{ renderModalRec(p); }
}
async function deleteRec(procId,recId){ if(!isFullAccess(currentUser)){showToast("Apenas o administrador pode excluir.");return;}
  var p=S.processos.find(function(x){return x.id===procId;});if(!p)return;
  // O recebimento pode viver na SUBCOLEÇÃO (atual) ou no ARRAY do doc do processo (legado — 147
  // processos ainda em 24/09). Apagar só o doc da subcoleção era um no-op silencioso nos legados:
  // o Firestore não reclama de deletar o que não existe, então não havia erro, e a linha voltava
  // no re-render porque recebOf() faz dual-read e cai no array. Tratar os dois lugares.
  var naSub=(S.recebByProc[procId]||[]).some(function(r){return r.id===recId;});
  var noArray=(p.recebimentos||[]).some(function(r){return r.id===recId;});
  if(!naSub && !noArray){ showToast('Recebimento não encontrado — recarregue a página.'); return; }
  try{
    if(naSub){ await fb.deleteDoc(fb.doc(fb.db,'processos',procId,'recebimentos',recId)); }
    if(noArray){
      var resto=(p.recebimentos||[]).filter(function(r){return r.id!==recId;});
      await fb.updateDoc(fb.doc(fb.db,'processos',procId),{recebimentos:resto});
      p.recebimentos=resto;
    }
  }catch(e){showToast('Erro ao excluir recebimento: '+(e.code||e.message));return;}
  if(S.recebByProc[procId]) S.recebByProc[procId]=S.recebByProc[procId].filter(function(r){return r.id!==recId;});
  if(_ppCur===procId){ openProcPanel(procId); }else{ renderModalRec(p); }
}

// ════════════════════════════════════════════════════════════
// ADMINISTRATIVO — Habilitação/Notificação de Cessão de Crédito (NATIVO)
// Acompanhamento do administrativo: por cedente/processo, controla as etapas
// (contrato, docs, notificação, habilitação, substabelecimento, EasyJur, Sistema PBL, Drive).
// Mesmo racional do painel da Jeanne, porém dentro do sistema (coleção 'notif1').
// ════════════════════════════════════════════════════════════
var N1_ETAPAS=[
  {key:'contrato',   label:'Contrato assinado', sempre:true},
  {key:'docsPipe',   label:'Docs Pipe',         sempre:true},
  {key:'notificacao',label:'Notificação'},
  {key:'habilitacao',label:'Habilitação'},
  {key:'substab',    label:'Substabelecimento'},
  {key:'easyjur',    label:'EasyJur'},
  {key:'sistemaPbl', label:'Sistema PBL'},
  {key:'pastaDrive', label:'Pasta Drive'}
];
var N1_TIPOS=['Comum','Trabalhista','Precatório','RPV'];
var N1_STATUS=[['pendente','Pendente'],['concluido','Concluído'],['problema','Com problema'],['nao_aplica','Não se aplica']];
var _n1View='andamento';
var _n1RelMes='';
function n1All(){ return S.notif1||[]; }
function n1StatusLabel(v){ var f=N1_STATUS.find(function(s){return s[0]===v;}); return f?f[1]:'Pendente'; }
function n1StatusCss(v){ var m={concluido:'background:var(--greenl);color:var(--green);border:1px solid var(--green)',pendente:'background:#fbf3df;color:var(--d);border:1px solid #e6cf94',problema:'background:var(--redl);color:var(--red);border:1px solid var(--red)',nao_aplica:'background:var(--row-alt);color:var(--mt);border:1px solid var(--bd)'}; return m[v]||m.pendente; }
function n1EtapaVal(r,k){ return (r.etapas&&r.etapas[k])||'pendente'; }
function n1TipoDef(r){ return !!(r&&r.tipo&&String(r.tipo).trim()); }
function n1IsConcluido(r){ if(!n1TipoDef(r)) return false; return N1_ETAPAS.every(function(e){ var v=n1EtapaVal(r,e.key); return v==='concluido'||v==='nao_aplica'; }); }
function n1TemProblema(r){ return N1_ETAPAS.some(function(e){ return n1EtapaVal(r,e.key)==='problema'; }); }
function n1Log(r,texto){ r.historico=r.historico||[]; r.historico.push({ts:new Date().toISOString(), user:(currentUser&&currentUser.name)||'—', texto:texto}); }
async function saveNotif1(r){ var id=r.id||fb.doc(fb.collection(fb.db,'notif1')).id; r.id=id; try{ await fb.setDoc(fb.doc(fb.db,'notif1',id), r); }catch(e){ showToast('Erro ao salvar: '+(e.code||e.message)); } var i=(S.notif1||[]).findIndex(function(x){return x.id===id;}); if(i>=0)S.notif1[i]=r; else (S.notif1=S.notif1||[]).push(r); return id; }
function n1Get(id){ return (S.notif1||[]).find(function(x){return x.id===id;}); }
async function n1SetTipo(id,val){ var r=n1Get(id); if(!r)return; if((r.tipo||'')===val)return; r.tipo=val; n1Log(r,'Tipo definido como '+(val||'—')); await saveNotif1(r); navigate('notif1'); }
async function n1SetEtapa(id,key,val){ var r=n1Get(id); if(!r)return; r.etapas=r.etapas||{}; if(r.etapas[key]===val)return; r.etapas[key]=val; var lbl=(N1_ETAPAS.find(function(e){return e.key===key;})||{}).label||key; n1Log(r,lbl+' → '+n1StatusLabel(val)); var jaCon=r.dataConclusao; if(n1IsConcluido(r)&&!jaCon){ r.dataConclusao=todayStr(); n1Log(r,'Processo concluído.'); } else if(!n1IsConcluido(r)&&jaCon){ r.dataConclusao=''; } await saveNotif1(r); navigate('notif1'); }
async function n1SetCampo(id,campo,val){ var r=n1Get(id); if(!r)return; if((r[campo]||'')===(val||''))return; r[campo]=val; await saveNotif1(r); }
// Excluir é só da gestão (admin/gestora/supervisora); os advogados usam e editam.
function n1PodeExcluir(u){ return isFullAccess(u)||isGestora(u)||(u&&u.role==='supervisora'); }
async function n1Excluir(id){ if(!n1PodeExcluir(currentUser)){ showToast('Só a gestão pode excluir registros do Administrativo.'); return; } var r=n1Get(id); if(!r)return; if(!confirm('Excluir "'+(r.cedente||'')+'" do acompanhamento?'))return; try{ await fb.deleteDoc(fb.doc(fb.db,'notif1',id)); }catch(e){} S.notif1=(S.notif1||[]).filter(function(x){return x.id!==id;}); navigate('notif1'); }
function modalNotif1(id){
  if(!isFullAccess(currentUser)){ showToast('Sem permissão.'); return; }
  var r=(id?n1Get(id):null)||{};
  showModal('<button class="modal-close" onclick="closeModal()">×</button><div class="modal-title">'+(id?'Editar processo':'Incluir processo')+'</div>'+
    '<div class="g2" style="margin-bottom:10px"><div class="fg"><label>Cedente *</label><input id="n1-cedente" value="'+esc(r.cedente||'')+'"/></div><div class="fg"><label>Advogado cedente</label><input id="n1-adv" value="'+esc(r.advogadoCedente||'')+'"/></div></div>'+
    '<div class="fg" style="margin-bottom:10px"><label>Réu / Assunto <span style="color:var(--mt);font-weight:400">(ex.: BANCO OLE / Empréstimo Irregular)</span></label><input id="n1-info" value="'+esc(r.cedenteInfo||'')+'"/></div>'+
    '<div class="g3" style="margin-bottom:10px"><div class="fg"><label>Link Pipe (URL)</label><input id="n1-pipe" value="'+esc(r.pipeLink||'')+'" placeholder="https://app.pipefy.com/..."/></div><div class="fg"><label>Deal (nº)</label><input id="n1-deal" value="'+esc(r.pipeDeal||'')+'"/></div><div class="fg"><label>Nº do processo</label><input id="n1-num" value="'+esc(r.numeroProcesso||'')+'" oninput="this.value=fmtCNJ(this.value)"/></div></div>'+
    '<div class="g3" style="margin-bottom:14px"><div class="fg"><label>Tipo</label><select id="n1-tipo"><option value="">Selecionar</option>'+N1_TIPOS.map(function(t){return '<option'+((r.tipo===t)?' selected':'')+'>'+esc(t)+'</option>';}).join('')+'</select></div><div class="fg"><label>Entrada</label><input id="n1-entrada" type="date" value="'+esc(r.entrada||todayStr())+'"/></div><div class="fg"><label>Prazo / vencimento <span style="color:var(--mt);font-weight:400">(opcional)</span></label><input id="n1-prazo" type="date" value="'+esc(r.prazo||'')+'"/></div></div>'+
    '<div style="display:flex;justify-content:flex-end;gap:10px"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="salvarNotif1('+(id?('\''+id+'\''):'null')+')">Salvar</button></div>');
}
async function salvarNotif1(id){
  if(!isFullAccess(currentUser)){ showToast('Sem permissão.'); return; }
  var ced=(document.getElementById('n1-cedente').value||'').trim();
  if(!ced){ alert('Informe o Cedente.'); return; }
  var r=(id?n1Get(id):null)||{etapas:{},historico:[],status:'andamento',criadoEm:new Date().toISOString()};
  var tipoNovo=document.getElementById('n1-tipo').value||'';
  if(!id && !r.entrada) r.entrada=todayStr();
  var tipoAntes=r.tipo||'';
  r.cedente=ced;
  r.advogadoCedente=(document.getElementById('n1-adv').value||'').trim();
  r.cedenteInfo=(document.getElementById('n1-info').value||'').trim();
  r.pipeLink=(document.getElementById('n1-pipe').value||'').trim();
  r.pipeDeal=(document.getElementById('n1-deal').value||'').trim();
  r.numeroProcesso=(document.getElementById('n1-num').value||'').trim();
  r.tipo=tipoNovo;
  r.entrada=document.getElementById('n1-entrada').value||r.entrada||todayStr();
  r.prazo=document.getElementById('n1-prazo').value||'';
  if(!id){ n1Log(r,'Processo incluído no acompanhamento.'); if(tipoNovo) n1Log(r,'Tipo definido como '+tipoNovo); }
  else if(tipoAntes!==tipoNovo){ n1Log(r,'Tipo definido como '+(tipoNovo||'—')); }
  await saveNotif1(r);
  closeModal(); showToast('Salvo.'); navigate('notif1');
}
function n1Kpis(){
  var arr=n1All(); var hoje=todayStr(); var mes=(S.mes||todayStr().slice(0,7));
  var emAnd=arr.filter(function(r){return !n1IsConcluido(r);}).length;
  var semTipo=arr.filter(function(r){return !n1TipoDef(r);}).length;
  var venceHoje=arr.filter(function(r){return r.prazo===hoje && !n1IsConcluido(r);}).length;
  var atrasados=arr.filter(function(r){return r.prazo && r.prazo<hoje && !n1IsConcluido(r);}).length;
  var conclMes=arr.filter(function(r){return n1IsConcluido(r) && String(r.dataConclusao||'').slice(0,7)===mes;}).length;
  function c(lbl,val,cor){ return '<div class="mc"><div class="ml">'+lbl+'</div><div class="mv" style="color:'+(cor||'var(--v)')+'">'+val+'</div></div>'; }
  return '<div class="metrics" style="margin-bottom:16px">'+c('Em andamento',emAnd)+c('Sem tipo definido',semTipo,'var(--d)')+c('Vencem hoje',venceHoje,'var(--d)')+c('Atrasados',atrasados,atrasados>0?'var(--red)':'var(--green)')+c('Concluídos no mês',conclMes,'var(--green)')+'</div>';
}
function n1EtapaCell(r,e){
  var val=n1EtapaVal(r,e.key);
  if(!e.sempre && !n1TipoDef(r)){ return '<select disabled style="font-size:11px;padding:4px 6px;border-radius:5px;background:var(--row-alt);color:var(--mt);border:1px dashed var(--bd)"><option>Definir tipo</option></select>'; }
  return '<select onchange="n1SetEtapa(\''+r.id+'\',\''+e.key+'\',this.value)" style="font-size:11px;padding:4px 6px;border-radius:5px;font-weight:600;'+n1StatusCss(val)+'">'+N1_STATUS.map(function(s){return '<option value="'+s[0]+'"'+(val===s[0]?' selected':'')+'>'+s[1]+'</option>';}).join('')+'</select>';
}
function n1TableHTML(){
  var arr=n1All().slice().sort(function(a,b){ return String(b.entrada||'').localeCompare(String(a.entrada||'')) || String(b.criadoEm||'').localeCompare(String(a.criadoEm||'')); });
  var head='<tr style="background:var(--v);color:#fff"><th style="padding:8px;text-align:left;min-width:220px">Cedente</th><th style="padding:8px;text-align:left;min-width:150px">Advogado cedente</th><th style="padding:8px;text-align:left;min-width:170px">Link Pipe / Processo</th><th style="padding:8px;min-width:120px">Tipo</th><th style="padding:8px">Entrada</th>'+N1_ETAPAS.map(function(e){return '<th style="padding:8px;min-width:120px">'+esc(e.label)+'</th>';}).join('')+'<th style="padding:8px"></th></tr>';
  var rows=arr.map(function(r){
    var pipe=r.pipeLink?('<a href="'+esc(r.pipeLink)+'" target="_blank" rel="noopener" style="color:var(--blue);font-size:12px;font-weight:600">Abrir no Pipe ↗'+(r.pipeDeal?(' <span style="color:var(--mt);font-weight:400">deal '+esc(r.pipeDeal)+'</span>'):'')+'</a>'):(r.pipeDeal?('<span style="font-size:12px;color:var(--mt)">deal '+esc(r.pipeDeal)+'</span>'):'<span style="font-size:11px;color:var(--mt)">—</span>');
    var numInput='<input value="'+esc(r.numeroProcesso||'')+'" placeholder="Nº do processo" onchange="n1SetCampo(\''+r.id+'\',\'numeroProcesso\',fmtCNJ(this.value));this.value=fmtCNJ(this.value)" oninput="this.value=fmtCNJ(this.value)" style="width:100%;margin-top:4px;font-size:11px;padding:4px 6px;border:1px solid var(--bd);border-radius:5px"/>';
    var tipoSel='<select onchange="n1SetTipo(\''+r.id+'\',this.value)" style="font-size:12px;padding:4px 6px;border-radius:5px;border:1px solid '+(n1TipoDef(r)?'var(--bd)':'var(--d)')+';'+(n1TipoDef(r)?'':'background:#fbf3df;color:var(--d);font-weight:600')+'"><option value="">Selecionar</option>'+N1_TIPOS.map(function(t){return '<option'+((r.tipo===t)?' selected':'')+'>'+esc(t)+'</option>';}).join('')+'</select>';
    var conc=n1IsConcluido(r);
    return '<tr'+(conc?' style="background:var(--greenl)"':'')+'>'+
      '<td style="padding:8px"><div style="font-weight:700;color:var(--v)">'+esc(r.cedente||'—')+(conc?' <span class="badge" style="background:var(--green);color:#fff;font-size:10px">Concluído</span>':'')+'</div>'+(r.cedenteInfo?'<div style="font-size:11px;color:var(--mt)">'+esc(r.cedenteInfo)+'</div>':'')+'</td>'+
      '<td style="padding:8px;font-size:12px">'+esc(r.advogadoCedente||'—')+'</td>'+
      '<td style="padding:8px">'+pipe+numInput+'</td>'+
      '<td style="padding:8px">'+tipoSel+'</td>'+
      '<td style="padding:8px;font-size:12px;white-space:nowrap">'+fmtDate(r.entrada)+(r.prazo?('<div style="font-size:10px;color:'+((r.prazo<todayStr()&&!conc)?'var(--red)':'var(--mt)')+'">prazo '+fmtDate(r.prazo)+'</div>'):'')+'</td>'+
      N1_ETAPAS.map(function(e){return '<td style="padding:6px 8px;text-align:center">'+n1EtapaCell(r,e)+'</td>';}).join('')+
      '<td style="padding:8px;white-space:nowrap"><button class="ebtn" title="Editar" onclick="modalNotif1(\''+r.id+'\')">✏️</button>'+(n1PodeExcluir(currentUser)?'<button class="dbtn" title="Excluir" onclick="n1Excluir(\''+r.id+'\')">×</button>':'')+'</td>'+
    '</tr>';
  }).join('')||'<tr><td colspan="'+(6+N1_ETAPAS.length)+'" style="padding:16px;text-align:center;color:var(--mt)">Nenhum processo no acompanhamento. Clique em "+ Incluir processo".</td></tr>';
  var legenda='<div style="display:flex;gap:16px;flex-wrap:wrap;font-size:11px;color:var(--mt);margin:10px 2px 0">'+
    '<span><span style="display:inline-block;width:11px;height:11px;border-radius:3px;background:var(--greenl);border:1px solid var(--green);vertical-align:middle"></span> Concluído</span>'+
    '<span><span style="display:inline-block;width:11px;height:11px;border-radius:3px;background:#fbf3df;border:1px solid #e6cf94;vertical-align:middle"></span> Pendente</span>'+
    '<span><span style="display:inline-block;width:11px;height:11px;border-radius:3px;background:var(--redl);border:1px solid var(--red);vertical-align:middle"></span> Com problema</span>'+
    '<span><span style="display:inline-block;width:11px;height:11px;border-radius:3px;background:var(--row-alt);border:1px solid var(--bd);vertical-align:middle"></span> Não se aplica</span>'+
    '<span><span style="display:inline-block;width:11px;height:11px;border-radius:3px;background:var(--row-alt);border:1px dashed var(--bd);vertical-align:middle"></span> Definir tipo primeiro</span>'+
  '</div>';
  return '<div style="overflow-x:auto;border-radius:8px;border:1px solid #ddd"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead>'+head+'</thead><tbody>'+rows+'</tbody></table></div>'+legenda;
}
function n1HistoricoHTML(){
  var evs=[]; n1All().forEach(function(r){ (r.historico||[]).forEach(function(h){ evs.push({ts:h.ts,user:h.user,texto:h.texto,ced:r.cedente}); }); });
  evs.sort(function(a,b){ return String(b.ts||'').localeCompare(String(a.ts||'')); });
  evs=evs.slice(0,40);
  var rows=evs.map(function(h){ var d=new Date(h.ts); var dt=isNaN(d)?'':(('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2)+' '+('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)); return '<div style="font-size:12px;padding:4px 0;border-bottom:1px solid var(--row-alt)"><span style="color:var(--mt)">'+dt+'</span> | <b>'+esc(h.user||'—')+'</b> | '+(h.ced?'<span style="color:var(--mt)">'+esc(h.ced)+':</span> ':'')+esc(h.texto||'')+'</div>'; }).join('')||'<div style="font-size:12px;color:var(--mt)">Sem alterações registradas.</div>';
  return '<div style="margin-top:22px"><div style="font-weight:700;color:var(--v);margin-bottom:6px">Histórico de alterações</div>'+rows+'</div>';
}
function n1RelatorioHTML(){
  var mesSel=_n1RelMes||(S.mes||todayStr().slice(0,7));
  var meses=[]; for(var i=0;i<12;i++){ var d=new Date(); d.setMonth(d.getMonth()-i); meses.push(d.toISOString().slice(0,7)); }
  var arr=n1All().filter(function(r){ return n1IsConcluido(r) && String(r.dataConclusao||'').slice(0,7)===mesSel; });
  var concl=arr.length;
  var noPrazo=arr.filter(function(r){ return r.prazo && r.dataConclusao && r.dataConclusao<=r.prazo; }).length;
  var comProb=arr.filter(n1TemProblema).length;
  var dias=arr.map(function(r){ if(r.entrada&&r.dataConclusao){ var a=new Date(r.entrada+'T00:00:00'),b=new Date(r.dataConclusao+'T00:00:00'); if(!isNaN(a)&&!isNaN(b)) return Math.max(0,Math.round((b-a)/86400000)); } return null; }).filter(function(x){return x!=null;});
  var tempoMed=dias.length?Math.round(dias.reduce(function(s,x){return s+x;},0)/dias.length):0;
  function c(lbl,val,cor,sub){ return '<div class="mc"><div class="ml">'+lbl+'</div><div class="mv" style="color:'+(cor||'var(--v)')+'">'+val+'</div>'+(sub?'<div style="font-size:11px;color:var(--mt)">'+sub+'</div>':'')+'</div>'; }
  var kpis='<div class="metrics" style="margin-bottom:16px">'+c('Concluídos',concl,'var(--green)')+c('Dentro do prazo',(concl?noPrazo:'—'))+c('Tempo médio',tempoMed+' dias')+c('Tiveram problema',comProb,comProb>0?'var(--red)':'var(--green)')+'</div>';
  var lista=arr.length?('<div style="overflow-x:auto;border-radius:8px;border:1px solid #ddd"><table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr style="background:var(--v);color:#fff"><th style="padding:8px;text-align:left">Cedente</th><th style="padding:8px">Tipo</th><th style="padding:8px">Entrada</th><th style="padding:8px">Conclusão</th><th style="padding:8px">Dias</th><th style="padding:8px">Problema?</th></tr></thead><tbody>'+arr.map(function(r){ var d=(r.entrada&&r.dataConclusao)?Math.max(0,Math.round((new Date(r.dataConclusao)-new Date(r.entrada))/86400000)):'—'; return '<tr><td style="padding:7px">'+esc(r.cedente||'')+'</td><td style="padding:7px;text-align:center">'+esc(r.tipo||'—')+'</td><td style="padding:7px;text-align:center">'+fmtDate(r.entrada)+'</td><td style="padding:7px;text-align:center">'+fmtDate(r.dataConclusao)+'</td><td style="padding:7px;text-align:center">'+d+'</td><td style="padding:7px;text-align:center">'+(n1TemProblema(r)?'<span style="color:var(--red)">sim</span>':'não')+'</td></tr>'; }).join('')+'</tbody></table></div>'):('<div class="card"><div class="empty">Nenhum processo concluído em '+esc(mesSel)+'.</div></div>');
  return '<div style="margin-bottom:12px"><select onchange="_n1RelMes=this.value;navigate(\'notif1\')" style="padding:7px 10px;border:1px solid var(--bd);border-radius:6px">'+meses.map(function(m){return '<option value="'+m+'"'+(m===mesSel?' selected':'')+'>'+m+'</option>';}).join('')+'</select></div>'+kpis+lista;
}
function pageNotif1(){
  var toolbar='<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:14px">'+
    '<div style="display:flex;gap:4px;background:var(--row-alt);border:1px solid var(--bd);border-radius:8px;padding:4px;width:fit-content">'+
      '<button class="btn'+(_n1View==='andamento'?' bp':'')+'" style="font-size:13px;padding:6px 16px;border-radius:6px'+(_n1View==='andamento'?'':';background:none')+'" onclick="_n1View=\'andamento\';navigate(\'notif1\')">Em andamento</button>'+
      '<button class="btn'+(_n1View==='relatorio'?' bp':'')+'" style="font-size:13px;padding:6px 16px;border-radius:6px'+(_n1View==='relatorio'?'':';background:none')+'" onclick="_n1View=\'relatorio\';navigate(\'notif1\')">Relatório mensal</button>'+
    '</div>'+
    (_n1View==='andamento'?'<button class="btn bp" style="font-size:12px" onclick="modalNotif1(null)">+ Incluir processo</button>':'')+
  '</div>';
  var titulo='<div class="page-title">'+I.notificacoes+' Administrativo <span style="font-size:12px;color:var(--mt);font-weight:400;margin-left:8px">Habilitação/Notificação — Cessão de Crédito</span></div>';
  if(_n1View==='relatorio'){ return titulo+toolbar+n1RelatorioHTML(); }
  return titulo+toolbar+n1Kpis()+n1TableHTML()+n1HistoricoHTML();
}

// Administrativo: advogados (e o perito) usam e editam; gestão também. Comercial/diligente não.
function podeVerAdministrativo(u){
  if(!u) return false;
  return isFullAccess(u)||isGestora(u)||u.role==='supervisora'||u.role==='lawyer'||u.role==='perito_contabil'||u.role==='gestor_calculos'||u.role==='juridico';
}

// ════════════════════════════════════════════════════════════
// FINANCEIRO — Compra PBL / Venda FIDC / Despesas
// ════════════════════════════════════════════════════════════
// Tipos de lançamento. `tipo` mantém os valores antigos (venda/compra/despesa) para o Fluxo de Caixa e demais telas continuarem lendo.
// venda = Receita (entrada) · compra = Aquisição de processo · despesa · transferencia (duas pernas, mesmo grupoId) · repasse (saída de conta vinculada para o fundo).
var FIN_TIPO_LBL={venda:'Receita',compra:'Aquisição de processo',despesa:'Despesa',transferencia:'Transferência',repasse:'Repasse ao fundo'};
var FIN_CATS={
  venda:['Recebimento de processo','Venda de crédito (FIDC)','Outras receitas'],
  compra:['Aquisição de processo'],
  despesa:['Custas e certidões','Honorários e correspondentes','Comissões','Pessoal','Tecnologia','Impostos e tarifas','Outras despesas'],
  transferencia:['Transferência entre contas'],
  repasse:['Repasse ao fundo']
};
var FIN_FORMAS=['PIX','TED','Boleto','Dinheiro','Outro'];
var FIN_EMPRESAS=['PBL','FIDC','CERTJUD'];
// Contas padrão da operação (botão "Cadastrar as 4 contas padrão" na tela Contas).
var FIN_CONTAS_PADRAO=[
  {id:'pbl-op',    nome:'PBL Originadora',          banco:'Genial',    agencia:'',     conta:'5253996-2',  titular:'PBL Originadora',        entidade:'PBL',     tipo:'operacional'},
  {id:'fidc-v1',   nome:'PBL FIDC (vinculada 1)',   banco:'Genial',    agencia:'',     conta:'38219-1',    titular:'PBL FIDC',               entidade:'FIDC',    tipo:'vinculada'},
  {id:'fidc-v2',   nome:'Evilyn FIDC (vinculada 2)',banco:'Genial',    agencia:'',     conta:'5244902-5',  titular:'Evilyn Wagner de Souza', entidade:'FIDC',    tipo:'vinculada'},
  {id:'certjud-op',nome:'Certjud',                  banco:'Santander', agencia:'3131', conta:'130090241',  titular:'Certjud',                entidade:'CERTJUD', tipo:'operacional'}
];
var _finTab='geral', _finConta='', _finExtDi='', _finExtDf='';
var _finF={vis:'todos',conta:'',di:'',df:'',q:''};

function finStatus(f){ return (f&&f.status)||'pago'; }
function finSentido(f){ return f.tipo==='venda'?'entrada':(f.tipo==='transferencia'?(f.sentido||'saida'):'saida'); }
function finData(f){ return f.dataBaixa||f.vencimento||f.data||''; }
function finVencido(f){ return finStatus(f)==='previsto' && (f.vencimento||f.data||'')<todayStr(); }
// Entra no Fluxo de Caixa: só o que já foi pago/recebido e não é movimentação entre contas próprias.
function finRealizado(f){ return finStatus(f)==='pago' && f.tipo!=='transferencia'; }
function contaById(id){ return (S.contas||[]).find(function(c){return c.id===id;})||null; }
function finEntidade(l){ if(l&&l.entidade)return l.entidade; var c=contaById(l&&l.conta); return c?c.entidade:'PBL'; }
function finContaNome(f){ var c=contaById(f.conta); return c?c.nome:(f.banco||'—'); }
function finNovoId(col){ return fb.doc(fb.collection(fb.db,col)).id; }
function titToEntidade(t){ t=String(t||''); if(/fidc/i.test(t))return 'FIDC'; if(/certjud/i.test(t))return 'CERTJUD'; return 'PBL'; }
// Saldo de cada conta = saldo inicial + entradas pagas − saídas pagas (a partir da data do saldo inicial). Previstos ficam à parte.
function contaSaldos(){
  var r={};
  (S.contas||[]).forEach(function(c){ r[c.id]={ent:0,sai:0,prevEnt:0,prevSai:0,ini:Number(c.saldoInicial)||0}; });
  (S.financeiro||[]).forEach(function(f){
    var x=r[f.conta]; if(!x)return;
    var st=finStatus(f); if(st==='cancelado')return;
    var c=contaById(f.conta); if(c&&c.dataSaldoInicial&&finData(f)<c.dataSaldoInicial)return;
    var v=Number(f.valor)||0, ent=finSentido(f)==='entrada';
    if(st==='pago'){ if(ent)x.ent+=v; else x.sai+=v; } else { if(ent)x.prevEnt+=v; else x.prevSai+=v; }
  });
  Object.keys(r).forEach(function(k){ r[k].saldo=r[k].ini+r[k].ent-r[k].sai; });
  return r;
}
async function upsertConta(c){
  var id=c.id||finNovoId('contas');
  var payload=Object.assign({},c,{id:id,saldoInicial:Number(c.saldoInicial)||0,updatedAt:fb.serverTimestamp(),updatedBy:currentUser.id});
  if(!c.createdAt){ payload.createdAt=fb.serverTimestamp(); payload.createdBy=currentUser.id; }
  await fb.setDoc(fb.doc(fb.db,'contas',id),payload,{merge:true});
  return id;
}
function finTipoBadge(f){
  var tb=f.tipo==='compra'?'<span class="badge b-compra">Aquisição</span>':f.tipo==='venda'?'<span class="badge b-venda">Receita</span>':f.tipo==='despesa'?'<span class="badge b-desp">Despesa</span>':'<span class="badge" style="background:var(--dl);color:var(--d)">'+FIN_TIPO_LBL[f.tipo]+'</span>';
  var e=finEntidade(f); var ec=e==='FIDC'?'var(--dl)':(e==='CERTJUD'?'var(--greenl)':'var(--bluel)'); var efg=e==='FIDC'?'var(--d)':(e==='CERTJUD'?'var(--green)':'var(--blue)');
  return tb+' <span class="badge" style="background:'+ec+';color:'+efg+'">'+e+'</span>';
}
function finStatusBadge(f){
  var st=finStatus(f), ent=finSentido(f)==='entrada';
  if(st==='cancelado') return '<span class="badge" style="background:var(--row-alt);color:var(--mt)">Cancelado</span>';
  if(st==='pago') return '<span class="badge b-venda">'+(ent?'Recebido':'Pago')+'</span>';
  if(finVencido(f)) return '<span class="badge b-desp">Vencido</span>';
  return '<span class="badge" style="background:var(--dl);color:var(--d)">'+(ent?'A receber':'A pagar')+'</span>';
}
async function venderFidc(id){ if(!canVenderFidc(currentUser)){ showToast('Venda ao FIDC: apenas Evilyn ou Marco têm autorização.'); return; }
  var p=(S.processos||[]).find(function(x){return x.id===id;}); if(!p)return;
  if(!canWriteLiquidacoes(currentUser)){ showToast('Sem permissão para registrar venda.'); return; }
  if(p.vendidoFidc){ showToast('Este processo já foi vendido ao FIDC.'); return; }
  var compra=Number(p.valorCompra)||0;
  if(compra<=0){ showToast('Preencha o Valor de Compra antes de vender ao FIDC.'); return; }
  var valorVenda=Math.round(compra*1.2*100)/100;
  var data=todayStr();
  try{
    await upsertLancamento({tipo:'venda',entidade:'PBL',data:data,valor:valorVenda,banco:'',descricao:'Venda ao FIDC — proc. '+p.numero,processoId:id,categoria:'Venda ao FIDC',obs:'Valor de Compra '+fmt(compra)+' + 20%'});
    await upsertLancamento({tipo:'compra',entidade:'FIDC',data:data,valor:valorVenda,banco:'',descricao:'Compra da PBL — proc. '+p.numero,processoId:id,categoria:'Compra do FIDC',obs:'Aquisição do processo da PBL'});
    S.financeiro=await fetchCollection('lancamentos');
    var dx=Object.assign({},(S.monByProc[id]||{}).dadosExtras||{},{titularidade:'FIDC PBL'});
    await procMonSave(id,{dadosExtras:dx});
    p.vendidoFidc=true; p.dataVendaFidc=data; p.valorVendaFidc=valorVenda;
    await persistProcessoFields(id,{vendidoFidc:true,dataVendaFidc:data,valorVendaFidc:valorVenda});
    await procTimelineAdd(id,'venda','Vendido ao FIDC por '+fmt(valorVenda)+' (Valor de Compra '+fmt(compra)+' + 20%). Entrada no caixa PBL e saída no caixa FIDC. Liquidado para a PBL; segue aberto no FIDC. Titularidade → FIDC PBL.');
    showToast('Venda ao FIDC registrada.');
    openProcPanel(id);
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}
async function desfazerVendaFidc(id){ if(!canVenderFidc(currentUser)){ showToast('Desfazer venda ao FIDC: apenas Evilyn ou Marco têm autorização.'); return; }
  var p=(S.processos||[]).find(function(x){return x.id===id;}); if(!p)return;
  if(!canWriteLiquidacoes(currentUser)){ showToast('Sem permissão.'); return; }
  if(!confirm('Desfazer a venda ao FIDC? Remove os lançamentos dos caixas PBL e FIDC e volta a titularidade para PBL.'))return;
  try{
    var alvos=(S.financeiro||[]).filter(function(f){return f.processoId===id && (f.categoria==='Venda ao FIDC'||f.categoria==='Compra do FIDC');});
    for(var i=0;i<alvos.length;i++){ await deleteLancamento(alvos[i].id); }
    S.financeiro=await fetchCollection('lancamentos');
    var dx=Object.assign({},(S.monByProc[id]||{}).dadosExtras||{},{titularidade:'PBL Originadora'});
    await procMonSave(id,{dadosExtras:dx});
    p.vendidoFidc=false; p.dataVendaFidc=''; p.valorVendaFidc=0;
    await persistProcessoFields(id,{vendidoFidc:false,dataVendaFidc:'',valorVendaFidc:0});
    await procTimelineAdd(id,'venda','Venda ao FIDC desfeita. Lançamentos removidos dos caixas. Titularidade → PBL Originadora.');
    showToast('Venda desfeita.');
    openProcPanel(id);
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}
// ════════ AQUISIÇÕES / PARTES DO CRÉDITO (múltiplas compras por processo) ════════
// Venda ao FIDC por aquisição: a fonte da verdade é o mapa `vendasFidc` do topo do documento,
// que as Security Rules deixam só o admin escrever. Os campos vendidoFidc/valorVendaFidc dentro
// de `aquisicoes` são cópia de exibição — o array é editável por outros papéis e não vale como prova.
function procVendasFidc(p){ var m=p&&p.vendasFidc; return (m&&typeof m==='object')?m:{}; }
function aqVendaFidc(p,aq){
  if(!aq) return {vendido:false,valor:0,data:''};
  // Processo sem array de aquisições: a "principal" espelha os campos do topo (também protegidos).
  if(aq.id==='principal' && !(p&&p.aquisicoes&&p.aquisicoes.length)){
    return {vendido:!!(p&&p.vendidoFidc), valor:Number(p&&p.valorVendaFidc)||0, data:(p&&p.dataVendaFidc)||''};
  }
  var v=procVendasFidc(p)[aq.id];
  return v?{vendido:true,valor:Number(v.valor)||0,data:v.data||''}:{vendido:false,valor:0,data:''};
}
function todasVendidasFidc(p,arr){ return (arr||[]).length>0 && (arr||[]).every(function(a){return aqVendaFidc(p,a).vendido;}); }
function procAquisicoes(p){
  if(p.aquisicoes && p.aquisicoes.length) return p.aquisicoes;
  return [{id:'principal', descricao:'Principal', valorCompra:Number(p.valorCompra)||0, valorCondenacao:Number(p.valorCondenacao)||0, dataCompra:p.dataCompra||'', vendidoFidc:!!p.vendidoFidc, dataVendaFidc:p.dataVendaFidc||'', valorVendaFidc:Number(p.valorVendaFidc)||0}];
}
function recalcTotaisAq(p){
  var arr=p.aquisicoes||[]; if(!arr.length) return;
  p.valorCompra=arr.reduce(function(s,a){return s+(Number(a.valorCompra)||0);},0);
  p.valorCondenacao=arr.reduce(function(s,a){return s+(Number(a.valorCondenacao)||0);},0);
  p.vendidoFidc=todasVendidasFidc(p,arr);
}
async function salvarAquisicoes(id, arr, vendas){
  var p=(S.processos||[]).find(function(x){return x.id===id;}); if(!p) return false;
  p.aquisicoes=arr; if(vendas) p.vendasFidc=vendas; recalcTotaisAq(p);
  var campos={aquisicoes:arr, valorCompra:p.valorCompra, valorCondenacao:p.valorCondenacao, vendidoFidc:p.vendidoFidc};
  if(vendas) campos.vendasFidc=vendas; // só admin passa na regra — venda e array vão juntos ou nada vai
  try{ await persistProcessoFields(id,campos); }
  catch(e){ showToast('Erro: '+(e.code||e.message)); return false; }
  return true;
}
// Deságio (%) = quanto o Valor de Compra está abaixo do Valor Atualizado: (cond - compra) / cond * 100
function _desagioPct(compra,cond){ compra=Number(compra)||0; cond=Number(cond)||0; if(cond<=0) return null; return (cond-compra)/cond*100; }
function _desagioFmt(compra,cond){ var d=_desagioPct(compra,cond); return d==null?'—':(d.toFixed(2).replace('.',',')+'%'); }
function aqCalcDesagio(){ var c=parseMoeda((document.getElementById('aq-compra')||{}).value); var k=parseMoeda((document.getElementById('aq-cond')||{}).value); var el=document.getElementById('aq-desagio'); if(el) el.value=_desagioFmt(c,k); }
function ppAquisicoesBox(id,p){
  var arr=procAquisicoes(p);
  var podeFidc=canVenderFidc(currentUser);
  var totCompra=arr.reduce(function(s,a){return s+(Number(a.valorCompra)||0);},0);
  var totCond=arr.reduce(function(s,a){return s+(Number(a.valorCondenacao)||0);},0);
  var rows=arr.map(function(a){
    var vVenda=Math.round((Number(a.valorCompra)||0)*1.2*100)/100;
    var acao;
    var vfid=aqVendaFidc(p,a); // lê o mapa protegido, não o campo do array
    if(vfid.vendido){ acao='<span class="badge" style="background:var(--bluel);color:var(--blue)">Vendido FIDC ('+fmt(vfid.valor)+')</span>'+(podeFidc?' <button class="btn" style="font-size:11px" title="Desfazer venda" onclick="desfazerVendaFidcAq(\''+id+'\',\''+a.id+'\')">↺</button>':''); }
    else if((Number(a.valorCompra)||0)>0){ acao=podeFidc?'<button class="btn bp" style="font-size:11px" onclick="modalVenderFidc(\''+id+'\',\''+a.id+'\')">🏦 Vender ao FIDC ('+fmt(vVenda)+')</button>':'<span style="font-size:11px;color:var(--mt)" title="Autorização apenas de Evilyn ou Marco">🔒 venda restrita</span>'; }
    else{ acao='<span style="font-size:11px;color:var(--mt)">preencha Valor de Compra</span>'; }
    var del=(arr.length>1)?'<button class="dbtn" onclick="removerAquisicao(\''+id+'\',\''+a.id+'\')">×</button>':'';
    return '<tr><td><b>'+esc(a.descricao)+'</b></td><td class="r">'+fmt(a.valorCompra)+'</td><td class="r">'+fmt(a.valorCondenacao)+'</td><td class="r" style="color:var(--d)">'+_desagioFmt(a.valorCompra,a.valorCondenacao)+'</td><td style="white-space:nowrap">'+fmtDate(a.dataCompra)+'</td><td>'+acao+'</td><td class="r" style="white-space:nowrap"><button class="ebtn" onclick="modalAquisicao(\''+id+'\',\''+a.id+'\')">✏️</button>'+del+'</td></tr>';
  }).join('');
  return '<div style="border:1px solid var(--bd);border-radius:8px;padding:12px;margin:10px 0">'+
    '<div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px"><div style="font-size:13px;font-weight:700;color:var(--v)">💼 Aquisições / partes do crédito</div><button class="btn bp" style="font-size:12px" onclick="modalAquisicao(\''+id+'\',null)">+ Adicionar compra</button></div>'+
    '<div style="overflow-x:auto"><table class="tbl"><thead><tr><th>Parte</th><th class="r">Valor de Compra</th><th class="r">Valor Atualizado</th><th class="r">Deságio</th><th>Data</th><th>Venda ao FIDC</th><th></th></tr></thead><tbody>'+rows+
      '<tr><td style="text-align:right;font-weight:800;background:var(--vl)">TOTAL</td><td class="r" style="font-weight:800;background:var(--vl)">'+fmt(totCompra)+'</td><td class="r" style="font-weight:800;background:var(--vl)">'+fmt(totCond)+'</td><td class="r" style="font-weight:800;background:var(--vl);color:var(--d)">'+_desagioFmt(totCompra,totCond)+'</td><td colspan="3" style="background:var(--vl)"></td></tr>'+
    '</tbody></table></div>'+
    '<div style="font-size:11px;color:var(--mt);margin-top:6px">Cada parte tem seu Valor de Compra e Valor Atualizado e pode ser vendida ao FIDC separadamente. Os totais alimentam o processo, relatórios e caixas.</div>'+aqTimelineHTML(p)+'</div>';
}
function modalAquisicao(id, aqId){
  var p=(S.processos||[]).find(function(x){return x.id===id;}); if(!p)return;
  var arr=procAquisicoes(p);
  var aq = aqId ? arr.find(function(a){return a.id===aqId;}) : null;
  var v=function(k){return aq&&aq[k]!=null?aq[k]:'';};
  var ov=document.getElementById('aq-ov'); if(ov) ov.remove();
  ov=document.createElement('div'); ov.id='aq-ov'; ov.className='modal-bg'; ov.style.zIndex='900';
  ov.onclick=function(e){ if(e.target===ov){ var o=document.getElementById('aq-ov'); if(o)o.remove(); } };
  ov.innerHTML='<div class="modal" style="max-width:560px"><div class="modal-title">'+(aq?'Editar aquisição':'Nova aquisição / compra')+'</div>'+
    '<div class="fg" style="margin-bottom:10px"><label>Descrição da parte *</label><input id="aq-desc" value="'+esc(String(v('descricao')))+'" placeholder="ex.: Principal, Sucumbência, Honorários..."/></div>'+
    '<div class="g4" style="margin-bottom:10px"><div class="fg"><label>Valor de Compra (PBL) (R$)</label><input id="aq-compra" type="text" inputmode="decimal" value="'+esc(v('valorCompra')?fmt(v('valorCompra')):'')+'" oninput="aqCalcDesagio()" onchange="maskMoeda(this);aqCalcDesagio()" placeholder="R$ 0,00"/></div><div class="fg"><label>Valor Atualizado (R$)</label><input id="aq-cond" type="text" inputmode="decimal" value="'+esc(v('valorCondenacao')?fmt(v('valorCondenacao')):'')+'" oninput="aqCalcDesagio()" onchange="maskMoeda(this);aqCalcDesagio()" placeholder="R$ 0,00"/></div><div class="fg"><label>Deságio (%) <span style="font-weight:400;color:var(--mt)">(auto)</span></label><input id="aq-desagio" type="text" readonly value="'+esc(_desagioFmt(v('valorCompra'),v('valorCondenacao')))+'" style="background:var(--row-alt);color:var(--d);font-weight:700"/></div><div class="fg"><label>Data da compra</label><input id="aq-data" type="date" value="'+esc(String(v('dataCompra')||todayStr()))+'"/></div></div>'+
    '<div style="display:flex;justify-content:flex-end;gap:10px"><button class="btn" onclick="var o=document.getElementById(\'aq-ov\');if(o)o.remove()">Cancelar</button><button class="btn bp" onclick="salvarAquisicao(\''+id+'\','+(aqId?('\''+aqId+'\''):'null')+')">Salvar</button></div></div>';
  document.body.appendChild(ov);
  setTimeout(function(){var el=document.getElementById('aq-desc'); if(el) el.focus();},30);
}
async function salvarAquisicao(id, aqId){
  var p=(S.processos||[]).find(function(x){return x.id===id;}); if(!p)return;
  var desc=(document.getElementById('aq-desc').value||'').trim();
  if(!desc){ showToast('Informe a descrição da parte.'); return; }
  var compra=parseMoeda(document.getElementById('aq-compra').value);
  var cond=parseMoeda(document.getElementById('aq-cond').value);
  var dataC=document.getElementById('aq-data').value||'';
  var arr=procAquisicoes(p).map(function(a){return Object.assign({},a);});
  if(aqId){
    var idx=-1; for(var i=0;i<arr.length;i++){ if(arr[i].id===aqId){idx=i;break;} }
    if(idx>=0){ arr[idx].descricao=desc; arr[idx].valorCompra=compra; arr[idx].valorCondenacao=cond; arr[idx].dataCompra=dataC; }
  } else {
    arr.push({id:fb.doc(fb.collection(fb.db,'processos')).id, descricao:desc, valorCompra:compra, valorCondenacao:cond, dataCompra:dataC, vendidoFidc:false, dataVendaFidc:'', valorVendaFidc:0});
  }
  var ok=await salvarAquisicoes(id, arr);
  if(ok){ var o=document.getElementById('aq-ov'); if(o)o.remove(); openProcPanel(id); showToast('Aquisição salva.'); }
}
async function removerAquisicao(id, aqId){
  var p=(S.processos||[]).find(function(x){return x.id===id;}); if(!p)return;
  var arr=procAquisicoes(p).filter(function(a){return a.id!==aqId;});
  if(!arr.length){ showToast('O processo precisa ter pelo menos uma aquisição.'); return; }
  if(!confirm('Remover esta aquisição/parte?'))return;
  var ok=await salvarAquisicoes(id, arr);
  if(ok){ openProcPanel(id); showToast('Aquisição removida.'); }
}
// Passo da DATA DA CESSÃO antes de vender (o valor segue sendo compra + 20%) — item 17 do
// relatório de 30/09. Sem ele a cessão era sempre carimbada com a data de hoje.
function modalVenderFidc(id, aqId){
  if(!canVenderFidc(currentUser)){ showToast('Venda ao FIDC: apenas Evilyn ou Marco têm autorização.'); return; }
  var p=(S.processos||[]).find(function(x){return x.id===id;}); if(!p)return;
  var aq=procAquisicoes(p).find(function(a){return a.id===aqId;}); if(!aq)return;
  var compra=Number(aq.valorCompra)||0;
  if(compra<=0){ showToast('Preencha o Valor de Compra desta aquisição antes de vender.'); return; }
  var valorVenda=Math.round(compra*1.2*100)/100;
  var ov=document.getElementById('vf-ov'); if(ov)ov.remove();
  ov=document.createElement('div'); ov.id='vf-ov'; ov.className='modal-bg'; ov.style.zIndex='950';
  ov.onclick=function(e){ if(e.target===ov){var o=document.getElementById('vf-ov');if(o)o.remove();} };
  ov.innerHTML='<div class="modal" style="max-width:480px"><div class="modal-title">🏦 Vender ao FIDC — '+esc(aq.descricao||'')+'</div>'+
    '<div style="font-size:12px;color:var(--mt);margin-bottom:10px">O valor da cessão é sempre <b>Valor de Compra + 20%</b>.</div>'+
    '<div class="finrow"><span>Valor de Compra (PBL)</span><span>'+fmt(compra)+'</span></div>'+
    '<div class="finrow big"><span>Valor da venda ao FIDC (+20%)</span><span style="color:var(--green)">'+fmt(valorVenda)+'</span></div>'+
    '<div class="fg" style="margin:12px 0"><label>Data da cessão ao FIDC *</label><input type="date" id="vf-data" value="'+todayStr()+'"/></div>'+
    '<div style="display:flex;justify-content:flex-end;gap:10px"><button class="btn" onclick="var o=document.getElementById(\'vf-ov\');if(o)o.remove()">Cancelar</button><button class="btn bp" onclick="confirmarVenderFidc(\''+id+'\',\''+aqId+'\')">Confirmar venda</button></div></div>';
  document.body.appendChild(ov);
}
async function confirmarVenderFidc(id, aqId){
  var d=document.getElementById('vf-data')?document.getElementById('vf-data').value:'';
  var o=document.getElementById('vf-ov'); if(o)o.remove();
  await venderFidcAq(id, aqId, d||todayStr());
}
// Visão PBL × FIDC em duas linhas, na aba Valores. Só aparece quando há venda ao FIDC:
//  • PBL  — data e valor de compra, data e valor da venda ao FIDC.
//  • FIDC — valor e data adquiridos, Valor Atualizado (o mesmo da capa) e recebimentos.
function aqTimelineHTML(p){
  var arr=procAquisicoes(p);
  var vendidas=arr.filter(function(a){return aqVendaFidc(p,a).vendido;});
  if(!vendidas.length) return ''; // só aparece quando há venda ao FIDC
  var recs=recebOf(p)||[];
  var recCell=recs.length?recs.slice().sort(function(a,b){return String(a.data).localeCompare(String(b.data));}).map(function(r){return '<b style="color:var(--green)">'+fmt(r.valor)+'</b> <span style="color:var(--mt)">('+fmtDate(r.data)+')</span>';}).join('<br>'):'<span style="color:var(--mt)">—</span>';
  var blocos=vendidas.map(function(a){
    var vf=aqVendaFidc(p,a);
    var compraD=a.dataCompra||'', compraV=Number(a.valorCompra)||0;
    var vendaD=vf.data||'', vendaV=Number(vf.valor)||0;
    var cond=Number(a.valorCondenacao)||0;
    var head=(arr.length>1?'<div style="font-size:11px;font-weight:700;color:var(--v);margin:8px 0 3px">'+esc(a.descricao||'Parte')+'</div>':'');
    return head+
      '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:12px;margin-bottom:4px">'+
      '<thead><tr style="background:var(--v);color:#fff">'+
        '<th style="padding:6px 8px;text-align:left">Titular</th>'+
        '<th style="padding:6px 8px">Data</th>'+
        '<th style="padding:6px 8px;text-align:right">Valor (compra/aquisição)</th>'+
        '<th style="padding:6px 8px">Venda ao FIDC</th>'+
        '<th style="padding:6px 8px;text-align:right">Valor Atualizado</th>'+
        '<th style="padding:6px 8px;text-align:left">Recebimento</th>'+
      '</tr></thead><tbody>'+
        '<tr>'+
          '<td style="padding:6px 8px;font-weight:700;color:#1D6B3A;white-space:nowrap">🏛️ PBL</td>'+
          '<td style="padding:6px 8px;text-align:center;white-space:nowrap">'+(compraD?fmtDate(compraD):'—')+'</td>'+
          '<td style="padding:6px 8px;text-align:right">'+fmt(compraV)+'</td>'+
          '<td style="padding:6px 8px;text-align:center;white-space:nowrap">'+(vendaD?fmtDate(vendaD):'—')+' · <b>'+fmt(vendaV)+'</b></td>'+
          '<td style="padding:6px 8px;text-align:right;color:var(--mt)">—</td>'+
          '<td style="padding:6px 8px;color:var(--mt)">—</td>'+
        '</tr>'+
        '<tr style="background:var(--bluel)">'+
          '<td style="padding:6px 8px;font-weight:700;color:#1e5fa8;white-space:nowrap">🏦 FIDC</td>'+
          '<td style="padding:6px 8px;text-align:center;white-space:nowrap">'+(vendaD?fmtDate(vendaD):'—')+'</td>'+
          '<td style="padding:6px 8px;text-align:right"><b>'+fmt(vendaV)+'</b></td>'+
          '<td style="padding:6px 8px;text-align:center;color:var(--mt)">—</td>'+
          '<td style="padding:6px 8px;text-align:right"><b>'+fmt(cond)+'</b></td>'+
          '<td style="padding:6px 8px">'+recCell+'</td>'+
        '</tr>'+
      '</tbody></table></div>';
  }).join('');
  return '<div style="margin-top:12px;border:1px solid #cfe0f5;border-radius:8px;padding:12px;background:#f7fafd">'+
    '<div style="font-weight:700;color:var(--v);font-size:13px;margin-bottom:8px">💠 Cessão ao FIDC — PBL × FIDC</div>'+blocos+
    '<div style="font-size:10.5px;color:var(--mt);margin-top:4px">A <b>PBL</b> comprou e cedeu o crédito ao FIDC (valor da cessão = compra + 20%). O <b>FIDC</b> passa a ser o titular, com a condenação igual à da capa; recebimentos aparecem quando houver.</div>'+
  '</div>';
}
async function venderFidcAq(id, aqId, dataCessao){ if(!canVenderFidc(currentUser)){ showToast('Venda ao FIDC: apenas Evilyn ou Marco têm autorização.'); return; }
  var p=(S.processos||[]).find(function(x){return x.id===id;}); if(!p)return;
  if(!canWriteLiquidacoes(currentUser)){ showToast('Sem permissão para registrar venda.'); return; }
  var arr=procAquisicoes(p).map(function(a){return Object.assign({},a);});
  var aq=null; for(var i=0;i<arr.length;i++){ if(arr[i].id===aqId){aq=arr[i];break;} }
  if(!aq)return;
  if(aqVendaFidc(p,aq).vendido){ showToast('Esta aquisição já foi vendida ao FIDC.'); return; }
  var compra=Number(aq.valorCompra)||0;
  if(compra<=0){ showToast('Preencha o Valor de Compra desta aquisição antes de vender.'); return; }
  var valorVenda=Math.round(compra*1.2*100)/100; var data=dataCessao||todayStr();
  try{
    await upsertLancamento({tipo:'venda',entidade:'PBL',data:data,valor:valorVenda,banco:'',descricao:'Venda ao FIDC — '+aq.descricao+' — proc. '+p.numero,processoId:id,categoria:'Venda ao FIDC',obs:'Aquisição "'+aq.descricao+'" · Valor de Compra '+fmt(compra)+' + 20%'});
    await upsertLancamento({tipo:'compra',entidade:'FIDC',data:data,valor:valorVenda,banco:'',descricao:'Compra da PBL — '+aq.descricao+' — proc. '+p.numero,processoId:id,categoria:'Compra do FIDC',obs:'Aquisição "'+aq.descricao+'" da PBL'});
    S.financeiro=await fetchCollection('lancamentos');
    aq.vendidoFidc=true; aq.dataVendaFidc=data; aq.valorVendaFidc=valorVenda; // cópia p/ exibição
    var vendas=Object.assign({}, procVendasFidc(p)); vendas[aq.id]={valor:valorVenda, data:data}; // fonte da verdade
    if(!await salvarAquisicoes(id, arr, vendas)) return;
    if(todasVendidasFidc(p,arr)){ var dx=Object.assign({},(S.monByProc[id]||{}).dadosExtras||{},{titularidade:'FIDC PBL'}); await procMonSave(id,{dadosExtras:dx}); }
    await procTimelineAdd(id,'venda','Aquisição "'+aq.descricao+'" vendida ao FIDC por '+fmt(valorVenda)+' (Valor de Compra '+fmt(compra)+' + 20%). Entrada no caixa PBL e saída no caixa FIDC.');
    showToast('Aquisição vendida ao FIDC.'); openProcPanel(id);
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}
async function desfazerVendaFidcAq(id, aqId){ if(!canVenderFidc(currentUser)){ showToast('Desfazer venda ao FIDC: apenas Evilyn ou Marco têm autorização.'); return; }
  var p=(S.processos||[]).find(function(x){return x.id===id;}); if(!p)return;
  if(!confirm('Desfazer a venda desta aquisição ao FIDC?'))return;
  var arr=procAquisicoes(p).map(function(a){return Object.assign({},a);});
  var aq=null; for(var i=0;i<arr.length;i++){ if(arr[i].id===aqId){aq=arr[i];break;} }
  if(!aq)return;
  try{
    var alvos=(S.financeiro||[]).filter(function(f){return f.processoId===id && (f.categoria==='Venda ao FIDC'||f.categoria==='Compra do FIDC') && String(f.descricao||'').indexOf(aq.descricao)>=0;});
    for(var k=0;k<alvos.length;k++){ await deleteLancamento(alvos[k].id); }
    S.financeiro=await fetchCollection('lancamentos');
    aq.vendidoFidc=false; aq.dataVendaFidc=''; aq.valorVendaFidc=0; // cópia p/ exibição
    var vendas=Object.assign({}, procVendasFidc(p)); delete vendas[aq.id]; // fonte da verdade
    if(!await salvarAquisicoes(id, arr, vendas)) return;
    if(!(arr||[]).some(function(a){return aqVendaFidc(p,a).vendido;})){ var dx=Object.assign({},(S.monByProc[id]||{}).dadosExtras||{},{titularidade:'PBL Originadora'}); await procMonSave(id,{dadosExtras:dx}); }
    await procTimelineAdd(id,'venda','Venda da aquisição "'+aq.descricao+'" ao FIDC desfeita.');
    showToast('Venda desfeita.'); openProcPanel(id);
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}
function ppVendaFidcBox(id,p){
  var compra=Number(p.valorCompra)||0; var vVenda=Math.round(compra*1.2*100)/100;
  var podeFidc=canVenderFidc(currentUser);
  if(p.vendidoFidc){
    return '<div style="border:1px solid var(--blue);border-radius:8px;padding:12px;margin:10px 0;background:var(--bluel)">'+
      '<div style="font-size:13px;font-weight:700;color:var(--blue)">🏦 Vendido ao FIDC</div>'+
      '<div style="font-size:12px;color:var(--tx);margin-top:4px">Vendido em <b>'+fmtDate(p.dataVendaFidc)+'</b> por <b>'+fmt(p.valorVendaFidc||0)+'</b> — entrada no caixa PBL, saída no caixa FIDC. Liquidado para a PBL; segue aberto no FIDC.</div>'+
      (podeFidc?'<div style="text-align:right;margin-top:8px"><button class="btn" onclick="desfazerVendaFidc(\''+id+'\')">↺ Desfazer venda</button></div>':'')+'</div>';
  }
  return '<div style="border:1px dashed var(--blue);border-radius:8px;padding:12px;margin:10px 0;background:var(--bluel)">'+
    '<div style="font-size:13px;font-weight:700;color:var(--blue);margin-bottom:4px">🏦 Venda ao FIDC (PBL → FIDC)</div>'+
    (compra>0
      ? '<div style="font-size:12px;color:var(--tx)">Valor da venda (Valor de Compra + 20%): <b>'+fmt(vVenda)+'</b> <span style="color:var(--mt)">(Valor de Compra '+fmt(compra)+')</span></div>'+(podeFidc?'<div style="text-align:right;margin-top:8px"><button class="btn bp" onclick="venderFidc(\''+id+'\')">Vender ao FIDC</button></div>':'<div style="text-align:right;margin-top:8px"><span style="font-size:11px;color:var(--mt)">🔒 Venda ao FIDC: autorização apenas de Evilyn ou Marco</span></div>')
      : '<div style="font-size:12px;color:var(--red)">Preencha o <b>Valor de Compra</b> (aba Principal → Editar dados) para calcular e registrar a venda ao FIDC.</div>')+
    '</div>';
}

function pageFinanceiro(){
  var tabs=[['geral','Visão geral'],['contas','Contas'],['lanc','Lançamentos']];
  var bar='<div style="display:flex;gap:4px;background:var(--row-alt);border:1px solid var(--bd);border-radius:8px;padding:4px;width:fit-content;margin-bottom:16px;flex-wrap:wrap">'+tabs.map(function(t){
    var on=_finTab===t[0];
    return '<button class="btn'+(on?' bp':'')+'" style="font-size:13px;padding:6px 16px;border-radius:6px'+(on?'':';background:none')+'" onclick="finSetTab(\''+t[0]+'\')">'+t[1]+'</button>';
  }).join('')+'</div>';
  var body=_finTab==='contas'?(_finConta?finViewExtrato():finViewContas()):_finTab==='lanc'?finViewLanc():finViewGeral();
  return '<div class="page-title">'+I.financeiro+' Financeiro</div>'+bar+body;
}
function finSetTab(t){ _finTab=t; if(t!=='contas')_finConta=''; navigate('financeiro'); }
function finSemConta(){ return (S.financeiro||[]).filter(function(f){return !contaById(f.conta) && finStatus(f)!=='cancelado';}).length; }
function finAvisoSemConta(){
  var n=finSemConta(); if(!n) return '';
  return '<div class="card" style="border-left:4px solid var(--d);margin-bottom:14px;font-size:13px"><strong>'+n+' lançamento'+(n>1?'s':'')+' sem conta.</strong> Não entram no saldo de nenhuma conta. Abra em Lançamentos para identificar a conta.</div>';
}

// ───────── Visão geral ─────────
function finContaCard(c,cs){
  var x=cs[c.id]; var cor=c.entidade==='FIDC'?'gold':c.entidade==='CERTJUD'?'green':'blue';
  return '<div class="mc '+cor+'" style="cursor:pointer" onclick="finAbrirExtrato(\''+c.id+'\')"><div class="ml">'+esc(c.nome)+(c.ativa===false?' (inativa)':'')+'</div><div class="mv '+cor+'">'+fmt(x.saldo)+'</div>'+
    '<div style="font-size:11px;color:var(--mt)">'+esc(c.banco)+(c.agencia?' ag. '+esc(c.agencia):'')+' · '+esc(c.conta)+'</div>'+
    '<div style="font-size:11px;color:var(--mt)">a receber '+fmt(x.prevEnt)+' · a pagar '+fmt(x.prevSai)+'</div></div>';
}
function finViewGeral(){
  var cs=contaSaldos(), contas=(S.contas||[]).filter(function(c){return c.ativa!==false;});
  if(!(S.contas||[]).length) return finViewContasVazio();
  var somaTipo=function(tp){ return contas.filter(function(c){return c.tipo===tp;}).reduce(function(s,c){return s+cs[c.id].saldo;},0); };
  var prev=(S.financeiro||[]).filter(function(f){return finStatus(f)==='previsto' && f.tipo!=='transferencia';});
  var rec=prev.filter(function(f){return f.tipo==='venda';}), pag=prev.filter(function(f){return f.tipo!=='venda';});
  var soma=function(a){ return a.reduce(function(s,f){return s+(Number(f.valor)||0);},0); };
  var venc=prev.filter(finVencido);
  var proximos=prev.slice().sort(function(a,b){return (a.vencimento||a.data||'').localeCompare(b.vencimento||b.data||'');}).slice(0,8).map(function(f){
    return '<tr><td>'+fmtDate(f.vencimento||f.data)+'</td><td>'+finTipoBadge(f)+'</td><td>'+esc(f.descricao)+'</td><td>'+esc(finContaNome(f))+'</td><td class="r" style="color:'+(f.tipo==='venda'?'#1D6B3A':'var(--red)')+'"><strong>'+fmt(f.valor)+'</strong></td><td>'+finStatusBadge(f)+'</td><td><button class="btn" style="font-size:11px;padding:3px 9px" onclick="finModalBaixar(\''+f.id+'\')">Dar baixa</button></td></tr>';
  }).join('');
  var porEmp=FIN_EMPRESAS.map(function(e){ var s=contas.filter(function(c){return c.entidade===e;}).reduce(function(t,c){return t+cs[c.id].saldo;},0); return '<div class="mc"><div class="ml">Saldo '+e+'</div><div class="mv">'+fmt(s)+'</div></div>'; }).join('');
  return finAvisoSemConta()+
    '<div class="metrics">'+
      '<div class="mc blue"><div class="ml">Saldo nas contas operacionais</div><div class="mv blue">'+fmt(somaTipo('operacional'))+'</div></div>'+
      '<div class="mc gold"><div class="ml">A repassar ao fundo (vinculadas)</div><div class="mv gold">'+fmt(somaTipo('vinculada'))+'</div></div>'+
      '<div class="mc green"><div class="ml">A receber (previsto)</div><div class="mv green">'+fmt(soma(rec))+'</div><div style="font-size:11px;color:var(--mt)">'+rec.length+' lançamento'+(rec.length===1?'':'s')+'</div></div>'+
      '<div class="mc red"><div class="ml">A pagar (previsto)</div><div class="mv red">'+fmt(soma(pag))+'</div><div style="font-size:11px;color:var(--mt)">'+pag.length+' lançamento'+(pag.length===1?'':'s')+(venc.length?' · '+venc.length+' vencido'+(venc.length>1?'s':''):'')+'</div></div>'+
    '</div>'+
    '<div class="st">Contas</div><div class="metrics">'+contas.map(function(c){return finContaCard(c,cs);}).join('')+'</div>'+
    '<div class="st">Saldo por empresa</div><div class="metrics">'+porEmp+'</div>'+
    '<div class="st">Próximos vencimentos</div>'+
    '<div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr><th>Vencimento</th><th>Tipo</th><th>Descrição</th><th>Conta</th><th class="r">Valor</th><th>Situação</th><th></th></tr></thead><tbody>'+
    (proximos||'<tr><td colspan="7" class="empty">Nada previsto. Use Lançamentos para registrar contas a pagar e a receber.</td></tr>')+'</tbody></table></div>';
}

// ───────── Contas ─────────
function finViewContasVazio(){
  return '<div class="card" style="text-align:center;padding:36px 20px"><div style="font-size:16px;font-weight:700;margin-bottom:6px">Nenhuma conta cadastrada</div>'+
    '<div style="color:var(--mt);font-size:13px;margin-bottom:16px">As contas são a base do financeiro: todo lançamento sai ou entra em uma conta.</div>'+
    '<button class="btn bp" onclick="finSeedContas()">Cadastrar as 4 contas padrão</button> <button class="btn" onclick="finSetTab(\'contas\');finModalConta(null)">Cadastrar uma conta</button></div>';
}
function finViewContas(){
  var lista=S.contas||[];
  if(!lista.length) return finViewContasVazio();
  var cs=contaSaldos();
  var grupo=function(tp,tit){
    var cx=lista.filter(function(c){return c.tipo===tp;}); if(!cx.length) return '';
    return '<div class="st">'+tit+'</div><div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr><th>Conta</th><th>Banco</th><th>Titular</th><th>Empresa</th><th class="r">Saldo atual</th><th class="r">A receber</th><th class="r">A pagar</th><th></th></tr></thead><tbody>'+
      cx.map(function(c){ var x=cs[c.id];
        return '<tr'+(c.ativa===false?' style="opacity:.55"':'')+'><td><strong>'+esc(c.nome)+'</strong>'+(c.ativa===false?' <span class="badge" style="background:var(--row-alt);color:var(--mt)">Inativa</span>':'')+'</td><td>'+esc(c.banco)+(c.agencia?' · ag. '+esc(c.agencia):'')+' · '+esc(c.conta)+'</td><td>'+esc(c.titular||'')+'</td><td>'+esc(c.entidade)+'</td><td class="r"><strong>'+fmt(x.saldo)+'</strong></td><td class="r">'+fmt(x.prevEnt)+'</td><td class="r">'+fmt(x.prevSai)+'</td>'+
        '<td style="white-space:nowrap"><button class="btn" style="font-size:11px;padding:3px 9px" onclick="finAbrirExtrato(\''+c.id+'\')">Extrato</button> <button class="btn" style="font-size:11px;padding:3px 9px" onclick="finModalConta(\''+c.id+'\')">Editar</button></td></tr>'; }).join('')+'</tbody></table></div>';
  };
  return '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px"><div style="color:var(--mt);font-size:13px">Cadastro e extrato das contas bancárias.</div><button class="btn bp" style="font-size:12px" onclick="finModalConta(null)">+ Nova conta</button></div>'+
    grupo('operacional','Contas operacionais')+grupo('vinculada','Contas vinculadas ao fundo (trânsito)');
}
async function finSeedContas(){
  try{
    for(var i=0;i<FIN_CONTAS_PADRAO.length;i++){ await upsertConta(Object.assign({ativa:true,saldoInicial:0,dataSaldoInicial:''},FIN_CONTAS_PADRAO[i])); }
    S.contas=await fetchCollection('contas'); _finTab='contas'; showToast('Contas cadastradas.'); navigate('financeiro');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}
function finModalConta(id){
  var c=(id?contaById(id):null)||{ativa:true,tipo:'operacional',entidade:'PBL'};
  var opt=function(arr,sel){ return arr.map(function(a){return '<option value="'+a[0]+'"'+(a[0]===sel?' selected':'')+'>'+a[1]+'</option>';}).join(''); };
  showModal('<button class="modal-close" onclick="closeModal()">×</button><div class="modal-title">'+(id?'Editar conta':'Nova conta')+'</div>'+
    '<div class="g2" style="margin-bottom:10px"><div class="fg"><label>Nome da conta *</label><input id="fc-nome" value="'+esc(c.nome||'')+'" placeholder="Ex: PBL Originadora"/></div><div class="fg"><label>Titular</label><input id="fc-titular" value="'+esc(c.titular||'')+'"/></div></div>'+
    '<div class="g3" style="margin-bottom:10px"><div class="fg"><label>Banco *</label><input id="fc-banco" value="'+esc(c.banco||'')+'"/></div><div class="fg"><label>Agência</label><input id="fc-ag" value="'+esc(c.agencia||'')+'"/></div><div class="fg"><label>Conta *</label><input id="fc-conta" value="'+esc(c.conta||'')+'"/></div></div>'+
    '<div class="g2" style="margin-bottom:10px"><div class="fg"><label>Empresa *</label><select id="fc-ent">'+opt(FIN_EMPRESAS.map(function(e){return [e,e];}),c.entidade)+'</select></div>'+
    '<div class="fg"><label>Tipo *</label><select id="fc-tipo">'+opt([['operacional','Operacional (dia a dia)'],['vinculada','Vinculada ao fundo (trânsito)']],c.tipo)+'</select></div></div>'+
    '<div class="g3" style="margin-bottom:14px"><div class="fg"><label>Saldo inicial (R$)</label><input id="fc-si" type="number" step="0.01" value="'+(c.saldoInicial||0)+'"/></div><div class="fg"><label>Data do saldo inicial</label><input id="fc-dsi" type="date" value="'+esc(c.dataSaldoInicial||'')+'"/></div>'+
    '<div class="fg"><label>Situação</label><select id="fc-ativa">'+opt([['1','Ativa'],['0','Inativa']],c.ativa===false?'0':'1')+'</select></div></div>'+
    '<div style="display:flex;justify-content:flex-end;gap:10px"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="finSalvarConta('+(id?'\''+id+'\'':'null')+')">Salvar</button></div>');
}
async function finSalvarConta(id){
  var g=function(k){return (document.getElementById(k).value||'').trim();};
  if(!g('fc-nome')||!g('fc-banco')||!g('fc-conta')){ alert('Preencha Nome, Banco e Conta.'); return; }
  var old=(id?contaById(id):null)||{};
  try{
    await upsertConta(Object.assign({},old,{id:id||undefined,nome:g('fc-nome'),titular:g('fc-titular'),banco:g('fc-banco'),agencia:g('fc-ag'),conta:g('fc-conta'),entidade:g('fc-ent'),tipo:g('fc-tipo'),saldoInicial:parseFloat(g('fc-si'))||0,dataSaldoInicial:g('fc-dsi'),ativa:g('fc-ativa')==='1'}));
    S.contas=await fetchCollection('contas'); closeModal(); showToast('Conta salva.'); navigate('financeiro');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}

// ───────── Extrato da conta ─────────
function finAbrirExtrato(id){ _finTab='contas'; _finConta=id; _finExtDi=''; _finExtDf=''; navigate('financeiro'); }
function finExtFiltro(){ _finExtDi=document.getElementById('fe-di').value; _finExtDf=document.getElementById('fe-df').value; navigate('financeiro'); }
function finViewExtrato(){
  var c=contaById(_finConta); if(!c){ _finConta=''; return finViewContas(); }
  var di=_finExtDi, df=_finExtDf;
  var mov=(S.financeiro||[]).filter(function(f){ return f.conta===c.id && finStatus(f)==='pago' && (!c.dataSaldoInicial||finData(f)>=c.dataSaldoInicial); })
    .sort(function(a,b){ return finData(a).localeCompare(finData(b)); });
  var saldo=Number(c.saldoInicial)||0, abertura=null, ent=0, sai=0, rows='';
  mov.forEach(function(f){
    var v=Number(f.valor)||0, e=finSentido(f)==='entrada', d=finData(f);
    if(di && d<di){ saldo+=e?v:-v; return; }
    if(abertura===null) abertura=saldo;
    if(df && d>df) return;
    saldo+=e?v:-v; if(e)ent+=v; else sai+=v;
    rows+='<tr><td>'+fmtDate(d)+'</td><td>'+esc(f.descricao)+(f.contraparte?' <span style="color:var(--mt);font-size:11px">· '+esc(f.contraparte)+'</span>':'')+'</td><td>'+esc(f.categoria||'')+'</td><td class="r" style="color:#1D6B3A">'+(e?fmt(v):'')+'</td><td class="r" style="color:var(--red)">'+(e?'':fmt(v))+'</td><td class="r"><strong>'+fmt(saldo)+'</strong></td></tr>';
  });
  if(abertura===null) abertura=saldo;
  var prev=(S.financeiro||[]).filter(function(f){return f.conta===c.id && finStatus(f)==='previsto';}).sort(function(a,b){return (a.vencimento||'').localeCompare(b.vencimento||'');});
  var prevRows=prev.map(function(f){ return '<tr><td>'+fmtDate(f.vencimento||f.data)+'</td><td>'+esc(f.descricao)+'</td><td>'+finStatusBadge(f)+'</td><td class="r" style="color:'+(finSentido(f)==='entrada'?'#1D6B3A':'var(--red)')+'">'+fmt(f.valor)+'</td><td><button class="btn" style="font-size:11px;padding:3px 9px" onclick="finModalBaixar(\''+f.id+'\')">Dar baixa</button></td></tr>'; }).join('');
  return '<div style="margin-bottom:12px"><button class="btn" style="font-size:12px" onclick="_finConta=\'\';navigate(\'financeiro\')">← Contas</button></div>'+
    '<div class="card" style="margin-bottom:14px"><div style="font-size:16px;font-weight:700">'+esc(c.nome)+'</div><div style="color:var(--mt);font-size:13px">'+esc(c.banco)+(c.agencia?' · ag. '+esc(c.agencia):'')+' · conta '+esc(c.conta)+' · '+esc(c.titular||'')+' · '+esc(c.entidade)+' · '+(c.tipo==='vinculada'?'vinculada ao fundo':'operacional')+'</div></div>'+
    '<div class="metrics"><div class="mc"><div class="ml">Saldo inicial do período</div><div class="mv">'+fmt(abertura)+'</div></div><div class="mc green"><div class="ml">Entradas</div><div class="mv green">'+fmt(ent)+'</div></div><div class="mc red"><div class="ml">Saídas</div><div class="mv red">'+fmt(sai)+'</div></div><div class="mc blue"><div class="ml">Saldo final</div><div class="mv blue">'+fmt(abertura+ent-sai)+'</div></div></div>'+
    '<div class="filter-bar no-print"><div class="fg"><label>Data início</label><input type="date" id="fe-di" value="'+esc(di)+'" onchange="finExtFiltro()"/></div><div class="fg"><label>Data fim</label><input type="date" id="fe-df" value="'+esc(df)+'" onchange="finExtFiltro()"/></div><button class="print-btn" onclick="window.print()">Imprimir</button></div>'+
    '<div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr><th>Data</th><th>Descrição</th><th>Categoria</th><th class="r">Entrada</th><th class="r">Saída</th><th class="r">Saldo</th></tr></thead><tbody>'+
    '<tr style="background:var(--row-alt)"><td colspan="5"><em>Saldo inicial</em></td><td class="r"><strong>'+fmt(abertura)+'</strong></td></tr>'+(rows||'<tr><td colspan="6" class="empty">Nenhuma movimentação no período.</td></tr>')+'</tbody></table></div>'+
    (prev.length?'<div class="st">Previstos nesta conta</div><div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr><th>Vencimento</th><th>Descrição</th><th>Situação</th><th class="r">Valor</th><th></th></tr></thead><tbody>'+prevRows+'</tbody></table></div>':'');
}

// ───────── Lançamentos ─────────
function finLancFiltrados(){
  var F=_finF, q=(F.q||'').toLowerCase();
  return (S.financeiro||[]).filter(function(f){
    var st=finStatus(f), v=F.vis;
    if(v==='todos'&&st==='cancelado') return false;
    if(v==='receber'&&!(f.tipo==='venda'&&st==='previsto')) return false;
    if(v==='pagar'&&!(st==='previsto'&&(f.tipo==='compra'||f.tipo==='despesa'||f.tipo==='repasse'))) return false;
    if(v==='transf'&&f.tipo!=='transferencia') return false;
    if(v==='repasse'&&f.tipo!=='repasse') return false;
    if(v==='realizados'&&st!=='pago') return false;
    if(v==='cancelados'&&st!=='cancelado') return false;
    if(F.conta&&f.conta!==F.conta) return false;
    var d=finData(f); if(F.di&&d<F.di) return false; if(F.df&&d>F.df) return false;
    if(q&&!((f.descricao||'')+' '+(f.contraparte||'')+' '+(f.obs||'')).toLowerCase().includes(q)) return false;
    return true;
  }).sort(function(a,b){ return finData(b).localeCompare(finData(a)); });
}
function finLancRow(f){
  var st=finStatus(f), ent=finSentido(f)==='entrada';
  var proc=f.processoId?(S.processos.find(function(p){return p.id===f.processoId;})||{numero:'—'}).numero:'';
  var acoes='';
  if(st==='previsto') acoes+='<button class="btn" style="font-size:11px;padding:3px 8px" onclick="finModalBaixar(\''+f.id+'\')">Dar baixa</button> ';
  if(st==='previsto'&&f.tipo!=='transferencia') acoes+='<button class="btn" style="font-size:11px;padding:3px 8px" onclick="finModalLanc(\''+f.id+'\')">Editar</button> ';
  if(st!=='cancelado') acoes+='<button class="btn" style="font-size:11px;padding:3px 8px" onclick="finCancelar(\''+f.id+'\')">'+(st==='pago'?'Estornar':'Cancelar')+'</button>';
  return '<tr'+(st==='cancelado'?' style="opacity:.5"':'')+'><td>'+fmtDate(f.vencimento||f.data)+(st==='pago'&&f.dataBaixa&&f.dataBaixa!==f.vencimento?'<div style="font-size:10px;color:var(--mt)">baixa '+fmtDate(f.dataBaixa)+'</div>':'')+'</td><td>'+finTipoBadge(f)+'</td><td>'+esc(f.descricao)+(f.contraparte?'<div style="font-size:11px;color:var(--mt)">'+esc(f.contraparte)+'</div>':'')+(st==='cancelado'&&f.motivoCancelamento?'<div style="font-size:11px;color:var(--mt)">Motivo: '+esc(f.motivoCancelamento)+'</div>':'')+'</td><td style="font-size:11px">'+esc(proc||'—')+'</td><td>'+esc(finContaNome(f))+'</td><td>'+esc(f.categoria||'')+'</td><td class="r" style="color:'+(ent?'#1D6B3A':'var(--red)')+'"><strong>'+(ent?'':'− ')+fmt(f.valor)+'</strong></td><td>'+finStatusBadge(f)+'</td><td style="white-space:nowrap">'+acoes+'</td></tr>';
}
function finLancTabela(){
  var l=finLancFiltrados();
  var e=0,s=0; l.forEach(function(f){ if(finStatus(f)==='cancelado'||f.tipo==='transferencia')return; if(finSentido(f)==='entrada')e+=Number(f.valor)||0; else s+=Number(f.valor)||0; });
  return {rows:l.map(finLancRow).join('')||'<tr><td colspan="9" class="empty">Nenhum lançamento encontrado.</td></tr>',resumo:l.length+' lançamento'+(l.length===1?'':'s')+' · entradas '+fmt(e)+' · saídas '+fmt(s)+' <span style="color:var(--mt)">(transferências não somam)</span>'};
}
function finSetVis(v){ _finF.vis=v; navigate('financeiro'); }
function finFiltrar(){
  _finF.conta=document.getElementById('fl-f-conta').value; _finF.di=document.getElementById('fl-f-di').value; _finF.df=document.getElementById('fl-f-df').value; _finF.q=document.getElementById('fl-f-q').value;
  var t=finLancTabela(); document.getElementById('fl-tbody').innerHTML=t.rows; document.getElementById('fl-resumo').innerHTML=t.resumo;
}
function finViewLanc(){
  if(!(S.contas||[]).length) return finViewContasVazio();
  var chips=[['todos','Todos'],['receber','A receber'],['pagar','A pagar'],['transf','Transferências'],['repasse','Repasses'],['realizados','Realizados'],['cancelados','Cancelados']];
  var t=finLancTabela();
  var contaOpts=(S.contas||[]).map(function(c){return '<option value="'+c.id+'"'+(_finF.conta===c.id?' selected':'')+'>'+esc(c.nome)+'</option>';}).join('');
  return finAvisoSemConta()+
    '<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:12px"><div style="display:flex;gap:6px;flex-wrap:wrap">'+chips.map(function(c){ var on=_finF.vis===c[0]; return '<button class="btn'+(on?' bp':'')+'" style="font-size:12px;padding:5px 12px" onclick="finSetVis(\''+c[0]+'\')">'+c[1]+'</button>'; }).join('')+'</div>'+
    '<button class="btn bp" style="font-size:12px" onclick="finModalLanc(null)">+ Novo lançamento</button></div>'+
    '<div class="filter-bar no-print"><div class="fg" style="max-width:220px"><label>Conta</label><select id="fl-f-conta" onchange="finFiltrar()"><option value="">Todas</option>'+contaOpts+'</select></div>'+
    '<div class="fg"><label>De</label><input type="date" id="fl-f-di" value="'+esc(_finF.di)+'" onchange="finFiltrar()"/></div><div class="fg"><label>Até</label><input type="date" id="fl-f-df" value="'+esc(_finF.df)+'" onchange="finFiltrar()"/></div>'+
    '<input class="search-input" id="fl-f-q" value="'+esc(_finF.q)+'" placeholder="Buscar descrição, contraparte, observação..." oninput="finFiltrar()"/><button class="print-btn" onclick="window.print()">Imprimir</button></div>'+
    '<div id="fl-resumo" style="font-size:12px;margin:0 0 8px 2px">'+t.resumo+'</div>'+
    '<div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr><th>Vencimento</th><th>Tipo</th><th>Descrição</th><th>Processo</th><th>Conta</th><th>Categoria</th><th class="r">Valor</th><th>Situação</th><th>Ação</th></tr></thead><tbody id="fl-tbody">'+t.rows+'</tbody></table></div>';
}

// ───────── Novo / editar lançamento ─────────
function finContasOpts(sel,soVinculadas){
  return (S.contas||[]).filter(function(c){ return (c.ativa!==false||c.id===sel) && (!soVinculadas||c.tipo==='vinculada'); })
    .map(function(c){return '<option value="'+c.id+'"'+(c.id===sel?' selected':'')+'>'+esc(c.nome)+' — '+esc(c.banco)+' '+esc(c.conta)+'</option>';}).join('');
}
function finModalLanc(id){
  if(!(S.contas||[]).length){ showToast('Cadastre as contas primeiro.'); _finTab='contas'; navigate('financeiro'); return; }
  var f=(id?(S.financeiro||[]).find(function(x){return x.id===id;}):null)||{};
  var tipo=f.tipo||'despesa', pago=id?finStatus(f)==='pago':false;
  var procOpts=(S.processos||[]).map(function(p){return '<option value="'+p.id+'"'+(p.id===f.processoId?' selected':'')+'>'+esc(p.numero)+' — '+esc(p.cliente)+'</option>';}).join('');
  var contrapartes=Array.from(new Set((S.financeiro||[]).map(function(x){return x.contraparte;}).filter(Boolean)));
  var tipoOpts=Object.keys(FIN_TIPO_LBL).map(function(k){return '<option value="'+k+'"'+(k===tipo?' selected':'')+'>'+FIN_TIPO_LBL[k]+'</option>';}).join('');
  var blk=function(t){ return '<div class="st" style="margin:14px 0 8px">'+t+'</div>'; };
  showModal('<button class="modal-close" onclick="closeModal()">×</button><div class="modal-title">'+(id?'Editar lançamento':'Novo lançamento')+'</div>'+
    blk('O quê')+
    '<div class="g2" style="margin-bottom:10px"><div class="fg"><label>Tipo *</label><select id="fl-tipo" onchange="finLancTipoChange()"'+(id?' disabled':'')+'>'+tipoOpts+'</select></div><div class="fg" style="grid-column:span 1"><label>Descrição *</label><input id="fl-desc" value="'+esc(f.descricao||'')+'" placeholder="Ex: Custas de cartório — proc. 0848128"/></div></div>'+
    '<div class="g2" style="margin-bottom:6px"><div class="fg" id="fl-g-contra"><label>Contraparte (quem paga / recebe)</label><input id="fl-contra" list="fl-contra-list" value="'+esc(f.contraparte||'')+'"/><datalist id="fl-contra-list">'+contrapartes.map(function(c){return '<option value="'+esc(c)+'">';}).join('')+'</datalist></div>'+
    '<div class="fg" id="fl-g-proc"><label>Processo vinculado</label><select id="fl-proc"><option value="">Nenhum</option>'+procOpts+'</select></div></div>'+
    blk('Quanto e quando')+
    '<div class="g4" style="margin-bottom:6px"><div class="fg"><label>Valor (R$) *</label><input id="fl-valor" type="number" min="0" step="0.01" value="'+(f.valor||'')+'"/></div><div class="fg"><label>Competência</label><input id="fl-comp" type="month" value="'+esc(f.competencia||todayStr().slice(0,7))+'"/></div><div class="fg" id="fl-g-venc"><label>Vencimento *</label><input id="fl-venc" type="date" value="'+esc(f.vencimento||f.data||todayStr())+'"/></div><div class="fg" id="fl-g-parc"><label>Parcelas</label><input id="fl-parc" type="number" min="1" max="60" value="1"'+(id?' disabled':'')+'/></div></div>'+
    blk('Classificação e conta')+
    '<div class="g2" style="margin-bottom:6px"><div class="fg"><label>Categoria</label><select id="fl-cat"></select></div><div class="fg"><label>Forma</label><select id="fl-forma">'+FIN_FORMAS.map(function(x){return '<option'+(x===f.forma?' selected':'')+'>'+x+'</option>';}).join('')+'</select></div></div>'+
    '<div class="g2" style="margin-bottom:6px"><div class="fg"><label id="fl-lbl-conta">Conta *</label><select id="fl-conta"></select></div><div class="fg" id="fl-g-dest"><label>Conta de destino *</label><select id="fl-dest"><option value="">Selecione…</option>'+finContasOpts('')+'</select></div></div>'+
    '<div id="fl-repasse-note" style="display:none;font-size:12px;color:var(--mt);margin-bottom:6px">Destino do repasse: conta principal do fundo (não controlada aqui). A saída só pode partir de uma conta vinculada.</div>'+
    blk('Situação')+
    '<div class="g3" style="margin-bottom:6px"><div class="fg" style="justify-content:flex-end"><label style="display:flex;gap:8px;align-items:center;text-transform:none;letter-spacing:0"><input type="checkbox" id="fl-pago" onchange="finLancPagoChange()"'+(pago?' checked':'')+'/> Já foi pago/recebido</label></div><div class="fg" id="fl-g-baixa"><label>Data da baixa</label><input id="fl-baixa" type="date" value="'+esc(f.dataBaixa||todayStr())+'"/></div></div>'+
    '<div class="fg" style="margin:10px 0 14px"><label>Observação</label><input id="fl-obs" value="'+esc(f.obs||'')+'"/></div>'+
    '<div style="display:flex;justify-content:flex-end;gap:10px"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="finSalvarLanc('+(id?'\''+id+'\'':'null')+')">Salvar</button></div>',{wide:true});
  window._finEditConta=f.conta||''; window._finEditCat=f.categoria||'';
  finLancTipoChange(); finLancPagoChange();
}
function finLancTipoChange(){
  var t=document.getElementById('fl-tipo').value, el=function(i){return document.getElementById(i);};
  var cat=el('fl-cat'), selCat=cat.value||window._finEditCat||'';
  cat.innerHTML=FIN_CATS[t].map(function(x){return '<option'+(x===selCat?' selected':'')+'>'+x+'</option>';}).join('');
  var cs=el('fl-conta'), selC=cs.value||window._finEditConta||'';
  cs.innerHTML=(t==='repasse'?'':'<option value="">Selecione…</option>')+finContasOpts(selC,t==='repasse');
  var show=function(i,on){ el(i).style.display=on?'':'none'; };
  show('fl-g-contra',t!=='transferencia'); show('fl-g-proc',t!=='transferencia'&&t!=='repasse'); show('fl-g-dest',t==='transferencia'); show('fl-repasse-note',t==='repasse');
  el('fl-lbl-conta').textContent=(t==='transferencia'||t==='repasse')?'Conta de origem *':'Conta *';
  finLancPagoChange();
}
function finLancPagoChange(){
  var pago=document.getElementById('fl-pago').checked, t=document.getElementById('fl-tipo').value;
  document.getElementById('fl-g-baixa').style.display=pago?'':'none';
  var parc=document.getElementById('fl-g-parc'); parc.style.display=(pago||t==='transferencia'||t==='repasse')?'none':'';
}
async function finSalvarLanc(id){
  var g=function(k){var e=document.getElementById(k);return e?(e.value||'').trim():'';};
  var tipo=id?(S.financeiro.find(function(x){return x.id===id;})||{}).tipo:g('fl-tipo');
  var valor=parseFloat(g('fl-valor'))||0, pago=document.getElementById('fl-pago').checked, venc=g('fl-venc'), baixa=pago?g('fl-baixa'):'';
  var conta=contaById(g('fl-conta')), dest=tipo==='transferencia'?contaById(g('fl-dest')):null;
  if(!g('fl-desc')||valor<=0||!conta){ alert('Preencha Descrição, Valor e Conta.'); return; }
  if(!venc&&!baixa){ alert('Informe o vencimento.'); return; }
  if(pago&&!baixa){ alert('Informe a data da baixa.'); return; }
  if(tipo==='transferencia'&&(!dest||dest.id===conta.id)){ alert('Escolha uma conta de destino diferente da origem.'); return; }
  if(tipo==='repasse'&&conta.tipo!=='vinculada'){ alert('O repasse ao fundo sai de uma conta vinculada.'); return; }
  var base={tipo:tipo,descricao:g('fl-desc'),valor:valor,contraparte:tipo==='transferencia'?'':g('fl-contra'),processoId:(tipo==='transferencia'||tipo==='repasse')?'':g('fl-proc'),categoria:g('fl-cat'),forma:g('fl-forma'),obs:g('fl-obs'),
    competencia:g('fl-comp')||(venc||baixa).slice(0,7),vencimento:venc||baixa,status:pago?'pago':'previsto',dataBaixa:baixa,data:baixa||venc};
  var porConta=function(c,extra){ return Object.assign({},base,{conta:c.id,entidade:c.entidade,banco:c.nome},extra||{}); };
  var parcelas=(!id&&!pago&&tipo!=='transferencia'&&tipo!=='repasse')?Math.max(1,Math.min(60,parseInt(g('fl-parc'),10)||1)):1;
  try{
    if(id){
      var old=S.financeiro.find(function(x){return x.id===id;});
      await upsertLancamento(Object.assign({},old,porConta(conta),{id:id}));
    } else if(tipo==='transferencia'){
      var grupo=finNovoId('lancamentos');
      await upsertLancamento(porConta(conta,{sentido:'saida',grupoId:grupo,descricao:base.descricao+' → '+dest.nome}));
      await upsertLancamento(porConta(dest,{sentido:'entrada',grupoId:grupo,descricao:base.descricao+' ← '+conta.nome}));
    } else if(parcelas>1){
      var total=Math.round(valor*100), cada=Math.floor(total/parcelas), d0=new Date(venc+'T00:00:00');
      for(var i=0;i<parcelas;i++){
        var d=new Date(d0.getFullYear(),d0.getMonth()+i,d0.getDate()); if(d.getDate()!==d0.getDate()) d=new Date(d0.getFullYear(),d0.getMonth()+i+1,0);
        var ds=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
        var v=(i===parcelas-1?total-cada*(parcelas-1):cada)/100;
        await upsertLancamento(porConta(conta,{valor:v,vencimento:ds,data:ds,competencia:ds.slice(0,7),descricao:base.descricao+' ('+(i+1)+'/'+parcelas+')',parcela:(i+1)+'/'+parcelas}));
      }
    } else { await upsertLancamento(porConta(conta)); }
    S.financeiro=await fetchCollection('lancamentos'); closeModal(); showToast('Lançamento salvo.'); navigate('financeiro');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}

// ───────── Baixa e cancelamento ─────────
function finModalBaixar(id){
  var f=(S.financeiro||[]).find(function(x){return x.id===id;}); if(!f) return;
  var ent=finSentido(f)==='entrada';
  showModal('<button class="modal-close" onclick="closeModal()">×</button><div class="modal-title">Dar baixa — '+(ent?'recebimento':'pagamento')+'</div>'+
    '<div style="font-size:13px;color:var(--mt);margin-bottom:12px">'+esc(f.descricao)+' · vencimento '+fmtDate(f.vencimento||f.data)+'</div>'+
    '<div class="g3" style="margin-bottom:14px"><div class="fg"><label>Data da baixa *</label><input id="fb-data" type="date" value="'+todayStr()+'"/></div><div class="fg"><label>Valor efetivo (R$) *</label><input id="fb-valor" type="number" step="0.01" min="0" value="'+(Number(f.valor)||0)+'"/></div><div class="fg"><label>Conta *</label><select id="fb-conta">'+finContasOpts(f.conta)+'</select></div></div>'+
    '<div style="display:flex;justify-content:flex-end;gap:10px"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="finConfirmarBaixa(\''+id+'\')">Confirmar baixa</button></div>');
}
async function finConfirmarBaixa(id){
  var f=(S.financeiro||[]).find(function(x){return x.id===id;}); if(!f) return;
  var data=document.getElementById('fb-data').value, valor=parseFloat(document.getElementById('fb-valor').value)||0, c=contaById(document.getElementById('fb-conta').value);
  if(!data||valor<=0||!c){ alert('Preencha data, valor e conta.'); return; }
  try{
    var upd=Object.assign({},f,{status:'pago',dataBaixa:data,data:data,valor:valor,conta:c.id,entidade:c.entidade,banco:c.nome});
    if(valor!==(Number(f.valor)||0)) upd.valorOriginal=Number(f.valorOriginal!=null?f.valorOriginal:f.valor)||0;
    await upsertLancamento(upd);
    S.financeiro=await fetchCollection('lancamentos'); closeModal(); showToast('Baixa registrada.'); navigate('financeiro');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}
async function finCancelar(id){
  var f=(S.financeiro||[]).find(function(x){return x.id===id;}); if(!f) return;
  var pago=finStatus(f)==='pago';
  var motivo=prompt((pago?'Estornar':'Cancelar')+' este lançamento. Informe o motivo:'); if(motivo===null) return;
  if(!motivo.trim()){ alert('O motivo é obrigatório.'); return; }
  var alvos=f.grupoId?(S.financeiro||[]).filter(function(x){return x.grupoId===f.grupoId;}):[f];
  try{
    for(var i=0;i<alvos.length;i++){ await upsertLancamento(Object.assign({},alvos[i],{status:'cancelado',motivoCancelamento:motivo.trim(),canceladoEm:todayStr(),canceladoPor:currentUser.id,statusAnterior:finStatus(alvos[i])})); }
    S.financeiro=await fetchCollection('lancamentos'); showToast(pago?'Lançamento estornado.':'Lançamento cancelado.'); navigate('financeiro');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}

// ════════════════════════════════════════════════════════════
// FLUXO DE CAIXA
// ════════════════════════════════════════════════════════════
function pageFluxoCaixa(){
  // agrupar por mês
  var byMes={};
  S.financeiro.forEach(function(f){
    if(!f.data||!finRealizado(f))return;
    var mes=f.data.slice(0,7);
    if(!byMes[mes])byMes[mes]={entradas:0,saidas:0,items:[]};
    if(f.tipo==='venda')byMes[mes].entradas+=f.valor||0;
    else byMes[mes].saidas+=f.valor||0;
    byMes[mes].items.push(f);
  });
  var meses=Object.keys(byMes).sort().reverse();
  var tEntradas=meses.reduce(function(s,m){return s+byMes[m].entradas;},0);
  var tSaidas=meses.reduce(function(s,m){return s+byMes[m].saidas;},0);
  var tSaldo=tEntradas-tSaidas;
  var rows=meses.map(function(m){
    var mb=byMes[m];var saldo=mb.entradas-mb.saidas;
    var dt=new Date(m+'-02');var label=dt.toLocaleDateString('pt-BR',{month:'long',year:'numeric'});
    return'<tr>'+
      '<td style="font-weight:600">'+label+'</td>'+
      '<td class="r fc-in">'+fmt(mb.entradas)+'</td>'+
      '<td class="r fc-out">'+fmt(mb.saidas)+'</td>'+
      '<td class="r"><span class="'+(saldo>=0?'fc-saldo-pos':'fc-saldo-neg')+'">'+fmt(saldo)+'</span></td>'+
      '<td><button class="btn bsm" onclick="detalharMes(\''+m+'\')">Ver detalhes</button></td>'+
    '</tr>';
  }).join('');

  return'<div class="page-title">'+I.fluxo+' Fluxo de Caixa</div>'+
  '<div class="metrics">'+
    '<div class="mc green"><div class="ml">Total Entradas (Vendas FIDC)</div><div class="mv green">'+fmt(tEntradas)+'</div></div>'+
    '<div class="mc red"><div class="ml">Total Saídas (Compras + Desp.)</div><div class="mv red">'+fmt(tSaidas)+'</div></div>'+
    '<div class="mc '+(tSaldo>=0?'':'red')+'"><div class="ml">Saldo Acumulado</div><div class="mv '+(tSaldo>=0?'':'red')+'">'+fmt(tSaldo)+'</div></div>'+
    '<div class="mc blue"><div class="ml">Períodos registrados</div><div class="mv blue">'+meses.length+'</div></div>'+
  '</div>'+
  (meses.length?
  '<div class="card" style="padding:0;overflow-x:auto">'+
    '<table class="tbl"><thead><tr><th>Período</th><th class="r">Entradas (Vendas FIDC)</th><th class="r">Saídas (Compras + Despesas)</th><th class="r">Saldo</th><th>Detalhe</th></tr></thead>'+
    '<tbody>'+rows+'</tbody>'+
    '<tfoot><tr class="foot"><td>Total</td><td class="r">'+fmt(tEntradas)+'</td><td class="r">'+fmt(tSaidas)+'</td><td class="r">'+fmt(tSaldo)+'</td><td></td></tr></tfoot>'+
  '</table></div>'+
  '<div id="fc-detalhe"></div>'
  :'<div class="card"><div class="empty">Nenhum lançamento registrado ainda. Acesse Financeiro para registrar compras, vendas e despesas.</div></div>');
}
function detalharMes(mes){
  var items=S.financeiro.filter(function(f){return f.data&&f.data.startsWith(mes)&&finRealizado(f);}).sort(function(a,b){return(a.data||'').localeCompare(b.data||'');});
  var dt=new Date(mes+'-02');var label=dt.toLocaleDateString('pt-BR',{month:'long',year:'numeric'});
  var rows=items.map(function(f){
    var tb=finTipoBadge(f);
    var cor=f.tipo==='venda'?'#1D6B3A':'var(--red)';
    return'<tr><td>'+fmtDate(f.data)+'</td><td>'+tb+'</td><td>'+esc(f.descricao)+'</td><td>'+esc(f.banco||'')+'</td><td class="r" style="color:'+cor+'">'+fmt(f.valor)+'</td><td style="font-size:11px">'+esc(f.obs||'')+'</td></tr>';
  }).join('');
  document.getElementById('fc-detalhe').innerHTML=
    '<div class="st">Detalhamento — '+label+'</div>'+
    '<div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr><th>Data</th><th>Tipo</th><th>Descrição</th><th>Banco</th><th class="r">Valor</th><th>Obs.</th></tr></thead><tbody>'+rows+'</tbody></table></div>';
}

// ════════════════════════════════════════════════════════════
// OPERACIONAL
// ════════════════════════════════════════════════════════════
function pageOperacional(){
  var lopts=S.lawyers.map(function(l){return'<option value="'+l.id+'">'+l.name+'</option>';}).join('');
  var list=!S.lawyers.length?'<div class="empty">Nenhum advogado cadastrado.</div>':
    S.lawyers.map(function(l,i){
      return'<div class="lrow"><div class="av" style="'+avSt(i)+'">'+ini(l.name)+'</div>'+
        '<div class="ln">'+l.name+(l.active===false?' <span style="font-size:10px;color:#999;font-style:italic">(inativo)</span>':'')+'</div>'+
        '<div style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--mt)">Pró-labore: '+
          '<input type="number" min="0" step="100" value="'+(l.prolabore||0)+'" data-lawyer-id="'+esc(l.id)+'" style="width:110px" onchange="updateLawyerProlabore(\''+l.id+'\', this.value)"/>'+
        '</div>'+
      '</div>';
    }).join('');
  return'<div class="page-title">'+I.operacional+' Lançamentos Operacionais</div>'+
  '<div class="st">Advogados cadastrados <span style="font-size:11px;color:var(--mt);font-weight:400">(novos advogados são criados via "+ Adicionar Usuário" na aba Usuários)</span></div>'+
  '<div class="card">'+list+'</div>'+
  '<div class="st">Importar produção via planilha</div>'+
  '<div class="card">'+
    '<p style="font-size:12px;color:var(--mt);margin-bottom:14px">Importe as planilhas mensais — o sistema distribui automaticamente para cada advogado.</p>'+
    '<label class="imp" for="file-liq-g"><input type="file" id="file-liq-g" class="fhide" accept=".xlsx,.xls" onchange="importLiqGeral(this)"/>'+
    '<div class="imp-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zM8 17l-3-3 1.4-1.4 1.6 1.6 3.6-3.6L13 11l-5 6z"/></svg></div>'+
    '<div class="imp-text"><div class="imp-title">Importar Liquidados</div><div class="imp-sub">Colunas: ADVOGADO · PROCESSOS · VALOR · LIQUIDAÇÃO</div></div><span class="imp-status" id="s-liq">Nenhum arquivo</span></label>'+
    '<label class="imp" for="file-val-g"><input type="file" id="file-val-g" class="fhide" accept=".xlsx,.xls" onchange="importValGeral(this)"/>'+
    '<div class="imp-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zM8 17l-3-3 1.4-1.4 1.6 1.6 3.6-3.6L13 11l-5 6z"/></svg></div>'+
    '<div class="imp-text"><div class="imp-title">Importar Validação / Distribuição</div><div class="imp-sub">Colunas: ADVOGADO · OBS</div></div><span class="imp-status" id="s-val">Nenhum arquivo</span></label>'+
    '<label class="imp" for="file-dil-g"><input type="file" id="file-dil-g" class="fhide" accept=".xlsx,.xls" onchange="importDilGeral(this)"/>'+
    '<div class="imp-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zM8 17l-3-3 1.4-1.4 1.6 1.6 3.6-3.6L13 11l-5 6z"/></svg></div>'+
    '<div class="imp-text"><div class="imp-title">Importar Diligências (Capa a Capa)</div><div class="imp-sub">Colunas: VAL. · VALOR · CONTRATO</div></div><span class="imp-status" id="s-dil">Nenhum arquivo</span></label>'+
  '</div>'+
  '<div class="st">Ajuste manual por advogado</div>'+
  '<div class="card">'+
    '<div class="g4" style="margin-bottom:10px">'+
      '<div class="fg"><label>Advogado</label><select id="sel-man"><option value="">Selecione...</option>'+lopts+'</select></div>'+
      '<div class="fg"><label>Proc. Validados (qtd)</label><input type="number" id="man-pv" min="0" placeholder="0"/></div>'+
      '<div class="fg"><label>Contr. Validados (qtd)</label><input type="number" id="man-cv" min="0" placeholder="0"/></div>'+
      '<div class="fg"><label>Capa a Capa (qtd)</label><input type="number" id="man-capa" min="0" placeholder="0"/></div>'+
    '</div>'+
    '<div class="g4">'+
      '<div class="fg"><label>Auditoria (qtd)</label><input type="number" id="man-au" min="0" placeholder="0"/></div>'+
      '<div class="fg"><label>Vol. Entradas (R$)</label><input type="number" id="man-ve" min="0" step="0.01" placeholder="0,00"/></div>'+
      '<div class="fg"><label>Vol. Liquidado (R$)</label><input type="number" id="man-vl" min="0" step="0.01" placeholder="0,00"/></div>'+
      '<div style="display:flex;align-items:flex-end"><button class="btn bp" onclick="saveManual()" style="width:100%">Salvar ajuste</button></div>'+
    '</div>'+
  '</div>';
}
async function updateLawyerProlabore(id, valor){
  if(!isFullAccess(currentUser)){showToast('Sem permiss\u00e3o.');return;}
  var v = parseFloat(valor)||0;
  if(v < 0){showToast('Pr\u00f3-labore n\u00e3o pode ser negativo.');return;}
  try{
    await fb.updateDoc(fb.doc(fb.db,'lawyers',id), {prolabore:v, updatedAt: fb.serverTimestamp(), updatedBy: currentUser.id});
    var l = S.lawyers.find(function(x){return x.id===id;});
    if(l) l.prolabore = v;
    showToast('Pr\u00f3-labore atualizado.');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}
function importLiqGeral(input){
  if(!input.files.length)return;
  var reader=new FileReader();
  reader.onload=async function(e){
    var wb=XLSX.read(e.target.result,{type:'array',cellDates:true});
    var ws=wb.Sheets[wb.SheetNames[0]];
    var rows=XLSX.utils.sheet_to_json(ws,{defval:''});
    var keys=rows.length>0?Object.keys(rows[0]):[];
    var byAdv={},dashArr=[],relArr=[];
    rows.forEach(function(r){
      var getCol=function(subs){var v='';keys.forEach(function(k){var kn=k.toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');subs.forEach(function(s){if(kn.includes(s)&&!v)v=String(r[k]||'').trim();});});return v;};
      var getNum=function(subs){var v=0;keys.forEach(function(k){var kn=k.toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');subs.forEach(function(s){if(kn.includes(s)&&!v)v=parseFloat(r[k])||0;});});return v;};
      var adv=getCol(['ADVOGADO']).toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
      var val=getNum(['VALOR']);
      var liq=getCol(['LIQUIDACAO','LIQUIDAAO','LIQUID']);
      var proc=getCol(['PROCESSO']);
      var datRaw=getCol(['DATA']);var dat='';
      if(datRaw){try{var dd=new Date(datRaw);if(!isNaN(dd))dat=dd.toISOString().slice(0,10);}catch(ex){}}
      if(!adv||adv==='ADVOGADO')return;
      var tipo=liq.toUpperCase().includes('PARCIAL')?'Parcial':'Total';
      if(!byAdv[adv])byAdv[adv]=[];
      byAdv[adv].push({ref:proc,valor:val,tipo:tipo});
      dashArr.push({adv:adv,val:val,tipo:tipo});
      relArr.push({adv:adv,advNome:adv.charAt(0)+adv.slice(1).toLowerCase(),proc:proc,val:val,tipo:tipo,data:dat});
    });
    var matched=0,total=0;
    var batch=fb.writeBatch(fb.db);
    S.lawyers.forEach(function(l){
      var key=l.name.toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
      var fn2=key.split(' ')[0];
      var foundKey=Object.keys(byAdv).find(function(k){return k===key||fn2===k||fn2.startsWith(k.split(' ')[0])||k.startsWith(fn2);});
      if(foundKey){
        if(!S.entries[l.id])S.entries[l.id]={processos:[],procValid:0,contValid:0,capaCapa:0,auditoria:0,volEntradas:0,volLiquidado:0};
        S.entries[l.id].processos=byAdv[foundKey];
        S.entries[l.id].volLiquidado=byAdv[foundKey].reduce(function(s,p){return s+p.valor;},0);
        batch.set(fb.doc(fb.db,'entries',l.id), {id:l.id,processos:byAdv[foundKey],volLiquidado:S.entries[l.id].volLiquidado,updatedAt:fb.serverTimestamp(),updatedBy:currentUser.id}, {merge:true});
        matched++;total+=byAdv[foundKey].length;
      }
    });
    try{ if(matched>0) await batch.commit(); }catch(err){ console.error(err); }
    S.dashData=dashArr;relLiqImportData=relArr;
    var el=document.getElementById('s-liq');if(el)el.textContent=total+' proc · '+matched+' adv';
    showToast(total+' processos para '+matched+' advogados!');input.value='';
  };
  reader.readAsArrayBuffer(input.files[0]);
}
function importValGeral(input){
  if(!input.files.length)return;
  readXlsx(input.files[0], async function(rows){
    var byAdv={};
    rows.forEach(function(r){
      var adv=normAdv(r['ADVOGADO']||r[2]||'');
      var obs=String(r['OBS']||r[3]||'').toUpperCase();
      if(!adv||adv==='ADVOGADO')return;
      if(!byAdv[adv])byAdv[adv]={pv:0,cv:0};
      if(obs.includes('VALIDADO')&&!obs.includes('NAO APROVADO')&&!obs.includes('NÃO APROVADO')&&!obs.includes('FALTA CONTRATO')){
        if(obs.includes('CONTRATO'))byAdv[adv].cv++;else byAdv[adv].pv++;
      }
    });
    var matched=0;
    var batch=fb.writeBatch(fb.db);
    S.lawyers.forEach(function(l){
      var key=normAdv(l.name);
      var fn=key.split(' ')[0];
      var found=byAdv[key]||byAdv[Object.keys(byAdv).find(function(k){return k.startsWith(fn);})||''];
      if(found){
        if(!S.entries[l.id])S.entries[l.id]={processos:[],procValid:0,contValid:0,capaCapa:0,auditoria:0,volEntradas:0,volLiquidado:0};
        S.entries[l.id].procValid=found.pv;
        S.entries[l.id].contValid=found.cv;
        batch.set(fb.doc(fb.db,'entries',l.id), {id:l.id,procValid:found.pv,contValid:found.cv,updatedAt:fb.serverTimestamp(),updatedBy:currentUser.id}, {merge:true});
        matched++;
      }
    });
    try{
      if(matched>0)await batch.commit();
      var el=document.getElementById('s-val');if(el)el.textContent=matched+' adv';
      input.value='';showToast(matched+' validações importadas!');
    }catch(e){ showToast('Erro: '+(e.code||e.message)); }
  });
}
function importDilGeral(input){
  if(!input.files.length)return;
  readXlsx(input.files[0], async function(rows){
    var byInit={};
    rows.forEach(function(r){
      var contrato=String(r['CONTRATO']||'').trim().toUpperCase();
      var val2=String(r['VAL.']||r['VAL']||'').trim().toUpperCase();
      var valor=parseFloat(r['VALOR']||0)||0;
      if(contrato!=='PAGO'||!val2)return;
      if(!byInit[val2])byInit[val2]={qtd:0,vol:0};
      byInit[val2].qtd++;byInit[val2].vol+=valor;
    });
    var matched=0;
    var batch=fb.writeBatch(fb.db);
    S.lawyers.forEach(function(l){
      var initials=l.name.trim().split(' ').slice(0,2).map(function(x){return x[0].toUpperCase();}).join('');
      if(byInit[initials]){
        if(!S.entries[l.id])S.entries[l.id]={processos:[],procValid:0,contValid:0,capaCapa:0,auditoria:0,volEntradas:0,volLiquidado:0};
        S.entries[l.id].capaCapa=byInit[initials].qtd;
        S.entries[l.id].volEntradas=byInit[initials].vol;
        batch.set(fb.doc(fb.db,'entries',l.id), {id:l.id,capaCapa:byInit[initials].qtd,volEntradas:byInit[initials].vol,updatedAt:fb.serverTimestamp(),updatedBy:currentUser.id}, {merge:true});
        matched++;
      }
    });
    try{
      if(matched>0)await batch.commit();
      var el=document.getElementById('s-dil');if(el)el.textContent=matched+' adv';
      input.value='';showToast(matched+' diligências importadas!');
    }catch(e){ showToast('Erro: '+(e.code||e.message)); }
  });
}
async function saveManual(){
  var lid=document.getElementById('sel-man').value;
  if(!lid){showToast('Selecione um advogado.');return;}
  if(!S.entries[lid])S.entries[lid]={processos:[],procValid:0,contValid:0,capaCapa:0,auditoria:0,volEntradas:0,volLiquidado:0};
  var g=function(id){return document.getElementById(id).value;};
  var fields={};
  if(g('man-pv')!=='')fields.procValid=parseInt(g('man-pv'))||0;
  if(g('man-cv')!=='')fields.contValid=parseInt(g('man-cv'))||0;
  if(g('man-capa')!=='')fields.capaCapa=parseInt(g('man-capa'))||0;
  if(g('man-au')!=='')fields.auditoria=parseInt(g('man-au'))||0;
  if(g('man-ve')!=='')fields.volEntradas=parseFloat(g('man-ve'))||0;
  if(g('man-vl')!=='')fields.volLiquidado=parseFloat(g('man-vl'))||0;
  Object.assign(S.entries[lid], fields);
  try{
    await persistEntry(lid, fields);
    showToast('Ajuste salvo!');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}

// ════════════════════════════════════════════════════════════
// CAMPANHAS
// ════════════════════════════════════════════════════════════
// Mês de referência das campanhas = o mês selecionado no topo (ou o atual).
function _campRefMes(){ return (S.periodo && S.periodo.mode==='mes' && S.periodo.mes) ? S.periodo.mes : (S.mes || new Date().toISOString().slice(0,7)); }
// Mês de uma campanha: campo 'mes' se houver; senão o mês de criação; senão o de referência.
function campMes(c){ if(c&&c.mes) return c.mes; if(c&&c.createdAt){ try{ var d=c.createdAt.toDate?c.createdAt.toDate():(typeof c.createdAt.seconds==='number'?new Date(c.createdAt.seconds*1000):new Date(c.createdAt)); if(!isNaN(d.getTime())) return d.toISOString().slice(0,7); }catch(e){} } return _campRefMes(); }
function _campMesLabel(ym){ var M=['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro']; var p=String(ym||'').split('-'); return p.length===2?(M[(parseInt(p[1],10)||1)-1]+' de '+p[0]):String(ym||''); }
// Nome do alvo da campanha (advogado ou gestor/equipe por e-mail) para exibição.
function campAlvoNome(c){
  if(!c||c.lawyer==='todos'||!c.lawyer) return 'Todos';
  if(String(c.lawyer).indexOf('u:')===0){ var em=String(c.lawyer).slice(2); var u=(S.users||[]).find(function(x){return String(x.email||'').toLowerCase()===em;}); return (u&&(u.nome||u.name))||c.lawyerNome||em; }
  var l=(S.lawyers||[]).find(function(x){return x.id===c.lawyer;}); return (l&&l.name)||c.lawyerNome||'—';
}
// Campanha é "minha"? (para cada um ver só a sua; admin vê todas)
function campanhaMinha(c){
  if(!c) return false;
  if(c.lawyer==='todos'||!c.lawyer) return true;
  var em=(currentUser&&currentUser.email)?String(currentUser.email).toLowerCase():'';
  if(em && String(c.lawyer)==='u:'+em) return true;
  if(currentUser&&currentUser.lawyerId && c.lawyer===currentUser.lawyerId) return true;
  var nome=campAlvoNome(c);
  if(nome && currentUser && currentUser.name && nome.toLowerCase()===String(currentUser.name).toLowerCase()) return true;
  return false;
}
// Opções do seletor: Advogados + Gestores/Equipe (usuários admin/gestora/supervisora, por e-mail).
function campAlvoOptions(){
  var lo='<optgroup label="Advogados">'+(S.lawyers||[]).map(function(l){return'<option value="'+l.id+'">'+esc(l.name)+'</option>';}).join('')+'</optgroup>';
  var ge=(S.users||[]).filter(function(u){return u && u.active!==false && u.email && ['admin','gestora','supervisora'].indexOf(u.role)>=0;})
    .sort(function(a,b){return String(a.nome||a.name||'').localeCompare(String(b.nome||b.name||''));});
  var go=ge.length?('<optgroup label="Gestores / equipe">'+ge.map(function(u){return '<option value="u:'+esc(String(u.email).toLowerCase())+'">'+esc(u.nome||u.name||u.email)+'</option>';}).join('')+'</optgroup>'):'';
  return '<option value="todos">Todos</option>'+lo+go;
}
function pageCampanhas(){
  var refMes=_campRefMes();
  var doMes=(S.campanhas||[]).filter(function(c){return campMes(c)===refMes;});
  var veTodas=isFullAccess(currentUser);
  var visiveis=veTodas?doMes:doMes.filter(campanhaMinha);
  var podeLancar=veTodas; // só admin lança/exclui; demais veem só a sua lista
  var list=!visiveis.length?'<div class="empty">Nenhuma campanha '+(veTodas?('lançada em '+esc(_campMesLabel(refMes))):'para você em '+esc(_campMesLabel(refMes)))+'.</div>':
    visiveis.map(function(c){var ln=campAlvoNome(c);return'<div class="lrow"><div style="flex:1">'+esc(c.nome)+'</div><span class="badge b-par">'+fmt(c.valor)+'</span><div style="font-size:11px;color:var(--mt);margin:0 8px">'+esc(ln)+'</div>'+(podeLancar?'<button class="btn bd2 bsm" onclick="removeCamp(\''+c.id+'\')">✕</button>':'')+'</div>';}).join('');
  var form=podeLancar?('<div class="card"><div class="frow"><div class="fg" style="flex:2"><label>Nome</label><input type="text" id="cn" placeholder="Ex: Meta de acordos"/></div><div class="fg"><label>Advogado / Gestor</label><select id="cl">'+campAlvoOptions()+'</select></div><div class="fg" style="max-width:130px"><label>Valor (R$)</label><input type="number" id="cv3" min="0" placeholder="0"/></div><button class="btn bp" onclick="addCamp()">Adicionar</button></div></div>'):'';
  return'<div class="page-title">'+I.campanhas+' Campanhas <span style="font-size:13px;color:var(--mt);font-weight:400;margin-left:8px">'+esc(_campMesLabel(refMes))+' · '+visiveis.length+'</span></div>'+
  '<div style="font-size:12px;color:var(--mt);margin:-4px 0 12px">As campanhas são lançadas no <b>mês de referência</b> (seletor no topo); ao virar o mês, a lista aparece <b>zerada</b>. '+(veTodas?'Você é admin: vê todas.':'Cada pessoa vê <b>apenas as suas</b>.')+'</div>'+
  form+
  '<div class="card">'+list+'</div>';
}
async function addCamp(){
  if(!isFullAccess(currentUser)){ showToast('Apenas o admin lança campanhas.'); return; }
  var n=(document.getElementById('cn').value||'').trim();
  var sel=document.getElementById('cl');
  var l=sel.value;
  var lnome=(sel.selectedOptions&&sel.selectedOptions[0])?sel.selectedOptions[0].textContent:'';
  var v=parseFloat(document.getElementById('cv3').value)||0;
  if(!n){alert('Informe o nome.');return;}
  try{
    await upsertCampanha({nome:n,lawyer:l,lawyerNome:lnome,valor:v,mes:_campRefMes()});
    document.getElementById('cn').value='';
    document.getElementById('cv3').value='';
    S.campanhas=await fetchCollection('campanhas');
    navigate('campanhas');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}
async function removeCamp(id){
  try{
    await deleteCampanha(id);
    S.campanhas=await fetchCollection('campanhas');
    navigate('campanhas');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}

// ════════════════════════════════════════════════════════════
// CALC ENGINE
// ════════════════════════════════════════════════════════════
// ── SUPERVISORA (ex.: Karen): comissão diferente do advogado — pró-labore fixo + bônus
//    atrelado à META e SUPERMETA do CONTENCIOSO (mesma apuração das gestoras). NÃO recebe
//    por validação nem liquidação. Padrão: R$ 2.000 (meta) + R$ 2.000 (supermeta).
function lawyerRoleOf(lid){
  if(currentUser && currentUser.lawyerId===lid && currentUser.role) return currentUser.role;
  var u=(S.users||[]).find(function(x){return x.lawyerId===lid;});
  return u?u.role:'';
}
function isSupervisoraLawyer(lid){ return lawyerRoleOf(lid)==='supervisora'; }
function supervisoraBonus(l){
  return { meta:(l&&l.superMetaBonus!=null)?Number(l.superMetaBonus):2000,
           superv:(l&&l.superSuperBonus!=null)?Number(l.superSuperBonus):2000 };
}
// ── Regras especiais de comissão ──────────────────────────────────
// Guilherme: 4 metas de execução (R$ 500 cada), marcadas manualmente no mês.
// Karen (supervisora): escalonada + campanhas + treinamentos (R$ 500 cada).
// Por e-mail, nunca por nome (Mapa de Permissões): outro "Guilherme" no cadastro não herda a regra.
var GUILHERME_EMAILS=['guilherme.souza@pblcompra.com'];
function isGuilherme(l){ return !!(l && GUILHERME_EMAILS.indexOf(String(l.email||'').trim().toLowerCase())>=0); }
var GUI_ATIVS=[['notificacoes','Notificações'],['cadastro','Cadastro no sistema (EasyJur + PBL)'],['pastasFidc','Pastas FIDC'],['habilitacoes','Habilitações']];
function guilhermeMarcadas(mes){ return ((S.gestorasMetas||{})[mes]||{}).guilhermeMetas || {}; }
function karenTreinos(mes){ return Number(((S.gestorasMetas||{})[mes]||{}).karenTreinamentos)||0; }
// Mesmo conjunto da regra de gestorasMetas (admin/gestora): com a supervisora aqui, a marcação dela era recusada em silêncio.
function podeMarcarMetaExec(u){ return !!(u && (isFullAccess(u)||isGestora(u))); }
async function guilhermeToggle(key, lid){
  if(!podeMarcarMetaExec(currentUser)){ showToast('Sem permissão para marcar.'); return; }
  var mes=_campRefMes(); var gm=Object.assign({}, (S.gestorasMetas||{})[mes]||{}); var gmet=Object.assign({}, gm.guilhermeMetas||{});
  gmet[key]=!gmet[key]; gm.guilhermeMetas=gmet; S.gestorasMetas=S.gestorasMetas||{}; S.gestorasMetas[mes]=gm;
  try{ await persistGestoraMeta(mes,{guilhermeMetas:gmet}); }catch(e){ console.error('guilhermeToggle:', e); showToast('Não foi possível salvar a marcação.'); }
  if(typeof showDetail==='function') showDetail(lid);
}
async function karenTreinoSet(n, lid){
  if(!podeMarcarMetaExec(currentUser)){ showToast('Sem permissão.'); return; }
  var mes=_campRefMes(); var val=Math.max(0,parseInt(n,10)||0); var gm=Object.assign({}, (S.gestorasMetas||{})[mes]||{}); gm.karenTreinamentos=val;
  S.gestorasMetas=S.gestorasMetas||{}; S.gestorasMetas[mes]=gm;
  try{ await persistGestoraMeta(mes,{karenTreinamentos:val}); }catch(e){ console.error('karenTreinoSet:', e); showToast('Não foi possível salvar os treinamentos.'); }
  if(typeof showDetail==='function') showDetail(lid);
}
function calc(lid){
  var l=S.lawyers.find(function(x){return x.id===lid;});if(!l)return null;
  var e=S.entries[lid]||{processos:[],procValid:0,contValid:0,capaCapa:0,auditoria:0,volEntradas:0,volLiquidado:0};
  var numMeses = (mesesDoPeriodo()||[]).length || 1;

  // Contagens vindas da tela "Validações PBL" — filtra pelo período selecionado.
  var dv={proc_val:0,cont_val:0,capa:0,auditoria:0};
  S.distribValidacao.forEach(function(m){
    if(m.advogadoId===lid && dv.hasOwnProperty(m.tipo) && inPeriodo(m.data)) dv[m.tipo]++;
  });

  // Soma contagens dos imports + registros manuais (ambas viram comissão)
  var qtdProcVal=(e.procValid||0)+dv.proc_val;
  var qtdContVal=(e.contValid||0)+dv.cont_val;
  var qtdCapa=(e.capaCapa||0)+dv.capa;             // Capa a Capa = Precatório
  var qtdAud=(e.auditoria||0)+dv.auditoria;

  // ── COMISSÃO POR PROCESSO LIQUIDADO ──
  // Regra: comissão SÓ quando o processo está 100% liquidado.
  // Fontes consideradas:
  //   (A) e.processos (legado, vindo do import de planilha) — usa flag tipo='Total'
  //   (B) S.liqManual (lançamentos manuais) — agrupa por (processo+advogado+titularidade);
  //       grupo "100% liquidado" = pelo menos 1 lançamento com liquidacao='Total'
  // Comissão por processo: R$50 se valor < R$10k, R$100 se ≥ R$10k
  // ⚠️ MIGRAÇÃO: se o advogado JÁ TEM lançamentos em S.liqManual (modo novo via aba
  // Liquidações), TODO o legado é ignorado. Isso garante que a base de cálculo seja
  // 100% a fonte nova e evita qualquer duplicação. Caso contrário, usa o legado
  // (advogado ainda no modo antigo).
  function normProc(s){return String(s||'').replace(/[^0-9]/g,'');}
  var temLiqManual=(S.liqManual||[]).some(function(m){return m.advogadoId===lid;});

  // (A) Legado — usado APENAS se o advogado não tem nada no S.liqManual
  var legadoFiltrado=temLiqManual ? [] : (e.processos||[]);
  var procsTotLegado=legadoFiltrado.filter(function(p){return p.tipo!=='Parcial';});
  var cPLegado=procsTotLegado.reduce(function(s,p){return s+(p.valor<10000?50:100);},0);

  // (B) Lançamentos manuais — agrupa por (processo+advogadoId+titularidade); filtra pelo período.
  var gruposManual={};
  (S.liqManual||[]).forEach(function(m){
    if(m.advogadoId!==lid)return;
    if(!inPeriodo(m.data))return;
    var key=(m.processo||'__sem_proc__'+m.id)+'|'+(m.titularidade||'');
    if(!gruposManual[key])gruposManual[key]={total:0,temTotal:false,proc:m.processo,titularidade:m.titularidade};
    gruposManual[key].total+=(m.valor||0);
    if(m.liquidacao==='Total')gruposManual[key].temTotal=true;
  });
  var procsTotManual=Object.keys(gruposManual).filter(function(k){return gruposManual[k].temTotal;}).map(function(k){return gruposManual[k];});
  var cPManual=procsTotManual.reduce(function(s,g){return s+(g.total<10000?50:100);},0);

  var cP=cPLegado+cPManual;

  var cPV=qtdProcVal*5,cCV=qtdContVal*2,cCapa=qtdCapa*10,cAud=qtdAud*10;
  var ve=e.volEntradas||0,cEnt=ve>=500000?Math.floor(ve/100000)*100:0;

  // ── PRÊMIO POR VOLUME LIQUIDADO ──
  // Mesma regra: se há S.liqManual, ignora 100% do legado (incluindo agregado e.volLiquidado)
  // Senão, usa o legado (processos detalhados ou agregado)
  var volLegado=0;
  if(!temLiqManual){
    volLegado=(e.processos||[]).reduce(function(s,p){return s+(p.valor||0);},0);
    if(!volLegado && e.volLiquidado) volLegado=e.volLiquidado;
  }
  var volManual=(S.liqManual||[]).filter(function(m){return m.advogadoId===lid && inPeriodo(m.data);}).reduce(function(s,m){return s+(m.valor||0);},0);
  var volLiqTotalParcial=volLegado+volManual;
  var cLiq=volLiqTotalParcial>=500000?Math.floor(volLiqTotalParcial/100000)*100:0;

  // Campanhas no período (filtradas por mes/ano/custom).
  var cCamp=S.campanhas.reduce(function(s,c){
    if(c.lawyer!=='todos' && c.lawyer!==lid) return s;
    if(c.data && !inPeriodo(c.data)) return s;
    if(c.mes){ // legacy: campo 'mes' YYYY-MM
      if((S.periodo||{}).mode==='mes' && c.mes !== (S.periodo.mes||S.mes)) return s;
      if((S.periodo||{}).mode==='ano' && c.mes.slice(0,4) !== String(S.periodo.ano)) return s;
    }
    return s+(c.valor||0);
  },0);
  // Cálculo Cumprimento de Sentença: nº de cálculos no período × valor unitário.
  var calcQtd=calcCalcQtd(lid), cCalc=calcCalcTotal(lid);
  // Pró-labore multiplicado pelo número de meses no período (modo ano/custom soma 12x).
  var prolaboreTotal = (l.prolabore||0) * numMeses;
  // ── SUPERVISORA (Karen): pró-labore + bônus meta/supermeta do CONTENCIOSO; sem os itens de peça. ──
  if(isSupervisoraLawyer(lid)){
    var supB=supervisoraBonus(l);
    var mesesSup=(mesesDoPeriodo()||[]); if(!mesesSup.length)mesesSup=[S.mes];
    var supMeta=0,supSuper=0,nM=0,nS=0,treinoQtd=0;
    mesesSup.forEach(function(mes){ var met=calcMetricasGestoras(mes); if(met.bateMetaCont){supMeta+=supB.meta;nM++;} if(met.bateSuperMetaCont){supSuper+=supB.superv;nS++;} treinoQtd+=karenTreinos(mes); });
    var cTreino=treinoQtd*500;
    var totalSup=prolaboreTotal+supMeta+supSuper+cCamp+cTreino;
    return {lawyer:l,entry:e,cP:0,cPV:0,cCV:0,cCapa:0,cAud:0,cEnt:0,cLiq:0,cCamp:cCamp,cCalc:0,total:totalSup,
      prolaboreTotal:prolaboreTotal,numMeses:numMeses,
      qtdProcVal:0,qtdContVal:0,qtdCapa:0,qtdAud:0,calcQtd:0,
      qtdProcTot:0,volLiqTotalParcial:0,qtdProcTotLegado:0,qtdProcTotManual:0,dvManual:dv,
      supervisora:true,supBonusMeta:supMeta,supBonusSuper:supSuper,supMetaMeses:nM,supSuperMeses:nS,supMetaUnit:supB.meta,supSuperUnit:supB.superv,cTreino:cTreino,treinoQtd:treinoQtd};
  }
  // ── GUILHERME: pró-labore + campanhas + 4 metas de execução (R$ 500 cada, manuais). ──
  if(isGuilherme(l)){
    var mesesG=(mesesDoPeriodo()||[]); if(!mesesG.length)mesesG=[_campRefMes()];
    var execTotal=0; mesesG.forEach(function(mm){ var mk=guilhermeMarcadas(mm); GUI_ATIVS.forEach(function(a){ if(mk[a[0]]) execTotal+=500; }); });
    var marcRef=guilhermeMarcadas(_campRefMes());
    var execMetas=GUI_ATIVS.map(function(a){ return {key:a[0],label:a[1],atingida:!!marcRef[a[0]]}; });
    var totalG=prolaboreTotal+cCamp+execTotal;
    return {lawyer:l,entry:e,cP:0,cPV:0,cCV:0,cCapa:0,cAud:0,cEnt:0,cLiq:0,cCamp:cCamp,cCalc:0,total:totalG,
      prolaboreTotal:prolaboreTotal,numMeses:numMeses,
      qtdProcVal:0,qtdContVal:0,qtdCapa:0,qtdAud:0,calcQtd:0,qtdProcTot:0,volLiqTotalParcial:0,qtdProcTotLegado:0,qtdProcTotManual:0,dvManual:dv,
      guilherme:true,execMetas:execMetas,execTotal:execTotal,execMes:_campRefMes()};
  }
  var total=prolaboreTotal+cP+cPV+cCV+cCapa+cAud+cEnt+cLiq+cCamp+cCalc;
  return{lawyer:l,entry:e,cP:cP,cPV:cPV,cCV:cCV,cCapa:cCapa,cAud:cAud,cEnt:cEnt,cLiq:cLiq,cCamp:cCamp,cCalc:cCalc,total:total,
    prolaboreTotal:prolaboreTotal, numMeses:numMeses,
    qtdProcVal:qtdProcVal,qtdContVal:qtdContVal,qtdCapa:qtdCapa,qtdAud:qtdAud,calcQtd:calcQtd,
    qtdProcTot:procsTotLegado.length+procsTotManual.length,volLiqTotalParcial:volLiqTotalParcial,
    qtdProcTotLegado:procsTotLegado.length,qtdProcTotManual:procsTotManual.length,
    dvManual:dv};
}
// ── Cálculo Cumprimento de Sentença (helpers) ───────────────
function calcValorUnit(){ return (S.calcValorUnit!=null)?S.calcValorUnit:25; }
function calcCalcDoLawyer(lid){ return (S.calculos||[]).filter(function(c){return c.advogadoId===lid && inPeriodo(c.data);}); }
function calcCalcQtd(lid){ return calcCalcDoLawyer(lid).reduce(function(s,c){return s+(c.qtd||1);},0); }
function calcCalcTotal(lid){ return calcCalcDoLawyer(lid).reduce(function(s,c){return s+(c.qtd||1)*(c.valorUnit||calcValorUnit());},0); }
async function saveCalculo(c){
  var id=c.id || fb.doc(fb.collection(fb.db,'calculos')).id; c.id=id;
  var payload=Object.assign({},c,{updatedAt:fb.serverTimestamp(),updatedBy:currentUser.id});
  if(!c.createdAt){ payload.createdAt=fb.serverTimestamp(); payload.createdBy=currentUser.id; }
  await fb.setDoc(fb.doc(fb.db,'calculos',id), payload);
  return id;
}
async function deleteCalculoDoc(id){ await fb.deleteDoc(fb.doc(fb.db,'calculos',id)); }
// Esse advogado faz cálculo de cumprimento de sentença? (função secundária ou já tem lançamentos)
function lawyerEhCalculista(lid){
  if(currentUser && currentUser.lawyerId===lid && isCalculista(currentUser)) return true;
  var u=(S.users||[]).find(function(x){return x.lawyerId===lid;});
  if(u) return isCalculista(u);
  return (S.calculos||[]).some(function(c){return c.advogadoId===lid;});
}
function podeRegistrarCalculo(){ return isFullAccess(currentUser)||isGestora(currentUser)||(currentUser&&(currentUser.role==='supervisora'||currentUser.role==='gestor_calculos')); }
// Lista de peritos = advogados com calculo_cs + usuários role=perito_contabil.
function peritosList(){
  var out=[];
  (S.users||[]).forEach(function(u){
    if(u.active===false) return;
    if(u.role==='lawyer' && hasSecRole(u,'calculo_cs') && u.lawyerId){
      out.push({ id:u.lawyerId, userId:u.id, nome:(lawyerName(u.lawyerId)||u.name||'—'), tipo:'advogado', advogadoId:u.lawyerId });
    } else if(u.role==='perito_contabil'){
      out.push({ id:u.id, userId:u.id, nome:(u.name||u.email||'—'), tipo:'clt', advogadoId:null });
    }
  });
  return out;
}
// Comissão de um registro: só advogado recebe.
function calcComissaoDe(c){ return c.advogadoId ? (c.valorUnit||calcValorUnit()) : 0; }
// Cálculos visíveis ao usuário atual (período + escopo por perfil).
function calculosNoEscopo(){
  var all=(S.calculos||[]).filter(function(c){return inPeriodo(c.data);});
  var u=currentUser; if(!u) return [];
  if(isFullAccess(u)||isGestora(u)||u.role==='supervisora'||u.role==='gestor_calculos') return all;
  if(u.role==='perito_contabil') return all.filter(function(c){return c.peritoId===u.id;});
  if(u.role==='lawyer' && u.lawyerId) return all.filter(function(c){return c.advogadoId===u.lawyerId;});
  return [];
}

// ════════════════════════════════════════════════════════════
// ADVOGADOS — detalhe comissões
// ════════════════════════════════════════════════════════════
function exportarComissaoExcel(lid){
  var c=calc(lid); if(!c){showToast('Advogado sem dados.');return;}
  var itens=[
    {Item:'Pró-labore fixo',Valor:c.prolaboreTotal},
    {Item:'Processos 100% liquidados',Valor:c.cP},
    {Item:'Processos validados',Valor:c.cPV},
    {Item:'Contratos validados',Valor:c.cCV},
    {Item:'Capa a capa',Valor:c.cCapa},
    {Item:'Auditoria',Valor:c.cAud},
    {Item:'Bônus entradas',Valor:c.cEnt},
    {Item:'Prêmio liquidação',Valor:c.cLiq},
    {Item:'Campanhas',Valor:c.cCamp}
  ];
  if(typeof lawyerEhCalculista==='function' && lawyerEhCalculista(lid)) itens.push({Item:'Cálculo Cumprimento de Sentença',Valor:c.cCalc});
  itens.push({Item:'Comissões (sem pró-labore)',Valor:(c.total-c.prolaboreTotal)});
  itens.push({Item:'TOTAL A PAGAR',Valor:c.total});
  var wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(itens), 'Resumo');
  var procs=(S.liqManual||[]).filter(function(m){return m.advogadoId===lid && inPeriodo(m.data);}).map(function(m){return {Data:m.data||'',Processo:m.processo||'',Origem:m.titularidade||'',Tipo:m.liquidacao||'Total','Qtd. Créditos':m.creditos||'',Valor:m.valor||0};});
  if(procs.length) XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(procs), 'Processos');
  var nome='comissao_'+String(c.lawyer.name||'advogado').replace(/[^\w]+/g,'_')+'_'+new Date().toISOString().slice(0,10)+'.xlsx';
  XLSX.writeFile(wb,nome);
  showToast('Exportado: '+nome);
}
function exportarComissaoTodosExcel(){
  var lawyers=(typeof lawyersComissao==='function'?lawyersComissao():S.lawyers)||[];
  var linhas=lawyers.map(function(l){ var c=calc(l.id); if(!c)return null; return {Advogado:l.name,'Pró-labore':c.prolaboreTotal,'Comissões':(c.total-c.prolaboreTotal),'Total a pagar':c.total}; }).filter(Boolean);
  if(!linhas.length){showToast('Nada para exportar.');return;}
  linhas.push({Advogado:'TOTAL','Pró-labore':linhas.reduce(function(s,r){return s+r['Pró-labore'];},0),'Comissões':linhas.reduce(function(s,r){return s+r['Comissões'];},0),'Total a pagar':linhas.reduce(function(s,r){return s+r['Total a pagar'];},0)});
  var wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(linhas), 'Comissões');
  var nome='comissoes_todos_'+new Date().toISOString().slice(0,10)+'.xlsx';
  XLSX.writeFile(wb,nome);
  showToast('Exportado: '+nome);
}

// Minhas Comissões — para lawyer/supervisora. Renderiza direto a comissão do proprio currentUser.lawyerId.
function pageMinhasComissoes(){
  if(!currentUser){ return '<div class="page-title">'+I.comissao+' Minhas Comissões</div><div class="empty">Sessão inválida.</div>'; }

  // Card de gestora (se role=gestora OU tem função secundária gestora).
  var ehGestora = currentUser.role === 'gestora' || hasSecRole(currentUser, 'gestora');
  if(ehGestora){
    var gid = currentUser.gestoraId;
    if(!gid){
      return '<div class="page-title">'+I.comissao+' Minhas Comissões</div>'+
        '<div class="empty">Seu perfil de gestora não está vinculado. Solicite ao administrador.</div>';
    }
    var g = (S.gestoras||[]).find(function(x){return x.id===gid;});
    if(!g){
      return '<div class="page-title">'+I.comissao+' Minhas Comissões</div>'+
        '<div class="empty">Gestora vinculada (id: '+esc(gid)+') não encontrada.</div>';
    }
    return '<div class="page-title">'+I.comissao+' Minhas Comissões — '+esc(g.name||'')+'</div>'+
      '<div class="card" style="margin-bottom:12px">'+
        '<div style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--bd);padding-bottom:8px;margin-bottom:8px">'+
          '<div><div style="font-weight:700;font-size:14px">'+esc(g.name||'—')+'</div><div style="font-size:11px;color:var(--mt)">'+esc(g.email||'')+'</div></div>'+
          '<div style="text-align:right"><div style="font-size:11px;color:var(--mt)">Total a receber</div><div style="font-size:18px;font-weight:700;color:var(--v)">'+fmt(g.prolabore||0)+'</div></div>'+
        '</div>'+
        '<table style="width:100%"><tbody>'+
          '<tr><td style="padding:5px 10px;font-size:12px;color:var(--mt)">Pró-labore fixo</td>'+
              '<td style="padding:5px 10px;font-size:12px;text-align:right;color:var(--v);font-weight:600">'+fmt(g.prolabore||0)+'</td></tr>'+
        '</tbody></table>'+
      '</div>';
  }

  // Card de advogado (lawyer/supervisora) — reusa showDetail.
  var lid = currentUser.lawyerId;
  if(!lid){
    return '<div class="page-title">'+I.comissao+' Minhas Comissões</div>'+
      '<div class="empty">Seu perfil não está vinculado a um advogado. Solicite ao administrador.</div>';
  }
  var lawyer = (S.lawyers||[]).find(function(l){return l.id===lid;});
  if(!lawyer){
    return '<div class="page-title">'+I.comissao+' Minhas Comissões</div>'+
      '<div class="empty">Advogado vinculado (id: '+esc(lid)+') não encontrado.</div>';
  }
  setTimeout(function(){ try{ showDetail(lid); }catch(e){} }, 0);
  return '<div class="page-title">'+I.comissao+' Minhas Comissões — '+esc(lawyer.name)+'</div>'+
    '<div id="detail-content"><div class="empty">Carregando...</div></div>';
}

function pageAdvogados(){
  var lockedRoles=['lawyer','supervisora'];
  var isLocked = currentUser && lockedRoles.indexOf(currentUser.role)>=0;
  var lockedLawyerId = isLocked ? (currentUser.lawyerId||null) : null;
  if(isLocked && !lockedLawyerId){
    return '<div class="page-title">'+I.advogados+' Comissões por Advogado</div>'+
      '<div class="empty">Seu perfil não está vinculado a um advogado. Solicite ao administrador para vincular um lawyerId no seu usuário.</div>';
  }
  var lawyersFiltrados = isLocked ? S.lawyers.filter(function(l){return l.id===lockedLawyerId;}) : lawyersComissao();
  var opts=lawyersFiltrados.map(function(l){var sel=isLocked?' selected':'';return'<option value="'+l.id+'"'+sel+'>'+l.name+'</option>';}).join('');
  var placeholder = isLocked ? '' : '<option value="">Selecione um advogado...</option>';
  var disabledAttr = isLocked ? ' disabled' : '';
  setTimeout(function(){
    if(isLocked && lockedLawyerId){ try{ showDetail(lockedLawyerId); }catch(e){} }
  }, 0);
  return'<div class="page-title">'+I.advogados+' Comissões por Advogado</div>'+
  '<div style="display:flex;gap:10px;align-items:flex-end;margin-bottom:16px;flex-wrap:wrap">'+
    '<div class="fg" style="flex:1;min-width:240px;max-width:340px;margin:0"><label style="font-size:12px;color:var(--mt);display:block;margin-bottom:4px">'+(isLocked?'Advogado':'Selecione um advogado')+'</label><select id="detail-sel" onchange="showDetail(this.value)"'+disabledAttr+'>'+placeholder+opts+'</select></div>'+
    (isLocked?'':'<button class="btn bp" style="font-size:12px" onclick="gerarRelatorioTodos()">📑 Gerar Relatório (Todos)</button>')+
    (isLocked?'':'<button class="btn" style="font-size:12px;background:#1D6B3A;color:#fff" onclick="exportarComissaoTodosExcel()">📊 Excel (Todos)</button>')+
    (isFullAccess(currentUser)?'<button class="btn" style="font-size:12px;background:#c0392b;color:#fff" onclick="limparDuplicatasLegado()" title="Remove processos antigos importados pelo Dashboard que já estão na nova aba Liquidações">🧹 Limpar Duplicatas</button>':'')+
  '</div>'+
  '<div id="detail-content">'+(isLocked?'<div class="empty">Carregando...</div>':'<div class="empty">Selecione um advogado para ver o detalhamento e gerar o relatório individual.</div>')+'</div>';
}

// Limpa processos antigos do legado (e.processos / S.entries[lid].processos) que
// já estão presentes em S.liqManual (mesmo número de processo). Resolve duplicação
// quando os mesmos processos foram importados pelas duas vias.
function limparDuplicatasLegado(){
  if(!isFullAccess(currentUser)){alert('Apenas Admin.');return;}
  function normProc(s){return String(s||'').replace(/[^0-9]/g,'');}
  // Por advogado: monta set de processos que já estão no S.liqManual
  var byAdv={};
  (S.liqManual||[]).forEach(function(m){
    if(!m.advogadoId)return;
    if(!byAdv[m.advogadoId])byAdv[m.advogadoId]={};
    var np=normProc(m.processo);
    if(np)byAdv[m.advogadoId][np]=true;
  });
  // Conta quantas duplicatas existem antes
  var totalRemover=0;
  Object.keys(S.entries||{}).forEach(function(lid){
    var en=S.entries[lid];if(!en||!en.processos)return;
    var dupSet=byAdv[lid]||{};
    en.processos.forEach(function(p){
      var np=normProc(p.numero||p.processo||p.proc||p.ref);
      if(np && dupSet[np]) totalRemover++;
    });
  });
  if(!totalRemover){alert('Nenhuma duplicata encontrada. Tudo limpo!');return;}
  if(!confirm('Encontradas '+totalRemover+' duplicatas (processos do legado que já estão na aba Liquidações).\n\nRemover essas duplicatas? Os lançamentos da aba Liquidações são preservados.')) return;
  // Remove
  Object.keys(S.entries||{}).forEach(function(lid){
    var en=S.entries[lid];if(!en||!en.processos)return;
    var dupSet=byAdv[lid]||{};
    en.processos=en.processos.filter(function(p){
      var np=normProc(p.numero||p.processo||p.proc||p.ref);
      return !np || !dupSet[np];
    });
  });
  saveData();
  alert(totalRemover+' duplicatas removidas com sucesso!');
  navigate('advogados');
}

// Relatório consolidado com todos os advogados — abre nova aba imprimível
function gerarRelatorioTodos(){
  if(!S.lawyers.length){showToast('Nenhum advogado cadastrado.');return;}
  var todos=lawyersComissao().map(function(l){return calc(l.id);}).filter(function(c){return !!c;});
  var dataGer=new Date().toLocaleDateString('pt-BR')+' '+new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
  var mesRef=S.mes||'';
  var emitidoPor=currentUser?currentUser.name:'';
  var totG=todos.reduce(function(s,c){return s+c.total;},0);
  var totP=todos.reduce(function(s,c){return s+c.prolaboreTotal;},0);

  var blocks=todos.map(function(c,idx){
    // Se há S.liqManual, ignora 100% do legado (modo novo)
    var temLiqManual=(S.liqManual||[]).some(function(m){return m.advogadoId===c.lawyer.id;});
    var procs=temLiqManual ? [] : (c.entry.processos||[]);
    // Lançamentos manuais agrupados por processo
    var grpManual={};
    (S.liqManual||[]).forEach(function(m){
      if(m.advogadoId!==c.lawyer.id)return;
      if(!inPeriodo(m.data))return; // segue o período selecionado (igual ao motor calc)
      var key=(m.processo||'(sem nº)')+'|'+(m.titularidade||'');
      if(!grpManual[key])grpManual[key]={proc:m.processo||'(sem nº)',titularidade:m.titularidade,total:0,qtd:0,temTotal:false};
      grpManual[key].total+=(m.valor||0);
      grpManual[key].qtd++;
      if(m.liquidacao==='Total')grpManual[key].temTotal=true;
    });
    var manualArr=Object.keys(grpManual).map(function(k){return grpManual[k];});

    var procRowsLegado=procs.map(function(p,i){
      var isPar=p.tipo==='Parcial';
      var com=isPar?0:(p.valor<10000?50:100);
      var bd=isPar?'<span style="background:#fff3cd;color:#856404;padding:1px 6px;border-radius:3px;font-size:9px;font-weight:700">PARC.</span>':'<span style="background:#d4edda;color:#155724;padding:1px 6px;border-radius:3px;font-size:9px;font-weight:700">TOTAL</span>';
      return '<tr><td style="padding:4px 8px;font-size:10px">'+(i+1)+'</td><td style="padding:4px 8px;font-size:10px">'+esc(p.ref||'---')+'</td><td style="padding:4px 8px;font-size:9px;color:#888">—</td><td style="padding:4px 8px">'+bd+'</td><td style="padding:4px 8px;font-size:10px;text-align:right">'+fmt(p.valor||0)+'</td><td style="padding:4px 8px;font-size:10px;text-align:right;color:'+(isPar?'#888':'#063D38')+';font-weight:600">'+(isPar?'—':'R$ '+com)+'</td></tr>';
    }).join('');
    var procRowsManual=manualArr.map(function(g,i){
      var com=g.temTotal?(g.total<10000?50:100):0;
      var bd=g.temTotal?'<span style="background:#d4edda;color:#155724;padding:1px 6px;border-radius:3px;font-size:9px;font-weight:700">100%</span>':'<span style="background:#fff3cd;color:#856404;padding:1px 6px;border-radius:3px;font-size:9px;font-weight:700">'+g.qtd+' parc.</span>';
      return '<tr><td style="padding:4px 8px;font-size:10px">'+(procs.length+i+1)+'</td><td style="padding:4px 8px;font-size:10px">'+esc(g.proc||'---')+'</td><td style="padding:4px 8px;font-size:9px;color:#5e7572">'+esc(g.titularidade||'')+'</td><td style="padding:4px 8px">'+bd+'</td><td style="padding:4px 8px;font-size:10px;text-align:right">'+fmt(g.total||0)+'</td><td style="padding:4px 8px;font-size:10px;text-align:right;color:'+(g.temTotal?'#063D38':'#888')+';font-weight:600">'+(g.temTotal?'R$ '+com:'—')+'</td></tr>';
    }).join('');
    var procRows=procRowsLegado+procRowsManual;
    if(!procRows)procRows='<tr><td colspan="6" style="padding:8px;text-align:center;color:#888;font-size:10px">Sem processos no período.</td></tr>';

    var totalLiqVol=c.volLiqTotalParcial||0;
    var qtdProcTotal=procs.length+manualArr.length;
    var items=[
      ['Pró-labore',c.prolaboreTotal],
      ['Proc. 100% liquidados ('+c.qtdProcTot+' de '+qtdProcTotal+')',c.cP],
      ['Proc. validados ('+c.qtdProcVal+')',c.cPV],
      ['Contratos validados ('+c.qtdContVal+')',c.cCV],
      ['Capa a capa ('+c.qtdCapa+')',c.cCapa],
      ['Auditoria ('+c.qtdAud+')',c.cAud],
      ['Bônus entradas',c.cEnt],
      ['Prêmio liquidação',c.cLiq],
      ['Campanhas',c.cCamp]
    ];
    var rowsHtml=items.map(function(it){return '<tr><td style="padding:5px 10px;border-bottom:1px solid #eef1f0;font-size:11px">'+it[0]+'</td><td style="padding:5px 10px;border-bottom:1px solid #eef1f0;text-align:right;font-size:11px;font-weight:600">'+fmt(it[1])+'</td></tr>';}).join('');

    return '<div class="adv-block'+(idx>0?' page-break':'')+'">'+
      '<div class="adv-hdr">'+
        '<div class="av">'+ini(c.lawyer.name)+'</div>'+
        '<div style="flex:1"><div class="adv-name">'+esc(c.lawyer.name)+'</div><div class="adv-sub">Volume liquidado: '+fmt(totalLiqVol)+'</div></div>'+
        '<div style="text-align:right"><div style="font-size:10px;color:#888;text-transform:uppercase">Total a pagar</div><div style="font-size:18px;font-weight:700;color:#063D38">'+fmt(c.total)+'</div></div>'+
      '</div>'+
      '<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">'+
        '<div><div class="sec-title">Detalhamento das Comissões</div><table>'+
          '<tbody>'+rowsHtml+'</tbody>'+
          '<tfoot><tr><td style="padding:8px 10px;background:#063D38;color:#fff;font-weight:700;font-size:12px">TOTAL</td><td style="padding:8px 10px;background:#063D38;color:#fff;text-align:right;font-weight:700;font-size:12px">'+fmt(c.total)+'</td></tr></tfoot>'+
        '</table></div>'+
        '<div><div class="sec-title">Processos ('+qtdProcTotal+')</div><table>'+
          '<thead><tr style="background:#063D38;color:#fff"><th style="padding:5px 8px;font-size:10px;text-align:left;width:24px">#</th><th style="padding:5px 8px;font-size:10px;text-align:left">Processo</th><th style="padding:5px 8px;font-size:10px;text-align:left">Origem</th><th style="padding:5px 8px;font-size:10px;text-align:left">Status</th><th style="padding:5px 8px;font-size:10px;text-align:right">Valor</th><th style="padding:5px 8px;font-size:10px;text-align:right">Com.</th></tr></thead>'+
          '<tbody>'+procRows+'</tbody>'+
        '</table></div>'+
      '</div>'+
    '</div>';
  }).join('');

  var summaryRows=todos.map(function(c){
    return '<tr><td style="padding:6px 10px;border-bottom:1px solid #eef1f0">'+esc(c.lawyer.name)+'</td><td style="padding:6px 10px;border-bottom:1px solid #eef1f0;text-align:right">'+fmt(c.prolaboreTotal)+'</td><td style="padding:6px 10px;border-bottom:1px solid #eef1f0;text-align:right">'+fmt(c.total-c.prolaboreTotal)+'</td><td style="padding:6px 10px;border-bottom:1px solid #eef1f0;text-align:right;font-weight:700">'+fmt(c.total)+'</td></tr>';
  }).join('');

  var html='<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><title>Relatório de Comissões — '+esc(mesRef)+'</title>'+
    '<style>'+
    '*{margin:0;padding:0;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}'+
    'body{background:#f0f3f2;color:#1c1c1c;padding:20px}'+
    '.sheet{max-width:1000px;margin:0 auto;background:#fff;padding:30px 36px;box-shadow:0 4px 20px rgba(0,0,0,.08);border-radius:6px}'+
    '.hdr{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid #063D38;padding-bottom:14px;margin-bottom:20px}'+
    '.brand-name{font-size:26px;font-weight:800;color:#063D38;letter-spacing:1px}'+
    '.brand-sub{font-size:11px;color:#888;letter-spacing:.15em;text-transform:uppercase;margin-top:2px}'+
    '.doc-title{font-size:12px;color:#888;text-align:right}'+
    '.doc-title strong{display:block;color:#063D38;font-size:15px;margin-bottom:3px}'+
    '.summary{margin-bottom:24px}'+
    '.summary table{width:100%;border-collapse:collapse;font-size:12px}'+
    '.summary thead th{padding:8px 10px;background:#063D38;color:#fff;text-align:right;font-size:11px;font-weight:600}'+
    '.summary thead th:first-child{text-align:left}'+
    '.summary tfoot td{padding:8px 10px;background:#DDE9E7;color:#063D38;font-weight:700;font-size:13px;text-align:right}'+
    '.summary tfoot td:first-child{text-align:left}'+
    '.adv-block{padding:18px 0;border-top:2px solid #DDE9E7;margin-top:16px}'+
    '.adv-block:first-of-type{border-top:none;margin-top:0}'+
    '.adv-hdr{display:flex;align-items:center;gap:12px;margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid #eef1f0}'+
    '.av{width:42px;height:42px;border-radius:50%;background:#063D38;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px}'+
    '.adv-name{font-size:16px;font-weight:700;color:#063D38}'+
    '.adv-sub{font-size:11px;color:#5e7572}'+
    '.sec-title{font-size:11px;color:#063D38;margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em;font-weight:700}'+
    'table{width:100%;border-collapse:collapse}'+
    '.foot{margin-top:30px;padding-top:14px;border-top:1px solid #ccc;display:flex;justify-content:space-between;font-size:10px;color:#888}'+
    '.print-bar{position:fixed;top:10px;right:10px;display:flex;gap:8px;z-index:99}'+
    '.print-bar button{padding:8px 16px;border:none;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer}'+
    '.print-bar .pr{background:#063D38;color:#fff}'+
    '.print-bar .cl{background:#ccc;color:#222}'+
    '@media print{.print-bar{display:none}body{background:#fff;padding:0}.sheet{box-shadow:none;max-width:none;margin:0;padding:18px}.page-break{page-break-before:always}}'+
    '</style></head><body>'+
    '<div class="print-bar"><button class="pr" onclick="window.print()">🖨️ Imprimir / Salvar PDF</button><button class="cl" onclick="window.close()">Fechar</button></div>'+
    '<div class="sheet">'+
      '<div class="hdr">'+
        '<div><div class="brand-name">PBL</div><div class="brand-sub">Relatório Consolidado de Comissões</div></div>'+
        '<div class="doc-title"><strong>Período: '+esc(mesRef)+'</strong>Emitido em '+dataGer+'<br/>Por: '+esc(emitidoPor)+'</div>'+
      '</div>'+
      '<div class="summary">'+
        '<div class="sec-title">Resumo geral — '+todos.length+' advogado(s)</div>'+
        '<table>'+
          '<thead><tr><th>Advogado</th><th>Pró-labore</th><th>Comissões</th><th>Total</th></tr></thead>'+
          '<tbody>'+summaryRows+'</tbody>'+
          '<tfoot><tr><td>TOTAL GERAL</td><td>'+fmt(totP)+'</td><td>'+fmt(totG-totP)+'</td><td>'+fmt(totG)+'</td></tr></tfoot>'+
        '</table>'+
      '</div>'+
      blocks+
      '<div class="foot"><div>PBL — Sistema de Gestão de Comissões</div><div>Relatório gerado automaticamente</div></div>'+
    '</div></body></html>';

  var w=window.open('','_blank');
  if(!w){showToast('Permita pop-ups para gerar o relatório.');return;}
  w.document.write(html);
  w.document.close();
}
function showDetail(lid){
  if(!lid)return;var c=calc(lid);if(!c)return;var e=c.entry;
  // Se há lançamentos no S.liqManual, ignora 100% do legado (modo novo)
  var temLiqManual=(S.liqManual||[]).some(function(m){return m.advogadoId===lid;});
  var legadoFiltrado=temLiqManual ? [] : (e.processos||[]);
  // Legado (import) — apenas no modo antigo
  var procRowsLegado=legadoFiltrado.map(function(p){
    var isPar=p.tipo==='Parcial';
    var com=isPar?0:(p.valor<10000?50:100);
    var bd=isPar?'<span style="background:#fff3cd;color:#856404;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700">PARCIAL</span>':'<span style="background:#d4edda;color:#155724;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700">TOTAL</span>';
    return '<tr><td style="padding:4px 8px;font-size:11px;color:var(--mt)">'+
      (p.ref||'---')+'</td><td style="padding:4px 8px">—</td><td style="padding:4px 8px">'+bd+'</td><td style="padding:4px 8px;font-size:11px;text-align:right">'+fmt(p.valor)+'</td>'+
      '<td style="padding:4px 8px;font-size:11px;text-align:right;color:'+(isPar?'var(--mt)':'var(--v)')+';font-weight:600">'+(isPar?'—':'R$ '+com)+'</td></tr>';
  }).join('');
  // Manual agrupado
  var grpManual={};
  (S.liqManual||[]).forEach(function(m){
    if(m.advogadoId!==lid)return;
    if(!inPeriodo(m.data))return; // segue o período selecionado (igual ao motor calc)
    var key=(m.processo||'(sem nº)')+'|'+(m.titularidade||'');
    if(!grpManual[key])grpManual[key]={proc:m.processo||'(sem nº)',titularidade:m.titularidade,total:0,qtd:0,temTotal:false};
    grpManual[key].total+=(m.valor||0);
    grpManual[key].qtd++;
    if(m.liquidacao==='Total')grpManual[key].temTotal=true;
  });
  var procRowsManual=Object.keys(grpManual).map(function(k){
    var g=grpManual[k];
    var com=g.temTotal?(g.total<10000?50:100):0;
    var bdSt=g.temTotal?'<span style="background:#d4edda;color:#155724;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700">100% LIQUIDADO</span>':'<span style="background:#fff3cd;color:#856404;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700">EM ANDAMENTO ('+g.qtd+' parc.)</span>';
    var corCart=g.titularidade==='FIDC PBL'?'#185FA5':g.titularidade==='PBL Originadora'?'#B8860B':'#1D6B3A';
    var bdCart='<span style="background:'+corCart+';color:#fff;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700">'+esc(g.titularidade||'')+'</span>';
    return '<tr><td style="padding:4px 8px;font-size:11px;color:var(--mt)">'+esc(g.proc)+'</td><td style="padding:4px 8px">'+bdCart+'</td><td style="padding:4px 8px">'+bdSt+'</td><td style="padding:4px 8px;font-size:11px;text-align:right">'+fmt(g.total)+'</td>'+
      '<td style="padding:4px 8px;font-size:11px;text-align:right;color:'+(g.temTotal?'var(--v)':'var(--mt)')+';font-weight:600">'+(g.temTotal?'R$ '+com:'—')+'</td></tr>';
  }).join('');
  var totalLinhas=legadoFiltrado.length+Object.keys(grpManual).length;
  var procDetail=totalLinhas>0?
    '<div style="margin:4px 0 8px;border:1px solid var(--bd);border-radius:6px;overflow:hidden">'+
    '<table style="width:100%;border-collapse:collapse">'+
    '<thead><tr style="background:var(--vl)">'+
    '<th style="padding:5px 8px;font-size:10px;text-align:left;color:var(--v)">Processo</th>'+
    '<th style="padding:5px 8px;font-size:10px;text-align:left;color:var(--v)">Origem</th>'+
    '<th style="padding:5px 8px;font-size:10px;text-align:left;color:var(--v)">Status</th>'+
    '<th style="padding:5px 8px;font-size:10px;text-align:right;color:var(--v)">Valor</th>'+
    '<th style="padding:5px 8px;font-size:10px;text-align:right;color:var(--v)">Comissão</th></tr></thead>'+
    '<tbody>'+procRowsLegado+procRowsManual+'</tbody></table>'+
    '<div style="padding:6px 8px;font-size:10px;color:var(--mt);background:var(--row-alt);border-top:1px solid var(--bd)">⚠️ A comissão por processo só é liberada quando o processo está <strong>100% liquidado</strong> (todas as parcelas recebidas).</div>'+
    '</div>':'';
  var totalLiq=c.volLiqTotalParcial||0;
  var labelLiq='Prêmio liquidação (Total+Parcial: '+fmt(totalLiq)+') — '+
    (totalLiq>=500000?'a partir de R$500k, +R$100 a cada R$100k':'meta R$500k para iniciar prêmio');
  var ehCalculista=lawyerEhCalculista(lid);
  var podeMarcar=podeMarcarMetaExec(currentUser);
  function _crow(l,v){ return '<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:.5px solid var(--bd);font-size:13px"><div style="color:var(--mt)">'+l+'</div><div>'+fmt(v)+'</div></div>'; }
  var m='<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px"><div class="mc"><div class="ml">Total</div><div class="mv">'+fmt(c.total)+'</div></div><div class="mc"><div class="ml">Pró-labore</div><div class="mv">'+fmt(c.prolaboreTotal)+'</div></div><div class="mc gold"><div class="ml">Comissões</div><div class="mv gold">'+fmt(c.total-c.prolaboreTotal)+'</div></div></div>';
  var actions='<div style="display:flex;gap:8px;justify-content:flex-end;margin-bottom:14px"><button class="btn bp" style="font-size:12px" onclick="gerarRelatorioAdvogado('+JSON.stringify(lid)+')">📄 Gerar Relatório</button><button class="btn" style="font-size:12px;background:#1D6B3A;color:#fff" onclick="exportarComissaoExcel('+JSON.stringify(lid)+')">📊 Exportar Excel</button></div>';
  var rows='';
  if(c.guilherme){
    rows+=_crow('Pró-labore fixo',c.prolaboreTotal);
    rows+='<div style="padding:10px 0 4px;font-size:12px;font-weight:700;color:var(--v)">Metas de execução — R$ 500 cada <span style="font-weight:400;color:var(--mt)">('+esc(_campMesLabel(c.execMes))+' · marque as atingidas no mês)</span></div>';
    rows+=c.execMetas.map(function(em){
      var ctrl=podeMarcar
        ? '<label style="display:flex;align-items:center;gap:7px;cursor:pointer;color:var(--v)"><input type="checkbox" '+(em.atingida?'checked':'')+' onchange="guilhermeToggle(\''+em.key+'\','+JSON.stringify(lid)+')"/> '+esc(em.label)+'</label>'
        : '<span style="color:var(--v)">'+(em.atingida?'✓ ':'○ ')+esc(em.label)+'</span>';
      return '<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:.5px solid var(--bd);font-size:13px">'+ctrl+'<div style="font-weight:600;color:'+(em.atingida?'var(--green)':'var(--mt)')+'">'+fmt(em.atingida?500:0)+'</div></div>';
    }).join('');
    rows+='<div style="display:flex;justify-content:space-between;padding:5px 0 9px;font-size:12px;color:var(--mt);border-bottom:.5px solid var(--bd)"><div>Subtotal metas de execução</div><div>'+fmt(c.execTotal)+' / '+fmt(2000)+'</div></div>';
    rows+=_crow('Campanhas',c.cCamp);
  } else if(c.supervisora){
    rows+=_crow('Pró-labore fixo',c.prolaboreTotal);
    rows+=_crow('Bônus META do contencioso'+(c.supMetaMeses>1?(' ('+c.supMetaMeses+' meses)'):'')+' — '+(c.supMetaMeses?'atingida':'não atingida'),c.supBonusMeta);
    rows+=_crow('Bônus SUPERMETA do contencioso'+(c.supSuperMeses>1?(' ('+c.supSuperMeses+' meses)'):'')+' — '+(c.supSuperMeses?'atingida':'não atingida'),c.supBonusSuper);
    rows+=_crow('Campanhas',c.cCamp);
    var trCtrl=podeMarcar
      ? '<input type="number" min="0" value="'+(c.treinoQtd||0)+'" onchange="karenTreinoSet(this.value,'+JSON.stringify(lid)+')" style="width:58px;padding:3px 6px;border:1px solid var(--bd);border-radius:5px;font-size:12px"/>'
      : '<b>'+(c.treinoQtd||0)+'</b>';
    rows+='<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:.5px solid var(--bd);font-size:13px"><div style="color:var(--mt);display:flex;align-items:center;gap:8px">Treinamentos (R$ 500 cada): '+trCtrl+' no mês</div><div>'+fmt(c.cTreino||0)+'</div></div>';
  } else {
    var items=[
      {l:'Pró-labore fixo',v:c.prolaboreTotal},
      {l:'Processos 100% liquidados ('+c.qtdProcTot+' de '+totalLinhas+') — R$50 abaixo de R$10k / R$100 acima',v:c.cP},
      {l:'Processos validados ('+c.qtdProcVal+')',v:c.cPV},
      {l:'Contratos validados ('+c.qtdContVal+')',v:c.cCV},
      {l:'Capa a capa ('+c.qtdCapa+')',v:c.cCapa},
      {l:'Auditoria ('+c.qtdAud+')',v:c.cAud},
      {l:'Bônus entradas',v:c.cEnt},
      {l:labelLiq,v:c.cLiq},
      {l:'Campanhas',v:c.cCamp}
    ];
    if(ehCalculista) items.push({l:'Cálculo Cumprimento de Sentença ('+c.calcQtd+' × R$ '+calcValorUnit()+')',v:c.cCalc});
    rows=items.map(function(it,idx){return'<div style="display:flex;flex-direction:column;padding:8px 0;border-bottom:.5px solid var(--bd);font-size:13px"><div style="display:flex;justify-content:space-between"><div style="color:var(--mt)">'+it.l+'</div><div>'+fmt(it.v)+'</div></div>'+(idx===1?procDetail:'')+'</div>';}).join('');
  }
  var calcSec = (ehCalculista && !c.supervisora && currentPage==='minhascomissoes') ? calcSectionHTML(lid) : '';
  document.getElementById('detail-content').innerHTML=m+actions+'<div class="card">'+rows+'<div style="display:flex;justify-content:space-between;padding:11px 0 0;font-size:15px;font-weight:700"><div>Total a pagar</div><div style="color:var(--v)">'+fmt(c.total)+'</div></div></div>'+calcSec;
}
// Lista read-only dos cálculos do advogado (aparece só em Minhas Comissões). Registro/edição vivem na aba Cumprimento de Sentença.
function calcSectionHTML(lid){
  var ents=calcCalcDoLawyer(lid).slice().sort(function(a,b){return String(b.data||'').localeCompare(String(a.data||''));});
  var lista=ents.length? ents.map(function(en){
    return '<tr><td style="padding:5px 8px;font-size:11px">'+fmtDate(en.data)+'</td><td style="padding:5px 8px;font-size:11px">'+(en.numero?esc(en.numero):(en.desc?esc(en.desc):'<span style="color:var(--mt)">—</span>'))+'</td><td style="padding:5px 8px;font-size:11px;text-align:center">'+(en.qtd||1)+'</td><td style="padding:5px 8px;font-size:11px;text-align:right;color:var(--v);font-weight:600">'+fmt((en.qtd||1)*(en.valorUnit||calcValorUnit()))+'</td></tr>';
  }).join('') : '<tr><td colspan="4" style="padding:10px;text-align:center;color:var(--mt);font-size:12px">Nenhum cálculo registrado no período.</td></tr>';
  return '<div class="card" style="margin-top:14px"><div style="margin-bottom:8px">'+
    '<b style="color:var(--v)">Cálculo Cumprimento de Sentença</b><div style="font-size:11px;color:var(--mt)">R$ '+calcValorUnit()+',00 por cálculo · '+calcCalcQtd(lid)+' no período · total '+fmt(calcCalcTotal(lid))+'</div></div>'+
    '<table style="width:100%;border-collapse:collapse"><thead><tr style="background:var(--vl)"><th style="padding:5px 8px;font-size:10px;text-align:left;color:var(--v)">Data</th><th style="padding:5px 8px;font-size:10px;text-align:left;color:var(--v)">Processo</th><th style="padding:5px 8px;font-size:10px;text-align:center;color:var(--v)">Qtd</th><th style="padding:5px 8px;font-size:10px;text-align:right;color:var(--v)">Valor</th></tr></thead><tbody>'+lista+'</tbody></table></div>';
}
function modalConfigCalculo(lid){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador.'); return; }
  showModal('<div class="modal-title">Valor por cálculo (Cumprimento de Sentença)</div>'+
    '<p style="font-size:13px;color:var(--mt)">Valor unitário aplicado a novos lançamentos de cálculo. Não altera lançamentos já feitos.</p>'+
    '<div class="fg" style="max-width:160px"><label>Valor (R$)</label><input id="cc-val" type="number" min="0" step="1" value="'+calcValorUnit()+'"/></div>'+
    '<div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="salvarConfigCalculo(\''+lid+'\')">Salvar</button></div>');
}
async function salvarConfigCalculo(lid){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador.'); return; }
  var v=parseFloat(document.getElementById('cc-val').value); if(isNaN(v)||v<0){ showToast('Valor inválido.'); return; }
  S.calcValorUnit=v;
  try{ await fb.setDoc(fb.doc(fb.db,'config','calculos'), {valorUnit:v, updatedAt:fb.serverTimestamp(), updatedBy:currentUser.id}, {merge:true}); }catch(e){ showToast('Erro: '+(e.code||e.message)); return; }
  closeModal(); showDetail(lid); showToast('Valor por cálculo definido em '+fmt(v)+'.');
}

// ════════════════════════════════════════════════════════════
// CUMPRIMENTO DE SENTENÇA — aba dedicada (Contencioso)
// ════════════════════════════════════════════════════════════
function csKpi(l,v,gold){ return '<div class="mc'+(gold?' gold':'')+'"><div class="ml">'+esc(String(l))+'</div><div class="mv'+(gold?' gold':'')+'">'+v+'</div></div>'; }
function csPeritoBadge(tipo){
  return tipo==='advogado'
    ? '<span style="display:inline-block;font-size:10px;font-weight:700;padding:2px 7px;border-radius:8px;background:var(--greenl);color:var(--green)">Advogado · R$ '+calcValorUnit()+'</span>'
    : '<span style="display:inline-block;font-size:10px;font-weight:700;padding:2px 7px;border-radius:8px;background:var(--vl);color:var(--v)">CLT · só quantidade</span>';
}
function pageCumprimentoSentenca(){
  if(!podeVerCumprimento(currentUser)) return '<div class="page-title">'+I.diligencias+' Cumprimento de Sentença</div><div class="card"><div class="empty">Acesso restrito.</div></div>';
  var regs=calculosNoEscopo().slice().sort(function(a,b){return String(b.data||'').localeCompare(String(a.data||''));});
  var podeReg=podeRegistrarCalculo();
  var totalCalc=regs.length;
  var comTotal=regs.reduce(function(s,c){return s+calcComissaoDe(c);},0);
  var valTotal=regs.reduce(function(s,c){return s+(Number(c.valorFinal)||0);},0);
  var peritos=peritosList();

  var kpis='<div class="metrics" style="margin-bottom:16px">'+
    csKpi('Cálculos no mês', totalCalc)+
    csKpi('Comissão gerada', fmt(comTotal), true)+
    csKpi('Valor total dos cálculos', fmt(valTotal))+
    csKpi('Peritos ativos', peritos.length)+
  '</div>';

  var TH='style="padding:6px 8px;font-size:10px;color:var(--v);text-align:left;text-transform:uppercase;letter-spacing:.04em;background:var(--vl)"';
  var TD='style="padding:7px 8px;font-size:12px;border-bottom:.5px solid var(--bd)"';
  var rows=regs.map(function(c){
    var adv=!!c.advogadoId;
    return '<tr>'+
      '<td '+TD+'>'+fmtDate(c.data)+'</td>'+
      '<td '+TD+' style="font-family:ui-monospace,Menlo,monospace">'+esc(c.numero||'—')+'</td>'+
      '<td '+TD+'>'+esc(c.peritoNome||'—')+' '+csPeritoBadge(adv?'advogado':'clt')+'</td>'+
      '<td '+TD+' style="text-align:right">'+fmt(c.valorFinal||0)+'</td>'+
      '<td '+TD+' style="text-align:right;color:var(--v);font-weight:700">'+(adv?('+'+fmt(calcComissaoDe(c))):'<span style="color:var(--mt)">—</span>')+'</td>'+
      (podeReg?'<td '+TD+' style="text-align:right"><button class="dbtn" title="Remover" onclick="delCalculoCS(\''+c.id+'\')">×</button></td>':'')+
    '</tr>';
  }).join('') || '<tr><td colspan="'+(podeReg?6:5)+'" style="text-align:center;color:var(--mt);padding:16px">Nenhum cálculo registrado no período.</td></tr>';

  var tabela='<div class="card" style="padding:0;overflow-x:auto">'+
    '<div style="display:flex;justify-content:space-between;align-items:center;padding:14px 16px">'+
      '<div><b style="color:var(--v)">Cálculos registrados</b><div style="font-size:11px;color:var(--mt)">Advogado recebe R$ '+calcValorUnit()+',00 por cálculo (comissão). CLT: só quantidade.</div></div>'+
      (podeReg?'<button class="btn bp" style="font-size:12px" onclick="modalRegistrarCalculo()">+ Registrar cálculo</button>':'')+
    '</div>'+
    '<table style="width:100%;border-collapse:collapse"><thead><tr>'+
      '<th '+TH+'>Data</th><th '+TH+'>Processo</th><th '+TH+'>Perito Contábil</th>'+
      '<th '+TH+' style="text-align:right">Valor do cálculo</th><th '+TH+' style="text-align:right">Comissão gerada</th>'+(podeReg?'<th '+TH+'></th>':'')+
    '</tr></thead><tbody>'+rows+'</tbody></table></div>';

  // Resumo por perito (no escopo/período)
  var res={};
  regs.forEach(function(c){ var k=c.peritoId||c.peritoNome; if(!res[k]) res[k]={nome:c.peritoNome||'—',tipo:(c.advogadoId?'advogado':'clt'),qtd:0,com:0}; res[k].qtd++; res[k].com+=calcComissaoDe(c); });
  var resumoRows=Object.keys(res).map(function(k){var p=res[k];
    return '<tr><td '+TD+'>'+esc(p.nome)+'</td><td '+TD+'>'+csPeritoBadge(p.tipo)+'</td><td '+TD+' style="text-align:center">'+p.qtd+'</td>'+
      '<td '+TD+' style="text-align:right;color:var(--v);font-weight:700">'+(p.tipo==='advogado'?fmt(p.com):'<span style="color:var(--mt)">—</span>')+'</td></tr>';
  }).join('') || '<tr><td colspan="4" style="text-align:center;color:var(--mt);padding:12px">—</td></tr>';
  var resumo='<div class="card" style="padding:0;overflow-x:auto"><div style="padding:12px 16px"><b style="color:var(--v)">Resumo por perito contábil (período)</b></div>'+
    '<table style="width:100%;border-collapse:collapse"><thead><tr><th '+TH+'>Perito</th><th '+TH+'>Tipo</th><th '+TH+' style="text-align:center">Qtd.</th><th '+TH+' style="text-align:right">Comissão</th></tr></thead><tbody>'+resumoRows+'</tbody></table></div>';

  return '<div class="page-title">'+I.diligencias+' Cumprimento de Sentença</div>'+
    '<div class="sub" style="font-size:12px;color:var(--mt);margin-bottom:14px">Registro dos cálculos por processo. Cada cálculo de advogado vale R$ '+calcValorUnit()+',00 e entra na comissão dele. Segue o seletor de período.</div>'+
    kpis+tabela+'<div style="height:14px"></div>'+resumo;
}
function modalRegistrarCalculo(){
  if(!podeRegistrarCalculo()){ showToast('Sem permissão para registrar cálculos.'); return; }
  var peritos=peritosList();
  if(!peritos.length){ showToast('Nenhum perito contábil cadastrado.'); return; }
  var opts=peritos.map(function(p){return '<option value="'+esc(p.id)+'">'+esc(p.nome)+' — '+(p.tipo==='advogado'?'Advogado (R$ '+calcValorUnit()+')':'CLT')+'</option>';}).join('');
  showModal('<div class="modal-title">Registrar cálculo — Cumprimento de Sentença</div>'+
    '<div class="fg" style="margin-bottom:10px"><label>Número do processo *</label><input id="cs-num" placeholder="0000000-00.0000.0.00.0000"/></div>'+
    '<div class="fg" style="margin-bottom:10px"><label>Perito Contábil (quem realizou) *</label><select id="cs-perito">'+opts+'</select>'+
      '<div style="font-size:11px;color:var(--mt);margin-top:3px">O advogado recebe R$ '+calcValorUnit()+',00 na comissão. CLT apenas contabiliza a quantidade.</div></div>'+
    '<div style="display:flex;gap:10px"><div class="fg" style="flex:1"><label>Valor final do cálculo (R$) *</label><input id="cs-val" type="number" min="0" step="0.01" placeholder="0,00"/></div>'+
    '<div class="fg" style="max-width:170px"><label>Data</label><input id="cs-data" type="date" value="'+todayStr()+'"/></div></div>'+
    '<div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="salvarCalculoCS()">Salvar</button></div>');
}
async function salvarCalculoCS(){
  if(!podeRegistrarCalculo()){ showToast('Sem permissão.'); return; }
  var num=(document.getElementById('cs-num').value||'').trim();
  var pid=document.getElementById('cs-perito').value;
  var val=parseFloat(document.getElementById('cs-val').value);
  var data=document.getElementById('cs-data').value||todayStr();
  var perito=peritosList().find(function(p){return p.id===pid;});
  if(!num){ showToast('Informe o número do processo.'); return; }
  if(!perito){ showToast('Selecione o perito contábil.'); return; }
  if(isNaN(val)||val<0){ showToast('Informe o valor final do cálculo.'); return; }
  var adv=perito.tipo==='advogado';
  try{
    await saveCalculo({ id:null, numero:num, peritoId:perito.id, peritoTipo:perito.tipo, peritoNome:perito.nome,
      advogadoId: adv?perito.advogadoId:null, valorFinal:val, valorUnit: adv?calcValorUnit():0, qtd:1, mes:data.slice(0,7), data:data });
    S.calculos=await fetchCollection('calculos');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); return; }
  closeModal(); navigate('cumprimentosentenca');
  showToast(adv?('Cálculo registrado. +'+fmt(calcValorUnit())+' para '+perito.nome+'.'):('Cálculo registrado para '+perito.nome+' (CLT — só quantidade).'));
}
async function delCalculoCS(id){
  if(!podeRegistrarCalculo()){ showToast('Sem permissão.'); return; }
  if(!confirm('Remover este cálculo?')) return;
  try{ await deleteCalculoDoc(id); S.calculos=await fetchCollection('calculos'); }catch(e){ showToast('Erro: '+(e.code||e.message)); return; }
  navigate('cumprimentosentenca'); showToast('Cálculo removido.');
}

// ════════════════════════════════════════════════════════════
// RELATÓRIO DE COMISSÃO POR ADVOGADO (imprimível / PDF)
// ════════════════════════════════════════════════════════════
function gerarRelatorioAdvogado(lid){
  var c=calc(lid);if(!c){showToast('Advogado sem dados.');return;}
  var e=c.entry;

  // Se há S.liqManual, ignora 100% do legado (modo novo)
  var temLiqManual=(S.liqManual||[]).some(function(m){return m.advogadoId===lid;});
  var procs=temLiqManual ? [] : (e.processos||[]);

  // Lançamentos manuais agrupados por processo
  var grpManual={};
  (S.liqManual||[]).forEach(function(m){
    if(m.advogadoId!==lid)return;
    if(!inPeriodo(m.data))return; // segue o período selecionado (igual ao motor calc)
    var key=(m.processo||'(sem nº)')+'|'+(m.titularidade||'');
    if(!grpManual[key])grpManual[key]={proc:m.processo||'(sem nº)',titularidade:m.titularidade,total:0,qtd:0,temTotal:false};
    grpManual[key].total+=(m.valor||0);
    grpManual[key].qtd++;
    if(m.liquidacao==='Total')grpManual[key].temTotal=true;
  });
  var manualArr=Object.keys(grpManual).map(function(k){return grpManual[k];});

  var procRowsLegado=procs.map(function(p,i){
    var isPar=p.tipo==='Parcial';
    var com=isPar?0:(p.valor<10000?50:100);
    var bd=isPar?'<span style="background:#fff3cd;color:#856404;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700">PARCIAL</span>':'<span style="background:#d4edda;color:#155724;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700">TOTAL</span>';
    var bg=i%2===0?'':'background:#f7faf9';
    return '<tr style="'+bg+'"><td style="padding:6px 10px">'+(i+1)+'</td><td style="padding:6px 10px;font-size:11px">'+esc(p.ref||'---')+'</td><td style="padding:6px 10px;font-size:10px;color:#888">—</td><td style="padding:6px 10px">'+bd+'</td><td style="padding:6px 10px;text-align:right">'+fmt(p.valor||0)+'</td><td style="padding:6px 10px;text-align:right;font-weight:600;color:'+(isPar?'#888':'#063D38')+'">'+(isPar?'—':'R$ '+com)+'</td></tr>';
  }).join('');
  var procRowsManual=manualArr.map(function(g,i){
    var com=g.temTotal?(g.total<10000?50:100):0;
    var bd=g.temTotal?'<span style="background:#d4edda;color:#155724;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700">100% LIQUIDADO</span>':'<span style="background:#fff3cd;color:#856404;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700">'+g.qtd+' parc.</span>';
    var bg=(procs.length+i)%2===0?'':'background:#f7faf9';
    return '<tr style="'+bg+'"><td style="padding:6px 10px">'+(procs.length+i+1)+'</td><td style="padding:6px 10px;font-size:11px">'+esc(g.proc||'---')+'</td><td style="padding:6px 10px;font-size:10px;color:#5e7572">'+esc(g.titularidade||'')+'</td><td style="padding:6px 10px">'+bd+'</td><td style="padding:6px 10px;text-align:right">'+fmt(g.total||0)+'</td><td style="padding:6px 10px;text-align:right;font-weight:600;color:'+(g.temTotal?'#063D38':'#888')+'">'+(g.temTotal?'R$ '+com:'—')+'</td></tr>';
  }).join('');
  var procRows=procRowsLegado+procRowsManual;
  if(!procRows) procRows='<tr><td colspan="6" style="padding:14px;text-align:center;color:#888;font-size:12px">Sem processos liquidados no período.</td></tr>';

  var totalLiqVol=c.volLiqTotalParcial||0;
  var qtdProcTotal=procs.length+manualArr.length;
  var labelLiq=totalLiqVol>=500000?'+R$100 a cada R$100k (a partir de R$500k)':'Meta de R$500k para iniciar';
  var items;
  if(c.guilherme){
    items=[{l:'Pró-labore fixo',v:c.prolaboreTotal,d:''}].concat(
      c.execMetas.map(function(em){ return {l:'Meta de execução — '+em.label,v:em.atingida?500:0,d:em.atingida?'atingida':'não atingida'}; }),
      [{l:'Campanhas',v:c.cCamp,d:''}]
    );
  } else if(c.supervisora){
    items=[
      {l:'Pró-labore fixo',v:c.prolaboreTotal,d:''},
      {l:'Bônus META do contencioso',v:c.supBonusMeta,d:(c.supMetaMeses?'atingida':'não atingida')+(c.supMetaMeses>1?(' ('+c.supMetaMeses+' meses)'):'')},
      {l:'Bônus SUPERMETA do contencioso',v:c.supBonusSuper,d:(c.supSuperMeses?'atingida':'não atingida')+(c.supSuperMeses>1?(' ('+c.supSuperMeses+' meses)'):'')},
      {l:'Campanhas',v:c.cCamp,d:''},
      {l:'Treinamentos',v:c.cTreino||0,d:(c.treinoQtd||0)+' × R$500'}
    ];
  } else {
    items=[
      {l:'Pró-labore fixo',v:c.prolaboreTotal,d:''},
      {l:'Processos 100% liquidados',v:c.cP,d:c.qtdProcTot+' processos × R$50/R$100'},
      {l:'Processos validados',v:c.cPV,d:c.qtdProcVal+' × R$5'},
      {l:'Contratos validados',v:c.cCV,d:c.qtdContVal+' × R$2'},
      {l:'Capa a capa',v:c.cCapa,d:c.qtdCapa+' × R$10'},
      {l:'Auditoria',v:c.cAud,d:c.qtdAud+' × R$10'},
      {l:'Bônus entradas',v:c.cEnt,d:'sobre volume de entradas'},
      {l:'Prêmio liquidação',v:c.cLiq,d:'volume liquidado: '+fmt(totalLiqVol)+' — '+labelLiq},
      {l:'Campanhas',v:c.cCamp,d:''}
    ];
  }
  var rowsHtml=items.map(function(it){
    return '<tr><td style="padding:8px 12px;border-bottom:1px solid #eef1f0">'+it.l+(it.d?'<div style="font-size:10px;color:#888;margin-top:2px">'+it.d+'</div>':'')+'</td><td style="padding:8px 12px;border-bottom:1px solid #eef1f0;text-align:right;font-weight:600">'+fmt(it.v)+'</td></tr>';
  }).join('');

  var dataGer=new Date().toLocaleDateString('pt-BR')+' '+new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
  var mesRef=S.mes||'';
  var emitidoPor=currentUser?currentUser.name:'';

  var html='<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><title>Relatório — '+esc(c.lawyer.name)+'</title>'+
    '<style>'+
    '*{margin:0;padding:0;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}'+
    'body{background:#f0f3f2;color:#1c1c1c;padding:20px}'+
    '.sheet{max-width:820px;margin:0 auto;background:#fff;padding:36px 44px;box-shadow:0 4px 20px rgba(0,0,0,.08);border-radius:6px}'+
    '.hdr{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid #063D38;padding-bottom:16px;margin-bottom:22px}'+
    '.brand-name{font-size:26px;font-weight:800;color:#063D38;letter-spacing:1px}'+
    '.brand-sub{font-size:11px;color:#888;letter-spacing:.15em;text-transform:uppercase;margin-top:2px}'+
    '.doc-title{font-size:13px;color:#888;text-align:right}'+
    '.doc-title strong{display:block;color:#063D38;font-size:16px;margin-bottom:3px}'+
    '.adv{display:flex;align-items:center;gap:14px;margin-bottom:24px;padding:14px 16px;background:#DDE9E7;border-radius:8px}'+
    '.av{width:50px;height:50px;border-radius:50%;background:#063D38;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:18px}'+
    '.adv-name{font-size:18px;font-weight:700;color:#063D38}'+
    '.adv-sub{font-size:12px;color:#5e7572}'+
    '.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:24px}'+
    '.mc{background:#f7faf9;border:1px solid #d0dbd9;border-radius:6px;padding:10px 12px}'+
    '.ml{font-size:10px;color:#888;text-transform:uppercase;letter-spacing:.05em}'+
    '.mv{font-size:16px;font-weight:700;color:#063D38;margin-top:2px}'+
    '.mc.gold .mv{color:#B8860B}.mc.gold{background:#FDF6E3;border-color:#E6D9A8}'+
    'h2{font-size:13px;color:#063D38;margin:18px 0 8px;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid #DDE9E7;padding-bottom:4px}'+
    'table{width:100%;border-collapse:collapse;font-size:12px;margin-bottom:8px}'+
    'thead tr{background:#063D38;color:#fff}'+
    'thead th{padding:8px 10px;text-align:left;font-weight:600;font-size:11px}'+
    'thead th.r{text-align:right}'+
    '.tot-row td{padding:10px 12px;background:#063D38;color:#fff;font-weight:700;font-size:14px}'+
    '.foot{margin-top:30px;padding-top:14px;border-top:1px solid #ccc;display:flex;justify-content:space-between;font-size:10px;color:#888}'+
    '.note{font-size:10px;color:#888;margin-top:6px;font-style:italic}'+
    '.print-bar{position:fixed;top:10px;right:10px;display:flex;gap:8px;z-index:99}'+
    '.print-bar button{padding:8px 16px;border:none;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer}'+
    '.print-bar .pr{background:#063D38;color:#fff}'+
    '.print-bar .cl{background:#ccc;color:#222}'+
    '@media print{.print-bar{display:none}body{background:#fff;padding:0}.sheet{box-shadow:none;max-width:none;margin:0;padding:24px}}'+
    '</style></head><body>'+
    '<div class="print-bar"><button class="pr" onclick="window.print()">🖨️ Imprimir / Salvar PDF</button><button class="cl" onclick="window.close()">Fechar</button></div>'+
    '<div class="sheet">'+
      '<div class="hdr">'+
        '<div><div class="brand-name">PBL</div><div class="brand-sub">Relatório de Comissão</div></div>'+
        '<div class="doc-title"><strong>Período: '+esc(mesRef)+'</strong>Emitido em '+dataGer+'<br/>Por: '+esc(emitidoPor)+'</div>'+
      '</div>'+
      '<div class="adv">'+
        '<div class="av">'+ini(c.lawyer.name)+'</div>'+
        '<div><div class="adv-name">'+esc(c.lawyer.name)+'</div><div class="adv-sub">Advogado(a)</div></div>'+
      '</div>'+
      '<div class="metrics">'+
        '<div class="mc"><div class="ml">Total a pagar</div><div class="mv">'+fmt(c.total)+'</div></div>'+
        '<div class="mc"><div class="ml">Pró-labore</div><div class="mv">'+fmt(c.prolaboreTotal)+'</div></div>'+
        '<div class="mc gold"><div class="ml">Comissões</div><div class="mv">'+fmt(c.total-c.prolaboreTotal)+'</div></div>'+
        '<div class="mc"><div class="ml">Vol. Liquidado</div><div class="mv">'+fmt(totalLiqVol)+'</div></div>'+
      '</div>'+
      '<h2>Detalhamento das Comissões</h2>'+
      '<table>'+
        '<thead><tr><th>Item</th><th class="r">Valor</th></tr></thead>'+
        '<tbody>'+rowsHtml+'</tbody>'+
        '<tfoot><tr class="tot-row"><td>TOTAL A PAGAR</td><td style="text-align:right">'+fmt(c.total)+'</td></tr></tfoot>'+
      '</table>'+
      '<h2>Processos Liquidados ('+qtdProcTotal+')</h2>'+
      '<table>'+
        '<thead><tr><th style="width:32px">#</th><th>Processo</th><th>Origem</th><th>Status</th><th class="r">Valor</th><th class="r">Comissão</th></tr></thead>'+
        '<tbody>'+procRows+'</tbody>'+
      '</table>'+
      '<div class="note">Volume liquidado total (Total + Parcial): '+fmt(totalLiqVol)+'. Apenas processos <strong>100% liquidados</strong> geram comissão por processo (R$50 abaixo de R$10.000 / R$100 acima). Lançamentos parciais somam apenas para o prêmio por volume.</div>'+
      '<div class="foot"><div>PBL — Sistema de Gestão de Comissões</div><div>Relatório gerado automaticamente</div></div>'+
    '</div></body></html>';

  var w=window.open('','_blank');
  if(!w){showToast('Permita pop-ups para gerar o relatório.');return;}
  w.document.write(html);
  w.document.close();
}

// ════════════════════════════════════════════════════════════
// RESUMO CONSOLIDADO
// ════════════════════════════════════════════════════════════
function pageResumo(){
  if(!S.lawyers.length)return'<div class="page-title">'+I.resumo+' Resumo Consolidado</div><div class="card"><div class="empty">Cadastre advogados em Lançamentos → Operacional.</div></div>';
  var res=lawyersComissao().map(function(l){return calc(l.id);}).filter(function(c){return !!c;});
  var tP=res.reduce(function(s,r){return s+r.lawyer.prolabore;},0);
  var tC=res.reduce(function(s,r){return s+(r.total-r.lawyer.prolabore);},0);
  var tG=tP+tC;
  var tbody=res.map(function(r,i){var bg=i%2===0?'':'background:var(--row-alt);';return'<tr><td style="'+bg+'"><div style="display:flex;align-items:center;gap:9px"><div class="av" style="width:28px;height:28px;font-size:10px;'+avSt(i)+'">'+ini(r.lawyer.name)+'</div>'+r.lawyer.name+'</div></td><td class="r" style="'+bg+'">'+fmt(r.lawyer.prolabore)+'</td><td class="r" style="'+bg+'">'+fmt(r.total-r.lawyer.prolabore)+'</td><td class="r" style="'+bg+';font-weight:700">'+fmt(r.total)+'</td></tr>';}).join('');
  return'<div class="page-title">'+I.resumo+' Resumo Consolidado</div>'+
  '<div class="metrics">'+
    '<div class="mc"><div class="ml">Total geral</div><div class="mv">'+fmt(tG)+'</div></div>'+
    '<div class="mc gold"><div class="ml">Pró-labore total</div><div class="mv gold">'+fmt(tP)+'</div></div>'+
    '<div class="mc"><div class="ml">Comissões total</div><div class="mv">'+fmt(tC)+'</div></div>'+
    '<div class="mc blue"><div class="ml">Advogados</div><div class="mv blue">'+lawyersComissao().length+'</div></div>'+
  '</div>'+
  '<div class="card" style="padding:0;overflow-x:auto">'+
    '<table class="tbl"><thead><tr><th>Advogado</th><th class="r">Pró-labore</th><th class="r">Comissões</th><th class="r">Total</th></tr></thead>'+
    '<tbody>'+tbody+'</tbody>'+
    '<tfoot><tr class="foot"><td>Total</td><td class="r">'+fmt(tP)+'</td><td class="r">'+fmt(tC)+'</td><td class="r">'+fmt(tG)+'</td></tr></tfoot>'+
  '</table></div>';
}

// ════════════════════════════════════════════════════════════
// LIQUIDAÇÕES — lançamento manual com origem (FIDC/PBL/CertJud),
// suporte a recebimentos parciais e consulta com filtros
// ════════════════════════════════════════════════════════════
function pageRelLiquidados(){
  var canDelete=canDeleteLiquidacoes(currentUser); // admin/supervisora podem excluir
  var canWrite=canWriteLiquidacoes(currentUser); // admin/gestora/supervisora podem escrever; lawyer apenas leitura.
  var advOpts=S.lawyers.map(function(l){return'<option value="'+l.id+'">'+l.name+'</option>';}).join('');

  // Estado atual dos filtros (preservado entre re-renders)
  var fOri=document.getElementById('liq-fori')?document.getElementById('liq-fori').value:'todos';
  var fAdv=document.getElementById('liq-fadv')?document.getElementById('liq-fadv').value:'todos';
  var fLiq=document.getElementById('liq-fliq')?document.getElementById('liq-fliq').value:'todos';
  var fDi=document.getElementById('liq-fdi')?document.getElementById('liq-fdi').value:'';
  var fDf=document.getElementById('liq-fdf')?document.getElementById('liq-fdf').value:'';
  var fBuscaRaw=document.getElementById('liq-fbusca')?(document.getElementById('liq-fbusca').value||''):'';
  var fBusca=fBuscaRaw.toLowerCase();
  var fAgrup=document.getElementById('liq-fagrup')?document.getElementById('liq-fagrup').checked:false;

  var todos=(S.liqManual||[]).slice();

  // Aplica filtros
  var filtrados=todos.filter(function(m){
    if(fOri!=='todos' && m.titularidade!==fOri)return false;
    if(fAdv!=='todos' && m.advogadoId!==fAdv)return false;
    if(fLiq!=='todos' && m.liquidacao!==fLiq)return false;
    if(fDi && (m.data||'')<fDi)return false;
    if(fDf && (m.data||'')>fDf)return false;
    if(fBusca){
      var s=((m.processo||'')+' '+(m.titularidade||'')+' '+((S.lawyers.find(function(l){return l.id===m.advogadoId;})||{name:''}).name||'')).toLowerCase();
      if(!s.includes(fBusca))return false;
    }
    return true;
  });

  // KPIs
  var kTot=filtrados.length;
  var kVal=filtrados.reduce(function(s,m){return s+(m.valor||0);},0);
  // Créditos liquidados: soma creditos apenas dos lançamentos marcados como 'Total'.
  var kCred=filtrados.filter(function(m){return m.liquidacao==='Total';}).reduce(function(s,m){return s+(parseInt(m.creditos,10)||0);},0);
  var kFidc=filtrados.filter(function(m){return m.titularidade==='FIDC PBL';}).reduce(function(s,m){return s+(m.valor||0);},0);
  var kPbl=filtrados.filter(function(m){return m.titularidade==='PBL Originadora';}).reduce(function(s,m){return s+(m.valor||0);},0);
  var kCer=filtrados.filter(function(m){return m.titularidade==='CERTJUD';}).reduce(function(s,m){return s+(m.valor||0);},0);

  // Linhas detalhadas (modo lista) — ordenadas por data desc
  var listaRows=filtrados.slice().sort(function(a,b){return(b.data||'').localeCompare(a.data||'');}).map(function(m,i){
    var an=(S.lawyers.find(function(l){return l.id===m.advogadoId;})||{name:'—'}).name;
    var corCart=m.titularidade==='FIDC PBL'?'#185FA5':m.titularidade==='PBL Originadora'?'#B8860B':'#1D6B3A';
    var bdCart='<span style="background:'+corCart+';color:#fff;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:600">'+esc(m.titularidade||'')+'</span>';
    var bdLiq=m.liquidacao==='Parcial'?'<span class="badge b-par">Parcial</span>':'<span class="badge b-tot">Total</span>';
    var bg=i%2===0?'':'background:var(--row-alt)';
    var chk=canDelete?'<td style="padding:8px 10px;text-align:center"><input type="checkbox" class="liq-chk" data-id="'+esc(m.id)+'" onchange="liqUpdateBulkState()"/></td>':'';
    var acoes=canWrite?'<td style="padding:8px 10px;text-align:center"><button class="btn" style="font-size:12px;padding:3px 8px" title="Editar" onclick="editLiqManual(\''+esc(m.id)+'\')">✏️</button></td>':'';
    return'<tr style="'+bg+'">'+chk+'<td style="padding:8px 10px">'+bdCart+'</td><td style="padding:8px 10px">'+fmtDate(m.data)+'</td><td style="padding:8px 10px;font-size:11px">'+esc(m.processo||'—')+'</td><td style="padding:8px 10px">'+esc(an)+'</td><td style="padding:8px 10px;text-align:right;font-weight:600">'+fmt(m.valor||0)+'</td><td style="padding:8px 10px;text-align:center">'+(parseInt(m.creditos,10)||0)+'</td><td style="padding:8px 10px">'+bdLiq+'</td>'+acoes+'</tr>';
  }).join('');

  // Modo agrupado — por processo (mostra somatório de parcelas + status global)
  var grupos={};
  filtrados.forEach(function(m){
    var key=(m.processo||'__sem_proc__')+'|'+(m.advogadoId||'')+'|'+(m.titularidade||'');
    if(!grupos[key])grupos[key]={proc:m.processo||'(sem nº)',adv:m.advogadoId,titularidade:m.titularidade,total:0,qtd:0,temTotal:false,creditos:0,ultData:'',lancs:[]};
    grupos[key].total+=(m.valor||0);
    grupos[key].qtd++;
    if(m.liquidacao==='Total'){ grupos[key].temTotal=true; grupos[key].creditos+=(parseInt(m.creditos,10)||0); }
    if((m.data||'')>grupos[key].ultData)grupos[key].ultData=(m.data||'');
    grupos[key].lancs.push(m);
  });
  var gruposArr=Object.keys(grupos).map(function(k){return grupos[k];}).sort(function(a,b){return(b.ultData||'').localeCompare(a.ultData||'');});
  var grupoRows=gruposArr.map(function(g,i){
    var an=(S.lawyers.find(function(l){return l.id===g.adv;})||{name:'—'}).name;
    var corCart=g.titularidade==='FIDC PBL'?'#185FA5':g.titularidade==='PBL Originadora'?'#B8860B':'#1D6B3A';
    var bdCart='<span style="background:'+corCart+';color:#fff;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:600">'+esc(g.titularidade||'')+'</span>';
    // Status: se algum lançamento marcado Total → 100% liquidado (libera comissão); senão é parcial em andamento
    var statusBd=g.temTotal?
      '<span style="background:#d4edda;color:#155724;padding:3px 8px;border-radius:4px;font-size:10px;font-weight:700">✓ 100% LIQUIDADO</span>':
      '<span style="background:#fff3cd;color:#856404;padding:3px 8px;border-radius:4px;font-size:10px;font-weight:700">⏳ EM ANDAMENTO ('+g.qtd+' parc.)</span>';
    var bg=i%2===0?'':'background:var(--row-alt)';
    return'<tr style="'+bg+'"><td style="padding:8px 10px">'+bdCart+'</td><td style="padding:8px 10px">'+fmtDate(g.ultData)+'</td><td style="padding:8px 10px;font-size:11px">'+esc(g.proc)+'</td><td style="padding:8px 10px">'+esc(an)+'</td><td style="padding:8px 10px;text-align:center">'+g.qtd+'</td><td style="padding:8px 10px;text-align:right;font-weight:600">'+fmt(g.total)+'</td><td style="padding:8px 10px;text-align:center">'+(g.temTotal?g.creditos:'—')+'</td><td style="padding:8px 10px;text-align:center">'+statusBd+'</td></tr>';
  }).join('');

  var formHtml=canWrite?
    '<div class="st">Novo lançamento de liquidação</div>'+
    '<div class="card" style="margin-bottom:18px">'+
      '<div class="g3" style="margin-bottom:10px">'+
        '<div class="fg"><label>Origem do crédito *</label><select id="lm-tit">'+titSelectOptions('')+'</select></div>'+
        '<div class="fg"><label>Data *</label><input type="date" id="lm-data" value="'+todayStr()+'"/></div>'+
        '<div class="fg"><label>Advogado *</label><select id="lm-adv"><option value="">Selecione...</option>'+advOpts+'</select></div>'+
      '</div>'+
      '<div class="g3" style="margin-bottom:10px">'+
        '<div class="fg"><label>Nº Processo</label><input type="text" id="lm-proc" placeholder="0000000-00.0000.0.00.0000"/></div>'+
        '<div class="fg"><label>Valor recebido (R$) *</label><input type="number" id="lm-valor" min="0" step="0.01" placeholder="0,00"/></div>'+
        '<div class="fg"><label>Liquidação *</label><select id="lm-liq"><option value="Parcial">Parcial (recebimento parcial)</option><option value="Total">Total (processo 100% liquidado)</option></select></div>'+
      '</div>'+
      '<div class="g3" style="margin-bottom:10px">'+
        '<div class="fg"><label>Qtd. Créditos *</label><input type="number" id="lm-creditos" min="1" step="1" placeholder="Ex: 1"/></div>'+
      '</div>'+
      '<div style="background:var(--vl);padding:9px 12px;border-radius:6px;font-size:11px;color:var(--mt);margin-bottom:10px">💡 <strong>Dica:</strong> use "Parcial" enquanto o processo recebe parcelas. Marque "Total" apenas quando o processo for 100% liquidado — só assim a comissão do advogado é liberada.</div>'+
      '<div style="text-align:right"><button class="btn bp" onclick="addLiqManual()">+ Registrar liquidação</button></div>'+
    '</div>'+
    // bloco de importação de planilha de liquidados
    '<div class="st">📥 Importar planilha de Liquidações</div>'+
    '<div class="card" style="margin-bottom:18px;border:2px dashed #185FA5;background:#f0f7fc">'+
      '<div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">'+
        '<div style="flex:1;min-width:300px">'+
          '<div style="font-size:14px;font-weight:600;color:#185FA5;margin-bottom:4px">Importar lançamentos em massa</div>'+
          '<div style="font-size:11px;color:var(--mt);margin-bottom:10px">Colunas esperadas na planilha: <strong>TITULARIDADE / DATA / PROCESSOS / ADVOGADO / VALOR / LIQUIDAÇÃO / CREDITOS</strong></div>'+
          '<input type="file" id="f-imp-liq" accept=".xlsx,.xls" onchange="importLiqXlsx(this)" style="font-size:13px"/>'+
          '<span id="imp-liq-status" style="margin-left:10px;font-size:12px;color:#185FA5;font-weight:600"></span>'+
        '</div>'+
      '</div>'+
      '<div style="background:#fff3cd;color:#856404;padding:9px 12px;border-radius:6px;font-size:11px;margin-top:10px">⚠️ <strong>Atenção:</strong> a importação adiciona os lançamentos diretamente na lista abaixo. Linhas com advogado não cadastrado são puladas. Marca como "Parcial" ou "Total" conforme a coluna LIQUIDAÇÃO da planilha.</div>'+
    '</div>':
    '<div class="card" style="background:var(--vl);margin-bottom:18px"><p style="font-size:12px;color:var(--v);margin:0">Apenas Admin registra lançamentos.</p></div>';

  // KPIs
  var metricsHtml=
    '<div class="metrics" style="margin-bottom:14px">'+
      '<div class="mc"><div class="ml">Lançamentos</div><div class="mv">'+kTot+'</div></div>'+
      '<div class="mc"><div class="ml">Volume total</div><div class="mv">'+fmt(kVal)+'</div></div>'+
      '<div class="mc gold"><div class="ml">Créditos liquidados</div><div class="mv gold">'+kCred+'</div><div style="font-size:11px;color:var(--mt)">só liquidações Total</div></div>'+
      '<div class="mc blue"><div class="ml">FIDC PBL</div><div class="mv blue">'+fmt(kFidc)+'</div></div>'+
      '<div class="mc gold"><div class="ml">PBL Originadora</div><div class="mv gold">'+fmt(kPbl)+'</div></div>'+
      '<div class="mc green"><div class="ml">CertJud</div><div class="mv green">'+fmt(kCer)+'</div></div>'+
    '</div>';

  // Filtros
  var oriOpts='<option value="todos"'+(fOri==='todos'?' selected':'')+'>Todas as origens</option>'+
    ['PBL Originadora','FIDC PBL','CERTJUD'].map(function(x){return'<option value="'+x+'"'+(fOri===x?' selected':'')+'>'+x+'</option>';}).join('');
  var advFiltOpts='<option value="todos"'+(fAdv==='todos'?' selected':'')+'>Todos advogados</option>'+
    S.lawyers.map(function(l){return'<option value="'+l.id+'"'+(fAdv===l.id?' selected':'')+'>'+esc(l.name)+'</option>';}).join('');
  var liqOpts='<option value="todos"'+(fLiq==='todos'?' selected':'')+'>Todas</option>'+
    ['Total','Parcial'].map(function(x){return'<option value="'+x+'"'+(fLiq===x?' selected':'')+'>'+x+'</option>';}).join('');

  var filtrosHtml=
    '<div class="filter-bar" style="background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:12px;margin-bottom:14px;display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end">'+
      '<div class="fg" style="flex:1;min-width:180px;margin:0"><label>Buscar</label><input type="text" id="liq-fbusca" placeholder="Processo, advogado..." value="'+esc(fBuscaRaw)+'" onkeydown="if(event.key===\'Enter\')navigate(\'reliquidados\')" onblur="if((this.value||\'\').toLowerCase()!==\''+esc(fBusca)+'\')navigate(\'reliquidados\')"/></div>'+
      '<div class="fg" style="min-width:150px;margin:0"><label>Origem</label><select id="liq-fori" onchange="navigate(\'reliquidados\')">'+oriOpts+'</select></div>'+
      '<div class="fg" style="min-width:150px;margin:0"><label>Advogado</label><select id="liq-fadv" onchange="navigate(\'reliquidados\')">'+advFiltOpts+'</select></div>'+
      '<div class="fg" style="min-width:120px;margin:0"><label>Liquidação</label><select id="liq-fliq" onchange="navigate(\'reliquidados\')">'+liqOpts+'</select></div>'+
      '<div class="fg" style="min-width:130px;margin:0"><label>De</label><input type="date" id="liq-fdi" value="'+fDi+'" onchange="navigate(\'reliquidados\')"/></div>'+
      '<div class="fg" style="min-width:130px;margin:0"><label>Até</label><input type="date" id="liq-fdf" value="'+fDf+'" onchange="navigate(\'reliquidados\')"/></div>'+
      '<label style="display:flex;align-items:center;gap:6px;font-size:12px;cursor:pointer;padding:8px 10px;border:1px solid var(--bd);border-radius:6px;background:var(--input)"><input type="checkbox" id="liq-fagrup" '+(fAgrup?'checked':'')+' onchange="navigate(\'reliquidados\')"/> Agrupar por processo</label>'+
      '<button class="btn" onclick="limparFiltrosLiq()" style="font-size:11px">Limpar</button>'+
    '</div>';

  var tabelaHtml;
  if(fAgrup){
    tabelaHtml=
      '<div class="st" style="margin-top:0">Agrupado por processo</div>'+
      '<div style="overflow-x:auto;border-radius:8px;border:1px solid var(--bd)">'+
      '<table style="width:100%;border-collapse:collapse;font-size:13px">'+
      '<thead><tr style="background:var(--v);color:#fff">'+
      '<th style="padding:9px 10px;text-align:left">Origem</th>'+
      '<th style="padding:9px 10px;text-align:left">Última data</th>'+
      '<th style="padding:9px 10px;text-align:left">Processo</th>'+
      '<th style="padding:9px 10px;text-align:left">Advogado</th>'+
      '<th style="padding:9px 10px;text-align:center">Parcelas</th>'+
      '<th style="padding:9px 10px;text-align:right">Total recebido</th>'+
      '<th style="padding:9px 10px;text-align:center">Créditos</th>'+
      '<th style="padding:9px 10px;text-align:center">Status</th>'+
      '</tr></thead>'+
      '<tbody>'+(grupoRows||'<tr><td colspan="8" style="text-align:center;padding:20px;color:var(--mt)">Nenhum lançamento encontrado.</td></tr>')+'</tbody>'+
      '</table></div>';
  } else {
    var chkAllHead = canDelete
      ? '<th style="padding:9px 10px;text-align:center;width:30px"><input type="checkbox" id="liq-chk-all" onchange="liqToggleAll(this.checked)" title="Selecionar tudo"/></th>'
      : '';
    var bulkToolbar = canDelete
      ? '<div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">'+
          '<button id="liq-bulk-del" class="btn no-print" style="font-size:11px;padding:4px 8px;background:transparent;color:var(--mt);border:1px solid var(--bd);opacity:.55" onclick="delLiqSelecionadas()" title="Excluir selecionadas" disabled>'+
            '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>'+
            ' <span id="liq-bulk-count">0</span>'+
          '</button>'+
        '</div>'
      : '';
    var acoesHead = canWrite ? '<th style="padding:9px 10px;text-align:center;width:64px">Ações</th>' : '';
    tabelaHtml=
      '<div class="st" style="margin-top:0">Lançamentos registrados</div>'+
      bulkToolbar+
      '<div style="overflow-x:auto;border-radius:8px;border:1px solid var(--bd)">'+
      '<table style="width:100%;border-collapse:collapse;font-size:13px">'+
      '<thead><tr style="background:var(--v);color:#fff">'+
      chkAllHead+
      '<th style="padding:9px 10px;text-align:left">Origem</th>'+
      '<th style="padding:9px 10px;text-align:left">Data</th>'+
      '<th style="padding:9px 10px;text-align:left">Processo</th>'+
      '<th style="padding:9px 10px;text-align:left">Advogado</th>'+
      '<th style="padding:9px 10px;text-align:right">Valor</th>'+
      '<th style="padding:9px 10px;text-align:center">Créditos</th>'+
      '<th style="padding:9px 10px;text-align:left">Liquidação</th>'+
      acoesHead+
      '</tr></thead>'+
      '<tbody>'+(listaRows||'<tr><td colspan="'+(7+(canDelete?1:0)+(canWrite?1:0))+'" style="text-align:center;padding:20px;color:var(--mt)">Nenhum lançamento encontrado.</td></tr>')+'</tbody>'+
      '</table></div>';
  }

  return'<div class="page-title">'+I.reliq+' Liquidações</div>'+
    formHtml+
    metricsHtml+
    filtrosHtml+
    tabelaHtml;
}

function liqToggleAll(checked){
  Array.prototype.forEach.call(document.querySelectorAll('.liq-chk'), function(el){ el.checked = !!checked; });
  liqUpdateBulkState();
}

function liqUpdateBulkState(){
  var checks = document.querySelectorAll('.liq-chk');
  var marcadas = Array.prototype.filter.call(checks, function(el){return el.checked;});
  var btn = document.getElementById('liq-bulk-del');
  var span = document.getElementById('liq-bulk-count');
  if(span) span.textContent = marcadas.length;
  if(btn){
    if(marcadas.length > 0){
      btn.disabled = false;
      btn.style.opacity = 1;
      btn.style.color = '#c0392b';
      btn.style.borderColor = '#c0392b';
    } else {
      btn.disabled = true;
      btn.style.opacity = .55;
      btn.style.color = 'var(--mt)';
      btn.style.borderColor = 'var(--bd)';
    }
  }
  var head = document.getElementById('liq-chk-all');
  if(head) head.checked = (checks.length > 0 && marcadas.length === checks.length);
}

async function delLiqSelecionadas(){
  if(!canDeleteLiquidacoes(currentUser)){ showToast('Sem permissão para excluir.'); return; }
  var ids = Array.prototype.slice.call(document.querySelectorAll('.liq-chk'))
    .filter(function(el){return el.checked;})
    .map(function(el){return el.getAttribute('data-id');})
    .filter(Boolean);
  if(ids.length === 0){ showToast('Nenhuma liquidação selecionada.'); return; }
  var msg = ids.length === 1
    ? 'Excluir 1 liquidação selecionada?\n\nEsta ação é irreversível.'
    : 'Excluir '+ids.length+' liquidações selecionadas?\n\nEsta ação é irreversível.';
  if(!confirm(msg)) return;
  try{
    showToast('Excluindo '+ids.length+'...');
    for(var i=0; i<ids.length; i+=400){
      var batch = fb.writeBatch(fb.db);
      ids.slice(i, i+400).forEach(function(id){
        batch.delete(fb.doc(fb.db,'liquidacoes',id));
      });
      await batch.commit();
    }
    S.liqManual = await fetchCollection('liquidacoes');
    showToast(ids.length+' liquidação(ões) excluída(s).');
    navigate('reliquidados');
  }catch(e){
    alert('Erro: '+(e.code||e.message));
  }
}


function limparFiltrosLiq(){
  ['liq-fori','liq-fadv','liq-fliq'].forEach(function(id){var el=document.getElementById(id);if(el)el.value='todos';});
  ['liq-fdi','liq-fdf','liq-fbusca'].forEach(function(id){var el=document.getElementById(id);if(el)el.value='';});
  var ag=document.getElementById('liq-fagrup');if(ag)ag.checked=false;
  navigate('reliquidados');
}

function importRelLiq(input){if(!input.files.length)return;readXlsx(input.files[0],function(rows){var data=[];rows.forEach(function(r){var adv=normAdv(r['ADVOGADO']||r['Advogado']||'');var val=parseFloat(r['VALOR']||r['Valor']||0)||0;var liq=String(r['LIQUIDAÇÃO']||r['Liquidação']||r['LIQUIDACAO']||'').trim();var proc=String(r['PROCESSOS']||r['Processo']||'').trim();var datRaw=r['DATA']||r['Data']||'';var dat='';if(datRaw){try{var d=new Date(datRaw);if(!isNaN(d))dat=d.toISOString().slice(0,10);}catch(e){}}if(!adv||adv==='ADVOGADO')return;data.push({adv:adv,advNome:adv.charAt(0)+adv.slice(1).toLowerCase(),proc:proc,val:val,tipo:liq.toUpperCase().includes('PARCIAL')?'Parcial':'Total',data:dat});});relLiqImportData=data;var el=document.getElementById('rel-liq-status');if(el)el.textContent=data.length+' processos';showToast(data.length+' processos importados!');input.value='';});}
function renderRelLiq(){
  var tipo=document.getElementById('liq-tipo').value;
  var advFiltId=document.getElementById('liq-adv').value;
  var dtIni=document.getElementById('liq-di').value;
  var dtFim=document.getElementById('liq-df').value;
  var usandoImport=relLiqImportData&&relLiqImportData.length>0&&(tipo==='todos'||tipo==='Total'||tipo==='Parcial');
  var html='';
  if(usandoImport){
    var fi=relLiqImportData.filter(function(r){if(tipo!=='todos'&&r.tipo!==tipo)return false;if(advFiltId!=='todos'){var l=S.lawyers.find(function(x){return x.id===advFiltId;});if(l){var fn=normAdv(l.name).split(' ')[0];if(!r.adv.startsWith(fn))return false;}}if(dtIni&&r.data&&r.data<dtIni)return false;if(dtFim&&r.data&&r.data>dtFim)return false;return true;});
    if(fi.length){var tv=fi.reduce(function(s,r){return s+r.val;},0),tt=fi.filter(function(r){return r.tipo==='Total';}).reduce(function(s,r){return s+r.val;},0),tp=fi.filter(function(r){return r.tipo==='Parcial';}).reduce(function(s,r){return s+r.val;},0),qt=fi.filter(function(r){return r.tipo==='Total';}).length,qp=fi.filter(function(r){return r.tipo==='Parcial';}).length;
    var byA={};fi.forEach(function(r){if(!byA[r.adv])byA[r.adv]={nome:r.advNome,tot:0,par:0,qt:0,qp:0};if(r.tipo==='Total'){byA[r.adv].tot+=r.val;byA[r.adv].qt++;}else{byA[r.adv].par+=r.val;byA[r.adv].qp++;}});
    var ar=Object.keys(byA).sort().map(function(k){var a=byA[k];var t=a.tot+a.par;var pct=(tv?t/tv*100:0).toFixed(1);return'<tr><td>'+a.nome+'</td><td class="r">'+a.qt+'</td><td class="r">'+fmt(a.tot)+'</td><td class="r">'+a.qp+'</td><td class="r">'+fmt(a.par)+'</td><td class="r"><strong>'+fmt(t)+'</strong></td><td class="r">'+pct+'%</td></tr>';}).join('');
    var pr=fi.map(function(r){var sb=r.tipo==='Total'?'<span class="badge b-tot">Total</span>':'<span class="badge b-par">Parcial</span>';return'<tr><td>'+r.advNome+'</td><td style="font-size:10px">'+r.proc+'</td><td>'+sb+'</td><td class="r">'+fmt(r.val)+'</td><td>'+fmtDate(r.data)+'</td></tr>';}).join('');
    html+='<div class="metrics" style="margin-bottom:16px"><div class="mc"><div class="ml">Total processos</div><div class="mv">'+fi.length+'</div></div><div class="mc gold"><div class="ml">Total liquidado</div><div class="mv gold">'+fmt(tv)+'</div></div><div class="mc"><div class="ml">Liq. Total ('+qt+')</div><div class="mv">'+fmt(tt)+'</div></div><div class="mc blue"><div class="ml">Liq. Parcial ('+qp+')</div><div class="mv blue">'+fmt(tp)+'</div></div></div>'+
    '<div class="st">Resumo por advogado</div><div class="card" style="padding:0;overflow-x:auto;margin-bottom:16px"><table class="tbl"><thead><tr><th>Advogado</th><th class="r">Qt Total</th><th class="r">Vl Total</th><th class="r">Qt Parcial</th><th class="r">Vl Parcial</th><th class="r">Total</th><th class="r">%</th></tr></thead><tbody>'+ar+'</tbody><tfoot><tr class="foot"><td>TOTAL</td><td class="r">'+qt+'</td><td class="r">'+fmt(tt)+'</td><td class="r">'+qp+'</td><td class="r">'+fmt(tp)+'</td><td class="r">'+fmt(tv)+'</td><td class="r">100%</td></tr></tfoot></table></div>'+
    '<div class="st">Detalhe por processo</div><div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr><th>Advogado</th><th>N° Processo</th><th>Tipo</th><th class="r">Valor</th><th>Data</th></tr></thead><tbody>'+pr+'</tbody><tfoot><tr class="foot"><td colspan="3">TOTAL</td><td class="r">'+fmt(tv)+'</td><td></td></tr></tfoot></table></div>';}
    else{html+='<div class="empty">Nenhum registro com os filtros aplicados.</div>';}
  }
  if(!usandoImport||(tipo==='liquidado_total'||tipo==='liquidado_parcial')){
    var tcf=tipo==='liquidado_total'?'liquidado_total':tipo==='liquidado_parcial'?'liquidado_parcial':'';
    var fc=S.processos.filter(function(p){if(p.status==='pendente')return false;if(tcf&&p.status!==tcf)return false;if(advFiltId!=='todos'&&p.advogadoId!==advFiltId)return false;var recs=recebOf(p);if(dtIni||dtFim){var ok=recs.some(function(r){if(!r.data)return false;if(dtIni&&r.data<dtIni)return false;if(dtFim&&r.data>dtFim)return false;return true;});if(!ok)return false;}return true;});
    if(fc.length){var tCo=fc.reduce(function(s,p){return s+(p.valorCompra||0);},0),tRe=fc.reduce(function(s,p){return s+(recebOf(p).reduce(function(sr,r){return sr+(r.valor||0);},0));},0),tFa=tRe-tCo,tCn=fc.reduce(function(s,p){return s+(p.valorCondenacao||0);},0);
    var cr=fc.map(function(p){var an=(S.lawyers.find(function(l){return l.id===p.advogadoId;})||{name:p.advogadoId||'—'}).name;var rp=recebOf(p).reduce(function(s,r){return s+(r.valor||0);},0);var fa=rp-(p.valorCompra||0);var de=p.valorCondenacao?(((p.valorCondenacao-p.valorCompra)/p.valorCondenacao)*100).toFixed(2):0;var lr=recebOf(p).slice(-1)[0];var sb=p.status==='liquidado_total'?'<span class="badge b-tot">Total</span>':'<span class="badge b-par">Parcial</span>';return'<tr><td>'+esc(p.cliente)+'</td><td style="font-size:10px">'+esc(p.numero)+'</td><td>'+an+'</td><td>'+sb+'</td><td class="r">'+fmt(p.valorCondenacao)+'</td><td class="r">'+fmt(p.valorCompra)+'</td><td class="r">'+fmt(rp)+'</td><td class="r" style="color:'+(fa>=0?'#1D6B3A':'#A32D2D')+'">'+fmt(fa)+'</td><td class="r">'+de+'%</td><td>'+(lr?fmtDate(lr.data):'—')+'</td><td>'+(lr?lr.banco:'—')+'</td></tr>';}).join('');
    html+=(usandoImport?'<div class="st" style="margin-top:24px">Processos do cadastro</div>':'')+
    '<div class="metrics" style="margin-bottom:16px;margin-top:8px"><div class="mc"><div class="ml">Processos</div><div class="mv">'+fc.length+'</div></div><div class="mc gold"><div class="ml">Total Recebido</div><div class="mv gold">'+fmt(tRe)+'</div></div><div class="mc"><div class="ml">Valor de Compra</div><div class="mv">'+fmt(tCo)+'</div></div><div class="mc blue"><div class="ml">Faturamento</div><div class="mv blue">'+fmt(tFa)+'</div></div></div>'+
    '<div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr><th>Cliente</th><th>N° Processo</th><th>Advogado</th><th>Tipo</th><th class="r">Valor Atualizado</th><th class="r">Valor de Compra</th><th class="r">Vl. Liquidado</th><th class="r">Faturamento</th><th class="r">Deságio %</th><th>Último Rec.</th><th>Banco</th></tr></thead><tbody>'+cr+'</tbody><tfoot><tr class="foot"><td colspan="4">TOTAL</td><td class="r">'+fmt(tCn)+'</td><td class="r">'+fmt(tCo)+'</td><td class="r">'+fmt(tRe)+'</td><td class="r">'+fmt(tFa)+'</td><td></td><td></td><td></td></tr></tfoot></table></div>';}
    else if(!usandoImport){html='<div class="empty">Nenhum processo encontrado com os filtros aplicados.</div>';}
  }
  if(!html)html='<div class="empty">Nenhum dado encontrado.</div>';
  document.getElementById('rel-liq-content').innerHTML=html;
}
function imprimirRelLiq(){renderRelLiq();setTimeout(function(){window.print();},300);}

// ════════════════════════════════════════════════════════════
// PREVISÃO DE ENTRADAS
// ════════════════════════════════════════════════════════════
function pagePrevisaoEntradas(){
  return'<div class="page-title">'+I.previsao+' Previsão de Entradas <button class="print-btn no-print" onclick="imprimirPrev()">Imprimir / PDF</button></div>'+
  '<div class="filter-bar no-print">'+
    '<div class="fg"><label>Advogado</label><select id="prev-adv"><option value="todos">Todos</option>'+S.lawyers.map(function(l){return'<option value="'+l.id+'">'+l.name+'</option>';}).join('')+'</select></div>'+
    '<div class="fg"><label>Matéria</label><input type="text" id="prev-mat" placeholder="Ex: RPV, Precatório..."/></div>'+
    '<input class="search-input" id="prev-q" placeholder="Buscar cliente ou processo..."/>'+
    '<button class="btn bp" onclick="renderPrev()">Filtrar</button>'+
  '</div>'+
  '<div id="prev-content"><div class="empty">Clique em Filtrar para gerar a previsão.</div></div>';
}
function renderPrev(){
  var adv=document.getElementById('prev-adv').value;
  var mat=(document.getElementById('prev-mat').value||'').toLowerCase();
  var q=(document.getElementById('prev-q').value||'').toLowerCase();
  var f=S.processos.filter(function(p){return p.status==='pendente'&&(adv==='todos'||p.advogadoId===adv)&&(!mat||!(p.materia||'').toLowerCase().includes(mat)?false:true)&&(!q||(p.cliente||'').toLowerCase().includes(q)||(p.numero||'').toLowerCase().includes(q));});
  // fix mat filter
  f=S.processos.filter(function(p){
    if(p.status==='liquidado_total')return false;
    if(adv!=='todos'&&p.advogadoId!==adv)return false;
    if(mat&&!(p.materia||'').toLowerCase().includes(mat))return false;
    if(q&&!(p.cliente||'').toLowerCase().includes(q)&&!(p.numero||'').toLowerCase().includes(q))return false;
    return true;
  });
  var tP=f.reduce(function(s,p){return s+previsaoDe(p);},0);
  var tC=f.reduce(function(s,p){return s+(p.valorCompra||0);},0);
  var tCn=f.reduce(function(s,p){return s+(p.valorCondenacao||0);},0);
  var tF=tP-tC;
  var rows=f.map(function(p){
    var an=(S.lawyers.find(function(l){return l.id===p.advogadoId;})||{name:p.advogadoId||'—'}).name;
    var pg=(p.valorCliente||0)-(p.valorCompra||0);
    var de=p.valorCondenacao?(((p.valorCondenacao-p.valorCompra)/p.valorCondenacao)*100).toFixed(2):0;
    var di=p.dataCompra?Math.floor((new Date()-new Date(p.dataCompra))/(864e5)):0;
    return'<tr><td>'+esc(p.cliente)+'</td><td style="font-size:10px">'+esc(p.numero)+(p.status==='liquidado_parcial'?' <span style="background:#fff3cd;color:#856404;padding:0 4px;border-radius:3px;font-size:9px;font-weight:700">PARCIAL</span>':'')+'</td><td>'+an+'</td><td>'+esc(p.materia||'')+'</td><td>'+fmtDate(p.dataCompra)+'</td><td class="r">'+di+'</td><td class="r">'+fmt(p.valorCondenacao)+'</td><td class="r" style="font-weight:700">'+fmt(previsaoDe(p))+'</td><td class="r">'+fmt(p.valorCompra)+'</td><td class="r" style="color:#1D6B3A">'+fmt(pg)+'</td><td class="r">'+de+'%</td></tr>';
  }).join('');
  var html=f.length?
    '<div class="metrics" style="margin-bottom:16px"><div class="mc blue"><div class="ml">Processos em aberto</div><div class="mv blue">'+f.length+'</div></div><div class="mc"><div class="ml">Valor Atualizado</div><div class="mv">'+fmt(tCn)+'</div></div><div class="mc gold"><div class="ml">Previsão de Entrada</div><div class="mv gold">'+fmt(tP)+'</div></div><div class="mc"><div class="ml">Prev. Faturamento</div><div class="mv">'+fmt(tF)+'</div></div></div>'+
    '<div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr><th>Cliente</th><th>N° Processo</th><th>Advogado</th><th>Matéria</th><th>Data Compra</th><th class="r">Dias</th><th class="r">Valor Atualizado</th><th class="r">Prev. a Receber</th><th class="r">Valor de Compra</th><th class="r">Prev. Ganho</th><th class="r">Deságio %</th></tr></thead><tbody>'+rows+'</tbody><tfoot><tr class="foot"><td colspan="6">TOTAL</td><td class="r">'+fmt(tCn)+'</td><td class="r">'+fmt(tP)+'</td><td class="r">'+fmt(tC)+'</td><td class="r">'+fmt(tF)+'</td><td></td></tr></tfoot></table></div>':
    '<div class="empty">Nenhum processo em aberto encontrado.</div>';
  document.getElementById('prev-content').innerHTML=html;
}
function imprimirPrev(){renderPrev();setTimeout(function(){window.print();},300);}

// ════════════════════════════════════════════════════════════
// MINHA COMISSÃO
// ════════════════════════════════════════════════════════════
function pageMinhaComissao(){
  if(!currentUser||!currentUser.lawyerId)return'<div class="empty">Sem dados.</div>';
  var lid=currentUser.lawyerId;
  var l=S.lawyers.find(function(x){return x.id===lid;});
  if(!l)return'<div class="card"><div class="empty">Perfil não configurado pelo administrador ainda.</div></div>';
  var c=calc(lid);var e=c.entry;

  // Se há S.liqManual, ignora 100% do legado (modo novo)
  var temLiqManual=(S.liqManual||[]).some(function(m){return m.advogadoId===lid;});
  var legadoFiltrado=temLiqManual ? [] : (e.processos||[]);

  // Processos legado (do import — se houver) — só os que não estão em S.liqManual
  var procRowsLegado=legadoFiltrado.map(function(p){
    var isPar=p.tipo==='Parcial';
    var com=isPar?0:(p.valor<10000?50:100);
    var bd=isPar?'<span style="background:#fff3cd;color:#856404;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700">PARCIAL</span>':'<span style="background:#d4edda;color:#155724;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700">TOTAL</span>';
    return '<tr><td style="padding:4px 8px;font-size:11px;color:var(--mt)">'+
      (p.ref||'---')+'</td><td style="padding:4px 8px">—</td><td style="padding:4px 8px">'+bd+'</td><td style="padding:4px 8px;font-size:11px;text-align:right">'+fmt(p.valor)+'</td>'+
      '<td style="padding:4px 8px;font-size:11px;text-align:right;color:'+(isPar?'var(--mt)':'var(--v)')+';font-weight:600">'+(isPar?'—':'R$ '+com)+'</td></tr>';
  }).join('');

  // Lançamentos manuais agrupados por processo+titularidade
  var grpManual={};
  (S.liqManual||[]).forEach(function(m){
    if(m.advogadoId!==lid)return;
    if(!inPeriodo(m.data))return; // segue o período selecionado (igual ao motor calc)
    var key=(m.processo||'(sem nº)')+'|'+(m.titularidade||'');
    if(!grpManual[key])grpManual[key]={proc:m.processo||'(sem nº)',titularidade:m.titularidade,total:0,qtd:0,temTotal:false,ultData:''};
    grpManual[key].total+=(m.valor||0);
    grpManual[key].qtd++;
    if(m.liquidacao==='Total')grpManual[key].temTotal=true;
    if((m.data||'')>grpManual[key].ultData)grpManual[key].ultData=(m.data||'');
  });
  var procRowsManual=Object.keys(grpManual).map(function(k){
    var g=grpManual[k];
    var com=g.temTotal?(g.total<10000?50:100):0;
    var bdSt=g.temTotal?'<span style="background:#d4edda;color:#155724;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700">100% LIQUIDADO</span>':'<span style="background:#fff3cd;color:#856404;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700">EM ANDAMENTO ('+g.qtd+' parc.)</span>';
    var corCart=g.titularidade==='FIDC PBL'?'#185FA5':g.titularidade==='PBL Originadora'?'#B8860B':'#1D6B3A';
    var bdCart='<span style="background:'+corCart+';color:#fff;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700">'+esc(g.titularidade||'')+'</span>';
    return '<tr><td style="padding:4px 8px;font-size:11px;color:var(--mt)">'+esc(g.proc)+'</td><td style="padding:4px 8px">'+bdCart+'</td><td style="padding:4px 8px">'+bdSt+'</td><td style="padding:4px 8px;font-size:11px;text-align:right">'+fmt(g.total)+'</td>'+
      '<td style="padding:4px 8px;font-size:11px;text-align:right;color:'+(g.temTotal?'var(--v)':'var(--mt)')+';font-weight:600">'+(g.temTotal?'R$ '+com:'—')+'</td></tr>';
  }).join('');

  var totalLinhas=legadoFiltrado.length+Object.keys(grpManual).length;
  var procDetail=totalLinhas>0?
    '<div style="margin:4px 0 8px;border:1px solid var(--bd);border-radius:6px;overflow:hidden">'+
    '<table style="width:100%;border-collapse:collapse">'+
    '<thead><tr style="background:var(--vl)">'+
    '<th style="padding:5px 8px;font-size:10px;text-align:left;color:var(--v)">Processo</th>'+
    '<th style="padding:5px 8px;font-size:10px;text-align:left;color:var(--v)">Origem</th>'+
    '<th style="padding:5px 8px;font-size:10px;text-align:left;color:var(--v)">Status</th>'+
    '<th style="padding:5px 8px;font-size:10px;text-align:right;color:var(--v)">Valor</th>'+
    '<th style="padding:5px 8px;font-size:10px;text-align:right;color:var(--v)">Comissão</th></tr></thead>'+
    '<tbody>'+procRowsLegado+procRowsManual+'</tbody></table>'+
    '<div style="padding:6px 8px;font-size:10px;color:var(--mt);background:var(--row-alt);border-top:1px solid var(--bd)">⚠️ A comissão por processo só é liberada quando o processo está <strong>100% liquidado</strong> (todas as parcelas recebidas). Lançamentos parciais somam apenas para o prêmio por volume.</div>'+
    '</div>':'';

  var totalLiq=c.volLiqTotalParcial||0;
  var labelLiq='Prêmio liquidação (Total+Parcial: '+fmt(totalLiq)+') — '+
    (totalLiq>=500000?'a partir de R$500k, +R$100 a cada R$100k':'meta R$500k para iniciar prêmio');
  var qtdProcTotal=(e.processos||[]).length+Object.keys(grpManual).length;
  var items=[
    {l:'Pró-labore fixo',v:c.prolaboreTotal},
    {l:'Processos 100% liquidados ('+c.qtdProcTot+' de '+qtdProcTotal+') — R$50 abaixo de R$10k / R$100 acima',v:c.cP},
    {l:'Processos validados ('+c.qtdProcVal+')',v:c.cPV},
    {l:'Contratos validados ('+c.qtdContVal+')',v:c.cCV},
    {l:'Capa a capa ('+c.qtdCapa+')',v:c.cCapa},
    {l:'Auditoria ('+c.qtdAud+')',v:c.cAud},
    {l:'Bônus entradas',v:c.cEnt},
    {l:labelLiq,v:c.cLiq},
    {l:'Campanhas',v:c.cCamp}
  ];
  var m='<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px"><div class="mc"><div class="ml">Total a receber</div><div class="mv">'+fmt(c.total)+'</div></div><div class="mc"><div class="ml">Pró-labore</div><div class="mv">'+fmt(c.prolaboreTotal)+'</div></div><div class="mc gold"><div class="ml">Comissões</div><div class="mv gold">'+fmt(c.total-c.prolaboreTotal)+'</div></div></div>';
  var rows=items.map(function(it,idx){return'<div style="display:flex;flex-direction:column;padding:8px 0;border-bottom:.5px solid var(--bd);font-size:13px"><div style="display:flex;justify-content:space-between"><div style="color:var(--mt)">'+it.l+'</div><div>'+fmt(it.v)+'</div></div>'+(idx===1?procDetail:'')+'</div>';}).join('');
  var per=document.getElementById('period-lbl')?document.getElementById('period-lbl').textContent:'';
  return'<div class="page-title">'+I.comissao+' Olá, '+esc(c.lawyer.name)+'</div>'+
    '<div style="font-size:12px;color:var(--mt);margin-bottom:16px">Período: '+per+'</div>'+m+
    '<div class="card">'+rows+'<div style="display:flex;justify-content:space-between;padding:11px 0 0;font-size:15px;font-weight:700"><div>Total a pagar</div><div style="color:var(--v)">'+fmt(c.total)+'</div></div></div>';
}

// ════════════════════════════════════════════════════════════
// USUÁRIOS
// ════════════════════════════════════════════════════════════
function pageUsuarios(){
  if(!isFullAccess(currentUser)){
    return '<div class="page-title">'+I.usuarios+' Usuários</div><div class="card">Acesso restrito.</div>';
  }
  // Três grupos separados — ativos, pré-cadastros e inativos. Antes ativos e inativos dividiam a
  // mesma tabela, distinguidos só por um selo vermelho no meio da coluna de função: em uma lista
  // de 20+ linhas ninguém enxergava quem estava desligado.
  var porNome=function(a,b){ return String(a.name||'').localeCompare(String(b.name||'')); };
  var ativos=(S.users||[]).filter(function(u){ return u.active!==false; }).sort(porNome);
  var inativos=(S.users||[]).filter(function(u){ return u.active===false; }).sort(porNome);
  var pendentes=(S.pendingUsers||[]).slice().sort(porNome);

  var vazio=function(cols,txt){ return '<tr><td colspan="'+cols+'" style="color:var(--mt);text-align:center;padding:14px">'+txt+'</td></tr>'; };
  var advDe=function(u){ return (u.role==='lawyer'? esc(lawyerName(u.lawyerId)) : '—'); };

  var linhasAtivos=ativos.map(function(u){
    var acao=(u.id===currentUser.id)
      ? '<span style="font-size:11px;color:var(--mt)">(você)</span>'
      : '<button class="btn bsm bd2" onclick="userDeactivate(\''+u.id+'\')">Desativar</button>';
    return '<tr><td>'+esc(u.name||'')+'</td><td>'+esc(u.email||'')+'</td><td>'+roleLabel(u.role)+'</td><td>'+advDe(u)+'</td>'+
      '<td><button class="btn bsm" onclick="userEdit(\''+u.id+'\')">Editar</button> '+acao+'</td></tr>';
  }).join('') || vazio(5,'Nenhum usuário ativo.');

  var linhasPendentes=pendentes.map(function(p){
    return '<tr><td>'+esc(p.name||'')+'</td><td>'+esc(p.email||'')+'</td><td>'+roleLabel(p.role)+'</td>'+
      '<td><button class="btn bsm bd2" onclick="userCancelInvite(\''+p.id+'\')">Cancelar convite</button></td></tr>';
  }).join('') || vazio(4,'Nenhum pré-cadastro pendente.');

  // Inativos ficam esmaecidos: continuam consultáveis (histórico), mas não competem pela atenção.
  var linhasInativos=inativos.map(function(u){
    return '<tr style="opacity:.6"><td>'+esc(u.name||'')+'</td><td>'+esc(u.email||'')+'</td><td>'+roleLabel(u.role)+'</td><td>'+advDe(u)+'</td>'+
      '<td><button class="btn bsm" onclick="userReactivate(\''+u.id+'\')">Reativar</button></td></tr>';
  }).join('') || vazio(5,'Nenhum usuário inativo.');

  var cabec=function(cor,titulo,qtd,sub,extra){
    return '<div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px">'+
      '<div style="display:flex;align-items:center;gap:8px">'+
        '<span style="width:9px;height:9px;border-radius:50%;background:'+cor+';display:inline-block"></span>'+
        '<strong>'+titulo+'</strong>'+
        '<span class="badge" style="background:var(--row-alt);color:var(--mt)">'+qtd+'</span>'+
        (sub?'<span style="color:var(--mt);font-size:12px">'+sub+'</span>':'')+
      '</div>'+(extra||'')+
    '</div>';
  };

  return '<div class="page-title">'+I.usuarios+' Usuários</div>'+
    '<div class="card" style="margin-bottom:12px">'+
      cabec('var(--green)','Ativos',ativos.length,'','<button class="btn bp" onclick="userOpenInvite()">+ Adicionar Usuário</button>')+
      '<table class="tbl"><thead><tr><th>Nome</th><th>Email</th><th>Função</th><th>Advogado</th><th>Ações</th></tr></thead><tbody>'+linhasAtivos+'</tbody></table>'+
    '</div>'+
    '<div class="card" style="margin-bottom:12px">'+
      cabec('var(--d)','Pré-cadastros pendentes',pendentes.length,'ativam no primeiro login da pessoa','')+
      '<table class="tbl"><thead><tr><th>Nome</th><th>Email</th><th>Função</th><th>Ações</th></tr></thead><tbody>'+linhasPendentes+'</tbody></table>'+
    '</div>'+
    '<div class="card">'+
      cabec('var(--red)','Inativos',inativos.length,'sem acesso ao sistema; o histórico é preservado','')+
      '<table class="tbl"><thead><tr><th>Nome</th><th>Email</th><th>Função</th><th>Advogado</th><th>Ações</th></tr></thead><tbody>'+linhasInativos+'</tbody></table>'+
    '</div>';
}

function userShowErr(id, msg){
  var el = document.getElementById(id);
  if(el){ el.textContent = msg; el.style.display = 'block'; }
}

function userOpenInvite(){
  var roleOpts = '<option value="">— Selecione —</option>' + ROLE_OPTIONS.map(function(r){return '<option value="'+r.value+'">'+r.label+'</option>';}).join('');
  showModal('<button class="modal-close" onclick="closeModal()">×</button>'+
    '<div class="modal-title">Adicionar Usuário</div>'+
    '<div class="fg" style="margin-bottom:10px"><label>Email *</label><input type="email" id="iu-email" placeholder="nome.sobrenome@pblcompra.com"/></div>'+
    '<div class="fg" style="margin-bottom:10px"><label>Nome *</label><input type="text" id="iu-name" placeholder="Nome completo"/></div>'+
    '<div class="fg" style="margin-bottom:10px"><label>Função *</label><select id="iu-role" onchange="userToggleLawyerField()">'+roleOpts+'</select></div>'+
    '<div class="fg" id="iu-prolabore-wrap" style="margin-bottom:10px;display:none"><label>Pró-labore (R$)</label>'+
      '<input type="number" id="iu-prolabore" min="0" step="100" value="0" placeholder="0"/>'+
      '<div style="font-size:11px;color:var(--mt)">Pode ser ajustado depois em Operacional / Prod.</div></div>'+
    '<div class="fg" id="iu-secrole-wrap" style="margin-bottom:10px;display:none"><label>Funções secundárias (opcional — pode marcar mais de uma)</label>'+
      '<div id="iu-secroles"></div></div>'+
    '<div class="fg" id="iu-prolabore-sec-wrap" style="margin-bottom:10px;display:none"><label>Pró-labore como gestora (R$)</label>'+
      '<input type="number" id="iu-prolabore-sec" min="0" step="100" value="0" placeholder="0"/></div>'+
    '<div id="iu-err" class="login-err" style="display:none;margin-bottom:10px"></div>'+
    '<div style="display:flex;justify-content:flex-end;gap:10px"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="userSubmitInvite()">Convidar</button></div>'
  );
}

// Checkboxes de funções secundárias válidas para o role (multi-seleção).
function secRoleChecks(role, sel, prefix){
  sel = sel||[];
  var rs = SEC_ROLES_DEF.filter(function(d){return d.role===role;});
  if(!rs.length) return '<div style="font-size:12px;color:var(--mt)">— nenhuma disponível para esta função —</div>';
  var onchg = prefix==='iu' ? 'userToggleSecRoleField()' : 'eUserToggleSecRoleField()';
  return rs.map(function(d){
    var ck = sel.indexOf(d.key)>=0?' checked':'';
    return '<label style="display:flex;align-items:center;gap:7px;font-size:13px;margin-top:4px"><input type="checkbox" class="'+prefix+'-secrole" value="'+d.key+'"'+ck+' onchange="'+onchg+'"/> '+esc(d.label)+'</label>';
  }).join('');
}
function readSecRoles(prefix){
  return Array.prototype.slice.call(document.querySelectorAll('.'+prefix+'-secrole:checked')).map(function(c){return c.value;});
}
function userToggleLawyerField(){
  var role = document.getElementById('iu-role').value;
  var pwrap = document.getElementById('iu-prolabore-wrap');
  if(pwrap) pwrap.style.display = (role==='lawyer' || role==='supervisora' || role==='gestora') ? '' : 'none';
  var swrap = document.getElementById('iu-secrole-wrap');
  var box = document.getElementById('iu-secroles');
  var temSec = (role==='admin' || role==='lawyer');
  if(swrap) swrap.style.display = temSec ? '' : 'none';
  if(box) box.innerHTML = secRoleChecks(role, [], 'iu');
  userToggleSecRoleField();
}

function userToggleSecRoleField(){
  var temGestora = readSecRoles('iu').indexOf('gestora')>=0;
  var spwrap = document.getElementById('iu-prolabore-sec-wrap');
  if(spwrap) spwrap.style.display = temGestora ? '' : 'none';
}

async function userSubmitInvite(){
  var email = (document.getElementById('iu-email').value||'').trim().toLowerCase();
  var name = (document.getElementById('iu-name').value||'').trim();
  var role = document.getElementById('iu-role').value;
  var prolaboreInput = document.getElementById('iu-prolabore');
  var prolabore = prolaboreInput ? (parseFloat(prolaboreInput.value)||0) : 0;
  var secondaryRoles = (role === 'admin' || role === 'lawyer') ? readSecRoles('iu') : [];
  var prolaboreSecInput = document.getElementById('iu-prolabore-sec');
  var prolaboreSecundario = (secondaryRoles.indexOf('gestora')>=0 && prolaboreSecInput) ? (parseFloat(prolaboreSecInput.value)||0) : 0;
  if(!email || !name || !role){ userShowErr('iu-err', 'Preencha email, nome e função.'); return; }
  if(prolabore < 0 || prolaboreSecundario < 0){ userShowErr('iu-err', 'Pró-labore não pode ser negativo.'); return; }
  try{
    await callFn('inviteUser', {email:email, name:name, role:role, prolabore:prolabore, secondaryRoles:secondaryRoles, prolaboreSecundario:prolaboreSecundario});
    closeModal();
    showToast('Convite criado! A pessoa entra no primeiro login.');
    S.pendingUsers = await fetchCollection('pendingUsers');
    navigate('usuarios');
  }catch(e){
    userShowErr('iu-err', 'Erro: ' + (e.message || e.code || 'falhou'));
  }
}


function userEdit(uid){
  var u = (S.users||[]).find(function(x){return x.id===uid;});
  if(!u){ showToast('Usuário não encontrado'); return; }
  var roleOpts = ROLE_OPTIONS.map(function(r){return '<option value="'+r.value+'"'+(u.role===r.value?' selected':'')+'>'+r.label+'</option>';}).join('');
  var perms = u.permissions || {};
  var canViewGN = !!perms.canViewGeracaoNegocios;
  var gnScope = perms.geracaoNegociosScope || 'all';
  var linkedLawyer = u.lawyerId ? (S.lawyers||[]).find(function(l){return l.id===u.lawyerId;}) : null;
  var linkedLawyerName = linkedLawyer ? linkedLawyer.name : '';
  var linkedLawyerProlabore = linkedLawyer ? (linkedLawyer.prolabore||0) : 0;
  var linkedGestora = u.gestoraId ? (S.gestoras||[]).find(function(g){return g.id===u.gestoraId;}) : null;
  var linkedGestoraName = linkedGestora ? linkedGestora.name : '';
  var linkedGestoraProlabore = linkedGestora ? (linkedGestora.prolabore||0) : 0;
  var secArr = secRolesOf(u);
  showModal('<button class="modal-close" onclick="closeModal()">×</button>'+
    '<div class="modal-title">Editar usuário — '+esc(u.name)+'</div>'+
    '<div class="fg" style="margin-bottom:10px"><label>Email</label><input type="email" value="'+esc(u.email||'')+'" disabled style="background:var(--row-alt)"/></div>'+
    '<div class="fg" style="margin-bottom:10px"><label>Função</label><select id="eu-role" onchange="eUserToggleLawyerField()">'+roleOpts+'</select></div>'+
    (u.lawyerId ? '<div class="fg" style="margin-bottom:10px"><label>'+(u.role==='supervisora'?'Supervisora vinculada':'Advogado vinculado')+'</label><input type="text" value="'+esc(linkedLawyerName)+'" disabled style="background:var(--row-alt)"/></div>'+
      '<div class="fg" style="margin-bottom:10px"><label>Pró-labore ('+(u.role==='supervisora'?'supervisora':'advogado')+', R$)</label><input type="number" id="eu-prolabore-law" min="0" step="100" value="'+linkedLawyerProlabore+'"/></div>'
      : '')+
    '<div class="fg" id="eu-secrole-wrap" style="margin-bottom:10px;display:'+((u.role==='admin'||u.role==='lawyer')?'':'none')+'"><label>Funções secundárias (opcional — pode marcar mais de uma)</label>'+
      '<div id="eu-secroles">'+secRoleChecks(u.role, secArr, 'eu')+'</div></div>'+
    '<div class="fg" id="eu-prolabore-ges-wrap" style="margin-bottom:10px;display:'+((u.role==='gestora' || secArr.indexOf("gestora")>=0)?'':'none')+'"><label>Pró-labore (gestora, R$)</label>'+
      '<input type="number" id="eu-prolabore-ges" min="0" step="100" value="'+linkedGestoraProlabore+'"/></div>'+
    '<div class="div"></div>'+
    '<div style="margin-bottom:6px;font-weight:700;color:var(--mt);font-size:12px">Permissões avançadas</div>'+
    '<div class="fg" style="margin-bottom:8px"><label style="display:flex;align-items:center;gap:6px"><input type="checkbox" id="eu-gn"'+(canViewGN?' checked':'')+' onchange="eUserToggleGNScope()"/> Pode ver Geração de Negócios</label></div>'+
    '<div class="fg" id="eu-gn-scope-wrap" style="margin-bottom:10px;display:'+(canViewGN?'':'none')+'"><label>Escopo</label><select id="eu-gn-scope"><option value="all"'+(gnScope==='all'?' selected':'')+'>Todos os cards</option><option value="own"'+(gnScope==='own'?' selected':'')+'>Apenas o próprio</option></select></div>'+
    '<div id="eu-err" class="login-err" style="display:none;margin-bottom:10px"></div>'+
    '<div style="display:flex;justify-content:flex-end;gap:10px"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="userSubmitEdit(\''+uid+'\')">Salvar</button></div>'
  );
}

function eUserToggleLawyerField(){
  var role = document.getElementById('eu-role').value;
  var prev = readSecRoles('eu'); // preserva marcações ainda válidas para o novo role
  var box = document.getElementById('eu-secroles');
  if(box) box.innerHTML = secRoleChecks(role, prev, 'eu');
  var swrap = document.getElementById('eu-secrole-wrap');
  if(swrap) swrap.style.display = (role==='admin' || role==='lawyer') ? '' : 'none';
  eUserToggleSecRoleField(role);
}
function eUserToggleSecRoleField(role){
  role = role || (document.getElementById('eu-role')||{}).value;
  var temGestora = readSecRoles('eu').indexOf('gestora')>=0;
  var pgwrap = document.getElementById('eu-prolabore-ges-wrap');
  if(pgwrap) pgwrap.style.display = (role==='gestora' || temGestora) ? '' : 'none';
}

function eUserToggleGNScope(){
  var ck = document.getElementById('eu-gn').checked;
  var wrap = document.getElementById('eu-gn-scope-wrap');
  if(wrap) wrap.style.display = ck ? '' : 'none';
}

async function userSubmitEdit(uid){
  var u = (S.users||[]).find(function(x){return x.id===uid;});
  if(!u){ userShowErr('eu-err', 'Usuário não encontrado.'); return; }
  var role = document.getElementById('eu-role').value;
  var secondaryRoles = (role === 'admin' || role === 'lawyer') ? readSecRoles('eu') : [];
  var canGN = document.getElementById('eu-gn').checked;
  var gnScope = document.getElementById('eu-gn-scope').value;
  var permissions = {};
  if(canGN){ permissions.canViewGeracaoNegocios = true; permissions.geracaoNegociosScope = gnScope; }
  var lawEl = document.getElementById('eu-prolabore-law');
  var gesEl = document.getElementById('eu-prolabore-ges');
  var newLawProlabore = lawEl ? (parseFloat(lawEl.value)||0) : null;
  var newGesProlabore = gesEl ? (parseFloat(gesEl.value)||0) : null;
  if((newLawProlabore !== null && newLawProlabore < 0) || (newGesProlabore !== null && newGesProlabore < 0)){
    userShowErr('eu-err', 'Pró-labore não pode ser negativo.'); return;
  }
  try{
    // setUserRole pode criar /gestoras ou /lawyers conforme a nova role — retorna os IDs resultantes.
    var resp = await callFn('setUserRole', {uid:uid, role:role, secondaryRoles:secondaryRoles, permissions:permissions});
    var lawyerIdFinal = (resp && resp.data && resp.data.lawyerId) || u.lawyerId || null;
    var gestoraIdFinal = (resp && resp.data && resp.data.gestoraId) || u.gestoraId || null;
    if(lawyerIdFinal && newLawProlabore !== null){
      await fb.updateDoc(fb.doc(fb.db,'lawyers',lawyerIdFinal), {prolabore:newLawProlabore, updatedAt: fb.serverTimestamp(), updatedBy: currentUser.id});
    }
    if(gestoraIdFinal && newGesProlabore !== null){
      await fb.updateDoc(fb.doc(fb.db,'gestoras',gestoraIdFinal), {prolabore:newGesProlabore, updatedAt: fb.serverTimestamp(), updatedBy: currentUser.id});
    }
    closeModal();
    showToast('Usuário atualizado!');
    S.users = await fetchCollection('users');
    S.lawyers = await fetchCollection('lawyers');
    S.gestoras = await fetchCollection('gestoras');
    navigate('usuarios');
  }catch(e){
    userShowErr('eu-err', 'Erro: ' + (e.message || e.code));
  }
}

async function userDeactivate(uid){
  if(!confirm('Desativar este usuário?')) return;
  try{
    await callFn('deactivateUser', {uid:uid});
    showToast('Usuário desativado!');
    S.users = await fetchCollection('users');
    navigate('usuarios');
  }catch(e){
    showToast('Erro: ' + (e.message || e.code));
  }
}

async function userReactivate(uid){
  if(!confirm('Reativar este usuário?')) return;
  try{
    await callFn('reactivateUser', {uid:uid});
    showToast('Usuário reativado!');
    S.users = await fetchCollection('users');
    navigate('usuarios');
  }catch(e){
    showToast('Erro: ' + (e.message || e.code));
  }
}

async function userCancelInvite(pendingId){
  if(!confirm('Cancelar este convite pendente?\n\nO advogado vinculado (se houver) também será removido.')) return;
  try{
    await callFn('cancelInvite', {pendingId: pendingId});
    S.pendingUsers = await fetchCollection('pendingUsers');
    S.lawyers = await fetchCollection('lawyers');
    showToast('Convite cancelado.');
    navigate('usuarios');
  }catch(e){
    showToast('Erro: ' + (e.message || e.code));
  }
}

function auditUserLabel(r){
  // Resolve quem fez a operação. Prioridade: userId > authId.
  var uid = r.userId || r.authId || '';
  if(!uid) return '<span style="color:var(--mt);font-style:italic">—</span>';
  // Sistemas/scripts conhecidos
  var systemTags = {seed:'seed',import_seed:'seed contencioso','approve-script':'script approve',system:'sistema','hermes-api':'Hermes API'};
  if(systemTags[uid]) return '<span style="color:var(--mt);font-style:italic">'+systemTags[uid]+'</span>';
  // Procura em /users por id
  var u = (S.users||[]).find(function(x){return x.id===uid;});
  if(u){
    var name = esc(u.name||u.email||uid);
    var email = u.email ? ('<div style="font-size:10px;color:var(--mt)">'+esc(u.email)+'</div>') : '';
    return name + email;
  }
  // Fallback: mostra UID truncado
  return '<span style="font-size:10px;font-family:monospace;color:var(--mt)" title="'+esc(uid)+'">'+esc(uid.slice(0,12))+(uid.length>12?'…':'')+'</span>';
}

async function pageAuditLog(){
  if(!isAdmin(currentUser)){
    return '<div class="page-title">Logs de Auditoria</div><div class="card">Acesso restrito a admin.</div>';
  }
  try{
    var q = fb.query(fb.collection(fb.db,'auditLog'));
    var snap = await fb.getDocs(q);
    var rows = snap.docs.map(function(d){return Object.assign({id:d.id}, d.data());})
      .sort(function(a,b){
        var ta = a.timestamp ? (a.timestamp.seconds || 0) : 0;
        var tb = b.timestamp ? (b.timestamp.seconds || 0) : 0;
        return tb - ta;
      })
      .slice(0, 200);
    var tbody = rows.map(function(r){
      var when = r.timestamp ? new Date((r.timestamp.seconds||0)*1000).toLocaleString('pt-BR') : '—';
      var fields = (r.changedFields||[]).slice(0,5).join(', ');
      if((r.changedFields||[]).length>5) fields += ' (+'+((r.changedFields||[]).length-5)+')';
      var actBadge = r.action==='create'?'<span class="badge b-green">create</span>'
                   : r.action==='delete'?'<span class="badge b-red">delete</span>'
                   : r.action==='read'?'<span class="badge">consulta</span>'
                   : '<span class="badge b-par">update</span>';
      return '<tr><td style="font-size:11px">'+when+'</td><td style="font-size:11px">'+auditUserLabel(r)+'</td><td>'+esc(r.collection||'')+'</td><td style="font-size:11px;font-family:monospace">'+esc(r.docId||'')+'</td><td>'+actBadge+'</td><td style="font-size:11px">'+esc(fields)+'</td></tr>';
    }).join('') || '<tr><td colspan="6" style="color:var(--mt);text-align:center;padding:14px">Nenhum log ainda.</td></tr>';
    return '<div class="page-title">Logs de Auditoria <span style="font-size:12px;color:var(--mt);font-weight:400">— últimos 200 eventos</span></div>'+
      '<div class="card">'+
        '<table class="tbl"><thead><tr><th>Quando</th><th>Usuário</th><th>Collection</th><th>Doc ID</th><th>Ação</th><th>Campos alterados</th></tr></thead><tbody>'+tbody+'</tbody></table>'+
      '</div>';
  }catch(e){
    return '<div class="page-title">Logs de Auditoria</div><div class="card">Erro ao carregar: '+esc(e.message||e.code||'falhou')+'</div>';
  }
}

// ════════════════════════════════════════════════════════════
// NOTIFICAÇÕES (Plano 3 — contencioso)
// ════════════════════════════════════════════════════════════

function notifShowErr(elId, msg){
  var el = document.getElementById(elId);
  if(el){ el.textContent = msg; el.style.display = 'block'; }
}

var NOTIF_STATUS_LABEL = {
  awaiting_extraction: { lbl:'Extraindo...', cls:'b-par' },
  awaiting_review:     { lbl:'Aguardando Revisão', cls:'b-par' },
  sending:             { lbl:'Enviando...', cls:'b-par' },
  sent:                { lbl:'Enviada ✓', cls:'b-green' },
  failed:              { lbl:'Falhou', cls:'b-red' },
  rejected:            { lbl:'Rejeitada', cls:'b-red' },
};

function notifStatusBadge(status){
  var info = NOTIF_STATUS_LABEL[status] || { lbl: status||'?', cls:'b-par' };
  return '<span class="badge '+info.cls+'">'+info.lbl+'</span>';
}

function notifTipoLabel(t){
  return ({comum:'Comum', trabalhista:'Trabalhista', rpv:'RPV', precatorio:'Precatório'})[t] || t || '—';
}

function pageNotificacoes(){
  if(!currentUser){ return '<div class="card">Acesso restrito.</div>'; }

  var filtroStatus = window._notifFiltroStatus || 'todos';
  var filtroBusca = (window._notifFiltroBusca || '').toLowerCase();

  var lista = (S.notificacoes||[]).slice().sort(function(a,b){
    var ta = a.createdAt && a.createdAt.seconds ? a.createdAt.seconds : 0;
    var tb = b.createdAt && b.createdAt.seconds ? b.createdAt.seconds : 0;
    return tb - ta;
  });

  if(filtroStatus !== 'todos'){
    lista = lista.filter(function(n){ return n.status === filtroStatus; });
  }
  if(filtroBusca){
    lista = lista.filter(function(n){
      return (n.numero_processo||'').toLowerCase().indexOf(filtroBusca) >= 0;
    });
  }

  var counts = { todos: (S.notificacoes||[]).length };
  ['awaiting_review','sent','failed','rejected'].forEach(function(s){
    counts[s] = (S.notificacoes||[]).filter(function(n){return n.status===s;}).length;
  });

  function chip(value, label){
    var active = filtroStatus === value;
    var style = active
      ? 'background:var(--v);color:#fff;border-color:var(--v)'
      : 'background:var(--card);color:var(--tx);border-color:var(--bd)';
    return '<button class="btn bsm" style="'+style+'" onclick="window._notifFiltroStatus=\''+value+'\';navigate(\'notificacoes\')">'+label+'</button>';
  }

  var rows = lista.map(function(n){
    var when = n.createdAt && n.createdAt.seconds
      ? new Date(n.createdAt.seconds*1000).toLocaleString('pt-BR')
      : '—';
    var sentWhen = n.sentAt && n.sentAt.seconds
      ? new Date(n.sentAt.seconds*1000).toLocaleString('pt-BR')
      : '—';
    var by = auditUserLabel({ userId: n.createdBy });
    var actoes = '';
    if(n.status === 'awaiting_review' || n.status === 'failed'){
      actoes = '<button class="btn bsm bp" onclick="notifOpenReview(\''+n.id+'\')">Revisar</button>';
    } else if(n.status === 'sending'){
      // Envio em andamento (ou interrompido). Nunca deve virar dead-end: permite abrir para ver e-mails/erro.
      actoes = '<span style="color:var(--mt);font-size:11px;font-style:italic;margin-right:6px">enviando…</span>'+
               '<button class="btn bsm" onclick="notifOpenReview(\''+n.id+'\')">Detalhes</button>';
    } else if(n.status === 'awaiting_extraction'){
      actoes = '<span style="color:var(--mt);font-size:11px;font-style:italic">em processamento…</span>';
    } else {
      actoes = '<button class="btn bsm" onclick="notifOpenReview(\''+n.id+'\')">Detalhes</button>';
    }
    return '<tr>'+
      '<td style="font-size:11px">'+esc(when)+'</td>'+
      '<td style="font-size:11px;font-family:monospace">'+esc(n.numero_processo||'')+'</td>'+
      '<td>'+notifTipoLabel(n.tipo)+'</td>'+
      '<td>'+notifStatusBadge(n.status)+'</td>'+
      '<td style="font-size:11px">'+esc(sentWhen)+'</td>'+
      '<td style="font-size:11px">'+by+'</td>'+
      '<td>'+actoes+'</td>'+
    '</tr>';
  }).join('') || '<tr><td colspan="7" style="text-align:center;color:var(--mt);padding:14px">Nenhuma notificação ainda.</td></tr>';

  return '<div class="page-title">'+I.notificacoes+' Notificações</div>'+
    '<div class="card" style="margin-bottom:10px">'+
      '<div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">'+
        '<div style="display:flex;gap:6px;flex-wrap:wrap">'+
          chip('todos','Todas ('+counts.todos+')')+
          chip('awaiting_review','Aguardando ('+counts.awaiting_review+')')+
          chip('sent','Enviadas ('+counts.sent+')')+
          chip('failed','Falhas ('+counts.failed+')')+
          chip('rejected','Rejeitadas ('+counts.rejected+')')+
        '</div>'+
        '<div style="display:flex;gap:8px;align-items:center">'+
          '<input type="text" placeholder="Buscar por número de processo" value="'+esc(filtroBusca)+'" oninput="window._notifFiltroBusca=this.value;clearTimeout(window._notifFiltroT);window._notifFiltroT=setTimeout(function(){navigate(\'notificacoes\')},300)" style="padding:5px 10px;border:.5px solid var(--bd);border-radius:6px;font-size:12px;width:240px"/>'+
          '<button class="btn bp" onclick="notifOpenCreate()">+ Nova Notificação</button>'+
        '</div>'+
      '</div>'+
    '</div>'+
    '<div class="card">'+
      '<table class="tbl"><thead><tr><th>Criado em</th><th>Processo</th><th>Tipo</th><th>Status</th><th>Data de envio</th><th>Criado por</th><th>Ações</th></tr></thead><tbody>'+rows+'</tbody></table>'+
    '</div>';
}

function notifOpenCreate(){
  showModal('<button class="modal-close" onclick="closeModal()">×</button>'+
    '<div class="modal-title">Nova Notificação</div>'+
    '<div class="fg" style="margin-bottom:10px"><label>Número do processo *</label>'+
      '<input type="text" id="nf-numero" placeholder="0000000-00.0000.0.00.0000" autofocus/>'+
      '<div style="font-size:11px;color:var(--mt)">A pasta é localizada no Drive automaticamente pelo número.</div></div>'+
    '<div class="fg" style="margin-bottom:10px"><label>Tipo de notificação *</label>'+
      '<div style="display:flex;gap:14px;font-size:13px;padding:4px 0">'+
        '<label><input type="radio" name="nf-tipo" value="comum" checked/> Comum</label>'+
        '<label><input type="radio" name="nf-tipo" value="trabalhista"/> Trabalhista</label>'+
        '<label><input type="radio" name="nf-tipo" value="rpv"/> RPV</label>'+
        '<label><input type="radio" name="nf-tipo" value="precatorio"/> Precatório</label>'+
      '</div></div>'+
    '<div class="fg" style="margin-bottom:10px"><label>E-mails destinatários (opcional)</label>'+
      '<textarea id="nf-emails" rows="2" placeholder="vara5@trt2.jus.br, procuradoria@sp.gov.br"></textarea>'+
      '<div style="font-size:11px;color:var(--mt)">Opcional — pode preencher na revisão antes de enviar. Separe por vírgula ou ponto-e-vírgula.</div></div>'+
    '<div id="nf-err" class="login-err" style="display:none;margin-bottom:10px"></div>'+
    '<div style="display:flex;justify-content:flex-end;gap:10px">'+
      '<button class="btn" onclick="closeModal()">Cancelar</button>'+
      '<button class="btn bp" onclick="notifSubmitCreate()">Criar e Extrair →</button>'+
    '</div>');
}

async function notifSubmitCreate(){
  var numero = (document.getElementById('nf-numero').value||'').trim();
  var tipo = (document.querySelector('input[name="nf-tipo"]:checked')||{}).value || 'comum';
  var emailsRaw = (document.getElementById('nf-emails').value||'').trim();
  var emails = emailsRaw.split(/[,;\n]/).map(function(e){return e.trim();}).filter(Boolean);

  if(!numero){ notifShowErr('nf-err','Informe o número do processo.'); return; }
  // E-mails são opcionais na criação — podem ser preenchidos na revisão antes de enviar.

  try{
    closeModal();
    showToast('Criando notificação — extração leva ~30s, aguarde...');
    await callFn('criarNotificacao', { numero_processo: numero, tipo: tipo, emails: emails });
    showToast('Notificação criada! Atualize a página se não aparecer.');
    navigate('notificacoes');
  }catch(e){
    alert('Erro ao criar: '+(e.message||e.code||'falhou'));
  }
}

function notifOpenReview(id){
  var n = (S.notificacoes||[]).find(function(x){return x.id===id;});
  if(!n){ showToast('Notificação não encontrada.'); return; }

  var dados = n.dadosExtraidos || {};
  var cedentes = Array.isArray(dados.cedentes) ? dados.cedentes : [];

  function cedenteRow(c, idx){
    return '<div style="display:flex;gap:6px;margin-bottom:6px" data-ced-idx="'+idx+'">'+
      '<input type="text" placeholder="Nome" value="'+esc(c.nome||'')+'" id="nf-ced-nome-'+idx+'" style="flex:2"/>'+
      '<input type="text" placeholder="Profissão" value="'+esc(c.profissao||'')+'" id="nf-ced-prof-'+idx+'" style="flex:1"/>'+
      '<button class="btn bsm bd2" type="button" onclick="this.parentElement.remove()">−</button>'+
    '</div>';
  }

  var cedentesHtml = cedentes.length
    ? cedentes.map(cedenteRow).join('')
    : cedenteRow({nome:'',profissao:''}, 0);

  var camposExtras = '';
  if(n.tipo === 'rpv' || n.tipo === 'precatorio'){
    camposExtras =
      '<div class="g2" style="gap:8px;margin-bottom:8px">'+
        '<div class="fg"><label>Réu</label><input type="text" id="nf-reu" value="'+esc(dados.reu||'')+'"/></div>'+
        '<div class="fg"><label>Autor</label><input type="text" id="nf-autor" value="'+esc(dados.autor||'')+'"/></div>'+
      '</div>';
  }
  if(n.tipo === 'precatorio'){
    camposExtras +=
      '<div class="g2" style="gap:8px;margin-bottom:8px">'+
        '<div class="fg"><label>Nº Precatório</label><input type="text" id="nf-precatorio" value="'+esc(dados.numero_precatorio||'')+'"/></div>'+
        '<div class="fg"><label>Nº Processo Execução</label><input type="text" id="nf-execucao" value="'+esc(dados.numero_processo_execucao||'')+'"/></div>'+
      '</div>';
  }
  var campoVara = (n.tipo === 'comum' || n.tipo === 'trabalhista')
    ? '<div class="fg" style="margin-bottom:8px"><label>Vara</label><input type="text" id="nf-vara" value="'+esc(dados.vara||'')+'"/></div>'
    : '';

  var pastaLink = n.pastaProcessoId
    ? '<div style="margin-top:4px"><a href="https://drive.google.com/drive/folders/'+n.pastaProcessoId+'" target="_blank" style="font-size:11px;color:var(--blue)">Abrir pasta no Drive ↗</a></div>'
    : '';
  var pdfPreview = n.pdfDriveId
    ? '<iframe src="https://drive.google.com/file/d/'+n.pdfDriveId+'/preview" style="width:100%;height:520px;border:.5px solid var(--bd);border-radius:6px"></iframe>'+pastaLink
    : '<div style="color:var(--mt);font-style:italic">PDF ainda não gerado.</div>'+pastaLink;

  var isFinal = (n.status === 'sent' || n.status === 'rejected');
  var disabledAttr = isFinal ? 'disabled' : '';

  // Anexos padrão (notificação/contrato/comprovantes) — contrato e comprovantes desmarcáveis.
  function anexoLinha(tipo, id, label, sempre){
    var dis = (disabledAttr || sempre) ? 'disabled' : '';
    return '<div style="font-size:12px;margin:3px 0"><label style="display:flex;align-items:center;gap:6px;color:var(--ft);font-style:normal">'+
      '<input type="checkbox" class="nf-padrao-chk" data-tipo="'+tipo+'" data-id="'+esc(id)+'" checked '+dis+' style="width:14px;height:14px;accent-color:var(--v)"/>'+
      '<span>📎 '+label+(sempre?' <span style="color:var(--mt);font-size:11px">— sempre</span>':'')+'</span>'+
      '<a href="https://drive.google.com/file/d/'+esc(id)+'/view" target="_blank" style="color:var(--blue);font-size:11px;margin-left:4px">↗</a>'+
    '</label></div>';
  }
  var anexosPadraoHtml = '';
  if(n.pdfDriveId) anexosPadraoHtml += anexoLinha('pdf', n.pdfDriveId, 'Notificação', true);
  if(n.contratoDriveId) anexosPadraoHtml += anexoLinha('contrato', n.contratoDriveId, 'Contrato', true);
  (n.comprovanteDriveIds||[]).forEach(function(cid, i){
    anexosPadraoHtml += anexoLinha('comprovante', cid, 'Comprovante '+(i+1), false);
  });
  if(!anexosPadraoHtml) anexosPadraoHtml = '<div style="color:var(--mt);font-style:italic;font-size:12px">Sem anexos padrão.</div>';

  var actoesFooter = '';
  if(!isFinal){
    actoesFooter =
      '<button class="btn bd2" onclick="notifOpenReject(\''+n.id+'\')">Rejeitar ×</button>'+
      '<button class="btn" onclick="notifSalvarEdicoes(\''+n.id+'\')">Salvar</button>'+
      '<button class="btn bp" onclick="notifApproveSend(\''+n.id+'\')">Aprovar e Enviar ✓</button>';
  } else {
    actoesFooter = '<button class="btn" onclick="closeModal()">Fechar</button>';
  }

  showModal('<button class="modal-close" onclick="closeModal()">×</button>'+
    '<div class="modal-title">Revisar Notificação — Processo '+esc(n.numero_processo||'')+' ('+notifTipoLabel(n.tipo)+')</div>'+
    '<div style="margin-bottom:10px">Status: '+notifStatusBadge(n.status)+
      (n.pdfFoiSubstituidoUpload ? ' <span class="badge b-par" style="margin-left:6px">PDF manual</span>' : '')+
    '</div>'+
    (n.status === 'sending' ? '<div class="card" style="background:var(--dl);border-color:var(--d);margin-bottom:10px;padding:10px 14px;font-size:13px;color:var(--tx)">⏳ <b>Envio em andamento ou interrompido.</b><br><span style="font-size:12px;color:var(--mt)">Se ficou preso aqui, o envio provavelmente falhou. Confira os e-mails e anexos abaixo; se necessário, use "Aprovar e Enviar" novamente (o sistema não reenvia duplicado).</span></div>' : '')+
    ((n.avisosExtracao && n.avisosExtracao.length) ? '<div class="card" style="background:var(--dl);border-color:var(--d);margin-bottom:10px;padding:10px 14px;font-size:13px;color:var(--tx)">⚠️ <b>Campo(s) não preenchido(s) automaticamente:</b> '+esc(n.avisosExtracao.join(', '))+'.<br><span style="font-size:12px;color:var(--mt)">O PDF foi gerado mesmo assim. Preencha em "Dados extraídos" e clique em <b>Re-gerar PDF</b> antes de enviar, se necessário.</span></div>' : '')+

    '<details open style="margin-bottom:10px"><summary style="cursor:pointer;font-weight:700;font-size:13px;color:var(--mt);text-transform:uppercase;letter-spacing:.05em">Preview do PDF</summary>'+
      '<div style="margin-top:8px">'+pdfPreview+'</div>'+
    '</details>'+

    '<details style="margin-bottom:10px"><summary style="cursor:pointer;font-weight:700;font-size:13px;color:var(--mt);text-transform:uppercase;letter-spacing:.05em">Dados extraídos</summary>'+
      '<div style="margin-top:8px">'+
        '<div style="margin-bottom:6px;font-size:12px;color:var(--mt)">Cedentes:</div>'+
        '<div id="nf-cedentes-wrap">'+cedentesHtml+'</div>'+
        '<button class="btn bsm" type="button" onclick="notifAddCedenteRow()" style="margin-bottom:10px">+ Adicionar cedente</button>'+
        campoVara+
        camposExtras+
        '<div class="fg" style="margin-bottom:8px"><label>Objeto da cessão</label><textarea id="nf-objeto" rows="3">'+esc(dados.objeto_cessao||'')+'</textarea></div>'+
        '<div style="display:flex;gap:10px">'+
          '<button class="btn bp" '+disabledAttr+' onclick="notifReGenerate(\''+n.id+'\')">Re-gerar PDF</button>'+
          '<button class="btn" '+disabledAttr+' onclick="notifOpenReplaceUpload(\''+n.id+'\')">Substituir por PDF manual…</button>'+
        '</div>'+
      '</div>'+
    '</details>'+

    '<details open style="margin-bottom:10px"><summary style="cursor:pointer;font-weight:700;font-size:13px;color:var(--mt);text-transform:uppercase;letter-spacing:.05em">E-mail</summary>'+
      '<div style="margin-top:10px">'+
        '<div class="fg" style="margin-bottom:10px"><label>Destinatários (separados por vírgula)</label>'+
          '<textarea id="nf-emails-edit" rows="2" '+disabledAttr+'>'+esc((n.emails||[]).join(', '))+'</textarea></div>'+
        '<div class="fg" style="margin-bottom:10px"><label>Assunto</label>'+
          '<input type="text" id="nf-assunto" class="nf-assunto-big" value="'+esc(n.assunto||'')+'" '+disabledAttr+'/></div>'+
        '<div class="fg"><label>Corpo do e-mail <span style="color:var(--mt);font-weight:400">— confira quebras de linha e espaçamento antes de enviar</span></label>'+
          '<textarea id="nf-corpo" class="nf-emailbody" rows="18" '+disabledAttr+'>'+esc(n.corpoEmail||'')+'</textarea></div>'+
      '</div>'+
    '</details>'+

    '<details open style="margin-bottom:10px"><summary style="cursor:pointer;font-weight:700;font-size:13px;color:var(--mt);text-transform:uppercase;letter-spacing:.05em">Anexos</summary>'+
      '<div style="margin-top:8px">'+
        '<div style="font-size:12px;color:var(--mt);margin-bottom:4px">Desmarque os que não quiser enviar:</div>'+
        anexosPadraoHtml+
        '<div style="margin-top:10px;padding-top:8px;border-top:.5px dashed var(--bd)">'+
          '<div style="font-size:12px;color:var(--mt);margin-bottom:6px">Outros documentos da pasta (marque para anexar):</div>'+
          '<div id="nf-extras-wrap" style="font-size:11px;color:var(--mt);font-style:italic">Carregando...</div>'+
        '</div>'+
      '</div>'+
    '</details>'+

    (n.rejectedReason ? '<div class="login-err" style="display:block;margin-bottom:10px">Motivo da rejeição: '+esc(n.rejectedReason)+'</div>' : '')+
    ((n.errosTentativa||[]).length ? '<div class="login-err" style="display:block;margin-bottom:10px;font-size:11px">Erro recente: '+esc((n.errosTentativa.slice(-1)[0]||{}).mensagem||'')+'</div>' : '')+

    '<div id="nf-rev-err" class="login-err" style="display:none;margin-bottom:10px"></div>'+
    '<div style="display:flex;justify-content:space-between;gap:10px">'+
      '<button class="btn" onclick="closeModal()">Fechar</button>'+
      '<div style="display:flex;gap:10px">'+actoesFooter+'</div>'+
    '</div>', {wide:true});

  notifCarregarExtras(n, isFinal);
}

async function notifCarregarExtras(n, readOnly){
  var wrap = document.getElementById('nf-extras-wrap');
  if(!wrap) return;
  try{
    var r = await callFn('listarAnexosNotificacao', { notificacaoId: n.id });
    var arquivos = (r && r.arquivos) || [];
    // Exclui os anexos padrão (notificação/contrato/comprovantes) — esses aparecem na lista de cima.
    var padroes = {};
    if(n.pdfDriveId) padroes[n.pdfDriveId]=1;
    if(n.contratoDriveId) padroes[n.contratoDriveId]=1;
    (n.comprovanteDriveIds||[]).forEach(function(id){padroes[id]=1;});
    var extras = arquivos.filter(function(a){return !padroes[a.id];});
    if(extras.length === 0){
      wrap.innerHTML = '<span style="color:var(--mt);font-style:italic">Nenhum outro arquivo na pasta.</span>';
      return;
    }
    var disabled = readOnly ? 'disabled' : '';
    wrap.innerHTML = extras.map(function(a){
      return '<div style="margin:3px 0"><label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--ft);font-style:normal">'+
        '<input type="checkbox" class="nf-extra-chk" data-id="'+esc(a.id)+'" '+disabled+'/>'+
        '<span>📎 '+esc(a.name||'(sem nome)')+'</span>'+
        '<a href="https://drive.google.com/file/d/'+esc(a.id)+'/view" target="_blank" style="color:var(--blue);font-size:11px;margin-left:6px">↗</a>'+
      '</label></div>';
    }).join('');
  }catch(e){
    wrap.innerHTML = '<span style="color:var(--red,#c33)">Erro ao carregar: '+esc(e.message||e.code||'falhou')+'</span>';
  }
}

function notifAddCedenteRow(){
  var wrap = document.getElementById('nf-cedentes-wrap');
  if(!wrap) return;
  var idx = wrap.children.length;
  var div = document.createElement('div');
  div.style.cssText = 'display:flex;gap:6px;margin-bottom:6px';
  div.setAttribute('data-ced-idx', idx);
  div.innerHTML = '<input type="text" placeholder="Nome" id="nf-ced-nome-'+idx+'" style="flex:2"/>'+
    '<input type="text" placeholder="Profissão" id="nf-ced-prof-'+idx+'" style="flex:1"/>'+
    '<button class="btn bsm bd2" type="button" onclick="this.parentElement.remove()">−</button>';
  wrap.appendChild(div);
}

function notifColetaDadosEditados(notificacao){
  var rows = document.querySelectorAll('#nf-cedentes-wrap > div');
  var cedentes = [];
  rows.forEach(function(row){
    var idx = row.getAttribute('data-ced-idx');
    var nome = (document.getElementById('nf-ced-nome-'+idx)||{}).value || '';
    var prof = (document.getElementById('nf-ced-prof-'+idx)||{}).value || '';
    if(nome.trim()){ cedentes.push({ nome: nome.trim(), profissao: prof.trim() }); }
  });
  var dados = { cedentes: cedentes };
  if(notificacao.tipo === 'comum' || notificacao.tipo === 'trabalhista'){
    var v = document.getElementById('nf-vara');
    if(v) dados.vara = v.value.trim();
    var ncs = (notificacao.dadosExtraidos||{}).numero_cumprimento_sentenca;
    if(ncs) dados.numero_cumprimento_sentenca = ncs;
  }
  if(notificacao.tipo === 'rpv' || notificacao.tipo === 'precatorio'){
    var reu = document.getElementById('nf-reu');
    var aut = document.getElementById('nf-autor');
    if(reu) dados.reu = reu.value.trim();
    if(aut) dados.autor = aut.value.trim();
  }
  if(notificacao.tipo === 'precatorio'){
    var prec = document.getElementById('nf-precatorio');
    var exec = document.getElementById('nf-execucao');
    if(prec) dados.numero_precatorio = prec.value.trim();
    if(exec) dados.numero_processo_execucao = exec.value.trim();
  }
  var obj = document.getElementById('nf-objeto');
  if(obj) dados.objeto_cessao = obj.value.trim();
  return dados;
}

async function notifReGenerate(id){
  var n = (S.notificacoes||[]).find(function(x){return x.id===id;});
  if(!n) return;
  var dadosEditados = notifColetaDadosEditados(n);
  if(!dadosEditados.cedentes || dadosEditados.cedentes.length === 0){
    notifShowErr('nf-rev-err','Pelo menos um cedente é obrigatório.');
    return;
  }
  try{
    showToast('Re-gerando PDF — aguarde ~15s...');
    await callFn('regenerarPdf', { notificacaoId: id, dadosEditados: dadosEditados });
    showToast('PDF regerado!');
    closeModal();
    setTimeout(function(){ notifOpenReview(id); }, 800);
  }catch(e){
    notifShowErr('nf-rev-err','Erro: '+(e.message||e.code||'falhou'));
  }
}

function notifOpenReplaceUpload(id){
  var input = document.getElementById('nf-replace-pdf-input');
  if(!input){
    input = document.createElement('input');
    input.type = 'file';
    input.id = 'nf-replace-pdf-input';
    input.accept = 'application/pdf,.pdf';
    input.style.display = 'none';
    document.body.appendChild(input);
  }
  input.onchange = async function(){
    if(!input.files || !input.files.length) return;
    var file = input.files[0];
    if(file.size > 7 * 1024 * 1024){
      alert('Arquivo muito grande (limite 7MB).');
      input.value = '';
      return;
    }
    try{
      showToast('Enviando PDF — aguarde...');
      var reader = new FileReader();
      reader.onload = async function(){
        var b64 = reader.result.split(',')[1]; // remove "data:application/pdf;base64,"
        try{
          await callFn('substituirPdfUpload', { notificacaoId: id, pdfBase64: b64 });
          showToast('PDF substituído!');
          closeModal();
          setTimeout(function(){ notifOpenReview(id); }, 800);
        }catch(e){
          alert('Erro ao substituir: '+(e.message||e.code||'falhou'));
        }
      };
      reader.readAsDataURL(file);
    }catch(e){
      alert('Erro ao ler arquivo: '+e.message);
    }
    input.value = '';
  };
  input.click();
}

// Salva os e-mails / edições do e-mail (assunto, corpo) sem enviar — preserva o histórico.
async function notifSalvarEdicoes(id){
  var n = (S.notificacoes||[]).find(function(x){return x.id===id;});
  if(!n){ return; }
  if(n.status==='sent'){ notifShowErr('nf-rev-err','Notificação já enviada — não pode ser editada.'); return; }
  var emailsRaw = (document.getElementById('nf-emails-edit')||{}).value || '';
  var emails = emailsRaw.split(/[,;\n]/).map(function(e){return e.trim();}).filter(Boolean);
  var assunto = ((document.getElementById('nf-assunto')||{}).value || '').trim();
  var corpo = (document.getElementById('nf-corpo')||{}).value || '';
  try{
    await fb.updateDoc(fb.doc(fb.db,'notificacoes',id), {
      emails: emails, assunto: assunto, corpoEmail: corpo,
      lastEditedAt: fb.serverTimestamp(), lastEditedBy: currentUser.id
    });
    // reflete localmente (mantém o modal aberto)
    n.emails=emails; n.assunto=assunto; n.corpoEmail=corpo;
    showToast('Alterações salvas ✓');
  }catch(e){ notifShowErr('nf-rev-err','Erro ao salvar: '+(e.message||e.code||'falhou')); }
}

async function notifApproveSend(id){
  var n = (S.notificacoes||[]).find(function(x){return x.id===id;});
  if(!n){ return; }
  var emailsRaw = (document.getElementById('nf-emails-edit')||{}).value || '';
  var emails = emailsRaw.split(/[,;\n]/).map(function(e){return e.trim();}).filter(Boolean);
  var assunto = ((document.getElementById('nf-assunto')||{}).value || '').trim();
  var corpo = (document.getElementById('nf-corpo')||{}).value || '';

  if(emails.length === 0){ notifShowErr('nf-rev-err','Pelo menos um destinatário é obrigatório.'); return; }
  if(!assunto){ notifShowErr('nf-rev-err','Assunto vazio.'); return; }
  if(!corpo.trim()){ notifShowErr('nf-rev-err','Corpo do e-mail vazio.'); return; }

  // Seleção de anexos: padrão (contrato/comprovante desmarcáveis) + extras opt-in.
  var padraoChecked = Array.prototype.slice.call(document.querySelectorAll('.nf-padrao-chk:checked'));
  var comprovanteDriveIds = padraoChecked.filter(function(el){return el.getAttribute('data-tipo')==='comprovante';})
    .map(function(el){return el.getAttribute('data-id');}).filter(Boolean);
  var contratoMarcado = padraoChecked.some(function(el){return el.getAttribute('data-tipo')==='contrato';});
  var extraDriveIds = Array.prototype.slice.call(document.querySelectorAll('.nf-extra-chk:checked'))
    .map(function(el){return el.getAttribute('data-id');}).filter(Boolean);

  if(!confirm('Confirmar envio para '+emails.length+' destinatário(s)?\n\n'+emails.join(', ')+(extraDriveIds.length?'\n\n+ '+extraDriveIds.length+' anexo(s) extra(s)':''))) return;

  try{
    closeModal();
    showToast('Enviando — aguarde...');
    await callFn('enviarNotificacao', {
      notificacaoId: id,
      emails: emails,
      assunto: assunto,
      corpoEmail: corpo,
      extraDriveIds: extraDriveIds,
      anexosSelecionados: {
        contrato: contratoMarcado,
        comprovanteDriveIds: comprovanteDriveIds,
      },
    });
    showToast('E-mail enviado com sucesso!');
    navigate('notificacoes');
  }catch(e){
    alert('Erro ao enviar: '+(e.message||e.code||'falhou'));
  }
}

function notifOpenReject(id){
  showModal('<button class="modal-close" onclick="closeModal()">×</button>'+
    '<div class="modal-title">Rejeitar Notificação</div>'+
    '<div class="fg" style="margin-bottom:10px"><label>Motivo *</label>'+
      '<textarea id="nf-rej-motivo" rows="4" placeholder="Descreva o motivo da rejeição..."></textarea></div>'+
    '<div id="nf-rej-err" class="login-err" style="display:none;margin-bottom:10px"></div>'+
    '<div style="display:flex;justify-content:flex-end;gap:10px">'+
      '<button class="btn" onclick="closeModal()">Cancelar</button>'+
      '<button class="btn bd2" onclick="notifSubmitReject(\''+id+'\')">Rejeitar</button>'+
    '</div>');
}

async function notifSubmitReject(id){
  var motivo = ((document.getElementById('nf-rej-motivo')||{}).value || '').trim();
  if(!motivo){ notifShowErr('nf-rej-err','Informe o motivo.'); return; }
  try{
    await callFn('rejeitarNotificacao', { notificacaoId: id, motivo: motivo });
    closeModal();
    showToast('Notificação rejeitada.');
    navigate('notificacoes');
  }catch(e){
    notifShowErr('nf-rej-err','Erro: '+(e.message||e.code||'falhou'));
  }
}

/* ===== Módulo CNAB (Fase 5 — geração de arquivo bancário via cnab-service) ===== */
// Reusa o mesmo mecanismo de ID token do calcFetch (fb.auth.currentUser.getIdToken).
async function cnabFetchMultipart(formData){
  var tok = fb.auth.currentUser ? await fb.auth.currentUser.getIdToken() : null;
  if(!tok){ return { ok:false, status:0, data:{erro:'sem sessão'} }; }
  var r = await fetch(CNAB_SERVICE_URL + '/gerar-cnab', {
    method:'POST', headers:{ 'Authorization':'Bearer '+tok }, body: formData
  });
  var data = await r.json().catch(function(){ return {}; });
  return { ok: r.ok, status: r.status, data: data };
}

function pageCnab(){
  if(!isAdmin(currentUser)) return '<div class="page-title">CNAB</div><div class="card"><div class="empty">Acesso restrito a administradores.</div></div>';
  return '<div class="page-title">'+esc(I.cnab||'🏦')+' CNAB — Geração de arquivo bancário</div>'+
    '<div class="card">'+
      '<div class="g3" style="margin-bottom:10px">'+
        '<div class="fg"><label>Tipo</label><select id="cnab-tipo">'+
          '<option value="aquisicao">Aquisição</option>'+
          '<option value="liquidacao">Liquidação (recebimentos)</option>'+
          '<option value="remarcacao">Remarcação a mercado</option>'+
          '<option value="perda">Perda</option>'+
        '</select></div>'+
        '<div class="fg"><label>Sequencial (auto)</label><input type="number" id="cnab-seq" min="1" placeholder="automático"/></div>'+
      '</div>'+
      '<div class="fg" style="margin-bottom:10px"><label>Planilha Excel (.xlsx)</label>'+
        '<div class="drop-zone" id="cnab-drop" onclick="document.getElementById(\'cnab-file\').click()"'+
          ' ondragover="event.preventDefault();this.classList.add(\'drag-over\')"'+
          ' ondragleave="this.classList.remove(\'drag-over\')"'+
          ' ondrop="cnabSoltar(event)">'+
          '📄 Arraste a planilha .xlsx aqui ou clique para escolher'+
          '<div class="dz-file" id="cnab-file-nome"></div>'+
        '</div>'+
        '<input type="file" id="cnab-file" accept=".xlsx" style="display:none" onchange="cnabMostrarArquivo()"/>'+
      '</div>'+
      '<button class="btn bp" onclick="cnabGerar(this)">Gerar CNAB</button>'+
      '<div id="cnab-result" style="margin-top:12px"></div>'+
    '</div>'+
    '<div class="card" style="margin-top:14px"><div style="font-weight:700;margin-bottom:8px">Histórico</div><div id="cnab-hist"><div class="empty">Carregando…</div></div></div>';
}

// Arquivo solto na área: entra no <input> (via DataTransfer) para o cnabGerar seguir lendo de lá.
function cnabSoltar(ev){
  ev.preventDefault();
  var zona=document.getElementById('cnab-drop'); if(zona) zona.classList.remove('drag-over');
  var f=ev.dataTransfer && ev.dataTransfer.files && ev.dataTransfer.files[0];
  if(!f) return;
  if(!/\.xlsx$/i.test(f.name)){ showToast('Use uma planilha .xlsx.'); return; }
  var inp=document.getElementById('cnab-file');
  var dt=new DataTransfer(); dt.items.add(f); inp.files=dt.files;
  cnabMostrarArquivo();
}
function cnabMostrarArquivo(){
  var f=document.getElementById('cnab-file').files[0];
  var el=document.getElementById('cnab-file-nome'); if(el) el.textContent=f?f.name:'';
}

async function cnabGerar(btn){
  var tipo = document.getElementById('cnab-tipo').value;
  var file = document.getElementById('cnab-file').files[0];
  if(!file){ showToast('Selecione a planilha Excel.'); return; }
  var seq = document.getElementById('cnab-seq').value;
  var fd = new FormData();
  fd.append('arquivo', file); fd.append('tipo', tipo); // sem data → o serviço usa a data de hoje
  if(seq){ fd.append('sequencial', seq); }
  if(btn){ btn.disabled=true; btn.textContent='Gerando…'; }
  var r = await cnabFetchMultipart(fd);
  if(btn){ btn.disabled=false; btn.textContent='Gerar CNAB'; }
  var el = document.getElementById('cnab-result');
  if(!r.ok){ el.innerHTML='<div style="color:var(--red)">Erro: '+esc((r.data&&r.data.erro)||('status '+r.status))+'</div>'; return; }
  var d = r.data;
  var xlsx = d.processadoPath || d.entradaPath; // Excel: processado (liquidação) ou o de entrada
  el.innerHTML='<div class="card" style="background:var(--dl)"><b>'+esc(d.arquivoNome)+'</b><br>'+
    d.nLinhas+' registro(s) · valor total '+fmt(d.valorTotal)+'<br>'+
    '<button class="btn" style="margin-top:8px" onclick="cnabBaixar(\''+esc(d.remPath)+'\')">⬇ Baixar .REM</button>'+
    (xlsx?' <button class="btn" onclick="cnabBaixar(\''+esc(xlsx)+'\',\''+esc(cnabExcelNome(tipo,d.dataEmissao))+'\')">⬇ Baixar Excel'+(d.processadoPath?' (processado)':'')+'</button>':'')+
    '</div>';
  showToast('CNAB gerado.');
  cnabCarregarHistorico();
}

// Nome padrão do Excel por tipo: "FIDC PBL - <Rótulo> DD-MM-YYYY.xlsx".
var CNAB_LABEL = {aquisicao:'Aquisição', liquidacao:'Liquidações', remarcacao:'Remarcação', perda:'Perda'};
function cnabExcelNome(tipo, dataIso){
  var p=String(dataIso||'').split('-'); // yyyy-mm-dd
  var dm=(p.length===3)?(p[2]+'-'+p[1]+'-'+p[0]):'';
  return 'FIDC PBL - '+(CNAB_LABEL[tipo]||tipo||'')+' '+dm+'.xlsx';
}
async function cnabBaixar(path, filename){
  // Download via URL assinada emitida pelo cnab-service (admin). O Storage nega leitura direta do cliente.
  // filename (opcional) define o nome do download (ex.: nome padrão do Excel).
  try{
    var token = await fb.auth.currentUser.getIdToken();
    var q = CNAB_SERVICE_URL+'/url?path='+encodeURIComponent(path)+(filename?('&filename='+encodeURIComponent(filename)):'');
    var r = await fetch(q, { headers:{ 'Authorization':'Bearer '+token } });
    var d = await r.json().catch(function(){return {};});
    if(r.ok && d.url){
      // A URL assinada já serve com Content-Disposition: attachment; o <a download> dispara o download na hora.
      var a=document.createElement('a'); a.href=d.url; a.download=filename||path.split('/').pop();
      document.body.appendChild(a); a.click(); a.remove();
    }
    else { showToast('Falha ao baixar: '+((d&&d.erro)||('status '+r.status))); }
  }catch(e){ showToast('Falha ao baixar: '+(e.code||e.message)); }
}

async function cnabCarregarHistorico(){
  var box = document.getElementById('cnab-hist'); if(!box) return;
  try{
    var snap = await fb.getDocs(fb.collection(fb.db,'cnab'));
    var docs = []; snap.forEach(function(dc){ docs.push(Object.assign({id:dc.id}, dc.data())); });
    // ordena por geradoEm desc (Timestamp ou string ISO), pega os 50 mais recentes
    docs.sort(function(a,b){
      var ta = a.geradoEm && a.geradoEm.seconds ? a.geradoEm.seconds : (typeof a.geradoEm==='string' ? new Date(a.geradoEm).getTime()/1000 : 0);
      var tb = b.geradoEm && b.geradoEm.seconds ? b.geradoEm.seconds : (typeof b.geradoEm==='string' ? new Date(b.geradoEm).getTime()/1000 : 0);
      return tb - ta;
    });
    docs = docs.slice(0,50);
    var rows = docs.map(function(d){
      var xlsx = d.processadoPath || d.entradaPath; // Excel: processado (liquidação) ou o de entrada
      return '<tr><td>'+esc(d.dataEmissao||'')+'</td><td>'+esc(d.tipo||'')+'</td><td class="r">'+esc(String(d.sequencial||''))+'</td>'+
        '<td class="r">'+esc(String(d.nLinhas||0))+'</td><td class="r">'+fmt(d.valorTotal||0)+'</td>'+
        '<td>'+esc(d.geradoPorNome||d.geradoPor||'')+'</td>'+
        '<td style="white-space:nowrap"><button class="btn" onclick="cnabBaixar(\''+esc(d.remPath||'')+'\')">⬇ .REM</button>'+
        (xlsx?' <button class="btn" onclick="cnabBaixar(\''+esc(xlsx)+'\',\''+esc(cnabExcelNome(d.tipo,d.dataEmissao))+'\')">⬇ Excel</button>':'')+'</td></tr>';
    }).join('') || '<tr><td colspan="7" class="empty">Nenhum CNAB gerado ainda.</td></tr>';
    box.innerHTML='<div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr><th>Data</th><th>Tipo</th><th class="r">Seq</th><th class="r">Registros</th><th class="r">Valor</th><th>Gerado por</th><th></th></tr></thead><tbody>'+rows+'</tbody></table></div>';
  }catch(e){ box.innerHTML='<div class="empty">Erro ao carregar histórico: '+esc(e.code||e.message)+'</div>'; }
}
</script>
<script>
async function addLiqManual(){
  if(!canWriteLiquidacoes(currentUser)){showToast("Sem permissão para esta ação.");return;}
  var tit=document.getElementById('lm-tit').value;
  var data=document.getElementById('lm-data').value;
  var proc=(document.getElementById('lm-proc').value||'').trim();
  var adv=document.getElementById('lm-adv').value;
  var valor=parseFloat(document.getElementById('lm-valor').value)||0;
  var liq=document.getElementById('lm-liq').value;
  var creditos=parseInt(document.getElementById('lm-creditos').value,10);
  if(!tit||!data||!adv||!valor){alert('Preencha Origem do crédito, Data, Advogado e Valor recebido.');return;}
  if(!creditos||creditos<1){alert('Informe a Quantidade de Créditos (número inteiro ≥ 1).');return;}
  try{
    await upsertLiquidacao({titularidade:tit,data:data,processo:proc,advogadoId:adv,valor:valor,liquidacao:liq,creditos:creditos});
    S.liqManual=await fetchCollection('liquidacoes');
    // Baixa automática das diligências do processo (Total=cumprida; Parcial=cumprida + tarefa p/ advogado).
    var nBaixa=0;
    try{ nBaixa=await baixarDiligenciasPorLiquidacao(proc, liq, adv); if(nBaixa){ S.diligencias=await fetchCollection('diligencias'); } }catch(_e){ console.error('baixa dilig (manual):',_e); }
    showToast('Liquidação registrada!'+(nBaixa?(' '+nBaixa+' diligência(s) baixada(s).'):''));
    navigate('reliquidados');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}
async function delLiqManual(id){
  if(!canDeleteLiquidacoes(currentUser)){showToast("Sem permissão para excluir.");return;}
  if(!confirm('Excluir lançamento?'))return;
  try{
    await deleteLiquidacao(id);
    S.liqManual=await fetchCollection('liquidacoes');
    navigate('reliquidados');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}
// Abre modal de edição de uma liquidação existente (admin/gestora/supervisora).
function editLiqManual(id){
  if(!canWriteLiquidacoes(currentUser)){showToast("Sem permissão para esta ação.");return;}
  var m=(S.liqManual||[]).find(function(x){return x.id===id;});
  if(!m){showToast("Liquidação não encontrada.");return;}
  var advOpts=S.lawyers.map(function(l){return'<option value="'+l.id+'"'+(l.id===m.advogadoId?' selected':'')+'>'+esc(l.name)+'</option>';}).join('');
  function tOpt(v,label){return '<option value="'+v+'"'+(m.titularidade===v?' selected':'')+'>'+label+'</option>';}
  function lOpt(v,label){return '<option value="'+v+'"'+(m.liquidacao===v?' selected':'')+'>'+label+'</option>';}
  showModal(
    '<div class="modal-title">Editar liquidação</div>'+
    '<div class="fg"><label>Origem do crédito *</label><select id="le-tit">'+titSelectOptions(m.titularidade||'')+'</select></div>'+
    '<div class="fg"><label>Data *</label><input type="date" id="le-data" value="'+esc(m.data||'')+'"/></div>'+
    '<div class="fg"><label>Advogado *</label><select id="le-adv"><option value="">Selecione...</option>'+advOpts+'</select></div>'+
    '<div class="fg"><label>Nº Processo</label><input type="text" id="le-proc" value="'+esc(m.processo||'')+'" placeholder="0000000-00.0000.0.00.0000"/></div>'+
    '<div class="fg"><label>Valor recebido (R$) *</label><input type="number" id="le-valor" min="0" step="0.01" value="'+esc(String(m.valor||0))+'"/></div>'+
    '<div class="fg"><label>Liquidação *</label><select id="le-liq">'+lOpt('Parcial','Parcial (recebimento parcial)')+lOpt('Total','Total (processo 100% liquidado)')+'</select></div>'+
    '<div class="fg"><label>Qtd. Créditos *</label><input type="number" id="le-creditos" min="1" step="1" value="'+esc(String(parseInt(m.creditos,10)||1))+'"/></div>'+
    '<div style="text-align:right;margin-top:12px"><button class="btn" onclick="closeModal()">Cancelar</button> <button class="btn bp" onclick="salvarEdicaoLiq(\''+esc(id)+'\')">Salvar alterações</button></div>'
  );
}
async function salvarEdicaoLiq(id){
  if(!canWriteLiquidacoes(currentUser)){showToast("Sem permissão para esta ação.");return;}
  var m=(S.liqManual||[]).find(function(x){return x.id===id;});
  if(!m){showToast("Liquidação não encontrada.");return;}
  var tit=document.getElementById('le-tit').value;
  var data=document.getElementById('le-data').value;
  var proc=(document.getElementById('le-proc').value||'').trim();
  var adv=document.getElementById('le-adv').value;
  var valor=parseFloat(document.getElementById('le-valor').value)||0;
  var liq=document.getElementById('le-liq').value;
  var creditos=parseInt(document.getElementById('le-creditos').value,10);
  if(!tit||!data||!adv||!valor){alert('Preencha Origem do crédito, Data, Advogado e Valor recebido.');return;}
  if(!creditos||creditos<1){alert('Informe a Quantidade de Créditos (número inteiro ≥ 1).');return;}
  try{
    await upsertLiquidacao(Object.assign({}, m, {id:id, titularidade:tit, data:data, processo:proc, advogadoId:adv, valor:valor, liquidacao:liq, creditos:creditos}));
    S.liqManual=await fetchCollection('liquidacoes');
    closeModal();
    navigate('reliquidados');
    showToast('Liquidação atualizada!');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}

// Importa planilha .xlsx direto para S.liqManual (lançamentos manuais)
function importLiqXlsx(input){
  if(!isFullAccess(currentUser)){alert('Apenas Admin pode importar.');return;}
  if(!input.files||!input.files.length)return;
  readXlsx(input.files[0], async function(rows){
    var toAdd=[],skipped=0,advNoMatch=[];
    rows.forEach(function(r){
      // Lê colunas da planilha (várias variações de header)
      var titRaw=String(getCol(r,['TITULARIDADE','Titularidade','titularidade'])||'').trim().toUpperCase();
      var datRaw=getCol(r,['DATA','Data','data']);
      var proc=String(getCol(r,['PROCESSOS','Processos','PROCESSO','Processo','processo'])||'').trim();
      var advRaw=String(getCol(r,['ADVOGADO','Advogado','advogado'])||'').trim();
      var val=parseValor(getCol(r,['VALOR','Valor','valor'])||0)||0;
      var liqRaw=String(getCol(r,['LIQUIDAÇÃO','Liquidação','LIQUIDACAO','Liquidacao','liquidacao'])||'').trim().toUpperCase();
      var cred=Math.max(0, parseInt(getCol(r,['CREDITOS','CRÉDITOS','Creditos','Créditos','QTD CREDITOS','Qtd Créditos','creditos'])||0,10)||0);

      // Pula linhas vazias / cabeçalho repetido
      if(!advRaw || advRaw==='ADVOGADO' || !val) {skipped++;return;}

      // Normaliza titularidade
      var tit='';
      if(titRaw.indexOf('FIDC')>=0) tit='FIDC PBL';
      else if(titRaw.indexOf('CERTJUD')>=0 || titRaw.indexOf('CERT JUD')>=0) tit='CERTJUD';
      else if(titRaw.indexOf('PBL')>=0) tit='PBL Originadora';
      else {skipped++;return;}

      // Converte data
      var dat='';
      if(datRaw){
        try{
          if(typeof datRaw==='number'){
            // Excel serial date
            var d=new Date(Math.round((datRaw-25569)*86400*1000));
            if(!isNaN(d))dat=d.toISOString().slice(0,10);
          } else {
            var d2=new Date(String(datRaw));
            if(!isNaN(d2))dat=d2.toISOString().slice(0,10);
          }
        }catch(e){}
      }
      if(!dat) dat=todayStr();

      // Casa advogado pelo primeiro nome (case-insensitive, sem acentos)
      var advKey=advRaw.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim();
      var firstName=advKey.split(/\s+/)[0];
      var lawyer=S.lawyers.find(function(l){
        var n=(l.name||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim();
        var fn=n.split(/\s+/)[0];
        return fn===firstName || n===advKey || n.indexOf(firstName)===0;
      });
      if(!lawyer){
        skipped++;
        if(advNoMatch.indexOf(advRaw)<0)advNoMatch.push(advRaw);
        return;
      }

      // Liquidação: Parcial ou Total (default Total)
      var liq=liqRaw.indexOf('PARCIAL')>=0 ? 'Parcial' : 'Total';

      toAdd.push({
        titularidade:tit,
        data:dat,
        processo:proc,
        advogadoId:lawyer.id,
        valor:val,
        creditos:cred,
        liquidacao:liq,
        importado:true
      });
    });
    // Batch-write em lotes de 400.
    var BATCH=400, added=0;
    try{
      var batch=fb.writeBatch(fb.db);
      for(var i=0;i<toAdd.length;i++){
        var liq=toAdd[i];
        var ref=fb.doc(fb.collection(fb.db,'liquidacoes'));
        batch.set(ref, Object.assign({},liq,{
          id:ref.id,
          valor:Number(liq.valor)||0,
          data:liq.data||'',
          criadoPor:currentUser.id,
          createdBy:currentUser.id,
          createdAt:fb.serverTimestamp(),
          updatedBy:currentUser.id,
          updatedAt:fb.serverTimestamp()
        }));
        added++;
        if(added%BATCH===0){ await batch.commit(); batch=fb.writeBatch(fb.db); }
      }
      if(added%BATCH!==0) await batch.commit();
      S.liqManual=await fetchCollection('liquidacoes');
    }catch(e){ alert('Erro no import: '+(e.code||e.message)); return; }
    // Baixa automática das diligências por processo (dedupe: TOTAL prevalece sobre PARCIAL).
    var baixaMap={}, totalBaixadas=0;
    toAdd.forEach(function(t){
      var np=String(t.processo||'').replace(/\D/g,''); if(np.length<20)return;
      if(!baixaMap[np]) baixaMap[np]={processo:t.processo,liq:t.liquidacao,adv:t.advogadoId};
      if(String(t.liquidacao).toUpperCase().indexOf('PARCIAL')<0) baixaMap[np].liq='Total'; // qualquer Total → Total
    });
    try{
      var keys=Object.keys(baixaMap);
      for(var bi=0;bi<keys.length;bi++){ var b=baixaMap[keys[bi]]; totalBaixadas+=await baixarDiligenciasPorLiquidacao(b.processo, b.liq, b.adv); }
      if(totalBaixadas){ S.diligencias=await fetchCollection('diligencias'); }
    }catch(_e){ console.error('baixa dilig (import):',_e); }
    var el=document.getElementById('imp-liq-status');
    if(el)el.textContent=added+' importados';
    var msg=added+' lançamentos importados.';
    if(skipped>0)msg+='\n'+skipped+' linhas puladas.';
    if(totalBaixadas)msg+='\n'+totalBaixadas+' diligência(s) baixada(s) automaticamente.';
    if(advNoMatch.length)msg+='\nAdvogados não encontrados: '+advNoMatch.slice(0,8).join(', ')+(advNoMatch.length>8?'...':'');
    alert(msg);
    input.value='';
    navigate('reliquidados');
  });
}

var TIPOS_DISTRIB=[
  {id:'proc_val',label:'Processo',val:5,grupo:'processo',desc:'Validação de processo'},
  {id:'cont_val',label:'Contrato',val:2,grupo:'processo',desc:'Validação de contrato'},
  {id:'capa',label:'Capa a Capa',val:10,grupo:'precatorio',desc:'Validação capa a capa de precatórios'},
  {id:'auditoria',label:'Auditoria',val:10,grupo:'precatorio',desc:'Auditoria de precatórios'}
];

// ════════════════════════════════════════════════════════════
// COMISSÕES POR GESTORA (Evilyn, Margie, Jeanne, Karen, Tanna)
// ════════════════════════════════════════════════════════════
// Definição fixa das gestoras e suas regras de remuneração.
// Cada uma tem uma base e um conjunto de "bônus" condicionais (se bater meta).
// Margie é CUMULATIVA (cada meta soma R$1.000); demais ESCALONADAS (substitui pela maior faixa atingida).
var GESTORAS_DEF=[
  {id:'evilyn',  nome:'Evilyn',  tipo:'evilyn',  modo:'configuravel'},
  {id:'margie',  nome:'Margie',  tipo:'margie',  modo:'cumulativa', base:12000,
    bonus:[
      {key:'metaCont',     label:'Meta contencioso',      val:1000},
      {key:'metaCom',      label:'Meta comercial',         val:1000},
      {key:'supermetaCom', label:'Supermeta comercial',    val:1000},
      {key:'supermetaCont',label:'Supermeta contencioso',  val:1000}
    ],
    campanhas:true
  },
  {id:'jeanne',  nome:'Jeanne',  tipo:'jeanne',  modo:'escalonada', base:10000,
    faixas:[
      {key:'metaCom',      label:'Meta comercial',     valor:12000},
      {key:'supermetaCom', label:'Supermeta comercial',valor:14000}
    ],
    campanhas:true
  },
  {id:'karen',   nome:'Karen',   tipo:'karen',   modo:'escalonada', base:6000,
    faixas:[
      {key:'metaCont',     label:'Meta contencioso',     valor:8000},
      {key:'supermetaCont',label:'Supermeta contencioso',valor:10000}
    ],
    campanhas:false
  },
  {id:'tanna',   nome:'Tanna',   tipo:'tanna',   modo:'escalonada', base:7000,
    faixas:[
      {key:'metaCont',     label:'Meta contencioso',     valor:8500},
      {key:'supermetaCont',label:'Supermeta contencioso',valor:10000}
    ],
    campanhas:false
  }
];

// Calcula somatório de entradas e liquidações no mês selecionado.
// Retorna {totEntradas, totLiquidado, bateMetaCom, bateSuperMetaCom, bateMetaCont, bateSuperMetaCont, metaContValor, supermetaContValor}
// mesParam é opcional: quando passado, calcula métricas referentes a esse mês específico
// (YYYY-MM). Quando ausente, usa o mês de S.mes (modo mês) — backward compat para o painel
// principal de status. Em modo ano/custom, pageComissoesGestoras itera mês-a-mês.
function calcMetricasGestoras(mesParam){
  var mes = mesParam || S.mes || '';
  var cfg=S.gestorasMetas[mes]||{};
  function inMesLocal(dataStr){ if(!mes) return false; return String(dataStr||'').slice(0,7)===mes; }
  // Total de entradas no mês: soma de e.volEntradas (legado) + (futuramente entradas detalhadas se existirem)
  var totEntradas=0;
  Object.keys(S.entries||{}).forEach(function(lid){
    var en=S.entries[lid];if(!en)return;
    totEntradas+=(en.volEntradas||0);
  });
  // Total liquidado no mês: soma S.liqManual do mês + recebimentos do mês que NÃO vieram de liquidação.
  // (Ao registrar liquidação, o valor entra em S.liqManual E como recebimento carimbado com liqId/origem;
  //  somar os dois contava em dobro — por isso ignoramos os recebimentos de origem 'liquidacao'.)
  var totLiquidado=0;
  (S.liqManual||[]).forEach(function(m){if(inMesLocal(m.data))totLiquidado+=(m.valor||0);});
  S.processos.forEach(function(p){
    recebOf(p).forEach(function(r){
      if(!recebContaComoLiquidado(r)) return;   // espelho de liquidação ou pagamento nos autos
      if(inMesLocal(r.data))totLiquidado+=(r.valor||0);
    });
  });
  // Metas/supermetas — admin define no formulário em "Comissões por Gestora".
  var metaCom=cfg.metaComercial||0;
  var supermetaCom=cfg.supermetaComercial||0;
  var metaContValor=cfg.metaContencioso||0;
  var supermetaContValor=cfg.supermetaContencioso||0;
  return {
    totEntradas:totEntradas,
    totLiquidado:totLiquidado,
    metaCom:metaCom,
    supermetaCom:supermetaCom,
    metaContValor:metaContValor,
    supermetaContValor:supermetaContValor,
    bateMetaCom:metaCom>0 && totEntradas>=metaCom,
    bateSuperMetaCom:supermetaCom>0 && totEntradas>=supermetaCom,
    bateMetaCont:metaContValor>0 && totLiquidado>=metaContValor,
    bateSuperMetaCont:supermetaContValor>0 && totLiquidado>=supermetaContValor
  };
}

// Calcula a remuneração total de uma gestora dado o objeto de métricas
function calcGestora(g, met){
  var mes=S.mes||'';
  var cfg=S.gestorasMetas[mes]||{};
  var base=g.base||0;
  var detalhes=[]; // linhas de extrato
  var total=0;

  if(g.tipo==='evilyn'){
    // Configurável: Evilyn define o valor mensal pela tela
    base=cfg.baseEvilyn||0;
    detalhes.push({l:'Pró-labore (configurável)',v:base});
    total=base;
  } else if(g.modo==='cumulativa'){
    // Margie: base + cada meta atingida soma R$1.000
    detalhes.push({l:'Pró-labore base',v:base});
    total=base;
    g.bonus.forEach(function(b){
      var bate=
        (b.key==='metaCom' && met.bateMetaCom) ||
        (b.key==='supermetaCom' && met.bateSuperMetaCom) ||
        (b.key==='metaCont' && met.bateMetaCont) ||
        (b.key==='supermetaCont' && met.bateSuperMetaCont);
      if(bate){detalhes.push({l:'+ '+b.label+' atingida',v:b.val});total+=b.val;}
      else detalhes.push({l:'  '+b.label+' (não atingida)',v:0,muted:true});
    });
  } else if(g.modo==='escalonada'){
    // Jeanne, Karen, Tanna: paga a maior faixa atingida (substitui)
    var maiorFaixa=null;
    g.faixas.forEach(function(f){
      var bate=
        (f.key==='metaCom' && met.bateMetaCom) ||
        (f.key==='supermetaCom' && met.bateSuperMetaCom) ||
        (f.key==='metaCont' && met.bateMetaCont) ||
        (f.key==='supermetaCont' && met.bateSuperMetaCont);
      if(bate)maiorFaixa=f;
    });
    if(maiorFaixa){
      detalhes.push({l:maiorFaixa.label+' atingida → faixa',v:maiorFaixa.valor});
      total=maiorFaixa.valor;
    } else {
      detalhes.push({l:'Pró-labore base (sem metas atingidas)',v:base});
      total=base;
    }
  }

  // Campanhas (Margie e Jeanne) — soma do valor de campanhas no mês (do sistema existente)
  if(g.campanhas){
    var campTotal=0;
    (S.campanhas||[]).forEach(function(c){
      // Soma todas as campanhas do mês corrente (mesma regra das comissões dos advogados)
      if(c.mes===mes || !c.mes) campTotal+=(c.valor||0);
    });
    if(campTotal>0){detalhes.push({l:'Campanhas do mês',v:campTotal});total+=campTotal;}
  }

  return {detalhes:detalhes,total:total};
}

// Retorna lista de IDs de /gestoras visíveis para o usuário atual.
function gestorasVisiveis(){
  var todasIds = (S.gestoras||[]).map(function(g){return g.id;});
  // Admin: vê TODAS (incluindo se ele tambem for gestora secundaria).
  if(isFullAccess(currentUser)) return todasIds;
  // Gestora primaria: vê só a propria.
  if(currentUser && currentUser.role==='gestora'){
    var gid = currentUser.gestoraId;
    return (gid && todasIds.indexOf(gid)>=0) ? [gid] : [];
  }
  // Demais (supervisora, lawyer): nao veem nenhuma.
  return [];
}

function pageComissoesGestoras(){
  var visiveis=gestorasVisiveis();
  if(!visiveis.length){
    return '<div class="page-title">'+I.advogados+' Comissões por Gestora</div>'+
      '<div class="card"><div class="empty">Nenhuma gestora cadastrada (ou você não tem permissão).</div></div>';
  }
  var canEdit=isFullAccess(currentUser);
  var meses = mesesDoPeriodo();
  var modoMes = (S.periodo||{}).mode === 'mes';

  // Painel de configuração mensal (admin) — só em modo mês.
  var configHtml='';
  if(canEdit && modoMes){
    var mes=S.mes||'';
    var cfg=S.gestorasMetas[mes]||{};
    configHtml=
      '<div class="st">Configuração mensal — '+esc(mes||'(selecione um mês)')+'</div>'+
      '<div class="card" style="margin-bottom:18px">'+
        '<div class="g4" style="margin-bottom:10px">'+
          '<div class="fg"><label>Meta comercial (R$)</label><input type="text" inputmode="decimal" id="gm-meta-com" value="'+(cfg.metaComercial?fmt(cfg.metaComercial):'')+'" placeholder="R$ 0,00" onchange="maskMoeda(this)"/></div>'+
          '<div class="fg"><label>Supermeta comercial (R$)</label><input type="text" inputmode="decimal" id="gm-supermeta-com" value="'+(cfg.supermetaComercial?fmt(cfg.supermetaComercial):'')+'" placeholder="R$ 0,00" onchange="maskMoeda(this)"/></div>'+
          '<div class="fg"><label>Meta contencioso (R$)</label><input type="text" inputmode="decimal" id="gm-meta-cont" value="'+(cfg.metaContencioso?fmt(cfg.metaContencioso):'')+'" placeholder="R$ 0,00" onchange="maskMoeda(this)"/></div>'+
          '<div class="fg"><label>Supermeta contencioso (R$)</label><input type="text" inputmode="decimal" id="gm-supermeta-cont" value="'+(cfg.supermetaContencioso?fmt(cfg.supermetaContencioso):'')+'" placeholder="R$ 0,00" onchange="maskMoeda(this)"/></div>'+
        '</div>'+
        '<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">'+
          '<div style="background:var(--vl);padding:9px 12px;border-radius:6px;font-size:11px;color:var(--mt);flex:1;min-width:280px">💡 Cada gestora ganha +R$1.000 por meta atingida. Em modo Ano/Personalizado as comissões são somadas mês-a-mês.</div>'+
          '<button class="btn bp" onclick="saveGestorasMetas()">💾 Salvar metas do mês</button>'+
        '</div>'+
      '</div>';
  } else if(canEdit && !modoMes){
    configHtml = '<div class="card" style="margin-bottom:18px;font-size:12px;color:var(--mt)">💡 Para editar metas de um mês específico, troque o seletor de período para <strong>Mês</strong>.</div>';
  }

  // Status (modo mês): badges de metas; modo ano/custom: só totais agregados.
  var statusHtml = '';
  if(modoMes){
    var met = calcMetricasGestoras();
    statusHtml =
      '<div class="metrics" style="margin-bottom:18px">'+
        '<div class="mc"><div class="ml">Total entradas no mês</div><div class="mv">'+fmt(met.totEntradas)+'</div><div style="font-size:11px;color:var(--mt)">'+(met.bateMetaCom?'<span style="color:var(--v);font-weight:600">✓ Meta comercial atingida</span>':(met.metaCom>0?'Falta '+fmt(met.metaCom-met.totEntradas):'Meta não definida'))+'</div></div>'+
        '<div class="mc gold"><div class="ml">Total liquidado no mês</div><div class="mv gold">'+fmt(met.totLiquidado)+'</div><div style="font-size:11px;color:var(--mt)">'+(met.bateMetaCont?'<span style="color:var(--v);font-weight:600">✓ Meta contencioso atingida</span>':(met.metaContValor>0?'Falta '+fmt(met.metaContValor-met.totLiquidado):'Meta não definida'))+'</div></div>'+
        '<div class="mc"><div class="ml">Metas comercial</div><div class="mv" style="font-size:15px">Meta: '+(met.metaCom>0?fmt(met.metaCom):'—')+(met.bateMetaCom?' <span style="color:var(--v)">✓</span>':'')+'</div><div style="font-size:12px;color:var(--mt);margin-top:3px">Supermeta: '+(met.supermetaCom>0?fmt(met.supermetaCom):'—')+(met.bateSuperMetaCom?' <span style="color:var(--v);font-weight:700">✓ atingida</span>':'')+'</div></div>'+
        '<div class="mc"><div class="ml">Metas contencioso</div><div class="mv" style="font-size:15px">Meta: '+(met.metaContValor>0?fmt(met.metaContValor):'—')+(met.bateMetaCont?' <span style="color:var(--v)">✓</span>':'')+'</div><div style="font-size:12px;color:var(--mt);margin-top:3px">Supermeta: '+(met.supermetaContValor>0?fmt(met.supermetaContValor):'—')+(met.bateSuperMetaCont?' <span style="color:var(--v);font-weight:700">✓ atingida</span>':'')+'</div></div>'+
      '</div>';
  } else {
    // Agregado: soma totEntradas e totLiquidado de cada mês no período.
    var aggEntradas = 0, aggLiquidado = 0;
    meses.forEach(function(m){
      var x = calcMetricasGestoras(m);
      aggEntradas += x.totEntradas; aggLiquidado += x.totLiquidado;
    });
    statusHtml =
      '<div class="metrics" style="margin-bottom:18px">'+
        '<div class="mc"><div class="ml">Total entradas no período</div><div class="mv">'+fmt(aggEntradas)+'</div><div style="font-size:11px;color:var(--mt)">'+meses.length+' meses</div></div>'+
        '<div class="mc gold"><div class="ml">Total liquidado no período</div><div class="mv gold">'+fmt(aggLiquidado)+'</div></div>'+
      '</div>';
  }

  // Cards por gestora — em modo mês: 1 mês; modo ano/custom: soma de todos os meses.
  var cards=(S.gestoras||[])
    .filter(function(g){return visiveis.indexOf(g.id)>=0;})
    .sort(function(a,b){return (a.name||'').localeCompare(b.name||'');})
    .map(function(g){return renderGestoraCard(g, meses);}).join('');

  return '<div class="page-title">'+I.advogados+' Comissões por Gestora</div>'+
    configHtml+
    statusHtml+
    (cards || '<div class="card"><div class="empty">Nenhuma gestora visível.</div></div>');
}

// Renderiza um card de gestora. Para cada mês no período, computa pró-labore + bônus,
// e exibe o total agregado. Em modo mês, exibe a quebra de bônus do único mês.
function renderGestoraCard(g, meses){
  var inativa = g.active === false;
  var statusBadge = inativa ? ' <span style="font-size:10px;color:#999;font-style:italic">(inativa)</span>' : '';
  var base = g.prolabore || 0;
  var numMeses = (meses||[]).length || 1;
  var modoMes = numMeses === 1;
  var aggBase = base * numMeses;
  var aggBonus = 0;
  var aggBonusCounts = {metaCom:0, supermetaCom:0, metaCont:0, supermetaCont:0};
  (meses||[]).forEach(function(m){
    var met = calcMetricasGestoras(m);
    if(met.bateMetaCom)       { aggBonus += 1000; aggBonusCounts.metaCom++; }
    if(met.bateSuperMetaCom)  { aggBonus += 1000; aggBonusCounts.supermetaCom++; }
    if(met.bateMetaCont)      { aggBonus += 1000; aggBonusCounts.metaCont++; }
    if(met.bateSuperMetaCont) { aggBonus += 1000; aggBonusCounts.supermetaCont++; }
  });
  var total = aggBase + aggBonus;

  var linhasHtml = '<tr><td style="padding:5px 10px;font-size:12px;color:var(--mt)">Pró-labore '+(modoMes?'fixo':'('+numMeses+' meses)')+'</td>'+
    '<td style="padding:5px 10px;font-size:12px;text-align:right;color:var(--v);font-weight:600">'+fmt(aggBase)+'</td></tr>';
  if(modoMes){
    // Em modo mês mostra o detalhe atingida/não atingida de cada bônus
    var met = calcMetricasGestoras(meses[0]);
    var bonuses = [
      {label:'Meta comercial atingida',         atingida: met.bateMetaCom},
      {label:'Supermeta comercial atingida',    atingida: met.bateSuperMetaCom},
      {label:'Meta contencioso atingida',       atingida: met.bateMetaCont},
      {label:'Supermeta contencioso atingida',  atingida: met.bateSuperMetaCont},
    ];
    bonuses.forEach(function(b){
      linhasHtml += '<tr><td style="padding:5px 10px;font-size:12px;color:var(--mt)">'+(b.atingida?'+ ':'  ')+esc(b.label)+(b.atingida?'':' (não atingida)')+'</td>'+
        '<td style="padding:5px 10px;font-size:12px;text-align:right;color:'+(b.atingida?'var(--v)':'var(--mt)')+';font-weight:'+(b.atingida?'600':'400')+'">'+(b.atingida?fmt(1000):'—')+'</td></tr>';
    });
  } else {
    // Em modo ano/custom mostra contagem de meses que bateram cada meta
    var labels = [
      {k:'metaCom',       lbl:'Meses com meta comercial'},
      {k:'supermetaCom',  lbl:'Meses com supermeta comercial'},
      {k:'metaCont',      lbl:'Meses com meta contencioso'},
      {k:'supermetaCont', lbl:'Meses com supermeta contencioso'},
    ];
    labels.forEach(function(lb){
      var c = aggBonusCounts[lb.k] || 0;
      var v = c * 1000;
      linhasHtml += '<tr><td style="padding:5px 10px;font-size:12px;color:var(--mt)">'+esc(lb.lbl)+' ('+c+'/'+numMeses+')</td>'+
        '<td style="padding:5px 10px;font-size:12px;text-align:right;color:'+(v?'var(--v)':'var(--mt)')+';font-weight:'+(v?'600':'400')+'">'+(v?fmt(v):'—')+'</td></tr>';
    });
  }
  return '<div class="card" style="margin-bottom:12px;'+(inativa?'opacity:.6':'')+'">'+
    '<div style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--bd);padding-bottom:8px;margin-bottom:8px">'+
      '<div><div style="font-weight:700;font-size:14px">'+esc(g.name||'—')+statusBadge+'</div><div style="font-size:11px;color:var(--mt)">'+esc(g.email||'')+'</div></div>'+
      '<div style="text-align:right"><div style="font-size:11px;color:var(--mt)">Total a receber</div><div style="font-size:18px;font-weight:700;color:var(--v)">'+fmt(total)+'</div></div>'+
    '</div>'+
    '<table style="width:100%"><tbody>'+linhasHtml+'</tbody></table>'+
  '</div>';
}

async function saveGestorasMetas(){
  if(!isFullAccess(currentUser)){alert('Apenas Admin.');return;}
  var mes=S.mes||'';
  if(!mes){alert('Selecione um mês de referência no topo da tela.');return;}
  if(!S.gestorasMetas[mes])S.gestorasMetas[mes]={};
  // Os campos passaram a ter máscara R$ (item 14a): parseFloat("R$ 14.000,00") daria NaN.
  var g=function(id){var v=document.getElementById(id);return v?parseMoeda(v.value):0;};
  var fields={
    metaComercial: g('gm-meta-com'),
    supermetaComercial: g('gm-supermeta-com'),
    metaContencioso: g('gm-meta-cont'),
    supermetaContencioso: g('gm-supermeta-cont')
  };
  Object.assign(S.gestorasMetas[mes], fields);
  try{
    await persistGestoraMeta(mes, fields);
    showToast('Metas salvas!');
    navigate('comissoesgestoras');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}


// Calcula comissão total a partir de uma lista de tipos (array de IDs)
function comissaoTipos(tipos){
  if(!tipos || !tipos.length) return 0;
  return tipos.reduce(function(s,id){
    var t=TIPOS_DISTRIB.find(function(x){return x.id===id;});
    return s+(t?t.val:0);
  },0);
}

// Retorna label combinado dos tipos selecionados
function labelTipos(tipos){
  if(!tipos || !tipos.length) return '—';
  return tipos.map(function(id){
    var t=TIPOS_DISTRIB.find(function(x){return x.id===id;});
    return t?t.label:id;
  }).join(' + ');
}

// Determina em qual carteira o processo cai:
// REGRA: vai para o validador, EXCETO se o inseridor for Johnathan (PJ) — nesse caso fica com Johnathan.
function definirCarteira(validadorId, inseridorId){
  if(!inseridorId) return validadorId;
  var ins=S.lawyers.find(function(l){return l.id===inseridorId;});
  if(ins && ins.pjInsercao) return inseridorId;
  return validadorId;
}

function pageDistrib(){
  var hasFullAccess=isFullAccess(currentUser);
  var podeExcluir=hasFullAccess;
  var readOnly = false; // todos os roles permitidos (admin/gestora/supervisora/lawyer) podem registrar validação
  var advOpts=S.lawyers.map(function(l){return'<option value="'+l.id+'">'+l.name+(l.pjInsercao?' (PJ)':'')+'</option>';}).join('');

  // Checkboxes agrupados por categoria (processo / precatório)
  function buildChecks(grupo, corHover){
    return TIPOS_DISTRIB.filter(function(t){return t.grupo===grupo;}).map(function(t){
      return '<label style="display:flex;align-items:center;gap:8px;padding:9px 12px;border:1px solid var(--bd);border-radius:8px;cursor:pointer;background:var(--card);font-size:13px;transition:all .15s" '+
        'onmouseover="if(!this.querySelector(\'input\').checked)this.style.background=\''+corHover+'\'" onmouseout="if(!this.querySelector(\'input\').checked)this.style.background=\'var(--card)\'">'+
        '<input type="checkbox" name="dv-tipo" value="'+t.id+'" data-grupo="'+grupo+'" onchange="dvAtualizaResumo()" style="cursor:pointer;width:16px;height:16px;accent-color:var(--v)"/>'+
        '<span style="flex:1"><strong>'+t.label+'</strong></span>'+
        '<span style="color:var(--v);font-weight:700;font-size:12px">R$ '+t.val+'</span>'+
        '</label>';
    }).join('');
  }
  var checksProc=buildChecks('processo','var(--vl)');
  var checksPrec=buildChecks('precatorio','var(--dl)');

  // Estado dos filtros (preservado entre re-renders)
  var fAdv=document.getElementById('dv-fadv')?document.getElementById('dv-fadv').value:'todos';
  var fTipo=document.getElementById('dv-ftipo')?document.getElementById('dv-ftipo').value:'todos';
  var fBusca=document.getElementById('dv-fbusca')?(document.getElementById('dv-fbusca').value||'').toLowerCase():'';
  var fPeriodo=document.getElementById('dv-fperiodo')?document.getElementById('dv-fperiodo').value:'todos';
  var fDataIni=document.getElementById('dv-fdi')?document.getElementById('dv-fdi').value:'';
  var fDataFim=document.getElementById('dv-fdf')?document.getElementById('dv-fdf').value:'';
  var fMateria=document.getElementById('dv-fmat')?document.getElementById('dv-fmat').value:'todos';

  // Calcular período baseado no preset
  var hoje=new Date(); hoje.setHours(0,0,0,0);
  var hojeStr=hoje.toISOString().slice(0,10);
  var di=fDataIni, df=fDataFim;
  if(fPeriodo==='hoje'){di=hojeStr;df=hojeStr;}
  else if(fPeriodo==='semana'){
    var d7=new Date(hoje);d7.setDate(hoje.getDate()-6);
    di=d7.toISOString().slice(0,10);df=hojeStr;
  } else if(fPeriodo==='mes'){
    var dm=new Date(hoje.getFullYear(),hoje.getMonth(),1);
    di=dm.toISOString().slice(0,10);df=hojeStr;
  } else if(fPeriodo==='mes_anterior'){
    var dma1=new Date(hoje.getFullYear(),hoje.getMonth()-1,1);
    var dma2=new Date(hoje.getFullYear(),hoje.getMonth(),0);
    di=dma1.toISOString().slice(0,10);df=dma2.toISOString().slice(0,10);
  }

  // Materias únicas para filtro
  var materiasSet={};
  S.distribValidacao.forEach(function(m){if(m.materia)materiasSet[m.materia]=true;});
  var materiasList=Object.keys(materiasSet).sort();
  var matOpts='<option value="todos"'+(fMateria==='todos'?' selected':'')+'>Todas</option>'+
    materiasList.map(function(x){return'<option value="'+esc(x)+'"'+(fMateria===x?' selected':'')+'>'+esc(x)+'</option>';}).join('');

  // Para filtro por tipo: se algum registro do grupo tem o tipo, o grupo inteiro entra
  var gruposTipo={};
  if(fTipo!=='todos'){
    S.distribValidacao.forEach(function(m){
      if(m.tipo===fTipo) gruposTipo[m.grupoId||m.id]=true;
    });
  }

  var lista=S.distribValidacao.slice().filter(function(m){
    if(fAdv!=='todos' && m.advogadoId!==fAdv && m.inseridorId!==fAdv) return false;
    if(fTipo!=='todos' && !gruposTipo[m.grupoId||m.id]) return false;
    if(fMateria!=='todos' && (m.materia||'')!==fMateria) return false;
    if(di && (m.data||'')<di) return false;
    if(df && (m.data||'')>df) return false;
    if(fBusca){
      var hay=((m.cliente||'')+' '+(m.numero||'')+' '+(m.obs||'')+' '+(m.materia||'')).toLowerCase();
      if(hay.indexOf(fBusca)<0) return false;
    }
    return true;
  }).sort(function(a,b){return(b.data||'').localeCompare(a.data||'');});

  // Métricas (agrupadas por grupoId — uma validação combinada conta como 1)
  var gruposNaLista={};
  lista.forEach(function(m){gruposNaLista[m.grupoId||m.id]=true;});
  var qtdValidacoes=Object.keys(gruposNaLista).length;
  var totalLista=lista.reduce(function(s,m){return s+comissaoTipos([m.tipo]);},0);
  var totalGeral=S.distribValidacao.reduce(function(s,m){return s+comissaoTipos([m.tipo]);},0);

  // Contagem por advogado (validador) — quantas validações distintas
  var porAdv={};
  lawyersComissao().forEach(function(l){porAdv[l.id]={qtd:0,com:0,nome:l.name,grupos:{}};});
  lista.forEach(function(m){
    if(!porAdv[m.advogadoId])return;
    porAdv[m.advogadoId].com+=comissaoTipos([m.tipo]);
    porAdv[m.advogadoId].grupos[m.grupoId||m.id]=true;
  });
  Object.keys(porAdv).forEach(function(k){porAdv[k].qtd=Object.keys(porAdv[k].grupos).length;});
  var rankAdv=Object.keys(porAdv).map(function(k){return porAdv[k];}).filter(function(x){return x.qtd>0;}).sort(function(a,b){return b.qtd-a.qtd;});
  var rankAdvHtml=rankAdv.length?rankAdv.map(function(x,i){
    return '<tr style="'+(i%2?'background:var(--row-alt)':'')+'"><td style="padding:7px 10px">'+esc(x.nome)+'</td><td style="padding:7px 10px;text-align:right;font-weight:600">'+x.qtd+'</td><td style="padding:7px 10px;text-align:right;color:var(--v);font-weight:700">R$ '+x.com.toFixed(2).replace('.',',')+'</td></tr>';
  }).join(''):'<tr><td colspan="3" style="padding:14px;text-align:center;color:var(--mt)">Nenhum advogado com validações no período.</td></tr>';

  // Tabela agrupada
  var gruposMap={};
  var ordemGrupos=[];
  lista.forEach(function(m){
    var k=m.grupoId||m.id;
    if(!gruposMap[k]){gruposMap[k]={primeiro:m,tipos:[],tiposIds:[],ids:[],totalVal:0};ordemGrupos.push(k);}
    gruposMap[k].tiposIds.push(m.tipo);
    gruposMap[k].ids.push(m.id);
    var t=TIPOS_DISTRIB.find(function(x){return x.id===m.tipo;});
    if(t){gruposMap[k].tipos.push(t.label);gruposMap[k].totalVal+=t.val;}
  });

  var rows=ordemGrupos.map(function(k,i){
    var g=gruposMap[k];
    var m=g.primeiro;
    var validador=(S.lawyers.find(function(l){return l.id===m.advogadoId;})||{name:'---'}).name;
    var inseridor=m.inseridorId?(S.lawyers.find(function(l){return l.id===m.inseridorId;})||{name:'---'}).name:'—';
    var carteiraId=definirCarteira(m.advogadoId,m.inseridorId);
    var carteira=(S.lawyers.find(function(l){return l.id===carteiraId;})||{name:'---'}).name;
    var carteiraEspecial=carteiraId!==m.advogadoId;
    var bg=i%2===0?'':'background:var(--row-alt)';
    var edt=podeExcluir?'<button onclick="editDistrib(\''+k+'\')" style="background:none;border:none;color:var(--v);cursor:pointer;font-size:14px;line-height:1;padding:4px 6px" title="Editar validação">✏️</button>':'';
    var del=podeExcluir?'<button onclick="delDistribGrupo(\''+k+'\')" style="background:none;border:none;color:var(--red);cursor:pointer;font-size:18px;line-height:1;padding:4px 8px" title="Excluir validação">×</button>':'';
    var carteiraCell=carteiraEspecial
      ? '<span style="background:var(--dl);color:var(--d);padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600" title="Inseridor PJ — fica na carteira do inseridor">'+esc(carteira)+' ⚡</span>'
      : esc(carteira);
    var tiposCell=g.tiposIds.map(function(tid){
      var t=TIPOS_DISTRIB.find(function(x){return x.id===tid;});
      if(!t)return '';
      var cor=t.grupo==='precatorio'?'background:var(--dl);color:var(--d)':'background:var(--vl);color:var(--v)';
      return '<span style="display:inline-block;'+cor+';padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600;margin:1px 2px">'+esc(t.label)+'</span>';
    }).join('');
    return'<tr style="'+bg+'">'+
      '<td style="padding:8px">'+fmtDate(m.data)+'</td>'+
      '<td style="padding:8px">'+esc(m.cliente||'—')+'</td>'+
      '<td style="padding:8px;font-size:11px;color:var(--mt)">'+esc(m.numero||'—')+'</td>'+
      '<td style="padding:8px;font-size:11px">'+esc(m.materia||'—')+'</td>'+
      '<td style="padding:8px">'+esc(validador)+'</td>'+
      '<td style="padding:8px;color:var(--mt)">'+esc(inseridor)+'</td>'+
      '<td style="padding:8px">'+carteiraCell+'</td>'+
      '<td style="padding:8px">'+tiposCell+'</td>'+
      '<td style="padding:8px;text-align:right;color:var(--v);font-weight:700">R$ '+g.totalVal.toFixed(2).replace('.',',')+'</td>'+
      '<td style="padding:8px;font-size:11px;color:var(--mt)">'+esc(m.obs||'')+'</td>'+
      '<td style="white-space:nowrap">'+edt+del+'</td>'+
    '</tr>';
  }).join('');

  var qtdTotal=S.distribValidacao.length;
  var qtdGruposTotal=Object.keys(S.distribValidacao.reduce(function(o,m){o[m.grupoId||m.id]=1;return o;},{})).length;

  return'<div class="page-title">'+I.resumo+' Validações PBL'+
    '<span class="section-badge" style="background:var(--vl);color:var(--v);font-size:11px;padding:3px 9px;border-radius:10px;margin-left:8px;font-weight:600">'+qtdGruposTotal+' validações</span>'+
    (isFullAccess(currentUser)?'<label class="btn no-print" style="margin-left:auto;font-size:12px;background:#1D6B3A;color:#fff;border-color:#1D6B3A;cursor:pointer">📥 Importar planilha<input type="file" accept=".xlsx,.xls" style="display:none" onchange="importValidacoesXlsx(this)"/></label>':'')+
    '<button class="btn no-print" style="'+(isFullAccess(currentUser)?'margin-left:8px':'margin-left:auto')+';font-size:12px" onclick="exportDistribXlsx()" title="Exportar para Excel">📥 Excel</button>'+
    '<button class="btn no-print" style="margin-left:8px;font-size:12px" onclick="window.print()" title="Imprimir relatório">🖨️ Imprimir</button>'+
    '</div>'+

    // FORMULÁRIO (oculto para lawyer)
    (readOnly ? '' :
    '<div class="card no-print">'+
      '<div style="font-size:12px;color:var(--mt);font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px">Registrar nova validação</div>'+
      '<div class="g3">'+
        '<div class="fg"><label>Data *</label><input type="date" id="dv-data" value="'+todayStr()+'"/></div>'+
        '<div class="fg"><label>Cliente *</label><input type="text" id="dv-cli" placeholder="Nome do cliente"/></div>'+
        '<div class="fg"><label>Nº Processo</label><input type="text" id="dv-num" placeholder="0000000-00.0000.0.00.0000"/></div>'+
        '<div class="fg"><label>Cliente Advogado</label><input type="text" id="dv-cliadv" placeholder="Advogado do cliente (captador)"/></div>'+
      '</div>'+
      '<div class="g3" style="margin-top:10px">'+
        '<div class="fg"><label>Validador * (recebe a comissão)</label><select id="dv-adv" onchange="dvAtualizaCarteira()"><option value="">Selecione...</option>'+advOpts+'</select></div>'+
        '<div class="fg"><label>Inseridor (opcional)</label><select id="dv-ins" onchange="dvAtualizaCarteira()"><option value="">— sem inseridor —</option>'+advOpts+'</select></div>'+
        '<div class="fg"><label>Matéria</label><input type="text" id="dv-mat" placeholder="Ex: RPV, Trabalhista, Cível..." list="mat-list"/>'+
          '<datalist id="mat-list">'+materiasList.map(function(x){return'<option value="'+esc(x)+'"/>';}).join('')+'</datalist>'+
        '</div>'+
      '</div>'+
      '<div style="margin-top:14px">'+
        '<label style="font-size:12px;color:var(--mt);display:block;margin-bottom:8px">Tipo de validação * <span style="font-weight:400">(marque um ou mais — pode combinar dentro do mesmo grupo)</span></label>'+
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">'+
          '<div style="padding:12px;background:var(--row-alt);border-radius:10px;border:1px solid var(--bd)">'+
            '<div style="font-size:11px;font-weight:700;color:var(--v);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px">📄 Processo comum</div>'+
            '<div style="display:flex;flex-direction:column;gap:6px">'+checksProc+'</div>'+
            '<div style="font-size:11px;color:var(--mt);margin-top:6px;font-style:italic">Pode ser só processo, só contrato, ou os dois</div>'+
          '</div>'+
          '<div style="padding:12px;background:var(--dl);border-radius:10px;border:1px solid var(--bd)">'+
            '<div style="font-size:11px;font-weight:700;color:var(--d);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px">📜 Precatório</div>'+
            '<div style="display:flex;flex-direction:column;gap:6px">'+checksPrec+'</div>'+
            '<div style="font-size:11px;color:var(--mt);margin-top:6px;font-style:italic">Pode ser só capa a capa, só auditoria, ou os dois</div>'+
          '</div>'+
        '</div>'+
      '</div>'+
      '<label style="display:flex;align-items:center;gap:8px;margin-top:12px;padding:10px 12px;border:1px solid var(--bd);border-radius:8px;cursor:pointer;background:var(--card);font-size:13px">'+
        '<input type="checkbox" id="dv-comprado" onchange="dvAtualizaCarteira()" style="cursor:pointer;width:16px;height:16px;accent-color:var(--v)"/>'+
        '<span style="flex:1"><strong>Processo Comprado</strong> <span style="color:var(--mt);font-weight:400;font-size:12px">— marque para enviar o processo à carteira do advogado</span></span>'+
      '</label>'+
      '<div class="g2" style="margin-top:10px">'+
        '<div class="fg"><label>Valor da condenação (R$)</label><input type="number" id="dv-vcond" min="0" step="0.01" placeholder="0,00"/></div>'+
        '<div class="fg"><label>Valor de compra (R$)</label><input type="number" id="dv-vcomp" min="0" step="0.01" placeholder="0,00"/></div>'+
      '</div>'+
      '<div class="fg" style="margin-top:12px"><label>Observação</label><input type="text" id="dv-obs" placeholder="Ex: pendência, RPV, detalhe específico..."/></div>'+
      '<div id="dv-prev" style="margin-top:12px;padding:12px 14px;background:var(--vl);border-radius:8px;font-size:13px;color:var(--v);display:none">'+
        '<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">'+
          '<div><strong>📁 Carteira:</strong> <span id="dv-prev-carteira">—</span></div>'+
          '<div><strong>💰 Comissão:</strong> <span id="dv-prev-comissao" style="color:var(--v);font-weight:700">R$ 0,00</span></div>'+
        '</div>'+
      '</div>'+
      '<div style="display:flex;justify-content:space-between;align-items:center;margin-top:14px;flex-wrap:wrap;gap:10px">'+
        '<div style="font-size:11px;color:var(--mt)">⚡ O processo entra na carteira do advogado responsável e a comissão é contabilizada automaticamente.</div>'+
        '<button class="btn bp" onclick="addDistrib()">+ Registrar Validação</button>'+
      '</div>'+
    '</div>')+

    // PAINEL DE FILTROS / RELATÓRIO
    '<div class="card no-print" style="margin-top:14px">'+
      '<div style="font-size:12px;color:var(--mt);font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px">🔍 Filtrar / gerar relatório</div>'+
      '<div class="g4">'+
        '<div class="fg"><label>Período</label>'+
          '<select id="dv-fperiodo" onchange="dvPeriodoChange()">'+
            '<option value="todos"'+(fPeriodo==='todos'?' selected':'')+'>Tudo</option>'+
            '<option value="hoje"'+(fPeriodo==='hoje'?' selected':'')+'>Hoje</option>'+
            '<option value="semana"'+(fPeriodo==='semana'?' selected':'')+'>Últimos 7 dias</option>'+
            '<option value="mes"'+(fPeriodo==='mes'?' selected':'')+'>Mês atual</option>'+
            '<option value="mes_anterior"'+(fPeriodo==='mes_anterior'?' selected':'')+'>Mês anterior</option>'+
            '<option value="custom"'+(fPeriodo==='custom'?' selected':'')+'>Personalizado</option>'+
          '</select>'+
        '</div>'+
        '<div class="fg"><label>De</label><input type="date" id="dv-fdi" value="'+esc(fDataIni)+'" onchange="document.getElementById(\'dv-fperiodo\').value=\'custom\';renderDistribTable()"/></div>'+
        '<div class="fg"><label>Até</label><input type="date" id="dv-fdf" value="'+esc(fDataFim)+'" onchange="document.getElementById(\'dv-fperiodo\').value=\'custom\';renderDistribTable()"/></div>'+
        '<div class="fg"><label>Advogado</label><select id="dv-fadv" onchange="renderDistribTable()"><option value="todos"'+(fAdv==='todos'?' selected':'')+'>Todos</option>'+S.lawyers.map(function(l){return'<option value="'+l.id+'"'+(fAdv===l.id?' selected':'')+'>'+l.name+'</option>';}).join('')+'</select></div>'+
      '</div>'+
      '<div class="g3" style="margin-top:10px">'+
        '<div class="fg"><label>Tipo</label><select id="dv-ftipo" onchange="renderDistribTable()"><option value="todos"'+(fTipo==='todos'?' selected':'')+'>Todos</option>'+TIPOS_DISTRIB.map(function(t){return'<option value="'+t.id+'"'+(fTipo===t.id?' selected':'')+'>'+t.label+'</option>';}).join('')+'</select></div>'+
        '<div class="fg"><label>Matéria</label><select id="dv-fmat" onchange="renderDistribTable()">'+matOpts+'</select></div>'+
        '<div class="fg"><label>Buscar</label><input type="text" id="dv-fbusca" value="'+esc(fBusca)+'" placeholder="Cliente, processo, observação..." oninput="renderDistribTable()"/></div>'+
      '</div>'+
    '</div>'+

    // RESUMO / KPIs
    '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin:18px 0 12px">'+
      '<div class="card" style="padding:14px;margin:0"><div style="font-size:11px;color:var(--mt);text-transform:uppercase;letter-spacing:.05em">Validações</div><div style="font-size:22px;font-weight:700;color:var(--v);margin-top:4px">'+qtdValidacoes+'</div></div>'+
      '<div class="card" style="padding:14px;margin:0"><div style="font-size:11px;color:var(--mt);text-transform:uppercase;letter-spacing:.05em">Lançamentos</div><div style="font-size:22px;font-weight:700;color:var(--tx);margin-top:4px">'+lista.length+'</div></div>'+
      '<div class="card" style="padding:14px;margin:0"><div style="font-size:11px;color:var(--mt);text-transform:uppercase;letter-spacing:.05em">Comissão filtrada</div><div style="font-size:22px;font-weight:700;color:var(--v);margin-top:4px">R$ '+totalLista.toFixed(2).replace('.',',')+'</div></div>'+
      '<div class="card" style="padding:14px;margin:0"><div style="font-size:11px;color:var(--mt);text-transform:uppercase;letter-spacing:.05em">Total geral</div><div style="font-size:22px;font-weight:700;color:var(--mt);margin-top:4px">R$ '+totalGeral.toFixed(2).replace('.',',')+'</div></div>'+
    '</div>'+

    // RANKING POR ADVOGADO
    '<div style="display:grid;grid-template-columns:1fr 2fr;gap:14px;align-items:flex-start">'+
      '<div class="card" style="margin:0">'+
        '<div style="font-size:12px;color:var(--mt);font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px">📊 Ranking por advogado</div>'+
        '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:13px">'+
          '<thead><tr style="background:var(--v);color:#fff"><th style="padding:8px 10px;text-align:left">Advogado</th><th style="padding:8px 10px;text-align:right">Validações</th><th style="padding:8px 10px;text-align:right">Comissão</th></tr></thead>'+
          '<tbody>'+rankAdvHtml+'</tbody>'+
        '</table></div>'+
      '</div>'+

      // TABELA PRINCIPAL
      '<div>'+
        '<div style="font-size:11px;font-weight:700;color:var(--mt);text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px">📋 Histórico detalhado</div>'+
        '<div style="overflow-x:auto;border-radius:8px;border:1px solid var(--bd)" id="dv-tbl-wrap">'+
          '<table style="width:100%;border-collapse:collapse;font-size:13px;background:var(--card)">'+
          '<thead><tr style="background:var(--v);color:#fff">'+
            '<th style="padding:10px;text-align:left">Data</th>'+
            '<th style="padding:10px;text-align:left">Cliente</th>'+
            '<th style="padding:10px;text-align:left">Nº Processo</th>'+
            '<th style="padding:10px;text-align:left">Matéria</th>'+
            '<th style="padding:10px;text-align:left">Validador</th>'+
            '<th style="padding:10px;text-align:left">Inseridor</th>'+
            '<th style="padding:10px;text-align:left">Carteira</th>'+
            '<th style="padding:10px;text-align:left">Tipo</th>'+
            '<th style="padding:10px;text-align:right">Comissão</th>'+
            '<th style="padding:10px;text-align:left">Obs.</th>'+
            '<th class="no-print"></th>'+
          '</tr></thead>'+
          '<tbody id="dv-tbody">'+(rows||'<tr><td colspan="11" style="text-align:center;padding:24px;color:var(--mt)">Nenhum registro encontrado.</td></tr>')+'</tbody>'+
        '</table></div>'+
      '</div>'+
    '</div>';
}

function dvPeriodoChange(){
  var v=document.getElementById('dv-fperiodo').value;
  if(v!=='custom' && v!=='todos'){
    // limpa as datas — serão recalculadas no render
    document.getElementById('dv-fdi').value='';
    document.getElementById('dv-fdf').value='';
  }
  renderDistribTable();
}

// Lê os tipos marcados no formulário
function dvTiposSelecionados(){
  var nodes=document.querySelectorAll('input[name="dv-tipo"]:checked');
  return Array.prototype.map.call(nodes,function(n){return n.value;});
}

// Atualiza preview de carteira E comissão
function dvAtualizaResumo(){
  var advId=document.getElementById('dv-adv').value;
  var insId=document.getElementById('dv-ins').value;
  var tipos=dvTiposSelecionados();
  var prev=document.getElementById('dv-prev');
  var lblC=document.getElementById('dv-prev-carteira');
  var lblV=document.getElementById('dv-prev-comissao');

  // destacar checkboxes marcados (cor conforme grupo)
  document.querySelectorAll('input[name="dv-tipo"]').forEach(function(n){
    var grupo=n.getAttribute('data-grupo');
    var cor=grupo==='precatorio'?'var(--dl)':'var(--vl)';
    var corBorda=grupo==='precatorio'?'var(--d)':'var(--v)';
    n.parentElement.style.background=n.checked?cor:'var(--card)';
    n.parentElement.style.borderColor=n.checked?corBorda:'var(--bd)';
  });

  if(!advId && !tipos.length){prev.style.display='none';return;}
  prev.style.display='block';

  var comprado=document.getElementById('dv-comprado')?document.getElementById('dv-comprado').checked:false;
  if(!comprado){
    lblC.innerHTML='<span style="color:var(--mt)">— não vai para carteira (Processo Comprado desmarcado)</span>';
  } else if(advId){
    var carteiraId=definirCarteira(advId,insId);
    var carteira=(S.lawyers.find(function(l){return l.id===carteiraId;})||{name:'?'}).name;
    var especial=carteiraId!==advId;
    lblC.innerHTML=esc(carteira)+(especial?' <span style="color:var(--d);font-weight:600">(inseridor PJ — processo fica com o inseridor)</span>':'');
  } else {
    lblC.textContent='— selecione um validador —';
  }

  var soma=tipos.reduce(function(s,id){var t=TIPOS_DISTRIB.find(function(x){return x.id===id;});return s+(t?t.val:0);},0);
  var detalhe=tipos.map(function(id){var t=TIPOS_DISTRIB.find(function(x){return x.id===id;});return t?t.label+' (R$'+t.val+')':'';}).filter(Boolean).join(' + ');
  lblV.innerHTML='<strong style="color:var(--v)">R$ '+soma.toFixed(2).replace('.',',')+'</strong>'+(detalhe?' <span style="color:var(--mt)">— '+detalhe+'</span>':'');
}

// Compatibilidade
function dvAtualizaCarteira(){dvAtualizaResumo();}

function renderDistribTable(){
  // re-renderiza preservando filtros
  var mc=document.getElementById('main-content');
  var fa=document.getElementById('dv-fadv').value;
  var ft=document.getElementById('dv-ftipo').value;
  var fb=document.getElementById('dv-fbusca').value;
  var fp=document.getElementById('dv-fperiodo').value;
  var fdi=document.getElementById('dv-fdi').value;
  var fdf=document.getElementById('dv-fdf').value;
  var fmat=document.getElementById('dv-fmat')?document.getElementById('dv-fmat').value:'todos';
  mc.innerHTML=pageDistrib();
  document.getElementById('dv-fadv').value=fa;
  document.getElementById('dv-ftipo').value=ft;
  document.getElementById('dv-fbusca').value=fb;
  document.getElementById('dv-fperiodo').value=fp;
  document.getElementById('dv-fdi').value=fdi;
  document.getElementById('dv-fdf').value=fdf;
  if(document.getElementById('dv-fmat'))document.getElementById('dv-fmat').value=fmat;
  var fbInp=document.getElementById('dv-fbusca');if(fbInp)fbInp.focus();
}

async function addDistrib(){
  var data=document.getElementById('dv-data').value;
  var cli=(document.getElementById('dv-cli').value||'').trim();
  var num=(document.getElementById('dv-num').value||'').trim();
  var cliAdv=(document.getElementById('dv-cliadv')?document.getElementById('dv-cliadv').value:'').trim();
  var adv=document.getElementById('dv-adv').value;
  var ins=document.getElementById('dv-ins').value;
  var mat=(document.getElementById('dv-mat').value||'').trim();
  var tipos=dvTiposSelecionados();
  var obs=(document.getElementById('dv-obs').value||'').trim();
  var processoComprado=document.getElementById('dv-comprado')?document.getElementById('dv-comprado').checked:false;
  var vCond=parseFloat((document.getElementById('dv-vcond')||{}).value)||0;
  var vComp=parseFloat((document.getElementById('dv-vcomp')||{}).value)||0;
  if(!data||!cli||!adv){alert('Preencha Data, Cliente e Validador.');return;}
  if(!tipos.length){alert('Marque ao menos um tipo de validação.');return;}

  var carteiraId=definirCarteira(adv,ins);
  var carteiraNome=(S.lawyers.find(function(l){return l.id===carteiraId;})||{name:''}).name;
  var grupoId=uid();

  var distribIds=[];
  var distribDocs=[];
  tipos.forEach(function(tipo){
    var distribId=fb.doc(fb.collection(fb.db,'validacoes')).id;
    distribIds.push(distribId);
    var rec={
      id:distribId,
      grupoId:grupoId,
      data:data,
      cliente:cli,
      clienteAdvogado:cliAdv,
      numero:num,
      materia:mat,
      advogadoId:adv,
      inseridorId:ins||null,
      carteiraId:carteiraId,
      tipo:tipo,
      obs:obs,
      processoComprado:processoComprado,
      valorCondenacao:vCond,
      valorCompra:vComp
    };
    distribDocs.push(rec);
    S.distribValidacao.push(rec);
  });
  // Persiste validacoes em batch no Firestore.
  try{
    var vbatch=fb.writeBatch(fb.db);
    distribDocs.forEach(function(d){
      vbatch.set(fb.doc(fb.db,'validacoes',d.id), Object.assign({},d,{createdBy:currentUser.id, createdAt:fb.serverTimestamp()}));
    });
    await vbatch.commit();
  }catch(err){ showToast('Erro ao salvar validacao: '+(err.code||err.message)); return; }

  // Cria/atualiza processo na carteira — somente se "Processo Comprado" estiver marcado
  if(processoComprado){
    var procExistente=null;
    if(num){
      var numLimpo=num.replace(/\D/g,'');
      if(numLimpo.length>5){
        procExistente=S.processos.find(function(p){return(p.numero||'').replace(/\D/g,'')===numLimpo;});
      }
    }
    var procPayload;
    if(procExistente){
      procExistente.advogadoId=carteiraId;
      if(mat && !procExistente.materia)procExistente.materia=mat;
      // Preenche valores só se ainda não houver (não sobrescreve dados existentes).
      if(vCond && !procExistente.valorCondenacao)procExistente.valorCondenacao=vCond;
      if(vComp && !procExistente.valorCompra)procExistente.valorCompra=vComp;
      if(cliAdv && !procExistente.clienteAdvogado)procExistente.clienteAdvogado=cliAdv;
      if(!procExistente.distribIds)procExistente.distribIds=[];
      procExistente.distribIds=procExistente.distribIds.concat(distribIds);
      procPayload=procExistente;
    } else {
      procPayload={
        numero:num||'(s/ número)',
        cliente:cli,
        clienteAdvogado:cliAdv,
        advogadoId:carteiraId,
        atendente:'',reu:'',materia:mat,foro:'',comarca:'',vara:'',estado:'',
        dataCompra:data,
        valorCondenacao:vCond,valorCliente:0,percCompra:0,valorCompra:vComp,
        status:'pendente',
        recebimentos:[],
        origem:'validacao_pbl',
        distribIds:distribIds
      };
    }
    try{
      await upsertProcesso(procPayload);
      S.processos=await fetchCollection('processos');
    }catch(err){ console.error('Erro upsertProcesso (validacao):', err); }
  }
  var soma=tipos.reduce(function(s,id){var t=TIPOS_DISTRIB.find(function(x){return x.id===id;});return s+(t?t.val:0);},0);
  showToast(processoComprado
    ? 'Validação registrada — R$'+soma.toFixed(2).replace('.',',')+' para '+carteiraNome+' ✓'
    : 'Validação registrada — R$'+soma.toFixed(2).replace('.',',')+' ✓');
  navigate('distrib');
}

async function delDistrib(id){
  if(!isFullAccess(currentUser)){showToast("Apenas o administrador pode excluir.");return;}
  if(!confirm('Excluir esta validação?'))return;
  try{
    await deleteDistribValidacao(id);
    S.distribValidacao=S.distribValidacao.filter(function(m){return m.id!==id;});
    var pendingUpdates=[];
    S.processos.forEach(function(p){
      if(p.distribIds && p.distribIds.indexOf(id)>=0){
        p.distribIds=p.distribIds.filter(function(x){return x!==id;});
        pendingUpdates.push(persistProcessoFields(p.id,{distribIds:p.distribIds}));
      }
    });
    await Promise.all(pendingUpdates.map(function(p){return p.catch(function(e){console.error(e);});}));
    navigate('distrib');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}

async function delDistribGrupo(grupoId){
  if(!isFullAccess(currentUser)){showToast("Apenas o administrador pode excluir.");return;}
  var registros=S.distribValidacao.filter(function(m){return(m.grupoId||m.id)===grupoId;});
  if(!registros.length){showToast('Validação não encontrada');return;}
  var idsParaRemover=registros.map(function(m){return m.id;});
  var msg='Excluir esta validação?';
  if(registros.length>1)msg+='\n\nIsso removerá '+registros.length+' lançamentos de comissão. ';
  msg+='\n\nObs: o processo na carteira NÃO será removido (pode ter recebimentos).';
  if(!confirm(msg))return;
  try{
    var batch=fb.writeBatch(fb.db);
    idsParaRemover.forEach(function(id){
      batch.delete(fb.doc(fb.db,'validacoes',id));
    });
    await batch.commit();
    S.distribValidacao=S.distribValidacao.filter(function(m){return idsParaRemover.indexOf(m.id)<0;});
    var pendingUpdates=[];
    S.processos.forEach(function(p){
      if(p.distribIds){
        var novo=p.distribIds.filter(function(x){return idsParaRemover.indexOf(x)<0;});
        if(novo.length!==p.distribIds.length){
          p.distribIds=novo;
          pendingUpdates.push(persistProcessoFields(p.id,{distribIds:novo}));
        }
      }
    });
    await Promise.all(pendingUpdates.map(function(p){return p.catch(function(e){console.error(e);});}));
    showToast('Validação excluída ✓');
    navigate('distrib');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}

// Editar validação (admin) — abre modal pré-preenchido com os dados do grupo
function editDistrib(grupoId){
  if(!isFullAccess(currentUser)){showToast('Apenas o administrador pode editar.');return;}
  var registros=S.distribValidacao.filter(function(m){return(m.grupoId||m.id)===grupoId;});
  if(!registros.length){showToast('Validação não encontrada');return;}
  var m=registros[0];
  var tiposAtuais=registros.map(function(r){return r.tipo;});
  var checks=TIPOS_DISTRIB.map(function(t){
    var ck=tiposAtuais.indexOf(t.id)>=0?' checked':'';
    return '<label style="display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--bd);border-radius:8px;cursor:pointer;font-size:13px">'+
      '<input type="checkbox" name="edv-tipo" value="'+t.id+'"'+ck+' style="width:16px;height:16px;accent-color:var(--v)"/>'+
      '<span style="flex:1"><strong>'+t.label+'</strong></span><span style="color:var(--v);font-weight:700;font-size:12px">R$ '+t.val+'</span></label>';
  }).join('');
  var compradoCk=m.processoComprado?' checked':'';
  showModal('<button class="modal-close" onclick="closeModal()">×</button><div class="modal-title">Editar Validação</div>'+
    '<div class="g2" style="margin-bottom:10px"><div class="fg"><label>Data *</label><input type="date" id="edv-data" value="'+(m.data||'')+'"/></div>'+
      '<div class="fg"><label>Cliente *</label><input type="text" id="edv-cli" value="'+esc(m.cliente)+'"/></div></div>'+
    '<div class="g2" style="margin-bottom:10px"><div class="fg"><label>Nº Processo</label><input type="text" id="edv-num" value="'+esc(m.numero)+'"/></div>'+
      '<div class="fg"><label>Cliente Advogado</label><input type="text" id="edv-cliadv" value="'+esc(m.clienteAdvogado||'')+'"/></div></div>'+
    '<div class="g2" style="margin-bottom:10px"><div class="fg"><label>Matéria</label><input type="text" id="edv-mat" value="'+esc(m.materia)+'"/></div><div class="fg"></div></div>'+
    '<div class="g2" style="margin-bottom:10px"><div class="fg"><label>Validador *</label><select id="edv-adv"><option value="">Selecione...</option>'+getAdvOpts(m.advogadoId)+'</select></div>'+
      '<div class="fg"><label>Inseridor</label><select id="edv-ins"><option value="">— sem inseridor —</option>'+getAdvOpts(m.inseridorId)+'</select></div></div>'+
    '<div style="margin-bottom:10px"><label style="font-size:12px;color:var(--mt)">Tipos de validação *</label><div style="display:flex;flex-direction:column;gap:6px;margin-top:6px">'+checks+'</div></div>'+
    '<label style="display:flex;align-items:center;gap:8px;margin-bottom:10px;padding:10px 12px;border:1px solid var(--bd);border-radius:8px;cursor:pointer;font-size:13px"><input type="checkbox" id="edv-comprado"'+compradoCk+' style="width:16px;height:16px;accent-color:var(--v)"/><span><strong>Processo Comprado</strong> <span style="color:var(--mt);font-weight:400;font-size:12px">— marque para manter/enviar o processo à carteira</span></span></label>'+
    '<div class="fg" style="margin-bottom:14px"><label>Observação</label><input type="text" id="edv-obs" value="'+esc(m.obs)+'"/></div>'+
    '<div style="display:flex;justify-content:flex-end;gap:10px"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="saveEditDistrib(\''+grupoId+'\')">Salvar</button></div>');
}

async function saveEditDistrib(grupoId){
  if(!isFullAccess(currentUser)){showToast('Apenas o administrador pode editar.');return;}
  var registros=S.distribValidacao.filter(function(m){return(m.grupoId||m.id)===grupoId;});
  if(!registros.length){showToast('Validação não encontrada');return;}
  var data=document.getElementById('edv-data').value;
  var cli=(document.getElementById('edv-cli').value||'').trim();
  var num=(document.getElementById('edv-num').value||'').trim();
  var cliAdv=(document.getElementById('edv-cliadv')?document.getElementById('edv-cliadv').value:'').trim();
  var mat=(document.getElementById('edv-mat').value||'').trim();
  var adv=document.getElementById('edv-adv').value;
  var ins=document.getElementById('edv-ins').value;
  var obs=(document.getElementById('edv-obs').value||'').trim();
  var comprado=document.getElementById('edv-comprado').checked;
  var tiposSel=Array.prototype.slice.call(document.querySelectorAll('input[name="edv-tipo"]:checked')).map(function(c){return c.value;});
  if(!data||!cli||!adv){alert('Preencha Data, Cliente e Validador.');return;}
  if(!tiposSel.length){alert('Marque ao menos um tipo de validação.');return;}

  var carteiraId=definirCarteira(adv,ins);
  var idsAntigos=registros.map(function(r){return r.id;});
  var procVinc=S.processos.find(function(p){return p.distribIds && p.distribIds.some(function(x){return idsAntigos.indexOf(x)>=0;});});

  // Edge: desmarcou "Processo Comprado" mas existe processo vinculado → pergunta
  var removerProc=false;
  if(!comprado && procVinc){
    removerProc=confirm('Esta validação tem um processo vinculado na carteira ("'+(procVinc.numero||'s/ número')+'").\n\nVocê desmarcou "Processo Comprado".\n\nOK = remover esse processo da carteira\nCancelar = manter o processo (apenas desvincula)');
  }

  var porTipo={}; registros.forEach(function(r){porTipo[r.tipo]=r;});
  var camposComuns={data:data,cliente:cli,clienteAdvogado:cliAdv,numero:num,materia:mat,advogadoId:adv,inseridorId:ins||null,carteiraId:carteiraId,obs:obs,processoComprado:comprado};
  var idsFinais=[];

  try{
    var batch=fb.writeBatch(fb.db);
    tiposSel.forEach(function(tid){
      if(porTipo[tid]){
        var id=porTipo[tid].id; idsFinais.push(id);
        batch.update(fb.doc(fb.db,'validacoes',id), Object.assign({},camposComuns,{tipo:tid,updatedAt:fb.serverTimestamp(),updatedBy:currentUser.id}));
      } else {
        var nid=fb.doc(fb.collection(fb.db,'validacoes')).id; idsFinais.push(nid);
        batch.set(fb.doc(fb.db,'validacoes',nid), Object.assign({},camposComuns,{id:nid,grupoId:grupoId,tipo:tid,createdAt:fb.serverTimestamp(),createdBy:currentUser.id}));
      }
    });
    registros.forEach(function(r){ if(tiposSel.indexOf(r.tipo)<0) batch.delete(fb.doc(fb.db,'validacoes',r.id)); });
    await batch.commit();
    S.distribValidacao=await fetchCollection('validacoes');

    // Carteira: atualiza junto
    if(comprado){
      if(procVinc){
        var novosDistrib=(procVinc.distribIds||[]).filter(function(x){return idsAntigos.indexOf(x)<0;}).concat(idsFinais);
        await persistProcessoFields(procVinc.id,{advogadoId:carteiraId,cliente:cli,clienteAdvogado:cliAdv||procVinc.clienteAdvogado||'',materia:mat||procVinc.materia||'',distribIds:novosDistrib});
      } else {
        await upsertProcesso({numero:num||'(s/ número)',cliente:cli,clienteAdvogado:cliAdv,advogadoId:carteiraId,atendente:'',reu:'',materia:mat,foro:'',comarca:'',vara:'',estado:'',dataCompra:data,valorCondenacao:0,valorCliente:0,percCompra:0,valorCompra:0,status:'pendente',recebimentos:[],origem:'validacao_pbl',distribIds:idsFinais});
      }
    } else if(procVinc){
      if(removerProc){
        await deleteProcesso(procVinc.id);
      } else {
        var limpos=(procVinc.distribIds||[]).filter(function(x){return idsAntigos.indexOf(x)<0;});
        await persistProcessoFields(procVinc.id,{distribIds:limpos});
      }
    }
    S.processos=await fetchCollection('processos');
    closeModal();
    showToast('Validação atualizada ✓');
    navigate('distrib');
  }catch(e){ showToast('Erro ao salvar: '+(e.code||e.message)); }
}

// Importa a planilha de validações (aba "Principal") → cria validações + processos.
// Colunas: Validador, CLIENTE, ADVOGADO, PROCESSO, Materia, VALOR, DATA, OBSERVAÇÕES.
// Materia == "Precatório" → tipos capa+auditoria; senão → proc_val+cont_val.
function importValidacoesXlsx(input){
  if(!isFullAccess(currentUser)){showToast('Apenas o administrador pode importar.');return;}
  if(!input.files||!input.files.length)return;
  var file=input.files[0]; input.value='';
  var reader=new FileReader();
  reader.onload=async function(e){
    try{
      var wb=XLSX.read(e.target.result,{type:'array',cellDates:true});
      var nome=wb.SheetNames.find(function(n){return String(n).trim().toLowerCase()==='principal';})||wb.SheetNames[0];
      var rows=XLSX.utils.sheet_to_json(wb.Sheets[nome],{defval:''});
      var TIPOS_COMUM=['proc_val','cont_val'], TIPOS_PREC=['capa','auditoria'];
      function matchLawyer(raw){
        var key=normAdv(raw); if(!key)return null;
        var fn=key.split(/\s+/)[0];
        return S.lawyers.find(function(l){ if(isPlaceholderLawyer(l))return false; var n=normAdv(l.name); return n===key||n.split(/\s+/)[0]===fn||n.indexOf(fn)===0; });
      }
      var validacaoDocs=[], procMap={}, skipped=0, advNoMatch=[];
      rows.forEach(function(r){
        var validRaw=String(getCol(r,['Validador','validador'])||'').trim();
        if(!validRaw){skipped++;return;}
        var lw=matchLawyer(validRaw);
        if(!lw){skipped++; if(advNoMatch.indexOf(validRaw)<0)advNoMatch.push(validRaw); return;}
        var cliente=String(getCol(r,['CLIENTE','Cliente'])||'').trim();
        var cliAdv=String(getCol(r,['ADVOGADO','Advogado'])||'').trim();
        var numero=String(getCol(r,['PROCESSO','Processo','Numero Processo','Número do Processo','Nº Processo','CNJ'])||'').trim();
        var materia=String(getCol(r,['Materia','Matéria'])||'').trim();
        var valor=parseValor(getCol(r,['VALOR','Valor'])||0)||0;
        var obs=String(getCol(r,['OBSERVAÇÕES','Observações','OBS'])||'').trim();
        var dv=getCol(r,['DATA','Data']); var dat='';
        if(dv){ try{ var d=(dv instanceof Date)?dv:new Date(String(dv)); if(d&&!isNaN(d.getTime())) dat=d.toISOString().slice(0,10);}catch(_e){} }
        if(!dat) dat=todayStr();
        var tipos = normAdv(materia)==='PRECATORIO' ? TIPOS_PREC : TIPOS_COMUM;
        var grupoId=uid(), distribIds=[];
        tipos.forEach(function(tp){
          var id=fb.doc(fb.collection(fb.db,'validacoes')).id;
          distribIds.push(id);
          validacaoDocs.push({id:id,grupoId:grupoId,data:dat,cliente:cliente,clienteAdvogado:cliAdv,numero:numero,materia:materia,advogadoId:lw.id,inseridorId:null,carteiraId:lw.id,tipo:tp,obs:obs,processoComprado:true,valorCompra:valor,valorCondenacao:0,importado:true});
        });
        var numLimpo=numero.replace(/\D/g,'');
        var key = numLimpo.length>5 ? ('n'+numLimpo) : ('g'+grupoId);
        if(!procMap[key]){
          var ex = numLimpo.length>5 ? S.processos.find(function(p){return (p.numero||'').replace(/\D/g,'')===numLimpo;}) : null;
          procMap[key] = ex
            ? {id:ex.id,numero:ex.numero,cliente:cliente||ex.cliente,clienteAdvogado:cliAdv||ex.clienteAdvogado,advogadoId:lw.id,materia:materia||ex.materia,valorCompra:valor||ex.valorCompra,valor:ex.valor,mes:ex.mes,status:ex.status||'pendente',recebimentos:ex.recebimentos||[],createdAt:ex.createdAt,distribIds:(ex.distribIds||[]).slice(),origem:ex.origem||'validacao_pbl',dataCompra:ex.dataCompra||dat}
            : {numero:numero||'(s/ número)',cliente:cliente,clienteAdvogado:cliAdv,advogadoId:lw.id,atendente:'',reu:'',materia:materia,foro:'',comarca:'',vara:'',estado:'',dataCompra:dat,valorCondenacao:0,valorCliente:0,percCompra:0,valorCompra:valor,status:'pendente',recebimentos:[],origem:'validacao_pbl',distribIds:[]};
        }
        procMap[key].distribIds=(procMap[key].distribIds||[]).concat(distribIds);
      });
      if(!validacaoDocs.length){ alert('Nenhuma linha válida com Validador reconhecido.'+(advNoMatch.length?'\n\nValidadores não encontrados: '+advNoMatch.slice(0,10).join(', '):'')); return; }
      var procs=Object.keys(procMap).map(function(k){return procMap[k];});
      if(!confirm('Importar '+validacaoDocs.length+' validações e '+procs.length+' processo(s)?'+(skipped?'\n\n'+skipped+' linha(s) puladas.':'')+(advNoMatch.length?'\n\n⚠️ Validadores não encontrados (serão pulados): '+advNoMatch.slice(0,8).join(', '):''))) return;
      var BATCH=400, batch=fb.writeBatch(fb.db), n=0;
      for(var i=0;i<validacaoDocs.length;i++){
        batch.set(fb.doc(fb.db,'validacoes',validacaoDocs[i].id), Object.assign({},validacaoDocs[i],{createdBy:currentUser.id,createdAt:fb.serverTimestamp()}));
        n++; if(n%BATCH===0){await batch.commit();batch=fb.writeBatch(fb.db);}
      }
      if(n%BATCH!==0) await batch.commit();
      for(var j=0;j<procs.length;j++){ try{ await upsertProcesso(procs[j]); }catch(pe){ console.error('import processo:',pe); } }
      S.distribValidacao=await fetchCollection('validacoes');
      S.processos=await fetchCollection('processos');
      navigate('distrib');
      alert(validacaoDocs.length+' validações importadas ('+procs.length+' processos).'+(skipped?'\n'+skipped+' linhas puladas.':'')+(advNoMatch.length?'\nValidadores não encontrados: '+advNoMatch.slice(0,8).join(', '):''));
    }catch(err){ alert('Erro no import: '+(err.code||err.message)); }
  };
  reader.readAsArrayBuffer(file);
}

function exportDistribXlsx(){
  // Exporta a lista filtrada visível como Excel
  var fAdv=document.getElementById('dv-fadv').value;
  var fTipo=document.getElementById('dv-ftipo').value;
  var fBusca=(document.getElementById('dv-fbusca').value||'').toLowerCase();
  var fPeriodo=document.getElementById('dv-fperiodo').value;
  var fDataIni=document.getElementById('dv-fdi').value;
  var fDataFim=document.getElementById('dv-fdf').value;
  var fMateria=document.getElementById('dv-fmat')?document.getElementById('dv-fmat').value:'todos';

  var hoje=new Date();hoje.setHours(0,0,0,0);
  var hojeStr=hoje.toISOString().slice(0,10);
  var di=fDataIni,df=fDataFim;
  if(fPeriodo==='hoje'){di=hojeStr;df=hojeStr;}
  else if(fPeriodo==='semana'){var d7=new Date(hoje);d7.setDate(hoje.getDate()-6);di=d7.toISOString().slice(0,10);df=hojeStr;}
  else if(fPeriodo==='mes'){var dm=new Date(hoje.getFullYear(),hoje.getMonth(),1);di=dm.toISOString().slice(0,10);df=hojeStr;}
  else if(fPeriodo==='mes_anterior'){var dma1=new Date(hoje.getFullYear(),hoje.getMonth()-1,1);var dma2=new Date(hoje.getFullYear(),hoje.getMonth(),0);di=dma1.toISOString().slice(0,10);df=dma2.toISOString().slice(0,10);}

  var gruposTipo={};
  if(fTipo!=='todos'){S.distribValidacao.forEach(function(m){if(m.tipo===fTipo)gruposTipo[m.grupoId||m.id]=true;});}

  var lista=S.distribValidacao.filter(function(m){
    if(fAdv!=='todos' && m.advogadoId!==fAdv && m.inseridorId!==fAdv)return false;
    if(fTipo!=='todos' && !gruposTipo[m.grupoId||m.id])return false;
    if(fMateria!=='todos' && (m.materia||'')!==fMateria)return false;
    if(di && (m.data||'')<di)return false;
    if(df && (m.data||'')>df)return false;
    if(fBusca){var hay=((m.cliente||'')+' '+(m.numero||'')+' '+(m.obs||'')+' '+(m.materia||'')).toLowerCase();if(hay.indexOf(fBusca)<0)return false;}
    return true;
  }).sort(function(a,b){return(b.data||'').localeCompare(a.data||'');});

  // Agrupar por grupoId
  var gruposMap={};var ordem=[];
  lista.forEach(function(m){
    var k=m.grupoId||m.id;
    if(!gruposMap[k]){gruposMap[k]={primeiro:m,tipos:[],totalVal:0};ordem.push(k);}
    var t=TIPOS_DISTRIB.find(function(x){return x.id===m.tipo;});
    if(t){gruposMap[k].tipos.push(t.label);gruposMap[k].totalVal+=t.val;}
  });

  var dados=ordem.map(function(k){
    var g=gruposMap[k];var m=g.primeiro;
    var validador=(S.lawyers.find(function(l){return l.id===m.advogadoId;})||{name:'---'}).name;
    var inseridor=m.inseridorId?(S.lawyers.find(function(l){return l.id===m.inseridorId;})||{name:'---'}).name:'';
    var carteiraId=definirCarteira(m.advogadoId,m.inseridorId);
    var carteira=(S.lawyers.find(function(l){return l.id===carteiraId;})||{name:'---'}).name;
    return{
      'Data':fmtDate(m.data),
      'Cliente':m.cliente||'',
      'Nº Processo':m.numero||'',
      'Matéria':m.materia||'',
      'Validador':validador,
      'Inseridor':inseridor,
      'Carteira':carteira,
      'Tipos':g.tipos.join(' + '),
      'Comissão (R$)':g.totalVal,
      'Observação':m.obs||''
    };
  });

  if(!dados.length){alert('Nenhum registro para exportar com os filtros atuais.');return;}

  var ws=XLSX.utils.json_to_sheet(dados);
  var wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'Validações PBL');

  // Resumo por advogado
  var porAdv={};
  ordem.forEach(function(k){
    var g=gruposMap[k];var m=g.primeiro;
    var nome=(S.lawyers.find(function(l){return l.id===m.advogadoId;})||{name:'---'}).name;
    if(!porAdv[nome])porAdv[nome]={qtd:0,com:0};
    porAdv[nome].qtd++;porAdv[nome].com+=g.totalVal;
  });
  var resumo=Object.keys(porAdv).sort(function(a,b){return porAdv[b].qtd-porAdv[a].qtd;}).map(function(n){
    return{'Advogado':n,'Qtd Validações':porAdv[n].qtd,'Comissão Total (R$)':porAdv[n].com};
  });
  if(resumo.length){
    var ws2=XLSX.utils.json_to_sheet(resumo);
    XLSX.utils.book_append_sheet(wb,ws2,'Resumo por Advogado');
  }

  var nome='validacoes_pbl_'+new Date().toISOString().slice(0,10)+'.xlsx';
  XLSX.writeFile(wb,nome);
  showToast('Exportado: '+nome);
}

// ════════════════════════════════════════════════════════════
// RELATÓRIO DE LIQUIDADOS (gerencial — admin/gestora) — volume por advogado, metas, ranking
// ════════════════════════════════════════════════════════════
var _relMetas={}; // mesRef -> {metaInd,obj1,obj2,diasMes,diasTrab} | 'loading'
function relMetasDefault(){ return {metaInd:500000,obj1:1800000,obj2:2300000,diasMes:22,diasTrab:1}; }
function relMesRef(){ var el=document.getElementById('periodo-mes'); return (el&&el.value)||S.mes||new Date().toISOString().slice(0,7); }
function relPct(v){ return (Number(v)||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'%'; }
function relMesLabel(mes){ try{ var d=new Date(mes+'-02'); return d.toLocaleDateString('pt-BR',{month:'long',year:'numeric'}).toUpperCase(); }catch(e){ return mes; } }
async function afterRelLiqDiario(){
  var mes=relMesRef();
  if(_relMetas[mes]!==undefined) return; // já carregado (evita loop)
  _relMetas[mes]='loading';
  try{ var d=await fb.getDoc(fb.doc(fb.db,'relatorioMetas',mes)); _relMetas[mes]= d.exists()? Object.assign(relMetasDefault(), d.data()) : relMetasDefault(); }
  catch(e){ _relMetas[mes]=relMetasDefault(); }
  if(currentPage==='relliqdiario') navigate('relliqdiario');
}
async function salvarRelMetas(){
  if(!(isFullAccess(currentUser)||isGestora(currentUser))){ showToast('Sem permissão.'); return; }
  var mes=relMesRef();
  var g=function(id){ return parseFloat((document.getElementById(id)||{}).value)||0; };
  var cfg={ metaInd:g('rl-metaInd'), obj1:g('rl-obj1'), obj2:g('rl-obj2'), diasMes:Math.max(1,g('rl-diasMes')||1), diasTrab:Math.max(1,g('rl-diasTrab')||1) };
  _relMetas[mes]=cfg;
  try{ await fb.setDoc(fb.doc(fb.db,'relatorioMetas',mes), Object.assign({},cfg,{mes:mes,updatedAt:fb.serverTimestamp(),updatedBy:currentUser.id}), {merge:true}); showToast('Configuração salva ✓'); }
  catch(e){ showToast('Erro ao salvar: '+(e.code||e.message)); }
  navigate('relliqdiario');
}
function toggleRelCfg(){ var c=document.getElementById('rl-cfg'); if(c) c.style.display=(c.style.display==='none'?'block':'none'); }
function pageRelLiqDiario(){
  if(!(isFullAccess(currentUser)||isGestora(currentUser))) return '<div class="page-title">'+I.reliq+' Relatório de Liquidados</div><div class="card"><div class="empty">Acesso restrito a administradores e gestores.</div></div>';
  var mes=relMesRef();
  var cfg=_relMetas[mes];
  if(cfg===undefined||cfg==='loading') return '<div class="page-title">'+I.reliq+' Relatório de Liquidados</div><div class="card"><div class="empty">Carregando…</div></div>';
  var metaInd=cfg.metaInd||0, obj1=cfg.obj1||0, obj2=cfg.obj2||0, diasMes=Math.max(1,cfg.diasMes||1), diasTrab=Math.max(1,cfg.diasTrab||1), diasRest=Math.max(diasMes-diasTrab,0);
  // Volume por advogado (soma valor das liquidações do mês). Placeholder/desconhecido -> pendente.
  var lawyers=lawyersComissao();
  var vol={}; lawyers.forEach(function(l){ vol[l.id]=0; });
  var pendente=0;
  (S.liqManual||[]).forEach(function(m){ if(String(m.data||'').slice(0,7)!==mes) return; var v=Number(m.valor)||0; if(vol[m.advogadoId]!=null) vol[m.advogadoId]+=v; else pendente+=v; });
  var advs=lawyers.map(function(l){ return {nome:l.name, volume:vol[l.id]}; }).filter(function(a){ return a.volume>0; });
  var totalVol=advs.reduce(function(s,a){return s+a.volume;},0)+pendente;
  var totMedia=totalVol/diasTrab, totProj=totMedia*diasMes;

  // Config panel
  var cfgHtml='<div class="card no-print" id="rl-cfg" style="display:none">'+
    '<div style="font-weight:700;color:var(--v);margin-bottom:10px;font-size:13px">Configuração do período ('+relMesLabel(mes)+')</div>'+
    '<div style="display:flex;gap:14px;flex-wrap:wrap;align-items:flex-end">'+
      '<div class="fg" style="margin:0"><label>Meta individual (R$)</label><input id="rl-metaInd" type="number" step="1000" value="'+metaInd+'"/></div>'+
      '<div class="fg" style="margin:0"><label>1º Objetivo (R$)</label><input id="rl-obj1" type="number" step="10000" value="'+obj1+'"/></div>'+
      '<div class="fg" style="margin:0"><label>Objetivo Coletivo (R$)</label><input id="rl-obj2" type="number" step="10000" value="'+obj2+'"/></div>'+
      '<div class="fg" style="margin:0;max-width:130px"><label>Dias úteis do mês</label><input id="rl-diasMes" type="number" step="1" value="'+diasMes+'"/></div>'+
      '<div class="fg" style="margin:0;max-width:130px"><label>Dias trabalhados</label><input id="rl-diasTrab" type="number" step="1" value="'+diasTrab+'"/></div>'+
      '<button class="btn bp" style="font-size:12px" onclick="salvarRelMetas()">💾 Salvar</button>'+
    '</div>'+
    '<div style="font-size:11px;color:var(--mt);margin-top:8px">Dias úteis e metas são informados manualmente e salvos por mês. O volume vem das liquidações lançadas no mês.</div>'+
  '</div>';

  var head='<div class="page-title">'+I.reliq+' Relatório de Liquidados — <span style="color:var(--d)">'+relMesLabel(mes)+'</span>'+
    '<button class="btn no-print" style="margin-left:auto;font-size:12px" onclick="toggleRelCfg()">⚙ Configurar metas / dias</button>'+
    '<button class="btn no-print" style="margin-left:8px;font-size:12px" onclick="exportRelLiqPng()">🖼️ Exportar PNG</button>'+
    '<button class="btn bp no-print" style="margin-left:8px;font-size:12px" onclick="window.print()">🖨️ Imprimir / PDF</button>'+
  '</div>'+
  '<div class="sub" style="font-size:12px;color:var(--mt);margin-bottom:14px">Volume liquidado por advogado no mês (segue o seletor de período). Apenas advogados com volume no mês aparecem.</div>';

  if(!advs.length && pendente===0) return head+cfgHtml+'<div class="card"><div class="empty">Nenhuma liquidação lançada em '+relMesLabel(mes)+'.</div></div>';

  var TH='style="background:var(--vl);color:var(--v);padding:7px 9px;font-size:11px;border:1px solid var(--bd);text-align:right"';
  var THL='style="background:var(--vl);color:var(--v);padding:7px 9px;font-size:11px;border:1px solid var(--bd);text-align:left"';
  var TD='style="padding:7px 9px;font-size:12px;border:1px solid var(--bd);text-align:right"';
  var TDL='style="padding:7px 9px;font-size:12px;border:1px solid var(--bd);text-align:left;font-weight:600;background:var(--row-alt)"';
  var TDT='style="padding:7px 9px;font-size:12px;border:1px solid var(--bd);text-align:right;font-weight:700;background:var(--vl);color:var(--v)"';

  // Tabela principal
  function linha(label, fn, tot){
    return '<tr><td '+TDL+'>'+label+'</td>'+advs.map(function(a){return '<td '+TD+'>'+fn(a)+'</td>';}).join('')+'<td '+TD+'>'+(label.indexOf('VOLUME')>=0?fmt(pendente).slice(3):'')+'</td><td '+TDT+'>'+tot+'</td></tr>';
  }
  var principal='<div class="card" style="padding:0;overflow-x:auto"><table style="width:100%;border-collapse:collapse"><thead><tr>'+
    '<th '+THL+' style="min-width:190px"></th>'+advs.map(function(a){return '<th '+TH+'>'+esc(a.nome)+'</th>';}).join('')+'<th '+TH+'>PENDENTE</th><th '+TH+'>TOTAL</th></tr></thead><tbody>'+
    linha('VOLUME DE LIQUIDADOS (R$)', function(a){return fmt(a.volume).slice(3);}, fmt(totalVol).slice(3))+
    linha('MÉDIA DE LIQUIDADOS (R$)', function(a){return fmt(a.volume/diasTrab).slice(3);}, fmt(totMedia).slice(3))+
    linha('PROJEÇÃO DE LIQUIDADOS (R$)', function(a){return fmt((a.volume/diasTrab)*diasMes).slice(3);}, fmt(totProj).slice(3))+
    '</tbody></table></div>';

  // Ranking
  var rank=advs.slice().sort(function(a,b){return b.volume-a.volume;});
  var rkRows=rank.map(function(a){
    var part=totalVol?(a.volume/totalVol*100):0, atg=metaInd?(a.volume/metaInd*100):0, falta=Math.max(metaInd-a.volume,0);
    return '<tr><td '+TDL+'>'+esc(a.nome)+'</td><td '+TD+'>'+fmt(a.volume).slice(3)+'</td><td '+TD+'>'+relPct(part)+'</td><td '+TD+'>'+relPct(atg)+'</td><td '+TD+'>'+fmt(falta).slice(3)+'</td></tr>';
  }).join('');
  if(pendente>0) rkRows+='<tr><td '+TDL+'>PENDENTE DE IDENTIFICAÇÃO</td><td '+TD+'>'+fmt(pendente).slice(3)+'</td><td '+TD+'>'+relPct(totalVol?pendente/totalVol*100:0)+'</td><td '+TD+'>—</td><td '+TD+'>—</td></tr>';
  var ranking='<div class="card" style="padding:0;overflow-x:auto"><table style="width:100%;border-collapse:collapse"><thead>'+
    '<tr><th '+TH+' colspan="5" style="text-align:center">Ranking por Volume · Objetivo individual R$ '+fmt(metaInd).slice(3)+'</th></tr>'+
    '<tr><th '+THL+'>Nome</th><th '+TH+'>Volume (R$)</th><th '+TH+'>Part. %</th><th '+TH+'>% Objetivo</th><th '+TH+'>Falta p/ Objetivo</th></tr></thead><tbody>'+rkRows+'</tbody></table></div>';

  // Dias úteis
  var pctTrab=diasMes?diasTrab/diasMes*100:0;
  var dias='<div class="card" style="padding:0;overflow-x:auto"><table style="width:100%;border-collapse:collapse"><thead>'+
    '<tr><th '+TH+' style="text-align:center">Dias úteis do mês</th><th '+TH+' style="text-align:center">Trabalhados</th><th '+TH+' style="text-align:center">Restantes</th></tr></thead><tbody>'+
    '<tr><td '+TD+' style="text-align:center">'+diasMes+'</td><td '+TD+' style="text-align:center">'+diasTrab+'</td><td '+TD+' style="text-align:center">'+diasRest+'</td></tr>'+
    '<tr><th '+TH+' style="text-align:center">% Trabalhado</th><th '+TH+' colspan="2" style="text-align:center">% Restante</th></tr>'+
    '<tr><td '+TD+' style="text-align:center">'+Math.round(pctTrab)+'%</td><td '+TD+' colspan="2" style="text-align:center">'+Math.round(100-pctTrab)+'%</td></tr>'+
    '</tbody></table></div>';

  // Objetivos
  function objTable(titulo, objetivo){
    var rest=objetivo-totalVol, mediaDia=totalVol/diasTrab, ritmo=diasRest?rest/diasRest:0;
    return '<div class="card" style="padding:0;overflow-x:auto"><table style="width:100%;border-collapse:collapse"><thead><tr><th '+TH+' colspan="2" style="text-align:center">'+titulo+'</th></tr></thead><tbody>'+
      '<tr><td '+TDL+'>Objetivo do Período</td><td '+TD+'>'+fmt(objetivo)+'</td></tr>'+
      '<tr><td '+TDL+'>Volume Realizado</td><td '+TD+'>'+fmt(totalVol)+'</td></tr>'+
      '<tr><td '+TDL+'>Volume Restante</td><td '+TD+'>'+fmt(rest)+'</td></tr>'+
      '<tr><td '+TDL+'>Média / dia Realizada</td><td '+TD+'>'+fmt(mediaDia)+'</td></tr>'+
      '<tr><td '+TDL+'>Ritmo Necessário / dia</td><td '+TD+'>'+fmt(ritmo)+'</td></tr>'+
      '</tbody></table></div>';
  }
  var objetivos='<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">'+objTable('1º Objetivo',obj1)+objTable('Objetivo Coletivo',obj2)+'</div>';

  // Título só aparece na imagem exportada (PNG) — oculto na tela.
  var reportTitle='<div id="rl-report-title" style="display:none;padding:6px 4px 16px;font-weight:800;font-size:17px;color:var(--v)">Relatório de Liquidados — '+relMesLabel(mes)+'</div>';
  var report='<div id="rl-report" style="background:var(--bg);padding:4px">'+reportTitle+principal+'<div style="height:14px"></div>'+ranking+'<div style="height:14px"></div>'+dias+'<div style="height:14px"></div>'+objetivos+'</div>';

  return head+cfgHtml+report;
}

// Exporta o Relatório de Liquidados inteiro como imagem PNG (inclui os quadros de Objetivos,
// que ficavam cortados na paginação do Imprimir/PDF).
async function exportRelLiqPng(){
  var el=document.getElementById('rl-report');
  if(!el){ showToast('Nada para exportar.'); return; }
  if(typeof html2canvas==='undefined'){ showToast('Biblioteca de imagem não carregou. Recarregue a página.'); return; }
  var titleEl=document.getElementById('rl-report-title');
  if(titleEl) titleEl.style.display='block';
  showToast('Gerando imagem…');
  try{
    var bg=getComputedStyle(document.body).backgroundColor||'#ffffff';
    var canvas=await html2canvas(el,{ backgroundColor:bg, scale:2, useCORS:true, logging:false,
      windowWidth:el.scrollWidth, windowHeight:el.scrollHeight });
    var link=document.createElement('a');
    link.download='relatorio-liquidados-'+relMesRef()+'.png';
    link.href=canvas.toDataURL('image/png');
    link.click();
    showToast('Imagem exportada ✓');
  }catch(e){ console.error('exportRelLiqPng:',e); showToast('Falha ao gerar a imagem.'); }
  finally{ if(titleEl) titleEl.style.display='none'; }
}

// Aba "Processos Liquidados" — exporta liquidações do sistema por período + origem (titularidade)
var ORIGENS_LIQ=['FIDC PBL','PBL Originadora','CERTJUD'];
function pageRelLiq2(){
  var checks=ORIGENS_LIQ.map(function(o){
    return '<label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">'+
      '<input type="checkbox" class="rl2-orig" value="'+esc(o)+'" checked style="width:15px;height:15px;accent-color:var(--v)"/>'+esc(o)+'</label>';
  }).join('');
  return'<div class="pg-title">Processos Liquidados</div>'+
    '<div class="card" style="margin-bottom:14px">'+
      '<div style="display:flex;gap:14px;flex-wrap:wrap;align-items:flex-end">'+
        '<div class="fg" style="margin:0"><label>Data início</label><input type="date" id="rl2-di"/></div>'+
        '<div class="fg" style="margin:0"><label>Data fim</label><input type="date" id="rl2-df"/></div>'+
        '<div class="fg" style="margin:0"><label>Origens</label><div style="display:flex;gap:16px;flex-wrap:wrap;padding-top:6px">'+checks+'</div></div>'+
        '<button class="btn bp" onclick="renderRelLiq2()">Gerar</button>'+
      '</div>'+
    '</div>'+
    '<div id="rl2-out"><div class="empty">Selecione o período e as origens, depois clique em Gerar.</div></div>';
}
function rl2OrigensSelecionadas(){
  return Array.prototype.slice.call(document.querySelectorAll('.rl2-orig:checked')).map(function(c){return c.value;});
}
function rl2Filtrar(){
  var di=document.getElementById('rl2-di').value, df=document.getElementById('rl2-df').value;
  var origs=rl2OrigensSelecionadas();
  return (S.liqManual||[]).filter(function(m){
    if(origs.indexOf(m.titularidade)<0) return false;
    var d=String(m.data||'').slice(0,10);
    if(di && d<di) return false;
    if(df && d>df) return false;
    return true;
  }).sort(function(a,b){return String(b.data||'').localeCompare(String(a.data||''));});
}
function rl2AdvNome(id){return (S.lawyers.find(function(l){return l.id===id;})||{name:'—'}).name;}
function renderRelLiq2(){
  var f=rl2Filtrar();
  var out=document.getElementById('rl2-out');
  if(!f.length){out.innerHTML='<div class="empty">Nenhuma liquidação encontrada para o período/origens selecionados.</div>';return;}
  var tot=f.reduce(function(s,m){return s+(m.valor||0);},0);
  var totT=f.filter(function(m){return m.liquidacao!=='Parcial';}).reduce(function(s,m){return s+(m.valor||0);},0);
  var totP=f.filter(function(m){return m.liquidacao==='Parcial';}).reduce(function(s,m){return s+(m.valor||0);},0);
  out.innerHTML=
    '<div style="display:flex;justify-content:flex-end;margin-bottom:10px"><button class="btn no-print" style="font-size:12px" onclick="exportRelLiq2()" title="Exportar para Excel">📥 Exportar Excel</button></div>'+
    '<div class="metrics" style="margin-bottom:16px"><div class="mc"><div class="ml">Liquidações</div><div class="mv">'+f.length+'</div></div>'+
      '<div class="mc gold"><div class="ml">Valor total</div><div class="mv gold">'+fmt(tot)+'</div></div>'+
      '<div class="mc blue"><div class="ml">Total</div><div class="mv blue">'+fmt(totT)+'</div></div>'+
      '<div class="mc"><div class="ml">Parcial</div><div class="mv">'+fmt(totP)+'</div></div></div>'+
    '<div style="overflow-x:auto;border-radius:8px;border:1px solid var(--bd)"><table style="width:100%;border-collapse:collapse;font-size:13px"><thead><tr style="background:var(--v);color:#fff">'+
      '<th style="padding:9px">Data</th><th style="padding:9px">Origem</th><th style="padding:9px">Processo</th><th style="padding:9px">Advogado</th><th style="padding:9px">Tipo</th><th style="padding:9px;text-align:right">Valor</th></tr></thead><tbody>'+
    f.map(function(m,i){var bg=i%2===0?'':'background:var(--row-alt)';
      return'<tr style="'+bg+'"><td style="padding:8px">'+fmtDate(m.data)+'</td><td style="padding:8px">'+esc(m.titularidade||'—')+'</td>'+
        '<td style="padding:8px;font-size:11px">'+esc(m.processo||'—')+'</td><td style="padding:8px">'+esc(rl2AdvNome(m.advogadoId))+'</td>'+
        '<td style="padding:8px">'+esc(m.liquidacao||'Total')+'</td><td style="padding:8px;text-align:right">'+fmt(m.valor||0)+'</td></tr>';
    }).join('')+
    '</tbody></table></div>';
}
function exportRelLiq2(){
  var f=rl2Filtrar();
  if(!f.length){showToast('Nada para exportar.');return;}
  var dados=f.map(function(m){return {
    'Data':m.data||'',
    'Origem':m.titularidade||'',
    'Processo':m.processo||'',
    'Advogado':rl2AdvNome(m.advogadoId),
    'Tipo':m.liquidacao||'Total',
    'Valor':m.valor||0
  };});
  var ws=XLSX.utils.json_to_sheet(dados);
  var wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'Liquidados');
  var di=document.getElementById('rl2-di').value, df=document.getElementById('rl2-df').value;
  var sufixo=(di||df)?('_'+(di||'inicio')+'_a_'+(df||'fim')):'';
  var nome='processos_liquidados'+sufixo+'.xlsx';
  XLSX.writeFile(wb,nome);
  showToast('Exportado: '+nome);
}

var relCompData=null;
function pageRelComp(){
  var st=relCompData?relCompData.length+' processos':'Nenhum arquivo';
  return'<div class="pg-title">Processos Comprados</div>'+
    '<div class="card" style="margin-bottom:14px"><label class="imp" for="f-rc"><input type="file" id="f-rc" class="fhide" accept=".xlsx,.xls" onchange="impRelComp(this)"/>'+
    '<div class="imp-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zM8 17l-3-3 1.4-1.4 1.6 1.6 3.6-3.6L13 11l-5 6z"/></svg></div>'+
    '<div class="imp-text"><div class="imp-title">Importar planilha</div><div class="imp-sub">Cliente / Processo / Data / Vl. Cliente / Valor de Compra / Prev. Ganho / Deságio%</div></div>'+
    '<span class="imp-status" id="rc-st">'+st+'</span></label></div>'+
    '<div style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap"><input id="rc-q" placeholder="Buscar..." style="padding:7px 10px;border:1px solid #ccc;border-radius:6px;flex:1;min-width:150px"/><input type="date" id="rc-di" style="padding:7px;border:1px solid #ccc;border-radius:6px"/><input type="date" id="rc-df" style="padding:7px;border:1px solid #ccc;border-radius:6px"/><button class="btn bp" onclick="renderRelComp()">Gerar</button></div>'+
    '<div id="rc-out"><div class="empty">Importe a planilha e clique em Gerar.</div></div>';
}
function impRelComp(input){
  if(!input.files.length)return;
  readXlsx(input.files[0],function(rows){
    relCompData=rows.filter(function(r){return String(getCol(r,['Cliente','cliente'])||'').trim();}).map(function(r){
      var dv=getCol(r,['Data','data']);var ds='';
      if(dv){try{var d=new Date(String(dv));if(!isNaN(d))ds=d.toISOString().slice(0,10);}catch(e){}}
      return{cliente:String(getCol(r,['Cliente','cliente'])||'').trim(),proc:String(getCol(r,['Processo','processo'])||'').trim(),data:ds,
        vlCli:parseValor(getCol(r,['Valor Cliente','valor cliente'])||0),
        vlComp:parseValor(getCol(r,['Valor Compra','valor compra'])||0),
        prevG:parseValor(getCol(r,['Prev. Ganho','prev ganho'])||0),
        des:parseValor(getCol(r,['Desagio','Deságio','desagio'])||0)};
    });
    var el=document.getElementById('rc-st');if(el)el.textContent=relCompData.length+' processos';
    showToast(relCompData.length+' importados!');input.value='';
  });
}
function renderRelComp(){
  if(!relCompData||!relCompData.length){document.getElementById('rc-out').innerHTML='<div class="empty">Importe primeiro.</div>';return;}
  var q=(document.getElementById('rc-q').value||'').toLowerCase();
  var di=document.getElementById('rc-di').value,df=document.getElementById('rc-df').value;
  var f=relCompData.filter(function(r){return(!q||(r.cliente||'').toLowerCase().includes(q))&&(!di||r.data>=di)&&(!df||r.data<=df);});
  var tCli=f.reduce(function(s,r){return s+r.vlCli;},0),tC=f.reduce(function(s,r){return s+r.vlComp;},0),tG=f.reduce(function(s,r){return s+r.prevG;},0);
  document.getElementById('rc-out').innerHTML=
    '<div class="metrics" style="margin-bottom:16px"><div class="mc"><div class="ml">Processos</div><div class="mv">'+f.length+'</div></div><div class="mc gold"><div class="ml">Vl. Cliente</div><div class="mv gold">'+fmt(tCli)+'</div></div><div class="mc blue"><div class="ml">Valor de Compra</div><div class="mv blue">'+fmt(tC)+'</div></div><div class="mc green"><div class="ml">Prev. Ganho</div><div class="mv green">'+fmt(tG)+'</div></div></div>'+
    '<div style="overflow-x:auto;border-radius:8px;border:1px solid #ddd"><table style="width:100%;border-collapse:collapse;font-size:13px"><thead><tr style="background:var(--v);color:#fff"><th style="padding:9px">Cliente</th><th style="padding:9px">Processo</th><th style="padding:9px">Data</th><th style="padding:9px;text-align:right">Vl.Cliente</th><th style="padding:9px;text-align:right">Vl.Compra</th><th style="padding:9px;text-align:right">Prev.Ganho</th><th style="padding:9px;text-align:right">Deságio%</th></tr></thead><tbody>'+
    f.map(function(r,i){var bg=i%2===0?'':'background:var(--row-alt)';return'<tr style="'+bg+'"><td style="padding:8px">'+esc(r.cliente)+'</td><td style="padding:8px;font-size:11px">'+esc(r.proc)+'</td><td style="padding:8px">'+fmtDate(r.data)+'</td><td style="padding:8px;text-align:right">'+fmt(r.vlCli)+'</td><td style="padding:8px;text-align:right">'+fmt(r.vlComp)+'</td><td style="padding:8px;text-align:right;color:#1D6B3A">'+fmt(r.prevG)+'</td><td style="padding:8px;text-align:right">'+r.des.toFixed(2)+'%</td></tr>';}).join('')+
    '</tbody></table></div>';
}

var relGeralData=null;
var MESES=['','Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
function pageRelGeral(){
  var st=relGeralData?relGeralData.length+' linhas':'Nenhum arquivo';
  return'<div class="pg-title">Rel. Geral CertJud</div>'+
    '<div class="card" style="margin-bottom:14px"><label class="imp" for="f-rg"><input type="file" id="f-rg" class="fhide" accept=".xlsx,.xls" onchange="impRelGeral(this)"/>'+
    '<div class="imp-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zM8 17l-3-3 1.4-1.4 1.6 1.6 3.6-3.6L13 11l-5 6z"/></svg></div>'+
    '<div class="imp-text"><div class="imp-title">Importar planilha</div><div class="imp-sub">Ano / Mês / Vl. Processo / Compra Mês / Recebimento Mês / Total / Despesa / Patrimônio Líquido</div></div>'+
    '<span class="imp-status" id="rg-st">'+st+'</span></label></div>'+
    '<div id="rg-out">'+(relGeralData?buildGeralTable():'<div class="empty">Importe a planilha para visualizar.</div>')+'</div>';
}
function impRelGeral(input){
  if(!input.files.length)return;
  readXlsx(input.files[0],function(rows){
    relGeralData=rows.filter(function(r){return parseValor(getCol(r,['Ano','ano'])||0)>0;}).map(function(r){
      return{ano:Math.round(parseValor(getCol(r,['Ano','ano'])||0)),mes:Math.round(parseValor(getCol(r,['Mes','Mês','mes'])||0)),
        vlProc:parseValor(getCol(r,['Valor Processo','valor processo'])||0),
        compra:parseValor(getCol(r,['Compra Mes','Compra Mês','compra mes'])||0),
        receb:parseValor(getCol(r,['Recebimento Mes','Recebimento Mês','recebimento mes'])||0),
        total:parseValor(getCol(r,['Total','total'])||0),
        desp:parseValor(getCol(r,['Despesa','despesa'])||0),
        pl:parseValor(getCol(r,['Patrimonio','Patrimônio','Patrimonio Liquido','patrimonio liquido'])||0)};
    });
    var el=document.getElementById('rg-st');if(el)el.textContent=relGeralData.length+' linhas';
    showToast(relGeralData.length+' linhas!');input.value='';
    var out=document.getElementById('rg-out');if(out)out.innerHTML=buildGeralTable();
  });
}
function buildGeralTable(){
  if(!relGeralData||!relGeralData.length)return'<div class="empty">Sem dados.</div>';
  var tC=relGeralData.reduce(function(s,r){return s+r.compra;},0);
  var tR=relGeralData.reduce(function(s,r){return s+r.receb;},0);
  var lastPL=relGeralData[relGeralData.length-1].pl;
  return'<div class="metrics" style="margin:16px 0"><div class="mc blue"><div class="ml">Total Compras</div><div class="mv blue">'+fmt(tC)+'</div></div><div class="mc gold"><div class="ml">Total Recebimentos</div><div class="mv gold">'+fmt(tR)+'</div></div><div class="mc green"><div class="ml">Patrimônio Líquido</div><div class="mv green">'+fmt(lastPL)+'</div></div></div>'+
    '<div style="overflow-x:auto;border-radius:8px;border:1px solid #ddd"><table style="width:100%;border-collapse:collapse;font-size:13px"><thead><tr style="background:var(--v);color:#fff"><th style="padding:9px">Período</th><th style="padding:9px;text-align:right">Vl.Processos</th><th style="padding:9px;text-align:right">Compra Mês</th><th style="padding:9px;text-align:right">Receb. Mês</th><th style="padding:9px;text-align:right">Total Carteira</th><th style="padding:9px;text-align:right">Despesa</th><th style="padding:9px;text-align:right">Patrimônio Liq.</th></tr></thead><tbody>'+
    relGeralData.map(function(r,i){var bg=i%2===0?'':'background:var(--row-alt)';return'<tr style="'+bg+'"><td style="padding:8px">'+(MESES[r.mes]||r.mes)+'/'+r.ano+'</td><td style="padding:8px;text-align:right">'+fmt(r.vlProc)+'</td><td style="padding:8px;text-align:right">'+fmt(r.compra)+'</td><td style="padding:8px;text-align:right">'+fmt(r.receb)+'</td><td style="padding:8px;text-align:right">'+fmt(r.total)+'</td><td style="padding:8px;text-align:right">'+fmt(r.desp)+'</td><td style="padding:8px;text-align:right;font-weight:700;color:var(--v)">'+fmt(r.pl)+'</td></tr>';}).join('')+
    '</tbody></table></div>';
}

var relPendData=null;
function pageRelPend(){
  var st=relPendData?relPendData.length+' processos':'Nenhum arquivo';
  return'<div class="pg-title">Processos Pendentes</div>'+
    '<div class="card" style="margin-bottom:14px"><label class="imp" for="f-rp"><input type="file" id="f-rp" class="fhide" accept=".xlsx,.xls" onchange="impRelPend(this)"/>'+
    '<div class="imp-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zM8 17l-3-3 1.4-1.4 1.6 1.6 3.6-3.6L13 11l-5 6z"/></svg></div>'+
    '<div class="imp-text"><div class="imp-title">Importar planilha</div><div class="imp-sub">Cliente / Processo / Data / Vl. Cliente / Valor de Compra / Prev. Ganho / Prev. Entrada / Deságio%</div></div>'+
    '<span class="imp-status" id="rp-st">'+st+'</span></label></div>'+
    '<div style="display:flex;gap:8px;margin-bottom:12px"><input id="rp-q" placeholder="Buscar..." style="padding:7px 10px;border:1px solid #ccc;border-radius:6px;flex:1"/><button class="btn bp" onclick="renderRelPend()">Gerar</button></div>'+
    '<div id="rp-out"><div class="empty">Importe a planilha e clique em Gerar.</div></div>';
}
function impRelPend(input){
  if(!input.files.length)return;
  readXlsx(input.files[0],function(rows){
    relPendData=rows.filter(function(r){return String(getCol(r,['Cliente','cliente'])||'').trim();}).map(function(r){
      var dv=getCol(r,['Data','data']);var ds='';
      if(dv){try{var d=new Date(String(dv));if(!isNaN(d))ds=d.toISOString().slice(0,10);}catch(e){}}
      return{cliente:String(getCol(r,['Cliente','cliente'])||'').trim(),proc:String(getCol(r,['Processo','processo'])||'').trim(),data:ds,
        vlCli:parseValor(getCol(r,['Valor Cliente','valor cliente'])||0),
        vlComp:parseValor(getCol(r,['Valor Compra','valor compra'])||0),
        prevG:parseValor(getCol(r,['Prev. Ganho','prev ganho'])||0),
        prevE:parseValor(getCol(r,['Prev. Entrada','prev entrada'])||0),
        des:parseValor(getCol(r,['Desagio','Deságio','desagio'])||0)};
    });
    var el=document.getElementById('rp-st');if(el)el.textContent=relPendData.length+' processos';
    showToast(relPendData.length+' importados!');input.value='';
  });
}
function renderRelPend(){
  if(!relPendData||!relPendData.length){document.getElementById('rp-out').innerHTML='<div class="empty">Importe primeiro.</div>';return;}
  var q=(document.getElementById('rp-q').value||'').toLowerCase();
  var f=relPendData.filter(function(r){return!q||(r.cliente||'').toLowerCase().includes(q)||(r.proc||'').toLowerCase().includes(q);});
  var tCli=f.reduce(function(s,r){return s+r.vlCli;},0),tC=f.reduce(function(s,r){return s+r.vlComp;},0),tG=f.reduce(function(s,r){return s+r.prevG;},0);
  document.getElementById('rp-out').innerHTML=
    '<div class="metrics" style="margin-bottom:16px"><div class="mc"><div class="ml">Pendentes</div><div class="mv">'+f.length+'</div></div><div class="mc gold"><div class="ml">Vl. Cliente</div><div class="mv gold">'+fmt(tCli)+'</div></div><div class="mc blue"><div class="ml">Valor de Compra</div><div class="mv blue">'+fmt(tC)+'</div></div><div class="mc green"><div class="ml">Prev. Ganho</div><div class="mv green">'+fmt(tG)+'</div></div></div>'+
    '<div style="overflow-x:auto;border-radius:8px;border:1px solid #ddd"><table style="width:100%;border-collapse:collapse;font-size:13px"><thead><tr style="background:var(--v);color:#fff"><th style="padding:9px">Cliente</th><th style="padding:9px">Processo</th><th style="padding:9px">Data</th><th style="padding:9px;text-align:right">Vl.Cliente</th><th style="padding:9px;text-align:right">Vl.Compra</th><th style="padding:9px;text-align:right">Prev.Ganho</th><th style="padding:9px;text-align:right">Prev.Entrada</th><th style="padding:9px;text-align:right">Deságio%</th></tr></thead><tbody>'+
    f.map(function(r,i){var bg=i%2===0?'':'background:var(--row-alt)';return'<tr style="'+bg+'"><td style="padding:8px">'+esc(r.cliente)+'</td><td style="padding:8px;font-size:11px">'+esc(r.proc)+'</td><td style="padding:8px">'+fmtDate(r.data)+'</td><td style="padding:8px;text-align:right">'+fmt(r.vlCli)+'</td><td style="padding:8px;text-align:right">'+fmt(r.vlComp)+'</td><td style="padding:8px;text-align:right;color:#1D6B3A">'+fmt(r.prevG)+'</td><td style="padding:8px;text-align:right">'+fmt(r.prevE)+'</td><td style="padding:8px;text-align:right">'+r.des.toFixed(2)+'%</td></tr>';}).join('')+
    '</tbody></table></div>';
}

// ======== IMPORTACAO PLANILHA CONTENCIOSO ========
var _PROC_DATA=[]; // dados movidos para data/seed/processos-contencioso.json (import no Plano 2)
// Botão "Importar Planilha" da tela Processos: abre file picker e importa XLSX
// do usuário. (O seed histórico do Contencioso ficou apenas no backend, na
// callable importContenciosoSeed — invocar via firebase CLI/SDK quando precisar.)
function importarPlanilhaContencioso(){
  if(!isFullAccess(currentUser) && !isGestora(currentUser)){
    showToast('Sem permissão para importar.');return;
  }
  var input = document.getElementById('hidden-proc-xlsx');
  if(!input){
    input = document.createElement('input');
    input.type = 'file';
    input.id = 'hidden-proc-xlsx';
    input.accept = '.xlsx,.xls,.csv';
    input.style.display = 'none';
    input.onchange = async function(){
      if(input.files && input.files.length){
        await handleProcessosXlsxImport(input.files[0]);
      }
      input.value = '';
    };
    document.body.appendChild(input);
  }
  input.click();
}

async function handleProcessosXlsxImport(file){
  readXlsx(file, async function(rows){
    var parsed = [];
    var skipped = 0;
    var advNoMatch = new Set();
    rows.forEach(function(r){
      var numero = String(getCol(r, ['Nº Processo','N° Processo','Numero','NUMERO','Número','Processo','PROCESSO'])||'').trim();
      var cliente = String(getCol(r, ['Cliente','CLIENTE','Nome'])||'').trim();
      var advRaw = String(getCol(r, ['Advogado','ADVOGADO','Adv'])||'').trim();
      var tribunal = String(getCol(r, ['Tribunal','TRIBUNAL'])||'').trim();
      var tipo = String(getCol(r, ['Tipo','TIPO','Materia','Matéria','MATERIA','MATÉRIA'])||'').trim();
      var credito = String(getCol(r, ['Credito','Crédito','CREDITO','CRÉDITO','Tipo de Crédito'])||'').trim();
      var dataRaw = getCol(r, ['Data Compra','DATA','Data','DATACOMPRA']);
      var dataCompra = '';
      if(dataRaw){
        try{
          if(typeof dataRaw==='number'){
            var d = new Date(Math.round((dataRaw-25569)*86400*1000));
            if(!isNaN(d)) dataCompra = d.toISOString().slice(0,10);
          } else {
            var d2 = new Date(String(dataRaw));
            if(!isNaN(d2)) dataCompra = d2.toISOString().slice(0,10);
          }
        }catch(e){}
      }
      var valor = parseValor(getCol(r, ['Valor','VALOR','Valor Cliente','Vl Cliente','VALOR CLIENTE'])||0);
      var timelineCell = getCol(r, ['Timeline','TIMELINE','Time line','Resumo Processual','Andamentos','Andamento']);

      // Linhas sem número e sem cliente são header/lixo
      if(!numero && !cliente){ skipped++; return; }
      if(advRaw && advRaw.toUpperCase()==='ADVOGADO'){ skipped++; return; }

      // Match advogado pelo primeiro nome
      var lawyer = null;
      if(advRaw){
        var advKey = advRaw.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').trim();
        var firstName = advKey.split(/\s+/)[0];
        lawyer = S.lawyers.find(function(l){
          var n = (l.name||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').trim();
          var fn = n.split(/\s+/)[0];
          return fn===firstName || n===advKey || n.startsWith(firstName);
        });
      }
      if(!lawyer){
        skipped++;
        if(advRaw) advNoMatch.add(advRaw);
        return;
      }
      parsed.push({numero:numero, cliente:cliente, advogadoId:lawyer.id, tribunal:tribunal, tipo:tipo, credito:credito, dataCompra:dataCompra, valor:valor, timeline:timelineCell});
    });

    if(!parsed.length){
      alert('Nenhum processo válido na planilha.\nLinhas puladas: '+skipped+(advNoMatch.size?'\nAdvogados sem match: '+Array.from(advNoMatch).slice(0,5).join(', '):''));
      return;
    }

    // Filtra duplicatas pelo número+advogadoId comparando com S.processos atual
    var existing = {};
    (S.processos||[]).forEach(function(p){
      existing[(p.numero||'')+'|'+(p.advogadoId||'')] = true;
    });
    var toAdd = parsed.filter(function(p){
      var key = p.numero+'|'+p.advogadoId;
      if(existing[key]){ skipped++; return false; }
      return true;
    });
    if(!toAdd.length){
      alert('Todos os processos da planilha já existem no sistema (idempotência: '+parsed.length+' duplicatas puladas).');
      return;
    }

    var msg = toAdd.length+' processo(s) prontos para importar.';
    if(skipped) msg += '\n('+skipped+' linhas puladas — duplicatas, advogado sem match, ou linhas vazias)';
    if(advNoMatch.size) msg += '\nAdvogados não encontrados (pulados): '+Array.from(advNoMatch).slice(0,5).join(', ')+(advNoMatch.size>5?'...':'');
    msg += '\n\nContinuar?';
    if(!confirm(msg)) return;

    // Batch write em lotes de 400
    showToast('Importando '+toAdd.length+' processos...');
    var mes = S.mes || new Date().toISOString().slice(0,7);
    var BATCH = 400, added = 0, ops = 0, tlAdded = 0;
    try{
      var batch = fb.writeBatch(fb.db);
      for(var i=0; i<toAdd.length; i++){
        var p = toAdd[i];
        var ref = fb.doc(fb.collection(fb.db,'processos'));
        batch.set(ref, {
          id: ref.id,
          numero: p.numero,
          cliente: p.cliente,
          advogadoId: p.advogadoId,
          tribunal: p.tribunal,
          tipo: p.tipo,
          credito: p.credito,
          dataCompra: p.dataCompra,
          valor: Number(p.valor)||0,
          valorCliente: Number(p.valor)||0,
          valorCompra: 0,
          valorCondenacao: 0,
          percCompra: 0,
          mes: mes,
          status: 'pendente',
          recebimentos: [],
          origem: 'import_xlsx',
          createdBy: currentUser.id,
          createdAt: fb.serverTimestamp(),
          updatedBy: currentUser.id,
          updatedAt: fb.serverTimestamp()
        });
        added++; ops++;
        if(ops % BATCH === 0){ await batch.commit(); batch = fb.writeBatch(fb.db); }
        // Timeline (resumo processual) vinda da planilha → subcoleção processos/{id}/timeline
        var tlEntries = parseTimelineCell(p.timeline);
        for(var k=0; k<tlEntries.length; k++){
          var te = tlEntries[k];
          var tref = fb.doc(fb.collection(fb.db,'processos',ref.id,'timeline'));
          batch.set(tref, { ts: te.ts, autor: (currentUser&&currentUser.name)||'Importação', papel:'', tipo:'andamento', texto: te.texto, ref: te.ref||'' });
          tlAdded++; ops++;
          if(ops % BATCH === 0){ await batch.commit(); batch = fb.writeBatch(fb.db); }
        }
      }
      if(ops % BATCH !== 0) await batch.commit();
      S.processos = await fetchCollection('processos');
      alert(added+' processo(s) importados com sucesso!'+(tlAdded?('\n'+tlAdded+' andamento(s) de timeline importado(s).'):''));
      navigate('processos');
    }catch(e){
      alert('Erro durante o import: '+(e.code||e.message));
    }
  });
}



// ════════════════════════════════════════════════════════════
// COMISSÕES — GERAÇÃO DE NEGÓCIOS (sistema do Marco, embutido em iframe)
// ════════════════════════════════════════════════════════════
var _gnIframeUrl=null;
function pageGeracaoNegocios(){
  // Dupla checagem: quem não tem canViewGeracaoNegocios:true não passa (já bloqueado no navigate)
  if(!canViewGN(currentUser)){
    return '<div class="page-title">'+I.advogados+' Comissões — Geração de Negócios</div><div class="card"><div class="empty">Você não tem permissão para visualizar esta área.</div></div>';
  }
  // Monta a página com um container para o iframe
  return '<div class="page-title">'+I.advogados+' Comissões — Geração de Negócios</div>'+
    '<div style="height:calc(100vh - 130px);min-height:600px;border:1px solid var(--bd);border-radius:8px;overflow:hidden;background:#fff">'+
      '<iframe id="gn-iframe" style="width:100%;height:100%;border:0;display:block" sandbox="allow-scripts allow-same-origin allow-downloads allow-popups"></iframe>'+
    '</div>';
}
function afterGeracaoNegocios(){
  var iframe=document.getElementById('gn-iframe');if(!iframe)return;
  // Cria Blob URL a partir do template HTML do Marco (uma vez só)
  if(!_gnIframeUrl){
    var tpl=document.getElementById('gn-marco-template');
    if(!tpl){console.error('Template do Marco não encontrado.');return;}
    var html=tpl.textContent||tpl.innerText;
    // Reverter o escape (tags fechamento de script foram escapadas durante a geração)
    var openTag='<';
    var closeTag='\\/script>';
    html=html.split(openTag+closeTag).join('<'+'/script>');
    var blob=new Blob([html],{type:'text/html;charset=utf-8'});
    _gnIframeUrl=URL.createObjectURL(blob);
  }
  iframe.src=_gnIframeUrl;
  // Quando o iframe sinalizar que está pronto, envia o usuário e a sessão salva
  iframe.onload=function(){
    var role='admin';
    if(currentUser){
      if(canViewGN(currentUser,'all'))role='jeanne';
      else if(canViewGN(currentUser,'own'))role='johnathan';
      else if(isFullAccess(currentUser))role='admin';
    }
    iframe.contentWindow.postMessage({type:'GN_USER',user:{role:role,id:currentUser?currentUser.id:null}},'*');
    // Carrega sessão salva (se houver)
    if(S.gnSessao){
      iframe.contentWindow.postMessage({type:'GN_LOAD',data:S.gnSessao},'*');
    }
  };
}
// Listener global para receber salvar do iframe
window.addEventListener('message', async function(ev){
  if(!ev.data)return;
  if(ev.data.type==='GN_SAVE'&&ev.data.data){
    S.gnSessao=ev.data.data;
    try{ await persistGnSessao(ev.data.data); }catch(e){ console.error('persistGnSessao falhou:', e); }
  }
});
</script>
<script type="text/html" id="gn-marco-template">
<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Comissionamento — PBL</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"><\/script>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --g: #0D4A3A; --gd: #082e25; --gl: #dff0e9;
  --gold: #C49A45; --goldd: #9c7a34;
  --tx: #111; --mu: #546860; --bo: #c2d9d1;
  --bg: linear-gradient(145deg, #f4f9f7 0%, #fdfaf4 100%);
  --bg-solid: #f4f9f7;
  --white: #fff;
  --sh: 0 2px 8px rgba(13,74,58,0.10);
  --sh2: 0 6px 24px rgba(13,74,58,0.16);
  --danger: #c0392b; --danger-bg: #fdf0ef;
  --tag-c-bg: #dff0e9; --tag-c-tx: #0D4A3A;
  --tag-j-bg: #fdf3e0; --tag-j-tx: #9c7a34;
  --tag-f-bg: #e8eaf6; --tag-f-tx: #3949ab;
  --overlay: rgba(0,0,0,0.35);
  --header-border: #C49A45;
  --gold-tint: rgba(196,154,69,0.07);
  --card-sh: 0 2px 10px rgba(13,74,58,0.10);
  --card-sh-hover: 0 6px 24px rgba(13,74,58,0.16);
}
[data-theme="dark"] {
  --g: #3a9c74; --gd: #2a7a58; --gl: #1a2e28;
  --gold: #d4a84e; --goldd: #b08030;
  --tx: #e0ede8; --mu: #7aaa9a; --bo: #2a4a40;
  --bg: #0f1f1a; --bg-solid: #0f1f1a; --white: #162820;
  --sh: 0 1px 4px rgba(0,0,0,0.3);
  --sh2: 0 4px 20px rgba(0,0,0,0.45);
  --danger: #e74c3c; --danger-bg: #2a1a1a;
  --tag-c-bg: #1a3028; --tag-c-tx: #3a9c74;
  --tag-j-bg: #2a2010; --tag-j-tx: #d4a84e;
  --tag-f-bg: #1a1c30; --tag-f-tx: #7986cb;
  --overlay: rgba(0,0,0,0.6);
  --header-border: #2a4a40;
  --gold-tint: rgba(212,168,78,0.05);
  --card-sh: 0 1px 4px rgba(0,0,0,0.3);
  --card-sh-hover: 0 4px 20px rgba(0,0,0,0.45);
}

*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);background-color:var(--bg-solid);color:var(--tx);font-family:'Space Grotesk',sans-serif;min-height:100vh;transition:background .3s,color .3s;font-size:14px}

/* HEADER */
.header{background:var(--white);border-bottom:2px solid var(--header-border);padding:0 32px;height:60px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:200;box-shadow:var(--sh);transition:background .3s,border-color .3s;position:relative;overflow:hidden}
.header::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--g) 0%,var(--gold) 100%);pointer-events:none}
.header-left{display:flex;align-items:center;gap:20px}
.header-divider{width:1px;height:24px;background:var(--bo)}
.header-title{font-size:15px;font-weight:600;letter-spacing:-0.01em}
.header-sub{font-size:11px;color:var(--mu);margin-top:1px}
.btn-theme{background:none;border:1px solid var(--bo);border-radius:6px;padding:6px 10px;cursor:pointer;font-size:14px;color:var(--mu);transition:all .15s;font-family:inherit}
.btn-theme:hover{border-color:var(--g);color:var(--g)}
.btn-fill{background:var(--g);color:#fff;border:none;border-radius:6px;padding:7px 16px;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer;transition:background .15s;letter-spacing:.01em}
.btn-fill:hover{background:var(--gd)}
.btn-registrar{background:var(--gold);color:#fff;border:none;border-radius:6px;padding:7px 16px;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer;transition:background .15s;letter-spacing:.01em}
.btn-registrar:hover{background:var(--goldd)}
.btn-registrar:disabled{opacity:.5;cursor:not-allowed}
.btn-pdf{background:var(--white);color:var(--g);border:1px solid var(--g);border-radius:6px;padding:7px 16px;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer;transition:all .15s}
.btn-pdf:hover{background:var(--gl)}
.btn-session{background:var(--white);color:var(--mu);border:1px solid var(--bo);border-radius:6px;padding:7px 16px;font-family:inherit;font-size:13px;font-weight:500;cursor:pointer;transition:all .15s;display:inline-flex;align-items:center;gap:6px}
.btn-session:hover{border-color:var(--g);color:var(--g)}

/* MODAL MANUAIS */
.modal-manuais-backdrop{display:none;position:fixed;inset:0;background:var(--overlay);z-index:600;align-items:flex-start;justify-content:center;padding:40px 16px;overflow-y:auto}
.modal-manuais-backdrop.open{display:flex}
.modal-manuais{background:var(--white);border:1px solid var(--bo);border-radius:12px;width:100%;max-width:560px;box-shadow:var(--sh2);transition:background .3s}
.mm-header{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;border-bottom:1px solid var(--bo)}
.mm-title{font-size:16px;font-weight:700;letter-spacing:-0.01em}
.mm-body{padding:0 24px 24px}
.mm-team{margin-top:20px}
.mm-team-label{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mu);margin-bottom:12px;padding-bottom:6px;border-bottom:1px solid var(--bo)}
.mm-person{margin-bottom:16px;padding:14px 16px;background:var(--bg-solid);border:1px solid var(--bo);border-radius:8px}
.mm-person-name{font-size:13px;font-weight:700;margin-bottom:10px;color:var(--tx)}
.mm-field{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font-size:13px}
.mm-field:last-child{margin-bottom:0}
.mm-field label{color:var(--mu);font-size:12px}
.mm-field-right{display:flex;align-items:center;gap:6px}
.mm-input{border:1px solid var(--bo);border-radius:5px;padding:5px 10px;font-size:13px;font-weight:600;font-family:inherit;background:var(--white);color:var(--tx);width:100px;text-align:right;outline:none;transition:border-color .15s}
.mm-input:focus{border-color:var(--g)}
.mm-input-hint{font-size:11px;color:var(--mu)}
.mm-footer{padding:16px 24px;border-top:1px solid var(--bo);display:flex;justify-content:flex-end;gap:10px}
.btn-mm-apply{background:var(--g);color:#fff;border:none;border-radius:7px;padding:10px 24px;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer;transition:background .15s}
.btn-mm-apply:hover{background:var(--gd)}
.btn-mm-cancel{background:none;border:1px solid var(--bo);border-radius:7px;padding:10px 20px;font-family:inherit;font-size:13px;color:var(--tx);cursor:pointer;transition:all .15s}
.btn-mm-cancel:hover{border-color:var(--g);color:var(--g)}

/* MAIN */
.main{max-width:1100px;margin:0 auto;padding:32px 24px}
@media(min-width:1280px){.main{max-width:1400px}}
@media(min-width:1600px){.main{max-width:1600px}}

/* UPLOAD */
.upload-label{font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--mu);margin-bottom:10px}
.upload-zone{border:1.5px dashed var(--bo);border-radius:8px;padding:32px;text-align:center;cursor:pointer;transition:all .2s;position:relative;background:var(--white);transition:background .3s,border-color .3s}
.upload-zone:hover,.upload-zone.drag-over{border-color:var(--g);background:var(--gl)}
.upload-zone input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
.upload-icon{font-size:26px;margin-bottom:8px}
.upload-zone h3{font-size:14px;font-weight:600;margin-bottom:3px}
.upload-zone p{font-size:12px;color:var(--mu)}
.upload-zone.loaded{border-style:solid;border-color:var(--g)}
.upload-zone.loaded h3{color:var(--g)}
.status-bar{font-size:12px;color:var(--mu);margin-top:8px;min-height:18px}
.status-bar.ok{color:var(--g);font-weight:500}
.status-bar.error{color:var(--danger)}

/* TABS */
.tabs-wrap{margin:28px 0 20px}
.tabs{display:flex;gap:4px;background:var(--white);border:1px solid var(--bo);border-radius:8px;padding:4px;width:fit-content;transition:background .3s,border-color .3s}
.tab{padding:8px 20px;border-radius:6px;font-size:13px;font-weight:500;color:var(--mu);cursor:pointer;transition:all .15s;border:none;background:none;font-family:inherit}
.tab.active{background:var(--g);color:#fff;font-weight:600}

/* GRID */
.people-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(380px,1fr));gap:16px;margin-bottom:28px}
@media(min-width:1280px){.people-grid{grid-template-columns:repeat(auto-fill,minmax(400px,1fr))}}
@media(min-width:1600px){.people-grid{grid-template-columns:repeat(auto-fill,minmax(420px,1fr))}}

/* CARD */
.person-card{background:var(--white);border:1px solid var(--bo);border-radius:10px;overflow:hidden;box-shadow:var(--card-sh);transition:box-shadow .2s,background .3s,border-color .3s;cursor:pointer}
.person-card:hover{box-shadow:var(--card-sh-hover)}
.card-top{padding:16px 18px 12px;border-bottom:1px solid var(--bo)}
.card-top-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.person-name{font-size:15px;font-weight:700;letter-spacing:-0.01em}
.card-actions{display:flex;gap:6px;align-items:center}
.tag{font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:3px 8px;border-radius:4px}
.tag.comercial{background:var(--tag-c-bg);color:var(--tag-c-tx)}
.tag.juridico{background:var(--tag-j-bg);color:var(--tag-j-tx)}
.tag.financeiro{background:var(--tag-f-bg);color:var(--tag-f-tx)}
.btn-remove{background:none;border:1px solid var(--bo);border-radius:5px;padding:3px 8px;font-size:11px;color:var(--mu);cursor:pointer;transition:all .15s;font-family:inherit}
.btn-remove:hover{border-color:var(--danger);color:var(--danger);background:var(--danger-bg)}
.btn-preencher{background:none;border:1px solid var(--bo);border-radius:5px;color:var(--mu);cursor:pointer;font-size:11px;font-family:inherit;font-weight:500;padding:3px 8px;transition:all .15s}
.btn-preencher:hover{border-color:var(--g);color:var(--g);background:var(--gl)}
.btn-add-pessoa{background:none;border:1px dashed var(--bo);border-radius:6px;color:var(--mu);cursor:pointer;font-size:13px;font-family:inherit;font-weight:500;padding:7px 16px;transition:all .15s}
.btn-add-pessoa:hover{border-color:var(--g);color:var(--g);border-style:solid}
/* MODAL INDIVIDUAL */
.modal-ind-backdrop{display:none;position:fixed;inset:0;background:var(--overlay);z-index:700;align-items:center;justify-content:center;padding:24px 16px}
.modal-ind-backdrop.open{display:flex}
.modal-ind{background:var(--white);border:1px solid var(--bo);border-radius:12px;width:100%;max-width:440px;max-height:90vh;overflow-y:auto;box-shadow:var(--sh2);transition:background .3s}
.modal-ind-header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid var(--bo);position:sticky;top:0;background:var(--white);z-index:1}
.modal-ind-title{font-size:14px;font-weight:700}
.modal-ind-body{padding:16px 20px}
.modal-ind-footer{padding:12px 20px;border-top:1px solid var(--bo);display:flex;justify-content:flex-end;gap:10px;position:sticky;bottom:0;background:var(--white)}
.card-stats{display:flex}
.stat{flex:1;text-align:center;padding:8px 4px}
.stat:not(:last-child){border-right:1px solid var(--bo)}
.stat-val{font-size:17px;font-weight:700;color:var(--g);line-height:1}
.stat-label{font-size:10px;color:var(--mu);margin-top:3px}
.card-body{padding:14px 18px}
.row{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px;font-size:13px}
.row .lbl{color:var(--mu);font-size:13px}
.row .val{font-weight:600;font-size:13px}
.card-divider{height:1px;background:var(--bo);margin:10px 0}
.manual-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:7px}
.manual-row label{font-size:13px;color:var(--mu)}
.manual-row .row-right{display:flex;align-items:center;gap:8px}
.manual-row .row-val{font-weight:600;font-size:13px;min-width:70px;text-align:right}
.manual-input{border:none;border-bottom:1px solid var(--bo);border-radius:0;padding:2px 0;font-size:13px;font-weight:600;font-family:inherit;background:transparent;color:var(--tx);width:60px;text-align:right;transition:border-color .15s;outline:none}
.manual-input:focus{border-bottom-color:var(--g)}
.card-total{display:grid;grid-template-columns:1fr 1fr 1fr;background:var(--gl);border-top:1px solid var(--bo);transition:background .3s}
.card-total-col{text-align:center;padding:10px 8px}
.card-total-col:not(:last-child){border-right:1px solid var(--bo)}
.total-lbl{font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mu);margin-bottom:3px;display:block}
.total-val{font-size:14px;font-weight:700;color:var(--g);display:block}
.total-val.total-main{font-size:16px;color:var(--g)}
.hint{font-size:10px;color:var(--mu);text-align:center;padding:6px 0 2px;opacity:.7}
.card-group-label{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mu);margin:8px 0 6px;padding-bottom:4px;border-bottom:1px solid var(--bo)}

/* SUMMARY TABLE */
.summary-section{margin-top:4px}
.summary-label{font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--mu);margin-bottom:10px}
.table-wrap{background:var(--white);border:1px solid var(--bo);border-radius:10px;overflow-x:auto;overflow-y:hidden;box-shadow:var(--sh);transition:background .3s,border-color .3s;-webkit-overflow-scrolling:touch}
table{width:100%;border-collapse:collapse;font-size:13px}
th{font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--mu);padding:10px 14px;text-align:right;white-space:nowrap;border-bottom:2px solid var(--bo)}
th:first-child{text-align:left}
th.th-com{background:rgba(13,74,58,0.05);color:var(--g)}
th.th-com-first{border-left:1px solid var(--bo)}
th.th-com-last{border-right:1px solid var(--bo)}
th.th-pre{background:rgba(196,154,69,0.07);color:var(--gold)}
th.th-pre-first{border-left:1px solid var(--bo)}
th.th-pre-last{border-right:1px solid var(--bo)}
td{padding:11px 14px;text-align:right;border-bottom:1px solid var(--bo);font-size:13px;white-space:nowrap;font-variant-numeric:tabular-nums}
td:first-child{text-align:left;font-weight:600}
tr:last-child td{border-bottom:none}
td.td-com{background:rgba(13,74,58,0.02)}
td.td-com-first{background:rgba(13,74,58,0.02);border-left:1px solid var(--bo)}
td.td-com-last{background:rgba(13,74,58,0.02);border-right:1px solid var(--bo)}
td.td-pre{background:rgba(196,154,69,0.04)}
td.td-pre-first{background:rgba(196,154,69,0.04);border-left:1px solid var(--bo)}
td.td-pre-last{background:rgba(196,154,69,0.04);border-right:1px solid var(--bo)}
tr.totals-row td{font-weight:700;color:var(--g);background:var(--gl)}
tr.totals-row td.td-com,tr.totals-row td.td-com-first,tr.totals-row td.td-com-last{background:rgba(13,74,58,0.06)}
tr.totals-row td.td-pre,tr.totals-row td.td-pre-first,tr.totals-row td.td-pre-last{background:rgba(196,154,69,0.08);color:var(--goldd)}
tr.totals-row td:first-child{font-size:11px;letter-spacing:.06em;text-transform:uppercase}
tr:not(.totals-row):hover td{opacity:.85;cursor:pointer}

/* EXPORT */
.export-row{margin-top:18px;display:flex;gap:10px}
.btn-export{background:var(--g);color:#fff;border:none;border-radius:7px;padding:10px 22px;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer;transition:background .15s}
.btn-export:hover{background:var(--gd)}

/* REMOVED */
.removed-section{margin-bottom:20px}
.removed-label{font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--mu);margin-bottom:8px}
.removed-chips{display:flex;flex-wrap:wrap;gap:8px}
.removed-chip{display:flex;align-items:center;gap:6px;background:var(--white);border:1px solid var(--bo);border-radius:20px;padding:4px 12px;font-size:12px;color:var(--mu);transition:background .3s}
.btn-restore{background:none;border:none;cursor:pointer;color:var(--g);font-size:13px;padding:0;line-height:1;font-weight:700}

/* MODAL BACKDROP */
.modal-backdrop{display:none;position:fixed;inset:0;background:var(--overlay);z-index:500;align-items:center;justify-content:center}
.modal-backdrop.open{display:flex}
.modal{background:var(--white);border:1px solid var(--bo);border-radius:12px;width:100%;max-width:480px;max-height:90vh;overflow-y:auto;box-shadow:var(--sh2);padding:28px;transition:background .3s}
.modal-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px}
.modal-name{font-size:20px;font-weight:700;letter-spacing:-0.02em}
.modal-tag{margin-top:4px}
.btn-close{background:none;border:1px solid var(--bo);border-radius:6px;padding:4px 10px;cursor:pointer;font-size:16px;color:var(--mu);font-family:inherit;transition:all .15s}
.btn-close:hover{border-color:var(--danger);color:var(--danger)}
.modal-section{margin-bottom:18px}
.modal-section-title{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mu);margin-bottom:10px;padding-bottom:6px;border-bottom:1px solid var(--bo)}
.breakdown-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;font-size:13px;border-bottom:1px dashed var(--bo)}
.breakdown-row:last-child{border-bottom:none}
.breakdown-row .blbl{color:var(--mu)}
.breakdown-row .bval{font-weight:600}
.breakdown-row .bval.gold{color:var(--gold)}
.breakdown-row .bval.green{color:var(--g)}
.breakdown-formula{font-size:11px;color:var(--mu);margin-top:2px}
.modal-total{display:flex;justify-content:space-between;align-items:center;padding:14px 0 0;margin-top:8px;border-top:2px solid var(--g)}
.modal-total .lbl{font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
.modal-total .val{font-size:22px;font-weight:700;color:var(--g)}

/* GLOBAL CARDS */
.global-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;margin-bottom:24px}
.global-card{background:var(--white);border:1px solid var(--bo);border-radius:10px;padding:16px 18px;box-shadow:var(--card-sh);transition:background .3s,border-color .3s}
.gc-label{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--mu);margin-bottom:6px}
.gc-val{font-size:22px;font-weight:700;color:var(--g);line-height:1;margin-bottom:2px}
.gc-sub{font-size:11px;color:var(--mu)}
.gc-input-row{display:flex;align-items:center;gap:8px;margin-top:6px}
.gc-input{border:1px solid var(--bo);border-radius:5px;padding:5px 10px;font-size:15px;font-weight:700;font-family:inherit;background:var(--bg-solid);color:var(--tx);width:100%;text-align:right;transition:border-color .15s,background .3s,color .3s;outline:none}
.gc-input:focus{border-color:var(--g)}
.gc-card-liq{border-left:3px solid var(--gold);background:var(--gold-tint)}
.cv-sec{font-size:10px;text-transform:uppercase;letter-spacing:.03em;color:#0c3d26;font-weight:700;margin:10px 0 6px;border-bottom:1px solid #dde7e1;padding-bottom:3px}
.cv-g3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.cv-g3 .fg label{display:block;font-size:9px;color:#3f4a44;margin-bottom:2px;font-weight:600}
.cv-g3 .fg select,.cv-g3 .fg input{width:100%;box-sizing:border-box}
.cv-grid{width:100%;border-collapse:collapse;font-size:11px;margin-top:4px}
.cv-grid th,.cv-grid td{padding:4px 6px;border-bottom:1px solid #eef1f0;text-align:left}
.cv-grid th{font-size:9px;text-transform:uppercase;color:#0c3d26;background:#f0f5f2}
.cv-grid input{width:100%;box-sizing:border-box}
.rev-ctabs{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:8px}
.rev-ctab{border:1px solid #b9cec2;border-radius:18px;padding:3px 12px;font-size:11px;color:#0c3d26;font-weight:600;cursor:pointer;background:#fff}
.rev-ctab.on{background:#0f5132;color:#fff;border-color:#0f5132}
.rev-ctab.add{border-style:dashed;color:#0f5132}
</style>
</head>
<body>

<header class="header">
  <div class="header-left">
    <div>
      <div class="header-title">Comissionamento — Geração de Negócios</div>
      <div class="header-sub" id="mes-ref">—</div>
    </div>
  </div>
  <div style="display:flex;gap:10px;align-items:center">
    <label class="btn-session" title="Carregar sessão salva">
      📂 Carregar sessão
      <input type="file" id="sessionInput" accept=".json" style="display:none" onchange="carregarSessao(event)">
    </label>
    <button class="btn-session" id="btnSalvarSessao" onclick="salvarSessao()" style="display:none">💾 Salvar sessão</button>
    <div class="header-divider"></div>
    <button class="btn-fill" id="btnFill" onclick="abrirModalManuais()" style="display:none">Dados manuais</button>
    <button class="btn-pdf" id="btnPdf" onclick="exportarPDF()" style="display:none">Exportar PDF</button>
    <button class="btn-theme" id="btnTheme" onclick="toggleTheme()">🌙</button>
  </div>
</header>

<main class="main">
  <div style="margin-bottom:24px">
    <div class="upload-label">Planilha mensal</div>
    <div class="upload-zone" id="uploadZone">
      <input type="file" id="fileInput" accept=".xlsx,.xls">
      <div class="upload-icon">📂</div>
      <h3>Arraste ou clique para subir a planilha mensal</h3>
      <p>Aba: Principal · C (Comercial) · D (Jurídico, siglas) · I (Créditos) · P (Valor) · R (Contrato)</p>
    </div>
    <div class="status-bar" id="statusBar"></div>
  </div>

  <div id="appContent" style="display:none">


    <div class="global-cards">
      <div class="global-card">
        <div class="gc-label">Total Créditos Normais</div>
        <div class="gc-val" id="gc-creditos">—</div>
        <div class="gc-sub">soma coluna C</div>
      </div>
      <div class="global-card">
        <div class="gc-label">Total Adicionais</div>
        <div class="gc-val" id="gc-adicionais">—</div>
        <div class="gc-sub">+2 por compra ≥ R$ 20k</div>
      </div>
      <div class="global-card">
        <div class="gc-label">Volume Total</div>
        <div class="gc-val" id="gc-volume">—</div>
        <div class="gc-sub">em reais (R$)</div>
      </div>
      <div class="global-card gc-card-liq">
        <div class="gc-label">Créditos Liquidados</div>
        <input type="number" min="0" step="1" class="gc-input" id="gc-liq-qt"
          placeholder="0" style="margin-top:8px" oninput="recalcLiquidados()" onchange="recalcLiquidados()">
        <div class="gc-sub" style="margin-top:4px">preencha a quantidade</div>
      </div>
      <div class="global-card gc-card-liq">
        <div class="gc-label">Valor Total Liquidados</div>
        <div class="gc-val" id="gc-liq-val">R$ 0,00</div>
        <div class="gc-sub">qtd × R$ 11,25</div>
      </div>
    </div>

    <div class="tabs-wrap">
      <div class="tabs">
        <button class="tab active" id="tab-btn-comercial" onclick="switchTab('comercial')">Comercial</button>
        <button class="tab" id="tab-btn-juridico" onclick="switchTab('juridico')">Jurídico</button>
        <button class="tab" id="tab-btn-financeiro" onclick="switchTab('financeiro')">Financeiro / ADM</button>
      </div>
    </div>

    <!-- COMERCIAL -->
    <div id="tab-comercial">
      <div style="display:flex;justify-content:flex-end;margin-bottom:12px">
        <button class="btn-add-pessoa" onclick="abrirModalAddPessoa('comercial')">+ Adicionar pessoa</button>
      </div>
      <div class="people-grid" id="cards-comercial"></div>
      <div id="removed-comercial" class="removed-section" style="display:none">
        <div class="removed-label">Removidos</div>
        <div class="removed-chips" id="chips-comercial"></div>
      </div>
      <div class="summary-section">
        <div class="summary-label">Resumo Comercial</div>
        <div class="table-wrap">
          <table>
            <thead><tr>
              <th>Nome</th>
              <th>Volume</th>
              <th class="th-com th-com-first">Créditos</th>
              <th class="th-com th-com-last">Adicionais</th>
              <th class="th-pre th-pre-first">Objetivo</th>
              <th class="th-pre">Obj. Coletivo</th>
              <th class="th-pre">Campanha Volume</th>
              <th class="th-pre">Campanha Execução</th>
              <th class="th-pre th-pre-last">Dupla de Ouro</th>
              <th>Total</th>
            </tr></thead>
            <tbody id="tbody-comercial"></tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- JURIDICO -->
    <div id="tab-juridico" style="display:none">
      <div style="display:flex;justify-content:flex-end;margin-bottom:12px">
        <button class="btn-add-pessoa" onclick="abrirModalAddPessoa('juridico')">+ Adicionar pessoa</button>
      </div>
      <div class="people-grid" id="cards-juridico"></div>
      <div id="removed-juridico" class="removed-section" style="display:none">
        <div class="removed-label">Removidos</div>
        <div class="removed-chips" id="chips-juridico"></div>
      </div>
      <div class="summary-section">
        <div class="summary-label">Resumo Jurídico</div>
        <div class="table-wrap">
          <table>
            <thead><tr>
              <th>Nome</th>
              <th>Volume</th>
              <th class="th-com th-com-first">Créditos</th>
              <th class="th-com">Adicionais</th>
              <th class="th-com">Precatório</th>
              <th class="th-com">Precatório Adic.</th>
              <th class="th-com">Inseridos</th>
              <th class="th-com th-com-last">Liquidados</th>
              <th class="th-pre th-pre-first">Objetivo</th>
              <th class="th-pre">Obj. Coletivo</th>
              <th class="th-pre">Campanha Volume</th>
              <th class="th-pre">Campanha Execução</th>
              <th class="th-pre">Dupla de Ouro</th>
              <th class="th-pre th-pre-last">Treinamento</th>
              <th>Total</th>
            </tr></thead>
            <tbody id="tbody-juridico"></tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- FINANCEIRO / ADM -->
    <div id="tab-financeiro" style="display:none">
      <div class="people-grid" id="cards-financeiro"></div>
      <div class="summary-section">
        <div class="summary-label">Resumo Financeiro / ADM</div>
        <div class="table-wrap">
          <table>
            <thead><tr>
              <th>Nome</th>
              <th class="th-pre th-pre-first">Prêmio Execução</th>
              <th class="th-pre">Prêmio Resultado</th>
              <th class="th-pre th-pre-last">Obj. Coletivo</th>
              <th>Total</th>
            </tr></thead>
            <tbody id="tbody-financeiro"></tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</main>

<!-- MODAL DADOS MANUAIS -->
<div class="modal-manuais-backdrop" id="modalManuaisBackdrop" onclick="fecharModalManuais(event)">
  <div class="modal-manuais">
    <div class="mm-header">
      <span class="mm-title">Dados manuais</span>
      <button class="btn-close" onclick="closeModalManuais()">✕</button>
    </div>
    <div class="mm-body" id="mmBody"></div>
    <div class="mm-footer">
      <button class="btn-mm-cancel" onclick="closeModalManuais()">Cancelar</button>
      <button class="btn-mm-apply" onclick="aplicarManuais()">Aplicar</button>
    </div>
  </div>
</div>

<!-- MODAL ADICIONAR PESSOA -->
<div class="modal-ind-backdrop" id="modalAddBackdrop">
  <div class="modal-ind" style="max-width:380px">
    <div class="modal-ind-header">
      <span class="modal-ind-title" id="modalAddTitle">Adicionar pessoa</span>
      <button class="btn-close" onclick="document.getElementById('modalAddBackdrop').classList.remove('open')">✕</button>
    </div>
    <div class="modal-ind-body">
      <div class="mm-field" style="margin-bottom:14px">
        <label>Nome completo</label>
        <input type="text" class="mm-input" id="add-nome" placeholder="Ex: Eduardo Zattar" style="width:100%">
      </div>
      <div class="mm-field" style="margin-bottom:14px">
        <label>Sigla</label>
        <input type="text" class="mm-input" id="add-sigla" placeholder="Ex: EZ" style="width:60px;text-transform:uppercase" maxlength="4">
      </div>
      <div style="font-size:11px;color:var(--mu);margin-top:8px">
        O card será criado com créditos e volume zerados. Preencha os dados pelo botão <strong>✏️ Preencher</strong> no card.
      </div>
    </div>
    <div class="modal-ind-footer">
      <button class="btn-mm-cancel" onclick="document.getElementById('modalAddBackdrop').classList.remove('open')">Cancelar</button>
      <button class="btn-mm-apply" onclick="confirmarAddPessoa()">Adicionar</button>
    </div>
  </div>
</div>

<!-- MODAL INDIVIDUAL -->
<div class="modal-ind-backdrop" id="modalIndBackdrop">
  <div class="modal-ind" id="modalInd">
    <div class="modal-ind-header">
      <span class="modal-ind-title" id="modalIndTitle">Preencher</span>
      <button class="btn-close" onclick="fecharModalInd(true)">✕</button>
    </div>
    <div class="modal-ind-body" id="modalIndBody"></div>
    <div class="modal-ind-footer">
      <button class="btn-mm-cancel" onclick="fecharModalInd(true)">Cancelar</button>
      <button class="btn-mm-apply" onclick="aplicarModalInd()">Aplicar</button>
    </div>
  </div>
</div>

<!-- MODAL BREAKDOWN -->
<div class="modal-backdrop" id="modalBackdrop" onclick="fecharModal(event)">
  <div class="modal" id="modal">
    <div class="modal-header">
      <div>
        <div class="modal-name" id="modal-name"></div>
        <div class="modal-tag" id="modal-tag"></div>
      </div>
      <button class="btn-close" onclick="closeModal()">✕</button>
    </div>
    <div id="modal-body"></div>
    <div class="modal-total">
      <span class="lbl">Total</span>
      <span class="val" id="modal-total"></span>
    </div>
  </div>
</div>

<script>
// ── MAPA SIGLA → NOME ─────────────────────────────────────────────────────
const JURIDICO_MAP = {
  "D":  "Daniel", "DL": "Débora", "EZ": "Eduardo", "F":  "Fernanda",
  "JC": "Johnathan", "LF": "Luiz F.", "L":  "Luiz H.", "NE": "Nataly",
  "NS": "Nicolli", "TZ": "Tarciane", "TP": "Tatiana"
};

const CFG = {
  CREDITO_VAL: 20, JOHNATHAN_VAL: 60, ADICIONAL_CREDITOS: 2,
  ADICIONAL_THRESHOLD: 20000, INSERCAO_VAL: 0.50, LIQ_VAL_UNIT: 11.25,
  PREMIO_BASE_VOL: 400000, PREMIO_BASE_VAL: 400, PREMIO_INC_VOL: 100000, PREMIO_INC_VAL: 100
};

let state = {
  comercial: {}, juridico: {}, removedComercial: [], removedJuridico: [],
  totalCreditosEmpresa: 0, manuais: {}
};

const fmt  = v => Number(v).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const fmtN = v => Number(v).toLocaleString('pt-BR');
const cap  = s => s.split(' ').map(w => w.charAt(0).toUpperCase()+w.slice(1)).join(' ');
const sid  = k => k.replace(/[^a-z0-9]/g,'_');

function getManual(key,field){return (state.manuais[key]&&state.manuais[key][field])||0;}
function premioVolume(vol){if(vol<CFG.PREMIO_BASE_VOL)return 0;const f=Math.floor((vol-CFG.PREMIO_BASE_VOL)/CFG.PREMIO_INC_VOL);return CFG.PREMIO_BASE_VAL+f*CFG.PREMIO_INC_VAL;}
function getVal(s){const e=document.querySelector(s);return parseFloat(e?.value)||0;}

function processarPlanilha(data){
  const wb=XLSX.read(data,{type:'array',cellDates:true});
  const sheetName=wb.SheetNames.find(n=>['principal','planilha1'].includes(n.toLowerCase().trim()));
  if(!sheetName){setStatus('Aba "Principal" não encontrada.','error');return;}
  const ws=wb.Sheets[sheetName];
  const rows=XLSX.utils.sheet_to_json(ws,{header:1,defval:null});
  let hRow=-1,colC,colD,colI,colP,colR;
  for(let i=0;i<Math.min(6,rows.length);i++){
    const r=rows[i].map(c=>c?String(c).trim().toUpperCase():'');
    if(r.includes('COMERCIAL')){hRow=i;colC=r.indexOf('COMERCIAL');colD=r.includes('JURÍDICO')?r.indexOf('JURÍDICO'):r.indexOf('JURIDICO');colI=r.indexOf('C');colP=r.indexOf('VALOR');colR=r.indexOf('CONTRATO');break;}
  }
  if(hRow===-1){setStatus('Cabeçalho não encontrado.','error');return;}
  const comercial={},juridico={};let mesRef=null;let totalCreditosEmpresa=0;
  const linhasRaw=[];
  for(let i=hRow+1;i<rows.length;i++){
    const row=rows[i];if(!row||row.every(c=>c===null))continue;
    const contrato=row[colR]?String(row[colR]).trim().toUpperCase():'';
    if(contrato!=='PAGO')continue;
    const valor=parseFloat(row[colP])||0;const creditos=parseFloat(row[colI])||0;
    const adicional=valor>=CFG.ADICIONAL_THRESHOLD?CFG.ADICIONAL_CREDITOS:0;
    totalCreditosEmpresa+=creditos;
    let dataISO='';
    if(row[1]){const d=row[1] instanceof Date?row[1]:new Date(row[1]);if(!isNaN(d)){dataISO=d.toISOString().slice(0,10);if(!mesRef)mesRef=d.toLocaleDateString('pt-BR',{month:'long',year:'numeric'});}}
    const nC=row[colC]?String(row[colC]).trim():'';
    const siglaJur=(colD!==-1&&row[colD])?String(row[colD]).trim().toUpperCase():'';
    const nomeJur=JURIDICO_MAP[siglaJur]||'';
    // Salva linha individual pra dashboard
    linhasRaw.push({data:dataISO,comercial:nC,juridico:nomeJur,siglaJur:siglaJur,creditos:creditos,adicionais:adicional,valor:valor});
    if(nC){const key=nC.toLowerCase();if(!comercial[key])comercial[key]={nome:cap(nC),creditos:0,adicionais:0,volume:0,linhas:0};comercial[key].creditos+=creditos;comercial[key].adicionais+=adicional;comercial[key].volume+=valor;comercial[key].linhas+=1;}
    if(nomeJur){const key=nomeJur.toLowerCase();if(!juridico[key])juridico[key]={nome:nomeJur,sigla:siglaJur,creditos:0,adicionais:0,volume:0,linhas:0};juridico[key].creditos+=creditos;juridico[key].adicionais+=adicional;juridico[key].volume+=valor;juridico[key].linhas+=1;}
  }
  state.comercial=comercial;state.juridico=juridico;
  state.linhasRaw=linhasRaw;
  state.removedComercial=[];state.removedJuridico=[];
  state.totalCreditosEmpresa=totalCreditosEmpresa;
  if(mesRef)document.getElementById('mes-ref').textContent=mesRef;
  const totCredNorm=Object.values(comercial).reduce((s,d)=>s+d.creditos,0);
  const totAdic=Object.values(comercial).reduce((s,d)=>s+d.adicionais,0);
  const totVol=Object.values(comercial).reduce((s,d)=>s+d.volume,0);
  document.getElementById('gc-creditos').textContent=fmtN(totCredNorm);
  document.getElementById('gc-adicionais').textContent=fmtN(totAdic);
  document.getElementById('gc-volume').textContent=fmt(totVol);
  renderAll();renderFinanceiro();
  document.getElementById('appContent').style.display='block';
  document.getElementById('btnFill').style.display='block';
  document.getElementById('btnPdf').style.display='block';
  document.getElementById('btnSalvarSessao').style.display='block';
  applyVisibilityRules();
  setStatus(`Planilha processada · ${Object.keys(comercial).length} comercial · ${Object.keys(juridico).length} jurídico`,'ok');
}

function renderAll(){renderTime('comercial');renderTime('juridico');}
function faixaMultiplicador(v){if(v<=100000)return 5;if(v<=250000)return 10;if(v<=400000)return 15;return 20;}
const FAIXA_NOMES=['fernanda','luiz h.'];
function comissaoBase(tipo,d){if(tipo==='juridico'&&d.nome==='Johnathan')return d.linhas*CFG.JOHNATHAN_VAL;if(tipo==='juridico'&&FAIXA_NOMES.includes(d.nome.toLowerCase())){const m=faixaMultiplicador(d.volume);return(d.creditos+d.adicionais)*m;}return(d.creditos+d.adicionais)*CFG.CREDITO_VAL;}
function comissaoLiquidados(key){const d=state.juridico[key];if(!d||d.nome==='Johnathan')return 0;const liqQt=getVal('#gc-liq-qt');const liqTotal=liqQt*CFG.LIQ_VAL_UNIT;const totalEmpresa=state.totalCreditosEmpresa;if(totalEmpresa===0)return 0;const pct=d.creditos/totalEmpresa;return pct*liqTotal;}

function renderTime(tipo){
  const data=tipo==='comercial'?state.comercial:state.juridico;
  const removed=tipo==='comercial'?state.removedComercial:state.removedJuridico;
  const cardsEl=document.getElementById(`cards-${tipo}`);
  const tbodyEl=document.getElementById(`tbody-${tipo}`);
  const chipsEl=document.getElementById(`chips-${tipo}`);
  const removedSec=document.getElementById(`removed-${tipo}`);
  cardsEl.innerHTML='';tbodyEl.innerHTML='';chipsEl.innerHTML='';
  const nomes=Object.keys(data).filter(n=>!removed.includes(n)).sort((a,b)=>data[b].volume-data[a].volume);
  let totCom=0,totLiq=0,totPvol=0,totTotal=0,totCred=0,totAdic=0,totIns=0,totVol=0;
  nomes.forEach((key,idx)=>{
    const d=data[key];
    const nomeDisp=d.sigla?`${d.nome} (${d.sigla})`:d.nome;
    const isJohnathan=tipo==='juridico'&&d.nome==='Johnathan';
    const isFaixa=tipo==='juridico'&&FAIXA_NOMES.includes(d.nome.toLowerCase());
    const mult=isFaixa?faixaMultiplicador(d.volume):CFG.CREDITO_VAL;
    const comNormal=isJohnathan?0:d.creditos*mult;
    const comAdic=isJohnathan?0:d.adicionais*mult;
    const comJohn=isJohnathan?d.linhas*CFG.JOHNATHAN_VAL:0;
    const comissao=comissaoBase(tipo,d);
    const liqVal=tipo==='juridico'&&!isJohnathan?comissaoLiquidados(key):0;
    const pVol=premioVolume(d.volume);
    const isNicolli=d.nome.toLowerCase()==='nicolli';
    const liqQt=getVal('#gc-liq-qt');
    const liqTotal=liqQt*CFG.LIQ_VAL_UNIT;
    const totalEmp=state.totalCreditosEmpresa;
    const pct=totalEmp>0?(d.creditos/totalEmp*100).toFixed(2):'0.00';
    const liqSubtitle=liqQt>0?`${pct}% × ${fmt(liqTotal)} (total liquidados)`:`Preencha os créditos liquidados`;
    const card=document.createElement('div');
    card.className='person-card';card.dataset.key=key;card.dataset.tipo=tipo;
    card.dataset.nome=d.nome.toLowerCase();
    let comissoesHTML='';
    if(isJohnathan){
      comissoesHTML=`<div class="card-group-label">Comissões</div>
        <div class="row"><span class="lbl">Créditos Comprados<br><span style="font-size:11px;color:var(--mu)">${fmtN(d.linhas)} proc. × R$ 60,00</span></span><span class="val">${fmt(comJohn)}</span></div>
        <div class="row"><span class="lbl">Processos Inseridos<br><span style="font-size:11px;color:var(--mu)" id="ins-sub-${sid(key)}">0 × R$ 0,50</span></span><span class="val" id="row-ins-val-${sid(key)}">R$ 0,00</span></div>`;
    } else {
      const multLabel=`R$ ${mult},00`;
      const faixaInfo=isFaixa?` <span style="font-size:10px;color:var(--gold)">(faixa ativa)</span>`:'';
      comissoesHTML=`<div class="card-group-label">Comissões</div>
        <div class="row"><span class="lbl">Créditos Comprados<br><span style="font-size:11px;color:var(--mu)">${fmtN(d.creditos)} × ${multLabel}${faixaInfo}</span></span><span class="val">${fmt(comNormal)}</span></div>
        <div class="row"><span class="lbl">Créditos Adicionais<br><span style="font-size:11px;color:var(--mu)">${fmtN(d.adicionais)} × ${multLabel}</span></span><span class="val">${fmt(comAdic)}</span></div>
        ${tipo==='juridico'?`<div class="row"><span class="lbl">Processos Inseridos<br><span style="font-size:11px;color:var(--mu)" id="ins-sub-${sid(key)}">0 × R$ 0,50</span></span><span class="val" id="row-ins-val-${sid(key)}">R$ 0,00</span></div>
        <div class="row"><span class="lbl">Processos Liquidados<br><span style="font-size:11px;color:var(--mu)" id="liq-subtitle-${sid(key)}">${liqSubtitle}</span></span><span class="val" id="row-liq-${sid(key)}">${liqQt>0?fmt(liqVal):'—'}</span></div>
        ${isNicolli?`<div class="row"><span class="lbl">Precatório<br><span style="font-size:11px;color:var(--mu)" id="prec-sub-${sid(key)}">0 × R$ 20,00</span></span><span class="val" id="row-prec-val-${sid(key)}">R$ 0,00</span></div>
        <div class="row"><span class="lbl">Precatório Adicional<br><span style="font-size:11px;color:var(--mu)" id="prec2-sub-${sid(key)}">0 × R$ 20,00</span></span><span class="val" id="row-prec2-val-${sid(key)}">R$ 0,00</span></div>`:''}`:''}`;
    }
    let premiosHTML=`<div class="card-divider"></div>
        <div class="card-group-label">Prêmios</div>
        <div class="row"><span class="lbl">Objetivo</span><span class="val">${fmt(pVol)}</span></div>
        <div class="row"><span class="lbl">Objetivo Coletivo</span><span class="val" id="row-objcol-val-${sid(key)}">R$ 0,00</span></div>
        <div class="row"><span class="lbl">${tipo==='comercial'?'Campanha Execução (Meet)':'Campanha Execução (Inserções)'} — 13/04 a 17/04</span><span class="val" id="row-camp-val-${sid(key)}">R$ 0,00</span></div>
        <div class="row"><span class="lbl">${tipo==='comercial'?'Campanha Execução (Meet)':'Campanha Execução (Inserções)'} — 27/04 a 30/04</span><span class="val" id="row-campp2-val-${sid(key)}">R$ 0,00</span></div>
        <div class="row"><span class="lbl">Campanha Volume — 13/04 a 17/04</span><span class="val" id="row-camp2-val-${sid(key)}">R$ 0,00</span></div>
        <div class="row"><span class="lbl">Campanha Volume — 27/04 a 30/04</span><span class="val" id="row-camp2p2-val-${sid(key)}">R$ 0,00</span></div>
        <div class="row"><span class="lbl">Campanha Dupla de Ouro — 13/04 a 17/04</span><span class="val" id="row-camp3-val-${sid(key)}">R$ 0,00</span></div>
        <div class="row"><span class="lbl">Campanha Dupla de Ouro — 27/04 a 30/04</span><span class="val" id="row-camp3p2-val-${sid(key)}">R$ 0,00</span></div>
        ${tipo==='juridico'&&d.nome==='Daniel'?`<div class="row"><span class="lbl">Prêmio Treinamento</span><span class="val" id="row-trein-val-${sid(key)}">R$ 0,00</span></div>`:''}`;
    card.innerHTML=`<div class="card-top">
        <div class="card-top-row">
          <span class="person-name">${nomeDisp}</span>
          <div class="card-actions">
            <button class="btn-preencher" onclick="event.stopPropagation();abrirModalIndividual('${tipo}','${key}')">✏️ Preencher</button>
            <span class="tag ${tipo}">${tipo==='comercial'?'Comercial':'Jurídico'}</span>
            <button class="btn-remove" onclick="event.stopPropagation();remover('${tipo}','${key}')">✕</button>
          </div>
        </div>
        <div class="card-stats">
          ${isJohnathan?`<div class="stat"><div class="stat-val">${fmtN(d.linhas)}</div><div class="stat-label">Processos</div></div><div class="stat"><div class="stat-val">${fmt(d.volume).replace('R$\u00a0','').split(',')[0]}</div><div class="stat-label">Volume</div></div>`:`<div class="stat"><div class="stat-val">${fmtN(d.creditos)}</div><div class="stat-label">Créditos</div></div><div class="stat"><div class="stat-val">${fmtN(d.adicionais)}</div><div class="stat-label">Adicionais</div></div><div class="stat"><div class="stat-val">${fmt(d.volume).replace('R$\u00a0','').split(',')[0]}</div><div class="stat-label">Volume</div></div>`}
        </div>
      </div>
      <div class="card-body" onclick="abrirModal('${tipo}','${key}')">${comissoesHTML}${premiosHTML}<p class="hint">Clique para ver o detalhamento</p></div>
      <div class="card-total">
        <div class="card-total-col"><span class="total-lbl">Comissões</span><span class="total-val" id="subtot-com-${tipo}-${sid(key)}">${fmt(comissao+liqVal)}</span></div>
        <div class="card-total-col"><span class="total-lbl">Prêmios</span><span class="total-val" id="subtot-pre-${tipo}-${sid(key)}">${fmt(pVol)}</span></div>
        <div class="card-total-col"><span class="total-lbl">Total</span><span class="total-val total-main" id="total-${tipo}-${sid(key)}">${fmt(comissao+liqVal+pVol)}</span></div>
      </div>`;
    cardsEl.appendChild(card);
    card.querySelectorAll('input').forEach(inp=>{inp.addEventListener('click',e=>e.stopPropagation());});
    const tr=document.createElement('tr');tr.dataset.key=key;tr.dataset.tipo=tipo;tr.dataset.nome=d.nome.toLowerCase();tr.onclick=()=>abrirModal(tipo,key);
    if(tipo==='juridico'){
      const insQt=getManual(key,'ins');const insVal=insQt*CFG.INSERCAO_VAL;
      const precVal=(getManual(key,'prec')+getManual(key,'prec2'))*20;
      const campVal=getManual(key,'camp')+getManual(key,'campp2');
      const camp2Val=getManual(key,'camp2')+getManual(key,'camp2p2');
      const camp3Val=getManual(key,'camp3')+getManual(key,'camp3p2');
      const objCol=state.manuais[`obj_col_${tipo}`]||0;
      const treinVal=(d.nome==='Daniel')?getManual(key,'trein'):0;
      const rowTotal=comissao+insVal+liqVal+precVal+pVol+objCol+campVal+camp2Val+camp3Val+treinVal;
      tr.innerHTML=`<td>${nomeDisp}</td><td>${fmt(d.volume)}</td>
        <td class="td-com-first" id="s-cred-${sid(key)}">${fmt(isJohnathan?comissao:d.creditos*mult)}</td>
        <td class="td-com" id="s-adic-${sid(key)}">${isJohnathan?'—':fmt(d.adicionais*mult)}</td>
        <td class="td-com" id="s-prec-${sid(key)}">${fmt(getManual(key,'prec')*20)}</td>
        <td class="td-com" id="s-prec2-${sid(key)}">${fmt(getManual(key,'prec2')*20)}</td>
        <td class="td-com" id="s-ins-${sid(key)}">${fmt(insVal)}</td>
        <td class="td-com-last" id="s-liq-${sid(key)}">${fmt(liqVal)}</td>
        <td class="td-pre-first" id="s-pvol-${tipo}-${sid(key)}">${fmt(pVol)}</td>
        <td class="td-pre" id="s-objcol-${tipo}-${sid(key)}">${fmt(objCol)}</td>
        <td class="td-pre" id="s-pcamp-${tipo}-${sid(key)}">${fmt(campVal)}</td>
        <td class="td-pre" id="s-pcamp2-${tipo}-${sid(key)}">${fmt(camp2Val)}</td>
        <td class="td-pre" id="s-pcamp3-${tipo}-${sid(key)}">${fmt(camp3Val)}</td>
        <td class="td-pre-last" id="s-trein-${tipo}-${sid(key)}">${fmt(getManual(key,'trein'))}</td>
        <td id="s-tot-${tipo}-${sid(key)}">${fmt(rowTotal)}</td>`;
    } else {
      const campVal=getManual(key,'camp')+getManual(key,'campp2');
      const camp2Val=getManual(key,'camp2')+getManual(key,'camp2p2');
      const camp3Val=getManual(key,'camp3')+getManual(key,'camp3p2');
      const objCol=state.manuais[`obj_col_${tipo}`]||0;
      const rowTotal=comissao+pVol+objCol+campVal+camp2Val+camp3Val;
      tr.innerHTML=`<td>${nomeDisp}</td><td>${fmt(d.volume)}</td>
        <td class="td-com-first">${fmt(d.creditos*CFG.CREDITO_VAL)}</td>
        <td class="td-com-last">${fmt(d.adicionais*CFG.CREDITO_VAL)}</td>
        <td class="td-pre-first" id="s-pvol-${tipo}-${sid(key)}">${fmt(pVol)}</td>
        <td class="td-pre" id="s-objcol-${tipo}-${sid(key)}">${fmt(objCol)}</td>
        <td class="td-pre" id="s-pcamp-${tipo}-${sid(key)}">${fmt(campVal)}</td>
        <td class="td-pre" id="s-pcamp2-${tipo}-${sid(key)}">${fmt(camp2Val)}</td>
        <td class="td-pre-last" id="s-pcamp3-${tipo}-${sid(key)}">${fmt(camp3Val)}</td>
        <td id="s-tot-${tipo}-${sid(key)}">${fmt(rowTotal)}</td>`;
    }
    tbodyEl.appendChild(tr);
    totCom+=comissao;totLiq+=liqVal;totPvol+=pVol;totTotal+=comissao+liqVal+pVol;
    totCred+=isJohnathan?comissao:d.creditos*mult;totAdic+=isJohnathan?0:d.adicionais*mult;
    totIns+=getManual(key,'ins')*CFG.INSERCAO_VAL;totVol+=d.volume;
  });
  const trT=document.createElement('tr');trT.className='totals-row';
  if(tipo==='juridico'){
    trT.innerHTML=`<td>Total</td><td>${fmt(totVol)}</td><td class="td-com-first" id="st-cred-${tipo}">${fmt(totCred)}</td><td class="td-com" id="st-adic-${tipo}">${fmt(totAdic)}</td><td class="td-com" id="st-prec-${tipo}">—</td><td class="td-com" id="st-prec2-${tipo}">—</td><td class="td-com" id="st-ins-${tipo}">${fmt(totIns)}</td><td class="td-com-last" id="st-liq-${tipo}">${fmt(totLiq)}</td><td class="td-pre-first" id="st-pvol-${tipo}">${fmt(totPvol)}</td><td class="td-pre" id="st-objcol-${tipo}">${fmt(0)}</td><td class="td-pre" id="st-pcamp-${tipo}">${fmt(0)}</td><td class="td-pre" id="st-pcamp2-${tipo}">${fmt(0)}</td><td class="td-pre" id="st-pcamp3-${tipo}">${fmt(0)}</td><td class="td-pre-last" id="st-trein-${tipo}">${fmt(0)}</td><td id="st-tot-${tipo}">${fmt(totTotal)}</td>`;
  } else {
    trT.innerHTML=`<td>Total</td><td>${fmt(totVol)}</td><td class="td-com-first" id="st-cred-${tipo}">${fmt(totCred)}</td><td class="td-com-last" id="st-adic-${tipo}">${fmt(totAdic)}</td><td class="td-pre-first" id="st-pvol-${tipo}">${fmt(totPvol)}</td><td class="td-pre" id="st-objcol-${tipo}">${fmt(0)}</td><td class="td-pre" id="st-pcamp-${tipo}">${fmt(0)}</td><td class="td-pre" id="st-pcamp2-${tipo}">${fmt(0)}</td><td class="td-pre-last" id="st-pcamp3-${tipo}">${fmt(0)}</td><td id="st-tot-${tipo}">${fmt(totTotal)}</td>`;
  }
  tbodyEl.appendChild(trT);
  removed.forEach(key=>{const d=tipo==='comercial'?state.comercial[key]:state.juridico[key];const chip=document.createElement('div');chip.className='removed-chip';chip.innerHTML=`${d?.nome||key} <button class="btn-restore" onclick="restaurar('${tipo}','${key}')">↩</button>`;chipsEl.appendChild(chip);});
  removedSec.style.display=removed.length>0?'block':'none';
  applyVisibilityRules();
}

function renderFinanceiro(){
  const cardsEl=document.getElementById('cards-financeiro');const tbodyEl=document.getElementById('tbody-financeiro');
  cardsEl.innerHTML='';tbodyEl.innerHTML='';
  const card=document.createElement('div');card.className='person-card';
  card.innerHTML=`<div class="card-top"><div class="card-top-row"><span class="person-name">Marco Antônio</span><span class="tag financeiro">Financeiro/ADM</span></div></div>
    <div class="card-body" onclick="abrirModalFinanceiro()">
      <div class="card-group-label">Prêmios</div>
      <div class="row"><span class="lbl">Prêmio Execução</span><span class="val" id="fin-exec-val">R$ 0,00</span></div>
      <div class="row"><span class="lbl">Prêmio Resultado</span><span class="val" id="fin-res-val">R$ 0,00</span></div>
      <div class="row"><span class="lbl">Objetivo Coletivo</span><span class="val" id="fin-objcol-val">R$ 0,00</span></div>
      <p class="hint">Clique para ver o detalhamento</p>
    </div>
    <div class="card-total"><div class="card-total-col" style="grid-column:1/-1"><span class="total-lbl">Total</span><span class="total-val total-main" id="total-fin">R$ 0,00</span></div></div>`;
  cardsEl.appendChild(card);
  const tr=document.createElement('tr');tr.onclick=()=>abrirModalFinanceiro();tr.style.cursor='pointer';
  tr.innerHTML=`<td>Marco Antônio</td><td class="td-pre-first" id="s-fin-exec">R$ 0,00</td><td class="td-pre" id="s-fin-res">R$ 0,00</td><td class="td-pre-last" id="s-fin-objcol">R$ 0,00</td><td id="s-fin-tot">R$ 0,00</td>`;
  tbodyEl.appendChild(tr);
}

function recalcFinanceiro(){
  const exec=state.manuais['marco_fin_exec']||0;const res=state.manuais['marco_fin_res']||0;
  const objCol=state.manuais['obj_col_financeiro']||0;const premios=exec+res+objCol;const tot=premios;
  const el=id=>document.getElementById(id);
  if(el('total-fin'))el('total-fin').textContent=fmt(tot);
  if(el('fin-exec-val'))el('fin-exec-val').textContent=fmt(exec);
  if(el('fin-res-val'))el('fin-res-val').textContent=fmt(res);
  if(el('fin-objcol-val'))el('fin-objcol-val').textContent=fmt(objCol);
  if(el('s-fin-exec'))el('s-fin-exec').textContent=fmt(exec);
  if(el('s-fin-res'))el('s-fin-res').textContent=fmt(res);
  if(el('s-fin-objcol'))el('s-fin-objcol').textContent=fmt(objCol);
  if(el('s-fin-tot'))el('s-fin-tot').textContent=fmt(tot);
}

function recalcLiquidados(){
  const liqQt=getVal('#gc-liq-qt');const liqVal=liqQt*CFG.LIQ_VAL_UNIT;
  document.getElementById('gc-liq-val').textContent=fmt(liqVal);
  const removed=state.removedJuridico;
  Object.keys(state.juridico).filter(k=>!removed.includes(k)).forEach(key=>{
    const d=state.juridico[key];if(d.nome==='Johnathan')return;
    const lv=comissaoLiquidados(key);const liqQtVal=getVal('#gc-liq-qt');
    const liqTotalVal=liqQtVal*CFG.LIQ_VAL_UNIT;const totalEmp=state.totalCreditosEmpresa;
    const pct=totalEmp>0?(d.creditos/totalEmp*100).toFixed(2):'0.00';
    const subtitle=liqQtVal>0?`${pct}% × ${fmt(liqTotalVal)} (total liquidados)`:`Preencha os créditos liquidados`;
    const elR=document.getElementById(`row-liq-${sid(key)}`);if(elR)elR.textContent=liqQtVal>0?fmt(lv):'—';
    const elSub=document.getElementById(`liq-subtitle-${sid(key)}`);if(elSub)elSub.textContent=subtitle;
    const elS=document.getElementById(`s-liq-${sid(key)}`);if(elS)elS.textContent=fmt(lv);
    _recalcCardInternal('juridico',key);
  });
  recalcTotals('juridico');
}

function _recalcCardInternal(tipo,key){
  const d=tipo==='comercial'?state.comercial[key]:state.juridico[key];if(!d)return;
  const isJohnathan=tipo==='juridico'&&d.nome==='Johnathan';
  const comissao=comissaoBase(tipo,d);
  const insQt=tipo==='juridico'?getManual(key,'ins'):0;
  const insVal=insQt*CFG.INSERCAO_VAL;
  const liqVal=(tipo==='juridico'&&!isJohnathan)?comissaoLiquidados(key):0;
  const pVol=premioVolume(d.volume);
  const pCamp=getManual(key,'camp')+getManual(key,'campp2');
  const pCamp2=getManual(key,'camp2')+getManual(key,'camp2p2');
  const pCamp3=getManual(key,'camp3')+getManual(key,'camp3p2');
  const objCol=state.manuais[`obj_col_${tipo}`]||0;
  const precQt=getManual(key,'prec');const precQt2=getManual(key,'prec2');
  const precVal=(precQt+precQt2)*20;
  const trein=(tipo==='juridico'&&d.nome==='Daniel')?getManual(key,'trein'):0;
  const total=comissao+insVal+liqVal+pVol+objCol+pCamp+pCamp2+pCamp3+precVal+trein;
  const el=id=>document.getElementById(id);
  if(el(`total-${tipo}-${sid(key)}`))el(`total-${tipo}-${sid(key)}`).textContent=fmt(total);
  if(el(`subtot-com-${tipo}-${sid(key)}`))el(`subtot-com-${tipo}-${sid(key)}`).textContent=fmt(comissao+insVal+liqVal+precVal);
  if(el(`subtot-pre-${tipo}-${sid(key)}`))el(`subtot-pre-${tipo}-${sid(key)}`).textContent=fmt(pVol+objCol+pCamp+pCamp2+pCamp3+trein);
  if(el(`row-trein-val-${sid(key)}`))el(`row-trein-val-${sid(key)}`).textContent=fmt(trein);
  if(el(`row-objcol-val-${sid(key)}`))el(`row-objcol-val-${sid(key)}`).textContent=fmt(objCol);
  if(el(`s-ins-${sid(key)}`))el(`s-ins-${sid(key)}`).textContent=fmtN(insQt);
  if(el(`s-liq-${sid(key)}`))el(`s-liq-${sid(key)}`).textContent=fmt(liqVal);
  if(el(`row-ins-val-${sid(key)}`))el(`row-ins-val-${sid(key)}`).textContent=fmt(insVal);
  if(el(`ins-sub-${sid(key)}`))el(`ins-sub-${sid(key)}`).textContent=`${fmtN(insQt)} × R$ 0,50`;
  if(el(`row-prec-val-${sid(key)}`))el(`row-prec-val-${sid(key)}`).textContent=fmt(precQt*20);
  if(el(`prec-sub-${sid(key)}`))el(`prec-sub-${sid(key)}`).textContent=`${fmtN(precQt)} × R$ 20,00`;
  if(el(`prec2-sub-${sid(key)}`))el(`prec2-sub-${sid(key)}`).textContent=`${fmtN(precQt2)} × R$ 20,00`;
  if(el(`row-prec2-val-${sid(key)}`))el(`row-prec2-val-${sid(key)}`).textContent=fmt(precQt2*20);
  if(el(`row-camp-val-${sid(key)}`))el(`row-camp-val-${sid(key)}`).textContent=fmt(getManual(key,'camp'));
  if(el(`row-campp2-val-${sid(key)}`))el(`row-campp2-val-${sid(key)}`).textContent=fmt(getManual(key,'campp2'));
  if(el(`row-camp2-val-${sid(key)}`))el(`row-camp2-val-${sid(key)}`).textContent=fmt(getManual(key,'camp2'));
  if(el(`row-camp2p2-val-${sid(key)}`))el(`row-camp2p2-val-${sid(key)}`).textContent=fmt(getManual(key,'camp2p2'));
  if(el(`row-camp3-val-${sid(key)}`))el(`row-camp3-val-${sid(key)}`).textContent=fmt(getManual(key,'camp3'));
  if(el(`row-camp3p2-val-${sid(key)}`))el(`row-camp3p2-val-${sid(key)}`).textContent=fmt(getManual(key,'camp3p2'));
  if(el(`s-pvol-${tipo}-${sid(key)}`))el(`s-pvol-${tipo}-${sid(key)}`).textContent=fmt(pVol);
  if(el(`s-tot-${tipo}-${sid(key)}`))el(`s-tot-${tipo}-${sid(key)}`).textContent=fmt(total);
}

let _addPessoaTipo=null;
function abrirModalAddPessoa(tipo){_addPessoaTipo=tipo;document.getElementById('modalAddTitle').textContent=`Adicionar pessoa — ${tipo==='comercial'?'Comercial':'Jurídico'}`;document.getElementById('add-nome').value='';document.getElementById('add-sigla').value='';document.getElementById('modalAddBackdrop').classList.add('open');setTimeout(()=>document.getElementById('add-nome').focus(),100);}
function confirmarAddPessoa(){const nome=document.getElementById('add-nome').value.trim();const sigla=document.getElementById('add-sigla').value.trim().toUpperCase();if(!nome){alert('Informe o nome.');return;}if(!sigla){alert('Informe a sigla.');return;}const key=nome.toLowerCase().replace(/\s+/g,'_')+'_manual';if(_addPessoaTipo==='comercial'){if(state.comercial[key]){alert('Já existe.');return;}state.comercial[key]={nome,sigla:null,creditos:0,adicionais:0,volume:0,_manual:true};}else{if(state.juridico[key]){alert('Já existe.');return;}state.juridico[key]={nome,sigla,creditos:0,adicionais:0,volume:0,linhas:0,_manual:true};}document.getElementById('modalAddBackdrop').classList.remove('open');renderTime(_addPessoaTipo);recalcTotals(_addPessoaTipo);}

let _modalIndTipo=null,_modalIndKey=null,_modalIndDirty=false;
function abrirModalIndividual(tipo,key){_modalIndTipo=tipo;_modalIndKey=key;_modalIndDirty=false;const d=tipo==='comercial'?state.comercial[key]:state.juridico[key];const m=state.manuais[key]||{};const nomeDisp=d.sigla?`${d.nome} (${d.sigla})`:d.nome;const isJohn=tipo==='juridico'&&d.nome==='Johnathan';const isNic=tipo==='juridico'&&d.nome.toLowerCase()==='nicolli';const execLabel=tipo==='comercial'?'Campanha Execução (Meet)':'Campanha Execução (Inserções)';document.getElementById('modalIndTitle').textContent=nomeDisp;
const field=(label,id,value,hint='')=>`<div class="mm-field"><label>${label}</label><div class="mm-field-right"><input type="number" min="0" step="0.01" class="mm-input ind-field" id="ind-${id}" value="${value||0}" placeholder="0,00" oninput="_modalIndDirty=true">${hint?`<span class="mm-input-hint">${hint}</span>`:''}</div></div>`;
let html='';
if(tipo==='juridico'){html+=field('Processos Inseridos','ins',m.ins||0,'× R$ 0,50');if(isNic){html+=field('Precatório (qtd.)','prec',m.prec||0,'× R$ 20,00');html+=field('Precatório Adicional (qtd.)','prec2',m.prec2||0,'× R$ 20,00');}}
html+=`<div style="font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mu);margin:14px 0 8px;padding-bottom:6px;border-bottom:1px solid var(--bo)">Campanhas</div>`;
html+=field(`${execLabel} — 13/04 a 17/04`,'camp',m.camp||0);
html+=field(`${execLabel} — 27/04 a 30/04`,'campp2',m.campp2||0);
html+=field('Campanha Volume — 13/04 a 17/04','camp2',m.camp2||0);
html+=field('Campanha Volume — 27/04 a 30/04','camp2p2',m.camp2p2||0);
html+=field('Campanha Dupla de Ouro — 13/04 a 17/04','camp3',m.camp3||0);
html+=field('Campanha Dupla de Ouro — 27/04 a 30/04','camp3p2',m.camp3p2||0);
if(tipo==='juridico'&&d.nome==='Daniel'){html+=`<div style="font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mu);margin:14px 0 8px;padding-bottom:6px;border-bottom:1px solid var(--bo)">Prêmios Especiais</div>`;html+=field('Prêmio Treinamento','trein',m.trein||0);}
document.getElementById('modalIndBody').innerHTML=html;document.getElementById('modalIndBackdrop').classList.add('open');}
function aplicarModalInd(){const tipo=_modalIndTipo;const key=_modalIndKey;const d=tipo==='comercial'?state.comercial[key]:state.juridico[key];const isNic=tipo==='juridico'&&d.nome.toLowerCase()==='nicolli';if(!state.manuais[key])state.manuais[key]={};const m=state.manuais[key];const get=id=>parseFloat(document.getElementById(`ind-${id}`)?.value)||0;if(tipo==='juridico'){m.ins=get('ins');if(isNic){m.prec=get('prec');m.prec2=get('prec2');}}m.camp=get('camp');m.campp2=get('campp2');m.camp2=get('camp2');m.camp2p2=get('camp2p2');m.camp3=get('camp3');m.camp3p2=get('camp3p2');if(tipo==='juridico'&&d.nome==='Daniel')m.trein=get('trein');_recalcCardInternal(tipo,key);recalcTotals(tipo);_modalIndDirty=false;document.getElementById('modalIndBackdrop').classList.remove('open');}
function fecharModalInd(c){if(c&&_modalIndDirty){if(!confirm('Descartar?'))return;}_modalIndDirty=false;document.getElementById('modalIndBackdrop').classList.remove('open');}
document.addEventListener('click',e=>{const b=document.getElementById('modalIndBackdrop');if(b&&e.target===b)fecharModalInd(true);});

function abrirModalManuais(){
  const body=document.getElementById('mmBody');body.innerHTML='';
  const jurRem=state.removedJuridico;
  const jurNomes=Object.keys(state.juridico).filter(k=>!jurRem.includes(k)).sort((a,b)=>state.juridico[b].volume-state.juridico[a].volume);
  if(jurNomes.length){const sec=document.createElement('div');sec.className='mm-team';sec.innerHTML=`<div class="mm-team-label">Jurídico</div><div class="mm-person"><div class="mm-person-name" style="font-size:12px;font-weight:600;color:var(--mu)">Prêmio coletivo</div><div class="mm-field"><label>Prêmio Objetivo Coletivo</label><input type="number" min="0" step="0.01" class="mm-input" id="mm-obj-col-juridico" value="${state.manuais['obj_col_juridico']||0}" placeholder="0,00"></div></div>`;jurNomes.forEach(key=>{const d=state.juridico[key];const isJohn=d.nome==='Johnathan';const isNic=d.nome.toLowerCase()==='nicolli';const m=state.manuais[key]||{};const nomeDisp=d.sigla?`${d.nome} (${d.sigla})`:d.nome;const p=document.createElement('div');p.className='mm-person';p.innerHTML=`<div class="mm-person-name">${nomeDisp}</div><div class="mm-field"><label>Processos Inseridos</label><div class="mm-field-right"><input type="number" min="0" step="1" class="mm-input" id="mm-ins-${sid(key)}" value="${m.ins||0}" placeholder="0"><span class="mm-input-hint">× R$ 0,50</span></div></div>${isNic?`<div class="mm-field"><label>Precatório (qtd.)</label><div class="mm-field-right"><input type="number" min="0" step="1" class="mm-input" id="mm-prec-${sid(key)}" value="${m.prec||0}" placeholder="0"><span class="mm-input-hint">× R$ 20,00</span></div></div><div class="mm-field"><label>Precatório Adicional (qtd.)</label><div class="mm-field-right"><input type="number" min="0" step="1" class="mm-input" id="mm-prec2-${sid(key)}" value="${m.prec2||0}" placeholder="0"><span class="mm-input-hint">× R$ 20,00</span></div></div>`:''}<div class="mm-field"><label>Camp. Exec. — 13/04</label><div class="mm-field-right"><input type="number" min="0" step="0.01" class="mm-input" id="mm-camp-jur-${sid(key)}" value="${m.camp||0}"></div></div><div class="mm-field"><label>Camp. Exec. — 27/04</label><div class="mm-field-right"><input type="number" min="0" step="0.01" class="mm-input" id="mm-camp-jur-p2-${sid(key)}" value="${m.campp2||0}"></div></div><div class="mm-field"><label>Camp. Volume — 13/04</label><div class="mm-field-right"><input type="number" min="0" step="0.01" class="mm-input" id="mm-camp2-jur-${sid(key)}" value="${m.camp2||0}"></div></div><div class="mm-field"><label>Camp. Volume — 27/04</label><div class="mm-field-right"><input type="number" min="0" step="0.01" class="mm-input" id="mm-camp2-jur-p2-${sid(key)}" value="${m.camp2p2||0}"></div></div><div class="mm-field"><label>Dupla Ouro — 13/04</label><div class="mm-field-right"><input type="number" min="0" step="0.01" class="mm-input" id="mm-camp3-jur-${sid(key)}" value="${m.camp3||0}"></div></div><div class="mm-field"><label>Dupla Ouro — 27/04</label><div class="mm-field-right"><input type="number" min="0" step="0.01" class="mm-input" id="mm-camp3-jur-p2-${sid(key)}" value="${m.camp3p2||0}"></div></div>${d.nome==='Daniel'?`<div class="mm-field"><label>Treinamento</label><div class="mm-field-right"><input type="number" min="0" step="0.01" class="mm-input" id="mm-trein-${sid(key)}" value="${m.trein||0}"></div></div>`:''}`;sec.appendChild(p);});body.appendChild(sec);}
  const comRem=state.removedComercial;
  const comNomes=Object.keys(state.comercial).filter(k=>!comRem.includes(k)).sort((a,b)=>state.comercial[b].volume-state.comercial[a].volume);
  if(comNomes.length){const sec=document.createElement('div');sec.className='mm-team';sec.innerHTML=`<div class="mm-team-label">Comercial</div><div class="mm-person"><div class="mm-person-name" style="font-size:12px;font-weight:600;color:var(--mu)">Prêmio coletivo</div><div class="mm-field"><label>Prêmio Objetivo Coletivo</label><input type="number" min="0" step="0.01" class="mm-input" id="mm-obj-col-comercial" value="${state.manuais['obj_col_comercial']||0}" placeholder="0,00"></div></div>`;comNomes.forEach(key=>{const d=state.comercial[key];const m=state.manuais[key]||{};const p=document.createElement('div');p.className='mm-person';p.innerHTML=`<div class="mm-person-name">${d.nome}</div><div class="mm-field"><label>Camp. Exec. — 13/04</label><div class="mm-field-right"><input type="number" min="0" step="0.01" class="mm-input" id="mm-camp-com-${sid(key)}" value="${m.camp||0}"></div></div><div class="mm-field"><label>Camp. Exec. — 27/04</label><div class="mm-field-right"><input type="number" min="0" step="0.01" class="mm-input" id="mm-camp-com-p2-${sid(key)}" value="${m.campp2||0}"></div></div><div class="mm-field"><label>Camp. Volume — 13/04</label><div class="mm-field-right"><input type="number" min="0" step="0.01" class="mm-input" id="mm-camp2-com-${sid(key)}" value="${m.camp2||0}"></div></div><div class="mm-field"><label>Camp. Volume — 27/04</label><div class="mm-field-right"><input type="number" min="0" step="0.01" class="mm-input" id="mm-camp2-com-p2-${sid(key)}" value="${m.camp2p2||0}"></div></div><div class="mm-field"><label>Dupla Ouro — 13/04</label><div class="mm-field-right"><input type="number" min="0" step="0.01" class="mm-input" id="mm-camp3-com-${sid(key)}" value="${m.camp3||0}"></div></div><div class="mm-field"><label>Dupla Ouro — 27/04</label><div class="mm-field-right"><input type="number" min="0" step="0.01" class="mm-input" id="mm-camp3-com-p2-${sid(key)}" value="${m.camp3p2||0}"></div></div>`;sec.appendChild(p);});body.appendChild(sec);}
  const finExec=state.manuais['marco_fin_exec']||0;const finRes=state.manuais['marco_fin_res']||0;
  const secFin=document.createElement('div');secFin.className='mm-team';
  secFin.innerHTML=`<div class="mm-team-label">Financeiro / ADM</div><div class="mm-person"><div class="mm-person-name" style="font-size:12px;font-weight:600;color:var(--mu)">Prêmio coletivo</div><div class="mm-field"><label>Prêmio Objetivo Coletivo</label><input type="number" min="0" step="0.01" class="mm-input" id="mm-obj-col-financeiro" value="${state.manuais['obj_col_financeiro']||0}" placeholder="0,00"></div></div><div class="mm-person"><div class="mm-person-name">Marco Antônio</div><div class="mm-field"><label>Prêmio Execução</label><input type="number" min="0" step="0.01" class="mm-input" id="mm-fin-exec" value="${finExec}"></div><div class="mm-field"><label>Prêmio Resultado</label><input type="number" min="0" step="0.01" class="mm-input" id="mm-fin-res" value="${finRes}"></div></div>`;
  body.appendChild(secFin);
  document.getElementById('modalManuaisBackdrop').classList.add('open');
}

function aplicarManuais(){
  state.manuais['obj_col_juridico']=parseFloat(document.getElementById('mm-obj-col-juridico')?.value)||0;
  state.manuais['obj_col_comercial']=parseFloat(document.getElementById('mm-obj-col-comercial')?.value)||0;
  state.manuais['obj_col_financeiro']=parseFloat(document.getElementById('mm-obj-col-financeiro')?.value)||0;
  const jurRem=state.removedJuridico;
  Object.keys(state.juridico).filter(k=>!jurRem.includes(k)).forEach(key=>{
    const d=state.juridico[key];const isNic=d.nome.toLowerCase()==='nicolli';
    if(!state.manuais[key])state.manuais[key]={};
    state.manuais[key].ins=parseFloat(document.getElementById(`mm-ins-${sid(key)}`)?.value)||0;
    state.manuais[key].camp=parseFloat(document.getElementById(`mm-camp-jur-${sid(key)}`)?.value)||0;
    state.manuais[key].campp2=parseFloat(document.getElementById(`mm-camp-jur-p2-${sid(key)}`)?.value)||0;
    state.manuais[key].camp2=parseFloat(document.getElementById(`mm-camp2-jur-${sid(key)}`)?.value)||0;
    state.manuais[key].camp2p2=parseFloat(document.getElementById(`mm-camp2-jur-p2-${sid(key)}`)?.value)||0;
    state.manuais[key].camp3=parseFloat(document.getElementById(`mm-camp3-jur-${sid(key)}`)?.value)||0;
    state.manuais[key].camp3p2=parseFloat(document.getElementById(`mm-camp3-jur-p2-${sid(key)}`)?.value)||0;
    state.manuais[key].trein=d.nome==='Daniel'?(parseFloat(document.getElementById(`mm-trein-${sid(key)}`)?.value)||0):0;
    state.manuais[key].prec=isNic?(parseFloat(document.getElementById(`mm-prec-${sid(key)}`)?.value)||0):0;
    state.manuais[key].prec2=isNic?(parseFloat(document.getElementById(`mm-prec2-${sid(key)}`)?.value)||0):0;
    _recalcCardInternal('juridico',key);
  });
  recalcTotals('juridico');
  const comRem=state.removedComercial;
  Object.keys(state.comercial).filter(k=>!comRem.includes(k)).forEach(key=>{
    if(!state.manuais[key])state.manuais[key]={};
    state.manuais[key].camp=parseFloat(document.getElementById(`mm-camp-com-${sid(key)}`)?.value)||0;
    state.manuais[key].campp2=parseFloat(document.getElementById(`mm-camp-com-p2-${sid(key)}`)?.value)||0;
    state.manuais[key].camp2=parseFloat(document.getElementById(`mm-camp2-com-${sid(key)}`)?.value)||0;
    state.manuais[key].camp2p2=parseFloat(document.getElementById(`mm-camp2-com-p2-${sid(key)}`)?.value)||0;
    state.manuais[key].camp3=parseFloat(document.getElementById(`mm-camp3-com-${sid(key)}`)?.value)||0;
    state.manuais[key].camp3p2=parseFloat(document.getElementById(`mm-camp3-com-p2-${sid(key)}`)?.value)||0;
    _recalcCardInternal('comercial',key);
  });
  recalcTotals('comercial');
  state.manuais['marco_fin_exec']=parseFloat(document.getElementById('mm-fin-exec')?.value)||0;
  state.manuais['marco_fin_res']=parseFloat(document.getElementById('mm-fin-res')?.value)||0;
  recalcFinanceiro();closeModalManuais();
}
function fecharModalManuais(e){if(e.target===document.getElementById('modalManuaisBackdrop'))closeModalManuais();}
function closeModalManuais(){document.getElementById('modalManuaisBackdrop').classList.remove('open');}

function recalcCard(tipo,key){_recalcCardInternal(tipo,key);recalcTotals(tipo);}
function recalcTotals(tipo){
  const data=tipo==='comercial'?state.comercial:state.juridico;
  const removed=tipo==='comercial'?state.removedComercial:state.removedJuridico;
  const nomes=Object.keys(data).filter(k=>!removed.includes(k));
  const objCol=state.manuais[`obj_col_${tipo}`]||0;
  let tCred=0,tAdic=0,tPrec=0,tPrec2=0,tIns=0,tLiq=0,tPv=0,tOc=0,tPc=0,tPc2=0,tPc3=0,tTrein=0,tT=0;
  nomes.forEach(key=>{
    const d=data[key];const isJ=tipo==='juridico'&&d.nome==='Johnathan';
    const isFx=tipo==='juridico'&&FAIXA_NOMES.includes(d.nome.toLowerCase());
    const mult=isFx?faixaMultiplicador(d.volume):CFG.CREDITO_VAL;
    const credVal=isJ?comissaoBase(tipo,d):d.creditos*mult;
    const adicVal=isJ?0:d.adicionais*mult;
    const insQt=(tipo==='juridico'&&!isJ)?getManual(key,'ins'):0;
    const insVal=insQt*CFG.INSERCAO_VAL;
    const liq=tipo==='juridico'?comissaoLiquidados(key):0;
    const pv=premioVolume(d.volume);
    const pc=getManual(key,'camp')+getManual(key,'campp2');
    const pc2=getManual(key,'camp2')+getManual(key,'camp2p2');
    const pc3=getManual(key,'camp3')+getManual(key,'camp3p2');
    const pr=(getManual(key,'prec')+getManual(key,'prec2'))*20;
    const trein=(tipo==='juridico'&&d.nome==='Daniel')?getManual(key,'trein'):0;
    const tot=credVal+adicVal+insVal+liq+pv+objCol+pc+pc2+pc3+pr+trein;
    tCred+=credVal;tAdic+=adicVal;tPrec+=getManual(key,'prec')*20;tPrec2+=getManual(key,'prec2')*20;tIns+=insVal;tLiq+=liq;tPv+=pv;tOc+=objCol;tPc+=pc;tPc2+=pc2;tPc3+=pc3;tT+=tot;tTrein+=trein;
    const e2=id=>document.getElementById(id);
    if(e2(`s-prec-${sid(key)}`))e2(`s-prec-${sid(key)}`).textContent=fmt(getManual(key,'prec')*20);
    if(e2(`s-prec2-${sid(key)}`))e2(`s-prec2-${sid(key)}`).textContent=fmt(getManual(key,'prec2')*20);
    if(e2(`s-ins-${sid(key)}`))e2(`s-ins-${sid(key)}`).textContent=fmt(insVal);
    if(e2(`s-liq-${sid(key)}`))e2(`s-liq-${sid(key)}`).textContent=fmt(liq);
    if(e2(`s-pvol-${tipo}-${sid(key)}`))e2(`s-pvol-${tipo}-${sid(key)}`).textContent=fmt(pv);
    if(e2(`s-objcol-${tipo}-${sid(key)}`))e2(`s-objcol-${tipo}-${sid(key)}`).textContent=fmt(objCol);
    if(e2(`s-pcamp-${tipo}-${sid(key)}`))e2(`s-pcamp-${tipo}-${sid(key)}`).textContent=fmt(pc);
    if(e2(`s-pcamp2-${tipo}-${sid(key)}`))e2(`s-pcamp2-${tipo}-${sid(key)}`).textContent=fmt(pc2);
    if(e2(`s-pcamp3-${tipo}-${sid(key)}`))e2(`s-pcamp3-${tipo}-${sid(key)}`).textContent=fmt(pc3);
    if(e2(`s-trein-${tipo}-${sid(key)}`))e2(`s-trein-${tipo}-${sid(key)}`).textContent=fmt(trein);
    if(e2(`s-tot-${tipo}-${sid(key)}`))e2(`s-tot-${tipo}-${sid(key)}`).textContent=fmt(tot);
  });
  const el=id=>document.getElementById(id);
  if(el(`st-cred-${tipo}`))el(`st-cred-${tipo}`).textContent=fmt(tCred);
  if(el(`st-adic-${tipo}`))el(`st-adic-${tipo}`).textContent=fmt(tAdic);
  if(el(`st-prec-${tipo}`))el(`st-prec-${tipo}`).textContent=fmt(tPrec);
  if(el(`st-prec2-${tipo}`))el(`st-prec2-${tipo}`).textContent=fmt(tPrec2);
  if(el(`st-ins-${tipo}`))el(`st-ins-${tipo}`).textContent=fmt(tIns);
  if(el(`st-liq-${tipo}`))el(`st-liq-${tipo}`).textContent=fmt(tLiq);
  if(el(`st-pvol-${tipo}`))el(`st-pvol-${tipo}`).textContent=fmt(tPv);
  if(el(`st-objcol-${tipo}`))el(`st-objcol-${tipo}`).textContent=fmt(tOc);
  if(el(`st-pcamp-${tipo}`))el(`st-pcamp-${tipo}`).textContent=fmt(tPc);
  if(el(`st-pcamp2-${tipo}`))el(`st-pcamp2-${tipo}`).textContent=fmt(tPc2);
  if(el(`st-pcamp3-${tipo}`))el(`st-pcamp3-${tipo}`).textContent=fmt(tPc3);
  if(el(`st-trein-${tipo}`))el(`st-trein-${tipo}`).textContent=fmt(tTrein);
  if(el(`st-tot-${tipo}`))el(`st-tot-${tipo}`).textContent=fmt(tT);
}

function abrirModal(tipo,key){
  const d=tipo==='comercial'?state.comercial[key]:state.juridico[key];if(!d)return;
  const isJohnathan=tipo==='juridico'&&d.nome==='Johnathan';
  const nomeDisp=d.sigla?`${d.nome} (${d.sigla})`:d.nome;
  const comissao=comissaoBase(tipo,d);
  const insQt=(tipo==='juridico'&&!isJohnathan)?getManual(key,'ins'):0;
  const insVal=insQt*CFG.INSERCAO_VAL;
  const liqVal=tipo==='juridico'?comissaoLiquidados(key):0;
  const pVol=premioVolume(d.volume);
  const pCamp=getManual(key,'camp')+getManual(key,'campp2');
  const pCamp2=getManual(key,'camp2')+getManual(key,'camp2p2');
  const pCamp3=getManual(key,'camp3')+getManual(key,'camp3p2');
  const objCol=state.manuais[`obj_col_${tipo}`]||0;
  const precQt=getManual(key,'prec');const precQt2=getManual(key,'prec2');
  const precVal=(precQt+precQt2)*20;
  const total=comissao+insVal+liqVal+pVol+objCol+pCamp+pCamp2+pCamp3+precVal;
  document.getElementById('modal-name').textContent=nomeDisp;
  document.getElementById('modal-tag').innerHTML=`<span class="tag ${tipo}">${tipo==='comercial'?'Comercial':'Jurídico'}</span>`;
  let html='';
  if(isJohnathan){
    html+=`<div class="modal-section"><div class="modal-section-title">Comissão por processo</div><div class="breakdown-row"><span class="blbl">Processos PAGO</span><span class="bval">${fmtN(d.linhas)}</span></div><div class="breakdown-row"><span class="blbl">Valor por processo</span><span class="bval">R$ 60,00</span></div><div class="breakdown-row"><span class="blbl">Comissão total</span><span class="bval green">${fmt(comissao)}</span></div></div>`;
  } else {
    const isFaixaModal=tipo==='juridico'&&FAIXA_NOMES.includes(d.nome.toLowerCase());
    const multModal=isFaixaModal?faixaMultiplicador(d.volume):CFG.CREDITO_VAL;
    html+=`<div class="modal-section"><div class="modal-section-title">Créditos</div><div class="breakdown-row"><span class="blbl">Créditos normais</span><span class="bval">${fmtN(d.creditos)}</span></div><div class="breakdown-row"><span class="blbl">Créditos adicionais</span><span class="bval">${fmtN(d.adicionais)}</span></div><div class="breakdown-row"><span class="blbl">Comissão</span><span class="bval green">${fmt(comissao)}</span></div></div>`;
  }
  if(tipo==='juridico'&&!isJohnathan){
    html+=`<div class="modal-section"><div class="modal-section-title">Inseridos / Liquidados</div><div class="breakdown-row"><span class="blbl">Inserções</span><span class="bval">${fmtN(insQt)}</span></div><div class="breakdown-row"><span class="blbl">Comissão inserções</span><span class="bval green">${fmt(insVal)}</span></div><div class="breakdown-row"><span class="blbl">Comissão liquidados</span><span class="bval green">${fmt(liqVal)}</span></div></div>`;
  }
  html+=`<div class="modal-section"><div class="modal-section-title">Prêmios</div><div class="breakdown-row"><span class="blbl">Volume</span><span class="bval">${fmt(d.volume)}</span></div><div class="breakdown-row"><span class="blbl">Prêmio Objetivo</span><span class="bval gold">${fmt(pVol)}</span></div><div class="breakdown-row"><span class="blbl">Campanhas</span><span class="bval gold">${fmt(pCamp+pCamp2+pCamp3)}</span></div></div>`;
  document.getElementById('modal-body').innerHTML=html;
  document.getElementById('modal-total').textContent=fmt(total);
  document.getElementById('modalBackdrop').classList.add('open');
}
function abrirModalFinanceiro(){const exec=state.manuais['marco_fin_exec']||0;const res=state.manuais['marco_fin_res']||0;const objCol=state.manuais['obj_col_financeiro']||0;const total=exec+res+objCol;document.getElementById('modal-name').textContent='Marco Antônio';document.getElementById('modal-tag').innerHTML=`<span class="tag financeiro">Financeiro/ADM</span>`;document.getElementById('modal-body').innerHTML=`<div class="modal-section"><div class="modal-section-title">Prêmios</div><div class="breakdown-row"><span class="blbl">Execução</span><span class="bval gold">${fmt(exec)}</span></div><div class="breakdown-row"><span class="blbl">Resultado</span><span class="bval gold">${fmt(res)}</span></div><div class="breakdown-row"><span class="blbl">Objetivo Coletivo</span><span class="bval gold">${fmt(objCol)}</span></div></div>`;document.getElementById('modal-total').textContent=fmt(total);document.getElementById('modalBackdrop').classList.add('open');}
function fecharModal(e){if(e.target===document.getElementById('modalBackdrop'))closeModal();}
function closeModal(){document.getElementById('modalBackdrop').classList.remove('open');}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();});

function remover(tipo,key){if(tipo==='comercial')state.removedComercial.push(key);else state.removedJuridico.push(key);renderTime(tipo);}
function restaurar(tipo,key){if(tipo==='comercial')state.removedComercial=state.removedComercial.filter(k=>k!==key);else state.removedJuridico=state.removedJuridico.filter(k=>k!==key);renderTime(tipo);}

function switchTab(tab){['comercial','juridico','financeiro'].forEach(t=>{document.getElementById(`tab-${t}`).style.display=t===tab?'block':'none';});document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));const btn=document.getElementById(`tab-btn-${tab}`);if(btn)btn.classList.add('active');}

// ── REGRA DE VISIBILIDADE PASSADA PELO HOST ──
// O sistema host injeta window.GN_USER = {role:'admin'|'jeanne'|'johnathan', nome:'Johnathan'|...}
function applyVisibilityRules(){
  var u=window.GN_USER||{role:'admin'};
  // Jeanne: esconde aba Financeiro/ADM
  if(u.role==='jeanne'){
    var btnFin=document.getElementById('tab-btn-financeiro');
    if(btnFin)btnFin.style.display='none';
    if(document.getElementById('tab-financeiro').style.display!=='none'){switchTab('comercial');}
  }
  // Johnathan: força aba Jurídico, esconde Comercial e Financeiro, esconde todos os cards exceto o dele
  if(u.role==='johnathan'){
    var btnCom=document.getElementById('tab-btn-comercial');if(btnCom)btnCom.style.display='none';
    var btnFin=document.getElementById('tab-btn-financeiro');if(btnFin)btnFin.style.display='none';
    switchTab('juridico');
    // esconder upload (Johnathan não importa planilha)
    var up=document.querySelector('.upload-zone');if(up&&up.parentElement)up.parentElement.style.display='none';
    var btnFill=document.getElementById('btnFill');if(btnFill)btnFill.style.display='none';
    var btnPdf=document.getElementById('btnPdf');if(btnPdf)btnPdf.style.display='none';
    var btnSave=document.getElementById('btnSalvarSessao');if(btnSave)btnSave.style.display='none';
    // esconder global cards de outros (mantém só os relevantes do Johnathan)
    // esconder todos os cards e linhas que não sejam Johnathan
    document.querySelectorAll('#cards-juridico .person-card').forEach(function(c){
      if((c.dataset.nome||'').toLowerCase()!=='johnathan')c.style.display='none';
    });
    document.querySelectorAll('#tbody-juridico tr').forEach(function(r){
      if(r.classList.contains('totals-row'))r.style.display='none';
      else if((r.dataset.nome||'').toLowerCase()!=='johnathan')r.style.display='none';
    });
    // esconder botão de remover/preencher do card dele (visualização apenas)
    document.querySelectorAll('#cards-juridico .btn-remove, #cards-juridico .btn-add-pessoa').forEach(function(b){b.style.display='none';});
  }
}

function toggleTheme(){const html=document.documentElement;const dark=html.getAttribute('data-theme')==='dark';html.setAttribute('data-theme',dark?'light':'dark');document.getElementById('btnTheme').textContent=dark?'🌙':'☀️';}

function salvarSessao(){
  const sessao={versao:'1.0',salvoEm:new Date().toISOString(),mesRef:document.getElementById('mes-ref').textContent||'—',liquidadosQt:getVal('#gc-liq-qt'),manuais:state.manuais,removedComercial:state.removedComercial,removedJuridico:state.removedJuridico,comercial:state.comercial,juridico:state.juridico,totalCreditosEmpresa:state.totalCreditosEmpresa,linhasRaw:state.linhasRaw||[]};
  // Salva também via mensagem para o host (pra integrar com localStorage do sistema principal)
  if(window.parent&&window.parent.postMessage){window.parent.postMessage({type:'GN_SAVE',data:sessao},'*');}
  const blob=new Blob([JSON.stringify(sessao,null,2)],{type:'application/json'});
  const url=URL.createObjectURL(blob);const a=document.createElement('a');
  const mes=sessao.mesRef.replace(/\s/g,'_').replace(/[^a-zA-Z0-9_]/g,'');
  const stamp=new Date().toISOString().slice(0,16).replace('T','_').replace(':','-');
  a.href=url;a.download=`sessao_pbl_${mes}_${stamp}.json`;a.click();URL.revokeObjectURL(url);
}
function carregarSessao(event){
  const file=event.target.files[0];if(!file)return;
  const reader=new FileReader();reader.onload=e=>{
    try{const sessao=JSON.parse(e.target.result);
      state.comercial=sessao.comercial||{};state.juridico=sessao.juridico||{};
      state.manuais=sessao.manuais||{};state.removedComercial=sessao.removedComercial||[];
      state.removedJuridico=sessao.removedJuridico||[];state.totalCreditosEmpresa=sessao.totalCreditosEmpresa||0;
      if(sessao.mesRef)document.getElementById('mes-ref').textContent=sessao.mesRef;
      const totCredNorm=Object.values(state.comercial).reduce((s,d)=>s+d.creditos,0);
      const totAdic=Object.values(state.comercial).reduce((s,d)=>s+d.adicionais,0);
      const totVol=Object.values(state.comercial).reduce((s,d)=>s+d.volume,0);
      document.getElementById('gc-creditos').textContent=fmtN(totCredNorm);
      document.getElementById('gc-adicionais').textContent=fmtN(totAdic);
      document.getElementById('gc-volume').textContent=fmt(totVol);
      if(sessao.liquidadosQt){document.getElementById('gc-liq-qt').value=sessao.liquidadosQt;recalcLiquidados();}
      renderAll();renderFinanceiro();
      document.getElementById('appContent').style.display='block';
      document.getElementById('btnFill').style.display='block';
      document.getElementById('btnPdf').style.display='block';
      document.getElementById('btnSalvarSessao').style.display='block';
      Object.keys(state.juridico).forEach(key=>_recalcCardInternal('juridico',key));
      Object.keys(state.comercial).forEach(key=>_recalcCardInternal('comercial',key));
      recalcFinanceiro();recalcTotals('juridico');recalcTotals('comercial');
      document.getElementById('uploadZone').classList.add('loaded');
      document.getElementById('uploadZone').querySelector('h3').textContent=`Sessão carregada: ${sessao.mesRef}`;
      setStatus(`Sessão carregada.`,'ok');
      applyVisibilityRules();
    }catch(err){alert('Erro: '+err.message);}
  };reader.readAsText(file);event.target.value='';
}
function exportarPDF(){window.print();}

// Recebe mensagem do host (sessão a carregar)
window.addEventListener('message',function(ev){
  if(!ev.data)return;
  if(ev.data.type==='GN_LOAD'&&ev.data.data){
    const sessao=ev.data.data;
    state.comercial=sessao.comercial||{};state.juridico=sessao.juridico||{};
    state.manuais=sessao.manuais||{};state.removedComercial=sessao.removedComercial||[];
    state.removedJuridico=sessao.removedJuridico||[];state.totalCreditosEmpresa=sessao.totalCreditosEmpresa||0;
    if(sessao.mesRef)document.getElementById('mes-ref').textContent=sessao.mesRef;
    const totCredNorm=Object.values(state.comercial).reduce((s,d)=>s+d.creditos,0);
    const totAdic=Object.values(state.comercial).reduce((s,d)=>s+d.adicionais,0);
    const totVol=Object.values(state.comercial).reduce((s,d)=>s+d.volume,0);
    document.getElementById('gc-creditos').textContent=fmtN(totCredNorm);
    document.getElementById('gc-adicionais').textContent=fmtN(totAdic);
    document.getElementById('gc-volume').textContent=fmt(totVol);
    if(sessao.liquidadosQt){document.getElementById('gc-liq-qt').value=sessao.liquidadosQt;recalcLiquidados();}
    renderAll();renderFinanceiro();
    document.getElementById('appContent').style.display='block';
    document.getElementById('btnFill').style.display='block';
    document.getElementById('btnPdf').style.display='block';
    Object.keys(state.juridico).forEach(key=>_recalcCardInternal('juridico',key));
    Object.keys(state.comercial).forEach(key=>_recalcCardInternal('comercial',key));
    recalcFinanceiro();recalcTotals('juridico');recalcTotals('comercial');
    applyVisibilityRules();
  }
  if(ev.data.type==='GN_USER'){
    window.GN_USER=ev.data.user||{role:'admin'};
    applyVisibilityRules();
  }
});

function setStatus(msg,type=''){const el=document.getElementById('statusBar');el.textContent=msg;el.className='status-bar '+type;}

document.getElementById('fileInput').addEventListener('change',e=>{const f=e.target.files[0];if(f)lerArquivo(f);});
const zone=document.getElementById('uploadZone');
zone.addEventListener('dragover',e=>{e.preventDefault();zone.classList.add('drag-over');});
zone.addEventListener('dragleave',()=>zone.classList.remove('drag-over'));
zone.addEventListener('drop',e=>{e.preventDefault();zone.classList.remove('drag-over');const f=e.dataTransfer.files[0];if(f)lerArquivo(f);});
function lerArquivo(file){setStatus('Lendo...','');const reader=new FileReader();reader.onload=e=>{try{processarPlanilha(new Uint8Array(e.target.result));zone.classList.add('loaded');zone.querySelector('h3').textContent=file.name;}catch(err){setStatus('Erro: '+err.message,'error');}};reader.readAsArrayBuffer(file);}

// Sinaliza ao host que está pronto e pede dados/usuário
window.parent.postMessage({type:'GN_READY'},'*');
<\/script>
</body>
</html>

</script>
