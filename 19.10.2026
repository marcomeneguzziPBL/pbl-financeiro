function ni(page,icon,label){
  // Rótulo num span: com o menu recolhido só o ícone fica, e o title vira a dica ao passar o mouse.
  return'<button class="nav-item" id="nav-'+page+'" title="'+esc(label)+'" onclick="navigate(\''+page+'\')">'+icon+'<span class="nav-lbl">'+label+'</span></button>';
}

