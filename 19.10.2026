      ni('diligencias',I.diligencias,'Diligências')+
      ni('cumprimentosentenca',I.diligencias,'Cumprimento de Sentença');
  } else if(currentUser.role==='perito_contabil'){
    sb.innerHTML=
      '<div class="sb-section">Principal</div>'+
      ni('dashboard',I.dashboard,'Dashboard')+
      ni('processos',I.processos,'Processos')+
      '<div class="sb-section">Contencioso</div>'+
