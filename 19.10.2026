<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PBL — Gestão de Créditos Judiciais</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3/dist/purify.min.js"></script>
<script>
/* ===== STANDALONE SHIM (sem Firebase) — Firestore em memória + auto-login ===== */
(function(){
  "use strict";
  function nowTs(){ return { seconds: Math.floor(Date.now()/1000), nanoseconds:0, toDate:function(){return new Date();} }; }
  function genId(){ return "id"+Math.random().toString(36).slice(2,10)+Date.now().toString(36).slice(-4); }
  function ymd(off){ var d=new Date(); d.setDate(d.getDate()+(off||0)); return d.toISOString().slice(0,10); }
  var MES=new Date().toISOString().slice(0,7);
  var COLS=Object.create(null);
  function coll(p){ if(!COLS[p])COLS[p]={}; return COLS[p]; }

  /* ---- seed de exemplo ---- */
  coll("users")["emu-fin"]={name:"Financeiro (standalone)",email:"financeiro@pblcompra.com",role:"admin",active:true};
  var LW=[["l1","João Lucas"],["l2","Karen Silva"],["l3","Evelly Azevedo"],["l4","Bruno Souza"],["l5","Guilherme Souza","guilherme.souza@pblcompra.com"]];
  LW.forEach(function(x){ coll("lawyers")[x[0]]={id:x[0],name:x[1],email:x[2]||(x[0]+"@pblcompra.com"),prolabore:5000,active:true}; });
  function P(id,num,cli,adv,st,cond,compra,mat,rec){ coll("processos")[id]={id:id,numero:num,cliente:cli,advogadoId:adv,status:st,valorCondenacao:cond,valorCompra:compra,materia:mat,dataCompra:ymd(-100),mes:MES,recebimentos:rec||[],origem:"validacao_pbl",distribIds:[]}; }
  P("p1","0848128-70.2024.8.19.0002","Maria Souza","l1","liquidado_parcial",50000,20000,"Comum",[{id:"r1",data:ymd(-4),banco:"Genial",valor:8000,valorDevolucao:null}]);
  P("p2","1007865-67.2024.8.26.0438","José Lima","l2","liquidado_total",31000,12000,"RPV",[{id:"r2",data:ymd(-2),banco:"Caixa",valor:31000,valorDevolucao:null}]);
  P("p3","1003805-32.2022.8.26.0564","Ana Paula","l1","pendente",43000,18000,"Comum",[]);
  P("p4","0604027-83.2023.8.04.0001","Carlos Dias","l3","pendente",60000,25000,"Precatório",[]);
  coll("processos/p1/mon")["estado"]={valorEstim:22000,dadosExtras:{tipo:"Comum",fase:"Aguardando alvará",titularidade:"FIDC",credito:"Triplo",prazoFatal:ymd(3)},agenda:[{data:ymd(-2),desc:"Peticionar levantamento",feito:false},{data:ymd(6),desc:"Conferir alvará",feito:false}]};
  coll("processos/p1/timeline")["t1"]={ts:new Date().toISOString(),autor:"Admin",papel:"admin",tipo:"andamento",texto:"Processo importado (exemplo)."};
  /* diligências v2 (exemplo) — cobrindo todos os status */
  function DG(id,proc,trib,uf,com,advNome,advId,valor,tipo,extra){ coll("diligencias")[id]=Object.assign({id:id,proc:proc,trib:trib,uf:uf,comarca:com,adv:advNome,advId:advId,resp:"Ariane Ximenes",materia:"Comum",valor:valor,tipo:tipo,cumprida:false,historico:[]},extra||{}); }
  DG("d1","0848128-70.2024.8.19.0002","TJRJ","RJ","Rio de Janeiro","João Lucas","l1",52000,"Diligenciar expedição de alvará",{fase:"fila"});
  DG("d2","1007865-67.2024.8.26.0438","TJSP","SP","São Paulo","Karen Silva","l2",15000,"Consultar andamento",{fase:"fila",dataRealizacao:ymd(-3),dataVerificar:ymd(6)});
  DG("d3","1003805-32.2022.8.26.0564","TJSP","SP","Campinas","João Lucas","l1",43000,"Verificar levantamento",{fase:"fila",dataRealizacao:ymd(-12),dataVerificar:ymd(-1)});
  DG("d4","0604027-83.2023.8.04.0001","TJAM","AM","Manaus","Evelly Azevedo","l3",60000,"Diligenciar saldo remanescente",{fase:"aprovacao",dataRealizacao:ymd(-1)});
  DG("d5","1015920-28.2024.8.26.0625","TJSP","SP","Santos","Karen Silva","l2",9500,"Providência do advogado",{fase:"advogado",tarefaAdvogado:"Anexar procuração atualizada."});
  DG("d6","0848128-70.2024.8.19.0002","TJRJ","RJ","Niterói","João Lucas","l1",22000,"Peticionar cumprimento",{fase:"devolvida",justificativaDevolucao:"Faltou anexar o cálculo atualizado."});
  DG("d7","1007865-67.2024.8.26.0438","TJSP","SP","São Paulo","Karen Silva","l2",31000,"Baixa de diligência",{fase:"concluida",cumprida:true,dataRealizacao:ymd(-6),dataCumprimento:ymd(-3)});

  /* lançamentos financeiros (exemplo) */
  function LC(id,tipo,dia,valor,desc,ent,banco,cat,proc){ coll("lancamentos")[id]={id:id,tipo:tipo,data:ymd(dia),valor:valor,descricao:desc,entidade:ent,banco:banco,categoria:cat,processoId:proc||"",obs:""}; }
  LC("f1","compra",-75,20000,"Compra do crédito — Maria Souza","PBL","Genial","Aquisição","p1");
  LC("f2","compra",-70,12000,"Compra do crédito — José Lima","PBL","Genial","Aquisição","p2");
  LC("f3","compra",-40,18000,"Compra do crédito — Ana Paula","CERTJUD","Itaú","Aquisição","p3");
  LC("f4","venda",-35,26000,"Cessão ao FIDC — José Lima","FIDC","BTG","Venda FIDC","p2");
  LC("f5","venda",-4,8000,"Liquidação Parcial — proc. 0848128-70.2024.8.19.0002","FIDC","Genial","Liquidação","p1");
  LC("f6","venda",-2,31000,"Liquidação Total — proc. 1007865-67.2024.8.26.0438","FIDC","Caixa","Liquidação","p2");
  LC("f7","despesa",-60,1800,"Custas de cartório","PBL","Genial","Custas","p1");
  LC("f8","despesa",-30,4500,"Honorários de correspondente","PBL","Genial","Honorários","");
  LC("f9","despesa",-5,950,"Certidões e cópias","CERTJUD","Itaú","Custas","p3");
  /* gestoras (ids de GESTORAS_DEF), para Comissões por Gestora abrir com conteúdo */
  [["evilyn","Evilyn",15000],["margie","Margie",12000],["jeanne","Jeanne",8000],["karen","Karen",6000],["tanna","Tanna",5000]].forEach(function(g){ coll("gestoras")[g[0]]={id:g[0],name:g[1],email:g[0]+"@pblcompra.com",prolabore:g[2],active:true}; });
  /* cumprimento de sentença (exemplo) */
  coll("calculos")["c1"]={id:"c1",numero:"0056850-59.2024.8.04.1000",peritoId:"l1",peritoTipo:"advogado",peritoNome:"João Lucas",advogadoId:"l1",valorFinal:18500,valorUnit:25,qtd:1,data:ymd(-3),mes:MES};
  /* liquidações (exemplo) */
  coll("liquidacoes")["lq1"]={id:"lq1",processo:"0848128-70.2024.8.19.0002",advogadoId:"l1",titularidade:"FIDC PBL",valor:8000,liquidacao:"Parcial",creditos:1,data:ymd(-4),mes:MES};

  /* Administrativo (notif1) e Diligências do dia (gnDilig) — módulos de 24/09. Sem estes
     registros os dois abrem vazios no build de teste e não dá para avaliá-los. */
  function N1(id,ced,info,advC,tipo,etapas){ coll("notif1")[id]={id:id,cedente:ced,cedenteInfo:info,advogadoCedente:advC,
    numeroProcesso:"", tipo:tipo, entrada:ymd(-20), prazo:ymd(10), etapas:etapas||{}, historico:[]}; }
  N1("n1","Sandoval de Brito","BANCO OLE CONSIGNADO / Empréstimo irregular","Wendel Malheiros","Comum",
     {contrato:"concluido",docsPipe:"concluido",notificacao:"concluido",habilitacao:"pendente"});
  N1("n2","Eldina Lino Tranqueira","BANCO BRADESCO / Empréstimo irregular","Ricardo Gloria","Trabalhista",
     {contrato:"concluido",docsPipe:"pendente"});
  N1("n3","Erica Karoline Corazza","CENTRAL NACIONAL UNIMED / Negativa de cobertura","Heitor Reinaldo","RPV",
     {contrato:"concluido",docsPipe:"concluido",notificacao:"problema"});

  function GD(id,dia,com,jur,val,cidade,autor,adv,cred,reu,mat,valor,status){ coll("gnDilig")[id]={id:id,data:ymd(dia),
    comercial:com,juridico:jur,validadoPor:val,cidade:cidade,autor:autor,advogado:adv,creditos:cred,origem:"Cliente",advTipo:"Novo",
    reu:reu,materia:mat,assinatura:"DIGITAL",link:"",valor:valor,status:status}; }
  GD("g1",0,"Andressa Rodrigues","Daniel Fontana","Wendel Malheiros","Palmas - TO","Maria Souza","Wendel Malheiros",1,"Banco Ole","Empréstimo irregular",12000,"PAGO");
  GD("g2",0,"Barbara Motta","Fernando Dutra","Ricardo Gloria","Curitiba - PR","José Lima","Ricardo Gloria",2,"Bradesco","Negativação",8500,"Aguardando pagamento");
  GD("g3",-1,"Gabriella Suzin","Daniel Fontana","","Goiânia - GO","Ana Paula","Heitor Reinaldo",1,"Unimed","Negativa de cobertura",15000,"Aguardando");

  /* Atuação do advogado (skillErros) — item 20. Coleção PRÓPRIA, não um tipo dentro de
     skillObs: em skillObs a regra do Firestore vazava o registro na listagem. Só a gestão vê. */
  function SE(id,proc,advErro,grav,texto,status){ coll("skillErros")[id]={id:id,tipo:"erro_atuacao",
    procId:proc,procNumero:"",advogadoErro:advErro,gravidade:grav,texto:texto,skill:"EvIA",versao:"1.6",
    base:"análise de andamento",confianca:0.9,ts:new Date().toISOString(),status:status,revisor:"",revisadoEm:""}; }
  SE("se1","p1","Wendel Malheiros","Grave","A advogada concordou com o cálculo do réu, inferior ao ajuizado.","nova");
  SE("se2","p1","Ricardo Gloria","Médio","Prazo de manifestação perdido; precluiu a prova pericial.","nova");
  SE("se3","p2","Heitor Reinaldo","Leve","Petição protocolada sem a procuração atualizada.","validada");

  /* ---- helpers de path ---- */
  function partsOf(p){ return p.split("/"); }
  function parentColl(docPath){ var i=docPath.lastIndexOf("/"); return docPath.slice(0,i); }
  function idOf(docPath){ var i=docPath.lastIndexOf("/"); return docPath.slice(i+1); }
  function mkSnap(cp,id){ var c=COLS[cp]||{}; var has=Object.prototype.hasOwnProperty.call(c,id); var pa=partsOf(cp);
    return { id:id, exists:function(){return has;}, data:function(){return has?Object.assign({},c[id]):undefined;},
      ref:{ id:id, path:cp+"/"+id, parent:{ id:pa[pa.length-1], parent:{ id: pa.length>=2?pa[pa.length-2]:null } } } }; }
  function docsOf(cp){ var c=COLS[cp]||{}; return Object.keys(c).map(function(id){return mkSnap(cp,id);}); }
  function resolve(data){ if(data==null||typeof data!=="object")return data; var out=Array.isArray(data)?[]:{}; for(var k in data){ var v=data[k]; out[k]=(v&&v.__st)?nowTs():v; } return out; }

  function collection(db){ var s=[].slice.call(arguments,1); return {__c:true, path:s.join("/")}; }
  function collectionGroup(db,name){ return {__cg:true, name:name}; }
  function doc(a){ if(a&&a.__c){ var id=arguments[1]||genId(); return {__d:true, path:a.path+"/"+id, id:id}; } var s=[].slice.call(arguments,1); return {__d:true, path:s.join("/"), id:s[s.length-1]}; }
  function getDoc(ref){ return Promise.resolve(mkSnap(parentColl(ref.path), idOf(ref.path))); }
  function setDoc(ref,data,opts){ var cp=parentColl(ref.path),id=idOf(ref.path),c=coll(cp),d=resolve(data); c[id]=(opts&&opts.merge)?Object.assign({},c[id]||{},d):d; return Promise.resolve(); }
  function updateDoc(ref,patch){ var cp=parentColl(ref.path),id=idOf(ref.path),c=coll(cp); c[id]=Object.assign({},c[id]||{},resolve(patch)); return Promise.resolve(); }
  function deleteDoc(ref){ var cp=parentColl(ref.path),id=idOf(ref.path); if(COLS[cp])delete COLS[cp][id]; return Promise.resolve(); }
  function applyW(docs,ws){ return docs.filter(function(s){ var dt=s.data()||{}; return ws.every(function(w){ var v=dt[w.f]; if(w.op==="==")return v===w.v; if(w.op==="in")return (w.v||[]).indexOf(v)>=0; if(w.op===">=")return v>=w.v; if(w.op==="<=")return v<=w.v; if(w.op===">")return v>w.v; if(w.op==="<")return v<w.v; return true; }); }); }
  function getDocs(ref){ var docs; if(ref.__cg){ docs=[]; Object.keys(COLS).forEach(function(cp){ if(partsOf(cp).pop()===ref.name) docsOf(cp).forEach(function(s){docs.push(s);}); }); } else if(ref.__q){ docs=applyW(docsOf(ref.coll.path), ref.wheres); } else { docs=docsOf(ref.path); } return Promise.resolve({docs:docs,size:docs.length,empty:docs.length===0,forEach:function(f){docs.forEach(f);}}); }
  function query(collRef){ return {__q:true, coll:collRef, wheres:[].slice.call(arguments,1)}; }
  function where(f,op,v){ return {f:f,op:op,v:v}; }
  function onSnapshot(ref,cb){ getDocs(ref).then(function(snap){ try{cb(snap);}catch(e){console.error(e);} }); return function(){}; }
  function serverTimestamp(){ return {__st:true}; }
  function writeBatch(){ var ops=[]; return { set:function(r,d,o){ops.push(function(){return setDoc(r,d,o);});return this;}, update:function(r,p){ops.push(function(){return updateDoc(r,p);});return this;}, "delete":function(r){ops.push(function(){return deleteDoc(r);});return this;}, commit:function(){return Promise.all(ops.map(function(f){return f();}));} }; }
  function httpsCallable(){ return function(){ return Promise.resolve({data:{ok:true}}); }; }

  var ADMIN={ uid:"emu-fin", displayName:"Financeiro (standalone)", email:"financeiro@pblcompra.com" };
  var auth={ currentUser:ADMIN };
  function onAuthStateChanged(a,cb){ setTimeout(function(){ cb(ADMIN); },0); return function(){}; }
  function signInWithPopup(){ return Promise.resolve({user:ADMIN}); }
  function signOut(){ return Promise.resolve(); } /* standalone: sessão fixa, sem logout */
  function GoogleAuthProvider(){}

  window.fb={ auth:auth, db:{__db:true}, fn:{__fn:true},
    collection:collection, collectionGroup:collectionGroup, doc:doc, getDoc:getDoc, getDocs:getDocs,
    setDoc:setDoc, updateDoc:updateDoc, deleteDoc:deleteDoc, query:query, where:where, onSnapshot:onSnapshot,
    serverTimestamp:serverTimestamp, writeBatch:writeBatch, httpsCallable:httpsCallable,
    GoogleAuthProvider:GoogleAuthProvider, signInWithPopup:signInWithPopup, signOut:signOut, onAuthStateChanged:onAuthStateChanged };
  window.__STANDALONE__=true;
  /* standalone: sem tela de login do Google, sem botão Sair, e sem depender de CDN (se Chart.js não carregar, usa um stub) */
  (function(){ var st=document.createElement("style"); st.textContent="#login-screen{display:none!important}.btn-logout{display:none!important}"; (document.head||document.documentElement).appendChild(st);
    if(typeof window.Chart==="undefined"){ var C=function(){ this.destroy=function(){}; this.update=function(){}; this.resize=function(){}; }; C.register=function(){}; C.defaults={font:{},plugins:{legend:{labels:{}}}}; window.Chart=C; } })();
  /* perfil financeiro: menu só com Lançamentos, Relatórios e Processos; o resto redireciona para o Financeiro */
  (function(){ var PG=["processos","financeiro","fluxocaixa","operacional","campanhas","advogados","comissoesgestoras","geracaonegocios","resumo","cnab","relliqdiario","previsao","relliq2","relcomp","relgeral","relpend"];
    function filtra(){ var sb=document.getElementById("sidebar"); if(!sb) return;
      sb.querySelectorAll(".nav-item").forEach(function(b){ var pg=String(b.id||"").replace(/^nav-/,""); b.style.display=PG.indexOf(pg)>=0?"":"none"; });
      var sec=null, vis=false; [].slice.call(sb.children).forEach(function(el){
        if(el.classList.contains("sb-section")){ if(sec) sec.style.display=vis?"":"none"; sec=el; vis=false; return; }
        if([].slice.call(el.querySelectorAll?el.querySelectorAll(".nav-item"):[]).concat(el.classList.contains("nav-item")?[el]:[]).some(function(b){return b.style.display!=="none";})) vis=true; });
      if(sec) sec.style.display=vis?"":"none"; }
    new MutationObserver(filtra).observe(document.documentElement,{childList:true,subtree:true});
    var _w=setInterval(function(){ if(typeof window.navigate!=="function") return; clearInterval(_w); var nav0=window.navigate; window.navigate=function(pg){ return nav0(PG.indexOf(pg)>=0?pg:"financeiro"); }; }, 50); })();
  var _navN=0; var _navT=setInterval(function(){ _navN++; try{ if(typeof window.navigate==="function" && window.currentUser){ window.navigate("financeiro"); clearInterval(_navT); } }catch(e){} if(_navN>150) clearInterval(_navT); }, 100);
  window.dispatchEvent(new Event("fb-ready"));
})();
</script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --v:#063D38;--vd:#042824;--vl:#DDE9E7;
  --d:#B8860B;--dl:#FDF6E3;--dm:#C9970D;
  --bd:#d0dbd9;--tx:#1c1c1c;--mt:#5e7572;
  --bg:#f0f3f2;--red:#A32D2D;--redl:#FCEBEB;
  --sb:240px;
  --card:#ffffff;--input:#ffffff;--row-alt:#f7faf9;--row-hov:#edf5f3;--shadow:rgba(0,0,0,.08);
  --blue:#185FA5;--bluel:#EEF3FB;--green:#1D6B3A;--greenl:#E6F4EC;
  --divider:#eef1f0;
}
body.dark{
  /* Fundo geral mais claro que o quase-preto antigo, e tipografia bem mais clara */
  --v:#26a394;--vd:#1d8478;--vl:#163530;
  --d:#e6b426;--dl:#3a3010;--dm:#f0bf2e;
  --bd:#39504a;--tx:#f1f5f4;--mt:#a8bdb8;
  --bg:#10181a;--red:#ff8585;--redl:#3a1a1a;
  --card:#1c2729;--input:#243032;--row-alt:#222d2f;--row-hov:#2c3a3c;--shadow:rgba(0,0,0,.5);
  --blue:#7ab4f0;--bluel:#1a2d44;--green:#7adc9b;--greenl:#163a23;
  --divider:#2e3e3a;
}
/* Aplicações específicas para o tema dark — cobre elementos com cores hard-coded */
body.dark .card,
body.dark .chart-card,
body.dark .filter-bar{background:var(--card)!important;border-color:var(--bd)!important;color:var(--tx)}
body.dark .sidebar{background:var(--card)!important;border-color:var(--bd)!important}
body.dark .nav-item{color:var(--tx)}
body.dark .nav-item:hover,body.dark .nav-item.active{background:var(--vl);color:var(--v)}
body.dark .fg input,body.dark .fg select,body.dark .fg textarea,
body.dark input[type=text],body.dark input[type=number],body.dark input[type=password],body.dark input[type=email],body.dark input[type=date],body.dark input[type=month],body.dark .search-input{
  background:var(--input)!important;color:var(--tx)!important;border-color:var(--bd)!important
}
body.dark input::placeholder,body.dark textarea::placeholder{color:#7a918c}
body.dark .btn{background:var(--input);border-color:var(--bd);color:var(--tx)}
body.dark .btn:hover{background:var(--vl)}
body.dark .bp{background:var(--v);color:#fff;border-color:var(--v)}
body.dark .bp:hover{background:var(--vd)}
/* Tabelas */
body.dark .tbl{background:var(--card)}
body.dark .tbl td{color:var(--tx);border-bottom-color:var(--divider)}
body.dark .tbl th{background:var(--vd);color:#fff}
body.dark .tbl tr:nth-child(even) td{background:var(--row-alt)}
body.dark .tbl tr:hover td{background:var(--row-hov)}
body.dark .tbl tr.foot td{background:var(--vd);color:#fff}
/* Modais */
body.dark .modal{background:var(--card)!important;color:var(--tx)}
body.dark .modal-title{color:var(--v)}
/* Imports / drop zones */
body.dark .imp{background:var(--dl)!important;border-color:var(--d)!important;color:var(--tx)!important}
body.dark .imp-title{color:var(--d)}
body.dark .imp:hover{background:#4a3d18!important}
/* Métricas */
body.dark .mc{background:var(--vl)}
body.dark .mc.gold{background:var(--dl)}
body.dark .mc.blue{background:var(--bluel)}
body.dark .mc.red{background:var(--redl)}
body.dark .mc.green{background:var(--greenl)}
body.dark .mv.blue{color:var(--blue)}
body.dark .mv.green{color:var(--green)}
/* Badges */
body.dark .b-tot{background:var(--vl);color:#7eddc8}
body.dark .b-par{background:var(--dl);color:var(--d)}
body.dark .b-pend{background:var(--bluel);color:var(--blue)}
body.dark .b-red{background:var(--redl);color:var(--red)}
body.dark .b-green{background:var(--greenl);color:var(--green)}
body.dark .b-compra{background:var(--bluel);color:var(--blue)}
body.dark .b-venda{background:var(--greenl);color:var(--green)}
body.dark .b-desp{background:var(--redl);color:var(--red)}
/* Linhas e divisórias */
body.dark .div,body.dark .lrow,body.dark .rank-row{border-color:var(--divider)!important}
body.dark .rank-bar-bg{background:var(--divider)}
/* Fluxo de caixa */
body.dark .fc-in,body.dark .fc-saldo-pos{color:var(--green)}
body.dark .fc-out,body.dark .fc-saldo-neg{color:var(--red)}
body.dark .fc-saldo-pos{background:var(--greenl)}
body.dark .fc-saldo-neg{background:var(--redl)}
/* Avatares ficam levemente saturados a mais */
body.dark .av{filter:saturate(1.1) brightness(1.05)}
/* Toggle do dark mode no header */
body.dark .btn-logout{background:rgba(255,255,255,.12)}
body.dark .btn-logout:hover{background:rgba(255,255,255,.2)}
/* Bloco genérico para inputs em formulário */
body.dark .login-box{background:var(--card)}
body.dark .login-box .lf input{background:var(--input);color:var(--tx);border-color:var(--bd)}
body.dark .login-title{color:var(--v)}
/* Garantir que elementos sem variáveis (cores codificadas) ainda fiquem legíveis */
body.dark [style*="background:#f4f4f4"],body.dark [style*="background: #f4f4f4"]{background:var(--row-alt)!important;color:var(--tx)!important}
body.dark [style*="background:var(--row-alt)"],body.dark [style*="background: #f7faf9"]{background:var(--row-alt)!important}
body.dark [style*="border:1px solid #e0e8e5"],body.dark [style*="border: 1px solid #e0e8e5"]{border-color:var(--bd)!important}
body.dark [style*="border-bottom:.5px solid #eef1f0"]{border-bottom-color:var(--divider)!important}
body{font-family:Arial,sans-serif;background:var(--bg);color:var(--tx);font-size:14px}

/* ── LOGIN ─────────────────────────────────────── */
.login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--v)}
.login-box{background:var(--card);border-radius:16px;padding:40px 36px;width:100%;max-width:380px;box-shadow:0 8px 32px var(--shadow)}
.login-logo{display:flex;align-items:center;gap:12px;margin-bottom:28px;justify-content:center}
.login-title{font-size:20px;font-weight:700;color:var(--v)}
.login-sub{font-size:12px;color:var(--mt);margin-top:2px}
.lf{margin-bottom:16px}
.lf label{font-size:12px;color:var(--mt);display:block;margin-bottom:5px;font-weight:600}
.lf input{width:100%;border:1px solid var(--bd);border-radius:8px;padding:10px 13px;font-size:14px;outline:none;transition:border-color .2s;background:var(--input);color:var(--tx)}
.lf input:focus{border-color:var(--v)}
.login-btn{width:100%;background:var(--v);color:#fff;border:none;border-radius:8px;padding:11px;font-size:14px;font-weight:700;cursor:pointer;margin-top:4px}
.login-btn:hover{background:var(--vd)}
.login-err{background:var(--redl);color:var(--red);border-radius:6px;padding:8px 12px;font-size:12px;font-weight:600;margin-bottom:14px;display:none}

/* ── APP SHELL ──────────────────────────────────── */
.app-wrap{display:flex;flex-direction:column;height:100vh;overflow:hidden}

/* ── HEADER ─────────────────────────────────────── */
.hdr{background:var(--v);display:flex;align-items:stretch;height:56px;flex-shrink:0;z-index:300}
.hdr-brand{width:var(--sb);flex-shrink:0;display:flex;align-items:center;gap:10px;padding:0 16px;border-right:1px solid rgba(255,255,255,.12)}
.hdr-title{color:#fff;font-size:14px;font-weight:700;line-height:1.2}
.hdr-subtitle{color:rgba(255,255,255,.5);font-size:10px;display:block}
.hdr-right{flex:1;display:flex;align-items:center;gap:10px;padding:0 20px}
.hdr-period{color:rgba(255,255,255,.7);font-size:12px;flex:1}
.hdr-user{color:rgba(255,255,255,.85);font-size:12px;background:rgba(255,255,255,.15);padding:4px 12px;border-radius:20px}
input[type=month]{padding:5px 9px;border-radius:6px;border:none;font-size:12px;background:rgba(255,255,255,.18);color:#fff;outline:none;cursor:pointer}
input[type=month]::-webkit-calendar-picker-indicator{filter:invert(1);opacity:.7}
.btn-calc{background:var(--d);color:#fff;border:none;padding:7px 18px;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer}
.btn-calc:hover{background:var(--dm)}
.btn-logout{background:rgba(255,255,255,.15);color:#fff;border:none;padding:6px 12px;border-radius:6px;font-size:12px;cursor:pointer}
.btn-logout:hover{background:rgba(255,255,255,.25)}
.admin-badge{background:var(--d);color:#fff;font-size:10px;font-weight:700;padding:2px 7px;border-radius:10px;margin-left:6px}

/* ── BODY ───────────────────────────────────────── */
.body-area{display:flex;flex:1;overflow:hidden}

/* ── SIDEBAR ────────────────────────────────────── */
.sidebar{width:var(--sb);background:var(--card);border-right:1px solid var(--bd);display:flex;flex-direction:column;overflow-y:auto;flex-shrink:0}
.sb-section{padding:16px 12px 4px;font-size:10px;font-weight:700;color:var(--mt);text-transform:uppercase;letter-spacing:.08em}
.nav-item{display:flex;align-items:center;gap:9px;padding:8px 14px;cursor:pointer;border-radius:7px;margin:1px 8px;font-size:13px;color:var(--tx);border:none;background:none;width:calc(100% - 16px);text-align:left;transition:background .12s,color .12s;white-space:nowrap}
.nav-item:hover{background:var(--vl);color:var(--v)}
.nav-item.active{background:var(--vl);color:var(--v);font-weight:700}
.nav-item svg{width:16px;height:16px;flex-shrink:0;opacity:.55}
.nav-item.active svg,.nav-item:hover svg{opacity:1}

/* accordion */
.sb-group{}
.sb-group-hdr{display:flex;align-items:center;gap:9px;padding:8px 14px 8px 22px;cursor:pointer;font-size:11px;font-weight:700;color:var(--mt);text-transform:uppercase;letter-spacing:.05em;border:none;background:none;width:100%;text-align:left}
.sb-group-hdr:hover{color:var(--v)}
.sb-group-hdr svg{width:14px;height:14px;opacity:.55}
.sb-chevron{margin-left:auto;font-size:10px;transition:transform .2s;line-height:1}
.sb-children{display:none;padding-bottom:4px}
.sb-children.open{display:block}
.sb-children .nav-item{padding-left:36px;font-size:12px;margin-left:12px;width:calc(100% - 20px)}

/* Botão de recolher, fixo no topo do menu */
.sb-toggle{position:sticky;top:0;z-index:1;flex-shrink:0;display:flex;align-items:center;gap:9px;padding:11px 22px;border:none;border-bottom:1px solid var(--bd);background:var(--card);color:var(--mt);font-size:12px;cursor:pointer;width:100%;text-align:left;white-space:nowrap}
.sb-toggle:hover{color:var(--v);background:var(--vl)}
.sb-toggle-ic{font-size:15px;line-height:1;width:16px;text-align:center}

/* Menu recolhido: faixa estreita só com os ícones; seções viram divisórias e os grupos se abrem. */
.sidebar{transition:width .18s ease}
body.sb-collapsed .sidebar{width:60px;overflow-x:hidden}
body.sb-collapsed .sidebar .nav-lbl{display:none}
body.sb-collapsed .sidebar .nav-item,
body.sb-collapsed .sidebar .sb-children .nav-item{justify-content:center;padding:9px 0;margin:1px 8px;width:calc(100% - 16px)}
body.sb-collapsed .sidebar .nav-item svg{width:18px;height:18px}
body.sb-collapsed .sidebar .sb-section{font-size:0;padding:0;margin:8px 12px;border-top:1px solid var(--bd)}
body.sb-collapsed .sidebar .sb-group-hdr{display:none}
body.sb-collapsed .sidebar .sb-children{display:block}
body.sb-collapsed .sidebar .sb-toggle{justify-content:center;padding:11px 0}
body.sb-collapsed .sidebar .sb-toggle + .sb-section{display:none}
/* A marca no topo deixa de acompanhar a largura do menu (senão a divisória fica solta no cabeçalho). */
body.sb-collapsed .hdr-brand{width:auto;border-right:none}

/* ── MAIN ───────────────────────────────────────── */
.main{flex:1;overflow-y:auto;padding:24px 28px;min-width:0}

/* Área de soltar arquivo (CNAB) */
.drop-zone{border:1.5px dashed var(--bd);border-radius:8px;padding:18px;text-align:center;cursor:pointer;color:var(--mt);font-size:13px;transition:border-color .15s,background .15s}
.drop-zone:hover,.drop-zone.drag-over{border-color:var(--v);background:var(--vl);color:var(--v)}
.drop-zone .dz-file{margin-top:6px;font-weight:700;color:var(--tx)}

/* ── CARDS / FORM ───────────────────────────────── */
.page-title{font-size:17px;font-weight:700;color:var(--v);display:flex;align-items:center;gap:10px;margin-bottom:18px}
.page-title svg{width:20px;height:20px;flex-shrink:0}
.st{font-size:11px;font-weight:700;color:var(--mt);text-transform:uppercase;letter-spacing:.08em;margin:22px 0 10px}
.st:first-child{margin-top:0}
.card{background:var(--card);border:.5px solid var(--bd);border-radius:10px;padding:16px 20px;margin-bottom:14px;color:var(--tx)}
.frow{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap}
.fg{display:flex;flex-direction:column;gap:4px;flex:1;min-width:110px}
.fg label{font-size:12px;color:var(--mt)}
.fg input,.fg select,.fg textarea{border:.5px solid var(--bd);border-radius:6px;padding:7px 10px;font-size:13px;color:var(--tx);background:var(--input);outline:none;width:100%;transition:border-color .15s}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--v)}
/* Checkbox/radio não são campos de largura total: mantêm tamanho natural e não herdam o estilo de input de texto. */
.fg input[type=checkbox],.fg input[type=radio]{width:16px;height:16px;flex:0 0 auto;padding:0;border-radius:4px;accent-color:var(--v);cursor:pointer}
.fg textarea{resize:vertical;min-height:70px}
.modal.modal-wide{max-width:980px}
.nf-emailbody{font-family:-apple-system,'Segoe UI',Arial,Helvetica,sans-serif!important;font-size:14px!important;line-height:1.7!important;min-height:360px;padding:16px 18px!important;white-space:pre-wrap}
.nf-assunto-big{font-size:14px!important;padding:9px 12px!important}
@media(max-width:1024px){.modal.modal-wide{max-width:95vw}}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
.g4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.div{height:.5px;background:var(--divider);margin:14px 0}

/* ── BUTTONS ────────────────────────────────────── */
.btn{padding:7px 15px;border-radius:6px;font-size:13px;border:.5px solid var(--bd);background:var(--card);cursor:pointer;color:var(--tx);font-weight:500;white-space:nowrap}
.btn:hover{background:var(--vl)}
.bp{background:var(--v);color:#fff;border-color:var(--v)}
.bp:hover{background:var(--vd)}
.bd2{color:var(--red);border-color:#e8b4b4;padding:4px 10px;font-size:11px}
.bd2:hover{background:var(--redl)}
.bsm{padding:4px 12px;font-size:12px}
.print-btn{background:#1D6B3A;color:#fff;border:none;padding:7px 16px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;margin-left:auto}
.print-btn:hover{background:#145229}

/* ── TABLE ──────────────────────────────────────── */
.tbl{width:100%;border-collapse:collapse;font-size:12px}
.tbl th{background:var(--v);color:#fff;font-size:11px;font-weight:700;padding:8px 11px;text-align:left;white-space:nowrap}
.tbl th.r{text-align:right}
.tbl td{padding:7px 11px;border-bottom:.5px solid var(--divider);vertical-align:middle;color:var(--tx)}
.tbl td.r{text-align:right}
.tbl tr:last-child td{border-bottom:none}
.tbl tr:nth-child(even) td{background:var(--row-alt)}
.tbl tr:hover td{background:var(--row-hov)}
.tbl tr.foot td{background:var(--v);color:#fff;font-weight:700}
.dbtn{color:var(--red);background:none;border:none;cursor:pointer;font-size:16px;padding:0 3px;line-height:1}
.ebtn{color:var(--v);background:none;border:none;cursor:pointer;font-size:14px;padding:0 3px;line-height:1}

/* ── BADGES ─────────────────────────────────────── */
.badge{display:inline-block;font-size:10px;font-weight:700;padding:2px 7px;border-radius:8px}
.ag-chip{display:inline-block;background:#e9f1ec;color:#0c3d26;border:1px solid #b9cec2;border-radius:14px;padding:2px 9px;font-size:11px;font-weight:600;margin:2px 4px 2px 0}
.b-tot{background:var(--vl);color:var(--v)}
.b-par{background:var(--dl);color:var(--d)}
.b-pend{background:var(--bluel);color:var(--blue)}
.b-red{background:var(--redl);color:var(--red)}
.b-green{background:var(--greenl);color:var(--green)}
.b-compra{background:var(--bluel);color:var(--blue)}
.b-venda{background:var(--greenl);color:var(--green)}
.b-desp{background:var(--redl);color:var(--red)}
.section-badge{background:var(--v);color:#fff;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;margin-left:10px;vertical-align:middle}

/* ── METRICS ────────────────────────────────────── */
.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:16px}
.mc{background:var(--vl);border-radius:8px;padding:13px 15px}
.mc.gold{background:var(--dl)}
.mc.blue{background:var(--bluel)}
.mc.red{background:var(--redl)}
.mc.green{background:var(--greenl)}
.ml{font-size:11px;color:var(--mt);margin-bottom:4px}
.mv{font-size:20px;font-weight:700;color:var(--v)}
.mv.gold{color:var(--d)}
.mv.blue{color:var(--blue)}
.mv.red{color:var(--red)}
.mv.green{color:var(--green)}

/* ── CHARTS ─────────────────────────────────────── */
.charts-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.chart-card{background:var(--card);border:.5px solid var(--bd);border-radius:10px;padding:18px 20px;color:var(--tx)}
.chart-title{font-size:13px;font-weight:700;color:var(--v);margin-bottom:4px}
.chart-sub{font-size:11px;color:var(--mt);margin-bottom:14px}
.chart-wrap{position:relative;height:260px}
.chart-full{grid-column:1/-1}
.chart-wrap-tall{position:relative;height:300px}

/* ── MODAL ──────────────────────────────────────── */
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:500;display:flex;align-items:center;justify-content:center}
.modal-bg.mt{z-index:1100}
.modal{background:var(--card);border-radius:12px;padding:28px;width:100%;max-width:720px;max-height:90vh;overflow-y:auto;position:relative;color:var(--tx)}
.modal-title{font-size:16px;font-weight:700;color:var(--v);margin-bottom:20px}
.modal-close{position:absolute;top:16px;right:20px;background:none;border:none;font-size:22px;cursor:pointer;color:var(--mt)}
.modal-close:hover{color:var(--red)}

/* ── RANK ───────────────────────────────────────── */
.rank-row{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:.5px solid var(--divider);font-size:12px}
.rank-row:last-child{border-bottom:none}
.rank-n{width:20px;font-size:11px;font-weight:700;color:var(--mt);text-align:center}
.rank-name{flex:1;font-weight:500}
.rank-bar-bg{width:120px;height:8px;background:var(--divider);border-radius:4px;overflow:hidden}
.rank-bar-fill{height:100%;border-radius:4px}
.rank-val{width:90px;text-align:right;font-size:11px}
.rank-pct{width:38px;text-align:right;font-size:11px;color:var(--mt)}

/* ── MISC ───────────────────────────────────────── */
.av{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0}
.ln{flex:1;font-size:13px;font-weight:500}
.lrow{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:.5px solid var(--divider)}
.lrow:last-child{border-bottom:none}
.empty{font-size:13px;color:var(--mt);padding:12px 0;text-align:center}
.toast{position:fixed;bottom:20px;right:20px;background:var(--v);color:#fff;padding:10px 18px;border-radius:8px;font-size:13px;font-weight:600;opacity:0;transition:opacity .3s;pointer-events:none;z-index:1200}
.toast.show{opacity:1}
.filter-bar{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin-bottom:14px;padding:14px 16px;background:var(--card);border:.5px solid var(--bd);border-radius:10px}
.search-input{border:.5px solid var(--bd);border-radius:6px;padding:7px 10px;font-size:13px;outline:none;flex:1;min-width:160px;background:var(--input);color:var(--tx)}
.search-input:focus{border-color:var(--v)}
.imp{display:flex;align-items:center;gap:12px;background:var(--dl);border:1.5px dashed var(--d);border-radius:8px;padding:12px 16px;margin-bottom:14px;cursor:pointer}
.imp:hover{background:#faeec4}
.imp-icon{width:34px;height:34px;background:var(--d);border-radius:7px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.imp-icon svg{width:18px;height:18px;fill:#fff}
.imp-text{flex:1}
.imp-title{font-size:13px;font-weight:700;color:var(--d)}
.imp-sub{font-size:11px;color:var(--mt);margin-top:2px}
.imp-status{font-size:11px;font-weight:700;color:var(--v);background:var(--vl);padding:3px 10px;border-radius:10px;white-space:nowrap;flex-shrink:0}
input.fhide{display:none}

/* fluxo caixa */
.fc-in{color:var(--green);font-weight:700}
.fc-out{color:var(--red);font-weight:700}
.fc-saldo-pos{background:var(--greenl);color:var(--green);padding:2px 8px;border-radius:6px;font-weight:700;font-size:12px}
.fc-saldo-neg{background:var(--redl);color:var(--red);padding:2px 8px;border-radius:6px;font-weight:700;font-size:12px}

/* ── PROC PANEL ─────────────────────────────────── */
.ptabs{display:flex;gap:2px;border-bottom:2px solid var(--bd);margin:12px 0 14px;flex-wrap:wrap}
.ptabs button{border:none;background:none;padding:8px 14px;font-size:13px;font-weight:600;cursor:pointer;color:var(--mt);border-bottom:2px solid transparent;margin-bottom:-2px}
.ptabs button.on{color:var(--v);border-bottom-color:var(--v)}
.ptabs button:hover{color:var(--v)}
.pbody{padding:4px 0}
.finrow{display:flex;justify-content:space-between;padding:5px 0;font-size:13px;border-bottom:.5px solid var(--divider)}
.finrow.big{font-size:15px;font-weight:800}
.tl-entry{border-left:3px solid var(--v);padding:4px 0 10px 12px;margin-bottom:2px}
.tl-entry .when{font-size:11px;color:var(--mt)}
.mini{width:100%;border-collapse:collapse}
.mini td,.mini th{padding:5px 7px;border-bottom:.5px solid var(--divider);font-size:12px}
.xbtn{border:none;background:none;color:var(--red);cursor:pointer;font-size:15px}
.plink{color:var(--blue);cursor:pointer;text-decoration:underline;font-weight:600}
.dfield{padding:4px 0}.dfield .lb{font-size:11px;color:var(--mt)}.dfield .vl{font-weight:600}
.grid-in{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
@media(max-width:640px){.grid-in{grid-template-columns:1fr}}

/* ── PRINT ──────────────────────────────────────── */
@media print{
  .hdr,.sidebar,.no-print,.modal-close,.dbtn,.ebtn,.print-btn,.filter-bar,.btn,.imp{display:none!important}
  .body-area{display:block}
  .main{padding:0;overflow:visible}
  body{background:#fff}
  .card{border:1px solid #ccc;border-radius:0}
  .tbl th{background:#063D38!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
@media(max-width:768px){
  :root{--sb:200px}
  .metrics,.g4{grid-template-columns:1fr 1fr}
  .g3{grid-template-columns:1fr 1fr}
  .charts-grid{grid-template-columns:1fr}
  .chart-full{grid-column:auto}
  .main{padding:16px}
}

/* ── CALC EDITOR OVERLAY ────────────────────────── */
#calc-editor-overlay{position:fixed;inset:0;z-index:1000;overflow:auto;background:var(--bg,#f6f8f7);-webkit-overflow-scrolling:touch}
.ce-hd{position:sticky;top:0;z-index:5;background:var(--v);color:#fff;padding:10px 16px}
.ce-hd .r1{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.ce-back{background:transparent;border:0;color:#cfeeda;font-size:12px;cursor:pointer}
.ce-desc{flex:1;min-width:160px;background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.5);border-radius:6px;padding:5px 9px;color:#fff}
.ce-tot{margin-left:auto;text-align:right}
.ce-tot .l{font-size:9px;text-transform:uppercase;letter-spacing:.05em;color:#cfeeda}
.ce-tot .v{font-size:20px;font-weight:800;color:#ffe28a;line-height:1}
.ce-acts{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}
.ce-acts .btn{color:#fff;border-color:rgba(255,255,255,.55);background:transparent}
.ce-acts .btn.bp{background:#ffd84d;color:#3a2d00;border-color:#ffd84d}
.ce-stale{background:#8a3300;color:#ffe0c8;border-radius:6px;padding:4px 10px;font-size:10px;margin-top:9px;display:inline-block;font-weight:600}
.ce-body{padding:14px 16px}
.ce-save{font-size:10px;color:#bfe8cf}
/* ── CALC PILLS (abas de verba) ─────────────────── */
.calc-pills{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
.calc-pills .pl{border:1px solid #b9cec2;background:#fff;border-radius:20px;padding:4px 13px;font-size:11px;color:#0c3d26;font-weight:600;cursor:pointer}
.calc-pills .pl.on{background:var(--v);color:#fff;border-color:var(--v)}
.calc-pills .pl.add{border-style:dashed;color:var(--v)}
.calc-pills .pl .n{background:#dcebe2;color:#0c3d26;border-radius:10px;padding:0 6px;margin-left:4px;font-size:10px;font-weight:700}
.calc-pills .pl.on .n{background:rgba(255,255,255,.25);color:#fff}
.calc-dd{position:absolute;top:32px;left:0;z-index:6;background:#fff;border:1px solid #b9cec2;border-radius:8px;box-shadow:0 6px 20px rgba(0,0,0,.12);padding:5px;min-width:190px}
.calc-dd-it{padding:6px 10px;font-size:11px;color:#123;border-radius:5px;cursor:pointer}
.calc-dd-it:hover{background:#eef6f1}
.calc-pills .pl.esp{border-color:#d9b8e6;color:#6d28d9;background:#faf5ff}
.calc-pills .pl.esp.on{background:#6d28d9;color:#fff;border-color:#6d28d9}
.calc-pill-sep{width:1px;height:20px;background:#dbe3de;display:inline-block;margin:0 3px;vertical-align:middle}
.calc-dd-sec{font-size:9px;text-transform:uppercase;color:#6b7c72;padding:4px 10px 2px;font-weight:700}
.calc-dd-it.esp{color:#6d28d9}
.ce-rz{padding:2px 0}
.ce-rz-tg{display:flex;align-items:baseline;gap:10px;border-bottom:2px solid #0f5132;padding-bottom:8px;margin-bottom:12px}
.ce-rz-tg .l{font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#0c3d26;font-weight:800}
.ce-rz-tg .v{font-family:Menlo,Consolas,monospace;font-size:26px;font-weight:800;color:#0f5132}
.ce-rz-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.ce-rz-card{border:1px solid #cfe0d6;border-radius:8px;padding:9px 10px;position:relative}
.ce-rz-card .k{font-size:9px;text-transform:uppercase;letter-spacing:.03em;color:#2c4a3a;font-weight:800}
.ce-rz-card .v{font-family:Menlo,Consolas,monospace;font-size:15px;font-weight:800;color:#14372c;margin-top:3px}
.ce-rz-card.neg .v{color:#a5402c}
.ce-rz-mem{position:absolute;top:7px;right:8px;font-size:9px;color:#0f5132;font-weight:700;text-decoration:underline;cursor:pointer}
.ce-rz-hint{font-size:10.5px;color:#3a463f;margin-top:9px}
.calc-esp-tab{padding-top:2px}
.calc-params-tab .pp-top{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:8px;margin-bottom:6px}
.calc-procnote{background:#eef4ff;border:1px solid #b8cce6;color:#1a3a66;border-radius:6px;padding:5px 10px;font-size:10px;margin-bottom:11px}
/* ── CALC VERBA TABLE + INLINE EDITOR (Task 4) ─── */
.calc-vtab td,.calc-vtab th{font-size:11px}
.calc-lrow{cursor:pointer}
.calc-lrow.open{background:#eef6f1}
.calc-eye{color:var(--v);cursor:pointer}
.calc-na{color:#3f4a44}
.calc-tag{background:#ffe08a;color:#6b4e00;border-radius:4px;padding:1px 7px;font-size:9px;font-weight:700}
.calc-empty{text-align:center;padding:22px 12px;color:#1a2320}
.calc-edit3{background:#eef6f1;border:1px solid #b9cec2;border-radius:8px;padding:11px;margin:2px 0 8px}
.calc-edit3 .g3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.calc-edit3 .grp .gh{font-size:9px;text-transform:uppercase;letter-spacing:.04em;color:#0c3d26;font-weight:700;margin-bottom:5px;border-bottom:1px solid #c6d6cc;padding-bottom:3px}
.calc-edit3 .fld{margin-bottom:6px}
.calc-edit3 .fld label{display:block;font-size:9px;color:#3f4a44;margin-bottom:2px;font-weight:600}
.calc-edit3 .fld input,.calc-edit3 .fld select{width:100%;box-sizing:border-box}
.calc-edit3 .ftr{display:flex;justify-content:space-between;align-items:center;margin-top:9px;padding-top:8px;border-top:1px solid #c6d6cc}
.calc-edit3 .calc-save{font-size:10px;color:var(--v);font-weight:600}
.calc-edit3 .calc-del{color:#a01b12;border-color:#e6b8b2}
.calc-honnote{background:#fff6d6;border:1px solid #e7d492;border-radius:6px;padding:6px 9px;font-size:10px;color:#6b4e00;margin-top:8px}
/* ── CALC MATRIZ DE TOTAIS (Task 6) ─────────────── */
.calc-matriz{margin:14px 0 0;border:1px solid #d5ddd8;border-radius:8px;overflow:hidden}
.calc-matriz .mh{background:#e9f1ec;padding:7px 12px;font-weight:700;color:#0c3d26;font-size:11px}
.calc-matriz .calc-mtot td{font-weight:800;color:var(--v);font-size:13px;border-top:2px solid #b9cec2}
/* ── CALC ABA APÓS PAGAMENTOS (Fase C Task 4) ────── */
.calc-etapa{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid #eef1f0;font-size:13px}
.calc-etapa-sub{font-weight:700;color:var(--v);border-top:1px solid #cfe0d6}
.calc-etapa-total{font-weight:800;color:var(--v);font-size:15px;border-top:2px solid #b9cec2;border-bottom:none;padding-top:8px}
/* ── CALC BARRA DE MÉTODO (Fase D1 Task 1) ─────── */
.calc-metodo-bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:#f3f8f5;border:1px solid #cfe0d6;border-radius:8px;padding:8px 11px;margin-bottom:10px}
.calc-anc-auto{font-size:12px;color:var(--v);background:#f3f8f5;border:1px solid #cfe0d6;border-radius:6px;padding:5px 8px;margin-top:4px}
.calc-metodo-bar .lbl{font-size:11px;color:#3f4a44;font-weight:600}
.calc-metodo-status{font-size:10px;color:#6b4e00;background:#fff6d6;border:1px solid #e7d492;border-radius:5px;padding:2px 8px}
/* ── CALC TABELA CONVERTIDO (Fase D1 Task 3) ──── */
.calc-cv td,.calc-cv th{font-size:11px}
.calc-cv input.cv-pago{width:120px;box-sizing:border-box;text-align:right}
.calc-cv-planilha{margin-top:12px;border:1px solid #d5ddd8;border-radius:8px;overflow:hidden}
.calc-cv-planilha .mh{background:#f0f5f2;padding:7px 12px;font-weight:700;color:#0c3d26;font-size:11px}
/* ── CALC TABELA REVISIONAL (Fase D2 Task 3) ──── */
.calc-rv td,.calc-rv th{font-size:11px}
/* ── CALC PLANILHA REVISIONAL (Fase D2 Task 4) ──── */
.rev-planilha{margin-top:12px;border:1px solid #d5ddd8;border-radius:8px;overflow:hidden;padding-bottom:8px}
.rev-planilha .mh{background:#f0f5f2;padding:7px 12px;font-weight:700;color:#0c3d26;font-size:11px}
.rev-resumo{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:8px 10px}
.rev-resumo .rc{border:1px solid #e2e8e4;border-radius:7px;padding:7px 9px;text-align:center}
.rev-resumo .rc .l{font-size:9px;color:#3f4a44;text-transform:uppercase}
.rev-resumo .rc .v{font-weight:700;color:var(--v);font-size:13px}
.rev-subtabs{display:flex;gap:6px;padding:0 10px 8px}
.rev-subtab{border:1px solid #cfe0d6;border-radius:6px;padding:3px 10px;font-size:10px;color:var(--v);cursor:pointer;background:#fff}
.rev-subtab.on{background:var(--v);color:#fff}
.bd-body{max-height:60vh;overflow:auto}
.bd-sec{margin-bottom:14px}
.bd-h{font-weight:800;color:#0c3d26;font-size:12px;margin-bottom:4px}
.bd-meta{font-size:11px;color:#20241f;margin-bottom:6px}
.bd-warn{font-size:12px;color:#a5402c;background:#fbf0ee;border:1px solid #e6c3bc;border-radius:6px;padding:8px 10px}
.bd-scroll{max-height:44vh;overflow:auto;border:1px solid #cfe0d6;border-radius:7px}
.bd-tbl{width:100%;border-collapse:collapse;font-size:10.5px}
.bd-tbl th,.bd-tbl td{padding:4px 6px;border-bottom:1px solid #eef1f0;white-space:nowrap;text-align:right;color:#20241f}
.bd-tbl th{font-size:8.5px;text-transform:uppercase;letter-spacing:.03em;color:#0c3d26;background:#f0f5f2;position:sticky;top:0}
.bd-tbl td.p,.bd-tbl th.p{text-align:left}
.bd-tot{text-align:right;font-size:12px;color:#0f5132;font-weight:800;margin-top:6px}
.cf-fav{border:1.5px solid #0f5132;border-radius:9px;padding:11px 12px;background:#f2f8f4;margin-bottom:11px}
.cf-top{display:flex;align-items:baseline;gap:9px;margin-bottom:8px}
.cf-star{background:#ffd84d;color:#3a2d00;border-radius:5px;padding:2px 8px;font-weight:800;font-size:11px}
.cf-desc{font-weight:700;color:#14372c;font-size:12px}
.cf-tot{margin-left:auto;text-align:right}
.cf-tot .l{font-size:9px;text-transform:uppercase;letter-spacing:.04em;color:#2c4a3a;font-weight:800;display:block}
.cf-tot .v{font-family:Menlo,Consolas,monospace;font-size:20px;font-weight:800;color:#0f5132}
.cf-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.cf-m{background:#fff;border:1px solid #cfe0d6;border-radius:6px;padding:5px 7px}
.cf-m .k{font-size:8.5px;text-transform:uppercase;color:#2c4a3a;font-weight:800}
.cf-m .v{font-family:Menlo,Consolas,monospace;font-size:12px;font-weight:800;color:#14372c}
.cf-m.neg .v{color:#a5402c}
</style>
</head>
<body>
<script>try{
  // Reset único: se o usuário salvou tema dark numa versão antiga, limpar.
  // Marca essa versão como já reseteada para não apagar de novo no futuro.
  if(!localStorage.getItem('pbl_theme_reset_v2')){
    localStorage.removeItem('pbl_theme');
    localStorage.setItem('pbl_theme_reset_v2','1');
  }
  if(localStorage.getItem('pbl_theme')==='dark')document.body.classList.add('dark');
}catch(e){}</script>

