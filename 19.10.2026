6 L28.5329312,34.6086345 L44.3020593,34.6086345 C45.4977139,34.6086345 46.6270343,34.6086345 47.5159953,34.5523586 C49.0789451,34.4567724 50.7860287,34.2324966 52.6818783,33.243531 C54.233363,32.3658759 55.3430287,31.3702897 56.1775301,30.1053241 C57.0525691,28.6897379 57.4780092,27.2493241 57.4780092,25.7004966 C57.4780092,22.6450483 56.3101986,20.3931862 53.8030092,18.6147034 Z" id="lg-Fill-3" fill="#063D38"></path>
