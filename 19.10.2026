// ── PERSIST ────────────────────────────────────────────────
function saveData(){try{localStorage.setItem('pbl_v4',JSON.stringify(S));}catch(e){}showToast('Salvo!');}
async function loadData(){
  // Carrega tudo do Firestore. /gestorasMetas e /geracaoNegocios ainda nao migrados (Plano 2C).
  if(!S.gestorasMetas)S.gestorasMetas={};
  if(!S.gnSessao)S.gnSessao=null;
  // Mantem fallback de localStorage para as collections nao-migradas (campanhas, gestorasMetas, gnSessao).
  try{
    var r=localStorage.getItem('pbl_v4');
    if(r){var d=JSON.parse(r);
      // campanhas/gestorasMetas/gnSessao agora vem do Firestore; mantém merge para outras chaves legadas.
    }
  }catch(e){}
  if(!S.campanhas)S.campanhas=[];
  // Collections no Firestore (fonte de verdade)
  try{ S.processos=await fetchCollection('processos'); }catch(e){ S.processos=[]; if(currentUser && ['admin','gestora','supervisora','lawyer','gestor_calculos'].indexOf(currentUser.role)>=0) showToast('Erro processos: '+(e.code||e.message)); }
  S.recebByProc={}; try{ await loadRecebimentos(); }catch(e){ S.recebByProc={}; }
  S.monByProc=S.monByProc||{}; try{ await loadMonAll(); }catch(e){ S.monByProc=S.monByProc||{}; }
  try{ S.lawyers=ordenaLawyers(await fetchCollection('lawyers')); }catch(e){ S.lawyers=[]; showToast('Erro lawyers: '+(e.code||e.message)); }
  try{ S.gestoras=await fetchCollection('gestoras'); }catch(e){ S.gestoras=[]; }
  try{ S.liqManual=await fetchCollection('liquidacoes'); }catch(e){ S.liqManual=[]; }
  try{ S.leads=await fetchCollection('leads'); }catch(e){ S.leads=[]; }
  try{ S.calculos=await fetchCollection('calculos'); }catch(e){ S.calculos=[]; }
  try{ S.partes=await fetchCollection('partes'); }catch(e){ S.partes=[]; }
  try{ S.analisesIA=await fetchCollection('analisesIA'); }catch(e){ S.analisesIA=[]; }
  try{ S.manual=await fetchCollection('manual'); }catch(e){ S.manual=[]; }
  try{ S.financeiro=await fetchCollection('lancamentos'); }catch(e){ S.financeiro=[]; }
  try{ S.contas=await fetchCollection('contas'); }catch(e){ S.contas=[]; }
  try{
    if(currentUser && currentUser.role==='lawyer' && currentUser.lawyerId){
      var _vq=fb.query(fb.collection(fb.db,'validacoes'), fb.where('advogadoId','==',currentUser.lawyerId));
      var _vs=await fb.getDocs(_vq);
      S.distribValidacao=_vs.docs.map(function(d){return Object.assign({id:d.id},d.data());});
    } else {
      S.distribValidacao=await fetchCollection('validacoes');
    }
  }catch(e){ S.distribValidacao=[]; }
  try{
    var entriesArr=await fetchCollection('entries');
    S.entries={};
    entriesArr.forEach(function(e){ S.entries[e.id]=e; });
  }catch(e){ S.entries={}; }
  try{ S.campanhas=await fetchCollection('campanhas'); }catch(e){ S.campanhas=[]; }
  try{
    var metasArr=await fetchCollection('gestorasMetas');
    S.gestorasMetas={};
    metasArr.forEach(function(m){ S.gestorasMetas[m.id]=m; });
  }catch(e){ S.gestorasMetas={}; }
  try{
    var gnDoc=await fb.getDoc(fb.doc(fb.db,'geracaoNegocios','current'));
    S.gnSessao = (gnDoc.exists() && gnDoc.data().data) ? gnDoc.data().data : null;
  }catch(e){ S.gnSessao=null; }
}

// ── UTILS ──────────────────────────────────────────────────
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function parseValor(v){if(typeof v==='number')return v;var s=String(v||'').trim().replace(/[R$\s]/g,'').replace(/\./g,'').replace(',','.');return parseFloat(s)||0;}
function getCol(row,keys){for(var i=0;i<keys.length;i++){for(var k in row){if(k.trim().toLowerCase()===keys[i].toLowerCase())return row[k];}}return null;}
function fmtDate(d){if(!d)return'';try{var p=String(d).slice(0,10).split('-');return p[2]+'/'+p[1]+'/'+p[0];}catch(e){return d;}}
function todayStr(){return new Date().toISOString().slice(0,10);}
function fmt(v){return'R$ '+Number(v||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});}
function fmtK(v){if(v>=1000000)return'R$ '+(v/1000000).toFixed(1)+'M';if(v>=1000)return'R$ '+(v/1000).toFixed(0)+'k';return fmt(v);}
function ini(n){return(n||'?').trim().split(' ').slice(0,2).map(function(x){return x[0].toUpperCase();}).join('');}
function avSt(i){var c=AVC[i%AVC.length];return'background:'+c.bg+';color:'+c.c+';';}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2);}
function showToast(m){var t=document.getElementById('toast');t.textContent=m;t.classList.add('show');setTimeout(function(){t.classList.remove('show');},1400);}
function toggleTheme(){
  var dark=document.body.classList.toggle('dark');
  try{localStorage.setItem('pbl_theme',dark?'dark':'light');}catch(e){}
  var btn=document.getElementById('btn-theme');
  if(btn) btn.textContent=dark?'☀️':'🌙';
}
// Menu recolhido = faixa só com os ícones (o rótulo aparece como dica ao passar o mouse).
// Preferência por navegador.
function setSidebarCollapsed(off){
  document.body.classList.toggle('sb-collapsed', off);
  var btn=document.getElementById('btn-sb');
  if(btn){
    btn.title=off?'Expandir menu':'Recolher menu';
    var ic=btn.querySelector('.sb-toggle-ic'); if(ic) ic.textContent=off?'»':'«';
  }
  // Gráficos (Chart.js) medem o contêiner ao desenhar: avisa para redimensionarem.
  window.dispatchEvent(new Event('resize'));
}
function toggleSidebar(){
  var off=!document.body.classList.contains('sb-collapsed');
  try{localStorage.setItem('pbl_sb_collapsed',off?'1':'0');}catch(e){}
