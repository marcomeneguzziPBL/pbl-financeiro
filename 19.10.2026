                        <path d="M27.1809961,26.1099724 L27.1535616,26.2990759 C26.9312189,27.8143862 26.0459432,29.4339724 25.4886535,30.0993517 C23.0027565,33.0401793 20.5971159,33.0306621 17.5842301,33.0385241 L17.4204418,33.0385241 C14.2777538,33.0385241 11.8287092,32.0429379 11.1584056,31.3663862 C10.1396423,30.3906621 9.95333315,29.1484552 9.95333315,27.048869 C9.89887354,24.8466621 10.0073833,6.76762759 10.0086117,6.58390345 C10.0086117,5.49148966 10.0597955,4.66969655 10.1711716,3.99604138 C10.2923749,3.26114483 10.4651716,2.79314483 10.7333749,2.4770069 C10.9888847,2.16748966 11.404907,1.91342069 11.8827593,1.76735172 C12.5039265,1.65314483 13.203712,1.54762759 14.1086423,1.54762759 L14.3133777,1.54762759 L14.3133777,0.297972414 L0.767266295,0.240455172 L0.767266295,1.47935172 L0.959308078,1.49135172 C1.99526908,1.55714483 2.77039721,1.69204138 3.1262273,1.76362759 C3.74944178,1.93535172 4.1118234,2.14473103 4.35996267,2.49107586 C4.62120501,2.75507586 4.79113538,3.16845517 4.90988189,3.82886897 C5.02125794,4.50211034 5.07285125,5.28873103 5.07285125,6.30417931 L5.0175727,28.2815586 C5.0175727,29.3785241 4.94960056,30.1411448 4.79973426,30.7014207 C4.6969571,31.3245931 4.49345014,31.7934207 4.19412702,32.0950759 C3.91814373,32.3739724 3.47878162,32.5936966 2.85474819,32.7658345 C2.1909961,32.9334207 1.3888429,32.9868 0.409388858,33.0385241 L0.215709192,33.048869 L0.215709192,34.344869 L27.7092134,34.344869 L28.4053136,26.192731 L27.1809961,26.1099724 Z" id="hd-Fill-5" fill="#FFFFFF" mask="url(#hd-mask-6)"></path>
