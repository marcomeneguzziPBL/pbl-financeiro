      (podeVerAdministrativo(currentUser) ? ni('notif1',I.notificacoes,'Administrativo') : '');
  } else if(currentUser.role==='juridico' || currentUser.role==='comercial'){
    // Jurídico/Comercial — Dashboard, Processos e Liquidações (edita processo; não exclui nada).
    sb.innerHTML=
      '<div class="sb-section">Principal</div>'+
      ni('dashboard',I.dashboard,'Dashboard')+
      ni('processos',I.processos,'Processos')+
      ni('agenda',I.agenda,'Agenda')+
      ni('reliquidados',I.reliq,'Liquidações')+
      (podeVerAdministrativo(currentUser) ? ('<div class="sb-section">Contencioso</div>'+ni('notif1',I.notificacoes,'Administrativo')) : '');
  } else {
    // Advogado — Principal completo EXCETO Liquidações (read-only); Notificações tudo; Minhas Comissões propria.
    sb.innerHTML=
      '<div class="sb-section">Principal</div>'+
      ni('dashboard',I.dashboard,'Dashboard')+
      ni('distrib',I.resumo,'Validações PBL')+
