var CX_LOCALDATA='<p style="margin-top:18px">{{CIDADE}}/{{UF}}, {{DATA_DIA}} de {{DATA_MES}} de {{DATA_ANO}}.</p>';
var CX_TESTE='<p style="margin-top:24px">Representante da cessionária<br>Piercarlo Blando</p><p style="margin-top:18px">Testemunhas</p><p>Assinatura: ___________________________ &nbsp; Assinatura: ___________________________<br>Nome: _________________________________ &nbsp; Nome: _________________________________<br>CPF: __________________________________ &nbsp; CPF: __________________________________</p>';
function _qualAutor(rot){ return '<p><b>'+(rot||'CEDENTE')+':</b> {{CED_NOME}}<br>Profissão: {{CED_PROF}}<br>Nacionalidade: Brasileiro(a)<br>Estado Civil: {{CED_ESTCIV}}<br>Nascimento: {{CED_NASC}}<br>RG: {{CED_RG}}<br>CPF: {{CED_CPF}}<br>Telefone: {{CED_TEL}}<br>Residente: {{CED_RES}}<br>Bairro: {{CED_BAIRRO}}<br>Cidade: {{CED_CIDADE}}<br>UF: {{CED_UF}}<br>CEP: {{CED_CEP}}</p>'; }
function _qualAdv(rot){ return '<p><b>'+(rot||'CEDENTE')+':</b> {{ADV_NOME}}<br>Profissão: {{ADV_PROF}}<br>Nacionalidade: Brasileiro(a)<br>Estado Civil: {{ADV_ESTCIV}}<br>Nascimento: {{ADV_NASC}}<br>OAB/UF: {{ADV_OAB}}<br>CPF: {{ADV_CPF}}<br>Telefone: {{ADV_TEL}}<br>Residente: {{ADV_RES}}<br>Bairro: {{ADV_BAIRRO}}<br>Cidade: {{ADV_CIDADE}}<br>UF: {{ADV_UF}}<br>CEP: {{ADV_CEP}}</p>'; }
// ── Modelos de contrato ──
function CONTRATO_MODELOS(){ return [
  { id:'cess_hon_contr', grupo:'Cessão de Crédito', nome:'Honorários Contratuais (1 cedente)', titulo:'CONTRATO DE CESSÃO DE CRÉDITO DE AÇÃO JUDICIAL',
    corpo:_qualAdv('CEDENTE')+CX_CESSIONARIA+
      '<p><b>Cláusula 1ª:</b> O presente contrato tem como objeto a transferência total à CESSIONÁRIA dos direitos creditórios disponíveis referentes aos honorários contratuais de que é titular o(a) CEDENTE, vinculados ao Processo nº {{NPROC}}, em tramitação na {{VARA}} da Comarca de {{COMARCA}}, que tem o(a) Sr(a). {{AUTOR}} como Autor(a), o(a) CEDENTE como Procurador(a) do(a) Autor(a), e {{REU}} como Réu(s), tendo a CESSIONÁRIA ciência plena de seu conteúdo.</p>'+
      '<p><b>Cláusula 2ª:</b> Os direitos creditórios correspondem ao valor total que couber ao CEDENTE no referido processo, incluídos correção monetária, juros, multas e pagamentos complementares até o arquivamento definitivo, após o devido abatimento das obrigações legais.</p>'+
      '<p><b>Cláusula 3ª:</b> O CEDENTE cede e transfere à CESSIONÁRIA, de forma irrevogável e irretratável, a totalidade dos direitos creditórios referentes aos honorários contratuais vinculados ao processo, pelo valor total de {{VALOR}} ({{VALOR_EXT}}), pago por transferência bancária no ato da assinatura.</p>'+
      '<p><b>Cláusula 4ª a 8ª:</b> Quitação, exclusividade, riscos pela CESSIONÁRIA, vigência a partir da assinatura e foro da Comarca de Florianópolis/SC. <span class="cx-todo">(cláusulas completas — editar conforme o modelo)</span></p>'+
      CX_LOCALDATA+'<p style="margin-top:18px">Cedente: {{ADV_NOME}} (OAB/UF {{ADV_OAB}}).</p>'+CX_TESTE },
  { id:'cess_triplo', grupo:'Cessão de Crédito', nome:'Triplo — Principal + Contratuais + Sucumbenciais (2 cedentes)', titulo:'CONTRATO DE CESSÃO DE CRÉDITO DE AÇÃO JUDICIAL',
    corpo:_qualAutor('CEDENTE (Autor)')+_qualAdv('CEDENTE (Advogado)')+CX_CESSIONARIA+
      '<p><b>Cláusula 1ª:</b> O presente contrato tem como objeto a transferência total à CESSIONÁRIA dos direitos creditórios disponíveis de que são titulares os(as) CEDENTES, vinculados ao Processo nº {{NPROC}}, em tramitação na {{VARA}} da Comarca de {{COMARCA}}, que tem o(a) PRIMEIRO(A) CEDENTE ({{AUTOR}}) como Autor(a), o(a) SEGUNDO(A) CEDENTE como Procurador(a) do(a) Autor(a) e {{REU}} como Réu(s).</p>'+
      '<p><i>Parágrafo único:</i> São objetos da presente cessão o crédito principal, os honorários contratuais e os honorários sucumbenciais.</p>'+
      '<p><b>Cláusula 3ª:</b> OS CEDENTES cedem e transferem à CESSIONÁRIA a totalidade dos direitos creditórios disponíveis vinculados ao processo, pelo valor total de {{VALOR}} ({{VALOR_EXT}}), pago por transferência bancária no ato da assinatura, para a conta do(a) SEGUNDO(A) CEDENTE, que prestará contas ao PRIMEIRO(A) CEDENTE.</p>'+
      '<p><b>Demais cláusulas:</b> quitação, exclusividade, riscos pela CESSIONÁRIA, vigência e foro de Florianópolis/SC. <span class="cx-todo">(editar conforme o modelo)</span></p>'+
      CX_LOCALDATA+'<p style="margin-top:18px">Cedente: {{AUTOR}}, representado(a) por seu(sua) procurador(a), Dr.(a) {{ADV_NOME}} (OAB/UF {{ADV_OAB}}).<br>Cedente: {{ADV_NOME}} (OAB/UF {{ADV_OAB}}).</p>'+CX_TESTE },
  { id:'cess_danos_morais', grupo:'Cessão de Crédito', nome:'Danos Morais — valor pago (sem danos materiais, 2 cedentes)', titulo:'CONTRATO DE CESSÃO DE CRÉDITO DE AÇÃO JUDICIAL',
    corpo:_qualAutor('CEDENTE (Autor)')+_qualAdv('CEDENTE (Advogado)')+CX_CESSIONARIA+
      '<p><b>Cláusula 1ª:</b> Transferência total à CESSIONÁRIA dos direitos creditórios de que são titulares os CEDENTES, vinculados ao Processo nº {{NPROC}}, na {{VARA}} da Comarca de {{COMARCA}}, tendo {{AUTOR}} como Autor(a) e {{REU}} como Réu(s).</p>'+
      '<p><i>Parágrafo único:</i> São objetos da cessão o crédito principal, os honorários contratuais e os honorários sucumbenciais referentes aos danos morais, NÃO fazendo parte deste negócio a condenação em danos materiais, cuja execução e titularidade permanecem sob responsabilidade dos CEDENTES.</p>'+
      '<p><b>Cláusula 3ª:</b> Cessão pelo valor total de {{VALOR}} ({{VALOR_EXT}}), pago por transferência bancária no ato da assinatura, para a conta do(a) SEGUNDO(A) CEDENTE.</p>'+
      '<p><b>Demais cláusulas:</b> quitação, exclusividade, riscos, vigência e foro de Florianópolis/SC. <span class="cx-todo">(editar conforme o modelo)</span></p>'+
      CX_LOCALDATA+'<p style="margin-top:18px">Cedente: {{AUTOR}}, representado(a) por Dr.(a) {{ADV_NOME}} (OAB/UF {{ADV_OAB}}).<br>Cedente: {{ADV_NOME}} (OAB/UF {{ADV_OAB}}).</p>'+CX_TESTE },
  { id:'substab_sem', grupo:'Substabelecimento', nome:'Substabelecimento SEM reservas', titulo:'SUBSTABELECIMENTO SEM RESERVA DE PODERES',
    corpo:'<p>{{ADV_NOME}}, brasileiro(a), advogado(a), inscrito(a) na OAB/{{ADV_OAB_UF}} sob o nº {{ADV_OAB_NUM}}, residente na {{ADV_RES}}, Bairro {{ADV_BAIRRO}}, {{ADV_CIDADE}}/{{ADV_UF}}, CEP {{ADV_CEP}}, <b>SUBSTABELECE SEM RESERVA DE PODERES</b>, na pessoa de EVILYN WAGNER DE SOUZA, brasileira, solteira, advogada, inscrita na OAB/SC sob o nº 53.146; e EVILYN WAGNER DE SOUZA SOCIEDADE INDIVIDUAL DE ADVOCACIA, CNPJ 57.587.002/0001-46, OAB/SC nº 10.648, ambas com domicílio na Rua Jacob Villain Filho, 2025, Guarda do Cubatão, Palhoça/SC, CEP 88135-398, os poderes conferidos por {{AUTOR}}, por meio da procuração acostada nos autos nº {{NPROC}}, que tramita na {{VARA}} da Comarca de {{COMARCA}}, habilitando-a para praticar todos os atos necessários ao bom e fiel cumprimento do referido mandato.</p>'+
      CX_LOCALDATA+'<p style="margin-top:30px">________________________________________________<br>{{ADV_NOME}}<br>OAB/{{ADV_OAB_UF}} nº {{ADV_OAB_NUM}}</p>' },
  { id:'substab_com', grupo:'Substabelecimento', nome:'Substabelecimento COM reservas', titulo:'SUBSTABELECIMENTO COM RESERVA DE PODERES',
    corpo:'<p>EVILYN WAGNER DE SOUZA, brasileira, solteira, advogada, inscrita na OAB/SC sob o nº 53.146, com endereço profissional à Rua Jacob Villain Filho, nº 2025, Bairro Guarda do Cubatão, Palhoça/SC, CEP 88135-398, <b>substabelece, com reserva de poderes</b>, ao(à) advogado(a) {{ADV_NOME}}, brasileiro(a), advogado(a), inscrito(a) na OAB/{{ADV_OAB_UF}} sob o nº {{ADV_OAB_NUM}}, residente na {{ADV_RES}}, Bairro {{ADV_BAIRRO}}, {{ADV_CIDADE}}/{{ADV_UF}}, CEP {{ADV_CEP}}, os poderes que lhe foram outorgados por {{AUTOR}}, conforme procuração acostada aos autos do processo nº {{NPROC}}, em trâmite na {{VARA}} da Comarca de {{COMARCA}}.</p>'+
      '<p>O presente substabelecimento confere poderes para a prática de atos de peticionamento, <span class="cx-todo">(especificar objeto/limitações)</span>, vedada expressamente a realização de levantamento de valores ou novo substabelecimento sem autorização.</p>'+
      CX_LOCALDATA+'<p style="margin-top:30px">EVILYN WAGNER DE SOUZA — OAB/SC nº 53.146</p>' },
  { id:'aditivo_repasse', grupo:'Aditivo', nome:'Aditivo — Cláusula de repasse', titulo:'ADITIVO AO CONTRATO DE CESSÃO DE CRÉDITO DE AÇÃO JUDICIAL',
    corpo:_qualAutor('CEDENTE (Autor)')+_qualAdv('CEDENTE (Advogado)')+CX_CESSIONARIA+
      '<p>As partes retro qualificadas firmaram o Contrato de Cessão de Crédito vinculado ao Processo nº {{NPROC}}, na {{VARA}} da Comarca de {{COMARCA}}, que tem o(a) PRIMEIRO(A) CEDENTE ({{AUTOR}}) como Autor(a), o(a) SEGUNDO(A) CEDENTE como Procurador(a) e {{REU}} como Réu(s).</p>'+
      '<p>Na hipótese de recebimento de valores diretamente na conta do advogado (SEGUNDO CEDENTE), fica este obrigado a repassá-los integralmente à CESSIONÁRIA, PBL - COMPRA DE CRÉDITOS JUDICIAIS LTDA, no prazo máximo de 2 (dois) dias úteis, sob pena de responsabilidade pelos prejuízos decorrentes de atraso ou retenção indevida.</p>'+
      '<p>As partes estabelecem que o presente aditivo não poderá ser acostado no processo em comento. Ficam ratificadas as demais cláusulas do instrumento ora alterado.</p>'+
      CX_LOCALDATA+'<p style="margin-top:18px">Cedente: {{AUTOR}}, representado(a) por Dr.(a) {{ADV_NOME}} (OAB/UF {{ADV_OAB}}).<br>Cedente: {{ADV_NOME}} (OAB/UF {{ADV_OAB}}).</p>'+CX_TESTE },
  { id:'aditivo_resp', grupo:'Aditivo', nome:'Aditivo — Cláusula de responsabilidade (2 advogados)', titulo:'ADITIVO AO CONTRATO DE CESSÃO DE CRÉDITO DE AÇÃO JUDICIAL',
    corpo:_qualAutor('CEDENTE (Autor)')+_qualAdv('CEDENTE (Advogado)')+'<p><b>CEDENTE (2º Advogado):</b> <span class="cx-todo">____ (qualificação)</span></p>'+CX_CESSIONARIA+
      '<p>As partes firmaram o Contrato de Cessão vinculado ao Processo nº {{NPROC}}, na {{VARA}} da Comarca de {{COMARCA}}, tendo {{AUTOR}} como Autor(a) e {{REU}} como Réu(s).</p>'+
      '<p>Através do presente aditivo, o SEGUNDO e o TERCEIRO CEDENTES responsabilizam-se integralmente por quaisquer cobranças de terceiros advogados referentes a honorários decorrentes desta ação, arcando com todos os custos e honorários de eventuais colaboradores, não sendo imputada à cessionária qualquer obrigação financeira adicional.</p>'+
      '<p>O presente aditivo não poderá ser acostado no processo. Ficam ratificadas as demais cláusulas.</p>'+
      CX_LOCALDATA+'<p style="margin-top:18px">Cedente: {{AUTOR}}, representado(a) por seus procuradores.<br>Cedente: {{ADV_NOME}} (OAB/UF {{ADV_OAB}}).<br>Cedente: <span class="cx-todo">____</span> (OAB/UF {{ADV_OAB}}).</p>'+CX_TESTE },
  { id:'termo_anuencia', grupo:'Termos', nome:'Termo de Anuência', titulo:'TERMO DE ANUÊNCIA',
    corpo:'<p><span class="cx-todo">NOME DO ANUENTE</span>, brasileiro(a), advogado(a), inscrito(a) na OAB/<span class="cx-todo">__</span> sob nº <span class="cx-todo">____</span>, declara estar ciente da cessão de créditos realizada entre o(a) Dr(a). {{ADV_NOME}}, advogado(a), inscrito(a) na OAB/<span class="cx-todo">__</span> sob o nº <span class="cx-todo">____</span>, e a cessionária PBL COMPRA DE CRÉDITOS JUDICIAIS, informando ainda que não possui valores de honorários contratuais e sucumbenciais na ação nº {{NPROC}}, que tem {{AUTOR}} como Autor(a) e {{REU}} como Réu.</p>'+
      CX_LOCALDATA+'<p style="margin-top:30px">________________________________________________<br><span class="cx-todo">NOME DO ANUENTE</span><br>OAB/UF <span class="cx-todo">____</span></p>' }
]; }
// ── Cessão de Crédito configurável (objeto + abrangência) ──
function cessaoObjetoTxt(objArr){
  var map={principal:'o crédito principal', contratuais:'os honorários contratuais', sucumbenciais:'os honorários sucumbenciais'};
  var arr=objArr.map(function(k){return map[k];}).filter(Boolean);
  if(!arr.length) return 'os direitos creditórios disponíveis';
  if(arr.length===1) return arr[0];
  return arr.slice(0,-1).join(', ')+' e '+arr[arr.length-1];
}
// Variacoes gramaticais do objeto: sem artigo ("montante de X") e contraido ("referentes ao/aos X")
function cessaoObjetoNu(objArr){
  var map={principal:'crédito principal', contratuais:'honorários contratuais', sucumbenciais:'honorários sucumbenciais'};
  var arr=objArr.map(function(k){return map[k];}).filter(Boolean);
  if(!arr.length) return 'direitos creditórios disponíveis';
  if(arr.length===1) return arr[0];
  return arr.slice(0,-1).join(', ')+' e '+arr[arr.length-1];
}
function cessaoObjetoAo(objArr){
  var map={principal:'ao crédito principal', contratuais:'aos honorários contratuais', sucumbenciais:'aos honorários sucumbenciais'};
  var arr=objArr.map(function(k){return map[k];}).filter(Boolean);
  if(!arr.length) return 'aos direitos creditórios disponíveis';
  if(arr.length===1) return arr[0];
  return arr.slice(0,-1).join(', ')+' e '+arr[arr.length-1];
}
function cessaoAbrangTxt(abr){
  if(abr==='morais') return ', referentes aos danos morais, não fazendo parte deste negócio a condenação em danos materiais, permanecendo a execução e titularidade sob responsabilidade dos CEDENTES';
  if(abr==='materiais') return ', referentes aos danos materiais, não fazendo parte deste negócio a condenação em danos morais, permanecendo a execução e titularidade sob responsabilidade dos CEDENTES';
  return '';
}
function cessaoTituloObjeto(objArr,abr){
  var m={principal:'Principal',contratuais:'Contratuais',sucumbenciais:'Sucumbenciais'};
  var t=objArr.map(function(k){return m[k];}).join(' + ')||'Créditos';
  var a=abr==='morais'?' (danos morais)':abr==='materiais'?' (danos materiais)':'';
  return t+a;
}
// Contrato de cessão CÍVEL — texto integral e fiel às minutas (1 ou 2 cedentes)
function montarCessaoCorpo(objArr,abr){
  var dois=objArr.indexOf('principal')>=0;
  var objTxt=cessaoObjetoTxt(objArr);
  var objNu=cessaoObjetoNu(objArr);
  var objAo=cessaoObjetoAo(objArr);
  var abrTxt=cessaoAbrangTxt(abr);
  var quals=dois?(_qualAutor('PRIMEIRO(A) CEDENTE (Autor)')+_qualAdv('SEGUNDO(A) CEDENTE (Advogado)')):_qualAdv('CEDENTE (Advogado)');
  var c1;
  if(dois){
    c1='<p><b>Cláusula 1ª:</b> O presente contrato tem como objeto a transferência total à CESSIONÁRIA dos direitos creditórios disponíveis de que são titulares os(as) CEDENTES, vinculados ao Processo nº {{NPROC}}, em tramitação na {{VARA}} da Comarca de {{COMARCA}}, que tem o(a) PRIMEIRO(A) CEDENTE como Autor(a), o(a) SEGUNDO(A) CEDENTE como Procurador(a) do(a) Autor(a) e {{REU}} como Réu(s), tendo a CESSIONÁRIA ciência plena de seu conteúdo.</p>'+
      '<p><i>Parágrafo único:</i> São objetos da presente cessão '+objTxt+abrTxt+'.</p>';
  } else {
    c1='<p><b>Cláusula 1ª:</b> O presente contrato tem como objeto a transferência total à CESSIONÁRIA dos direitos creditórios disponíveis referentes '+objAo+abrTxt+' de que é titular o(a) CEDENTE, vinculados ao Processo nº {{NPROC}}, em tramitação na {{VARA}} da Comarca de {{COMARCA}}, que tem o(a) Sr(a). {{AUTOR}} como Autor(a), o(a) CEDENTE como Procurador(a) do(a) Autor(a), e {{REU}} como Réu(s), tendo a CESSIONÁRIA ciência plena de seu conteúdo.</p>';
  }
  var c2='<p><b>Cláusula 2ª:</b> Os direitos creditórios disponíveis a que se refere a Cláusula 1ª correspondem ao valor total que couber '+(dois?'aos(às) CEDENTES':'ao(à) CEDENTE')+' no referido processo, incluídos correção monetária, juros, multas e pagamentos complementares até o arquivamento definitivo do processo, após o devido abatimento das obrigações legais.</p>';
  var c3;
  if(dois){
    c3='<p><b>Cláusula 3ª:</b> OS CEDENTES, pelo presente instrumento, cedem e transferem à CESSIONÁRIA, de forma irrevogável e irretratável, a totalidade dos direitos creditórios disponíveis vinculados ao processo a que se refere a Cláusula 1ª, nos termos referidos na Cláusula 2ª, pelo valor total de {{VALOR}} ({{VALOR_EXT}}), quantia que será paga de forma imediata, por meio de transferência bancária no ato da assinatura dos CEDENTES no presente contrato.</p>'+
      '<p><i>Parágrafo primeiro:</i> O presente contrato somente terá validade após a comprovação do pagamento a que se refere ao caput da presente cláusula.</p>'+
      '<p><i>Parágrafo segundo:</i> No valor indicado no caput do presente artigo estão englobados o montante de '+objNu+', sendo que o montante será pago para a conta de titularidade do(a) SEGUNDO(A) CEDENTE, via transferência bancária, que deverá fazer a prestação de contas com o(a) seu(sua) cliente, ora PRIMEIRO(A) CEDENTE.</p>';
  } else {
    c3='<p><b>Cláusula 3ª:</b> O CEDENTE, pelo presente instrumento, cede e transfere à CESSIONÁRIA, de forma irrevogável e irretratável, a totalidade dos direitos creditórios disponíveis referentes '+objAo+' vinculados ao processo a que se refere a Cláusula 1ª, nos termos referidos na Cláusula 2ª, pelo valor total de {{VALOR}} ({{VALOR_EXT}}), quantia que será paga de forma imediata, por meio de transferência bancária no ato da assinatura do(a) CEDENTE no presente contrato.</p>'+
      '<p><i>Parágrafo primeiro:</i> O presente contrato somente terá validade após a comprovação do pagamento a que se refere ao caput da presente cláusula.</p>'+
      '<p><i>Parágrafo segundo:</i> No valor indicado no caput do presente artigo estão englobados o montante dos valores referentes '+objAo+', sendo que o montante será pago para a conta de titularidade do(a) CEDENTE, via transferência bancária, que deverá fazer a prestação de contas com o(a) seu(sua) cliente, ora, parte Autora da ação.</p>';
  }
  var c4='<p><b>Cláusula 4ª:</b> '+(dois?'OS CEDENTES':'O CEDENTE')+', após a efetivação da transferência bancária do preço da cessão, no prazo a que se refere a Cláusula 3ª, '+(dois?'dão':'dá')+' plena, rasa, geral e irrevogável quitação do seu pagamento para nada mais repetir ou reclamar, seja a que título for, em razão desta avença, nos autos do processo indicado na Cláusula 1ª, assumindo, inclusive, suas obrigações tributárias na forma da legislação em vigor.</p>';
  var c5='<p><b>Cláusula 5ª:</b> '+(dois?'OS CEDENTES declaram':'O CEDENTE declara')+' que não '+(dois?'negociaram e nem negociarão':'negociou e nem negociará')+' estes direitos creditórios com terceiros, sendo atualmente '+(dois?'legítimos e únicos proprietários':'legítimo e único proprietário')+' dos direitos em questão, com plenos poderes para deles dispor.</p>';
  var c6='<p><b>Cláusula 6ª:</b> A CESSIONÁRIA assumirá os riscos do negócio jurídico, responsabilizando-se pela solvência do devedor.</p>';
  var c7='<p><b>Cláusula 7ª:</b> O presente contrato passa a vigorar entre as partes a partir de sua assinatura.</p>';
  var c8='<p><b>Cláusula 8ª:</b> Para dirimir quaisquer controvérsias oriundas do presente contrato, as partes elegem o foro da Comarca de Florianópolis/SC;</p>';
  var fecho='<p>Por estarem assim justos e contratados, firmam o presente instrumento, em duas vias de igual teor, juntamente com 2 (duas) testemunhas.</p>';
  var assin=dois
    ? '<p style="margin-top:18px">Cedente: {{AUTOR}}, neste ato representado(a) por seu(sua) procurador(a), Dr.(a) {{ADV_NOME}} (OAB/UF {{ADV_OAB}}).<br>Cedente: {{ADV_NOME}} (OAB/UF {{ADV_OAB}}).</p>'
    : '<p style="margin-top:18px">Cedente: {{ADV_NOME}} (OAB/UF {{ADV_OAB}}).</p>';
  return quals+CX_CESSIONARIA+c1+c2+c3+c4+c5+c6+c7+c8+fecho+CX_LOCALDATA+assin+CX_TESTE;
}
// Contrato TRABALHISTA — texto fiel (autor / advogado / triplo). Vara do Trabalho/TRT, FGTS, liquidez, PIX.
var CX_TRAB_LIQ='<p><b>Cláusula de liquidez:</b> O CEDENTE, de forma voluntária, concorda que o pagamento do crédito ora cedido ocorrerá em valor superior ao valor pago mediante esta cessão, quando O CEDENTE não terá direito à resolução contratual, à complementação ou majoração do valor pago, ou a crédito de qualquer natureza contra a CESSIONÁRIA, declarando expressamente que optou pela cessão, considerando que a parte autora optou pela obtenção de liquidez imediata, em detrimento de aguardar o adimplemento da obrigação pelo Réu.</p><p><i>Parágrafo único:</i> Nessa hipótese o valor que exceder o valor pago será exclusivamente de titularidade da CESSIONÁRIA, pelo que O CEDENTE desde já concorda em não exigir ou demandar a CESSIONÁRIA em nenhuma situação.</p>';
var CX_TRAB_FGTS='<p><i>Parágrafo segundo:</i> Não estão englobados na presente cessão as verbas referentes ao Fundo de Garantia por Tempo de Serviços, pois tal montante será depositado diretamente na conta vinculada ao FGTS do CEDENTE, por força do art. 26, caput e parágrafo único, da Lei nº 8.036/1990, comprometendo-se a cessionária o repasse dos referidos valores no caso de recebimento direto do FGTS.</p>';
function montarTrabCorpo(objArr,abr){
  objArr=(objArr&&objArr.length)?objArr:['principal'];
  var temPrinc=objArr.indexOf('principal')>=0;
  var temHon=objArr.indexOf('contratuais')>=0||objArr.indexOf('sucumbenciais')>=0;
  var tipo=temPrinc?(temHon?'triplo':'autor'):'adv';
  var objTxt=cessaoObjetoTxt(objArr);
  var objNu=cessaoObjetoNu(objArr);
  var abrTxt=cessaoAbrangTxt(abr);
  var honTxt=cessaoObjetoTxt(objArr.filter(function(k){return k!=='principal';}));
  var procLinha='vinculado ao Processo de Conhecimento nº {{NPROC}}, Cumprimento de Sentença nº <span class="cx-todo">____</span>, em tramitação na {{VARA}} — TRT da <span class="cx-todo">__</span>ª Região';
  if(tipo==='adv'){
    return _qualAdv('CEDENTE (Advogado)')+CX_CESSIONARIA+
      '<p><b>Cláusula 1ª.</b> O presente contrato tem como objeto a transferência total à CESSIONÁRIA dos direitos creditórios disponíveis de que é titular a CEDENTE, '+procLinha+', que tem o Sr(a). {{AUTOR}} como Autor(a), a CEDENTE como Procuradora do Autor e {{REU}} como Réu, tendo a CESSIONÁRIA ciência plena de seu conteúdo.</p>'+
      '<p><i>Parágrafo único:</i> São objetos da presente cessão '+objTxt+abrTxt+'.</p>'+
      '<p><b>Cláusula 2ª:</b> Os direitos creditórios disponíveis a que se refere a Cláusula 1ª correspondem ao valor total que couber à CEDENTE no referido processo, incluídos correção monetária, juros, multas e pagamentos complementares até o arquivamento definitivo do processo, após o devido abatimento das obrigações legais.</p>'+
      '<p><b>Cláusula 3ª:</b> A CEDENTE, pelo presente instrumento, cede e transfere à CESSIONÁRIA, de forma irrevogável e irretratável, a totalidade dos direitos creditórios disponíveis vinculados ao processo a que se refere a Cláusula 1ª, nos termos referidos na Cláusula 2ª, pelo valor total de {{VALOR}} ({{VALOR_EXT}}), quantia que será paga de forma imediata, por meio de transferência bancária no ato da assinatura no presente contrato.</p>'+
      '<p><i>Parágrafo primeiro:</i> O presente contrato somente terá validade após a comprovação do pagamento a que se refere ao caput da presente cláusula.</p>'+
      '<p><i>Parágrafo segundo:</i> No valor indicado no caput do presente artigo estão englobados o montante de '+objNu+', que serão pagos na chave PIX <span class="cx-todo">____</span>.</p>'+
      '<p><b>Cláusula 4ª:</b> A CEDENTE, após a efetivação da transferência bancária do preço da cessão, no prazo a que se refere a Cláusula 3ª, dá plena, rasa, geral e irrevogável quitação do seu pagamento para nada mais repetir ou reclamar, seja a que título for, em razão desta avença, nos autos do processo indicado na Cláusula 1ª, assumindo, inclusive, suas obrigações tributárias na forma da legislação em vigor.</p>'+
      CX_TRAB_LIQ+
      '<p><b>Cláusula 6ª:</b> A CEDENTE declara que não negociou e nem negociará estes direitos creditórios com terceiros, sendo atualmente legítima e única proprietária dos direitos em questão, com plenos poderes para deles dispor.</p>'+
      '<p><b>Cláusula 7ª:</b> A CESSIONÁRIA assumirá os riscos do negócio jurídico, responsabilizando-se pela solvência do devedor.</p>'+
      '<p><b>Cláusula 8ª:</b> O presente contrato passa a vigorar entre as partes a partir de sua assinatura.</p>'+
      '<p><b>Cláusula 9ª:</b> Para dirimir quaisquer controvérsias oriundas do presente contrato, as partes elegem o foro da Comarca de Florianópolis/SC;</p>'+
      '<p>Por estarem assim justos e contratados, firmam o presente instrumento, em duas vias de igual teor, juntamente com 2 (duas) testemunhas.</p>'+
      CX_LOCALDATA+'<p style="margin-top:18px">Cedente: {{ADV_NOME}} (OAB/UF {{ADV_OAB}}).</p>'+CX_TESTE;
  }
  if(tipo==='triplo'){
    return _qualAutor('PRIMEIRO(A) CEDENTE (Autor)')+_qualAdv('SEGUNDA CEDENTE (Advogada)')+CX_CESSIONARIA+
      '<p><b>Cláusula 1ª.</b> O presente contrato tem como objeto a transferência total à CESSIONÁRIA dos direitos creditórios disponíveis de que são titulares as CEDENTES, vinculado ao Processo nº {{NPROC}}, em tramitação na {{VARA}}, que tem o PRIMEIRO CEDENTE como Autor, a SEGUNDA CEDENTE como Procuradora do Autor e {{REU}} como Réu, tendo a CESSIONÁRIA ciência plena de seu conteúdo.</p>'+
      '<p><i>Parágrafo primeiro:</i> São objetos da presente cessão '+objTxt+abrTxt+'.</p>'+
      CX_TRAB_FGTS+
      '<p><b>Cláusula 2ª:</b> Os direitos creditórios disponíveis a que se refere a Cláusula 1ª correspondem ao valor total que couber aos CEDENTES no referido processo, incluídos correção monetária, juros, multas e pagamentos complementares até o arquivamento definitivo do processo, após o devido abatimento das obrigações legais, observada a ressalva do Parágrafo segundo da Cláusula 1ª.</p>'+
      '<p><b>Cláusula 3ª:</b> OS CEDENTES, pelo presente instrumento, cedem e transferem à CESSIONÁRIA, de forma irrevogável e irretratável, a totalidade dos direitos creditórios disponíveis vinculados ao processo a que se refere a Cláusula 1ª, nos termos referidos na Cláusula 2ª, pelo valor total de {{VALOR}} ({{VALOR_EXT}}), quantia que será paga de forma imediata, por meio de transferência bancária.</p>'+
      '<p><i>Parágrafo primeiro:</i> O presente contrato somente terá validade após a comprovação do pagamento a que se refere ao caput da presente cláusula.</p>'+
      '<p><i>Parágrafo segundo:</i> No valor indicado no caput do presente artigo estão englobados o montante de valores principais, sendo <span class="cx-todo">R$ ____</span>, pagos na conta do PRIMEIRO CEDENTE na chave PIX <span class="cx-todo">____</span>, e '+honTxt+' no valor de <span class="cx-todo">R$ ____</span>, que serão pagos para a conta de titularidade da SEGUNDA CEDENTE, via PIX na chave <span class="cx-todo">____</span>, que deverá fazer o repasse e prestação de contas com a sua cliente, ora PRIMEIRA CEDENTE.</p>'+
      '<p><b>Cláusula 4ª:</b> OS CEDENTES, após a efetivação da transferência bancária do preço da cessão, no prazo a que se refere a Cláusula 3ª, dão plena, rasa, geral e irrevogável quitação do seu pagamento para nada mais repetir ou reclamar, seja a que título for, em razão desta avença, nos autos do processo indicado na Cláusula 1ª, assumindo, inclusive, suas obrigações tributárias na forma da legislação em vigor.</p>'+
      '<p><b>Cláusula 5ª:</b> OS CEDENTES declaram que não negociaram e nem negociarão estes direitos creditórios com terceiros, sendo atualmente legítimos e únicos proprietários dos direitos em questão, com plenos poderes para deles dispor.</p>'+
      CX_TRAB_LIQ+
      '<p><b>Cláusula 7ª:</b> A CESSIONÁRIA assumirá os riscos do negócio jurídico, responsabilizando-se pela solvência do devedor.</p>'+
      '<p><b>Cláusula 8ª:</b> O presente contrato passa a vigorar entre as partes a partir de sua assinatura.</p>'+
      '<p><b>Cláusula 9ª:</b> Para dirimir quaisquer controvérsias oriundas do presente contrato, as partes elegem o foro da Comarca de Florianópolis/SC;</p>'+
      '<p>Por estarem assim justos e contratados, firmam o presente instrumento, em duas vias de igual teor, juntamente com 2 (duas) testemunhas.</p>'+
      CX_LOCALDATA+'<p style="margin-top:18px">Cedente: {{AUTOR}} (CPF {{CED_CPF}}).<br>Cedente: {{ADV_NOME}} (OAB/UF {{ADV_OAB}}).</p>'+CX_TESTE;
  }
  // autor (padrão)
  return _qualAutor('CEDENTE (Autor)')+CX_CESSIONARIA+
    '<p><b>Cláusula 1ª.</b> O presente contrato tem como objeto a transferência total à CESSIONÁRIA dos direitos creditórios disponíveis de que é titular o CEDENTE, '+procLinha+', que tem o CEDENTE como Autor e {{REU}} como Réu, tendo a CESSIONÁRIA ciência plena de seu conteúdo.</p>'+
    '<p><i>Parágrafo primeiro:</i> São objetos da presente cessão '+objTxt+' disponível ao CEDENTE'+abrTxt+'.</p>'+
    CX_TRAB_FGTS+
    '<p><b>Cláusula 2ª:</b> Os direitos creditórios disponíveis a que se refere a Cláusula 1ª correspondem ao valor total que couber ao CEDENTE no referido processo, incluídos correção monetária, juros, multas e pagamentos complementares até o arquivamento definitivo do processo, após o devido abatimento das obrigações legais, observada a ressalva do Parágrafo segundo da Cláusula 1ª.</p>'+
    '<p><b>Cláusula 3ª:</b> O CEDENTE, pelo presente instrumento, cede e transfere à CESSIONÁRIA, de forma irrevogável e irretratável, a totalidade dos direitos creditórios disponíveis vinculados ao processo a que se refere a Cláusula 1ª, nos termos referidos na Cláusula 2ª, pelo valor total de {{VALOR}} ({{VALOR_EXT}}), quantia que será paga de forma imediata, por meio de transferência bancária no ato da assinatura do CEDENTE no presente contrato.</p>'+
    '<p><i>Parágrafo primeiro:</i> O presente contrato somente terá validade após a comprovação do pagamento a que se refere ao caput da presente cláusula.</p>'+
    '<p><i>Parágrafo segundo:</i> No valor indicado no caput do presente artigo estão englobados o montante dos valores principais disponíveis ao CEDENTE, sendo que será pago na chave PIX <span class="cx-todo">____</span>.</p>'+
    '<p><b>Cláusula 4ª:</b> O CEDENTE, após a efetivação da transferência bancária do preço da cessão, no prazo a que se refere a Cláusula 3ª, dá plena, rasa, geral e irrevogável quitação do seu pagamento para nada mais repetir ou reclamar, seja a que título for, em razão desta avença, nos autos do processo indicado na Cláusula 1ª, assumindo, inclusive, suas obrigações tributárias na forma da legislação em vigor.</p>'+
    CX_TRAB_LIQ+
    '<p><b>Cláusula 6ª:</b> O CEDENTE declara que não negociou e nem negociará estes direitos creditórios com terceiros, sendo atualmente legítimo e único proprietário dos direitos em questão, com plenos poderes para deles dispor.</p>'+
    '<p><b>Cláusula 7ª:</b> A CESSIONÁRIA assumirá os riscos do negócio jurídico, responsabilizando-se pela solvência do devedor.</p>'+
    '<p><b>Cláusula 8ª:</b> O presente contrato passa a vigorar entre as partes a partir de sua assinatura.</p>'+
