    </div>
    <div class="hdr-right">
      <div class="hdr-emp" id="hdr-emp"></div>
      <span class="hdr-user" id="hdr-user"></span>
      <button class="btn-logout" onclick="toggleTheme()" id="btn-theme" title="Alternar tema" style="font-size:14px">🌙</button>
    </div>
  </div>
  <div class="body-area">
    <nav class="sidebar" id="sidebar"></nav>
    <div class="main" id="main-content"></div>
  </div>
</div>

<div class="toast" id="toast"></div>
<div id="modal-root"></div>

<script>
/* Só o administrador altera cadastros, exclui lançamentos e fecha caixa. */
function isFullAccess(u){return u && u.role==='admin';}
// ── STATE ──────────────────────────────────────────────────
var S={
  /* estado em memoria do modulo financeiro */
  finCad:null,
  finCaixa:[],
  financeiro:[],
};
var currentUser=null;
var currentPage='dashboard';
// ── PERSIST ────────────────────────────────────────────────
/* Um registro por conta: o último caixa fechado. Cada fechamento novo substitui o anterior. */
async function finCarregaCaixas(){ S.finCaixa=await fetchCollection('caixas'); }
/* Feriados: o dia marcado vale para todas as contas e não conta nos avisos de caixa (dias sem fechar, saldo parado). */
async function finCarregaFeriados(){ try{ S.finFeriados=await fetchCollection('feriados'); }catch(e){ S.finFeriados=[]; } }
function finEhFeriado(d){ return (S.finFeriados||[]).some(function(f){ return f.data===d; }); }
async function finMarcarFeriado(d,liga){
  try{
    if(liga) await fb.setDoc(fb.doc(fb.db,'feriados',d),{id:d,data:d,por:currentUser.id,em:new Date().toISOString()});
    else{ var b=fb.writeBatch(fb.db); b.delete(fb.doc(fb.db,'feriados',d)); await b.commit(); }
    await finCarregaFeriados();
    showToast(liga?fmtDate(d)+' marcado como feriado, para todas as contas.':fmtDate(d)+' não é mais feriado.');
    navigate(currentPage==='fechamento'?'fechamento':'financeiro');
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}
/* Histórico: um registro por conta e por dia (fechar o mesmo dia de novo substitui o daquele dia). */
function finCaixasDaConta(cid){
  return (S.finCaixa||[]).filter(function(r){ return r.contaId===cid; }).sort(function(a,b){
    return String(b.data||'').localeCompare(String(a.data||'')) || String(b.em||'').localeCompare(String(a.em||''));
  });
}
function finCaixaDe(cid){ return finCaixasDaConta(cid)[0]||null; }   /* o fechamento mais recente */
/* Fechamento "a refazer": o saldo do sistema naquele dia não é mais o que foi conferido, porque depois entrou,
   mudou ou saiu um lançamento com data igual ou anterior (o saldo é acumulado). Fechar o dia de novo resolve. */
function finCaixaMudou(r){
  var c=r&&finCadById('contas',r.contaId); if(!c||finExterna(c)||r.data<finContaDataIni(c)) return false;
  return Math.abs(finSaldoConta(c,r.data)-(Number(r.saldoSistema)||0))>=0.005;
}
/* Todos os fechamentos a refazer (de uma conta ou de todas), numa passada só pelos lançamentos. */
function finCaixasARefazer(cid){
  var por={}, out=[];
  (S.finCaixa||[]).forEach(function(r){ if(!cid||r.contaId===cid) (por[r.contaId]=por[r.contaId]||[]).push(r); });
  Object.keys(por).forEach(function(id){
    var c=finCadById('contas',id); if(!c||finExterna(c)) return;
    var ini=finContaDataIni(c), regs=por[id].filter(function(r){ return r.data>=ini; }).sort(function(a,b){ return a.data<b.data?-1:(a.data>b.data?1:0); });
    if(!regs.length) return;
    var mov=regs.map(function(){ return 0; });
    (S.financeiro||[]).forEach(function(f){
      var d=f.data||''; if(f.contaId!==id||d<ini) return;
      var lo=0, hi=regs.length; while(lo<hi){ var m=(lo+hi)>>1; if(regs[m].data<d) lo=m+1; else hi=m; }   /* 1º fechamento com data >= d */
      if(lo<regs.length){ var v=Number(f.valor)||0; mov[lo]+=finEntraSaldo(f)?v:-v; }
    });
    var saldo=Number(c.saldoInicial)||0;
    regs.forEach(function(r,i){ saldo+=mov[i]; if(Math.abs(saldo-(Number(r.saldoSistema)||0))>=0.005) out.push(r); });
  });
  return out;
}
/* Quais fechamentos passam a ficar a refazer se a lista de lançamentos virar `nova` (os que já estavam não contam). */
function finFechAfetados(nova){
  var ja={}, antes=S.financeiro, res;
  finCaixasARefazer().forEach(function(r){ ja[r.id]=1; });
  S.financeiro=nova;
  try{ res=finCaixasARefazer().filter(function(r){ return !ja[r.id]; }); } finally{ S.financeiro=antes; }
  return res.sort(function(a,b){ return a.data<b.data?-1:(a.data>b.data?1:0); });
}
/* Aviso para os diálogos: "estes fechamentos vão ficar a refazer". */
function finFechAvisoHtml(afet){
  if(!afet||!afet.length) return '';
  var nomes=afet.slice(0,5).map(function(r){ return esc(finCadNome('contas',r.contaId))+' em '+fmtDate(r.data); });
  return '<span class="fin-dlg-alerta">'+(afet.length===1?'Isto muda o saldo de um dia com caixa já fechado: ':'Isto muda o saldo de '+afet.length+' dias com caixa já fechado: ')+
    nomes.join('; ')+(afet.length>5?' e mais '+(afet.length-5):'')+'. '+(afet.length===1?'O fechamento fica marcado':'Os fechamentos ficam marcados')+' como <strong>a refazer</strong> no Fechar caixa.</span>';
}

/* Quem já tinha transferência no formato antigo (uma só linha, com origem e destino) ganha as duas pontas, cada uma na sua conta. */
async function finMigraTransfAntigas(){
  var velhas=(S.financeiro||[]).filter(function(f){ return f.tipo==='transferencia' && !f.sentido; });
  if(!velhas.length) return;
  for(var i=0;i<velhas.length;i++){
    var f=velhas[i], dest=f.contaDestinoId||'', c=dest?finCadById('contas',dest):null, par=(c&&!finExterna(c))?fb.doc(fb.collection(fb.db,'lancamentos')).id:'';
    var ida=Object.assign({},f,{sentido:'saida',contraparteId:dest,contaDestinoId:'',parId:par});
    await fb.setDoc(fb.doc(fb.db,'lancamentos',f.id),Object.assign({sentido:'saida',contraparteId:dest,contaDestinoId:'',parId:par},finDerivados(ida)),{merge:true});
    if(par){
      var volta=Object.assign({},f,{id:par,sentido:'entrada',contaId:dest,contraparteId:f.contaId,contaDestinoId:'',parId:f.id,seq:finProxSeq()});
      await fb.setDoc(fb.doc(fb.db,'lancamentos',par),Object.assign({},volta,finDerivados(volta)),{merge:true});
    }
  }
  S.financeiro=await fetchCollection('lancamentos');
}
async function loadData(){
  try{ S.financeiro=await fetchCollection('lancamentos'); }catch(e){ S.financeiro=[]; }
  try{ await finCarregaCaixas(); }catch(e){ S.finCaixa=[]; }
  await finCarregaFeriados();
  try{ await ensureCadastrosFin(); await fetchCadastrosFin(); }
  catch(e){ S.finCad={empresas:[],contas:[],categorias:[]}; }
  try{ await finMigraTransfAntigas(); }catch(e){}
}

// ── UTILS ──────────────────────────────────────────────────
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}
function fmt(v){return'R$ '+Number(v||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2);}
function showToast(m){var t=document.getElementById('toast');t.textContent=m;t.classList.add('show');setTimeout(function(){t.classList.remove('show');},1400);}
function toggleTheme(){
  var dark=document.body.classList.toggle('dark');
  try{localStorage.setItem('pbl_theme',dark?'dark':'light');}catch(e){}
  var btn=document.getElementById('btn-theme');
  if(btn) btn.textContent=dark?'☀️':'🌙';
}
// Menu recolhido = faixa só com os ícones (o rótulo aparece como dica ao passar o mouse).
// Preferência por navegador.
function applyStoredTheme(){
  try{
    var t=localStorage.getItem('pbl_theme');
    if(t==='dark'){
      document.body.classList.add('dark');
      var btn=document.getElementById('btn-theme');
      if(btn) btn.textContent='☀️';
    }
  }catch(e){}
}
// Verifica se uma data (YYYY-MM-DD ou YYYY-MM) cai dentro do periodo selecionado no topo.
// Retorna array de meses (YYYY-MM) que compoem o periodo atual.
// Usado para iterar comissoes mes-a-mes em modo ano/custom.
function fmtDate(d){if(!d)return'—';var dt=new Date(d+'T00:00:00');if(isNaN(dt))return d;return dt.toLocaleDateString('pt-BR');}
/* Data de hoje no fuso do computador. toISOString é UTC: no Brasil, a partir das 21h já dava o dia seguinte. */
function todayStr(){var d=new Date();return d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2);}
async function fetchCollection(name){
  var snap=await fb.getDocs(fb.collection(fb.db,name));
  return snap.docs.map(function(d){return Object.assign({id:d.id}, d.data());});
}
/* ═══════════════════════════════════════════════════════════
   FINANCEIRO — CADASTROS BASE E LANÇAMENTOS
   Empresa, conta e categoria são cadastros. O lançamento tem tipo explícito
   (entrada, saída ou transferência) e guarda quem criou e quem alterou.
   ═══════════════════════════════════════════════════════════ */
var FIN_CADS=['empresas','contas','categorias'];
/* Cadastros iniciais — criados uma única vez, só quando a coleção está vazia.
   No sistema de verdade o admin cria/edita pela própria tela de Cadastros. */
/* Data em que o sistema novo passa a valer. O saldo de abertura de cada conta vale no início desse dia. */
var FIN_DATA_INICIAL='';   /* vazio = a conta aceita lançamentos de qualquer data; cada conta pode ter a sua data inicial */
var FIN_SEED_EMPRESAS=[
  {id:'originadora',nome:'PBL Originadora',codigo:'PBL',ativo:true},
  {id:'fidc',nome:'FIDC PBL',codigo:'FIDC',ativo:true},
  {id:'certjud',nome:'CertJud',codigo:'CERTJUD',ativo:true}
];
var FIN_SEED_CONTAS=[
  {id:'c-38219',nome:'Genial 38219-1',banco:'Genial',bancoCodigo:'125',agencia:'0001',numero:'38219-1',titular:'PBL - COMPRA DE CREDITOS JUDICIAIS LTDA',cnpj:'27.192.535/0001-68',pixTipo:'telefone',pixChave:'48991342526',empresaId:'fidc',funcao:'transito',ativo:true,obs:'',saldoInicial:0,dataInicial:FIN_DATA_INICIAL},
  {id:'c-5244902',nome:'Genial 5244902-5',banco:'Genial',bancoCodigo:'125',agencia:'0001',numero:'5244902-5',titular:'Evilyn Wagner de Souza Sociedade Individual de Advocacia',cnpj:'57.587.002/0001-46',pixTipo:'aleatoria',pixChave:'fb363b3c-5a50-4bab-abab-8b6ad51c325b',empresaId:'fidc',funcao:'transito',ativo:true,obs:'',saldoInicial:0,dataInicial:FIN_DATA_INICIAL},
  {id:'c-5253996',nome:'Genial 5253996-2',banco:'Genial',bancoCodigo:'125',agencia:'0001',numero:'5253996-2',titular:'PBL - COMPRA DE CREDITOS JUDICIAIS LTDA',cnpj:'27.192.535/0001-68',pixTipo:'email',pixChave:'piercarlo.blando@pblcompra.com',empresaId:'originadora',funcao:'operacional',ativo:true,obs:'',saldoInicial:0,dataInicial:FIN_DATA_INICIAL},
  {id:'c-13009024',nome:'Santander 13009024-1',banco:'Santander',bancoCodigo:'033',agencia:'3131',numero:'13009024-1',titular:'PBL - COMPRA DE CREDITOS JUDICIAIS LTDA',cnpj:'27.192.535/0001-68',pixTipo:'cpfcnpj',pixChave:'27192535000168',empresaId:'certjud',funcao:'operacional',ativo:true,saldoInicial:0,dataInicial:FIN_DATA_INICIAL}
];
var FIN_SEED_CATEGORIAS=[
  {id:'n-liq',nome:'Liquidação de processo',sinal:'entrada',ativo:true},
  {id:'n-cessao',nome:'Recebimento do fundo pela cessão',sinal:'entrada',ativo:true},
  {id:'n-reemb',nome:'Reembolso de custas',sinal:'entrada',ativo:true},
  {id:'n-aporte',nome:'Aporte',sinal:'entrada',ativo:true},
  {id:'n-eqv',nome:'Entrada equivocada',sinal:'entrada',ativo:true},
  {id:'n-outrasent',nome:'Outras entradas',sinal:'entrada',ativo:true},
  {id:'n-compra',nome:'Compra de processo',sinal:'saida',ativo:true},
  {id:'n-custas',nome:'Custas judiciais',sinal:'saida',ativo:true},
  {id:'n-honor',nome:'Honorários de correspondente',sinal:'saida',ativo:true},
  {id:'n-folha',nome:'Folha e encargos',sinal:'saida',ativo:true},
  {id:'n-comis',nome:'Comissões',sinal:'saida',ativo:true},
  {id:'n-fixa',nome:'Despesa fixa',sinal:'saida',ativo:true},
  {id:'n-trib',nome:'Tributos e retenções',sinal:'saida',ativo:true},
  {id:'n-retirada',nome:'Retirada de sócio',sinal:'saida',ativo:true},
  {id:'n-repasse',nome:'Repasse ao fundo',sinal:'saida',ativo:true},
  {id:'n-deveqv',nome:'Devolução de entrada equivocada',sinal:'saida',ativo:true},
  {id:'n-outrassai',nome:'Outras saídas',sinal:'saida',ativo:true}
];

function finCad(col){ return (S.finCad&&S.finCad[col])||[]; }
function finCadAtivos(col){ return finCad(col).filter(function(o){return o.ativo!==false;}); }
function finCadById(col,id){ var a=finCad(col); for(var i=0;i<a.length;i++){ if(a[i].id===id) return a[i]; } return null; }
function finCadNome(col,id){ var o=finCadById(col,id); return o?(o.nome||''):''; }

/* A primeira conta que aparece em qualquer tela (cartões, seleção padrão, formulários). */
var FIN_CONTA_PRINCIPAL='c-5253996';
async function fetchCadastrosFin(){
  S.finCad=S.finCad||{};
  for(var i=0;i<FIN_CADS.length;i++){
    var c=FIN_CADS[i];
    try{ S.finCad[c]=await fetchCollection(c); }catch(e){ S.finCad[c]=[]; }
    if(c==='contas') S.finCad[c].sort(function(a,b){ return (b.id===FIN_CONTA_PRINCIPAL)-(a.id===FIN_CONTA_PRINCIPAL); });   /* a conta principal vem sempre primeiro, em todas as telas */
  }
}
/* Só semeia no standalone. No sistema de verdade os cadastros nascem pela tela. */
async function ensureCadastrosFin(){
  if(!window.__STANDALONE__) return;
  S.finCad=S.finCad||{};
  var pares=[['empresas',FIN_SEED_EMPRESAS],['contas',FIN_SEED_CONTAS],['categorias',FIN_SEED_CATEGORIAS]];
  for(var i=0;i<pares.length;i++){
    var col=pares[i][0], seed=pares[i][1];
    var atual=[]; try{ atual=await fetchCollection(col); }catch(e){ atual=[]; }
    if(atual.length) continue;
    for(var k=0;k<seed.length;k++){
      await fb.setDoc(fb.doc(fb.db,col,seed[k].id), Object.assign({},seed[k],{createdAt:fb.serverTimestamp(),createdBy:'seed'}), {merge:true});
    }
  }
}

async function upsertCadastroFin(col,obj){
  if(FIN_CADS.indexOf(col)<0) throw new Error('Cadastro inválido.');
  var id=obj.id||fb.doc(fb.collection(fb.db,col)).id;
  var payload=Object.assign({},obj,{id:id,updatedAt:fb.serverTimestamp(),updatedBy:currentUser.id});
  if(!obj.createdAt){ payload.createdAt=fb.serverTimestamp(); payload.createdBy=currentUser.id; }
  await fb.setDoc(fb.doc(fb.db,col,id),payload,{merge:true});
  return id;
}
/* Cadastro não se exclui: inativa. O histórico continua apontando para ele. */
async function toggleCadastroFin(col,id,ativo){
  await fb.updateDoc(fb.doc(fb.db,col,id),{ativo:!!ativo,updatedAt:fb.serverTimestamp(),updatedBy:currentUser.id});
}

/* Erros por campo, indexados pelo id do elemento. */
function finValidaCampos(l){
  var e={}, c=l.contaId?finCadById('contas',l.contaId):null, dc=null;
  if(l.data==='!'){ e['fin-data']='Data não reconhecida. Digite como 28/10/2026.'; l=Object.assign({},l,{data:''}); }
  else if(!l.data) e['fin-data']='Informe a data.';
  if(isNaN(l.valor)) e['fin-valor']='Valor não reconhecido. Digite como 1.234,56.';
  else if(!(Number(l.valor)>0)) e['fin-valor']='Informe um valor maior que zero.';
  if(!l.contaId) e['fin-conta']='Selecione a conta.';
  else if(!c) e['fin-conta']='Conta não cadastrada.';
  if(l.tipo==='transferencia'){
    if(l.sentido!=='entrada' && l.sentido!=='saida') e['fin-sentido']='Escolha se a transferência foi enviada ou recebida.';
    if(l.contraparteId){
      if(l.contraparteId===l.contaId) e['fin-outra']='A outra conta deve ser diferente da conta.';
      else{ dc=finCadById('contas',l.contraparteId); if(!dc) e['fin-outra']='Conta não cadastrada.'; }
    }
  }else{
    if(['entrada','saida'].indexOf(l.tipo)<0) e['fin-tipo']='Selecione o tipo do lançamento.';
    if(!l.categoriaId) e['fin-nat']='Selecione a categoria.';
    else{
      var nat=finCadById('categorias',l.categoriaId);
      if(!nat) e['fin-nat']='Categoria não cadastrada.';
      else if(nat.sinal && nat.sinal!==l.tipo) e['fin-nat']='A categoria "'+nat.nome+'" é de '+(nat.sinal==='entrada'?'entrada':'saída')+'.';
    }
  }
  if(String(l.descricao||'').length>FIN_DESC_MAX) e['fin-desc']='Use no máximo '+FIN_DESC_MAX+' caracteres. O que passar disso pode ir na observação.';
  if(l.data){
    if(c && finExterna(c)) e['fin-conta']='A conta "'+c.nome+'" é externa e não recebe lançamentos.';
    else if(c && l.data<finContaDataIni(c)) e['fin-data']='A conta "'+c.nome+'" começa em '+fmtDate(finContaDataIni(c))+'. Escolha uma data a partir daí.';
  }
  return e;
}
/* Campos derivados gravados junto: mantêm as telas antigas lendo banco/categoria/entidade. */
function finDerivados(l){
  var cta=finCadById('contas',l.contaId)||{};
  var nat=finCadById('categorias',l.categoriaId)||{};
  var emp=finCadById('empresas',cta.empresaId)||{};
  return { banco:cta.nome||'', categoria:(l.tipo==='transferencia'?finNatNome(l):(nat.nome||'')), entidade:emp.codigo||'' };
}

/* Ordem em que os lançamentos foram feitos, mesmo dentro do mesmo segundo. */
var _finSeq=0;
function finProxSeq(){ _finSeq=Math.max(Date.now(),_finSeq+1); return _finSeq; }

async function upsertLancamento(l){
  var id = l.id || fb.doc(fb.collection(fb.db,'lancamentos')).id;
  var payload = Object.assign({}, l, {
    id:id,
    valor: Number(l.valor)||0,
    updatedAt: fb.serverTimestamp(),
    updatedBy: currentUser.id
  });
  payload=Object.assign(payload, finDerivados(l));   /* banco, categoria e entidade já gravados no lançamento */
  if(!l.createdAt){ payload.createdAt=fb.serverTimestamp(); payload.createdBy=currentUser.id; payload.seq=finProxSeq(); }
  await fb.setDoc(fb.doc(fb.db,'lancamentos',id), payload, {merge:true});
  return id;
}
/* O sistema de verdade entrega o usuário já autenticado; aqui o banco simulado entrega um administrador. */
function startAuthListener(){
  fb.onAuthStateChanged(fb.auth, async function(authUser){
    if(!authUser) return;
    try{
      var snap=await fb.getDoc(fb.doc(fb.db,'users',authUser.uid));
      if(!snap.exists() || snap.data().active!==true) return;
      currentUser=Object.assign({id:authUser.uid}, snap.data());
      var appScreen=document.getElementById('app-screen'); if(appScreen) appScreen.style.display='flex';
      await loadData();
      initApp();
    }catch(e){ showToast('Erro ao carregar o usuário: '+(e.message||e.code)); }
  });
}
if(window.fb){startAuthListener();}
else{window.addEventListener('fb-ready', startAuthListener);}

// ── INIT ───────────────────────────────────────────────────
function initApp(){
  applyStoredTheme();
  document.getElementById('hdr-user').innerHTML=currentUser.name+'<span class="admin-badge">Admin</span>';
  buildSidebar();
  navigate('financeiro');
}

// ════════════════════════════════════════════════════════════
// SIDEBAR
// ════════════════════════════════════════════════════════════
var I={
  lancamentos:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>',
  fluxo:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>',
  operacional:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>',
  precatorios:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="12" cy="12" r="3"/><line x1="6" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="18" y2="12"/></svg>',
};

function ni(page,icon,label){
  // Rótulo num span: com o menu recolhido só o ícone fica, e o title vira a dica ao passar o mouse.
  return'<button class="nav-item" id="nav-'+page+'" title="'+esc(label)+'" onclick="finIrPagina(\''+page+'\')">'+icon+'<span class="nav-lbl">'+label+'</span></button>';
}

function buildSidebar(){
  var sb=document.getElementById('sidebar');
  if(!sb) return;
  if(!isFullAccess(currentUser)){
    sb.innerHTML='<div class="sb-section">Sem acesso</div>';
    return;
  }
  sb.innerHTML=
    '<div class="sb-section">Financeiro</div>'+
    ni('financeiro',I.lancamentos,'Lançamentos')+
    ni('fechamento',I.fluxo,'Fechar caixa')+
    '<div class="sb-sub">Cadastros</div>'+
    '<div class="sb-children open">'+
      ni('cadcontas',I.precatorios,'Empresas e contas')+
      ni('cadcategorias',I.operacional,'Plano de contas')+
    '</div>';
}

function navigate(page){
  /* Financeiro e as telas de cadastro sao do admin. No sistema de verdade a regra
     tambem vive no servidor: mudar aqui nao libera para outro perfil. */
  if(!isFullAccess(currentUser)){ showToast('Acesso restrito. Contate o administrador.'); return; }
  _finCb=null; _finDp=null;   /* a tela é redesenhada: lista com busca e calendário abertos deixam de existir */
  var CAD={cadcontas:'contas',cadcategorias:'categorias'};
  if(page!=='financeiro' && page!=='fechamento' && !CAD[page]) page='financeiro';
  var outraPagina=page!==currentPage;
  currentPage=page;
  document.querySelectorAll('.nav-item').forEach(function(e){e.classList.remove('active');});
  var el=document.getElementById('nav-'+page); if(el)el.classList.add('active');
  if(CAD[page]){ _finTab='cad'; _finCadTab=CAD[page]; }
  else if(page==='fechamento'){ _finTab='fech'; }
  else { _finTab='lanc'; }
  document.getElementById('main-content').innerHTML=pageFinanceiro();
  finAjustaColunas();
  if(document.getElementById('fin-form')){ if(_finFormIni===null) _finFormIni=finFormFoto(); } else _finFormIni=null;   /* foto do formulário ao abrir */
  if(outraPagina) finMainScroll(0);   /* página nova abre no topo, não na rolagem da anterior */
}

// ════════════════════════════════════════════════════════════
function finEhTransferencia(l){ return !!(l&&l.tipo==='transferencia'); }
function finSinal(l){ if(!l) return -1; return l.tipo==='entrada'?1:(l.tipo==='transferencia'?0:-1); }
/* Uma ponta de transferência entra ou sai da conta conforme o sentido; entrada e saída, conforme o tipo. */
function finEntraSaldo(f){ return !!f && (f.tipo==='entrada' || (f.tipo==='transferencia' && f.sentido==='entrada')); }
/* "Entrada", "Saída", "Transferência enviada" ou "Transferência recebida": o mesmo nome na tela, no PDF e na planilha */
function finTipoRotulo(f){
  if(!f) return '';
  if(f.tipo==='transferencia') return f.sentido==='entrada'?'Transferência recebida':'Transferência enviada';
  return f.tipo==='entrada'?'Entrada':(f.tipo==='saida'?'Saída':'');
}
function finDifDias(a,b){ return Math.round((Date.parse(a+'T12:00:00')-Date.parse(b+'T12:00:00'))/864e5); }
/* A outra ponta da transferência existe? (ligada na hora de lançar, ou achada pela conta, pelo valor e por até 5 dias de diferença) */
function finTemPar(f){
  var lista=S.financeiro||[];
  var cents=Math.round((Number(f.valor)||0)*100), oposto=f.sentido==='entrada'?'saida':'entrada';
  /* a ponta ligada só conta se ainda bater: valor, sentido oposto e a conta certa (alterar uma ponta não altera a outra) */
  var p=f.parId?lista.find(function(x){ return x.id===f.parId; }):null;
  if(p && p.sentido===oposto && p.contaId===f.contraparteId && Math.round((Number(p.valor)||0)*100)===cents && Math.abs(finDifDias(p.data,f.data))<=5) return true;
  return lista.some(function(x){
    return x.id!==f.id && x.tipo==='transferencia' && x.sentido===oposto && x.contaId===f.contraparteId &&
      Math.round((Number(x.valor)||0)*100)===cents && Math.abs(finDifDias(x.data,f.data))<=5;
  });
}
/* A ponta ligada existe, mas não bate mais (valor ou conta alterados depois). */
/* A outra ponta gravada junto com esta transferência (ligadas pelo parId), se ainda existir. */
function finParDe(f){
  if(!f||!finEhTransferencia(f)||!f.parId) return null;
  return (S.financeiro||[]).find(function(x){ return x.id===f.parId && finEhTransferencia(x); })||null;
}
/* A outra ponta depois de alterar esta: mesma data, valor, descrição e observação; contas trocadas e sentido oposto. */
function finEspelho(l,p){
  return Object.assign({},p,{data:l.data,valor:l.valor,descricao:l.descricao,obs:l.obs,contaId:l.contraparteId,contraparteId:l.contaId,sentido:l.sentido==='saida'?'entrada':'saida',parId:l.id});
}
function finParDiverge(f){
  var p=f.parId?(S.financeiro||[]).find(function(x){ return x.id===f.parId; }):null;
  return !!(p && !finTemPar(f));
}
function finEntidade(l){
  if(l&&l.contaId){ var c=finCadById('contas',l.contaId); var e=c?finCadById('empresas',c.empresaId):null; if(e) return e.codigo||e.id; }
  return (l&&l.entidade)?l.entidade:'PBL';
}
function finTs(ts){
  if(!ts) return '';
  try{
    var d = ts.toDate?ts.toDate():(ts.seconds?new Date(ts.seconds*1000):new Date(ts));
    return d.toLocaleDateString('pt-BR')+' '+d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
  }catch(e){ return ''; }
}
function finTrilha(f){
  var p=[];
  if(f.createdBy) p.push('criado por '+f.createdBy+(finTs(f.createdAt)?' em '+finTs(f.createdAt):''));
  if(f.updatedBy) p.push('alterado por '+f.updatedBy+(finTs(f.updatedAt)?' em '+finTs(f.updatedAt):''));
  return p.join(' · ');
}
/* Saldo por conta: a transferência move entre duas contas sem virar receita nem despesa. */
/* ── Datas, conta externa e mês fechado ───────────────────── */
function finExterna(c){ return !!(c&&c.funcao==='externa'); }
function finContaDataIni(c){ return (c&&c.dataInicial)||FIN_DATA_INICIAL; }
function finMesDe(d){ return String(d||'').slice(0,7); }
function finUltimoDia(mes){ var p=String(mes).split('-'); var n=new Date(Number(p[0]),Number(p[1]),0).getDate(); return mes+'-'+('0'+n).slice(-2); }
function finDiaAnterior(d){ var x=new Date(d+'T12:00:00'); x.setDate(x.getDate()-1); return x.getFullYear()+'-'+('0'+(x.getMonth()+1)).slice(-2)+'-'+('0'+x.getDate()).slice(-2); }
function finFmtSinal(v){ return (v>0?'+ ':(v<0?'− ':''))+fmt(Math.abs(v)); }
/* Valor em reais digitado à brasileira. Devolve NaN quando não dá para ler com certeza:
   um campo de dinheiro recusa o ambíguo em vez de adivinhar (31.000 é trinta e um mil, não 31). */
function finParseVal(s){
  s=String(s==null?'':s).replace(/[R$\s]/g,'');
  var neg=false; if(s.charAt(0)==='-'){ neg=true; s=s.slice(1); }
  if(!s) return 0;
  var n;
  if(s.indexOf(',')>=0){
    if(!/^(\d{1,3}(\.\d{3})+|\d+),\d{1,2}$/.test(s)) return NaN;
    n=parseFloat(s.replace(/\./g,'').replace(',','.'));
  }else if(/^\d+$/.test(s)){ n=parseFloat(s);
  }else if(/^\d{1,3}(\.\d{3})+$/.test(s)){ n=parseFloat(s.replace(/\./g,''));
  }else if(/^\d+\.\d{1,2}$/.test(s)){ n=parseFloat(s);
  }else return NaN;
  return neg?-n:n;
}
/* Empresas que o lançamento toca: a da conta e, se for transferência, a da conta de destino (se interna). */
function finEmpresasDoLanc(l){
  var ids=[], c=l.contaId?finCadById('contas',l.contaId):null;
  if(c&&c.empresaId) ids.push(c.empresaId);
  if(!ids.length){
    finCad('empresas').forEach(function(e){ if((e.codigo||e.id)===finEntidade(l)) ids.push(e.id); });
  }
  return ids;
}
/* Movimento de uma conta entre duas datas (inclusive). Nada antes da data inicial da conta conta. */
function finMovConta(c,de,ate){
  var m={ent:0,sai:0,trIn:0,trOut:0}, ini=finContaDataIni(c);
  (S.financeiro||[]).forEach(function(f){
    var d=f.data||'';
    if(d<ini) return; if(de&&d<de) return; if(ate&&d>ate) return;
    var v=Number(f.valor)||0;
    if(f.contaId!==c.id) return;
    if(finEhTransferencia(f)){ if(f.sentido==='entrada') m.trIn+=v; else m.trOut+=v; return; }
    if(finSinal(f)>0) m.ent+=v; else m.sai+=v;
  });
  return m;
}
/* Saldo no fim do dia `ate`. O saldo de abertura vale no início do dia da data inicial. */
function finNatNome(f){
  if(finEhTransferencia(f)) return f.sentido==='entrada'?'Transferência recebida':(f.sentido==='saida'?'Transferência enviada':'Transferência');
  return (f.categoriaId&&finCadNome('categorias',f.categoriaId))||f.categoria||'';
}
/* Formata o valor ao sair do campo; durante a digitação o texto nunca é reescrito. */
/* Campo de valor: só dígitos, vírgula e ponto (e o sinal de menos nos saldos). Letras e símbolos nem entram, nem colados. */
function finSoNumeros(s,neg){
  var r=String(s==null?'':s).replace(neg?/[^\d.,\-]/g:/[^\d.,]/g,'');
  if(neg) r=r.charAt(0)+r.slice(1).replace(/-/g,'');
  return r;
}
function finValorEntrada(e,neg){
  var v=e.value, r=finSoNumeros(v,neg); if(r===v) return;
  var p=e.selectionStart; e.value=r;
  try{ var q=Math.max(0,(p==null?r.length:p)-(v.length-r.length)); e.setSelectionRange(q,q); }catch(x){}
}
/* A descrição é curta (aparece numa linha só na lista); o que for mais longo vai na observação. */
var FIN_DESC_MAX=60;
function finDescEntrada(e){   /* o contador só aparece perto do limite */
  var c=document.getElementById('cont-fin-desc'), n=String(e.value||'').length;
  if(c){ c.textContent=n+'/'+FIN_DESC_MAX; c.style.display=n>=FIN_DESC_AVISO?'':'none'; }
}
function finValorBlur(id){
  var e=document.getElementById(id); if(!e) return;
  var v=finParseVal(e.value);
  if(String(e.value).trim()===''||isNaN(v)) return;
  e.value=v.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
}

/* O select escondido por trás da lista com busca (o campo visível é o "cbc-"). */
function finEhCb(e){ return !!(e && ((e.classList&&e.classList.contains&&e.classList.contains('fin-cb-sel')) || /\bfin-cb-sel\b/.test(e.className||''))); }
/* ── erros ao lado do campo ── */
function finErroEm(id,msg){
  var d=document.getElementById('err-'+id);
  if(d){ d.textContent=msg?'⚠ '+msg:''; d.style.display=msg?'block':'none'; }
  var e=document.getElementById(id);
  /* só campos de verdade ficam marcados; a mensagem-resumo usa o id do botão e não pode pintá-lo */
  if(e&&e.tagName!=='BUTTON'){
    if(e.classList){ if(msg) e.classList.add('fin-invalid'); else e.classList.remove('fin-invalid'); }
    if(e.setAttribute) e.setAttribute('aria-invalid',msg?'true':'false');
  }
  var cb=finEhCb(e)?document.getElementById('cbc-'+id):document.getElementById('dpc-'+id);   /* lista com busca ou calendário: o campo visível é que fica marcado */
  if(cb){ if(cb.classList){ if(msg) cb.classList.add('fin-invalid'); else cb.classList.remove('fin-invalid'); } if(cb.setAttribute) cb.setAttribute('aria-invalid',msg?'true':'false'); }
  if(msg) _finErros[id]=msg; else delete _finErros[id];
}
/* Mostra o conjunto de erros e leva o foco ao primeiro. O que a pessoa digitou fica como está. */
function finErros(mapa){
  Object.keys(_finErros).forEach(function(k){ if(!(k in mapa)) finErroEm(k,''); });
  var ids=Object.keys(mapa);
  ids.forEach(function(k){ finErroEm(k,mapa[k]); });
  if(ids.length){ var e=document.getElementById(ids[0]); if(finEhCb(e)) e=document.getElementById('cbc-'+ids[0])||e; else if(document.getElementById('dpt-'+ids[0])) e=document.getElementById('dpt-'+ids[0]); if(e&&e.focus) e.focus(); }
}
/* Corrigiu o campo: o erro some na hora. */
function finAoEditar(ev){
  var t=ev&&ev.target;
  if(t&&t.id&&_finErros[t.id]) finErroEm(t.id,'');
}

/* ── diálogo próprio (no lugar de confirm/prompt do navegador) ── */
function finDialogoHtml(o){
  var motivo=o.motivo
    ? '<div class="fg"><label for="fin-dlg-motivo">'+esc(o.motivo.rotulo||'Motivo')+(o.motivo.obrigatorio?' *':'')+'</label>'+
      '<input type="text" id="fin-dlg-motivo" autocomplete="off"/><div class="fin-err" id="err-fin-dlg-motivo" role="alert"></div></div>'
    : '';
  return '<div class="fin-ov" onclick="if(event.target===this)finDlgCancelar()"><div class="fin-dlg" role="alertdialog" aria-modal="true" aria-labelledby="fin-dlg-t" aria-describedby="fin-dlg-d">'+
    '<h3 id="fin-dlg-t">'+esc(o.titulo)+'</h3><p id="fin-dlg-d">'+o.texto+'</p>'+motivo+
    '<div class="acoes">'+(o.semCancelar?'':'<button class="btn" id="fin-dlg-cancelar" onclick="finDlgCancelar()" style="background:#eee;color:var(--mt)">Cancelar</button>')+
    '<button class="btn '+(o.perigo?'danger':'bp')+'" id="fin-dlg-ok" onclick="finDlgOk()">'+esc(o.rotuloOk||'Confirmar')+'</button></div></div></div>';
}
function finDialogo(o){
  _finDlg=o;
  var root=document.getElementById('modal-root'); if(!root) return;
  root.innerHTML=finDialogoHtml(o);
  setTimeout(function(){
    var f=document.getElementById(o.motivo?'fin-dlg-motivo':(o.perigo?'fin-dlg-cancelar':'fin-dlg-ok'));
    if(f&&f.focus) f.focus();
  },0);
}
/* Cancelar fecha o diálogo e, se ele tinha um lugar para voltar (ex.: o histórico), volta para lá. */
function finDlgCancelar(){ var o=_finDlg; finDlgFecha(); if(o&&o.onCancel) o.onCancel(); }

function finDlgFecha(){
  _finDlg=null;
  var root=document.getElementById('modal-root'); if(root) root.innerHTML='';
}
function finDlgOk(){
  var o=_finDlg; if(!o) return;
  var motivo='';
  if(o.motivo){
    var e=document.getElementById('fin-dlg-motivo');
    motivo=e?String(e.value||'').trim():'';
    if(o.motivo.obrigatorio && !motivo){ finErroEm('fin-dlg-motivo','Informe o motivo.'); return; }
  }
  finDlgFecha();
  return o.onOk(motivo);
}

/* ── teclado: Enter salva e abre um novo lançamento, Esc cancela ── */
function finTeclado(e){
  var k=e&&e.key, t=(e&&e.target)||{};
  var mx=document.getElementById('fin-exp'); if(k==='Escape' && mx && mx.open && !_finDlg){ mx.open=false; return; }
  if(t.id && String(t.id).indexOf('cbb-')===0) return;   /* a caixa de busca da lista cuida das próprias teclas */
  if(_finDlg){
    if(k==='Escape') finDlgCancelar();
    else if(k==='Enter' && t.id==='fin-dlg-motivo'){ if(e.preventDefault) e.preventDefault(); finDlgOk(); }
    return;
  }
  if(k==='Enter' && t.id && t.id.indexOf('fcx-banco-')===0){ if(e.preventDefault) e.preventDefault(); finFecharCaixa(t.id.slice(10)); return; }
  if(k==='Enter' && t.id && t.id.indexOf('fcx-obs-')===0){ if(e.preventDefault) e.preventDefault(); finFecharCaixa(t.id.slice(8)); return; }
  if(!(_finNovo||_finEdit)){
    /* na aba Lançamentos, E, S e T abrem entrada, saída e transferência (fora de qualquer campo) */
    if(currentPage==='financeiro' && !e.ctrlKey && !e.metaKey && !e.altKey && /^[est]$/i.test(k||'')){
      var tg=String(t.tagName||'').toUpperCase();
      if(tg!=='INPUT' && tg!=='SELECT' && tg!=='TEXTAREA' && !t.isContentEditable){
        if(e.preventDefault) e.preventDefault();
        finNovo({e:'entrada',s:'saida',t:'transferencia'}[k.toLowerCase()]);
      }
    }
    return;
  }
  if(k==='Escape'){ finPedeCancelar(); return; }
  /* Enter salva de qualquer campo do formulário: de texto ou de lista (Categoria, Conta, que são caixas desenhadas pelo sistema) */
  if(k==='Enter' && ((t.tagName==='INPUT' && t.type!=='checkbox') || (t.getAttribute && t.getAttribute('role')==='combobox'))){
    var f=document.getElementById('fin-form');
    if(f && f.contains && f.contains(t)){ if(e.preventDefault) e.preventDefault(); addFin(!_finEdit); }
  }
}
document.addEventListener('input',finAoEditar);
document.addEventListener('change',finAoEditar);
document.addEventListener('keydown',finTeclado);
document.addEventListener('mousedown',function(e){ if(_finCb){ var w=document.getElementById('cb-'+_finCb.id); if(w&&w.contains&&!w.contains(e.target)) finCbFecha(false); } });   /* clicar fora fecha a lista com busca */
document.addEventListener('click',function(e){ var d=document.getElementById('fin-exp'); if(d&&d.open&&d.contains&&!d.contains(e.target)) d.open=false; });   /* clicar fora fecha o menu Exportar */

function finSaldoConta(c,ate){
  if(finExterna(c)) return 0;
  var m=finMovConta(c,'',ate);
  return (Number(c.saldoInicial)||0)+m.ent-m.sai+m.trIn-m.trOut;
}
/* ═══ LANÇAMENTOS: extrato por conta e período ═══ */
var MESES_PT=['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
function finMesLabel(mes){ var p=String(mes).split('-'); return MESES_PT[Number(p[1])-1]+' de '+p[0]; }
function finMesSoma(mes,d){ var p=String(mes).split('-'); var x=new Date(Number(p[0]),Number(p[1])-1+d,1); return x.getFullYear()+'-'+('0'+(x.getMonth()+1)).slice(-2); }
var DIAS_PT=['Domingo','Segunda-feira','Terça-feira','Quarta-feira','Quinta-feira','Sexta-feira','Sábado'];
function finDiaMais(iso,n){ var x=new Date(iso+'T12:00:00'); x.setDate(x.getDate()+n); return x.getFullYear()+'-'+('0'+(x.getMonth()+1)).slice(-2)+'-'+('0'+x.getDate()).slice(-2); }
function finDiaSemana(iso){ return DIAS_PT[new Date(iso+'T12:00:00').getDay()]; }
/* O primeiro dia em que alguma conta existe no sistema. */
function finInicioSistema(){
  var ds=finCad('contas').filter(function(c){ return !finExterna(c); }).map(finContaDataIni).sort();
  return ds[0]||FIN_DATA_INICIAL;
}

function finPeriodoRange(){
  var p=_finPer;
  if(p.mode==='tudo') return {de:'',ate:''};   /* todos os lançamentos, do primeiro ao último */
  if(p.mode==='livre') return {de:p.di||'',ate:p.df||''};
  if(p.mode==='7d') return {de:finDiaMais(p.fim,-6),ate:p.fim};
  if(p.mode==='mes') return {de:p.mes+'-01',ate:finUltimoDia(p.mes)};
  return {de:p.dia,ate:p.dia};
}
function finPerCobre(d){ var r=finPeriodoRange(); return (!r.de||d>=r.de)&&(!r.ate||d<=r.ate); }
/* Depois de lançar, a tela vai para onde o lançamento está, mantendo o tipo de período. */
function finPerVaiPara(d){
  var p=_finPer; if(p.mode==='tudo') return;   /* em Tudo, qualquer lançamento já aparece */
  if(p.mode==='dia'){ p.dia=d; p.fim=d; p.mes=finMesDe(d); }
  else if(p.mode==='7d'){ p.fim=d; p.dia=d; p.mes=finMesDe(d); }
  else{ p.mode='mes'; p.mes=finMesDe(d); p.dia=d; p.fim=d; }
}
function finPerAtalho(k){
  _finRecente=null;
  var hoje=todayStr(), ontem=finDiaMais(hoje,-1), r=finPeriodoRange(), p=_finPer;
  if(k==='hoje') _finPer={mode:'dia',dia:hoje,fim:hoje,mes:finMesDe(hoje),di:'',df:''};
  else if(k==='ontem') _finPer={mode:'dia',dia:ontem,fim:ontem,mes:finMesDe(ontem),di:'',df:''};
  else if(k==='7d') _finPer={mode:'7d',dia:hoje,fim:hoje,mes:finMesDe(hoje),di:'',df:''};
  else if(k==='mes') _finPer={mode:'mes',dia:p.dia,fim:p.fim,mes:finMesDe(r.ate||hoje),di:'',df:''};
  else if(k==='tudo') _finPer={mode:'tudo',dia:p.dia,fim:p.fim,mes:p.mes,di:'',df:''};
  else _finPer={mode:'livre',dia:p.dia,fim:p.fim,mes:p.mes,di:(r.de&&r.de<hoje?r.de:hoje),df:(r.ate&&r.ate<hoje?r.ate:hoje)};   /* o intervalo nunca começa nem termina depois de hoje */
  navigate('financeiro');
}
/* As setas andam na unidade da tela (um dia, sete dias ou um mês) e nunca passam de hoje. */
function finPerNav(d){
  _finRecente=null;
  var p=_finPer, hoje=todayStr(), ini=finInicioSistema();
  if(p.mode==='dia'){ var n=finDiaMais(p.dia,d); if(d>0&&n>hoje) return; if(d<0&&n<ini) return; p.dia=n; p.fim=n; p.mes=finMesDe(n); }
  else if(p.mode==='7d'){
    var f=finDiaMais(p.fim,7*d);
    if(d>0&&f>hoje) f=hoje;
    if(d<0&&finDiaMais(f,-6)<ini){ f=finDiaMais(ini,6); if(f>=p.fim) return; }   /* nunca anda para a frente ao voltar */
    if(f===p.fim) return;
    p.fim=f; p.dia=f; p.mes=finMesDe(f);
  }
  else if(p.mode==='mes'){ var m=finMesSoma(p.mes,d); if(d>0&&m>hoje.slice(0,7)) return; if(d<0&&m<ini.slice(0,7)) return; p.mes=m; }
  navigate('financeiro');
}
function finPerDia(){ var e=document.getElementById('fin-pdia'); if(e&&e.value){ _finPer.dia=e.value; _finPer.fim=e.value; _finPer.mes=finMesDe(e.value); _finRecente=null; navigate('financeiro'); } }
function finPerFim(){ var e=document.getElementById('fin-pfim'); if(e&&e.value){ _finPer.fim=e.value; _finPer.dia=e.value; _finPer.mes=finMesDe(e.value); _finRecente=null; navigate('financeiro'); } }
function finPerMes(){ var e=document.getElementById('fin-mes'); if(e&&e.value){ _finPer.mes=e.value; _finRecente=null; navigate('financeiro'); } }
function finPerLivre(){
  function v(id){ var e=document.getElementById(id); return e?e.value:''; }
  _finPer.mode='livre'; _finPer.di=v('fin-pdi'); _finPer.df=v('fin-pdf'); navigate('financeiro');
}
/* Contas que a tela mostra: uma só, ou todas as internas da empresa selecionada. */
/* Contas que a tela oferece: as da empresa escolhida no cabeçalho (ou todas), as ativas primeiro. */
function finContasVisiveis(){
  return finCad('contas').filter(function(c){ return !finExterna(c) && (!_finEmp||c.empresaId===_finEmp); })
    .sort(function(a,b){ return (a.ativo===false?1:0)-(b.ativo===false?1:0); });
}
/* Contas em uso: as marcadas que estão à vista; se nenhuma estiver, a primeira. Nunca fica vazio. */
function finContasEscopo(){
  var vis=finContasVisiveis(), sel=vis.filter(function(c){ return _finContasSel.indexOf(c.id)>=0; });
  return sel.length?sel:vis.slice(0,1);
}
function finSalvaContasSel(ids){ _finContasSel=ids; try{ sessionStorage.setItem('fin_contas',JSON.stringify(ids)); }catch(e){} }
/* Abertura, movimento e saldo final de uma conta num período qualquer. */
function finCalcPeriodo(c,de,ate){
  var ini=finContaDataIni(c);
  if(ate && ate<ini) return {aplica:false,abertura:0,ent:0,sai:0,trIn:0,trOut:0,final:0};
  var abertura=(!de||de<=ini)?(Number(c.saldoInicial)||0):finSaldoConta(c,finDiaAnterior(de));
  var m=finMovConta(c,(de&&de>ini)?de:ini,ate||'');
  return {aplica:true,abertura:abertura,ent:m.ent,sai:m.sai,trIn:m.trIn,trOut:m.trOut,final:abertura+m.ent-m.sai+m.trIn-m.trOut};
}
/* Todas as linhas do período na visão atual, em ordem de extrato, com saldo corrido quando há uma conta só.
   Nada aqui depende de busca ou filtro: o saldo precisa ser o mesmo do banco. */
/* Linhas de extrato (com saldo depois de cada uma) das contas dadas, de uma data a outra. */
function finLinhasDe(contas,de,ate){
  var ids={}, linhas=[], s=0;
  contas.forEach(function(c){ ids[c.id]=true; var k=finCalcPeriodo(c,de,ate); if(k.aplica) s+=k.abertura; });
  (S.financeiro||[]).forEach(function(f){
    var d=f.data||'';
    if(de&&d<de) return; if(ate&&d>ate) return;
    var v=Number(f.valor)||0;
    if(!ids[f.contaId]) return;
    var L={f:f,ent:0,sai:0};
    if(finEntraSaldo(f)) L.ent=v; else L.sai=v;
    linhas.push(L);
  });
  function ts(f){ return f.seq||((f.createdAt&&f.createdAt.seconds)||0)*1000; }
  linhas.sort(function(a,b){
    var d=(a.f.data||'').localeCompare(b.f.data||''); if(d!==0) return d;
    return (ts(a.f)-ts(b.f)) || String(a.f.id).localeCompare(String(b.f.id));
  });
  linhas.forEach(function(L){ s=Math.round((s+L.ent-L.sai)*100)/100; L.saldo=s; });
  return linhas;
}
function finLinhasEscopo(){ var rng=finPeriodoRange(); return finLinhasDe(finContasEscopo(),rng.de,rng.ate); }
/* Saldo inicial, movimento e saldo final do período, somando as contas marcadas. */
function finTotaisPeriodo(){
  var rng=finPeriodoRange(), t={ab:0,ent:0,sai:0,tr:0,fin:0,aplica:false,trIn:0,trOut:0};
  finContasEscopo().forEach(function(c){
    var k=finCalcPeriodo(c,rng.de,rng.ate); if(!k.aplica) return;
    t.aplica=true; t.ab+=k.abertura; t.ent+=k.ent; t.sai+=k.sai; t.tr+=k.trIn-k.trOut; t.fin+=k.final; t.trIn+=k.trIn; t.trOut+=k.trOut;
  });
  return t;
}
function finLinhaPassa(L){
  var f=L.f;
  if(_finF.tipo && _finF.tipo!=='todos' && f.tipo!==_finF.tipo) return false;
  if(_finF.categoriaId && f.categoriaId!==_finF.categoriaId) return false;
  if(_finF.q){
    var q=_finF.q.toLowerCase().trim();
    /* a busca olha o que a pessoa vê: descrição, observação, contas, categoria e o valor (1800 ou 1.800,00) */
    var v=Number(f.valor)||0;
    var alvo=[f.descricao,f.obs,
      finCadNome('contas',f.contaId),finCadNome('contas',f.contraparteId),finNatNome(f),
      String(v).replace('.',','), v.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})].join(' ').toLowerCase();
    if(alvo.indexOf(q)<0) return false;
  }
  return true;
}
/* ── navegação da tela ── */
/* Marca ou desmarca uma conta. Sempre fica ao menos uma. */
function finSetConta(id){
  _finRecente=null; _finEdit=null;
  var atual=finContasEscopo().map(function(c){ return c.id; }), i=atual.indexOf(id);
  if(i>=0){ if(atual.length>1) atual.splice(i,1); } else atual.push(id);
  finSalvaContasSel(atual); navigate('financeiro');
}
/* Clique no menu: página nova começa limpa e no topo. */
function finIrPagina(p){
  if(p!==currentPage){ _finNovo=null; _finEdit=null; _finRecente=null; _finCadAberto=false; _finEmpNova=false; _finCadEdit={}; }
  navigate(p);
}

function finNovo(tipo,duplicando){
  if(!duplicando) _finClone=null;
  if(!_finNovo&&!_finEdit){ _finUltimo=null; _finScroll=finMainScroll(); }
  _finNovo=tipo; _finEdit=null; navigate('financeiro');
  setTimeout(function(){
    finMainScroll(0);
    var e=document.getElementById('fin-valor'); if(e&&e.focus) e.focus();
  },0);
}
/* O que estava no formulário quando ele abriu: para saber se algo foi digitado antes de descartar. */
/* Data fora do comum (no futuro ou com mais de um ano): avisa embaixo do campo, sem impedir. Não avisa na data original de um lançamento alterado. */
function finDataAviso(){
  var i=document.getElementById('fin-data'), a=document.getElementById('avi-fin-data'); if(!i||!a) return;
  var v=i.value, hoje=todayStr(), ed=_finEdit?(S.financeiro||[]).find(function(f){ return f.id===_finEdit; }):null, txt='';
  if(v && !(ed&&ed.data===v)){
    var fc=finDataForaDoComum(v);
    if(fc) txt=(fc==='futuro'?'Data no futuro: ':'Data anterior a hoje: ')+fmtDate(v)+' ('+finDataDistancia(v)+').'+(finDataLonge(v)?' Confira o ano.':'');
  }
  a.textContent=txt; a.style.display=txt?'block':'none';   /* "block" vence o estilo que esconde o aviso */
}
var _finFormIni=null;
function finFormFoto(){ try{ var l=finLerForm(); return JSON.stringify([l.valor,l.descricao,l.categoriaId,l.contaId,l.contraparteId,l.data,l.obs,l.sentido]); }catch(e){ return null; } }
function finPedeCancelar(){
  if(_finDlg) return;
  var agora=finFormFoto();
  if(_finFormIni===null || agora===null || agora===_finFormIni){ finCancelarEdicao(); return; }
  finDialogo({titulo:'Descartar o que foi digitado?',texto:'O que você preencheu neste '+(_finEdit?'lançamento':'formulário')+' ainda não foi salvo.',rotuloOk:'Descartar',perigo:true,onOk:function(){ finCancelarEdicao(); }});
}
function finCancelarEdicao(){ _finEdit=null; _finNovo=null; _finClone=null; _finTroca=null; _finFormIni=null; _finDataConfirmada=null; _finUltimo=null; navigate('financeiro'); finVoltaDoFormulario(false); }
/* A rolagem da tela é a da área central (.main), não a da janela. */
function finMainScroll(y){
  var m=document.querySelector?document.querySelector('.main'):null; if(!m) return 0;
  if(y===undefined) return m.scrollTop||0;
  m.scrollTop=y; try{ window.scrollTo(0,y); }catch(e){}
  return y;
}
/* Ao fechar o formulário, a lista volta onde estava; depois de salvar, vai até a linha que acabou de entrar. */
function finVoltaDoFormulario(destacar){
  var y=_finScroll; _finScroll=null;
  setTimeout(function(){
    if(!document.querySelector) return;
    var r=destacar?document.querySelector('#fin-lista tbody tr[style*="--novo"]'):null;
    if(r&&r.scrollIntoView) r.scrollIntoView({block:'center'}); else finMainScroll(y||0);
  },0);
}
function finSetEmp(id){
  _finEmp=id; _finEdit=null; _finNovo=null;
  try{ sessionStorage.setItem('fin_emp',id); }catch(e){}
  navigate(currentPage);
}
/* Abre os lançamentos da conta no dia do fechamento. Sem data, usa a que está no campo da linha. */
function finVerLancDia(cid,dia){
  if(!dia){ var e=document.getElementById('fcx-data'); dia=(e&&e.value)||finCaixaDataDia(); }
  _finPer={mode:'dia',dia:dia,fim:dia,mes:finMesDe(dia),di:'',df:''};
  _finF={tipo:'todos',categoriaId:'',q:''}; finSalvaContasSel([cid]);
  var c=finCadById('contas',cid); if(c&&_finEmp&&c.empresaId!==_finEmp) _finEmp=c.empresaId;
  _finEdit=null; _finNovo=null;
  navigate('financeiro'); window.scrollTo(0,0);
}
/* ═══════════════════════════════════════════════════════════
   FINANCEIRO — tela (lançamentos + cadastros)
   ═══════════════════════════════════════════════════════════ */
var FIN_TITULO={fech:'Fechar caixa',lanc:'Lançamentos',contas:'Empresas e contas',categorias:'Plano de contas'};
var _finTab='lanc';
var _finEmp=(function(){ try{ return sessionStorage.getItem('fin_emp')||''; }catch(e){ return ''; } })();
var _fechData='';      /* dia aberto na tela; vazio = hoje */
var _fechConta='';     /* conta aberta na tela; vazio = a primeira */
var _fechMes='';       /* mês do histórico; vazio = o mês do dia em conferência */
var _fechBanco={};     /* saldo do banco digitado, por conta e dia */
var _fechObs={};       /* observação digitada, por conta e dia */
var _finCadTab='contas';
var _finEdit=null;
var _finCadEdit={};
var _finCadAberto=false;   /* formulário de cadastro novo aberto */
var _finCadEmpPre='';      /* empresa já escolhida ao criar conta a partir do grupo dela */
var _finEmpNova=false;     /* formulário de empresa nova aberto (dentro de Contas bancárias) */
var _finF={tipo:'todos',categoriaId:'',q:''};
/* Contas marcadas para ver juntas. Fica guardado na sessão; sempre há pelo menos uma em uso. */
var _finContasSel=(function(){ try{ return JSON.parse(sessionStorage.getItem('fin_contas')||'[]'); }catch(e){ return []; } })();
var _finErros={};       /* mensagens de erro por campo (id do elemento) */
var _finDlg=null;        /* diálogo aberto no momento */
var _finRecente=null;    /* lançamento recém-salvo, destacado na lista */
var _finNovo=null;      /* 'entrada' | 'saida' | 'transferencia' quando o formulário está aberto */
var _finUltimo=null;    /* data e conta do último lançamento, para lançar vários seguidos */
var _finScroll=null;    /* onde a lista estava rolada ao abrir o formulário, para voltar ao mesmo ponto */
/* modos: dia | 7d | mes | livre. Começa em hoje. */
var _finPer={mode:'dia',dia:todayStr(),fim:todayStr(),mes:todayStr().slice(0,7),di:'',df:''};

/* ═══ FECHAMENTO DO MÊS ═══ saldo do sistema x saldo do extrato, por conta ═══ */
/* ═══ FECHAMENTO ═══ fechar o caixa de cada conta (dia a dia) e ver o mês ═══ */
function finContasFechar(){ return finCad('contas').filter(function(c){ return !finExterna(c) && c.ativo!==false && (!_finEmp||c.empresaId===_finEmp); }); }
/* O que a linha de uma conta mostra: data, saldo pelos lançamentos até ela, saldo digitado do banco e a diferença. */
/* ─── Fechar caixa: contas no topo, um dia por vez, conferência, diferença, causas, lançamentos do dia e histórico ─── */
function finCaixaChave(cid,data){ return cid+'_'+data; }
function finCaixaDoDia(cid,data){ return (S.finCaixa||[]).find(function(r){ return r.contaId===cid && r.data===data; })||null; }
function finFechContaSel(){ var cs=finContasFechar(); return cs.filter(function(c){ return c.id===_fechConta; })[0]||cs[0]||null; }
function finNumBR(v){ return fmt(v).replace(/^R\$\s*/,''); }
/* O dia em conferência: o dia escolhido numa linha da tabela, ou o último dia do período (até hoje). */
/* Abre um dia do período para conferir, sem sair do período: a tabela continua a mesma. */
/* Quantos lançamentos de cada tipo a conta teve no dia. */
/* O que a tela mostra de uma conta no dia aberto: caminho do saldo no sistema, saldo digitado do banco e a diferença. */
/* Dias sem fechamento da conta nos últimos 30 dias: dias úteis e dias com lançamento, a partir do primeiro lançamento dela. */
/* Procura o que pode explicar a diferença: um lançamento com exatamente esse valor, no dia ou nos 7 dias anteriores. */
function finCaixaDifHtml(k){
  if(k.banco!==null && isNaN(k.banco)) return '<span style="color:var(--red);font-weight:700">⚠ valor inválido</span>';
  if(k.dif===null) return '<span style="color:var(--mt)">—</span>';
  if(Math.abs(k.dif)<0.005) return '<span style="color:var(--green);font-weight:700">confere</span>';
  return '<span style="color:var(--red);font-weight:700" title="banco − sistema">'+finFmtSinal(k.dif)+'</span>';
}
/* Bate: "Fechar caixa". Não bate: "Fechar com ressalva". Sem saldo do banco, o botão espera. */
function finCaixaBotaoHtml(cid,k){
  var ress=(k.dif!==null && Math.abs(k.dif)>=0.005), espera=(!k.aplica || k.dif===null);
  return '<button class="btn '+(ress?'ress':'bp')+'" id="fcx-btn-'+cid+'" onclick="finFecharCaixa(\''+cid+'\')"'+(espera?' disabled':'')+'>'+(ress?'Fechar com ressalva':'Fechar caixa')+'</button>';
}
/* Saldo do sistema, diferença e botão acompanham a data e o saldo do banco enquanto se digita. */
/* Um cartão por conta, como o caixa de um supermercado: o que o sistema diz, o que o banco diz, e fechar. */
/* Meses mostrados no quadro do fim de mês: do atual para trás, até 12, a partir do primeiro movimento. */
/* O dia que vale como "último dia" do mês: o último dia do calendário; se cair no fim de semana e só a sexta estiver fechada, a sexta. */
/* Quadro de leitura rápida: o saldo fechado no último dia de cada mês, uma coluna por conta. */
/* Um dia de cada vez no período: fechado, com ressalva ou em aberto, com a diferença e a observação. */
function finCaixaConta(cid){ _fechConta=cid; navigate('fechamento'); }
function finCaixaObs(cid,v){ _fechObs[finCaixaChave(cid,finCaixaDataDia())]=v; }
/* Atalho a partir de Lançamentos: abre o Fechar caixa de hoje nesta conta, com o cursor no saldo do banco. */
/* Diferença, dica, causas e botão acompanham o saldo do banco enquanto se digita. */
async function finFecharCaixa(cid){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode realizar esta ação.'); return; }
  var c=finCadById('contas',cid); if(!c) return;
  var bEl=document.getElementById('fcx-banco-'+cid), oEl=document.getElementById('fcx-obs-'+cid), hoje=todayStr(), data=finCaixaDataDia(), key=finCaixaChave(cid,data);
  var raw=bEl?String(bEl.value||''):String(_fechBanco[key]||''), obs=oEl?String(oEl.value||'').trim():String(_fechObs[key]||'').trim();
  var erros={}, banco=NaN;
  if(!data) erros['fcx-data']='Informe a data do fechamento.';
  else if(data>hoje) erros['fcx-data']='Escolha uma data até hoje.';
  else if(data<finContaDataIni(c)) erros['fcx-data']='A conta "'+c.nome+'" começa em '+fmtDate(finContaDataIni(c))+'. Escolha uma data a partir daí.';
  if(raw.trim()==='') erros['fcx-banco-'+cid]='Digite o saldo do banco.';
  else{ banco=finParseVal(raw); if(isNaN(banco)) erros['fcx-banco-'+cid]='Valor não reconhecido. Digite como 1.234,56.'; }
  if(Object.keys(erros).length){ finErros(erros); return; }
  finErros({});
  var sistema=finSaldoConta(c,data), dif=Math.round((banco-sistema)*100)/100, ress=Math.abs(dif)>=0.005;
  try{
    var regId=key, reg={id:regId,contaId:cid,empresaId:c.empresaId,data:data,saldoBanco:banco,saldoSistema:sistema,diferenca:dif,ressalva:ress,obs:obs,por:currentUser.id,em:new Date().toISOString()};
    await fb.setDoc(fb.doc(fb.db,'caixas',regId),reg);     /* sem merge: fechar o mesmo dia de novo substitui só aquele dia */
    await finCarregaCaixas();
    delete _fechBanco[key]; delete _fechObs[key]; delete _fechCorrigir[key];
    showToast((ress?'Caixa fechado com ressalva':'Caixa fechado')+': '+c.nome+', '+fmtDate(data)+'.'+(ress?' Reveja no próximo fechamento.':''));
    /* fechou: volta ao início da aba (hoje, no topo), sem campos para fechar de novo */
    _fechData=''; _fechMes='';
    navigate('fechamento'); finMainScroll(0);
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}
/* Atalho a partir de Lançamentos: abre o Fechar caixa de hoje nesta conta, com o cursor no saldo do banco. */
/* ─── Fechar caixa: duas partes. Em cima, conferir o saldo do banco com o do sistema e fechar o dia; embaixo, o histórico dos dias do mês. ─── */
function finCaixaDataDia(){ return _fechData||todayStr(); }
function finCaixaMesSel(){ return _fechMes||finMesDe(finCaixaDataDia()); }
/* O que a tela mostra de uma conta no dia aberto: saldo no sistema, saldo digitado do banco e a diferença. */
function finCaixaCalc(cid){
  var c=finCadById('contas',cid), data=finCaixaDataDia(), key=finCaixaChave(cid,data), reg=finCaixaDoDia(cid,data);
  var raw=_fechBanco[key]; if(raw===undefined && reg) raw=finNumBR(reg.saldoBanco);
  var aplica=!!c && data>=finContaDataIni(c), sistema=aplica?finSaldoConta(c,data):null;
  var banco=(raw===undefined||String(raw).trim()==='')?null:finParseVal(raw);
  var dif=(aplica && banco!==null && !isNaN(banco))?Math.round((banco-sistema)*100)/100:null;
  return {data:data,aplica:aplica,sistema:sistema,banco:banco,dif:dif,raw:raw,reg:reg};
}
function finCaixaHintHtml(k){ return k.dif===null||Math.abs(k.dif)<0.005?'':(k.dif>0?'O banco tem mais que o sistema.':'O banco tem menos que o sistema.'); }
/* Dia do mês que vale como "fim do mês": o último; se cair no fim de semana, a sexta. */
function finCaixaFimDoMes(mes){
  var u=finUltimoDia(mes), g=0;
  while(!finEhDiaUtil(u) && g<10){ u=finDiaMais(u,-1); g++; }   /* último dia útil: pula fim de semana e feriado */
  return u;
}
function finCaixaContasHtml(sel){
  var data=finCaixaDataDia();
  return '<div class="fcx-contas">'+finContasFechar().map(function(c){
    var emp=finCadById('empresas',c.empresaId), aplica=data>=finContaDataIni(c), r=finCaixaDoDia(c.id,data), on=!!sel&&sel.id===c.id;
    var cobra=finFechExigido(c,data), px=(!r&&!cobra)?finProximoFech(c,data):'';
    var refazer=!!r&&finCaixaMudou(r);
    var estado=!aplica?'':(!r?(cobra?'pend':'info'):((r.ressalva||refazer)?'ress':'ok')), rot=!aplica?'Começa em '+fmtDate(finContaDataIni(c)):(!r?(cobra?'Em aberto':(finFechRegra(c)==='nenhum'?'Sem fechamento':'Fecha em '+fmtDate(px).slice(0,5))):(refazer?'A refazer':(r.ressalva?'Fechado com ressalva':'Fechado')));
    return '<div class="fcx-conta'+(on?' on':'')+'" role="button" tabindex="0" aria-pressed="'+(on?'true':'false')+'" onclick="finCaixaConta(\''+c.id+'\')" '+
      'onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();finCaixaConta(\''+c.id+'\');}">'+
      '<div class="n">'+esc(c.nome)+'</div><div class="e">'+esc(emp?emp.nome:'')+'</div>'+
      '<div class="s">'+(aplica?fmt(finSaldoConta(c,data)):'—')+'</div>'+
      '<div class="cx '+estado+'">'+esc(rot)+'</div></div>';
  }).join('')+'</div>';
}
/* Parte 1: o dia, o saldo do sistema, o saldo do banco, a diferença e o botão. */
/* Dia fechado: o que foi conferido, sem campos para fechar de novo. Se o saldo do sistema mudou depois, avisa. */
var _fechCorrigir={};
function finCaixaFechadoHtml(c,k,nav){
  var reg=k.reg, quando=reg.em?new Date(reg.em).toLocaleString('pt-BR',{dateStyle:'short',timeStyle:'short'}):fmtDate(reg.data);
  var mudou=k.aplica && Math.abs((k.sistema||0)-(Number(reg.saldoSistema)||0))>=0.005;
  var dif=Number(reg.diferenca)||0;
  return '<div class="card fcx-pn"><h3 class="fcx-h">Conferir e fechar — '+esc(c.nome)+'</h3>'+nav+
    '<div class="fcx-feito '+((reg.ressalva||mudou)?'ress':'ok')+'" role="status"><span class="ic" aria-hidden="true">'+((reg.ressalva||mudou)?'!':'✓')+'</span><div><strong>'+(mudou?'Fechamento a refazer':(reg.ressalva?'Caixa fechado com ressalva':'Caixa fechado'))+'</strong> '+(mudou?'(fechado':'em')+' '+quando+(mudou?')':'')+'</div></div>'+
    '<div class="fcx-trio">'+
      '<div><div class="fcx-lb">Saldo no sistema</div><div class="fcx-grande">'+fmt(Number(reg.saldoSistema)||0)+'</div></div>'+
      '<div><div class="fcx-lb">Saldo no banco</div><div class="fcx-grande">'+fmt(Number(reg.saldoBanco)||0)+'</div></div>'+
      '<div><div class="fcx-lb">Diferença</div><div class="fcx-grande" style="color:'+(Math.abs(dif)>=0.005?'var(--red)':'var(--green)')+'">'+(Math.abs(dif)>=0.005?finFmtSinal(dif):fmt(0))+'</div></div>'+
    '</div>'+
    (reg.obs?'<div class="fcx-reg">Observação: '+esc(reg.obs)+'</div>':'')+
    (mudou?'<div class="fcx-mudou" role="alert">Depois do fechamento, entrou, mudou ou saiu um lançamento com data igual ou anterior, e o saldo do sistema deste dia passou para <strong>'+fmt(k.sistema)+'</strong>. Confira com o banco e feche o dia de novo.</div>':'')+
    '<div class="fcx-feito-acao"><a href="#" class="fcx-link" onclick="finCaixaCorrigir(\''+c.id+'\',true);return false">'+(mudou?'Refazer este fechamento':'Corrigir este fechamento')+'</a></div></div>';
}
function finCaixaCorrigir(cid,liga){
  var key=finCaixaChave(cid,finCaixaDataDia());
  if(liga) _fechCorrigir[key]=true; else{ delete _fechCorrigir[key]; delete _fechBanco[key]; delete _fechObs[key]; }
  navigate('fechamento');
  if(liga) setTimeout(function(){ var e=document.getElementById('fcx-banco-'+cid); if(e&&e.focus) e.focus(); },0);
}
function finCaixaFecharHtml(c,k){
  var key=finCaixaChave(c.id,k.data), reg=k.reg, raw=(k.raw===undefined||k.raw===null)?'':k.raw, obs=_fechObs[key];
  if(obs===undefined) obs=reg?(reg.obs||''):'';
  var hoje=todayStr(), ehHoje=(k.data===hoje), ini=finInicioSistema();
  var nav='<div class="fcx-nav">'+
    '<button class="fcx-seta" onclick="finCaixaDia(-1)" aria-label="Dia anterior"'+((ini&&k.data<=ini)?' disabled':'')+'>‹</button>'+
    finDp('fcx-data',k.data,{min:ini,max:hoje,onchange:'finCaixaMudaData()',rotulo:'Dia do fechamento',compacto:true})+
    '<button class="fcx-seta" onclick="finCaixaDia(1)" aria-label="Próximo dia"'+(ehHoje?' disabled':'')+'>›</button>'+
    (ehHoje?'':'<button class="btn" onclick="finCaixaHoje()">Hoje</button>')+
    '<a href="#" class="fcx-link" onclick="finVerLancDia(\''+c.id+'\',\''+k.data+'\');return false">Ver lançamentos do dia</a></div>'+
    '<div class="fin-err" id="err-fcx-data" role="alert"></div>';
  var aviso=k.aplica?'':'<div class="fcx-reg">Esta conta começa em '+fmtDate(finContaDataIni(c))+'. Escolha um dia a partir daí.</div>';
  var jaFechado=reg?'<div class="fcx-reg"><strong>'+(reg.ressalva?'Fechado com ressalva':'Fechado')+'</strong> em '+(reg.em?new Date(reg.em).toLocaleString('pt-BR',{dateStyle:'short',timeStyle:'short'}):fmtDate(reg.data))+
    '. Fechar de novo substitui este fechamento. <a href="#" class="fcx-link" onclick="finCaixaCorrigir(\''+c.id+'\',false);return false">Cancelar a correção</a></div>':'';
  /* dia já fechado: mostra o fechamento, sem campos; corrigir é um passo à parte */
  if(reg && !_fechCorrigir[key]) return finCaixaFechadoHtml(c,k,nav);
  if(!reg && finEhFeriado(k.data)) jaFechado='<div class="fcx-reg"><strong>Feriado</strong>: este dia não conta nos avisos de caixa, em nenhuma conta. Se houver movimento, dá para fechar normalmente. <a href="#" class="fcx-link" onclick="finMarcarFeriado(\''+k.data+'\',false);return false">Desmarcar feriado</a></div>';
  return '<div class="card fcx-pn"><h3 class="fcx-h">Conferir e fechar — '+esc(c.nome)+'</h3>'+nav+aviso+
    '<div class="fcx-trio">'+
      '<div><div class="fcx-lb">Saldo no sistema</div><div class="fcx-grande" id="fcx-sis-'+c.id+'">'+(k.aplica?fmt(k.sistema):'—')+'</div></div>'+
      '<div><label for="fcx-banco-'+c.id+'" class="fcx-lb">Saldo no banco</label>'+
        '<input type="text" inputmode="decimal" class="fcx-in" id="fcx-banco-'+c.id+'" value="'+esc(raw)+'" placeholder="0,00" autocomplete="off" aria-label="Saldo do banco de '+esc(c.nome)+'" '+
        'oninput="finValorEntrada(this,true);finCaixaAtualiza(\''+c.id+'\')" onblur="finValorBlur(\'fcx-banco-'+c.id+'\')"/>'+
        '<div class="fin-err" id="err-fcx-banco-'+c.id+'" role="alert"></div></div>'+
      '<div><div class="fcx-lb">Diferença</div><div class="fcx-grande" id="fcx-dif-'+c.id+'">'+finCaixaDifHtml(k)+'</div><div class="fcx-hint" id="fcx-hint-'+c.id+'">'+finCaixaHintHtml(k)+'</div></div>'+
    '</div>'+
    '<div class="fcx-linha2"><div><label for="fcx-obs-'+c.id+'" class="fcx-lb">Observação (opcional)</label>'+
      '<input type="text" id="fcx-obs-'+c.id+'" value="'+esc(obs)+'" maxlength="200" placeholder="O que explica a diferença" autocomplete="off" oninput="finCaixaObs(\''+c.id+'\',this.value)"/></div>'+
      '<div class="fcx-acao" id="fcx-acao-'+c.id+'">'+finCaixaBotaoHtml(c.id,k)+'</div></div>'+jaFechado+'</div>';
}
/* Parte 2: os dias do mês escolhido, um por linha, com o que foi fechado. */
function finCaixaHistoricoHtml(c,k){
  var mes=finCaixaMesSel(), hoje=todayStr(), ini=finContaDataIni(c)||'', adm=isFullAccess(currentUser), regra=finFechRegra(c);
  var de=mes+'-01', ate=finUltimoDia(mes); if(ate>hoje) ate=hoje; if(ini&&de<ini) de=ini;
  var movim={}, primeira='';
  (S.financeiro||[]).forEach(function(f){ if(f.contaId===c.id){ movim[f.data]=true; if(!primeira||f.data<primeira) primeira=f.data; } });
  var dias=[];
  for(var x=ate; x>=de; x=finDiaMais(x,-1)){
    var w=new Date(x+'T12:00:00').getDay(), r=finCaixaDoDia(c.id,x);
    if(!r && (!primeira||x<primeira)) continue;
    if(regra==='diario'?((w!==0&&w!==6)||movim[x]||r):(r||finFechExigido(c,x))) dias.push({d:x,r:r});
  }
  var refaz=dias.filter(function(o){ return o.r&&finCaixaMudou(o.r); }).length;
  var fech=dias.filter(function(o){ return o.r; }).length, ress=dias.filter(function(o){ return o.r&&o.r.ressalva; }).length, fer=dias.filter(function(o){ return !o.r&&finEhFeriado(o.d); }).length, aberto=dias.length-fech-fer, fimMes=finCaixaFimDoMes(mes);
  var resumo=fech+(fech===1?' fechado':' fechados')+(ress?' · '+ress+' com ressalva':'')+(refaz?' · '+refaz+' a refazer':'')+' · '+aberto+' em aberto'+(fer?' · '+fer+(fer===1?' feriado':' feriados'):'');
  function linhaHtml(o){
    var r=o.r, d=o.d, quando=r&&r.em?new Date(r.em).toLocaleString('pt-BR',{dateStyle:'short',timeStyle:'short'}):'';
    var fer=!r&&finEhFeriado(d), refazer=!!r&&finCaixaMudou(r);
    var sit=fer?'<span class="fcx-st fer">Feriado</span>':(!r?'<span class="fcx-st ab">Em aberto</span>':refazer?'<span class="fcx-st ress" title="O saldo do sistema deste dia mudou depois do fechamento">A refazer</span>':(r.ressalva?'<span class="fcx-st ress">Fechado com ressalva</span>':'<span class="fcx-st ok">Fechado</span>'));
    var acao=fer?'<button class="fin-ic" title="Desmarcar feriado (vale para todas as contas)" aria-label="Desmarcar feriado de '+fmtDate(d)+'" onclick="finMarcarFeriado(\''+d+'\',false)">'+FIN_IC.ferX+'</button>'
      :!r?'<span class="fcx-acs"><button class="btn fcx-fechar" onclick="finCaixaAbrirDia(\''+d+'\',true)">Fechar</button><button class="fin-ic" title="Marcar como feriado (vale para todas as contas)" aria-label="Marcar '+fmtDate(d)+' como feriado" onclick="finMarcarFeriado(\''+d+'\',true)">'+FIN_IC.fer+'</button></span>'
      :(adm?'<button class="fin-ic dg" title="Excluir fechamento" aria-label="Excluir fechamento de '+fmtDate(d)+'" onclick="finCaixaExcluir(\''+esc(r.id)+'\')">'+FIN_IC.exc+'</button>':'');
    return '<tr'+(d===k.data?' class="fcx-sel"':'')+'><td><a href="#" onclick="finCaixaAbrirDia(\''+d+'\');return false" class="fcx-link" title="'+(r?esc('Fechado por '+(r.por||'—')+(quando?' em '+quando:'')):'Em aberto')+'"><strong>'+fmtDate(d)+'</strong></a>'+
      '<span class="fcx-sub"> '+finDiaSemana(d).toLowerCase()+((regra==='diario'&&d===fimMes)?' · <b>fim do mês</b>':'')+'</span></td>'+
      '<td class="r">'+fmt(r?r.saldoSistema:finSaldoConta(c,d))+(refazer?'<div class="fcx-sub">agora '+fmt(finSaldoConta(c,d))+'</div>':'')+'</td>'+
      '<td class="r">'+(r?fmt(r.saldoBanco):'<span class="fcx-mut">—</span>')+'</td>'+
      '<td class="r" style="'+(r&&r.ressalva?'color:var(--red);font-weight:600':'')+'">'+(r&&r.ressalva?finFmtSinal(r.diferenca):'<span class="fcx-mut">—</span>')+'</td>'+
      '<td>'+sit+'</td><td><span class="fin-ell" title="'+esc((r&&r.obs)||'')+'">'+((r&&r.obs)?esc(r.obs):'<span class="fcx-mut">—</span>')+'</span></td><td class="r">'+acao+'</td></tr>';
  }
  /* Como regra, só os dias em aberto (de qualquer mês) e o último fechado; o histórico completo do mês abre num link. */
  if(!_fcxHistCompleto){
    /* mesma regra dos avisos (finPendFech): de hoje para trás, até o último fechamento feito */
    var abertos=[], ultimo=null, iniA=finIniAvisos(c), guardaA=0;
    (S.finCaixa||[]).forEach(function(r){ if(r.contaId===c.id && (!ultimo||r.data>ultimo.data)) ultimo=r; });
    if(regra!=='nenhum' && iniA){
      for(var y=hoje; y>=iniA && guardaA<400; y=finDiaMais(y,-1)){
        guardaA++;
        if(!finFechExigido(c,y)) continue;
        if(finCaixaDoDia(c.id,y)) break;
        abertos.push({d:y,r:null});
      }
    }
    abertos.sort(function(a,b){ return a.d<b.d?1:-1; });
    var refazC=finCaixasARefazer(c.id).filter(function(r){ return !ultimo||r.id!==ultimo.id; }).sort(function(a,b){ return a.data<b.data?1:-1; }).map(function(r){ return {d:r.data,r:r}; });
    var lst=abertos.concat(refazC,ultimo?[{d:ultimo.data,r:ultimo}]:[]);
    var pendC=finPendFech(c), hojeAb=abertos.some(function(o){ return o.d===hoje; }) && regra==='diario';
    var nRefC=refazC.length+((ultimo&&finCaixaMudou(ultimo))?1:0);
    var resumoC=(pendC.n?finPendTexto(pendC):'Nada pendente')+(nRefC?' · '+nRefC+(nRefC===1?' fechamento a refazer':' fechamentos a refazer'):'')+(hojeAb?' · hoje em aberto':'')+(ultimo?' · último fechamento em '+fmtDate(ultimo.data):' · nenhum fechamento ainda');
    var tabC=lst.length?'<table class="tbl fcx-th"><colgroup><col style="width:210px"><col style="width:150px"><col style="width:150px"><col style="width:130px"><col style="width:170px"><col><col style="width:124px"></colgroup>'+
      '<thead><tr><th>Data</th><th class="r">Saldo do sistema</th><th class="r">Saldo do banco</th><th class="r">Diferença</th><th>Situação</th><th>Observação</th><th></th></tr></thead><tbody>'+lst.map(linhaHtml).join('')+'</tbody></table>'
      :'<div class="empty">Nenhum dia a fechar.</div>';
    return '<div class="card fcx-pn" id="fcx-hist"><div class="fcx-topo"><h3 class="fcx-h" style="margin:0">Fechamentos — '+esc(c.nome)+'</h3></div>'+
      '<div class="fcx-sub" style="margin:0 0 10px">'+esc(resumoC)+'</div>'+tabC+
      '<button type="button" class="fcx-mais" onclick="finCaixaHistCompleto(true)">Ver histórico completo</button></div>';
  }
  var linhas=dias.map(linhaHtml).join('');
  var tabela=dias.length?'<table class="tbl fcx-th"><colgroup><col style="width:210px"><col style="width:150px"><col style="width:150px"><col style="width:130px"><col style="width:170px"><col><col style="width:124px"></colgroup>'+
    '<thead><tr><th>Data</th><th class="r">Saldo do sistema</th><th class="r">Saldo do banco</th><th class="r">Diferença</th><th>Situação</th><th>Observação</th><th></th></tr></thead><tbody>'+linhas+'</tbody></table>'
    :'<div class="empty">Nenhum '+(regra==='diario'?'dia':'fechamento')+' a conferir em '+esc(finMesLabel(mes))+'.'+((regra!=='diario'&&regra!=='nenhum'&&finProximoFech(c,mes+'-01')>hoje)?' O próximo é em '+fmtDate(finProximoFech(c,mes+'-01'))+'.':'')+'</div>';
  var m0=ini?ini.slice(0,7):'', mAtual=hoje.slice(0,7);
  var navMes='<div class="fcx-nav"><button class="fcx-seta" onclick="finCaixaMesNav(-1)" aria-label="Mês anterior"'+((m0&&mes<=m0)?' disabled':'')+'>‹</button>'+
    finDpMes('fcx-mes',mes,{min:m0,max:mAtual,onchange:'finCaixaMudaMes()',rotulo:'Mês do histórico'})+
    '<button class="fcx-seta" onclick="finCaixaMesNav(1)" aria-label="Próximo mês"'+(mes>=mAtual?' disabled':'')+'>›</button></div>';
  return '<div class="card fcx-pn" id="fcx-hist"><div class="fcx-topo"><h3 class="fcx-h" style="margin:0">Histórico de fechamentos — '+esc(c.nome)+'</h3>'+navMes+'</div>'+
    '<div class="fcx-sub" style="margin:0 0 10px">'+esc(resumo)+'</div>'+tabela+
    '<button type="button" class="fcx-mais" onclick="finCaixaHistCompleto(false)">Ver menos</button></div>';
}
var _fcxHistCompleto=false;
function finCaixaHistCompleto(v){ _fcxHistCompleto=!!v; navigate('fechamento'); var h=document.getElementById('fcx-hist'); if(h&&h.scrollIntoView&&v) try{ h.scrollIntoView({block:'start'}); }catch(e){} }
/* Para conta que não fecha todo dia: qual é a regra, o próximo fechamento ou o que está pendente. */
function finCaixaRegraHtml(c){
  var r=finFechRegra(c); if(r==='diario') return '';
  var p=finPendFech(c), px=finProximoFech(c), txt;
  if(r==='nenhum') txt='<strong>Sem fechamento</strong>: o sistema não cobra o fechamento desta conta. Dá para fechar quando quiser.';
  else txt='<strong>'+FIN_FECH_ROTULO[r]+'</strong>'+(r==='semanal'?' (toda '+FIN_DIAS_UTEIS_NOME[finFechDow(c)].toLowerCase()+')':' (último dia do mês)')+'. '+
    (p.n?'Pendente: <a href="#" class="fcx-link" onclick="finCaixaAbrirDia(\''+p.desde+'\',true);return false">'+fmtDate(p.desde)+'</a>'+(p.n>1?' e mais '+(p.n-1):'')+'.':(px?'O próximo é em '+fmtDate(px)+'.':''));
  return '<div class="fcx-regra" role="note">'+txt+'</div>';
}
function finViewFechamento(){
  var c=finFechContaSel();
  if(!c) return '<div class="card empty">Nenhuma conta.</div>';
  var k=finCaixaCalc(c.id);
  return finCaixaContasHtml(c)+finCaixaRegraHtml(c)+finCaixaFecharHtml(c,k)+finCaixaHistoricoHtml(c,k);
}
function finCaixaIrDia(d){ _fechData=(d===todayStr()?'':d); _fechMes=''; navigate('fechamento'); }
function finCaixaDia(n){
  var hoje=todayStr(), d=finDiaMais(finCaixaDataDia(),n), ini=finInicioSistema();
  if(d>hoje||(ini&&d<ini)) return;
  finCaixaIrDia(d);
}
function finCaixaMudaData(){ var e=document.getElementById('fcx-data'); if(e&&e.value) finCaixaIrDia(e.value); }
function finCaixaHoje(){ finCaixaIrDia(todayStr()); }
/* Abre um dia do histórico para conferir; com "foco", o cursor já vai para o saldo do banco. */
function finCaixaAbrirDia(d,foco){
  finCaixaIrDia(d); try{ window.scrollTo(0,0); }catch(e){}
  if(foco) setTimeout(function(){ var c=finFechContaSel(), e=c&&document.getElementById('fcx-banco-'+c.id); if(e&&e.focus) e.focus(); },0);
}
function finCaixaMesNav(n){
  var hoje=todayStr(), ini=finInicioSistema(), m=finMesSoma(finCaixaMesSel(),n);
  if(m>hoje.slice(0,7)||(ini&&m<ini.slice(0,7))) return;
  _fechMes=m; navigate('fechamento');
}
function finCaixaMudaMes(){ var e=document.getElementById('fcx-mes'); if(e&&e.value){ _fechMes=e.value; navigate('fechamento'); } }
/* Atalho a partir de Lançamentos: abre o Fechar caixa de hoje nesta conta, com o cursor no saldo do banco. */
function finIrFecharCaixa(cid){
  finAjustaEmpresaDaConta(cid); _fechData=''; _fechMes=''; _fechConta=cid;
  finIrPagina('fechamento');
  setTimeout(function(){ var e=document.getElementById('fcx-banco-'+cid); if(e){ if(e.scrollIntoView) e.scrollIntoView({block:'center'}); if(e.focus) e.focus(); } },0);
}
/* Diferença, dica e botão acompanham o saldo do banco enquanto se digita. */
function finCaixaAtualiza(cid){
  var c=finCadById('contas',cid); if(!c) return;
  var b=document.getElementById('fcx-banco-'+cid);
  if(b) _fechBanco[finCaixaChave(cid,finCaixaDataDia())]=b.value;
  var k=finCaixaCalc(cid);
  var f=document.getElementById('fcx-dif-'+cid); if(f) f.innerHTML=finCaixaDifHtml(k);
  var h=document.getElementById('fcx-hint-'+cid); if(h) h.innerHTML=finCaixaHintHtml(k);
  var a=document.getElementById('fcx-acao-'+cid); if(a) a.innerHTML=finCaixaBotaoHtml(cid,k);
}
/* Excluir um fechamento: confirmação com motivo, como nos lançamentos. Uma cópia fica em 'caixasExcluidos'. */
function finCaixaExcluir(id){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode realizar esta ação.'); return; }
  var r=(S.finCaixa||[]).find(function(x){return x.id===id;}); if(!r) return;
  var c=finCadById('contas',r.contaId);
  finDialogo({
    titulo:'Excluir fechamento',
    texto:esc(c?c.nome:'')+' — '+fmtDate(r.data)+', saldo do banco '+fmt(r.saldoBanco)+'. Ele sai do histórico da conta. O motivo fica registrado.',
    motivo:{rotulo:'Motivo da exclusão',obrigatorio:true},
    rotuloOk:'Excluir fechamento', perigo:true,
    onOk:function(motivo){ return finCaixaExcluirGravar(id,motivo); },
  });
}
async function finCaixaExcluirGravar(id,motivo){
  var r=(S.finCaixa||[]).find(function(x){return x.id===id;}); if(!r) return;
  try{
    var lote=fb.writeBatch(fb.db);
    lote.set(fb.doc(fb.db,'caixasExcluidos',id+'_'+Date.now()),Object.assign({},r,{excluidoMotivo:motivo,excluidoPor:currentUser.id,excluidoEm:new Date().toISOString()}));
    lote["delete"](fb.doc(fb.db,'caixas',id));
    await lote.commit();
    await finCarregaCaixas();
    showToast('Fechamento excluído.');
    navigate(currentPage);
  }catch(e){ showToast('Erro: '+(e.message||e.code)); }
}

var FIN_PDF_W={r:[278,278,355,556,556,889,667,191,333,333,389,584,278,333,278,278,556,556,556,556,556,556,556,556,556,556,278,278,584,584,584,556,1015,667,667,722,722,667,611,778,722,278,500,667,556,833,722,778,667,778,722,667,611,722,667,944,667,667,611,278,278,278,469,556,333,556,556,500,556,556,278,556,556,222,222,500,222,833,556,556,556,556,333,500,278,556,500,722,500,500,500,334,260,334,584,761,556,0,222,556,333,1000,556,556,333,1000,667,333,1000,0,611,0,0,222,222,333,333,350,556,1000,333,1000,500,333,944,0,500,667,278,333,556,556,556,556,260,556,333,737,370,556,584,333,737,333,400,584,333,333,333,556,537,278,333,333,365,556,834,834,834,611,667,667,667,667,667,667,1000,722,667,667,667,667,278,278,278,278,722,722,778,778,778,778,778,584,778,722,722,722,722,667,667,611,556,556,556,556,556,556,889,500,556,556,556,556,278,278,278,278,556,556,556,556,556,556,556,584,611,556,556,556,556,500,556,500],b:[278,333,474,556,556,889,722,238,333,333,389,584,278,333,278,278,556,556,556,556,556,556,556,556,556,556,333,333,584,584,584,611,975,722,722,722,722,667,611,778,722,278,556,722,611,833,722,778,667,778,722,667,611,722,667,944,667,667,611,333,278,333,584,556,333,556,611,556,611,556,333,611,611,278,278,556,278,889,611,611,611,611,389,556,333,611,556,778,556,556,500,389,280,389,584,761,556,0,278,556,500,1000,556,556,333,1000,667,333,1000,0,611,0,0,278,278,500,500,350,556,1000,333,1000,556,333,944,0,500,667,278,333,556,556,556,556,280,556,333,737,370,556,584,333,737,333,400,584,333,333,333,611,556,278,333,333,365,556,834,834,834,611,722,722,722,722,722,722,1000,722,667,667,667,667,278,278,278,278,722,722,778,778,778,778,778,584,778,722,722,722,722,667,667,611,556,556,556,556,556,556,889,556,556,556,556,556,278,278,278,278,611,611,611,611,611,611,611,584,611,611,611,611,611,556,611,556]};
/* ═══ LISTA COM BUSCA ═══ no lugar do <select> do navegador (que fecha ao tentar buscar com Ctrl+F), uma lista com caixa de busca ═══ */
var _finCb=null;   /* a lista aberta: {id, itens:[{v,t}], vis:[índices dos itens à mostra], ativo, termo, atual} */
function finCbDecodifica(s){ return String(s).replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').replace(/&#39;/g,"'").replace(/&amp;/g,'&'); }
/* As opções vêm do mesmo HTML que o <select> sempre usou: o select continua na página (escondido) e guarda o valor. */
function finCbOpcoes(html){
  var out=[], re=/<option\b([^>]*)>([\s\S]*?)<\/option>/g, m;
  while((m=re.exec(html||''))){
    var v=/\bvalue="([^"]*)"/.exec(m[1]);
    out.push({v:v?finCbDecodifica(v[1]):'',t:finCbDecodifica(m[2].replace(/<[^>]+>/g,'')),sel:/\bselected\b/.test(m[1]),dis:/\bdisabled\b/.test(m[1])});
  }
  return out;
}
/* Mostra o trecho encontrado em destaque (sem acento e sem diferença de maiúscula); só marca se o tamanho do texto não muda ao normalizar. */
function finCbMarca(t,termo){
  if(!termo) return esc(t);
  var n=finNorm(t); if(n.length!==String(t).length) return esc(t);
  var i=n.indexOf(termo); if(i<0) return esc(t);
  return esc(t.slice(0,i))+'<mark>'+esc(t.slice(i,i+termo.length))+'</mark>'+esc(t.slice(i+termo.length));
}
/* Nos campos de conta, o campo fechado mostra só o nome da conta ("Genial 5253996-2"); a empresa aparece na lista e na dica. */
function finCbTxtCurto(id,t){ return (id==='fin-conta'||id==='fin-outra')?String(t||'').split(' — ')[0]:t; }
function finCbHtml(id,optsHtml,o){
  o=o||{};
  var ops=finCbOpcoes(optsHtml), cur=ops.filter(function(x){ return x.sel; })[0]||ops[0]||{v:'',t:''};
  var ph=!cur.v && !o.neutro;
  return '<div class="fin-cb" id="cb-'+id+'">'+
    '<select id="'+id+'" class="fin-cb-sel" tabindex="-1" aria-hidden="true"'+(o.onchange?' onchange="'+o.onchange+'"':'')+'>'+optsHtml+'</select>'+
    '<div class="fin-cb-campo'+(o.neutro?' neutro':'')+'" id="cbc-'+id+'" role="combobox" tabindex="0" aria-haspopup="listbox" aria-expanded="false" aria-controls="cbl-'+id+'"'+
      (o.rotulo?' aria-label="'+esc(o.rotulo)+'"':' aria-labelledby="lb-'+id+'"')+' onclick="finCbAbre(\''+id+'\')" onkeydown="finCbTecla(event,\''+id+'\')">'+
      '<span class="txt'+(ph?' ph':'')+'" id="cbt-'+id+'" title="'+esc(cur.t)+'">'+esc(finCbTxtCurto(id,cur.t))+'</span><span class="seta" aria-hidden="true"></span></div>'+
    '<div class="fin-cb-pop" id="cbp-'+id+'" hidden></div></div>';
}
/* Campo de formulário com a lista com busca: o rótulo leva o cursor para o campo. */
function finFcb(rot,optsHtml,id,onchange){
  return '<div class="fg"><label id="lb-'+id+'" onclick="finCbFoca(\''+id+'\')">'+rot+'</label>'+finCbHtml(id,optsHtml,{onchange:onchange})+'<div class="fin-err" id="err-'+id+'" role="alert"></div></div>';
}
function finCbFoca(id){ var c=document.getElementById('cbc-'+id); if(c&&c.focus) c.focus(); }
function finCbAbre(id,ini){
  if(_finCb && _finCb.id===id && ini===undefined){ finCbFecha(false); return; }   /* clicar de novo fecha */
  if(_finCb) finCbFecha(false);
  var sel=document.getElementById(id), pop=document.getElementById('cbp-'+id), campo=document.getElementById('cbc-'+id);
  if(!sel||!pop) return;
  var itens=finCbOpcoes(sel.innerHTML).filter(function(x){ return !x.dis && !(x.v==='' && /^selecione/i.test(x.t)); });
  _finCb={id:id,itens:itens,vis:[],ativo:0,termo:'',atual:String(sel.value||'')};
  pop.innerHTML='<div class="fin-cb-bus"><input type="text" id="cbb-'+id+'" class="fin-cb-bi" placeholder="Buscar..." aria-label="Buscar" autocomplete="off" aria-controls="cbl-'+id+'" oninput="finCbFiltra(\''+id+'\')" onkeydown="finCbTecla(event,\''+id+'\')"/></div>'+
    '<div class="fin-cb-lst" id="cbl-'+id+'" role="listbox"></div><div class="fin-cb-dica">↑ ↓ escolhem · Enter seleciona · Esc fecha</div>';
  pop.hidden=false;
  if(campo&&campo.setAttribute) campo.setAttribute('aria-expanded','true');
  var w=document.getElementById('cb-'+id); if(w&&w.classList) w.classList.add('aberto');
  var bi=document.getElementById('cbb-'+id);
  if(bi&&ini) bi.value=ini;
  finCbFiltra(id);
  if(bi&&bi.focus){ bi.focus(); try{ var n=String(bi.value||'').length; bi.setSelectionRange(n,n); }catch(e){} }
}
function finCbFiltra(id){
  var c=_finCb; if(!c||c.id!==id) return;
  var bi=document.getElementById('cbb-'+id), termo=finNorm(bi?bi.value:'');
  c.termo=termo; c.vis=[];
  c.itens.forEach(function(x,i){ if(!termo || (x.v!=='' && finNorm(x.t).indexOf(termo)>=0)) c.vis.push(i); });
  var pos=-1;
  if(!termo){ for(var k=0;k<c.vis.length;k++){ if(c.itens[c.vis[k]].v===c.atual){ pos=k; break; } } }   /* sem busca, começa na opção atual */
  c.ativo=pos>=0?pos:0;
  finCbDesenha();
}
function finCbDesenha(){
  var c=_finCb; if(!c) return;
  var lst=document.getElementById('cbl-'+c.id); if(!lst) return;
  var h='';
  if(!c.vis.length) h='<div class="fin-cb-vazio">Nenhum resultado</div>';
  c.vis.forEach(function(i,k){
    var x=c.itens[i], atual=(x.v===c.atual);
    h+='<div class="fin-cb-op'+(k===c.ativo?' ativo':'')+(atual?' atual':'')+'" role="option" id="cbo-'+c.id+'-'+k+'" aria-selected="'+(atual?'true':'false')+'" onmousedown="finCbEscolhe(event,\''+c.id+'\','+k+')" onmousemove="finCbHover(\''+c.id+'\','+k+')">'+finCbMarca(x.t,c.termo)+'</div>';
  });
  lst.innerHTML=h;
  var bi=document.getElementById('cbb-'+c.id); if(bi&&bi.setAttribute) bi.setAttribute('aria-activedescendant',c.vis.length?'cbo-'+c.id+'-'+c.ativo:'');
  var a=document.getElementById('cbo-'+c.id+'-'+c.ativo); if(a&&a.scrollIntoView) a.scrollIntoView({block:'nearest'});
}
function finCbHover(id,k){
  var c=_finCb; if(!c||c.id!==id||c.ativo===k) return;
  var a=document.getElementById('cbo-'+id+'-'+c.ativo), b=document.getElementById('cbo-'+id+'-'+k);
  if(a&&a.classList) a.classList.remove('ativo'); if(b&&b.classList) b.classList.add('ativo');
  c.ativo=k;
}
function finCbEscolhe(ev,id,k){
  if(ev&&ev.preventDefault) ev.preventDefault();   /* o clique não tira o foco do campo antes da hora */
  var c=_finCb; if(!c||c.id!==id) return;
  var i=c.vis[k]; if(i===undefined) return;
  var x=c.itens[i], sel=document.getElementById(id);
  if(!sel) { finCbFecha(false); return; }
  var mudou=String(sel.value||'')!==x.v;
  sel.value=x.v;
  var campo=document.getElementById('cbc-'+id), neutro=!!(campo&&campo.classList&&campo.classList.contains('neutro'));
  var t=document.getElementById('cbt-'+id); if(t){ t.textContent=finCbTxtCurto(id,x.t); t.title=x.t; if(t.classList){ if(x.v==='' && !neutro) t.classList.add('ph'); else t.classList.remove('ph'); } }
  finCbFecha(true);
  if(mudou) finCbMudou(sel);
}
function finCbMudou(sel){
  try{ if(sel.dispatchEvent && typeof Event==='function'){ sel.dispatchEvent(new Event('change',{bubbles:true})); return; } }catch(e){}
  if(typeof sel.onchange==='function') sel.onchange({target:sel});
  finAoEditar({target:sel});
}
function finCbFecha(foco){
  var c=_finCb; if(!c) return;
  var id=c.id; _finCb=null;
  var pop=document.getElementById('cbp-'+id); if(pop){ pop.hidden=true; pop.innerHTML=''; }
  var campo=document.getElementById('cbc-'+id); if(campo&&campo.setAttribute) campo.setAttribute('aria-expanded','false');
  var w=document.getElementById('cb-'+id); if(w&&w.classList) w.classList.remove('aberto');
  if(foco&&campo&&campo.focus) campo.focus();
}
/* Teclado, tanto no campo fechado quanto na caixa de busca da lista aberta. */
function finCbTecla(e,id){
  var k=e.key, c=_finCb, aberto=!!(c&&c.id===id);
  function para(){ if(e.preventDefault) e.preventDefault(); if(e.stopPropagation) e.stopPropagation(); }
  if(!aberto){
    if(e.ctrlKey||e.metaKey||e.altKey) return;
    /* no formulário de lançamento, o Enter na lista fechada salva (como em qualquer campo); a lista abre com seta, espaço ou digitando */
    if(k==='Enter'){ var fm=document.getElementById('fin-form'), cc=document.getElementById('cbc-'+id); if(fm&&cc&&fm.contains&&fm.contains(cc)) return; }
    if(k==='Enter'||k===' '||k==='ArrowDown'||k==='ArrowUp'){ para(); finCbAbre(id); return; }
    if(k&&k.length===1){ para(); finCbAbre(id,k); return; }   /* digitar já começa a buscar */
    return;
  }
  if(k==='ArrowDown'||k==='ArrowUp'){
    para(); if(c.vis.length){ c.ativo=(c.ativo+(k==='ArrowDown'?1:-1)+c.vis.length)%c.vis.length; finCbDesenha(); } return;
  }
  if(k==='Enter'){ para(); if(c.vis.length) finCbEscolhe(null,id,c.ativo); return; }
  if(k==='Escape'){ para(); finCbFecha(true); return; }   /* Esc fecha só a lista; com a lista fechada, o Esc cancela o formulário como sempre */
  if(k==='Tab'){
    /* Tab confirma o que foi buscado e segue para o próximo campo; Shift+Tab só fecha */
    if(!e.shiftKey && c.termo && c.vis.length) finCbEscolhe(null,id,c.ativo); else finCbFecha(true);
  }
}

/* ═══ PLANILHAS E PDF ═══ exportar em Excel (com dados ou em branco), importar em lote e exportar em PDF ═══ */
var FIN_CRC=(function(){ var t=[],c,n,k; for(n=0;n<256;n++){ c=n; for(k=0;k<8;k++) c=(c&1)?(0xEDB88320^(c>>>1)):(c>>>1); t[n]=c>>>0; } return t; })();
function finCrc32(u){ var c=0xFFFFFFFF; for(var i=0;i<u.length;i++) c=FIN_CRC[(c^u[i])&255]^(c>>>8); return (c^0xFFFFFFFF)>>>0; }
function finBytes(s){ return new TextEncoder().encode(s); }
function finJunta(partes){
  var n=0,i,p=0; for(i=0;i<partes.length;i++) n+=partes[i].length;
  var o=new Uint8Array(n); for(i=0;i<partes.length;i++){ o.set(partes[i],p); p+=partes[i].length; }
  return o;
}
/* Um .xlsx é um zip. Aqui o zip é escrito sem compressão (o Excel abre normalmente) e lido com ou sem. */
function finZipEscreve(arqs){
  var partes=[], central=[], off=0;
  arqs.forEach(function(a){
    var nome=finBytes(a.nome), d=a.dados, crc=finCrc32(d);
    var lh=new Uint8Array(30+nome.length), v=new DataView(lh.buffer);
    v.setUint32(0,0x04034b50,true); v.setUint16(4,20,true); v.setUint16(6,0x0800,true); v.setUint16(10,0,true); v.setUint16(12,0x21,true);
    v.setUint32(14,crc,true); v.setUint32(18,d.length,true); v.setUint32(22,d.length,true); v.setUint16(26,nome.length,true); lh.set(nome,30);
    var ch=new Uint8Array(46+nome.length), c=new DataView(ch.buffer);
    c.setUint32(0,0x02014b50,true); c.setUint16(4,20,true); c.setUint16(6,20,true); c.setUint16(8,0x0800,true); c.setUint16(14,0x21,true);
    c.setUint32(16,crc,true); c.setUint32(20,d.length,true); c.setUint32(24,d.length,true); c.setUint16(28,nome.length,true); c.setUint32(42,off,true); ch.set(nome,46);
    partes.push(lh,d); central.push(ch); off+=lh.length+d.length;
  });
  var tam=0; central.forEach(function(c){ tam+=c.length; });
  var fim=new Uint8Array(22), e=new DataView(fim.buffer);
  e.setUint32(0,0x06054b50,true); e.setUint16(8,arqs.length,true); e.setUint16(10,arqs.length,true); e.setUint32(12,tam,true); e.setUint32(16,off,true);
  return finJunta(partes.concat(central,[fim]));
}
async function finZipLe(u8){
  var v=new DataView(u8.buffer,u8.byteOffset,u8.byteLength), i=u8.length-22;
  while(i>=0 && v.getUint32(i,true)!==0x06054b50) i--;
  if(i<0) throw new Error('zip');
  var n=v.getUint16(i+10,true), pos=v.getUint32(i+16,true), ent={}, k;
  for(k=0;k<n;k++){
    if(v.getUint32(pos,true)!==0x02014b50) break;
    var met=v.getUint16(pos+10,true), cs=v.getUint32(pos+20,true), nl=v.getUint16(pos+28,true), el=v.getUint16(pos+30,true), cl=v.getUint16(pos+32,true), lo=v.getUint32(pos+42,true);
    ent[new TextDecoder().decode(u8.subarray(pos+46,pos+46+nl))]={met:met,cs:cs,lo:lo};
    pos+=46+nl+el+cl;
  }
  async function dados(nome){
    var e=ent[nome]; if(!e) return null;
    var ini=e.lo+30+v.getUint16(e.lo+26,true)+v.getUint16(e.lo+28,true), bruto=u8.subarray(ini,ini+e.cs);
    if(e.met===0) return bruto;
    if(e.met!==8) throw new Error('zip');
    var fluxo=new Blob([bruto]).stream().pipeThrough(new DecompressionStream('deflate-raw'));
    return new Uint8Array(await new Response(fluxo).arrayBuffer());
  }
  return {nomes:Object.keys(ent), dados:dados, texto:async function(nome){ var d=await dados(nome); return d?new TextDecoder().decode(d):null; }};
}

function finXml(s){ return String(s).replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g,'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function finDesXml(s){
  return String(s).replace(/&#x([0-9a-fA-F]+);/g,function(m,h){ return String.fromCodePoint(parseInt(h,16)); }).replace(/&#(\d+);/g,function(m,d){ return String.fromCodePoint(parseInt(d,10)); })
    .replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').replace(/&apos;/g,"'").replace(/&amp;/g,'&');
}
function finColXlsx(i){ var s=''; i++; while(i>0){ var m=(i-1)%26; s=String.fromCharCode(65+m)+s; i=Math.floor((i-1)/26); } return s; }
function finColIdx(letras){ var n=0; for(var i=0;i<letras.length;i++) n=n*26+(letras.charCodeAt(i)-64); return n-1; }
function finSerial(iso){ var p=String(iso).split('-'); return Math.round((Date.UTC(+p[0],+p[1]-1,+p[2])-Date.UTC(1899,11,30))/86400000); }
function finSerialIso(n){ var d=new Date(Date.UTC(1899,11,30)+Math.round(n)*86400000); return d.getUTCFullYear()+'-'+('0'+(d.getUTCMonth()+1)).slice(-2)+'-'+('0'+d.getUTCDate()).slice(-2); }
function finNorm(s){ return String(s==null?'':s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/\s+/g,' ').trim(); }

/* estilos: 1 cabeçalho verde, 2 data, 3 valor, 4 texto com quebra, 5 negrito */
var FIN_XLSX_ESTILOS='<?xml version="1.0" encoding="UTF-8" standalone="yes"?><styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'+
  '<numFmts count="2"><numFmt numFmtId="164" formatCode="dd/mm/yyyy"/><numFmt numFmtId="165" formatCode="#,##0.00"/></numFmts>'+
  '<fonts count="3"><font><sz val="11"/><name val="Calibri"/></font><font><b/><sz val="11"/><color rgb="FFFFFFFF"/><name val="Calibri"/></font><font><b/><sz val="11"/><name val="Calibri"/></font></fonts>'+
  '<fills count="3"><fill><patternFill patternType="none"/></fill><fill><patternFill patternType="gray125"/></fill><fill><patternFill patternType="solid"><fgColor rgb="FF062E2B"/><bgColor indexed="64"/></patternFill></fill></fills>'+
  '<borders count="1"><border><left/><right/><top/><bottom/><diagonal/></border></borders>'+
  '<cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs>'+
  '<cellXfs count="6"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/>'+
  '<xf numFmtId="0" fontId="1" fillId="2" borderId="0" xfId="0" applyFont="1" applyFill="1"/>'+
  '<xf numFmtId="164" fontId="0" fillId="0" borderId="0" xfId="0" applyNumberFormat="1"/>'+
  '<xf numFmtId="165" fontId="0" fillId="0" borderId="0" xfId="0" applyNumberFormat="1"/>'+
  '<xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0" applyAlignment="1"><alignment wrapText="1" vertical="top"/></xf>'+
  '<xf numFmtId="0" fontId="2" fillId="0" borderId="0" xfId="0" applyFont="1"/></cellXfs>'+
  '<cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles></styleSheet>';
function finCelXlsx(r,c,v,est){
  var ref=finColXlsx(c)+(r+1), s=est?' s="'+est+'"':'';
  if(v===null||v===undefined||v==='') return est?'<c r="'+ref+'"'+s+'/>':'';
  if(typeof v==='number') return '<c r="'+ref+'"'+s+'><v>'+v+'</v></c>';
  return '<c r="'+ref+'"'+s+' t="inlineStr"><is><t xml:space="preserve">'+finXml(v)+'</t></is></c>';
}
function finAbaXml(a,ativa){
  var linhas=a.linhas.map(function(lin,r){
    var cs=''; lin.forEach(function(c,k){ var o=(c!==null&&typeof c==='object')?c:{v:c}; cs+=finCelXlsx(r,k,o.v,o.e); });
    return cs?'<row r="'+(r+1)+'">'+cs+'</row>':'';
  }).join('');
  var cols=a.larguras?'<cols>'+a.larguras.map(function(w,k){ return '<col min="'+(k+1)+'" max="'+(k+1)+'" width="'+w+'" customWidth="1"'+((a.estilosCol&&a.estilosCol[k])?' style="'+a.estilosCol[k]+'"':'')+'/>'; }).join('')+'</cols>':'';
  var vis='<sheetViews><sheetView workbookViewId="0"'+(ativa?' tabSelected="1"':'')+'>'+(a.congelar?'<pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" state="frozen"/><selection pane="bottomLeft" activeCell="A2" sqref="A2"/>':'')+'</sheetView></sheetViews>';
  var val=(a.validacoes&&a.validacoes.length)?'<dataValidations count="'+a.validacoes.length+'">'+a.validacoes.map(function(v){
    return '<dataValidation type="'+v.tipo+'"'+(v.op?' operator="'+v.op+'"':'')+' allowBlank="1" showErrorMessage="1" errorTitle="'+finXml(v.titulo)+'" error="'+finXml(v.erro)+'" sqref="'+v.sqref+'"><formula1>'+finXml(v.f1)+'</formula1></dataValidation>';
  }).join('')+'</dataValidations>':'';
  return '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'+vis+cols+'<sheetData>'+linhas+'</sheetData>'+val+'</worksheet>';
}
function finXlsxEscreve(abas){
  var n=abas.length, i, ct='<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/>'+
    '<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>';
  var folhas='', rels='<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">', arqs=[];
  for(i=1;i<=n;i++){
    ct+='<Override PartName="/xl/worksheets/sheet'+i+'.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>';
    folhas+='<sheet name="'+finXml(abas[i-1].nome)+'" sheetId="'+i+'" r:id="rId'+i+'"/>';
    rels+='<Relationship Id="rId'+i+'" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet'+i+'.xml"/>';
    arqs.push({nome:'xl/worksheets/sheet'+i+'.xml',dados:finBytes(finAbaXml(abas[i-1],i===1))});
  }
  ct+='</Types>';
  rels+='<Relationship Id="rId'+(n+1)+'" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/></Relationships>';
  var wb='<?xml version="1.0" encoding="UTF-8" standalone="yes"?><workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><bookViews><workbookView activeTab="0"/></bookViews><sheets>'+folhas+'</sheets></workbook>';
  var raiz='<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>';
  return finZipEscreve([{nome:'[Content_Types].xml',dados:finBytes(ct)},{nome:'_rels/.rels',dados:finBytes(raiz)},{nome:'xl/workbook.xml',dados:finBytes(wb)},{nome:'xl/_rels/workbook.xml.rels',dados:finBytes(rels)},{nome:'xl/styles.xml',dados:finBytes(FIN_XLSX_ESTILOS)}].concat(arqs));
}
/* Lê a planilha (a do sistema ou uma salva pelo Excel): devolve a aba "Lançamentos" (ou a primeira) como linhas de valores. */
async function finXlsxLe(buf){
  var u8=(buf instanceof Uint8Array)?buf:new Uint8Array(buf), zip=await finZipLe(u8);
  var wb=await zip.texto('xl/workbook.xml'), rels=await zip.texto('xl/_rels/workbook.xml.rels');
  if(!wb||!rels) throw new Error('xlsx');
  var abas=[], m, re=/<sheet\b([^>]*?)\/?>/g;
  while((m=re.exec(wb))){ var nome=/\bname="([^"]*)"/.exec(m[1]), rid=/\br:id="([^"]*)"/.exec(m[1]); if(nome&&rid) abas.push({nome:finDesXml(nome[1]),rid:rid[1]}); }
  var alvo={}; re=/<Relationship\b([^>]*?)\/?>/g;
  while((m=re.exec(rels))){ var id=/\bId="([^"]*)"/.exec(m[1]), tg=/\bTarget="([^"]*)"/.exec(m[1]); if(id&&tg) alvo[id[1]]=tg[1]; }
  if(!abas.length) throw new Error('xlsx');
  var aba=abas.filter(function(a){ return finNorm(a.nome)==='lancamentos'; })[0]||abas[0], alvoAba=alvo[aba.rid]||'';
  var caminho=alvoAba.charAt(0)==='/'?alvoAba.slice(1):'xl/'+alvoAba;
  var xml=await zip.texto(caminho); if(!xml) throw new Error('xlsx');
  var comp=await zip.texto('xl/sharedStrings.xml'), ss=[];
  if(comp){ var si=/<si\b[^>]*>([\s\S]*?)<\/si>/g, x; while((x=si.exec(comp))){ var tt='', t2=/<t\b[^>]*>([\s\S]*?)<\/t>/g, y; while((y=t2.exec(x[1]))) tt+=finDesXml(y[1]); ss.push(tt); } }
  var linhas=[], lr=/<row\b[^>]*?(?:\/>|>([\s\S]*?)<\/row>)/g, row;
  while((row=lr.exec(xml))){
    if(!row[1]) continue;
    var cr=/<c\b([^>]*?)(?:\/>|>([\s\S]*?)<\/c>)/g, c;
    while((c=cr.exec(row[1]))){
      var at=c[1], ref=/\br="([A-Z]+)(\d+)"/.exec(at); if(!ref) continue;
      var tipo=(/\bt="([^"]*)"/.exec(at)||[])[1], corpo=c[2]||'', v=null;
      if(tipo==='inlineStr'){ var ts='', ti=/<t\b[^>]*>([\s\S]*?)<\/t>/g, z; while((z=ti.exec(corpo))) ts+=finDesXml(z[1]); v=ts; }
      else{
        var vv=/<v\b[^>]*>([\s\S]*?)<\/v>/.exec(corpo); if(!vv) continue;
        if(tipo==='s') v=ss[parseInt(vv[1],10)];
        else if(tipo==='str'||tipo==='e') v=finDesXml(vv[1]);
        else if(tipo==='b') v=vv[1]==='1';
        else v=parseFloat(vv[1]);
      }
      var r=parseInt(ref[2],10)-1; (linhas[r]=linhas[r]||[])[finColIdx(ref[1])]=v;
    }
  }
  for(var q=0;q<linhas.length;q++) if(!linhas[q]) linhas[q]=[];
  return {aba:aba.nome, linhas:linhas};
}

/* ── a planilha de lançamentos (com os dados da tela ou em branco) ── */
var FIN_PLAN_CAB=['Data','Tipo','Conta','Categoria','Valor','Descrição','Observação','Outra conta (opcional)'];
var FIN_PLAN_TIPOS={entrada:'Entrada',saida:'Saída',transferencia:'Transferência'};
var FIN_PLAN_TIPOS_LISTA=['Entrada','Saída','Transferência enviada','Transferência recebida'];
function finPlanilhaAbas(linhasDados){
  var contas=finCad('contas').filter(function(c){ return c.ativo!==false && !finExterna(c); }).map(function(c){ return c.nome; });
  var destinos=contas.slice();   /* "Outra conta": as mesmas contas do sistema */
  var cats=finCad('categorias').filter(function(n){ return n.ativo!==false; }), catsOrd=cats.filter(function(n){ return n.sinal==='entrada'; }).concat(cats.filter(function(n){ return n.sinal!=='entrada'; })).map(function(n){ return n.nome; });
  var comSaldo=!!linhasDados, cab=FIN_PLAN_CAB.slice(); if(comSaldo) cab.push('Saldo');
  var linhas=[cab.map(function(h){ return {v:h,e:1}; })];
  (linhasDados||[]).forEach(function(d){
    linhas.push([{v:d.data?finSerial(d.data):'',e:2},d.tipo,d.conta,d.categoria,{v:d.valor,e:3},d.descricao,d.obs,d.destino,{v:d.saldo,e:3}]);
  });
  var ate=Math.max(2000,linhas.length+500);
  var listas=[[{v:'Tipo',e:5},{v:'Conta',e:5},{v:'Categoria',e:5},{v:'Outra conta (opcional)',e:5}]], n=Math.max(4,contas.length,catsOrd.length,destinos.length), i, tipos=FIN_PLAN_TIPOS_LISTA;
  for(i=0;i<n;i++) listas.push([tipos[i]||'',contas[i]||'',catsOrd[i]||'',destinos[i]||'']);
  var ajuda=['Como preencher','1. Preencha uma linha por lançamento na aba Lançamentos, a partir da linha 2.','2. Data: dia/mês/ano. Tipo, Conta, Categoria e Outra conta: escolha na lista (a setinha da célula). As opções vêm da aba Listas.',
    '3. Valor: sempre positivo. O Tipo diz se o dinheiro entra (Entrada, Transferência recebida) ou sai (Saída, Transferência enviada).',
    '4. Cada linha é um lançamento numa conta só. Uma transferência entre duas contas suas são duas linhas: uma "Transferência enviada" na conta que enviou e uma "Transferência recebida" na que recebeu.',
    '5. Transferência não tem categoria: deixe em branco. "Outra conta" é opcional e só diz com quem foi a transferência.',
    '6. Descrição: até '+FIN_DESC_MAX+' caracteres. Observação: texto livre.','7. A coluna Saldo (quando existe) é só para consulta e é ignorada na importação.',
    '8. No sistema: Lançamentos › Importar. Antes de gravar, o sistema mostra o que vai entrar, o que tem erro e o que já existe.'].map(function(t,k){ return [{v:t,e:k===0?5:4}]; });
  function lista(col,k){ return 'Listas!$'+col+'$2:$'+col+'$'+(k+1); }
  var nT=4, nC=Math.max(1,contas.length), nK=Math.max(1,catsOrd.length), nD=Math.max(1,destinos.length);
  return [
    {nome:'Lançamentos',linhas:linhas,congelar:true,larguras:[13,15,24,32,15,44,36,24].concat(comSaldo?[16]:[]),estilosCol:[2,0,0,0,3,0,0,0].concat(comSaldo?[3]:[]),
      validacoes:[
        {tipo:'list',sqref:'B2:B'+ate,f1:lista('A',nT),titulo:'Tipo',erro:'Escolha Entrada, Saída, Transferência enviada ou Transferência recebida.'},
        {tipo:'list',sqref:'C2:C'+ate,f1:lista('B',nC),titulo:'Conta',erro:'Escolha uma conta da lista.'},
        {tipo:'list',sqref:'D2:D'+ate,f1:lista('C',nK),titulo:'Categoria',erro:'Escolha uma categoria da lista.'},
        {tipo:'list',sqref:'H2:H'+ate,f1:lista('D',nD),titulo:'Outra conta (opcional)',erro:'Escolha uma conta da lista.'},
        {tipo:'decimal',op:'greaterThan',sqref:'E2:E'+ate,f1:'0',titulo:'Valor',erro:'Digite um valor maior que zero.'},
        {tipo:'textLength',op:'lessThanOrEqual',sqref:'F2:F'+ate,f1:String(FIN_DESC_MAX),titulo:'Descrição',erro:'Use no máximo '+FIN_DESC_MAX+' caracteres. O resto pode ir na observação.'}
      ]},
    {nome:'Listas',linhas:listas,larguras:[18,26,36,26]},
    {nome:'Como preencher',linhas:ajuda,larguras:[120]}
  ];
}
/* O que está na tela, na ordem da lista, já no formato da planilha. */
function finLinhasParaPlanilha(){
  return finLinhasEscopo().filter(finLinhaPassa).map(function(L){
    var f=L.f, tr=finEhTransferencia(f);
    return {data:f.data,tipo:finTipoRotulo(f),conta:finCadNome('contas',f.contaId),categoria:tr?'':(finNatNome(f)||''),valor:Number(f.valor)||0,descricao:f.descricao||'',obs:f.obs||'',destino:(tr&&f.contraparteId)?finCadNome('contas',f.contraparteId):'',saldo:L.saldo};
  });
}
function finPeriodoRotulo(){
  var r=finPeriodoRange(), p=_finPer;
  if(p.mode==='mes') return p.mes;
  if(p.mode==='dia') return p.dia;
  if(p.mode==='tudo') return 'tudo';
  return (r.de||'inicio')+'_a_'+(r.ate||'hoje');
}
function finBaixar(nome,bytes,mime){
  window._finUltimoArquivo={nome:nome,bytes:bytes,mime:mime};
  try{
    var b=new Blob([bytes],{type:mime}), a=document.createElement('a');
    a.href=URL.createObjectURL(b); a.download=nome; document.body.appendChild(a); a.click();
    setTimeout(function(){ try{ URL.revokeObjectURL(a.href); if(a.remove) a.remove(); }catch(e){} },1000);
  }catch(e){}
}
var FIN_MIME_XLSX='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
function finFechaMenuExp(){ var d=document.getElementById('fin-exp'); if(d&&d.open) d.open=false; }
function finExportarExcel(comDados){
  finFechaMenuExp();
  var dados=comDados?finLinhasParaPlanilha():null;
  var nome=comDados?'lancamentos-'+finPeriodoRotulo()+'.xlsx':'modelo-importacao-lancamentos.xlsx';
  finBaixar(nome,finXlsxEscreve(finPlanilhaAbas(dados)),FIN_MIME_XLSX);
  showToast(comDados?'Excel gerado: lançamentos da tela.':'Excel gerado: modelo em branco.');
}
function finImprimir(){ finFechaMenuExp(); window.print(); }

/* ── importar em lote ── */
var _finImp=null;   /* análise da planilha que está na janela de conferência */
var _finImpDup=false;   /* importar também as linhas que parecem repetidas (só se a pessoa marcar) */
/* Linhas que vão entrar e mudam o saldo de dias com caixa fechado */
function finImpFechAviso(an){
  var vao=an.itens.filter(function(i){ return i.status==='ok' || (_finImpDup && i.status==='dup'); });
  if(!vao.length) return '';
  var sim=(S.financeiro||[]).concat(vao.map(function(i,k){ return Object.assign({},i.l,{id:'__imp'+k}); }));
  var av=finFechAvisoHtml(finFechAfetados(sim));
  return av?'<p style="margin:0 0 8px">'+av+'</p>':'';
}
function finImpDupMuda(v){ _finImpDup=!!v; var root=document.getElementById('modal-root'); if(root&&_finImp) root.innerHTML=finImportaHtml(); var c=document.getElementById('fin-imp-dup'); if(c&&c.focus) c.focus(); }
function finImportaData(v){
  var iso='', m;
  if(typeof v==='number'){ if(v>20000&&v<80000) iso=finSerialIso(v); }
  else{
    var s=String(v==null?'':v).trim();
    if((m=/^(\d{4})-(\d{2})-(\d{2})/.exec(s))) iso=m[1]+'-'+m[2]+'-'+m[3];
    else if((m=/^(\d{1,2})\/(\d{1,2})\/(\d{4})/.exec(s))) iso=m[3]+'-'+('0'+m[2]).slice(-2)+'-'+('0'+m[1]).slice(-2);
  }
  if(!iso) return '';
  var d=new Date(iso+'T12:00:00'); if(isNaN(d.getTime())||finSerialIso(finSerial(iso))!==iso) return '';
  return iso;
}
function finImportaTipo(v){
  var s=finNorm(v); if(!s) return '';
  if(s==='entrada') return 'entrada'; if(s==='saida') return 'saida';
  if(s==='transferencia enviada') return 'transf_saida'; if(s==='transferencia recebida') return 'transf_entrada';
  if(s==='transferencia') return 'antiga';
  return '?';
}
function finImportaCols(cab){
  var nomes={data:['data'],tipo:['tipo'],conta:['conta','conta de origem','origem'],categoria:['categoria'],valor:['valor','valor (r$)','valor r$'],descricao:['descricao'],obs:['observacao'],destino:['outra conta (opcional)','outra conta','conta de destino','destino']};
  var idx={}, k;
  cab.forEach(function(h,i){ var n=finNorm(h); for(k in nomes) if(idx[k]===undefined && nomes[k].indexOf(n)>=0) idx[k]=i; });
  return idx;
}
/* Lê as linhas da planilha e diz, linha a linha, se entra, se tem erro ou se já existe. */
function finImportaAnalisa(linhas){
  var h=-1, i, idx={};
  for(i=0;i<Math.min(linhas.length,15);i++){ var x=finImportaCols(linhas[i]||[]); if(x.data!==undefined&&x.tipo!==undefined&&x.valor!==undefined){ h=i; idx=x; break; } }
  if(h<0) return {erroGeral:'Não achei o cabeçalho (Data, Tipo, Conta, Categoria, Valor…). Use o modelo do sistema: Exportar › Modelo em branco para importar.',itens:[]};
  var faltam=[['conta','Conta']].filter(function(p){ return idx[p[0]]===undefined; }).map(function(p){ return p[1]; });
  if(faltam.length) return {erroGeral:'Falta a coluna: '+faltam.join(', ')+'. Use o modelo do sistema.',itens:[]};
  var contas={}, cats={}; finCad('contas').forEach(function(c){ contas[finNorm(c.nome)]=c; }); finCad('categorias').forEach(function(n){ cats[finNorm(n.nome)]=n; });
  var existentes={}; (S.financeiro||[]).forEach(function(f){ existentes[finChaveImp(f)]=1; });
  var visto={}, itens=[], c;
  function cel(lin,k){ return idx[k]===undefined?'':(lin[idx[k]]==null?'':lin[idx[k]]); }
  for(i=h+1;i<linhas.length;i++){
    var lin=linhas[i]||[], vazia=true;
    for(c=0;c<lin.length;c++) if(lin[c]!==undefined&&lin[c]!==null&&String(lin[c]).trim()!=='') vazia=false;
    if(vazia) continue;
    var erros=[], tk=finImportaTipo(cel(lin,'tipo')), data=finImportaData(cel(lin,'data')), bruto=cel(lin,'valor'), valor;
    var eTr=(tk==='transf_saida'||tk==='transf_entrada'), tipo=eTr?'transferencia':((tk==='entrada'||tk==='saida')?tk:''), sentido=eTr?(tk==='transf_entrada'?'entrada':'saida'):'';
    if(!data) erros.push('Data não reconhecida (use dia/mês/ano).');
    if(!tk) erros.push('Informe o tipo.');
    else if(tk==='?') erros.push('Tipo inválido: use Entrada, Saída, Transferência enviada ou Transferência recebida.');
    else if(tk==='antiga') erros.push('Use "Transferência enviada" ou "Transferência recebida": cada linha é uma conta.');
    if(typeof bruto==='number') valor=Math.round(bruto*100)/100; else valor=finParseVal(bruto);
    if(bruto===''||bruto===null) erros.push('Informe o valor.');
    else if(isNaN(valor)) erros.push('Valor não reconhecido.');
    else if(valor<0) erros.push('Valor deve ser positivo; o tipo diz se entra ou sai.');
    var nomeConta=String(cel(lin,'conta')).trim(), conta=nomeConta?contas[finNorm(nomeConta)]:null;
    if(!nomeConta) erros.push('Informe a conta.'); else if(!conta) erros.push('Conta não encontrada: '+nomeConta+'.');
    var l={tipo:tipo,sentido:sentido,data:data,valor:valor,contaId:conta?conta.id:'',contraparteId:'',categoriaId:'',descricao:String(cel(lin,'descricao')).trim(),obs:String(cel(lin,'obs')).trim()};
    var nota='', nOutra=String(cel(lin,'destino')).trim(), nCat=String(cel(lin,'categoria')).trim();
    if(tipo==='transferencia'){
      if(nOutra){ var dc=contas[finNorm(nOutra)]; if(!dc) erros.push('Outra conta não encontrada: '+nOutra+'.'); else if(conta&&dc.id===conta.id) erros.push('A outra conta deve ser diferente da conta.'); else l.contraparteId=dc.id; }
      if(nCat) nota='A categoria foi ignorada: transferência não tem categoria.';
    }else if(tipo){
      var ct=nCat?cats[finNorm(nCat)]:null;
      if(!nCat) erros.push('Informe a categoria.'); else if(!ct) erros.push('Categoria não encontrada: '+nCat+'.'); else l.categoriaId=ct.id;
      if(nOutra) nota='"Outra conta" foi ignorada: só vale em transferência.';
    }
    if(!erros.length){
      var ev=finValidaCampos(l), seen={}; Object.keys(ev).forEach(function(k){ if(!seen[ev[k]]){ seen[ev[k]]=1; erros.push(ev[k]); } });
    }
    var item={linha:i+1,l:l,erros:erros,status:'ok',aviso:'',nota:nota};
    if(erros.length) item.status='erro';
    else{
      var ch=finChaveImp(l);
      if(existentes[ch]){ item.status='dup'; item.dupTipo='sistema'; item.aviso='Já existe um lançamento igual no sistema.'; }
      else if(visto[ch]){ item.status='dup'; item.dupTipo='planilha'; item.aviso='Igual à linha '+visto[ch]+' da planilha.'; }
      else visto[ch]=i+1;
    }
    itens.push(item);
  }
  return {erroGeral:'',itens:itens};
}
function finChaveImp(f){ return [f.data,f.tipo,f.sentido||'',f.contaId,f.contraparteId||'',Math.round((Number(f.valor)||0)*100),finNorm(f.descricao||'')].join('|'); }
function finImportaResumo(an){
  var r={total:an.itens.length,ok:0,erro:0,dup:0};
  an.itens.forEach(function(i){ r[i.status]++; });
  return r;
}
function finImportaHtml(){
  var an=_finImp, r=finImportaResumo(an), lim=300, nImp=r.ok+(_finImpDup?r.dup:0);
  var ord=an.itens.filter(function(i){ return i.status!=='ok'; }).concat(an.itens.filter(function(i){ return i.status==='ok'; })), mostra=ord.slice(0,lim);
  var linhas=mostra.map(function(i){
    var l=i.l, sit=i.status==='ok'?'<span class="badge b-venda">pronta</span>'+(i.nota?'<div class="fcx-sub">'+esc(i.nota)+'</div>':''):(i.status==='dup'?(_finImpDup?'<span class="badge b-venda">pronta</span>':'<span class="fcx-ab">'+(i.dupTipo==='planilha'?'repetida':'já existe')+'</span>')+'<div class="fcx-sub">'+esc(i.aviso)+'</div>':'<span class="badge b-desp">com erro</span><div class="fcx-sub" style="color:var(--red)">'+esc(i.erros.join(' '))+'</div>');
    return '<tr><td class="r">'+i.linha+'</td><td>'+sit+'</td><td>'+(l.data?fmtDate(l.data):'—')+'</td><td>'+esc(finTipoRotulo(l)||'—')+'</td><td>'+esc(finCadNome('contas',l.contaId)||'—')+
      (l.tipo==='transferencia'&&l.contraparteId?' ('+(l.sentido==='entrada'?'de ':'para ')+esc(finCadNome('contas',l.contraparteId))+')':'')+'</td><td>'+esc(l.tipo==='transferencia'?'—':(finCadNome('categorias',l.categoriaId)||'—'))+'</td><td class="r">'+(isNaN(l.valor)||l.valor===undefined?'—':fmt(l.valor))+'</td><td><span class="fin-ell" title="'+esc(l.descricao)+'">'+esc(l.descricao)+'</span></td></tr>';
  }).join('');
  var tabela=an.itens.length?'<div class="fin-imp-rol"><table class="tbl fin-imp"><thead><tr><th class="r">Linha</th><th>Situação</th><th>Data</th><th>Tipo</th><th>Conta</th><th>Categoria</th><th class="r">Valor</th><th>Descrição</th></tr></thead><tbody>'+linhas+'</tbody></table></div>'+
    (ord.length>lim?'<div class="fcx-sub" style="margin-top:6px">Mostrando as primeiras '+lim+' linhas (erros primeiro). As demais seguem a mesma regra.</div>':''):'';
  var corpo=an.erroGeral?'<p style="color:var(--red);margin:6px 0 0">'+esc(an.erroGeral)+'</p>'
    :'<p class="fin-imp-res"><strong>'+r.total+'</strong> linhas lidas · <strong>'+r.ok+'</strong> prontas'+(r.erro?' · <strong style="color:var(--red)">'+r.erro+' com erro</strong>':'')+(r.dup?' · <strong>'+r.dup+' parecem repetidas</strong>':'')+'</p>'+
      (r.erro?'<p class="fcx-sub" style="margin:0 0 8px">As linhas com erro não serão importadas. Corrija na planilha e importe de novo, se quiser.</p>':'')+
      (r.dup?finImpDupHtml(an):'')+finImpFechAviso(an)+tabela;
  return '<div class="fin-ov" onclick="if(event.target===this)finDlgCancelar()"><div class="fin-dlg fin-imp-dlg" role="dialog" aria-modal="true" aria-labelledby="fin-imp-t">'+
    '<h3 id="fin-imp-t">Importar lançamentos</h3><div class="fcx-sub" style="margin-bottom:6px">'+esc(an.arquivo||'')+'</div>'+corpo+
    '<div class="acoes"><button class="btn" id="fin-dlg-cancelar" onclick="finDlgCancelar()" style="background:#eee;color:var(--mt)">Cancelar</button>'+
    (nImp?'<button class="btn bp" id="fin-dlg-ok" onclick="finImportaGrava()">Importar '+nImp+(nImp===1?' lançamento':' lançamentos')+'</button>':'')+'</div></div></div>';
}
/* A opção de importar as repetidas: desmarcada por padrão, com quantas são de cada tipo. */
function finImpDupHtml(an){
  var pl=an.itens.filter(function(i){ return i.status==='dup'&&i.dupTipo==='planilha'; }).length, si=an.itens.filter(function(i){ return i.status==='dup'&&i.dupTipo==='sistema'; }).length, n=pl+si;
  var partes=[]; if(pl) partes.push(pl+(pl===1?' igual a outra linha da planilha':' iguais a outras linhas da planilha')); if(si) partes.push(si+(si===1?' já existe no sistema':' já existem no sistema'));
  return '<label class="fin-imp-dup"><input type="checkbox" id="fin-imp-dup"'+(_finImpDup?' checked':'')+' onchange="finImpDupMuda(this.checked)"/>'+
    '<span>Importar também '+(n===1?'a linha que parece repetida':'as <strong>'+n+'</strong> linhas que parecem repetidas')+' <span class="sub">('+partes.join(' · ')+')</span>'+
    '<span class="sub" style="display:block">Marque só se elas forem mesmo lançamentos diferentes, como várias tarifas iguais no mesmo dia.</span></span></label>'+
    ((_finImpDup&&si)?'<p class="fin-imp-alerta" role="alert">'+si+(si===1?' linha já existe':' linhas já existem')+' no sistema e '+(si===1?'vai':'vão')+' entrar de novo. Se for a mesma planilha importada outra vez, desmarque.</p>':'');
}
function finImportarAbrir(){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode realizar esta ação.'); return; }
  finFechaMenuExp();
  var e=document.getElementById('fin-arq'); if(e&&e.click) e.click();
}
async function finImportarArquivo(inp){
  var f=inp&&inp.files&&inp.files[0]; if(!f) return;
  var nome=f.name; try{ inp.value=''; }catch(e){}
  var buf; try{ buf=await f.arrayBuffer(); }catch(e){ showToast('Não consegui abrir o arquivo.'); return; }
  return finImportarBytes(buf,nome);
}
async function finImportarBytes(buf,nome){
  var lido; try{ lido=await finXlsxLe(buf); }catch(e){ showToast('Não consegui ler esse arquivo. Use uma planilha .xlsx (o modelo do sistema).'); return null; }
  _finImp=finImportaAnalisa(lido.linhas); _finImp.arquivo=nome||''; _finImpDup=false;
  _finDlg={importacao:true,onCancel:function(){ _finImp=null; }};
  var root=document.getElementById('modal-root'); if(root) root.innerHTML=finImportaHtml();
  setTimeout(function(){ var b=document.getElementById('fin-dlg-ok')||document.getElementById('fin-dlg-cancelar'); if(b&&b.focus) b.focus(); },0);
  return _finImp;
}
async function finImportaGrava(){
  var an=_finImp; if(!an) return;
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode realizar esta ação.'); return; }
  var prontos=an.itens.filter(function(i){ return i.status==='ok' || (_finImpDup && i.status==='dup'); }); if(!prontos.length) return;
  finDlgFecha(); _finImp=null; _finImpDup=false;
  var lote='imp-'+Date.now(), gravados=0;
  try{
    for(var i=0;i<prontos.length;i+=400){
      var b=fb.writeBatch(fb.db);
      prontos.slice(i,i+400).forEach(function(it){
        var l=it.l, id=fb.doc(fb.collection(fb.db,'lancamentos')).id;
        b.set(fb.doc(fb.db,'lancamentos',id),Object.assign({},l,{id:id,valor:Number(l.valor)||0,createdAt:fb.serverTimestamp(),createdBy:currentUser.id,updatedAt:fb.serverTimestamp(),updatedBy:currentUser.id,seq:finProxSeq(),origem:'planilha',lote:lote},finDerivados(l)));
        gravados++;
      });
      await b.commit();
    }
    S.financeiro=await fetchCollection('lancamentos');
    var datas=prontos.map(function(it){ return it.l.data; }).sort(), de=datas[0], ate=datas[datas.length-1], r=finPeriodoRange();
    if((r.de&&de<r.de)||(r.ate&&ate>r.ate)) _finPer=(de===ate)?{mode:'dia',dia:de,fim:de,mes:finMesDe(de),di:'',df:''}:{mode:'livre',dia:ate,fim:ate,mes:finMesDe(ate),di:de,df:ate};
    var marcadas=finContasEscopo().map(function(c){ return c.id; }), tocadas={};
    prontos.forEach(function(it){ [it.l.contaId].forEach(function(id){ var c=id&&finCadById('contas',id); if(c&&!finExterna(c)) tocadas[id]=1; }); });
    finSalvaContasSel(marcadas.concat(Object.keys(tocadas).filter(function(id){ return marcadas.indexOf(id)<0; })));
    _finF={tipo:'todos',categoriaId:'',q:''}; _finRecente=null; _finNovo=null; _finEdit=null;
    showToast(gravados+(gravados===1?' lançamento importado.':' lançamentos importados.')+' Para desfazer, use a marca "planilha" na linha.');
    navigate('financeiro');
  }catch(e){ showToast('Erro: '+(e.code||e.message)+(gravados?' ('+gravados+' já gravados)':'')); }
}

/* ── PDF ── gerado aqui mesmo (fonte Helvetica, sem depender de nada) ── */
var FIN_CP1252={0x20AC:128,0x201A:130,0x0192:131,0x201E:132,0x2026:133,0x2020:134,0x2021:135,0x02C6:136,0x2030:137,0x0160:138,0x2039:139,0x0152:140,0x017D:142,0x2018:145,0x2019:146,0x201C:147,0x201D:148,0x2022:149,0x2013:150,0x2014:151,0x02DC:152,0x2122:153,0x0161:154,0x203A:155,0x0153:156,0x017E:158,0x0178:159,0x2212:45,0x2192:62,0x21C4:60};
function finPdfCodifica(s){
  var o=[], i, c;
  for(i=0;i<s.length;i++){ c=s.charCodeAt(i); o.push(c<32?32:(c<127?c:((c>=160&&c<=255)?c:(FIN_CP1252[c]||(c===127?32:63))))); }
  return o;
}
function finPdfLarg(bytes,f,tam){ var w=FIN_PDF_W[f], t=0; for(var i=0;i<bytes.length;i++) t+=(bytes[i]>=32?w[bytes[i]-32]:0); return t*tam/1000; }
function finPdfCorta(bytes,max,f,tam){
  if(finPdfLarg(bytes,f,tam)<=max) return bytes;
  var b=bytes.slice(); while(b.length&&finPdfLarg(b.concat([133]),f,tam)>max) b.pop();
  return b.concat([133]);
}
function finPdfEsc(bytes){
  var s='', i, b; for(i=0;i<bytes.length;i++){ b=bytes[i]; s+=(b===40||b===41||b===92)?'\\'+String.fromCharCode(b):((b<32||b>126)?'\\'+('00'+b.toString(8)).slice(-3):String.fromCharCode(b)); }
  return s;
}
function finPdfNum(n){ return (Math.round(n*100)/100).toString(); }
/* d: {titulo, sub:[texto], colunas:[{nome,larg,dir,flex}], linhas:[{banda:texto}|{cels:[{t,cor}]}], saldoIni, saldoFim, rodape} */
function finPdfGera(d){
  var W=841.89, H=595.28, M=36, tam=8.5, rh=15.5, bh=17, util=W-2*M, cols=d.colunas.map(function(c){ return {nome:c.nome,larg:c.larg,dir:!!c.dir,flex:!!c.flex}; });
  var soma=0, flex=-1; cols.forEach(function(c,i){ soma+=c.larg; if(c.flex) flex=i; });
  if(flex>=0) cols[flex].larg+=util-soma;
  var xs=[], x=M; cols.forEach(function(c){ xs.push(x); x+=c.larg; });
  var direita=M+util, paginas=[], ops=null, y=0;
  var CORES={pos:'0.12 0.44 0.31',neg:'0.64 0.23 0.18',mt:'0.4 0.45 0.44',tx:'0.1 0.14 0.13',br:'1 1 1'};
  function txt(px,py,s,f,t,cor,dir,larg){
    var b=finPdfCodifica(s); if(larg!==undefined) b=finPdfCorta(b,larg,f,t);
    var w=finPdfLarg(b,f,t), xx=dir?px-w:px;
    ops.push('BT /'+(f==='b'?'F2':'F1')+' '+finPdfNum(t)+' Tf '+CORES[cor||'tx']+' rg '+finPdfNum(xx)+' '+finPdfNum(py)+' Td ('+finPdfEsc(b)+') Tj ET');
  }
  function ret(px,py,w,h,cor){ ops.push(cor+' rg '+finPdfNum(px)+' '+finPdfNum(py)+' '+finPdfNum(w)+' '+finPdfNum(h)+' re f'); }
  function linha(py,cor){ ops.push(cor+' RG 0.5 w '+finPdfNum(M)+' '+finPdfNum(py)+' m '+finPdfNum(M+util)+' '+finPdfNum(py)+' l S'); }
  function cabecalho(){
    ret(M,y-rh,util,rh,'0.024 0.18 0.169');
    cols.forEach(function(c,i){ var t=c.nome; if(c.dir) txt(xs[i]+c.larg-5,y-rh+4.6,t,'b',8,'br',true); else txt(xs[i]+5,y-rh+4.6,t,'b',8,'br',false,c.larg-8); });
    y-=rh;
  }
  function nova(primeira){
    ops=[]; paginas.push(ops); y=H-M;
    if(primeira){
      txt(M,y-15,d.titulo,'b',16,'tx'); y-=24;
      (d.sub||[]).forEach(function(s){ txt(M,y-9,s,'r',9,'mt'); y-=13; });
      y-=6;
      if(d.saldoIni){ txt(direita,y-9,d.saldoIni,'b',9.5,'tx',true); y-=17; }
    }else{ txt(M,y-9,d.titulo+' (continuação)','r',8.5,'mt'); y-=20; }
    cabecalho();
  }
  nova(true);
  d.linhas.forEach(function(L){
    var h=L.banda!==undefined?bh:rh;
    if(y-(L.banda!==undefined?bh+rh:rh)<M+26) nova(false);   /* o título do dia nunca fica sozinho no fim da página */
    if(L.banda!==undefined){ ret(M,y-h,util,h,'0.945 0.957 0.953'); txt(M+5,y-h+5.2,L.banda,'b',8.5,'tx',false,util-10); }
    else{
      L.cels.forEach(function(c,i){ if(!c.t) return; if(cols[i].dir) txt(xs[i]+cols[i].larg-5,y-h+4.6,c.t,c.neg?'b':'r',tam,c.cor,true); else txt(xs[i]+5,y-h+4.6,c.t,'r',tam,c.cor,false,cols[i].larg-8); });
      linha(y-h,'0.9 0.92 0.91');
    }
    y-=h;
  });
  if(d.saldoFim){ if(y-24<M+26) nova(false); txt(direita,y-17,d.saldoFim,'b',9.5,'tx',true); }
  var total=paginas.length;
  paginas.forEach(function(p,i){
    ops=p; txt(M,22,d.rodape||'','r',7.5,'mt'); txt(direita,22,'Página '+(i+1)+' de '+total,'r',7.5,'mt',true);
  });
  var objs=[], kids=[], n;
  objs.push('<< /Type /Catalog /Pages 2 0 R >>');
  objs.push(null);
  objs.push('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>');
  objs.push('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>');
  var agora=new Date(), pad=function(v){ return ('0'+v).slice(-2); };
  objs.push('<< /Title ('+finPdfEsc(finPdfCodifica(d.titulo))+') /Producer (PBL Financeiro) /CreationDate (D:'+agora.getFullYear()+pad(agora.getMonth()+1)+pad(agora.getDate())+pad(agora.getHours())+pad(agora.getMinutes())+pad(agora.getSeconds())+') >>');
  paginas.forEach(function(p,i){
    var cont=p.join('\n'), idC=6+2*i, idP=7+2*i;
    objs.push('<< /Length '+cont.length+' >>\nstream\n'+cont+'\nendstream');
    objs.push('<< /Type /Page /Parent 2 0 R /MediaBox [0 0 '+W+' '+H+'] /Resources << /Font << /F1 3 0 R /F2 4 0 R >> >> /Contents '+idC+' 0 R >>');
    kids.push(idP+' 0 R');
  });
  objs[1]='<< /Type /Pages /Kids ['+kids.join(' ')+'] /Count '+total+' >>';
  var out='%PDF-1.4\n', offs=[];
  objs.forEach(function(o,i){ offs.push(out.length); out+=(i+1)+' 0 obj\n'+o+'\nendobj\n'; });
  var xref=out.length; out+='xref\n0 '+(objs.length+1)+'\n0000000000 65535 f \n';
  offs.forEach(function(o){ out+=('0000000000'+o).slice(-10)+' 00000 n \n'; });
  out+='trailer\n<< /Size '+(objs.length+1)+' /Root 1 0 R /Info 5 0 R >>\nstartxref\n'+xref+'\n%%EOF';
  return finBytes(out);
}
function finExportarPdf(){
  finFechaMenuExp();
  var escopo=finContasEscopo(), unica=escopo.length===1, rng=finPeriodoRange(), tot=finTotaisPeriodo(), p=_finPer;
  var todas=finLinhasEscopo(), vis=todas.filter(finLinhaPassa), emp=_finEmp?finCadById('empresas',_finEmp):null;
  var per=p.mode==='mes'?'Mês: '+finMesLabel(p.mes):(p.mode==='dia'?'Dia: '+fmtDate(p.dia):(p.mode==='7d'?'7 dias: ':'')+'De '+fmtDate(rng.de)+' até '+fmtDate(rng.ate));
  if(p.mode==='7d') per='7 dias: de '+fmtDate(rng.de)+' até '+fmtDate(rng.ate);
  if(p.mode==='tudo') per='Todos os lançamentos';
  var filtros=[]; if(_finF.tipo&&_finF.tipo!=='todos') filtros.push('Mostrar: '+({entrada:'entradas',saida:'saídas',transferencia:'transferências'}[_finF.tipo]||_finF.tipo)); if(_finF.categoriaId) filtros.push('Categoria: '+finCadNome('categorias',_finF.categoriaId)); if(_finF.q) filtros.push('Busca: "'+_finF.q+'"');
  var sub=[(emp?emp.nome:'Todas as empresas')+' · '+escopo.map(function(c){ return c.nome; }).join(', '),per+(filtros.length?' · '+filtros.join(' · '):'')];
  var colunas=unica?[{nome:'Data',larg:62},{nome:'Descrição',larg:230,flex:true},{nome:'Categoria',larg:150},{nome:'Valor',larg:104,dir:true},{nome:'Saldo',larg:96,dir:true}]
                    :[{nome:'Data',larg:62},{nome:'Descrição',larg:200,flex:true},{nome:'Categoria',larg:130},{nome:'Conta',larg:120},{nome:'Valor',larg:100,dir:true},{nome:'Saldo',larg:92,dir:true}];
  var linhas=[], dia='', porDia={};
  vis.forEach(function(L){ porDia[L.f.data]=(porDia[L.f.data]||0)+1; });
  vis.forEach(function(L){
    var f=L.f, tr=finEhTransferencia(f), nome=f.descricao||finNatNome(f)||'Lançamento';
    if(f.data!==dia){ dia=f.data; linhas.push({banda:finDiaSemana(f.data)+', '+fmtDate(f.data)+' · '+porDia[f.data]+(porDia[f.data]===1?' lançamento':' lançamentos')}); }
    var cels=[{t:fmtDate(f.data)},{t:nome+(tr&&f.contraparteId?' ('+(f.sentido==='entrada'?'de ':'para ')+finCadNome('contas',f.contraparteId)+')':'')},{t:finNatNome(f)||''}];
    if(!unica) cels.push({t:finCadNome('contas',f.contaId)});
    var vl=finValorLinha(L); cels.push({t:vl.t,cor:vl.cor==='sai'?'neg':(vl.cor==='ent'?'pos':null)});
    cels.push({t:fmt(L.saldo),neg:true,cor:L.saldo<0?'neg':null});
    linhas.push({cels:cels});
  });
  var agora=new Date(), pad=function(v){ return ('0'+v).slice(-2); };
  var bytes=finPdfGera({titulo:'Lançamentos',sub:sub,colunas:colunas,linhas:linhas,saldoIni:'Saldo inicial  '+fmt(tot.ab),saldoFim:'Saldo final  '+fmt(tot.fin),
    rodape:'PBL Financeiro · gerado em '+pad(agora.getDate())+'/'+pad(agora.getMonth()+1)+'/'+agora.getFullYear()+' '+pad(agora.getHours())+':'+pad(agora.getMinutes())+' · '+vis.length+(vis.length===1?' lançamento':' lançamentos')});
  finBaixar('lancamentos-'+finPeriodoRotulo()+'.pdf',bytes,'application/pdf');
  showToast('PDF gerado: lançamentos da tela.');
}

/* Ações da aba, no topo à direita do título: ocultar valores e os três lançamentos. */
function finAcoesHtml(){
  return '<div class="fin-acoes no-print">'+
    '<button class="btn fin-olho" id="fin-olho" onclick="finOcultarValores()" aria-pressed="'+(_finOculto?'true':'false')+'" title="Esconde os valores da tela, útil ao compartilhar a tela">'+finOlhoSvg(_finOculto)+'<span>'+(_finOculto?'Mostrar valores':'Ocultar valores')+'</span></button>'+
    '<button class="btn fin-nv" onclick="finNovo(\'entrada\')" title="Atalho: tecla E" aria-keyshortcuts="E">+ Entrada</button>'+
    '<button class="btn fin-nv" onclick="finNovo(\'saida\')" title="Atalho: tecla S" aria-keyshortcuts="S">+ Saída</button>'+
    '<button class="btn fin-nv" onclick="finNovo(\'transferencia\')" title="Atalho: tecla T" aria-keyshortcuts="T">⇄ Transferência</button></div>';
}
/* Ocultar valores: desfoca os números da tela (cartões, resumo, lista, Fechar caixa). Excel e PDF não mudam. */
var _finOculto=false; try{ _finOculto=localStorage.getItem('fin_oculto')==='1'; }catch(e){}
/* Agrupar por dia: as faixas dos dias (dia, quantos lançamentos e se o caixa fechou). Ligado por padrão; a escolha fica gravada. */
var _finAgrupar=true; try{ _finAgrupar=localStorage.getItem('fin_agrupar')!=='0'; }catch(e){}
function finAgruparDias(v){
  _finAgrupar=!!v; try{ localStorage.setItem('fin_agrupar',_finAgrupar?'1':'0'); }catch(e){}
  var l=document.getElementById('fin-lista'); if(l){ l.innerHTML=finListaHtml(); finAjustaColunas(); }
}
function finAplicaOculto(){ try{ document.body.classList.toggle('fin-oculto',!!_finOculto); }catch(e){} }
function finOlhoSvg(off){
  return off?'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.4 5.1A9.7 9.7 0 0 1 12 5c5 0 8.5 4.5 9.5 7a13 13 0 0 1-2.4 3.4M6.2 6.2A13 13 0 0 0 2.5 12c1 2.5 4.5 7 9.5 7a9.6 9.6 0 0 0 4.6-1.2"/></svg>'
    :'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12C3.5 9.5 7 5 12 5s8.5 4.5 9.5 7c-1 2.5-4.5 7-9.5 7s-8.5-4.5-9.5-7z"/><circle cx="12" cy="12" r="3"/></svg>';
}
function finOcultarValores(){
  _finOculto=!_finOculto; try{ localStorage.setItem('fin_oculto',_finOculto?'1':'0'); }catch(e){}
  finAplicaOculto();
  var b=document.getElementById('fin-olho');
  if(b){ b.setAttribute('aria-pressed',_finOculto?'true':'false'); b.innerHTML=finOlhoSvg(_finOculto)+'<span>'+(_finOculto?'Mostrar valores':'Ocultar valores')+'</span>'; }
}
/* ── Avisos: dias úteis sem fechar, saldo parado na conta de passagem, transferência sem contrapartida ── */
function finEhDiaUtil(d){ var w=new Date(d+'T12:00:00').getDay(); return w!==0 && w!==6 && !finEhFeriado(d); }
/* ── Regra de fechamento de cada conta: diário, semanal (no dia escolhido), mensal (último dia do mês) ou sem fechamento ── */
var FIN_FECH_TIPOS=['diario','semanal','mensal','nenhum'];
var FIN_FECH_ROTULO={diario:'Fechamento diário',semanal:'Fechamento semanal',mensal:'Fechamento mensal',nenhum:'Sem fechamento'};
var FIN_FECH_CURTO={diario:'Diário',semanal:'Semanal',mensal:'Mensal',nenhum:'Sem fechamento'};
var FIN_FECH_DICA={diario:'Todo dia útil. Fica pendente a partir do dia seguinte.',semanal:'Uma vez por semana, no dia escolhido.',mensal:'No último dia do mês. A partir desse dia, fica pendente até fechar.',nenhum:'O sistema não cobra. Dá para fechar quando quiser.'};
var FIN_DIAS_UTEIS_NOME={1:'Segunda-feira',2:'Terça-feira',3:'Quarta-feira',4:'Quinta-feira',5:'Sexta-feira'};
function finFechRegra(c){ var r=c&&c.fechamento; return FIN_FECH_ROTULO[r]?r:'diario'; }
function finFechDow(c){ var n=Number(c&&c.fechDiaSemana); return (n>=1&&n<=5)?n:5; }
/* Na semana de d (segunda a domingo), o dia escolhido; se for feriado, o dia útil anterior. */
function finRefSemana(c,d){
  var w=new Date(d+'T12:00:00').getDay(); if(w===0) w=7;
  var alvo=finDiaMais(d,finFechDow(c)-w), g=0;
  while(!finEhDiaUtil(alvo) && g<6){ alvo=finDiaMais(alvo,-1); g++; }
  return alvo;
}
/* O sistema cobra o fechamento desta conta neste dia? */
function finFechExigido(c,d){
  var r=finFechRegra(c);
  if(r==='nenhum') return false;
  if(r==='diario') return finEhDiaUtil(d);
  if(r==='mensal') return d===finUltimoDia(d.slice(0,7));
  return d===finRefSemana(c,d);
}
/* O próximo dia em que o fechamento será cobrado (a partir de d, ou de hoje). */
function finProximoFech(c,d){
  var x=d||todayStr(), g=0; if(finFechRegra(c)==='nenhum') return '';
  while(g<40){ if(finFechExigido(c,x)) return x; x=finDiaMais(x,1); g++; }
  return '';
}
function finPendTexto(p){
  if(p.un==='mes') return p.n===1?'Fechamento de '+finMesLabel(p.desde.slice(0,7)).split(' de ')[0]+' pendente':p.n+' meses sem fechar';
  if(p.un==='semana') return p.n===1?'Fechamento de '+fmtDate(p.desde).slice(0,5)+' pendente':p.n+' semanas sem fechar';
  return p.n+(p.n===1?' dia sem fechar':' dias sem fechar');
}
/* Fechamentos que a regra da conta cobra e ainda não foram feitos, de trás para frente até o último feito.
   Diário: hoje fica de fora (o caixa do dia se fecha no fim do dia). Semanal e mensal: o próprio dia de referência já conta. */
/* Início para os avisos: a data inicial da conta; sem ela, o primeiro movimento ou fechamento da conta. */
function finIniAvisos(c){
  var ini=c?finContaDataIni(c):''; if(ini) return ini;
  var ds=(S.financeiro||[]).filter(function(f){ return f.contaId===c.id; }).map(function(f){ return f.data; })
    .concat((S.finCaixa||[]).filter(function(r){ return r.contaId===c.id; }).map(function(r){ return r.data; })).filter(Boolean).sort();
  return ds[0]||'';
}
function finPendFech(c){
  var hoje=todayStr(), ini=finIniAvisos(c), r=finFechRegra(c), un={diario:'dia',semanal:'semana',mensal:'mes',nenhum:'dia'}[r];
  var d=r==='diario'?finDiaMais(hoje,-1):hoje, n=0, desde='', guarda=0;
  if(!c || !ini || r==='nenhum') return {n:0,desde:'',un:un};
  while(d>=ini && guarda<400){
    guarda++;
    if(finFechExigido(c,d)){ if(finCaixaDoDia(c.id,d)) break; n++; desde=d; }
    d=finDiaMais(d,-1);
  }
  return {n:n,desde:desde,un:un};
}
/* Conta de passagem deve zerar a cada repasse: aviso quando o saldo fica acima de zero por 2 dias úteis ou mais. */
function finParado(c){
  if(!c || c.funcao!=='transito') return null;
  var hoje=todayStr(), ini=finIniAvisos(c); if(!ini || hoje<ini) return null;
  var saldo=Math.round(finSaldoConta(c,hoje)*100)/100; if(saldo<=0.005) return null;
  var d=hoje, desde=hoje, guarda=0;
  while(guarda<120){
    guarda++;
    var ant=finDiaMais(d,-1);
    if(ant<ini){ desde=ini; break; }
    if(finSaldoConta(c,ant)<=0.005){ desde=d; break; }
    d=ant; desde=d;
  }
  var n=0, x=desde; while(x<hoje){ if(finEhDiaUtil(x)) n++; x=finDiaMais(x,1); }
  return n>=2?{n:n,valor:saldo,desde:desde}:null;
}
function finIrFecharDiaConta(cid,d){ finAjustaEmpresaDaConta(cid); _fechConta=cid; finCaixaIrDia(d); }
function finSoConta(cid){ finAjustaEmpresaDaConta(cid); _finRecente=null; finSalvaContasSel([cid]); navigate('financeiro'); }
/* Leva a um lançamento: marca a conta dele, vai ao período e rola até a linha, destacada. */
function finIrPara(id){
  var f=(S.financeiro||[]).find(function(x){ return x.id===id; }); if(!f) return;
  finAjustaEmpresaDaConta(f.contaId);
  var sel=finContasEscopo().map(function(c){ return c.id; }); if(sel.indexOf(f.contaId)<0){ sel.push(f.contaId); finSalvaContasSel(sel); }
  _finF={tipo:'todos',categoriaId:'',q:''}; finPerVaiPara(f.data); _finRecente=id;
  navigate('financeiro'); finVoltaDoFormulario(true);
}
function finAtencaoHtml(){
  var itens=[], n=0, contas=finContasVisiveis().filter(function(c){ return c.ativo!==false && !finExterna(c); }), ids={};
  contas.forEach(function(c){
    ids[c.id]=1;
    var p=finPendFech(c);
    if(p.n>0){ n++; itens.push('<button onclick="finIrFecharDiaConta(\''+c.id+'\',\''+p.desde+'\')" title="Abre o Fechar caixa no fechamento mais antigo pendente ('+fmtDate(p.desde)+')">'+esc(c.nome)+' · '+finPendTexto(p)+'</button>'); }
    var rf=finCaixasARefazer(c.id).sort(function(a,b){ return a.data<b.data?-1:1; });
    if(rf.length){ n++; itens.push('<button onclick="finIrFecharDiaConta(\''+c.id+'\',\''+rf[0].data+'\')" title="O saldo do sistema mudou depois do fechamento. Abre o Fechar caixa no mais antigo ('+fmtDate(rf[0].data)+')">'+esc(c.nome)+' · '+rf.length+(rf.length===1?' fechamento a refazer':' fechamentos a refazer')+'</button>'); }
    var pd=finParado(c);
    if(pd){ n++; itens.push('<button onclick="finSoConta(\''+c.id+'\')" title="Conta de passagem com saldo sem repasse desde '+fmtDate(pd.desde)+'">'+esc(c.nome)+' · <span class="fin-mv">'+fmt(pd.valor)+'</span> parado há '+pd.n+' dias</button>'); }
  });
  var semcp=(S.financeiro||[]).filter(function(f){ return finEhTransferencia(f) && f.contraparteId && ids[f.contaId] && !finTemPar(f); })
    .sort(function(a,b){ return a.data<b.data?1:(a.data>b.data?-1:0); });
  n+=semcp.length;
  semcp.slice(0,3).forEach(function(f){ var dv=finParDiverge(f); itens.push('<button onclick="finIrPara(\''+f.id+'\')" title="'+(dv?'A outra ponta existe, mas o valor ou a conta não batem mais (uma das pontas foi alterada)':'Transferência com a outra conta informada, mas sem a outra ponta')+'">'+fmtDate(f.data).slice(0,5)+' · '+(dv?'transferência diferente da outra ponta':'transferência sem contrapartida')+' · '+esc(finCadNome('contas',f.contaId))+'</button>'); });
  if(semcp.length>3) itens.push('<span class="mais">e mais '+(semcp.length-3)+' sem contrapartida</span>');
  if(!n) return '';
  return '<div class="fin-aten no-print" role="status"><span class="t">'+n+(n===1?' item pede atenção':' itens pedem atenção')+'</span>'+itens.join('')+'</div>';
}
function pageFinanceiro(){
  _finErros={}; finAplicaOculto();
  finAtualizaEmpresaHeader();
  var emp=_finEmp?finCadById('empresas',_finEmp):null;
  var nome=_finTab==='cad'?FIN_TITULO[_finCadTab]:FIN_TITULO[_finTab];
  var head='<div class="page-title">'+nome+(emp&&_finTab!=='cad'?' — '+esc(emp.nome):'')+'</div>';
  if(!finCad('contas').length){
    return head+'<div class="card"><div class="empty">Nenhuma conta cadastrada. Comece por <b>Cadastros</b>: empresa → conta bancária → plano de contas.</div></div>';
  }
  if(_finTab==='cad') return '<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">'+head+finCadBotaoNovo()+'</div>'+finViewCadastros();
  if(_finTab==='lanc' && !_finNovo && !_finEdit) head='<div class="fin-topo">'+head+finAcoesHtml()+'</div>';
  return head+(_finTab==='fech'?finViewFechamento():finViewLancamentos());
}

/* ── Lançamentos ─────────────────────────────────────────── */
/* Só as contas que o sistema controla. Com uma empresa selecionada, a conta do lançamento lista só as dela; "Outra conta" mostra todas. Sem conta escolhida, nada vem pré-selecionado. */
function finOptsConta(sel,exclui,modo){
  return '<option value=""'+(sel?'':' selected')+'>Selecione…</option>'+
    finCad('contas').filter(function(c){
      if(c.id===exclui) return false;
      if(c.id===sel) return true;   /* a escolhida aparece mesmo inativa: editar um lançamento antigo não pode apagá-la */
      if(c.ativo===false) return false;
      if(finExterna(c)) return false;
      if(modo==='origem' && _finEmp && c.empresaId!==_finEmp) return false;
      return true;
    }).map(function(c){
      var emp=finCadById('empresas',c.empresaId);
      return '<option value="'+c.id+'"'+(c.id===sel?' selected':'')+'>'+esc(c.nome)+' — '+esc(emp?emp.nome:'sem empresa')+(c.ativo===false?' (inativa)':'')+'</option>';
    }).join('');
}
function finOptsCategoria(sinal,sel){
  /* sem opção pré-selecionada: a categoria precisa ser escolhida, não herdada da ordem da lista */
  return '<option value=""'+(sel?'':' selected')+'>Selecione…</option>'+
    finCad('categorias').filter(function(n){ return n.id===sel || (n.ativo!==false && (!sinal||!n.sinal||n.sinal===sinal)); }).map(function(n){
      return '<option value="'+n.id+'"'+(n.id===sel?' selected':'')+'>'+esc(n.nome)+(n.ativo===false?' (inativa)':'')+'</option>';
    }).join('');
}
/* Seletor de empresa no cabeçalho: vale para Lançamentos e Fechar caixa; some nas telas de configuração. */
function finAtualizaEmpresaHeader(){
  var box=document.getElementById('hdr-emp'); if(!box) return;
  if(_finTab==='cad'){ box.innerHTML=''; return; }
  var itens=[{id:'',nome:'Todas as empresas'}].concat(finCad('empresas').filter(function(e){ return e.ativo!==false; }));
  box.innerHTML='<label for="hdr-emp-sel">Empresa</label><select id="hdr-emp-sel" onchange="finSetEmp(this.value)" aria-label="Empresa">'+
    itens.map(function(e){ return '<option value="'+esc(e.id)+'"'+(e.id===_finEmp?' selected':'')+'>'+esc(e.nome)+'</option>'; }).join('')+'</select>';
}

/* O caixa de hoje desta conta: fechado, fechado com ressalva ou ainda aberto. */
function finCaixaHojeDe(cid){
  var hoje=todayStr(), r=(S.finCaixa||[]).find(function(x){ return x.contaId===cid && x.data===hoje; });
  return !r?{estado:'aberto'}:{estado:(r.ressalva?'ressalva':'fechado'),dif:r.diferenca};
}
/* Atalho: leva ao Fechar caixa de hoje, já no campo do saldo do banco desta conta. */
/* Ao abrir uma conta de outra empresa, o filtro de empresa do cabeçalho acompanha a conta. */
function finAjustaEmpresaDaConta(cid){
  var c=finCadById('contas',cid);
  if(c && _finEmp && _finEmp!==c.empresaId){ _finEmp=c.empresaId; try{ sessionStorage.setItem('fin_emp',_finEmp); }catch(e){} }
}
/* Do cartão da conta para o extrato dela no mês atual. */
/* Da conta do fundo para as transferências que chegaram a ela, no mês atual. */
/* Um cartão por conta: saldo do período e a situação do caixa de hoje. Clicar seleciona a conta; o botão leva ao fechamento. */
/* Um cartão por conta: marque os que quer ver juntos. Mostra o saldo do período e a situação do caixa de hoje. */
function finChipsContas(){
  var rng=finPeriodoRange(), vis=finContasVisiveis(), sel=finContasEscopo().map(function(c){ return c.id; });
  function chipCaixa(c){
    var p=finPendFech(c), pd=finParado(c), extra=pd?'<span class="fin-cx alerta fixo" title="Conta de passagem com saldo sem repasse desde '+fmtDate(pd.desde)+'">parado há '+pd.n+' dias</span>':'';
    if(p.n>0) return '<div class="fin-cxs"><button class="fin-cx alerta" onclick="event.stopPropagation();finIrFecharDiaConta(\''+c.id+'\',\''+p.desde+'\')" title="Fechamento pendente desde '+fmtDate(p.desde)+'">'+finPendTexto(p)+'</button>'+extra+'</div>';
    return '<div class="fin-cxs">'+chipHoje(c)+extra+'</div>';
  }
  function chipHoje(c){
    var hoje=todayStr(), rg=finFechRegra(c);
    if(rg!=='diario' && !finFechExigido(c,hoje) && !finCaixaDoDia(c.id,hoje)){
      var px=finProximoFech(c,hoje);
      return '<button class="fin-cx info" onclick="event.stopPropagation();finIrFecharCaixa(\''+c.id+'\')" title="'+FIN_FECH_ROTULO[rg]+(px?': o próximo é em '+fmtDate(px):'')+'">'+(rg==='nenhum'?'Sem fechamento':'Fecha em '+fmtDate(px).slice(0,5))+'</button>';
    }
    var k=finCaixaHojeDe(c.id), cl={aberto:'pend',fechado:'ok',ressalva:'ress'}[k.estado];
    var rot={aberto:'Fechar caixa',fechado:'Caixa fechado hoje',ressalva:'Fechado com ressalva'}[k.estado];
    return '<button class="fin-cx '+cl+'" onclick="event.stopPropagation();finIrFecharCaixa(\''+c.id+'\')" title="'+(k.estado==='aberto'?'Ir para o Fechar caixa desta conta':'Ver o fechamento de hoje')+'">'+rot+'</button>';
  }
  var cartoes=vis.map(function(c){
    var k=finCalcPeriodo(c,rng.de,rng.ate), on=sel.indexOf(c.id)>=0, emp=finCadById('empresas',c.empresaId);
    return '<div class="fin-cartao'+(on?' on':'')+(c.ativo===false?' off':'')+'" role="button" tabindex="0" aria-pressed="'+(on?'true':'false')+'" onclick="finSetConta(\''+c.id+'\')" '+
      'onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();finSetConta(\''+c.id+'\');}">'+
      '<span class="chk" aria-hidden="true">✓</span>'+
      '<div class="n">'+esc(c.nome)+'</div><div class="e">'+esc((emp?emp.nome:'')+(c.ativo===false?' · inativa':''))+'</div>'+
      '<div class="s">'+(k.aplica?fmt(k.final):'<span style="color:var(--mt)">—</span>')+'</div>'+(c.ativo===false?'':chipCaixa(c))+
      ((c.agencia||c.cnpj||c.pixChave)?'<button class="fin-copia" onclick="event.stopPropagation();finCopiarDados(\''+c.id+'\')" onkeydown="event.stopPropagation()" title="Copiar dados da conta" aria-label="Copiar dados da conta '+esc(c.nome)+'">'+
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg></button>':'')+'</div>';
  }).join('');
  return '<div class="no-print fin-scroll" style="display:flex;gap:8px;flex-wrap:wrap;align-items:stretch;margin:0 0 6px">'+cartoes+'</div>'+
    (vis.length>1?'<div class="fin-dica no-print">Clique nos cartões para ver uma ou mais contas juntas.</div>':'');
}

function finPeriodoHtml(){
  var p=_finPer, hoje=todayStr(), ontem=finDiaMais(hoje,-1), md=p.mode, ini=finInicioSistema();
  function seg(txt,on,acao,pos,off){
    var raio=pos==='first'?'8px 0 0 8px':(pos==='last'?'0 8px 8px 0':'0');
    return '<button onclick="'+acao+'" aria-pressed="'+(on?'true':'false')+'"'+(off?' disabled title="Antes do início do sistema ('+fmtDate(ini)+')"':'')+
      ' style="padding:7px 14px;border:1px solid '+(on?'var(--v)':'var(--bd)')+';'+
      'background:'+(on?'var(--v)':'var(--card)')+';color:'+(on?'#fff':'var(--tx)')+';font-size:13px;font-weight:'+(on?'700':'500')+';cursor:'+(off?'not-allowed':'pointer')+
      ';opacity:'+(off?'.45':'1')+';margin-left:'+(pos==='first'?'0':'-1px')+';border-radius:'+raio+'">'+txt+'</button>';
  }
  var grupo='<div role="group" aria-label="Período" class="fin-seg" style="display:inline-flex">'+
    seg('Hoje',md==='dia'&&p.dia===hoje,"finPerAtalho('hoje')",'first')+
    seg('Ontem',md==='dia'&&p.dia===ontem,"finPerAtalho('ontem')",'meio',ontem<ini)+
    seg('7 dias',md==='7d',"finPerAtalho('7d')",'meio')+
    seg('Mês',md==='mes',"finPerAtalho('mes')",'meio')+
    seg('Tudo',md==='tudo',"finPerAtalho('tudo')",'meio')+
    seg('Personalizado',md==='livre',"finPerAtalho('livre')",'last')+'</div>';
  var campo='padding:6px 10px;border:1px solid var(--bd);border-radius:6px;background:var(--input);color:var(--tx);font:inherit;font-weight:700';
  var seta='padding:5px 11px;border:1px solid var(--bd);background:var(--card);color:var(--tx);border-radius:6px;cursor:pointer;font-size:14px';
  var ctl;
  if(md==='tudo'){
    var dl=(S.financeiro||[]).map(function(f){ return f.data; }).filter(Boolean).sort();
    ctl='<span style="font-size:13px;color:var(--mt)">'+(dl.length?'Todos os lançamentos, de '+fmtDate(dl[0])+' a '+fmtDate(dl[dl.length-1]):'Todos os lançamentos')+'</span>';
  }else if(md==='livre'){
    ctl=finDpFaixa('fin-pdi','fin-pdf',p.di,p.df,{min:ini,max:hoje,onchange:'finPerLivre()'});
  }else{
    var r=finPeriodoRange(), ant, prox, fimJa, iniJa;
    if(md==='dia'){ ant='Dia anterior'; prox='Próximo dia'; fimJa=p.dia>=hoje; iniJa=p.dia<=ini; }
    else if(md==='7d'){ ant='7 dias anteriores'; prox='Próximos 7 dias'; fimJa=p.fim>=hoje; iniJa=finDiaMais(p.fim,-6)<=ini; }
    else{ ant='Mês anterior'; prox='Próximo mês'; fimJa=p.mes>=hoje.slice(0,7); iniJa=p.mes<=ini.slice(0,7); }
    var meio=md==='dia'
      ? finDp('fin-pdia',p.dia,{min:ini,max:hoje,onchange:'finPerDia()',rotulo:'Dia',compacto:true})
      : (md==='mes'
        ? finDpMes('fin-mes',p.mes,{min:ini.slice(0,7),max:hoje.slice(0,7),onchange:'finPerMes()',rotulo:'Mês'})
        : '<span style="font-size:12px;color:var(--mt)">de '+fmtDate(r.de)+' até</span>'+finDp('fin-pfim',p.fim,{min:ini,max:hoje,onchange:'finPerFim()',rotulo:'Último dia',compacto:true,semana:false}));
    ctl='<button onclick="finPerNav(-1)"'+(iniJa?' disabled':'')+' aria-label="'+ant+'" title="'+ant+'" style="'+seta+(iniJa?';opacity:.4;cursor:not-allowed':'')+'">‹</button>'+meio+
        '<button onclick="finPerNav(1)"'+(fimJa?' disabled':'')+' aria-label="'+prox+'" title="'+prox+'" style="'+seta+(fimJa?';opacity:.4;cursor:not-allowed':'')+'">›</button>';
  }
  return '<div class="no-print" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:0 0 14px"><span style="font-size:12px;color:var(--mt)">Período</span>'+grupo+ctl+'</div>';
}

function finStripHtml(){
  var t=finTotaisPeriodo();
  var aviso=(t.aplica||!finInicioSistema())?'':'<div class="card" style="margin-bottom:10px"><div class="empty">Este período é anterior ao início do sistema ('+fmtDate(finInicioSistema())+').</div></div>';
  /* Cartões: só rótulo e valor. O detalhe fica na dica ao passar o mouse (todos têm). Entradas, Saídas e Transferências
     são filtros da lista, em sincronia com o "Mostrar" dos filtros. */
  var rng=finPeriodoRange(), hojeK=todayStr(), fimK=rng.ate&&rng.ate<hojeK?rng.ate:hojeK;
  function sv(v){ return '<span class="fin-mv">'+fmt(Math.abs(v))+'</span>'; }
  function dica(txt){ return '<span class="fin-kdica" role="tooltip">'+txt+'</span>'; }
  function filtro(tipo,cls,rot,valor,txtDica){
    var on=_finF.tipo===tipo;
    return '<div class="mc '+cls+' clic'+(on?' ativo':'')+'" data-tipo="'+tipo+'" role="button" tabindex="0" aria-pressed="'+(on?'true':'false')+'" onclick="finKpiFiltro(\''+tipo+'\')" onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();finKpiFiltro(\''+tipo+'\');}">'+
      '<div class="ml">'+rot+'</div><div class="mv '+cls+'">'+valor+'</div>'+
      '<span class="fin-kx" aria-hidden="true">filtrando ✕</span>'+dica(txtDica+'<span class="fin-kd2">'+(on?'Clique para voltar a ver tudo.':'Clique para ver só '+({entrada:'as entradas',saida:'as saídas',transferencia:'as transferências'}[tipo])+' na lista.')+'</span>')+'</div>';
  }
  var nCt=finContasEscopo().length, txtTr=(t.trIn||t.trOut)?'Enviadas '+sv(t.trOut)+' · recebidas '+sv(t.trIn)+'.'+((nCt>1&&Math.round(t.trIn*100)===Math.round(t.trOut*100))?' Entre as contas marcadas, elas se anulam.':''):'Nenhuma transferência no período.';
  return aviso+'<div class="fin-kpis">'+
    '<div class="mc" tabindex="0"><div class="ml">Saldo inicial</div><div class="mv">'+fmt(t.ab)+'</div>'+dica(rng.de?'No início de '+fmtDate(rng.de)+'.':'Saldo de abertura das contas.')+'</div>'+
    filtro('entrada','green','Entradas',fmt(t.ent),'Tudo o que entrou no período, sem as transferências.')+
    filtro('saida','red','Saídas',fmt(t.sai),'Tudo o que saiu no período, sem as transferências.')+
    filtro('transferencia','blue','Transferências',finFmtSinal(t.tr),txtTr)+
    '<div class="mc gold hero" tabindex="0"><div class="ml">Saldo final</div><div class="mv gold">'+fmt(t.fin)+'</div>'+dica((fimK===hojeK?'Até hoje, ':'No fim de ')+fmtDate(fimK)+'.')+'</div>'+
  '</div>';
}
/* O que mostrar acima do formulário: o saldo atual da conta e o último lançamento dela. */
/* O lançamento mais recente (o último que entrou, pela ordem de gravação) entre as contas dadas. */
function finUltimoDe(contas){
  var ids={}, melhor=null;
  contas.forEach(function(c){ ids[c.id]=true; });
  (S.financeiro||[]).forEach(function(f){
    if(!ids[f.contaId]) return;
    var k=f.seq||((f.createdAt&&f.createdAt.seconds)||0)*1000;
    if(!melhor||k>melhor.k) melhor={f:f,k:k};
  });
  return melhor&&melhor.f;
}
/* Faixa de contexto do formulário: a conta, o saldo atual e o saldo depois deste lançamento (atualiza enquanto se digita). */
function finFormCtxHtml(contaId,tipo,sentido,valor){
  var c=contaId?finCadById('contas',contaId):null, cs=(c?[c]:finContasEscopo()).filter(function(x){ return x && !finExterna(x); });
  if(!cs.length) return '';
  var hoje=todayStr(), saldo=0, tem=false;
  cs.forEach(function(x){ if(hoje>=finContaDataIni(x)){ saldo+=finSaldoConta(x,hoje); tem=true; } });
  saldo=Math.round(saldo*100)/100;
  var nome=cs.length===1?cs[0].nome:cs.length+' contas marcadas';
  function sg(v){ return v<0?'− '+fmt(-v):fmt(v); }   /* negativo como no resto do sistema: "− R$ 1.234,56" */
  var h='<span class="cn">'+esc(nome)+' · saldo atual</span> <b class="sd'+(saldo<0?' neg':'')+'">'+(tem?sg(saldo):'—')+'</b>';
  var sinal=tipo==='entrada'?1:(tipo==='saida'?-1:(sentido==='entrada'?1:-1));
  if(c && tem && valor>0){ var dep=Math.round((saldo+sinal*valor)*100)/100;
    h+=' <span class="seta">→ depois deste</span> <b class="dep'+(dep<0?' neg':'')+'">'+sg(dep)+'</b>'; }
  /* o último lançamento da conta selecionada */
  var ult='';
  if(c){
    var f=finUltimoDe([c]);
    if(!f) ult='Último lançamento: <b>nenhum ainda</b>';
    else{
      var trf=finEhTransferencia(f), cls=trf?'':(finSinal(f)>0?'ent':'sai');
      var quando=f.data===hoje?'hoje':(f.data===finDiaMais(hoje,-1)?'ontem':fmtDate(f.data));
      ult='Último lançamento: <b>'+esc(f.descricao||finNatNome(f)||'Lançamento')+'</b> · <span class="v '+cls+'">'+(trf&&f.sentido!=='entrada'?'− ':'')+fmt(Math.abs(Number(f.valor)||0))+'</span> · '+quando;
    }
  }
  return '<span class="fin-ctx-a">'+h+'</span>'+(ult?'<span class="fin-ctx-b">'+ult+'</span>':'');
}
function finFormCtx(){
  var box=document.getElementById('fin-ctx'); if(!box) return;
  function v(id){ var e=document.getElementById(id); return e?e.value:''; }
  var val=finParseVal(v('fin-valor'));
  box.innerHTML=finFormCtxHtml(v('fin-conta'),v('fin-tipo'),v('fin-sentido'),(val&&isFinite(val))?Math.abs(val):0);
}
/* O texto da opção que cria a outra ponta junto com esta. */
function finParTexto(sentido,contraId){
  var n=contraId?finCadNome('contas',contraId):'';
  return 'Registrar também a transferência '+(sentido==='entrada'?'enviada':'recebida')+' na '+esc(n)+' <span class="sub">(cria os dois lançamentos, ligados: alterar ou excluir um altera o outro)</span>';
}
/* Enviada ou Recebida: troca o botão, o rótulo da outra conta e o texto da opção de registrar a outra ponta. */
function finSentido(s){
  var h=document.getElementById('fin-sentido'); if(h) h.value=s;
  ['saida','entrada'].forEach(function(k){ var b=document.getElementById('fin-sent-'+k); if(b){ b.className=(k===s?'on':''); b.setAttribute('aria-checked',k===s?'true':'false'); } });
  var lb=document.getElementById('lb-fin-outra'); if(lb) lb.textContent=s==='entrada'?'Da conta (opcional)':'Para a conta (opcional)';
  finOutraMudou(); finErroEm('fin-sentido',''); finFormCtx();
}
/* Ao trocar a conta de origem, a lista da outra conta deixa de oferecer a nova origem (e solta a escolha se ela coincidir). */
function finOutraAtualiza(){
  var o=document.getElementById('fin-outra'), c=document.getElementById('fin-conta'); if(!o||!c) return;
  var atual=o.value===c.value?'':o.value;
  o.innerHTML=finOptsConta(atual,c.value,'outra'); o.value=atual;
  var t=document.getElementById('cbt-fin-outra'), op=o.options[o.selectedIndex];
  if(t){ t.textContent=finCbTxtCurto('fin-outra',op?op.textContent:''); if(t.classList){ if(!atual) t.classList.add('ph'); else t.classList.remove('ph'); } }
  finOutraMudou();
}
function finOutraMudou(){
  var o=document.getElementById('fin-outra'), box=document.getElementById('fin-par-box'), h=document.getElementById('fin-sentido'); if(!box) return;
  var id=o?o.value:''; box.style.display=id?'':'none';
  var tx=document.getElementById('fin-par-txt'); if(tx&&id) tx.innerHTML=finParTexto(h?h.value:'saida',id);
}
/* Com estorno (o lançamento estornado ou o próprio estorno), valor, conta e categoria ficam travados: os dois precisam continuar se anulando. */
function finFormHtml(){
  var h=_finFormHtmlBase(), ed=_finEdit?(S.financeiro||[]).find(function(f){ return f.id===_finEdit; }):null;
  if(!ed || !(ed.estornoDe||finEstornoDe(ed.id))) return h;
  ['fin-valor','fin-conta','fin-nat'].forEach(function(id){ h=h.replace('id="'+id+'"','id="'+id+'" disabled title="Travado: este lançamento tem estorno"'); });
  var nota='<div class="fin-trava" role="note">'+(ed.estornoDe?'Este é um estorno.':'Este lançamento foi estornado.')+' Valor, conta e categoria ficam travados para os dois continuarem se anulando. Para mudar, exclua'+(ed.estornoDe?' este estorno':' o estorno')+', ajuste e estorne de novo.</div>';
  var k=h.indexOf('<div class="fin-fg12"'); if(k<0) k=h.indexOf('<label');
  return k>0?h.slice(0,k)+nota+h.slice(k):h+nota;
}
function _finFormHtmlBase(){
  if(!_finNovo && !_finEdit) return '';
  var ed=_finEdit?(S.financeiro||[]).find(function(f){ return f.id===_finEdit; }):null;
  var cl=(!ed&&_finClone&&_finClone.tipo===_finNovo)?_finClone:null;   /* duplicando: os campos vêm do lançamento copiado */
  var tp=(!ed&&!cl&&_finTroca&&_finTroca.tipo===_finNovo)?_finTroca:null;   /* trocou o tipo no seletor: mantém o que já foi digitado */
  var bs=ed||cl||tp;
  var tipo=ed?ed.tipo:_finNovo, tr=tipo==='transferencia', u=_finUltimo||{};
  var sentido=tr?(bs&&bs.sentido?bs.sentido:(u.sentido||'saida')):'', contraSel=tr?(bs?(bs.contraparteId||''):(u.contraparteId||'')):'';
  var escopo=finContasEscopo();
  var contaSel=bs&&bs.contaId?bs.contaId:(escopo.length===1?escopo[0].id:(u.contaId&&escopo.some(function(c){return c.id===u.contaId;})?u.contaId:''));
  var nomeTipo={entrada:'entrada',saida:'saída',transferencia:'transferência'}[tipo];
  var titulo=ed?'Alterar '+nomeTipo:'Nova '+nomeTipo+(cl?' (cópia)':'');
  var nv=bs?Number(bs.valor):NaN, valor=(bs&&bs.valor!==''&&isFinite(nv))?Math.abs(nv).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}):'';
  var dataSel=ed?ed.data:(tp&&tp.data?tp.data:(cl?todayStr():(u.data||todayStr())));
  function fc(rot,ctrl,id){
    return '<div class="fg"><label for="'+id+'">'+rot+'</label>'+ctrl+'<div class="fin-err" id="err-'+id+'" role="alert"></div></div>';
  }
  /* tipo: seletor no topo; na alteração fica travado (trocar o tipo de um lançamento salvo quebraria estornos e pares de transferência) */
  var tipos='<div class="fin-tipos" role="radiogroup" aria-label="Tipo do lançamento">'+['entrada','saida','transferencia'].map(function(k){
    var on=k===tipo, rot={entrada:'Entrada',saida:'Saída',transferencia:'Transferência'}[k];
    return '<button type="button" role="radio" class="'+(on?'on':'')+'" aria-checked="'+on+'"'+(ed&&!on?' disabled title="O tipo de um lançamento salvo não muda"':'')+(ed?'':' onclick="finTrocaTipo(\''+k+'\')"')+'>'+rot+'</button>';
  }).join('')+'</div>';
  /* duas linhas, larguras pelo conteúdo: Valor · Descrição · Categoria (ou a outra conta) / Conta · Data · Observação */
  var terceiro=tr?finFcb(sentido==='entrada'?'Da conta (opcional)':'Para a conta (opcional)',finOptsConta(contraSel===contaSel?'':contraSel,contaSel,'outra'),'fin-outra','finOutraMudou()')
                 :finFcb('Categoria *',finOptsCategoria(tipo,bs?bs.categoriaId:''),'fin-nat');
  var nDesc=bs&&bs.descricao?bs.descricao.length:0;
  var clsTipo={entrada:'t-entrada',saida:'t-saida',transferencia:'t-transferencia'}[tipo];   /* escritas por extenso para o estilo não ser considerado sem uso */
  var ctx=ed?'':'<div class="fin-ctx" id="fin-ctx">'+finFormCtxHtml(contaSel,tipo,sentido,bs?Math.abs(Number(bs.valor)||0):0)+'</div>';
  return '<div class="card fin-formc '+clsTipo+'" id="fin-form" role="region" aria-label="'+titulo+'">'+
    '<div class="fin-fh"><div class="fin-ft">'+(ed?'<h2>Alterar lançamento</h2>':'')+tipos+(cl?'<span class="fin-copia">cópia</span>':'')+'</div>'+
      '<button type="button" class="fin-fx" aria-label="Fechar sem salvar" title="Fechar (Esc)" onclick="finPedeCancelar()">×</button></div>'+
    '<input type="hidden" id="fin-tipo" value="'+tipo+'"/>'+ctx+
    (tr?'<div class="fin-sent" role="radiogroup" aria-label="Sentido da transferência">'+
      '<button type="button" role="radio" id="fin-sent-saida" class="'+(sentido==='saida'?'on':'')+'" aria-checked="'+(sentido==='saida')+'" onclick="finSentido(\'saida\')">Enviada</button>'+
      '<button type="button" role="radio" id="fin-sent-entrada" class="'+(sentido==='entrada'?'on':'')+'" aria-checked="'+(sentido==='entrada')+'" onclick="finSentido(\'entrada\')">Recebida</button></div>'+
      '<input type="hidden" id="fin-sentido" value="'+sentido+'"/><div class="fin-err" id="err-fin-sentido" role="alert"></div>':'')+
    '<div class="fin-fg12">'+
      '<div class="fin-c2">'+fc('Valor (R$) *','<input type="text" inputmode="decimal" id="fin-valor" value="'+esc(valor)+'" placeholder="0,00" autocomplete="off" onfocus="this.select()" oninput="finValorEntrada(this);finFormCtx()" onblur="finValorBlur(\'fin-valor\')"/>','fin-valor')+'</div>'+
      '<div class="fin-c5">'+fc('Descrição','<input type="text" id="fin-desc" value="'+esc(bs?(bs.descricao||''):'')+'" placeholder="Opcional" maxlength="'+FIN_DESC_MAX+'" oninput="finDescEntrada(this)" autocomplete="off"/>'+
        '<div class="fin-cont" id="cont-fin-desc"'+(nDesc>=FIN_DESC_AVISO?'':' style="display:none"')+'>'+nDesc+'/'+FIN_DESC_MAX+'</div>','fin-desc')+'</div>'+
      '<div class="fin-c5">'+terceiro+'</div>'+
      '<div class="fin-c3">'+finFcb('Conta *',finOptsConta(contaSel,'','origem'),'fin-conta',tr?'finFormCtx();finOutraAtualiza()':'finFormCtx()')+'</div>'+
      '<div class="fin-c5"><div class="fg"><label for="dpt-fin-data">Data *</label>'+finDp('fin-data',dataSel,{oninput:'finDataAviso()',onchange:'finDataAviso()',atalhos:'dentro',rotulo:'Data'})+'<div class="fin-aviso" id="avi-fin-data" role="status"></div><div class="fin-err" id="err-fin-data" role="alert"></div></div></div>'+
      '<div class="fin-c4">'+fc('Observação','<input type="text" id="fin-obs" maxlength="300" value="'+esc(bs?(bs.obs||''):'')+'" placeholder="Opcional"/>','fin-obs')+'</div>'+
    '</div>'+
    ((tr&&ed&&finParDe(ed))?'<div class="fin-par" style="cursor:default">A outra ponta desta transferência, na '+esc(finCadNome('contas',finParDe(ed).contaId))+', é alterada junto.</div>':'')+
    ((tr&&!ed)?'<label class="fin-par" id="fin-par-box"'+(contraSel?'':' style="display:none"')+'><input type="checkbox" id="fin-par" checked/><span id="fin-par-txt">'+finParTexto(sentido,contraSel)+'</span></label>':'')+
    '<div class="fin-linb">'+
      '<button class="btn bp" id="fin-salvar" type="button" onclick="addFin(false)">'+(ed?'Salvar alteração':'Salvar')+'</button>'+
      (ed?'':'<button class="btn fin-b2" onclick="addFin(true)" type="button">Salvar e novo</button>')+
      '<button type="button" class="fin-cancelar" onclick="finPedeCancelar()">Cancelar</button>'+
      '<span class="fin-dica">* obrigatório · Enter '+(ed?'salva':'salva e abre um novo')+' · Esc cancela</span>'+
    '</div>'+
    '<div class="fin-err" id="err-fin-salvar" role="alert" style="margin-top:8px"></div></div>';
}
/* Trocar o tipo no seletor do topo: o formulário muda, e valor, descrição, conta, data e observação continuam. */
var _finTroca=null, FIN_DESC_AVISO=45;
function finTrocaTipo(novo){
  if(_finEdit || !_finNovo || novo===_finNovo) return;
  var l=finLerForm();
  _finTroca={tipo:novo,valor:(isFinite(l.valor)&&l.valor)?l.valor:'',descricao:l.descricao||'',contaId:l.contaId||'',data:l.data||'',obs:l.obs||'',categoriaId:'',sentido:'',contraparteId:''};
  var ini=_finFormIni; _finNovo=novo; _finClone=null; navigate('financeiro'); _finFormIni=ini;
  var v=document.getElementById('fin-valor'); if(v&&v.focus) v.focus();
}
/* Ícones das ações da linha (traço fino, herdam a cor do botão). */
var FIN_IC=(function(){
  function s(p){ return '<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+p+'</svg>'; }
  return {
    obs:s('<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>'),
    alt:s('<path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>'),
    fer:s('<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M16 3v4M8 3v4M4 11h16"/><path d="M12 13.6l1.1 2.2 2.4.35-1.75 1.7.4 2.4-2.15-1.13-2.15 1.13.4-2.4-1.75-1.7 2.4-.35z"/>'),
    ferX:s('<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M16 3v4M8 3v4M4 11h16"/><path d="M10 14l4 4M14 14l-4 4"/>'),
    copia:s('<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>'),
    cal:s('<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M16 3v4M8 3v4M4 11h16M8 15h2M12 15h2"/>'),
    mais:s('<circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/>'),
    exc:s('<polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>')
  };
})();
/* Identificação do lançamento nos diálogos: a descrição em destaque, e embaixo valor, data e categoria. */
function finIdentLanc(f){
  return '<strong style="display:block;overflow-wrap:anywhere">'+esc(f.descricao||f.categoria||'Lançamento')+'</strong>'+
    '<span style="display:block;color:var(--mt);font-size:12px;margin-top:2px">'+fmt(f.valor)+' · '+fmtDate(f.data)+(f.descricao&&f.categoria?' · '+esc(f.categoria):'')+'</span>';
}
/* Lê a observação do lançamento (ela não aparece na lista, para a linha ter sempre a mesma altura). */
function finVerObs(id){
  var f=(S.financeiro||[]).find(function(x){ return x.id===id; }); if(!f||!f.obs) return;
  finDialogo({
    titulo:'Observação',
    texto:finIdentLanc(f)+'<span style="display:block;white-space:pre-wrap;overflow-wrap:anywhere;margin-top:12px">'+esc(f.obs)+'</span>',
    rotuloOk:'Fechar', semCancelar:true, onOk:function(){}
  });
}
/* O valor da linha numa coluna só: entrada sem sinal (verde), saída com o "−" (vermelho). Transferência fica neutra, sem cor. */
function finValorLinha(L){
  var f=L.f, tr=finEhTransferencia(f), e=Math.round(((L.ent||0)-(L.sai||0))*100)/100;   /* o efeito no saldo: um estorno de saída entra positivo */
  if(e<0) return {t:'− '+fmt(-e),cor:tr?'neutra':'sai'};
  return {t:fmt(e),cor:tr?'neutra':'ent'};
}
function finLinhaHtml(L,unica){
  var f=L.f, v=Number(f.valor)||0, tr=finEhTransferencia(f);
  var origem=finCadNome('contas',f.contaId), outra=f.contraparteId?finCadNome('contas',f.contraparteId):'';
  var sub=[];
  if(tr&&outra) sub.push((f.sentido==='entrada'?'De ':'Para ')+outra);
  var semcp=!!(tr&&f.contraparteId&&!finTemPar(f));
  var marcas='';
  if(_finRecente===f.id) marcas+=' <span class="badge" style="background:var(--vl);color:var(--vt)">novo</span>';
  if(f.obs) marcas+=' <button type="button" class="fin-obsi" onclick="event.stopPropagation();finVerObs(\''+f.id+'\')" title="Observação: '+esc(f.obs)+'" aria-label="Ver a observação">'+FIN_IC.obs+'</button>';
  if(f.estornoDe){ var o0=(S.financeiro||[]).find(function(x){ return x.id===f.estornoDe; }); marcas+=' <span class="fin-est" title="'+(o0?'Estorno do lançamento de '+fmtDate(o0.data):'Estorno')+'">estorno</span>'; }
  else if(finEstornoDe(f.id)) marcas+=' <span class="fin-est on" title="Este lançamento foi estornado em '+fmtDate(finEstornoDe(f.id).data)+'">estornado</span>';
  if(f.origem==='planilha' && f.lote) marcas+=' <button type="button" class="fin-orig" onclick="event.stopPropagation();finVerLote(\''+esc(f.lote)+'\')" title="Veio da '+esc(finLoteRotulo(f.lote))+'. Clique para ver ou desfazer a importação">planilha</button>';
  var vl=finValorLinha(L), cor=vl.cor==='neutra'?'var(--tx)':(vl.cor==='sai'?'var(--red)':'var(--green)');
  var celulas='<td class="r" style="color:'+cor+'">'+vl.t+'</td>';
  /* um menu ⋮ no fim da linha: Alterar, Duplicar, Estornar e Excluir (a linha continua livre para selecionar e copiar) */
  var jaEst=finEstornoDe(f.id), podeEst=!tr && !f.estornoDe && !jaEst;
  var porqueNao=tr?'Transferência não se estorna: registre a transferência de volta':(f.estornoDe?'Este lançamento já é um estorno':(jaEst?'Já estornado em '+fmtDate(jaEst.data):''));
  var acoes=['<details class="fin-more fin-lm" ontoggle="finMenuPos(this)"><summary aria-label="Ações do lançamento" title="Ações">'+FIN_IC.mais+'</summary><div class="fin-more-pop" role="menu">'+
    '<button role="menuitem" onclick="finEditar(\''+f.id+'\')">Alterar</button>'+
    (f.estornoDe?'':'<button role="menuitem" onclick="finClonar(\''+f.id+'\')">Duplicar</button>')+
    '<button role="menuitem"'+(podeEst?' onclick="finEstornar(\''+f.id+'\')"':' disabled title="'+esc(porqueNao)+'"')+'>Estornar</button>'+
    '<button role="menuitem" class="dg" onclick="finExcluir(\''+f.id+'\')">Excluir</button></div></details>'];
  var fundo=(_finRecente===f.id?' style="background:var(--novo)"':'');
  return '<tr'+fundo+' title="'+esc(finTrilha(f))+'">'+
    '<td class="fin-dt">'+fmtDate(f.data)+'</td>'+
    '<td><div class="fin-cel"><span class="fin-ell" title="'+esc(f.descricao||'')+'">'+(f.descricao?esc(f.descricao):'<span style="color:var(--mt)">—</span>')+'</span>'+marcas+'</div>'+
      ((sub.length||semcp)?'<span class="fin-ell" style="font-size:12px;color:var(--mt)">'+esc(sub.join(' · '))+(semcp?(sub.length?' · ':'')+(finParDiverge(f)?'<span class="fin-semcp" title="A outra ponta existe, mas o valor ou a conta não batem mais">diferente da outra ponta</span>':'<span class="fin-semcp" title="Não achei a outra ponta desta transferência na outra conta">sem contrapartida</span>'):'')+'</span>':'')+'</td>'+
    '<td><span class="fin-ell" title="'+esc(finNatNome(f)||'')+'">'+esc(finNatNome(f)||'—')+'</span></td>'+
    (unica?'':'<td><span class="fin-ell" title="'+esc(origem)+'">'+esc(origem)+'</span></td>')+
    celulas+
    '<td class="r fin-sl"'+(L.saldo<0?' style="color:var(--red)"':'')+'>'+fmt(L.saldo)+'</td>'+
    '<td class="fin-ac">'+acoes.join('')+'</td></tr>';
}

/* Para cada dia da lista: quantas das contas à vista já fecharam o caixa (e quantas com ressalva). */
function finSituacaoDosDias(datas,escopo){
  var m={};
  datas.forEach(function(d){
    if(m[d]) return;
    var r=m[d]={apl:0,fech:0,ress:0,fer:finEhFeriado(d)};
    escopo.forEach(function(c){ if(d<finContaDataIni(c)) return; var g=finCaixaDoDia(c.id,d); if(!g && !finFechExigido(c,d)) return; r.apl++; if(g){ r.fech++; if(g.ressalva) r.ress++; } });
  });
  return m;
}
/* "Fechado", "Ressalva", "Em aberto" (ou "2/4 fechadas" com várias contas); clicar abre o Fechar caixa naquele dia. */
function finSituacaoDiaHtml(r,d){
  if(r&&!r.apl&&r.fer) return '<span class="fin-sit s-fer" title="Dia marcado como feriado: não conta nos avisos de caixa">Feriado</span>';
  if(!r||!r.apl) return '';
  var cls, txt, tit;
  if(r.fech===r.apl && r.ress){ cls='s-ress'; txt=r.apl>1?'Fechadas com ressalva':'Fechado com ressalva'; tit=r.apl>1?'Todas fechadas; '+r.ress+(r.ress===1?' com ressalva':' com ressalva'):'Caixa fechado com ressalva neste dia'; }
  else if(r.fech===r.apl){ cls='s-ok'; txt=r.apl>1?'Fechadas':'Fechado'; tit=r.apl>1?'Todas as contas à vista estão fechadas neste dia':'Caixa fechado neste dia'; }
  else if(r.fech>0){ cls=r.ress?'s-ress':'s-ab'; txt=r.fech+'/'+r.apl+' fechadas'; tit=r.fech+' de '+r.apl+' contas fechadas neste dia'+(r.ress?', '+r.ress+' com ressalva':''); }
  else if(r.fer){ cls='s-fer'; txt='Feriado'; tit='Dia marcado como feriado: não conta nos avisos de caixa'; }
  else { cls='s-ab'; txt='Em aberto'; tit='Caixa ainda não fechado neste dia'; }
  return '<button type="button" class="fin-sit '+cls+'" title="'+esc(tit+' — abrir o Fechar caixa de '+fmtDate(d))+'" onclick="finFecharDia(\''+d+'\')">'+esc(txt)+'</button>';
}
function finFaixaDiaHtml(d,n,r,ncol){
  /* a situação ocupa as duas últimas colunas (Saldo e ações): "Fechadas com ressalva" cabe sem empurrar a tabela */
  return '<tr class="fin-dia"><td colspan="'+(ncol-2)+'">'+finDiaSemana(d)+', '+fmtDate(d)+' <span class="n">· '+n+' lançamento'+(n===1?'':'s')+'</span></td>'+
    '<td class="fin-ac" colspan="2">'+finSituacaoDiaHtml(r,d)+'</td></tr>';
}
/* Da faixa do dia direto para o Fechar caixa daquele dia (na primeira conta à vista ainda não fechada). */
function finFecharDia(d){
  var cs=finContasEscopo().filter(function(c){ return d>=finContaDataIni(c); });
  if(!cs.length) return;
  var alvo=cs.filter(function(c){ return !finCaixaDoDia(c.id,d); })[0]||cs[0];
  finAjustaEmpresaDaConta(alvo.id); _fechConta=alvo.id; finCaixaIrDia(d);
}
/* Larguras das colunas da lista, calculadas a cada desenho e quando a janela muda de tamanho:
   Data, Valor, Saldo e ações ficam com o que precisam; a Conta (se aparecer) com o nome mais longo; a Descrição
   com 60 caracteres e o ícone; a Categoria com o nome mais longo; o espaço que sobra é dividido por igual entre os vãos
   de texto (Data→Descrição e Valor→Saldo ficam curtos e fixos).
   Se não couber, aperta nesta ordem: a folga da Data, a Descrição, a Categoria (o texto quebra a linha, nunca é cortado). */
var FIN_DESC_REF='Compra do crédito — proc. 0009876-54 — Maria Aparecida Souza';
var _finMedidor=null;
function finMedeTexto(txt,ref){
  if(!_finMedidor){ _finMedidor=document.createElement('span'); _finMedidor.style.cssText='position:absolute;left:-9999px;top:0;visibility:hidden;white-space:nowrap'; document.body.appendChild(_finMedidor); }
  /* copia propriedade por propriedade: com algarismos tabulares, o navegador devolve a fonte resumida vazia */
  var cs=getComputedStyle(ref), st=_finMedidor.style;
  st.fontFamily=cs.fontFamily; st.fontSize=cs.fontSize; st.fontWeight=cs.fontWeight; st.fontStyle=cs.fontStyle; st.fontVariantNumeric=cs.fontVariantNumeric; st.fontFeatureSettings=cs.fontFeatureSettings; st.letterSpacing=cs.letterSpacing; st.textTransform=cs.textTransform;
  _finMedidor.textContent=txt; return Math.ceil(_finMedidor.getBoundingClientRect().width);
}
function finAjustaColunas(){
  try{
    if(typeof getComputedStyle!=='function') return;
    var tb=document.querySelector('#fin-lista table.fin-tbl'); if(!tb||!tb.getBoundingClientRect) return;
    var cols=tb.querySelectorAll('col'), ths=tb.querySelectorAll('thead th'); if(!cols.length||cols.length!==ths.length) return;
    var multi=tb.classList.contains('fin-tbl-m'), card=tb.parentElement;
    var W=Math.max(card.clientWidth||0, parseFloat(getComputedStyle(tb).minWidth)||0); if(!W) return;
    var lin=tb.querySelector('tbody tr:not(.fin-dia)'), ref=lin?lin.children[1]:ths[1], refN=lin?lin.children[multi?4:3]:ths[1];
    function pad(i){ var c=lin?lin.children[i]:ths[i]; if(!c) return 28; var s=getComputedStyle(c); return (parseFloat(s.paddingLeft)||0)+(parseFloat(s.paddingRight)||0); }
    function maior(lista,el){ var m=0; lista.forEach(function(x){ var w=finMedeTexto(x,el); if(w>m) m=w; }); return m; }
    var iV=multi?4:3, iS=iV+1;
    var cab=function(i){ return finMedeTexto(ths[i].textContent.trim(),ths[i])+14; };   /* título e a seta da ordem */
    var celulas=function(i){ return [].map.call(tb.querySelectorAll('tbody tr:not(.fin-dia) td:nth-child('+(i+1)+'), tfoot td:nth-child('+(i===iV?2:3)+')'),function(td){ return td.textContent.trim(); }); };
    var dtMin=finMedeTexto('00/00/0000',lin?lin.children[0]:ref)+pad(0), dtIdeal=dtMin+18;
    var vW=Math.max(110,cab(iV),maior(celulas(iV),refN)+pad(iV)), sW=Math.max(110,cab(iS),maior(celulas(iS),lin?lin.children[iS]:refN)+pad(iS));
    var cats=finCad('categorias').map(function(n){ return n.nome; }).concat(['Transferência enviada','Transferência recebida']);
    var catIdeal=Math.min(330,maior(cats,ref)+pad(2)+2), catMin=Math.min(catIdeal,150);
    var conW=multi?Math.min(260,maior(finCad('contas').filter(function(c){ return c.ativo!==false; }).map(function(c){ return c.nome; }),ref)+pad(3)+2):0;
    var descIdeal=finMedeTexto(FIN_DESC_REF,ref)+25+pad(1), descMin=240;
    var acW=44, fixo=vW+sW+acW+conW, dt=dtIdeal, resto=W-fixo-dt;
    if(resto<descIdeal+catIdeal){ dt=dtMin; resto=W-fixo-dt; }
    var desc, cat;
    if(resto>=descIdeal+catIdeal){
      desc=descIdeal; cat=catIdeal; var extra=resto-descIdeal-catIdeal;
      /* sobrando espaço: os vãos Data→Descrição e Valor→Saldo ficam curtos e fixos (~40px); o resto é dividido por igual
         entre os vãos de texto: Descrição→Categoria, (Categoria→Conta) e Categoria/Conta→Valor. */
      var vs=Math.min(12,extra); sW+=vs; extra-=vs;
      var q=extra/(multi?3:2);
      desc+=q; cat+=q; if(multi) conW+=q;
    }
    else{ cat=catIdeal; desc=resto-cat; if(desc<descMin){ desc=descMin; cat=Math.max(catMin,resto-desc); } }
    var w=[dt,desc,cat].concat(multi?[conW]:[]).concat([vW,sW,acW]);
    for(var i=0;i<cols.length;i++) cols[i].style.width=Math.round(w[i])+'px';
  }catch(e){}
}
if(typeof window!=='undefined' && window.addEventListener){
  var _finAjT=null;
  window.addEventListener('resize',function(){ clearTimeout(_finAjT); _finAjT=setTimeout(finAjustaColunas,80); });
  try{ if(document.fonts&&document.fonts.ready) document.fonts.ready.then(function(){ finAjustaColunas(); }); }catch(e){}
}
/* ── Calendário próprio do sistema (substitui o do navegador) ─────────────────────────────
   Um componente só, em três formas: dia, mês e intervalo. Por trás fica um campo escondido com o
   mesmo id de antes, guardando a data (aaaa-mm-dd ou aaaa-mm); quem lê as datas continua igual.
   O campo de dia entende o que se digita ("28", "28/10", "281026", "ontem", "hoje") e as setas ↑↓
   mudam o dia; o calendário abre pelo ícone (ou Alt+↓). */
var _finDp=null;   /* {id, tipo, vis:'aaaa-mm' ou 'aaaa', foco:'aaaa-mm-dd', ini:'' (início do intervalo escolhido)} */
var FIN_MESES_CURTO=['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
var FIN_CAL_SVG='<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>';
function finDpAttrs(o){ return (o.onchange?' onchange="'+o.onchange+'"':'')+(o.oninput?' oninput="'+o.oninput+'"':''); }
function finDpLim(o){ return ' data-min="'+esc(o.min||'')+'" data-max="'+esc(o.max||'')+'"'; }
function finDpAtalhosHtml(id,cls){ return '<div class="fin-dp-at'+cls+'"><button type="button" tabindex="-1" onmousedown="event.preventDefault()" onclick="finDpPoe(\''+id+'\',todayStr())">Hoje</button><button type="button" tabindex="-1" onmousedown="event.preventDefault()" onclick="finDpPoe(\''+id+'\',finDiaMais(todayStr(),-1))">Ontem</button></div>'; }
/* campo de dia */
function finDp(id,val,o){
  o=o||{}; var v=val||'';
  return '<div class="fin-dp'+(o.compacto?' compacto':'')+'" id="dp-'+id+'"'+finDpLim(o)+' data-tipo="dia"'+'>'+
    '<input type="hidden" id="'+id+'" value="'+esc(v)+'"'+finDpAttrs(o)+'/>'+
    '<div class="fin-dp-campo" id="dpc-'+id+'">'+
      '<button type="button" class="fin-dp-ic" tabindex="-1" onmousedown="event.preventDefault()" onclick="finDpAbre(\''+id+'\')" aria-label="Abrir calendário">'+FIN_CAL_SVG+'</button>'+
      '<input type="text" class="fin-dp-txt" id="dpt-'+id+'" value="'+(v?fmtDate(v):'')+'" placeholder="dd/mm/aaaa" inputmode="numeric" autocomplete="off" spellcheck="false" aria-label="'+esc(o.rotulo||'Data')+'"'+(o.labelledby?' aria-labelledby="'+o.labelledby+'"':'')+
        ' onkeydown="finDpTecla(event,\''+id+'\')" onblur="finDpSai(\''+id+'\')" oninput="finDpDigitando(\''+id+'\')" onfocus="if(!_finDp)this.select()"/>'+
      (o.semana!==false?'<span class="fin-dp-sem" id="dpw-'+id+'">'+(v?finDiaSemana(v).toLowerCase():'')+'</span>':'')+
      (o.atalhos==='dentro'?finDpAtalhosHtml(id,' dentro'):'')+
    '</div>'+
    (o.atalhos&&o.atalhos!=='dentro'?finDpAtalhosHtml(id,''):'')+
    '<div class="fin-dp-pop" id="dpp-'+id+'" hidden></div></div>';
}
/* campo de mês */
function finDpMes(id,val,o){
  o=o||{};
  return '<div class="fin-dp compacto mes" id="dp-'+id+'"'+finDpLim(o)+' data-tipo="mes">'+
    '<input type="hidden" id="'+id+'" value="'+esc(val||'')+'"'+finDpAttrs(o)+'/>'+
    '<button type="button" class="fin-dp-campo fin-dp-bt" id="dpc-'+id+'" onclick="finDpAbre(\''+id+'\')" onkeydown="finDpTecla(event,\''+id+'\')" aria-haspopup="dialog" aria-label="'+esc(o.rotulo||'Mês')+': '+(val?finMesLabel(val):'')+'">'+
      '<span class="fin-dp-ic">'+FIN_CAL_SVG+'</span><span class="fin-dp-val" id="dpt-'+id+'">'+(val?finMesLabel(val):'Escolha o mês')+'</span></button>'+
    '<div class="fin-dp-pop" id="dpp-'+id+'" hidden></div></div>';
}
/* campo de intervalo (De–Até), com atalhos */
function finDpFaixaTxt(de,ate){ return (de?fmtDate(de):'')+((de||ate)?' até ':'')+(ate?fmtDate(ate):''); }
/* Lê um intervalo digitado: uma data (vale para um dia só) ou duas, em qualquer ordem.
   Aceita "01/10 a 29/10", "1/10 até 29/10/2026", "01102026 29102026", "01/10-29/10", "ontem a hoje". */
function finDpLeFaixa(txt,ref){
  var s=String(txt||'').toLowerCase().trim(); if(!s) return null;
  var re=/hoje|ontem|amanh[ãa]|\d{1,2}[\/.]\d{1,2}(?:[\/.]\d{2,4})?|\d{1,2}-\d{1,2}-\d{2,4}|\d{4,8}|\d{1,2}/g, m, ps=[];
  while((m=re.exec(s)) && ps.length<3) ps.push(m[0]);
  if(!ps.length || ps.length>2) return null;
  var a=finDpLe(ps[0],ref); if(!a) return null;
  var b=ps[1]?finDpLe(ps[1],a):a; if(!b) return null;
  return a<=b?{de:a,ate:b}:{de:b,ate:a};
}
function finDpFaixa(idDe,idAte,de,ate,o){
  o=o||{};
  return '<div class="fin-dp compacto faixa" id="dp-'+idDe+'"'+finDpLim(o)+' data-tipo="faixa" data-ate="'+idAte+'">'+
    '<input type="hidden" id="'+idDe+'" value="'+esc(de||'')+'"/><input type="hidden" id="'+idAte+'" value="'+esc(ate||'')+'"'+finDpAttrs(o)+'/>'+
    '<div class="fin-dp-campo" id="dpc-'+idDe+'">'+
      '<button type="button" class="fin-dp-ic" tabindex="-1" onmousedown="event.preventDefault()" onclick="finDpAbre(\''+idDe+'\')" aria-label="Abrir calendário">'+FIN_CAL_SVG+'</button>'+
      '<input type="text" class="fin-dp-txt" id="dpt-'+idDe+'" value="'+finDpFaixaTxt(de,ate)+'" placeholder="dd/mm/aaaa até dd/mm/aaaa" autocomplete="off" spellcheck="false" aria-label="Período (de e até)" title="Digite uma data ou duas: 01/10 a 29/10"'+
        ' onkeydown="finDpTecla(event,\''+idDe+'\')" onblur="finDpSai(\''+idDe+'\')" oninput="finDpDigitando(\''+idDe+'\')" onfocus="if(!_finDp)this.select()" onclick="if(!_finDp||_finDp.id!==\''+idDe+'\'){ finDpAbre(\''+idDe+'\'); this.select(); }"/></div>'+   /* clicar abre o calendário com o texto selecionado; digitar fecha e substitui */
    '<div class="fin-dp-pop" id="dpp-'+idDe+'" hidden></div></div>';
}
/* Lê o que foi digitado. ref: data de referência para completar mês e ano. */
function finDpLe(txt,ref){
  var t=String(txt||'').trim().toLowerCase(), h=todayStr(); ref=ref||h;
  if(!t) return '';
  if(t==='hoje') return h; if(t==='ontem') return finDiaMais(h,-1); if(t==='amanhã'||t==='amanha') return finDiaMais(h,1);
  var d,m,y, p=t.split(/[\/.\-\s]+/).filter(Boolean);
  if(p.length===1 && /^\d+$/.test(p[0])){
    var s=p[0];
    if(s.length<=2){ d=+s; m=+ref.slice(5,7); y=+ref.slice(0,4); }
    else if(s.length===4){ d=+s.slice(0,2); m=+s.slice(2,4); y=+ref.slice(0,4); }
    else if(s.length===6){ d=+s.slice(0,2); m=+s.slice(2,4); y=2000+(+s.slice(4,6)); }
    else if(s.length===8){ d=+s.slice(0,2); m=+s.slice(2,4); y=+s.slice(4,8); }
    else return null;
  }else if(p.length>=2 && p.length<=3 && p.every(function(x){ return /^\d+$/.test(x); })){
    d=+p[0]; m=+p[1]; y=p[2]?(+p[2]<100?2000+(+p[2]):+p[2]):+ref.slice(0,4);
  }else return null;
  if(!(y>=1900&&y<=2999&&m>=1&&m<=12&&d>=1&&d<=31)) return null;
  var x=new Date(y,m-1,d); if(x.getMonth()!==m-1) return null;   /* 31/02 não existe */
  return y+'-'+('0'+m).slice(-2)+'-'+('0'+d).slice(-2);
}
function finDpWrap(id){ return document.getElementById('dp-'+id); }
function finDpForaLim(id,iso){ var w=finDpWrap(id); if(!w||!iso) return false; var mn=w.getAttribute('data-min')||'', mx=w.getAttribute('data-max')||''; return (mn&&iso<mn)||(mx&&iso>mx); }
/* Põe a data no campo: guarda, escreve, avisa quem depende dela (as mesmas funções de antes). */
function finDpPoe(id,iso){
  var h=document.getElementById(id), t=document.getElementById('dpt-'+id), w=document.getElementById('dpw-'+id); if(!h) return;
  if(iso && finDpForaLim(id,iso)){ finDpErro(id,'Fora do período permitido.'); return; }
  finDpErro(id,'');
  var mudou=h.value!==iso; h.value=iso||'';
  if(t) t.value=iso?fmtDate(iso):''; if(w) w.textContent=iso?finDiaSemana(iso).toLowerCase():'';
  finDpFecha(false);
  if(mudou){ try{ h.dispatchEvent(new Event('input',{bubbles:true})); h.dispatchEvent(new Event('change',{bubbles:true})); }catch(e){ if(h.onchange) h.onchange(); } }
}
function finDpErro(id,msg){
  if(document.getElementById('err-'+id)){ finErroEm(id,msg); return; }
  var c=document.getElementById('dpc-'+id); if(c&&c.classList) c.classList[msg?'add':'remove']('fin-invalid');
  var w=finDpWrap(id), m=document.getElementById('dpm-'+id);
  if(msg && !m && w){ m=document.createElement('div'); m.className='fin-dp-msg'; m.id='dpm-'+id; m.setAttribute('role','alert'); w.appendChild(m); }
  if(m){ m.textContent=msg?'⚠ '+msg:''; m.style.display=msg?'block':'none'; }
}
/* Ao sair do campo, o que foi digitado vale (ou volta ao que era, com o erro ao lado). */
function finDpSai(id){
  if(_finDp && _finDp.id===id) return;   /* o calendário aberto cuida da escolha */
  var t=document.getElementById('dpt-'+id), h=document.getElementById(id); if(!t||!h) return;
  var w=finDpWrap(id);
  if(w && w.getAttribute('data-tipo')==='faixa'){ finDpSaiFaixa(id); return; }
  var v=finDpLe(t.value,h.value||todayStr());
  if(v===null){ finDpErro(id,'Data não reconhecida. Digite como 28/10/2026.'); return; }
  finDpErro(id,'');   /* data válida: o erro some, mesmo que seja a mesma data de antes */
  if(v!==h.value || t.value!==(v?fmtDate(v):'')) finDpPoe(id,v);
}
function finDpSaiFaixa(id){
  var t=document.getElementById('dpt-'+id), w=finDpWrap(id), he=document.getElementById(id), ha=document.getElementById(w.getAttribute('data-ate'));
  var atual=finDpFaixaTxt(he.value,ha.value); if(t.value===atual){ finDpErro(id,''); return true; }
  var r=finDpLeFaixa(t.value,ha.value||todayStr());
  if(!r){
    /* diz qual data não existe, quando é esse o problema */
    var ruim=(String(t.value).match(/\d{1,2}[\/.]\d{1,2}(?:[\/.]\d{2,4})?|\d{1,2}-\d{1,2}-\d{2,4}|\d{4,8}/g)||[]).filter(function(x){ return finDpLe(x,todayStr())===null; })[0];
    finDpErro(id,ruim?'A data '+ruim+' não existe.':'Não entendi. Digite como 01/10 a 29/10.'); return false;
  }
  if(finDpForaLim(id,r.de)||finDpForaLim(id,r.ate)){ finDpErro(id,'Fora do período permitido (até hoje).'); return false; }
  finDpErro(id,''); finDpPoeFaixa(id,r.de,r.ate,true); return true;
}
/* Começou a digitar com o calendário aberto: fecha o calendário e vale o que for digitado. */
function finDpDigitando(id){ if(_finDp && _finDp.id===id) finDpFecha(false); }
function finDpTecla(e,id){
  var k=e.key, w=finDpWrap(id), tipo=w?w.getAttribute('data-tipo'):'dia', aberto=!!(_finDp&&_finDp.id===id);
  function para(){ if(e.preventDefault) e.preventDefault(); if(e.stopPropagation) e.stopPropagation(); }
  if(aberto){
    if(k==='Escape'){ para(); finDpFecha(true); return; }
    if(_finDp.vista==='anos'){
      var da={ArrowLeft:-1,ArrowRight:1,ArrowUp:-3,ArrowDown:3}[k];
      if(da!==undefined){ para(); var ny=Number(_finDp.vis.slice(0,4))+da; _finDp.vis=tipo==='mes'?String(ny):ny+_finDp.vis.slice(4); if(ny<_finDp.anoBase||ny>_finDp.anoBase+11) _finDp.anoBase=ny-(ny%12); finDpDesenha(); return; }
      if(k==='Enter'){ para(); finDpIrAno(Number(_finDp.vis.slice(0,4))); return; }
    }else if(_finDp.vista==='meses'){
      var dv={ArrowLeft:-1,ArrowRight:1,ArrowUp:-3,ArrowDown:3}[k];
      if(dv!==undefined){ para(); _finDp.vis=finMesSoma(_finDp.vis,dv); finDpDesenha(); return; }
      if(k==='Enter'){ para(); finDpIrMes(_finDp.vis); return; }
    }else if(tipo==='dia'||tipo==='faixa'){
      var dd={ArrowLeft:-1,ArrowRight:1,ArrowUp:-7,ArrowDown:7}[k];
      if(dd!==undefined){ para(); finDpMoveFoco(finDiaMais(_finDp.foco,dd)); return; }
      if(k==='PageUp'||k==='PageDown'){ para(); var f=_finDp.foco, m=finMesSoma(f.slice(0,7),k==='PageUp'?-1:1), ul=+finUltimoDia(m).slice(8); finDpMoveFoco(m+'-'+('0'+Math.min(+f.slice(8),ul)).slice(-2)); return; }
      if(k==='Enter'){ para(); finDpEscolhe(id,_finDp.foco); return; }
    }else if(tipo==='mes'){
      var dm={ArrowLeft:-1,ArrowRight:1,ArrowUp:-3,ArrowDown:3}[k];
      if(dm!==undefined){ para(); _finDp.foco=finMesSoma(_finDp.foco,dm); _finDp.vis=_finDp.foco.slice(0,4); finDpDesenha(); return; }
      if(k==='Enter'){ para(); finDpEscolhe(id,_finDp.foco); return; }
    }
    if(k==='Tab') finDpFecha(false);
    return;
  }
  if(tipo==='faixa'){
    if(k==='Enter'){ para(); finDpSaiFaixa(id); return; }
    if(k==='ArrowDown'&&e.altKey){ para(); finDpAbre(id); return; }
    return;
  }
  if(tipo!=='dia'){ if(k==='ArrowDown'||k==='Enter'||k===' '){ para(); finDpAbre(id); } return; }
  if(k==='ArrowDown'&&e.altKey){ para(); finDpAbre(id); return; }
  if(k==='ArrowUp'||k==='ArrowDown'){   /* sem o calendário aberto, as setas mudam o dia */
    para(); var h=document.getElementById(id), t=document.getElementById('dpt-'+id);
    var base=finDpLe(t.value,h.value||todayStr())||h.value||todayStr(), n=finDiaMais(base,k==='ArrowUp'?1:-1);
    if(!finDpForaLim(id,n)){ finDpPoe(id,n); t.select(); }
    return;
  }
  if(k==='Enter'){   /* confirma o digitado antes de o formulário salvar */
    var t2=document.getElementById('dpt-'+id), h2=document.getElementById(id), v=finDpLe(t2.value,h2.value||todayStr());
    if(v===null){ para(); finDpErro(id,'Data não reconhecida. Digite como 28/10/2026.'); return; }
    finDpErro(id,''); if(v!==h2.value) finDpPoe(id,v);
  }
}
function finDpAbre(id){
  if(_finDp && _finDp.id===id){ finDpFecha(true); return; }
  if(_finDp) finDpFecha(false);
  var w=finDpWrap(id), tipo=w.getAttribute('data-tipo'), h=document.getElementById(id), hoje=todayStr();
  if(tipo==='mes'){ var mv=h.value||hoje.slice(0,7); _finDp={id:id,tipo:'mes',vis:mv.slice(0,4),foco:mv}; }
  else if(tipo==='faixa'){ var ate=document.getElementById(w.getAttribute('data-ate')).value||hoje, de=h.value||ate; _finDp={id:id,tipo:'faixa',vis:ate.slice(0,7),foco:ate,ini:'',de:de,ate:ate}; }
  else{ var v=h.value||finDpLe(document.getElementById('dpt-'+id).value,hoje)||hoje; _finDp={id:id,tipo:'dia',vis:v.slice(0,7),foco:v}; }
  var p=document.getElementById('dpp-'+id); p.hidden=false; finDpDesenha(); finDpPosiciona();
  var c=document.getElementById('dpc-'+id); if(c&&c.setAttribute) c.setAttribute('aria-expanded','true');
  if(tipo==='dia'||tipo==='faixa'){ var t=document.getElementById('dpt-'+id); if(t){ if(document.activeElement!==t) t.focus(); if(t.select) t.select(); } }   /* texto selecionado: digitar substitui */
}
function finDpFecha(foco){
  if(!_finDp) return; var id=_finDp.id, tipo=_finDp.tipo; _finDp=null;
  var p=document.getElementById('dpp-'+id); if(p){ p.hidden=true; p.innerHTML=''; }
  var c=document.getElementById('dpc-'+id); if(c&&c.setAttribute) c.setAttribute('aria-expanded','false');
  if(foco){ var f=(tipo==='dia'||tipo==='faixa')?document.getElementById('dpt-'+id):c; if(f&&f.focus) f.focus(); }
}
/* O calendário abre por cima de tudo (não é cortado pelo cartão) e, sem espaço embaixo, abre para cima. */
function finDpPosiciona(){
  if(!_finDp) return; var p=document.getElementById('dpp-'+_finDp.id), c=document.getElementById('dpc-'+_finDp.id); if(!p||!c||!c.getBoundingClientRect) return;
  var r=c.getBoundingClientRect(), ph=p.offsetHeight||340, pw=p.offsetWidth||300, vh=window.innerHeight, vw=window.innerWidth;
  var top=(r.bottom+6+ph>vh && r.top-6-ph>0)?r.top-6-ph:r.bottom+6, left=Math.max(8,Math.min(r.left,vw-pw-8));
  p.style.position='fixed'; p.style.top=Math.round(top)+'px'; p.style.left=Math.round(left)+'px';
}
function finDpMoveFoco(iso){
  if(!_finDp) return; if(finDpForaLim(_finDp.id,iso)) return;
  _finDp.foco=iso; if(iso.slice(0,7)!==_finDp.vis) _finDp.vis=iso.slice(0,7); finDpDesenha();
}
function finDpPreHtml(id){
  return '<div class="fin-dp-pre">'+[['hoje','Hoje'],['7d','Últimos 7 dias'],['30d','Últimos 30 dias'],['mes','Este mês'],['mesp','Mês passado'],['ano','Este ano'],['tudo','Tudo']].map(function(x){ return '<button type="button" onmousedown="event.preventDefault()" onclick="finDpAtalho(\''+id+'\',\''+x[0]+'\')">'+x[1]+'</button>'; }).join('')+'</div>';
}
/* Trocar de ano ou de mês sem andar mês a mês: o título do calendário abre os meses do ano; o ano abre a grade de anos. */
function finDpVista(v){ if(!_finDp) return; _finDp.vista=v; if(v==='anos'){ var y=Number(_finDp.vis.slice(0,4)); _finDp.anoBase=y-(y%12); } finDpDesenha(); }
function finDpNavAno(d){ if(!_finDp) return; var y=Number(_finDp.vis.slice(0,4))+d; _finDp.vis=_finDp.tipo==='mes'?String(y):y+_finDp.vis.slice(4); finDpDesenha(); }
function finDpNavAnos(d){ if(!_finDp) return; _finDp.anoBase+=d; finDpDesenha(); }
function finDpIrAno(y){ if(!_finDp) return; _finDp.vis=_finDp.tipo==='mes'?String(y):y+'-'+(_finDp.vis.slice(5,7)||'01'); _finDp.vista=_finDp.tipo==='mes'?'':'meses'; finDpDesenha(); }
function finDpIrMes(mm){
  if(!_finDp) return; var f=_finDp.foco||mm+'-01', ul=+finUltimoDia(mm).slice(8);
  _finDp.vis=mm; _finDp.vista=''; _finDp.foco=mm+'-'+('0'+Math.min(+f.slice(8)||1,ul)).slice(-2); finDpDesenha();
}
function finDpNav(d){ if(!_finDp) return; if(_finDp.tipo==='mes') _finDp.vis=String(+_finDp.vis+d); else _finDp.vis=finMesSoma(_finDp.vis,d); finDpDesenha(); }
function finDpEscolhe(id,v){
  if(!_finDp) return;
  if(_finDp.tipo==='mes'){ var w=finDpWrap(id), mn=(w.getAttribute('data-min')||'').slice(0,7), mx=(w.getAttribute('data-max')||'').slice(0,7); if((mn&&v<mn)||(mx&&v>mx)) return; finDpPoeMes(id,v); return; }
  if(_finDp.tipo==='faixa'){
    if(!_finDp.ini){ _finDp.ini=v; _finDp.foco=v; finDpDesenha(); return; }   /* primeiro clique: início; segundo: fim */
    var a=_finDp.ini<v?_finDp.ini:v, b=_finDp.ini<v?v:_finDp.ini; finDpPoeFaixa(id,a,b); return;
  }
  finDpPoe(id,v); var t=document.getElementById('dpt-'+id); if(t&&t.focus) t.focus();
}
function finDpPoeMes(id,v){
  var h=document.getElementById(id), t=document.getElementById('dpt-'+id); var mudou=h.value!==v; h.value=v; if(t) t.textContent=finMesLabel(v);
  finDpFecha(true); if(mudou){ try{ h.dispatchEvent(new Event('change',{bubbles:true})); }catch(e){} }
}
function finDpPoeFaixa(id,a,b,semFoco){
  var w=finDpWrap(id), he=document.getElementById(id), ha=document.getElementById(w.getAttribute('data-ate'));
  he.value=a; ha.value=b; var t=document.getElementById('dpt-'+id); if(t) t.value=finDpFaixaTxt(a,b);
  finDpFecha(!semFoco); try{ ha.dispatchEvent(new Event('change',{bubbles:true})); }catch(e){}
}
/* Atalhos do intervalo */
function finDpAtalho(id,k){
  var h=todayStr(), m=h.slice(0,7), a,b=h;
  if(k==='tudo'){ finDpFecha(false); finPerAtalho('tudo'); return; }
  if(k==='hoje') a=h; else if(k==='7d') a=finDiaMais(h,-6); else if(k==='30d') a=finDiaMais(h,-29);
  else if(k==='mes') a=m+'-01'; else if(k==='mesp'){ var mp=finMesSoma(m,-1); a=mp+'-01'; b=finUltimoDia(mp); }
  else if(k==='ano') a=h.slice(0,4)+'-01-01';
  var w=finDpWrap(id), mn=w.getAttribute('data-min')||''; if(mn&&a<mn) a=mn;
  finDpPoeFaixa(id,a,b);
}
function finDpDesenha(){
  if(!_finDp) return; var s=_finDp, id=s.id, p=document.getElementById('dpp-'+id); if(!p) return;
  var w=finDpWrap(id), mn=w.getAttribute('data-min')||'', mx=w.getAttribute('data-max')||'', hoje=todayStr(), h='';
  /* grade de anos (clicando no ano): 12 anos por página */
  if(s.vista==='anos'){
    var b0=s.anoBase, ya=Number(s.vis.slice(0,4));
    h='<div class="fin-dp-hd"><button type="button" onmousedown="event.preventDefault()" onclick="finDpNavAnos(-12)" aria-label="Anos anteriores"'+(mn&&b0<=+mn.slice(0,4)?' disabled':'')+'>‹</button><strong>'+b0+' – '+(b0+11)+'</strong><button type="button" onmousedown="event.preventDefault()" onclick="finDpNavAnos(12)" aria-label="Próximos anos"'+(mx&&b0+11>=+mx.slice(0,4)?' disabled':'')+'>›</button></div><div class="fin-dp-meses">';
    for(var ai=0;ai<12;ai++){ var yy=b0+ai, offA=(mn&&yy<+mn.slice(0,4))||(mx&&yy>+mx.slice(0,4));
      h+='<button type="button" class="'+(yy===ya?'sel ':'')+(yy===+hoje.slice(0,4)?'hj':'')+'"'+(offA?' disabled':'')+' onmousedown="event.preventDefault()" onclick="finDpIrAno('+yy+')">'+yy+'</button>'; }
    h+='</div>';
    if(s.tipo==='faixa') h='<div class="fin-dp-fx">'+finDpPreHtml(id)+'<div>'+h+'<div class="fin-dp-dica">Escolha o ano.</div></div></div>';
    p.innerHTML=h; return;
  }
  /* grade de meses: no seletor de mês e, nos de dia, ao clicar no título */
  if(s.tipo==='mes' || s.vista==='meses'){
    var y=s.vis.slice(0,4), sel=document.getElementById(id).value, ehMes=s.tipo==='mes', selMes=ehMes?sel:(s.tipo==='faixa'?'':String(sel).slice(0,7)), focoMes=ehMes?s.foco:s.vis;
    h='<div class="fin-dp-hd"><button type="button" onmousedown="event.preventDefault()" onclick="finDpNavAno(-1)" aria-label="Ano anterior"'+(mn&&y<=mn.slice(0,4)?' disabled':'')+'>‹</button>'+
      '<button type="button" class="fin-dp-tit" onmousedown="event.preventDefault()" onclick="finDpVista(\'anos\')" aria-label="Escolher o ano">'+y+'<span class="fin-dp-car" aria-hidden="true">▾</span></button>'+
      '<button type="button" onmousedown="event.preventDefault()" onclick="finDpNavAno(1)" aria-label="Próximo ano"'+(mx&&y>=mx.slice(0,4)?' disabled':'')+'>›</button></div><div class="fin-dp-meses">';
    for(var i=1;i<=12;i++){ var mm=y+'-'+('0'+i).slice(-2), off=(mn&&mm<mn.slice(0,7))||(mx&&mm>mx.slice(0,7));
      h+='<button type="button" class="'+(mm===selMes?'sel ':'')+(mm===focoMes?'foco ':'')+(mm===hoje.slice(0,7)?'hj':'')+'"'+(off?' disabled':'')+' onmousedown="event.preventDefault()" onclick="'+(ehMes?'finDpEscolhe(\''+id+'\',\''+mm+'\')':'finDpIrMes(\''+mm+'\')')+'">'+FIN_MESES_CURTO[i-1]+'</button>'; }
    h+='</div>';
    if(s.tipo==='faixa') h='<div class="fin-dp-fx">'+finDpPreHtml(id)+'<div>'+h+'<div class="fin-dp-dica">Escolha o mês.</div></div></div>';
    p.innerHTML=h; return;
  }
  var vis=s.vis, d1=new Date(vis+'-01T12:00:00'), ini=d1.getDay(), ul=+finUltimoDia(vis).slice(8), sel1=document.getElementById(id).value;
  var faixaDe=s.tipo==='faixa'?(s.ini||s.de):'', faixaAte=s.tipo==='faixa'?(s.ini?'':s.ate):'';
  h='<div class="fin-dp-hd"><button type="button" onmousedown="event.preventDefault()" onclick="finDpNav(-1)" aria-label="Mês anterior"'+(mn&&vis<=mn.slice(0,7)?' disabled':'')+'>‹</button>'+
    '<button type="button" class="fin-dp-tit" onmousedown="event.preventDefault()" onclick="finDpVista(\'meses\')" aria-label="Escolher o mês e o ano">'+finMesLabel(vis)+'<span class="fin-dp-car" aria-hidden="true">▾</span></button>'+
    '<button type="button" onmousedown="event.preventDefault()" onclick="finDpNav(1)" aria-label="Próximo mês"'+(mx&&vis>=mx.slice(0,7)?' disabled':'')+'>›</button></div>';
  h+='<div class="fin-dp-gr" role="grid">'+['D','S','T','Q','Q','S','S'].map(function(x){ return '<span class="sem">'+x+'</span>'; }).join('');
  for(var b=0;b<ini;b++) h+='<span></span>';
  for(var d=1;d<=ul;d++){
    var iso=vis+'-'+('0'+d).slice(-2), wd=(ini+d-1)%7, off2=(mn&&iso<mn)||(mx&&iso>mx), cls=[];
    if(wd===0||wd===6) cls.push('fds'); if(iso===hoje) cls.push('hj'); if(iso===s.foco) cls.push('foco');
    if(s.tipo==='dia'&&iso===sel1) cls.push('sel');
    if(s.tipo==='faixa'){ if(iso===faixaDe||iso===faixaAte) cls.push('sel'); if(faixaDe&&faixaAte&&iso>faixaDe&&iso<faixaAte) cls.push('meio'); }
    h+='<button type="button" class="'+cls.join(' ')+'"'+(off2?' disabled':'')+' onmousedown="event.preventDefault()" onclick="finDpEscolhe(\''+id+'\',\''+iso+'\')" aria-label="'+fmtDate(iso)+'">'+d+'</button>';
  }
  h+='</div>';
  if(s.tipo==='faixa'){
    h='<div class="fin-dp-fx">'+finDpPreHtml(id)+'<div>'+h+
      '<div class="fin-dp-dica">'+(s.ini?'Agora clique no último dia.':'Clique no primeiro dia e depois no último.')+'</div></div></div>';
  }
  p.innerHTML=h;
}
if(typeof document!=='undefined' && document.addEventListener){
  document.addEventListener('mousedown',function(e){ if(!_finDp) return; var w=finDpWrap(_finDp.id), p=document.getElementById('dpp-'+_finDp.id); if(w&&w.contains&&!w.contains(e.target)&&!(p&&p.contains&&p.contains(e.target))) finDpFecha(false); });
  document.addEventListener('scroll',function(){ if(_finDp) finDpPosiciona(); },true);
  window.addEventListener('resize',function(){ if(_finDp) finDpPosiciona(); });
}

/* Ordem da lista pelo cabeçalho: 1º clique crescente, 2º decrescente, 3º volta à ordem normal (por data). */
var _finOrd={col:'',dir:1};
function finOrdenar(col){
  if(_finOrd.col!==col) _finOrd={col:col,dir:1};
  else if(_finOrd.dir===1) _finOrd={col:col,dir:-1};
  else _finOrd={col:'',dir:1};
  var l=document.getElementById('fin-lista'); if(l){ l.innerHTML=finListaHtml(); finAjustaColunas(); }
}
function finOrdenaLinhas(vis){
  var c=_finOrd.col, d=_finOrd.dir; if(!c || (c==='data'&&d===1)) return vis;
  var chave={
    data:function(L){ return L.f.data; },
    desc:function(L){ return String(L.f.descricao||'').toLocaleLowerCase('pt-BR'); },
    cat:function(L){ return String(finNatNome(L.f)||'').toLocaleLowerCase('pt-BR'); },
    conta:function(L){ return String(finCadNome('contas',L.f.contaId)||'').toLocaleLowerCase('pt-BR'); },
    valor:function(L){ return (L.ent||0)-(L.sai||0); },
    saldo:function(L){ return L.saldo; }
  }[c];
  if(!chave) return vis;
  return vis.map(function(L,i){ return {L:L,i:i,k:chave(L)}; }).sort(function(a,b){
    var r=(typeof a.k==='number')?(a.k-b.k):String(a.k).localeCompare(String(b.k),'pt-BR');
    if(c==='data') r=0;   /* por data decrescente: inverte a ordem normal (o dia e a ordem dos lançamentos) */
    return (r!==0?r*d:(c==='data'?(b.i-a.i):(a.i-b.i)));
  }).map(function(o){ return o.L; });
}
function finThOrd(col,rot,cls,tit){
  var on=_finOrd.col===col, dir=on?_finOrd.dir:0;
  var seta=on?'<span class="seta" aria-hidden="true">'+(dir===1?'▲':'▼')+'</span>':'';
  return '<th'+(cls?' class="'+cls+'"':'')+' aria-sort="'+(on?(dir===1?'ascending':'descending'):'none')+'"'+(tit?' title="'+tit+'"':'')+'>'+
    '<button type="button" class="fin-ord'+(on?' on':'')+'" onclick="finOrdenar(\''+col+'\')" title="Ordenar por '+rot.toLowerCase()+'">'+rot+seta+'</button></th>';
}
function finListaHtml(){
  var rng=finPeriodoRange(), escopo=finContasEscopo(), unica=escopo.length===1?escopo[0]:null;
  var todas=finLinhasEscopo(), vis=todas.filter(finLinhaPassa), tot=finTotaisPeriodo();
  var filtrando=!!((_finF.tipo&&_finF.tipo!=='todos')||_finF.categoriaId||_finF.q);
  var ncol=unica?6:7, corpo='', porDia={}, dia='', dias=finSituacaoDosDias(vis.map(function(L){ return L.f.data; }),escopo);
  /* colunas: Data · Descrição · Categoria · [Conta] · Entrada · Saída · Saldo após o lançamento · ações. A faixa de cada dia diz o dia, quantos lançamentos e a situação do fechamento */
  vis.forEach(function(L){ porDia[L.f.data]=(porDia[L.f.data]||0)+1; });
  /* ordem escolhida no cabeçalho; por data (a normal) mantém as faixas dos dias, nas outras a lista fica corrida */
  var porData=!_finOrd.col||_finOrd.col==='data', ord=finOrdenaLinhas(vis), comFaixas=porData&&_finAgrupar;
  ord.forEach(function(L){
    var d=L.f.data;
    if(comFaixas && d!==dia){ corpo+=finFaixaDiaHtml(d,porDia[d],dias[d],ncol); dia=d; corpo+=finLinhaHtml(L,unica); return; }
    var h=finLinhaHtml(L,unica);
    /* sem as faixas: a primeira linha de cada dia ganha uma divisória um pouco mais marcada */
    if(porData && !comFaixas && dia && d!==dia) h=h.replace(/^<tr/,'<tr class="nd"');
    dia=d; corpo+=h;
  });
  if(!vis.length) corpo+='<tr><td colspan="'+ncol+'" class="empty">'+(filtrando
    ? 'Nenhum lançamento com esses filtros. <a href="#" onclick="finLimparFiltros();return false" style="color:var(--blue)">Limpar filtros</a>'
    : 'Nenhum lançamento neste período. Registre o primeiro: '+
      '<a href="#" onclick="finNovo(\'entrada\');return false" style="color:var(--green);font-weight:600">+ Entrada</a> · '+
      '<a href="#" onclick="finNovo(\'saida\');return false" style="color:var(--red);font-weight:600">+ Saída</a>')+'</td></tr>';
  var ent=0,sai=0; vis.forEach(function(L){ ent+=L.ent; sai+=L.sai; });
  var cab='<tr>'+finThOrd('data','Data','fin-dt','')+finThOrd('desc','Descrição','','')+finThOrd('cat','Categoria','','')+(unica?'':finThOrd('conta','Conta','',''))+
    finThOrd('valor','Valor','r','Entrada sem sinal; saída com o sinal de menos')+finThOrd('saldo','Saldo','r','Saldo depois deste lançamento')+'<th></th></tr>';
  /* Valores e ações com largura fixa (o Saldo e os botões ficam colados à direita); Categoria (e Conta) em %;
     a Descrição, sem largura, ocupa o que sobrar. */
  var larg=unica?['100px','','18%','160px','150px','44px']:['100px','','13%','13%','160px','150px','44px'];
  var nomesCol=unica?['c-dt','c-desc','c-cat','','','']:['c-dt','c-desc','c-cat','c-conta','','',''];
  var cols='<colgroup>'+larg.map(function(w,i){ var c=nomesCol[i]?' class="'+nomesCol[i]+'"':''; return w?'<col'+c+' style="width:'+w+'">':'<col'+c+'>'; }).join('')+'</colgroup>';
  /* linha de total no fim da tabela: a soma da coluna Valor (o que está na tela) e o saldo final do período */
  var liq=Math.round((ent-sai)*100)/100;
  var total='<tfoot><tr class="fin-tot"><td colspan="'+(ncol-3)+'"><strong>Total do período</strong> <span class="n">· '+(filtrando?vis.length+' de '+todas.length+' lançamentos, com filtros':todas.length+(todas.length===1?' lançamento':' lançamentos'))+'</span></td>'+
    '<td class="r" title="Entradas '+fmt(ent)+' · Saídas '+fmt(sai)+'"><strong style="color:'+(liq<0?'var(--red)':(liq>0?'var(--green)':'var(--tx)'))+'">'+(liq<0?'− '+fmt(-liq):fmt(liq))+'</strong></td>'+
    '<td class="r" title="'+(filtrando?'Saldo final do período (não muda com os filtros)':'Saldo final do período')+'"><strong'+(tot.fin<0?' style="color:var(--red)"':'')+'>'+fmt(tot.fin)+'</strong></td><td></td></tr></tfoot>';
  return '<div class="card fin-tw'+(unica?'':' m')+'"><table class="tbl fin-tbl'+(unica?'':' fin-tbl-m')+(comFaixas?' agr':'')+'">'+cols+'<thead>'+cab+'</thead><tbody>'+corpo+'</tbody>'+total+'</table></div>';
}

function finViewLancamentos(){
  /* modo lançamento: enquanto o formulário está aberto, ele é a tela; o resto (contas, período, resumo, filtros e lista) volta ao fechar */
  if(_finNovo||_finEdit) return finFormHtml();
  /* período todo antes do início do sistema: uma mensagem só, sem saldos zerados nem lista vazia */
  var rng0=finPeriodoRange(), ini0=finInicioSistema();
  if(rng0.ate && rng0.ate<ini0){
    return finChipsContas()+finPeriodoHtml()+
      '<div class="card" style="text-align:center;padding:40px 16px"><div style="font-size:15px;font-weight:600;margin-bottom:6px">O sistema começa em '+fmtDate(ini0)+'</div>'+
      '<div style="color:var(--mt);font-size:13px;margin-bottom:16px">Não há lançamentos antes dessa data.</div>'+
      '<button class="btn bp" onclick="finPerAtalho(\'hoje\')">Ir para hoje</button></div>';
  }
  var filtros=
  '<div class="filter-bar no-print fin-filtros" style="padding:10px 12px;align-items:center">'+
    '<div class="fg" style="max-width:150px"><select id="fin-tf" onchange="filterFin()" aria-label="Mostrar">'+
      ['todos','entrada','saida','transferencia'].map(function(t){
        var lb={todos:'Tudo',entrada:'Entradas',saida:'Saídas',transferencia:'Transferências'}[t];
        return '<option value="'+t+'"'+(_finF.tipo===t?' selected':'')+'>'+lb+'</option>';
      }).join('')+'</select></div>'+
    '<div class="fg" style="max-width:220px">'+finCbHtml('fin-nf','<option value="">Todas as categorias</option>'+
      finCad('categorias').map(function(n){return '<option value="'+n.id+'"'+(_finF.categoriaId===n.id?' selected':'')+'>'+esc(n.nome)+'</option>';}).join(''),{onchange:'filterFin()',rotulo:'Categoria',neutro:true})+'</div>'+
    '<input class="search-input" id="fin-q" value="'+esc(_finF.q)+'" placeholder="Buscar por descrição, categoria ou valor..." oninput="filterFin()"/>'+
    '<label class="fin-agr" title="Mostrar uma faixa por dia, com quantos lançamentos e se o caixa foi fechado"><input type="checkbox" id="fin-agr"'+(_finAgrupar?' checked':'')+' onchange="finAgruparDias(this.checked)"/>Agrupar por dia</label>'+
    '<button class="btn fin-nv" onclick="finImportarAbrir()" title="Importar lançamentos de uma planilha Excel (.xlsx)">Importar</button>'+
    '<input type="file" id="fin-arq" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" style="display:none" onchange="finImportarArquivo(this)" aria-label="Planilha para importar"/>'+
    '<details class="fin-exp" id="fin-exp"><summary class="btn fin-nv" title="Baixar ou imprimir os lançamentos">Exportar</summary><div class="fin-menu">'+
      '<button onclick="finExportarExcel(true)">Excel — lançamentos da tela</button>'+
      '<button onclick="finExportarExcel(false)">Excel — modelo em branco</button>'+
      '<button onclick="finExportarPdf()">PDF — lançamentos da tela</button>'+
      '<button onclick="finImprimir()">Imprimir — lançamentos da tela</button></div></details>'+
  '</div>';
  return finFormHtml()+finChipsContas()+finPeriodoHtml()+
    '<div id="fin-conteudo">'+finStripHtml()+'</div>'+
    filtros+finAtencaoHtml()+
    '<div id="fin-lista">'+finListaHtml()+'</div>';
}

function finLerForm(){
  function v(id){ var e=document.getElementById(id); return e?e.value:''; }
  var tipo=v('fin-tipo'), data=v('fin-data');
  /* vale o que está escrito no campo: se a pessoa digitou uma data inválida, o valor anterior não pode ser salvo no lugar */
  var dt=document.getElementById('dpt-fin-data');
  if(dt){ var lida=finDpLe(dt.value,data||todayStr()); data=lida===null?'!':lida; }
  return {
    tipo:tipo, sentido: tipo==='transferencia'?v('fin-sentido'):'', data:data, valor:finParseVal(v('fin-valor')),
    contaId:v('fin-conta'),
    contraparteId: tipo==='transferencia'?v('fin-outra'):'',
    categoriaId: tipo==='transferencia'?'':v('fin-nat'),
    descricao:(v('fin-desc')||'').trim(),
    obs:(v('fin-obs')||'').trim()
  };
}

/* Lançamento existente igual a l: mesmo dia, tipo, conta, valor e categoria (ou, na transferência, mesmo sentido e outra conta). */
function finLancIgual(l){
  var cents=Math.round(Math.abs(Number(l.valor)||0)*100);
  return (S.financeiro||[]).find(function(x){
    if(x.data!==l.data||x.tipo!==l.tipo||x.contaId!==l.contaId) return false;
    if(Math.round(Math.abs(Number(x.valor)||0)*100)!==cents) return false;
    if(l.tipo==='transferencia') return (x.sentido||'')===(l.sentido||'') && (x.contraparteId||'')===(l.contraparteId||'');
    return (x.categoriaId||'')===(l.categoriaId||'');
  })||null;
}
var _finSalvando=false, _finDupOk=false, _finDataOk=false, _finDataConfirmada=null;
/* Lançamento com data diferente de hoje (anterior ou futura) pede confirmação ao salvar. Ligado no sistema; os testes automáticos antigos o desligam. */
var FIN_CONFIRMA_DATA=true;
var _finFechOk=false;   /* já avisou que o lançamento muda dias fechados e a pessoa confirmou */
function finDataForaDoComum(v){ if(!v) return ''; var h=todayStr(); if(v>h) return 'futuro'; if(v<h) return 'passado'; return ''; }
/* "ontem", "há 5 dias", "amanhã", "daqui a 3 dias" */
function finDataDistancia(v){
  var n=Math.round((new Date(v+'T12:00:00')-new Date(todayStr()+'T12:00:00'))/864e5);
  if(n===-1) return 'ontem'; if(n===1) return 'amanhã';
  return n<0?'há '+(-n)+' dias':'daqui a '+n+' dias';
}
function finDataLonge(v){ var h=todayStr(); return v<finDiaMais(h,-365)||v>finDiaMais(h,365); }
function finBotoesForm(trava){ try{ document.querySelectorAll('#fin-form .fin-linb button').forEach(function(b){ b.disabled=!!trava; }); }catch(e){} }
async function addFin(manter){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode realizar esta ação.'); return; }
  if(_finSalvando) return;   /* clique duplo ou Enter repetido: só o primeiro salva */
  _finSalvando=true; finBotoesForm(true);
  try{ await addFinFaz(manter); } finally{ _finSalvando=false; finBotoesForm(false); }
}
async function addFinFaz(manter){
  var l=finLerForm(), orig=null;
  var parEl=document.getElementById('fin-par'), par=!!(!_finEdit && l.tipo==='transferencia' && l.contraparteId && parEl && parEl.checked);
  if(_finEdit){
    orig=(S.financeiro||[]).find(function(f){return f.id===_finEdit;});
    if(orig){
      l.id=orig.id; l.createdAt=orig.createdAt; l.createdBy=orig.createdBy;
      if(orig.estornoDe){ l.estornoDe=orig.estornoDe; }
      /* com estorno, os dois precisam continuar se anulando: valor, conta e categoria ficam como estavam */
      if(orig.estornoDe || finEstornoDe(orig.id)){ l.valor=Math.abs(Number(orig.valor)||0); l.contaId=orig.contaId; l.categoriaId=orig.categoriaId||''; l.tipo=orig.tipo; }
    }
  }
  /* erros aparecem ao lado de cada campo; a tela não é redesenhada, então nada do que foi digitado se perde */
  var erros=finValidaCampos(l);
  var parOrig=(orig&&finEhTransferencia(orig))?finParDe(orig):null, ocNova=l.contraparteId?finCadById('contas',l.contraparteId):null;
  var outraJunto=!!(parOrig && ocNova && !finExterna(ocNova) && l.contraparteId!==l.contaId);   /* a outra ponta é alterada junto */
  if(outraJunto && l.data && l.data!=='!' && l.data<finContaDataIni(ocNova)) erros['fin-outra']='A conta "'+ocNova.nome+'" começa em '+fmtDate(finContaDataIni(ocNova))+'. Escolha uma data a partir daí.';
  if(orig && orig.estornoDe && !erros['fin-valor']) l.valor=-Math.abs(Number(l.valor)||0);   /* estorno continua com o valor invertido */
  if(par){ var oc=finCadById('contas',l.contraparteId); if(oc && l.data && l.data!=='!' && l.data<finContaDataIni(oc)) erros['fin-outra']='A conta "'+oc.nome+'" começa em '+fmtDate(finContaDataIni(oc))+'. Escolha uma data a partir daí.'; }
  if(Object.keys(erros).length){ finErros(erros); finErroEm('fin-salvar','Revise os campos marcados.'); return; }
  finErroEm('fin-salvar','');
  /* data fora do comum (no futuro ou com mais de um ano): pergunta antes de salvar, para um erro no ano não passar despercebido */
  var foraDoComum=finDataForaDoComum(l.data);
  if(FIN_CONFIRMA_DATA && foraDoComum && !_finDataOk && !(orig && orig.data===l.data) && _finDataConfirmada!==l.data){
    finDialogo({titulo:foraDoComum==='futuro'?'A data está no futuro':'A data é anterior a hoje',
      texto:'Você está salvando com a data <strong>'+fmtDate(l.data)+'</strong> ('+finDataDistancia(l.data)+'), e hoje é '+fmtDate(todayStr())+'.'+
        (finDataLonge(l.data)?'<span class="fin-dlg-alerta">A diferença passa de um ano: confira o ano.</span>':'')+
        '<span style="display:block;margin-top:10px">Quer salvar assim?</span>',
      rotuloOk:'Salvar assim',onOk:function(){ _finDataOk=true; _finDataConfirmada=l.data; _finSalvando=false; return addFin(manter).then(function(){ _finDataOk=false; }); }});
    return;
  }
  /* lançamento novo igual a outro do mesmo dia (mesmo tipo, conta, valor e categoria ou outra conta): pergunta antes */
  if(!orig && !_finDupOk){
    var igual=finLancIgual(l);
    if(igual){
      finDialogo({titulo:'Já existe um lançamento igual neste dia',
        texto:'Já existe um lançamento igual: '+finIdentLanc(igual)+'<span style="display:block;margin-top:10px">Se for mesmo outro lançamento (por exemplo, duas tarifas iguais), salve mesmo assim.</span>',
        rotuloOk:'Salvar mesmo assim',onOk:function(){ _finDupOk=true; _finSalvando=false; return addFin(manter).then(function(){ _finDupOk=false; }); }});
      return;
    }
  }
  /* mexe no saldo de um dia com caixa fechado (o saldo é acumulado: vale para dias fechados depois desta data): avisa antes */
  if(!_finFechOk){
    var sim=(S.financeiro||[]).filter(function(f){ return (!orig || f.id!==orig.id) && !(outraJunto && f.id===parOrig.id); });
    sim.push(Object.assign({},l,{id:orig?orig.id:'__novo'}));
    if(outraJunto) sim.push(finEspelho(Object.assign({},l,{id:orig.id}),parOrig));
    if(par) sim.push(Object.assign({},l,{id:'__par',contaId:l.contraparteId,contraparteId:l.contaId,sentido:l.sentido==='saida'?'entrada':'saida'}));
    var afet=finFechAfetados(sim);
    if(afet.length){
      finDialogo({titulo:'Este lançamento muda dias já fechados',texto:finIdentLanc(Object.assign({},orig||{},l))+finFechAvisoHtml(afet)+'<span style="display:block;margin-top:10px">Quer salvar assim?</span>',
        rotuloOk:'Salvar assim',onOk:function(){ _finFechOk=true; _finSalvando=false; return addFin(manter).then(function(){ _finFechOk=false; }); }});
      return;
    }
  }
  try{
    var novoId;
    if(par){
      /* as duas pontas nascem juntas, cada uma na sua conta, e depois são independentes */
      novoId=fb.doc(fb.collection(fb.db,'lancamentos')).id; var id2=fb.doc(fb.collection(fb.db,'lancamentos')).id;
      var l2=Object.assign({},l,{id:id2,parId:novoId,contaId:l.contraparteId,contraparteId:l.contaId,sentido:l.sentido==='saida'?'entrada':'saida'});
      l.id=novoId; l.parId=id2;
      await upsertLancamento(l); await upsertLancamento(l2);
    }else if(outraJunto){
      l.parId=parOrig.id; novoId=await upsertLancamento(l);
      await upsertLancamento(finEspelho(l,parOrig));
    }else if(parOrig){
      /* a outra conta foi retirada (ou virou externa): as pontas deixam de ser ligadas, e a outra fica como estava */
      l.parId=''; novoId=await upsertLancamento(l);
      await upsertLancamento(Object.assign({},parOrig,{parId:''}));
    }else novoId=await upsertLancamento(l);
    S.financeiro=await fetchCollection('lancamentos');
    var editou=!!_finEdit;
    _finRecente=novoId;
    var fechouAntes=[l.contaId,par?l.contraparteId:''].filter(Boolean).some(function(cid){ return finCaixaDoDia(cid,l.data); }) || (orig && orig.data!==l.data && finCaixaDoDia(orig.contaId,orig.data));
    showToast((editou?'Lançamento alterado.'+(outraJunto?' A outra ponta, na '+ocNova.nome+', também foi alterada.':(parOrig?' A outra ponta ficou como estava e não está mais ligada a esta.':'')):(par?'Transferência registrada: enviada e recebida.':'Lançamento registrado.'))+(fechouAntes?' Atenção: o caixa desse dia já estava fechado e o saldo dele mudou.':''));
    _finUltimo={data:l.data,contaId:l.contaId,contraparteId:l.contraparteId||'',sentido:l.sentido||''};
    /* mostra o que acabou de ser lançado: leva a tela para o mês e a conta do lançamento */
    if(!finPerCobre(l.data)) finPerVaiPara(l.data);
    /* a conta do lançamento entra na seleção, para ele aparecer na tela */
    var tocadas=[l.contaId,par?l.contraparteId:''].filter(function(id){ return id && finCadById('contas',id) && !finExterna(finCadById('contas',id)); });
    var marcadas=finContasEscopo().map(function(c){ return c.id; });
    if(!tocadas.some(function(id){ return marcadas.indexOf(id)>=0; })) finSalvaContasSel(marcadas.concat(tocadas.slice(0,1)));
    var emps=finEmpresasDoLanc(l);
    if(_finEmp && emps.indexOf(_finEmp)<0){ _finEmp=''; try{ sessionStorage.setItem('fin_emp',''); }catch(e){} }
    _finEdit=null; _finClone=null; _finTroca=null; _finFormIni=null;
    if(!manter||editou){ _finNovo=null; _finUltimo=null; _finDataConfirmada=null; }   /* a data confirmada só vale na sequência do "Salvar e novo" */
    navigate('financeiro');
    if(_finNovo) setTimeout(function(){ var e=document.getElementById('fin-valor'); if(e&&e.focus) e.focus(); },0);
    else finVoltaDoFormulario(true);
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}
/* O estorno feito a partir deste lançamento, se houver. */
function finEstornoDe(id){ return (S.financeiro||[]).find(function(x){ return x.estornoDe===id; })||null; }
/* Duplicar: abre um lançamento novo com tudo igual (data de hoje), para conferir e salvar. */
var _finClone=null;
function finClonar(id){
  var f=(S.financeiro||[]).find(function(x){ return x.id===id; }); if(!f) return;
  _finClone=f; finNovo(f.tipo,true);
}
/* Estornar: cria um lançamento de hoje, na mesma conta e categoria, com o valor invertido. */
function finEstornar(id){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode realizar esta ação.'); return; }
  var f=(S.financeiro||[]).find(function(x){ return x.id===id; }); if(!f) return;
  if(finEhTransferencia(f)||f.estornoDe||finEstornoDe(f.id)) return;
  var v=Number(f.valor)||0, hoje=todayStr(), efeito=finEntraSaldo(f)?-v:v;
  finDialogo({titulo:'Estornar lançamento',
    texto:'Vai ser criado um lançamento de <strong>hoje ('+fmtDate(hoje)+')</strong> na mesma conta e na mesma categoria (<strong>'+esc(finNatNome(f)||'')+'</strong>), '+
      'com o valor invertido: <strong>'+(efeito<0?'− '+fmt(-efeito):fmt(efeito))+'</strong>.<br><span class="fcx-sub">O lançamento original continua no dia '+fmtDate(f.data)+', marcado como estornado.</span>'+
      finFechAvisoHtml(finFechAfetados((S.financeiro||[]).concat([{id:'__est',tipo:f.tipo,data:hoje,valor:-v,contaId:f.contaId,sentido:f.sentido||''}]))),
    rotuloOk:'Estornar',
    onOk:async function(){
      try{
        var o={tipo:f.tipo,data:hoje,valor:-v,contaId:f.contaId,categoriaId:f.categoriaId||'',sentido:f.sentido||'',
          descricao:('Estorno: '+(f.descricao||finNatNome(f)||'')).slice(0,FIN_DESC_MAX),
          obs:'Estorno do lançamento de '+fmtDate(f.data)+(f.descricao?' ('+f.descricao+')':'')+'.',estornoDe:f.id};
        var nid=await upsertLancamento(o);
        S.financeiro=await fetchCollection('lancamentos');
        _finRecente=nid; if(!finPerCobre(hoje)) finPerVaiPara(hoje);
        navigate('financeiro'); showToast('Estorno registrado em '+fmtDate(hoje)+'.');
      }catch(e){ showToast('Erro: '+(e.code||e.message)); }
    }});
}
/* O menu ⋮ abre por cima de tudo (não é cortado pela tabela) e só um fica aberto por vez. */
function finMenuPos(d){
  if(!d||!d.open||!d.querySelector) return;
  document.querySelectorAll('details.fin-lm[open]').forEach(function(x){ if(x!==d) x.open=false; });
  var p=d.querySelector('.fin-more-pop'), s=d.querySelector('summary'); if(!p||!s) return;
  var r=s.getBoundingClientRect(); p.style.position='fixed'; p.style.right='auto';
  var w=p.offsetWidth||170, h=p.offsetHeight||150, top=r.bottom+4;
  if(top+h>window.innerHeight-8) top=Math.max(8,r.top-h-4);
  p.style.top=top+'px'; p.style.left=Math.max(8,r.right-w)+'px';
}
if(typeof document!=='undefined' && document.addEventListener){
  document.addEventListener('click',function(e){ document.querySelectorAll('details.fin-lm[open]').forEach(function(d){ if(!d.contains(e.target)) d.open=false; }); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape') document.querySelectorAll('details.fin-lm[open]').forEach(function(d){ d.open=false; }); },true);
  document.addEventListener('scroll',function(){ document.querySelectorAll('details.fin-lm[open]').forEach(function(d){ d.open=false; }); },true);
}
function finEditar(id){ if(!_finNovo&&!_finEdit) _finScroll=finMainScroll(); _finEdit=id; _finNovo=null; navigate('financeiro'); finMainScroll(0); }
/* Excluir: pede confirmação e o motivo. O lançamento sai do extrato e dos saldos;
   uma cópia dele com o motivo, quem excluiu e quando fica guardada em 'lancExcluidos'. */
function finExcluir(id){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode realizar esta ação.'); return; }
  var f=(S.financeiro||[]).find(function(x){return x.id===id;}); if(!f) return;
  var info=f.lote?finLoteInfo(f.lote):null, emLote=!!(info&&info.n>1); _finExcLote=false;
  /* lançamento que veio de planilha: dá para excluir só ele ou a importação inteira, com um motivo só */
  var escolha=emLote?'<span class="fin-dlg-op" role="radiogroup" aria-label="O que excluir">'+
      '<label><input type="radio" name="fin-exc-esc" value="um" checked onchange="finExcEscolha()"/> Só este lançamento</label>'+
      '<label><input type="radio" name="fin-exc-esc" value="lote" onchange="finExcEscolha()"/> Toda a '+esc(finLoteRotulo(f.lote))+' ('+info.n+' lançamentos)</label></span>':'';
  var est=finEstornoDe(f.id), outra=finParDe(f);
  var semUm=(S.financeiro||[]).filter(function(x){ return x.id!==f.id && x.estornoDe!==f.id && !(outra && x.id===outra.id); });
  var avUm=finFechAvisoHtml(finFechAfetados(semUm)), avLote='';
  if(emLote){ var saiLote={}; info.itens.concat(finEstornosDoLote(f.lote)).forEach(function(x){ saiLote[x.id]=1; }); avLote=finFechAvisoHtml(finFechAfetados((S.financeiro||[]).filter(function(x){ return !saiLote[x.id]; }))); }
  /* um lançamento estornado e o seu estorno se anulam: excluir só um deixaria o saldo errado, então os dois saem juntos */
  var avisoEst=est?'<span class="fin-dlg-alerta">Este lançamento foi estornado em '+fmtDate(est.data)+'. O estorno também será excluído, porque os dois se anulam.</span>':'';
  var avisoPar=outra?'<span class="fin-dlg-alerta">A outra ponta desta transferência, na '+esc(finCadNome('contas',outra.contaId))+', também será excluída: as duas formam a mesma transferência.</span>':'';
  var avisoFech=(avUm?'<span id="fin-exc-av-um">'+avUm+'</span>':'')+(avLote?'<span id="fin-exc-av-lote" style="display:none">'+avLote+'</span>':'');
  finDialogo({
    titulo:est?'Excluir lançamento e estorno':(outra?'Excluir transferência':'Excluir lançamento'),
    texto:finIdentLanc(f)+escolha+avisoEst+avisoPar+avisoFech+'<span style="display:block;margin-top:10px">'+(emLote?'O que for excluído sai do extrato e dos saldos.':(est?'Os dois saem do extrato e dos saldos.':'Ele sai do extrato e dos saldos.'))+' O motivo fica registrado.</span>',
    motivo:{rotulo:'Motivo da exclusão',obrigatorio:true},
    rotuloOk:(est||outra)?'Excluir os dois':'Excluir lançamento', perigo:true,
    onOk:function(motivo){ return (emLote&&_finExcLote)?finDesfazerLote(f.lote,motivo):finExcluirGravar(id,motivo); }
  });
}
/* a escolha fica guardada na hora em que é marcada (ao confirmar, a janela já fechou) */
var _finExcLote=false;
function finExcEscolha(){
  var r=document.querySelector('input[name="fin-exc-esc"]:checked'), b=document.getElementById('fin-dlg-ok'), t=document.getElementById('fin-dlg-t');
  var lote=!!(r&&r.value==='lote'); _finExcLote=lote;
  if(b) b.textContent=lote?'Desfazer importação':'Excluir lançamento';
  if(t) t.textContent=lote?'Desfazer importação':'Excluir lançamento';
  var a1=document.getElementById('fin-exc-av-um'), a2=document.getElementById('fin-exc-av-lote');
  if(a1) a1.style.display=lote?'none':''; if(a2) a2.style.display=lote?'':'none';
}
/* ── Importação: cada planilha importada é um lote, que dá para ver e desfazer de uma vez ── */
function finLoteRotulo(lote){
  var ms=Number(String(lote).replace(/^imp-/,'')), d=ms?new Date(ms):null;
  return d&&!isNaN(d)?'importação de '+d.toLocaleDateString('pt-BR')+' às '+d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}):'importação';
}
function finLoteInfo(lote){
  var ls=(S.financeiro||[]).filter(function(f){ return f.lote===lote; }), ent=0, sai=0, fech=0;
  ls.forEach(function(f){ var v=Number(f.valor)||0; if(finEntraSaldo(f)) ent+=v; else sai+=v; if(finCaixaDoDia(f.contaId,f.data)) fech++; });
  return {itens:ls,n:ls.length,ent:ent,sai:sai,fechados:fech,por:ls.length?ls[0].createdBy:''};
}
function finVerLote(lote){
  var info=finLoteInfo(lote); if(!info.n) return;
  var adm=isFullAccess(currentUser);
  var texto='<strong style="display:block">'+info.n+(info.n===1?' lançamento':' lançamentos')+'</strong>'+
    '<span style="display:block;color:var(--mt);font-size:13px;margin-top:2px">'+(info.ent?'entradas '+fmt(info.ent):'')+(info.ent&&info.sai?' · ':'')+(info.sai?'saídas '+fmt(info.sai):'')+(info.por?' · importado por '+esc(info.por):'')+'</span>'+
    (info.fechados?'<span class="fin-dlg-alerta">'+info.fechados+(info.fechados===1?' deles está num dia com caixa já fechado':' deles estão em dias com caixa já fechado')+': desfazer muda o saldo desses dias.</span>':'')+
    (finEstornosDoLote(lote).length?'<span class="fin-dlg-alerta">'+finEstornosDoLote(lote).length+(finEstornosDoLote(lote).length===1?' lançamento desta importação foi estornado depois: o estorno também será excluído.':' lançamentos desta importação foram estornados depois: os estornos também serão excluídos.')+'</span>':'')+
    '<span style="display:block;margin-top:10px">'+(adm?'Desfazer exclui todos os lançamentos desta importação, inclusive os alterados depois. O motivo fica registrado em cada um.':'Só o administrador pode desfazer uma importação.')+'</span>';
  finDialogo(adm?{titulo:'Desfazer '+finLoteRotulo(lote),texto:texto,motivo:{rotulo:'Motivo',obrigatorio:true},rotuloOk:'Desfazer importação',perigo:true,onOk:function(m){ return finDesfazerLote(lote,m); }}
               :{titulo:finLoteRotulo(lote).replace(/^i/,'I'),texto:texto,rotuloOk:'Fechar',semCancelar:true,onOk:function(){}});
}
/* Estornos (feitos depois) de lançamentos desta importação que não fazem parte dela. */
function finEstornosDoLote(lote){
  var ids={}; finLoteInfo(lote).itens.forEach(function(f){ ids[f.id]=true; });
  return (S.financeiro||[]).filter(function(x){ return x.estornoDe && ids[x.estornoDe] && x.lote!==lote; });
}
async function finDesfazerLote(lote,motivo){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode realizar esta ação.'); return; }
  var ls=finLoteInfo(lote).itens; if(!ls.length) return;
  ls=ls.concat(finEstornosDoLote(lote));   /* estornos de lançamentos desta importação saem junto (senão ficariam sozinhos) */
  var em=new Date().toISOString(), feitos=0;
  try{
    for(var i=0;i<ls.length;i+=200){
      var b=fb.writeBatch(fb.db);
      ls.slice(i,i+200).forEach(function(f){
        b.set(fb.doc(fb.db,'lancExcluidos',f.id),Object.assign({},f,{excluidoMotivo:motivo,excluidoPor:currentUser.id,excluidoEm:em,excluidoComLote:lote}));
        b["delete"](fb.doc(fb.db,'lancamentos',f.id));
      });
      await b.commit(); feitos+=Math.min(200,ls.length-i);
    }
    S.financeiro=await fetchCollection('lancamentos');
    showToast('Importação desfeita: '+feitos+(feitos===1?' lançamento excluído.':' lançamentos excluídos.'));
    navigate('financeiro');
  }catch(e){ S.financeiro=await fetchCollection('lancamentos'); showToast('Erro: '+(e.message||e.code)+(feitos?' ('+feitos+' já excluídos)':'')); navigate('financeiro'); }
}
async function finExcluirGravar(id,motivo){
  var f=(S.financeiro||[]).find(function(x){return x.id===id;}); if(!f) return;
  try{
    /* num lote só: ou grava a cópia e apaga o original, ou não faz nada */
    var lote=fb.writeBatch(fb.db), em=new Date().toISOString();
    lote.set(fb.doc(fb.db,'lancExcluidos',id),Object.assign({},f,{excluidoMotivo:motivo,excluidoPor:currentUser.id,excluidoEm:em}));
    lote["delete"](fb.doc(fb.db,'lancamentos',id));
    /* o estorno deste lançamento sai junto, no mesmo lote (ou os dois, ou nenhum) */
    var ests=(S.financeiro||[]).filter(function(x){ return x.estornoDe===id; });
    var outra=finParDe(f); if(outra) ests.push(outra);   /* a outra ponta da transferência sai junto, no mesmo lote */
    ests.forEach(function(e){
      lote.set(fb.doc(fb.db,'lancExcluidos',e.id),Object.assign({},e,{excluidoMotivo:motivo,excluidoPor:currentUser.id,excluidoEm:em,excluidoJuntoCom:id}));
      lote["delete"](fb.doc(fb.db,'lancamentos',e.id));
    });
    await lote.commit();
    S.financeiro=await fetchCollection('lancamentos');
    showToast(outra?'Transferência excluída nas duas contas.':(ests.length?'Lançamento e estorno excluídos.':'Lançamento excluído.'));
    navigate('financeiro');
  }catch(e){ showToast('Erro: '+(e.message||e.code)); }
}
function finLimparFiltros(){
  _finF.tipo='todos'; _finF.categoriaId=''; _finF.q='';
  navigate('financeiro');
}

function filterFin(){
  function v(id){ var e=document.getElementById(id); return e?e.value:''; }
  _finF.tipo=v('fin-tf')||'todos'; _finF.categoriaId=v('fin-nf'); _finF.q=v('fin-q');
  var l=document.getElementById('fin-lista'); if(l){ l.innerHTML=finListaHtml(); finAjustaColunas(); }
  finKpiMarca();
}
/* Cartão de Entradas, Saídas ou Transferências: filtra a lista por esse tipo; clicar de novo volta a mostrar tudo. */
function finKpiFiltro(tipo){
  var s=document.getElementById('fin-tf'), novo=_finF.tipo===tipo?'todos':tipo;
  if(s){ s.value=novo; filterFin(); } else { _finF.tipo=novo; navigate('financeiro'); }
}
function finKpiMarca(){
  try{ document.querySelectorAll('.fin-kpis .mc[data-tipo]').forEach(function(c){
    var on=c.getAttribute('data-tipo')===_finF.tipo; c.classList[on?'add':'remove']('ativo'); c.setAttribute('aria-pressed',on?'true':'false');
    var d2=c.querySelector('.fin-kd2'); if(d2) d2.textContent=on?'Clique para voltar a ver tudo.':'Clique para ver só '+({entrada:'as entradas',saida:'as saídas',transferencia:'as transferências'}[c.getAttribute('data-tipo')])+' na lista.';
  }); }catch(e){}
}

/* ── Cadastros ───────────────────────────────────────────── */
function finViewCadastros(){
  var col=_finCadTab;
  if(col==='contas'){   /* empresas e contas na mesma tela: cada empresa é um grupo com as suas contas */
    return ((_finEmpNova||_finCadEdit.empresas)?'<div class="fin-cadform">'+finCadForm('empresas')+'</div>':'')+
           ((_finCadAberto||_finCadEdit.contas)?'<div class="fin-cadform">'+finCadForm('contas')+'</div>':'')+finCadTabela('contas');
  }
  return ((_finCadAberto||_finCadEdit[col])?'<div class="fin-cadform">'+finCadForm(col)+'</div>':'')+finCadTabela(col);
}
/* O botão fica na linha do título; some quando o formulário está aberto. */
function finCadBotaoNovo(){
  var col=_finCadTab;
  if(col==='contas'){
    if(_finCadAberto||_finEmpNova||_finCadEdit.contas||_finCadEdit.empresas) return '';
    return '<div class="fin-tbtns no-print"><button class="btn fin-nv" onclick="finEmpNova()">+ Nova empresa</button><button class="btn bp" onclick="finCadNovo()">+ Nova conta bancária</button></div>';
  }
  if(_finCadAberto||_finCadEdit[col]) return '';
  return '<button class="btn bp no-print" onclick="finCadNovo()">+ Nova categoria</button>';
}
function finCadNovo(empId){ _finCadAberto=true; _finEmpNova=false; _finCadEmpPre=empId||''; _finCadEdit={}; finCadAbreForm(); }
function finEmpNova(){ _finEmpNova=true; _finCadAberto=false; _finCadEdit={}; finCadAbreForm(); }

/* Para que serve cada conta, em palavras de quem usa. */
var FIN_FUNCAO_ROTULO={operacional:'Caixa da empresa',transito:'Conta de passagem',externa:'Só recebe repasse'};
var FIN_FUNCAO_DICA={operacional:'O caixa do dia a dia da empresa.',transito:'O dinheiro entra e é repassado ao fundo.',externa:'Conta do fundo na administradora: só recebe repasse, sem saldo aqui.'};
/* CPF/CNPJ com pontuação: 14 dígitos = CNPJ, 11 = CPF; qualquer outra coisa fica como foi digitada. */
function finFormataDoc(s){
  var d=String(s||'').replace(/\D/g,'');
  if(d.length===14) return d.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/,'$1.$2.$3/$4-$5');
  if(d.length===11) return d.replace(/^(\d{3})(\d{3})(\d{3})(\d{2})$/,'$1.$2.$3-$4');
  return String(s||'').trim();
}
function finDocBlur(id){ var e=document.getElementById(id); if(e&&e.value) e.value=finFormataDoc(e.value); }
var FIN_PIX_TIPOS={email:'E-mail',telefone:'Telefone',cpfcnpj:'CPF ou CNPJ',aleatoria:'Chave aleatória'};
/* A linha do Pix, do jeito que vocês escrevem hoje. */
function finLinhaPix(c){
  var k=String(c.pixChave||'').trim(); if(!k) return '';
  var d=k.replace(/\D/g,''), tp={email:'e-mail',telefone:'celular',aleatoria:'aleatória'}[c.pixTipo]||'';
  if(c.pixTipo==='cpfcnpj') tp=d.length===11?'CPF':(d.length===14?'CNPJ':'CPF ou CNPJ');
  return 'Chave PIX'+(tp?' ('+tp+')':'')+': '+k;
}
/* Código (COMPE) dos bancos mais comuns: sugere o código quando a pessoa digita o nome do banco. */
var FIN_BANCOS_COD={'genial':'125','santander':'033','itau':'341','bradesco':'237','banco do brasil':'001','bb':'001','caixa':'104','caixa economica federal':'104','nubank':'260','nu pagamentos':'260','inter':'077','sicoob':'756','sicredi':'748','btg pactual':'208','btg':'208','safra':'422','c6':'336','c6 bank':'336','xp':'348','original':'212','banrisul':'041','bs2':'218','daycoval':'707','pan':'623','mercado pago':'323','pagbank':'290','picpay':'380','sofisa':'637','bv':'655','votorantim':'655'};
function finBancoCodigoSugerido(nome){ var n=finNorm(nome).replace(/^banco /,''); return FIN_BANCOS_COD[n]||''; }
/* "Banco" na frente do nome, exceto onde o nome já diz o que é (Caixa, cooperativas, Nubank...). */
function finBancoNomeCompleto(c){
  var b=String(c.banco||'').trim(); if(!b) return '';
  return /^(banco|caixa|sicoob|sicredi|cooperativa|coop\b|nubank|nu\b|mercado|pagbank|picpay|stone)/i.test(finNorm(b))?b:'Banco '+b;
}
/* "125 - Banco Genial". Conta antiga, sem o código guardado, usa o código conhecido do banco; código apagado de propósito fica sem. */
function finInstituicao(c){
  var nome=finBancoNomeCompleto(c), cod=(c.bancoCodigo===undefined)?finBancoCodigoSugerido(c.banco):String(c.bancoCodigo||'').trim();
  return cod&&nome?cod+' - '+nome:(nome||cod);
}
/* O bloco que se manda para quem vai pagar: agência e conta, titular, CPF/CNPJ e Pix. */
function finTextoRecebimento(c){
  var l=[], num=String(c.numero||'').trim(), ag=String(c.agencia||'').trim(), doc=String(c.cnpj||'').trim(), inst=finInstituicao(c);
  if(inst) l.push('Instituição: '+inst);
  if(ag) l.push('Agência: '+ag);
  if(num) l.push('Tipo de conta: Conta Corrente');
  if(num) l.push('Conta e Dígito: '+num);
  if(c.titular) l.push('Nome: '+c.titular);
  if(doc) l.push((doc.replace(/\D/g,'').length===11?'CPF: ':'CNPJ: ')+doc);
  var p=finLinhaPix(c); if(p) l.push(p);
  return l.join('\n');
}
/* Copia para a área de transferência; se o navegador não deixar, mostra o texto numa janela para copiar na mão. */
function finCopiar(txt,msg){
  function manual(){ finDialogo({titulo:'Dados para recebimento',texto:'<pre class="cod" style="white-space:pre-wrap;user-select:all;margin:0;font:inherit">'+esc(txt)+'</pre>',rotuloOk:'Fechar',onOk:function(){}}); }
  try{
    if(typeof navigator!=='undefined' && navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(txt).then(function(){ showToast(msg); },manual); return;
    }
  }catch(e){}
  manual();
}
function finCopiarDados(cid){ var c=finCadById('contas',cid); if(c) finCopiar(finTextoRecebimento(c),'Dados copiados.'); }

function finNomeConta(banco,numero,apelido){ return String(apelido||'').trim()||((String(banco||'').trim()+' '+String(numero||'').trim()).trim()); }
function finLancDaConta(id){ return (S.financeiro||[]).filter(function(f){ return f.contaId===id||f.contraparteId===id; }).length; }
/* Mostra o nome que a conta vai ter enquanto a pessoa digita. */
/* Ao sair do campo Banco, sugere o código se ele ainda está em branco. */
function finCadBancoBlur(){
  var b=document.getElementById('cad-banco'), c=document.getElementById('cad-bancocodigo');
  if(!b||!c||String(c.value||'').trim()) return;
  var s=finBancoCodigoSugerido(b.value); if(s) c.value=s;
}
/* O código tem 3 números: só dígitos e zeros à esquerda (33 vira 033). */
function finCadCodigoBlur(){ var c=document.getElementById('cad-bancocodigo'); if(c&&c.value){ var d=String(c.value).replace(/\D/g,'').slice(0,3); c.value=d?('000'+d).slice(-3):''; } }
function finCadNomePrev(){
  function g(i){ var e=document.getElementById(i); return e?e.value:''; }
  var p=document.getElementById('cad-nome-prev'); if(p) p.textContent=finNomeConta(g('cad-banco'),g('cad-numero'),g('cad-apelido'))||'—';
}
/* Escolher "Só recebe repasse" esconde o saldo de abertura (a conta do fundo não tem saldo aqui). */
function finCadFuncaoMudou(v){
  var h=document.getElementById('cad-funcao'); if(h) h.value=v;
  var b=document.getElementById('cad-abertura'); if(b) b.style.display=(v==='externa'?'none':'block');
  finCadRadioMarca('cad-funcao-r',v);
}
/* Marca o cartão escolhido só dentro do seu grupo (função ou fechamento). */
function finCadRadioMarca(nome,v){
  document.querySelectorAll('input[name="'+nome+'"]').forEach(function(i){ var l=i.closest?i.closest('.fin-radio'):null; if(l&&l.classList) l.classList.toggle('on',i.value===v); });
}
function finCadFechMudou(v){
  var h=document.getElementById('cad-fech'); if(h) h.value=v;
  var d=document.getElementById('cad-fech-dia'); if(d) d.style.display=(v==='semanal'?'flex':'none');
  finCadRadioMarca('cad-fech-r',v);
}
/* Ao trocar a empresa, sugere o titular que as outras contas dela já usam (só se o campo estiver vazio). */
function finCadEmpresaMudou(){
  var e=document.getElementById('cad-empresa'), tt=document.getElementById('cad-titular'); if(!e||!tt||tt.value) return;
  var c=finCad('contas').filter(function(x){ return x.empresaId===e.value && x.titular; })[0];
  if(c){ tt.value=c.titular; var dd=document.getElementById('cad-cnpj'); if(dd && !dd.value) dd.value=c.cnpj||''; }
}

function finCadForm(col){
  var ed=_finCadEdit[col]?finCadById(col,_finCadEdit[col]):null;
  function inp(id,lb,val,ph){ return '<div class="fg"><label for="'+id+'">'+lb+'</label><input type="text" id="'+id+'" value="'+esc(val||'')+'" placeholder="'+(ph||'')+'"/><div class="fin-err" id="err-'+id+'" role="alert"></div></div>'; }
  var campos='';
  if(col==='empresas'){
    campos='<div class="g3" style="margin-bottom:10px">'+
      inp('cad-nome','Nome *',ed?ed.nome:'','Ex: PBL Originadora')+
      inp('cad-codigo','Código *',ed?ed.codigo:'','Ex: PBL')+
      inp('cad-obs','Observação',ed?ed.obs:'')+'</div>';
  }else if(col==='contas'){
    var auto=ed?((ed.banco||'')+' '+(ed.numero||'')).trim():'';
    var apel=ed?(ed.apelido!==undefined?ed.apelido:((ed.nome&&ed.nome!==auto)?ed.nome:'')):'';
    var empSel=ed?ed.empresaId:(_finCadEmpPre||'');
    var empOpts=finCadAtivos('empresas').map(function(e){
      return '<option value="'+e.id+'"'+(empSel===e.id?' selected':'')+'>'+esc(e.nome)+'</option>';
    }).join('');
    var fn=ed?(ed.funcao||'operacional'):'operacional', fc=ed?finFechRegra(ed):'diario', fdow=ed?finFechDow(ed):5;
    var funcs=['operacional','transito']; if(fn==='externa') funcs.push('externa');   /* "só recebe repasse" não se escolhe mais; só aparece para uma conta que já era assim */
    var radios=funcs.map(function(k){
      return '<label class="fin-radio'+(fn===k?' on':'')+'"><input type="radio" name="cad-funcao-r" value="'+k+'"'+(fn===k?' checked':'')+' onchange="finCadFuncaoMudou(this.value)"/>'+
        '<span class="t">'+FIN_FUNCAO_ROTULO[k]+'</span><span class="d">'+FIN_FUNCAO_DICA[k]+'</span></label>';
    }).join('');
    function ent(id,lb,val,ph,extra){ return '<div class="fg"><label for="'+id+'">'+lb+'</label><input type="text" id="'+id+'" value="'+esc(val||'')+'" placeholder="'+(ph||'')+'" oninput="finCadNomePrev()" '+(extra||'')+' autocomplete="off"/><div class="fin-err" id="err-'+id+'" role="alert"></div></div>'; }
    var codBanco=ed?(ed.bancoCodigo===undefined?finBancoCodigoSugerido(ed.banco):ed.bancoCodigo):'';
    campos='<div class="g5" style="margin-bottom:10px">'+
      ent('cad-banco','Banco',ed?ed.banco:'','Ex: Genial','onblur="finCadBancoBlur()"')+
      ent('cad-bancocodigo','Código do banco',codBanco,'Ex: 125','inputmode="numeric" maxlength="3" onblur="finCadCodigoBlur()"')+
      ent('cad-agencia','Agência',ed?ed.agencia:'','Ex: 0001')+
      ent('cad-numero','Número da conta',ed?ed.numero:'','Ex: 38219-1')+
      ent('cad-apelido','Apelido (opcional)',apel,'Ex: Caixa principal')+'</div>'+
      '<div class="fin-nomeprev">Nome da conta: <strong id="cad-nome-prev">'+esc(finNomeConta(ed?ed.banco:'',ed?ed.numero:'',apel)||'—')+'</strong> <span>Preencha o banco e o número, ou só o apelido.</span></div>'+
      '<div class="g3" style="margin-bottom:12px">'+
      '<div class="fg"><label for="cad-empresa">Empresa *</label><select id="cad-empresa" onchange="finCadEmpresaMudou()">'+empOpts+'</select><div class="fin-err" id="err-cad-empresa" role="alert"></div></div>'+
      inp('cad-titular','Titular (quem assina o extrato) *',ed?ed.titular:'','Razão social')+
      '<div class="fg"><label for="cad-cnpj">CPF ou CNPJ do titular</label><input type="text" id="cad-cnpj" value="'+esc(ed?(ed.cnpj||''):'')+'" placeholder="00.000.000/0000-00" autocomplete="off" onblur="finDocBlur(\'cad-cnpj\')"/><div class="fin-err" id="err-cad-cnpj" role="alert"></div></div></div>'+
      '<div class="fg" style="margin-bottom:12px"><label id="cad-funcao-l">Para que serve esta conta? *</label>'+
        '<div class="fin-radios" role="radiogroup" aria-labelledby="cad-funcao-l">'+radios+'</div>'+
        '<input type="hidden" id="cad-funcao" value="'+fn+'"/></div>'+
      '<div class="fg" style="margin-bottom:12px"><label id="cad-fech-l">Fechamento de caixa *</label>'+
        '<div class="fin-radios" role="radiogroup" aria-labelledby="cad-fech-l">'+FIN_FECH_TIPOS.map(function(k){
          return '<label class="fin-radio'+(fc===k?' on':'')+'"><input type="radio" name="cad-fech-r" value="'+k+'"'+(fc===k?' checked':'')+' onchange="finCadFechMudou(this.value)"/>'+
            '<span class="t">'+FIN_FECH_CURTO[k]+'</span><span class="d">'+FIN_FECH_DICA[k]+'</span></label>'; }).join('')+'</div>'+
        '<input type="hidden" id="cad-fech" value="'+fc+'"/>'+
        '<div class="fin-fech-dia" id="cad-fech-dia" style="display:'+(fc==='semanal'?'flex':'none')+'"><label for="cad-fechdow">Dia da semana</label><select id="cad-fechdow">'+
          [1,2,3,4,5].map(function(n){ return '<option value="'+n+'"'+(fdow===n?' selected':'')+'>'+FIN_DIAS_UTEIS_NOME[n]+'</option>'; }).join('')+'</select><span>Se cair num feriado, vale o dia útil anterior.</span></div></div>'+
      '<div id="cad-abertura" style="display:'+(fn==='externa'?'none':'block')+'">'+
        '<div class="fin-sub">Saldo de abertura</div>'+
        '<div class="g3" style="margin-bottom:10px">'+
          '<div class="fg"><label for="cad-saldo">Saldo (R$)</label><input type="text" inputmode="decimal" id="cad-saldo" autocomplete="off" oninput="finValorEntrada(this,true)" value="'+(ed?esc((Number(ed.saldoInicial)||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})):'0,00')+'" onblur="finValorBlur(\'cad-saldo\')"/><div class="fin-err" id="err-cad-saldo" role="alert"></div></div>'+
          '<div class="fg"><label for="dpt-cad-datainicial">Data do saldo (opcional)</label>'+finDp('cad-datainicial',ed?(ed.dataInicial||''):FIN_DATA_INICIAL,{rotulo:'Data do saldo'})+'<div class="fin-err" id="err-cad-datainicial" role="alert"></div></div>'+
          '<div class="fg" style="justify-content:flex-end;font-size:11px;color:var(--mt)">Use o saldo do extrato do dia anterior ao primeiro lançamento. Sem data, a conta aceita lançamentos de qualquer data.</div>'+
        '</div></div>'+
      '<details class="fin-obs"'+(ed&&ed.pixChave?' open':'')+'><summary>Chave Pix (para receber pagamentos)</summary><div class="g3" style="margin-top:8px">'+
        '<div class="fg"><label for="cad-pixtipo">Tipo da chave</label><select id="cad-pixtipo"><option value="">— escolha —</option>'+
          Object.keys(FIN_PIX_TIPOS).map(function(k){ return '<option value="'+k+'"'+(ed&&ed.pixTipo===k?' selected':'')+'>'+FIN_PIX_TIPOS[k]+'</option>'; }).join('')+'</select></div>'+
        '<div class="fg" style="grid-column:span 2"><label for="cad-pixchave">Chave</label><input type="text" id="cad-pixchave" value="'+esc(ed?(ed.pixChave||''):'')+'" autocomplete="off"/><div class="fin-err" id="err-cad-pixchave" role="alert"></div></div></div></details>'+
      '<details class="fin-obs"'+(ed&&ed.obs?' open':'')+'><summary>Observação</summary><input type="text" id="cad-obs" aria-label="Observação" value="'+esc(ed?(ed.obs||''):'')+'"/></details>';
  }else if(col==='categorias'){
    campos='<div class="g3" style="margin-bottom:10px">'+
      inp('cad-nome','Nome *',ed?ed.nome:'','Ex: Custas judiciais')+
      '<div class="fg"><label>Tipo *</label><select id="cad-sinal">'+
        '<option value="saida"'+(ed&&ed.sinal==='saida'?' selected':'')+'>Saída</option>'+
        '<option value="entrada"'+(ed&&ed.sinal==='entrada'?' selected':'')+'>Entrada</option>'+
      '</select></div>'+
      inp('cad-obs','Observação',ed?ed.obs:'')+'</div>';
  }
  return '<div class="st" style="margin-top:0">'+(ed?'Alterar ':{empresas:'Nova ',contas:'Nova ',categorias:'Nova '}[col])+{empresas:'empresa',contas:'conta bancária',categorias:'categoria'}[col]+'</div>'+
    '<div class="card"'+(ed?' style="border:1px solid var(--v)"':'')+'>'+campos+
    '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><button class="btn bp" onclick="salvarCadastro(\''+col+'\')">'+(ed?'Salvar':'+ Cadastrar')+'</button>'+
    '<button class="btn" onclick="cancelarCadastro(\''+col+'\')" style="background:#eee;color:var(--mt)">Cancelar</button>'+
    (ed&&col==='empresas'?'<button class="btn" style="margin-left:auto" onclick="inativarCadastro(\'empresas\',\''+ed.id+'\','+(ed.ativo!==false?'false':'true')+')">'+(ed.ativo!==false?'Inativar empresa':'Reativar empresa')+'</button>':'')+'</div><div class="fin-err" id="err-cad-salvar" role="alert" style="margin-top:8px"></div></div>';
}

/* Plano de contas em dois blocos (Entradas e Saídas): nome, quantos lançamentos usam, Alterar à vista e Inativar no ⋯ */
function finCategoriasHtml(){
  var itens=finCad('categorias');
  function usos(o){ return (S.financeiro||[]).filter(function(f){ return f.categoriaId===o.id; }).length; }
  function linha(o){
    var n=usos(o), at=o.ativo!==false;
    return '<div class="fin-plrow'+(at?'':' off')+'" title="'+esc(finTrilha(o))+'">'+
      '<div class="fin-pl-nm"><span class="nm">'+esc(o.nome)+'</span>'+(o.obs?'<span class="sub">'+esc(o.obs)+'</span>':'')+'</div>'+
      (at?'':'<span class="fin-pl-st">Inativa</span>')+
      '<span class="fin-pl-n">'+n+(n===1?' lançamento':' lançamentos')+'</span>'+
      '<div class="fin-pl-ac"><button class="fin-cc-ac" onclick="editarCadastro(\'categorias\',\''+o.id+'\')" title="Alterar a categoria">'+FIN_IC.alt+'<span>Alterar</span></button>'+
        '<details class="fin-more"><summary aria-label="Mais opções de '+esc(o.nome)+'">⋯</summary><div class="fin-more-pop">'+
          '<button class="dg" onclick="inativarCadastro(\'categorias\',\''+o.id+'\','+(at?'false':'true')+')">'+(at?'Inativar categoria':'Reativar categoria')+'</button></div></details></div></div>';
  }
  function bloco(sinal,titulo,cls,icone){
    var lst=itens.filter(function(o){ return (o.sinal==='entrada'?'entrada':'saida')===sinal; });
    var ativas=lst.filter(function(o){ return o.ativo!==false; }), inativas=lst.filter(function(o){ return o.ativo===false; });
    return '<div class="card fin-pl"><div class="fin-pl-hd"><span class="fin-kic '+cls+'">'+icone+'</span><strong>'+titulo+'</strong><span class="n">'+ativas.length+(ativas.length===1?' categoria':' categorias')+'</span></div>'+
      (lst.length?ativas.concat(inativas).map(linha).join(''):'<div class="empty">Nenhuma categoria de '+titulo.toLowerCase()+'.</div>')+'</div>';
  }
  return '<div class="fin-plgrid">'+bloco('entrada','Entradas','k-ent','<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 7L7 17"/><path d="M15 17H7V9"/></svg>')+bloco('saida','Saídas','k-sai','<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M9 7h8v8"/></svg>')+'</div>';
}
function finCadTabela(col){
  if(col==='contas') return finContasPorEmpresaHtml();
  if(col==='categorias') return finCategoriasHtml();
  var itens=finCad(col);
  var cab='<th>Nome</th><th>Tipo</th><th>Lançamentos</th><th>Observação</th>';
  var linhas=itens.map(function(o){
    var n=(S.financeiro||[]).filter(function(f){return f.categoriaId===o.id;}).length;
    return finCadLinha(col,o,'<td><strong>'+esc(o.nome)+'</strong></td>'+
      '<td>'+(o.sinal==='entrada'?'<span class="badge b-venda">Entrada</span>':'<span class="badge b-desp">Saída</span>')+'</td>'+
      '<td>'+n+'</td><td style="font-size:11px">'+esc(o.obs||'')+'</td>');
  }).join('');
  return '<div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr>'+cab+'<th>Status</th><th>Ações</th></tr></thead>'+
    '<tbody>'+(linhas||'<tr><td colspan="6" class="empty">Nenhum registro.</td></tr>')+'</tbody></table></div>';
}
/* Contas bancárias agrupadas por empresa: cada empresa é um cabeçalho com as suas contas embaixo. */
/* Um cartão por conta bancária, agrupado por empresa. Saldo de hoje, situação do caixa e as ações na mão. */
/* O tipo da chave Pix em poucas palavras: CPF ou CNPJ conforme a chave, e-mail, telefone, chave aleatória. */
function finPixCurto(c){
  var tp=c.pixTipo;
  if(tp==='cpfcnpj') return String(c.pixChave||'').replace(/\D/g,'').length===11?'CPF':'CNPJ';
  return {email:'e-mail',telefone:'telefone',aleatoria:'chave aleatória'}[tp]||(FIN_PIX_TIPOS[tp]||'chave').toLowerCase();
}
/* Logos dos bancos, pelo código do banco (embutidos, sem depender de internet). Banco sem logo usa o selo com o código. */
var FIN_BANCO_LOGO={'125':'data:image/png;base64,','033':'data:image/svg+xml;base64,'};
function finContaLinhaHtml(c){
  var ext=finExterna(c), ativa=c.ativo!==false, cod=c.bancoCodigo||((c.banco||c.nome||'?').trim().charAt(0)||'?').toUpperCase(), rg=finFechRegra(c);
  function campo(rot,val,larga){ return (rot&&val)?'<div class="fin-cc-f'+(larga?' w':'')+'"><dt>'+esc(rot)+'</dt><dd>'+esc(val)+'</dd></div>':''; }
  var docRot=c.cnpj?(c.cnpj.replace(/\D/g,'').length===11?'CPF do titular':'CNPJ do titular'):'';
  var pix=(c.pixTipo&&c.pixChave)?c.pixChave:'';
  var fech=ext?'':FIN_FECH_ROTULO[rg]+({diario:', todo dia útil',mensal:', no último dia do mês',nenhum:''}[rg]!==undefined?{diario:', todo dia útil',mensal:', no último dia do mês',nenhum:''}[rg]:', toda '+FIN_DIAS_UTEIS_NOME[finFechDow(c)].toLowerCase());
  var copiar=((c.agencia||c.cnpj||c.pixChave)&&!ext)?'<button class="fin-cc-ac" onclick="finCopiarDados(\''+c.id+'\')" title="Copiar os dados da conta">'+FIN_IC.copia+'<span>Copiar dados</span></button>':'';
  return '<div class="fin-ccard'+(ativa?'':' off')+'" title="'+esc(finTrilha(c))+'">'+
    '<div class="fin-cc-top">'+(FIN_BANCO_LOGO[c.bancoCodigo]?'<div class="fin-cc-logo"><img src="'+FIN_BANCO_LOGO[c.bancoCodigo]+'" alt="'+esc(c.banco?'Banco '+c.banco:'Banco')+'"/></div>':'<div class="fin-cc-bk" aria-hidden="true">'+esc(cod)+'</div>')+
      '<div class="fin-cc-id"><div class="fin-cc-nm">'+esc(c.nome)+'</div>'+(c.banco?'<div class="fin-cc-bn">Banco '+esc(c.banco)+(c.bancoCodigo?' · código '+esc(c.bancoCodigo):'')+'</div>':'')+'</div></div>'+
    '<dl class="fin-cc-dl">'+campo('Agência',c.agencia)+campo('Conta corrente',c.numero)+campo('Titular',c.titular,true)+campo(docRot,c.cnpj,true)+
      campo(pix?'Chave Pix · '+finPixCurto(c):'',pix,true)+campo('Observação',c.obs,true)+'</dl>'+
    '<div class="fin-cc-tags"><span class="fin-cc-fun'+(ext?' ext':'')+'">'+esc(finFuncaoRotulo(c))+'</span>'+(fech?'<span class="fin-cc-fe">'+FIN_IC.cal+'<span>'+esc(fech)+'</span></span>':'')+'</div>'+
    (ativa?'':'<div class="fin-cc-in">Conta inativa</div>')+
    '<div class="fin-cc-ft">'+copiar+
      '<button class="fin-cc-ac" onclick="editarCadastro(\'contas\',\''+c.id+'\')" title="Alterar os dados da conta">'+FIN_IC.alt+'<span>Alterar</span></button>'+
      '<details class="fin-more"><summary aria-label="Mais opções de '+esc(c.nome)+'">⋯</summary><div class="fin-more-pop">'+
        '<button class="dg" onclick="inativarCadastro(\'contas\',\''+c.id+'\','+(ativa?'false':'true')+')">'+(ativa?'Inativar conta':'Reativar conta')+'</button></div></details></div></div>';
}
function finFuncaoRotulo(c){ return FIN_FUNCAO_ROTULO[c.funcao]||FIN_FUNCAO_ROTULO.operacional; }
function finContasPorEmpresaHtml(){
  var todas=finCad('contas'), inativas=[], primeiro=true;
  function ordem(a,b){ return (b.id===FIN_CONTA_PRINCIPAL)-(a.id===FIN_CONTA_PRINCIPAL) || (finExterna(a)?1:0)-(finExterna(b)?1:0) || String(a.nome).localeCompare(String(b.nome),'pt-BR'); }
  var grupos=finCad('empresas').map(function(e){
    var cs=todas.filter(function(c){ return c.empresaId===e.id; }).sort(ordem), ativas=cs.filter(function(c){ return c.ativo!==false; });
    inativas=inativas.concat(cs.filter(function(c){ return c.ativo===false; }));
    var corpo=ativas.length?ativas.map(finContaLinhaHtml).join(''):'<div class="fin-cvazio">Nenhuma conta nesta empresa.'+(e.ativo!==false?' <button class="fin-act" onclick="finCadNovo(\''+e.id+'\')">+ Nova conta nesta empresa</button>':'')+'</div>';
    var h='<div class="fin-egrp'+(e.ativo!==false?'':' off')+'" title="'+esc(finTrilha(e))+'"><strong>'+esc(e.nome)+'</strong>'+
        '<span class="n">'+ativas.length+(ativas.length===1?' conta':' contas')+'</span>'+(e.ativo!==false?'':'<span class="n">empresa inativa</span>')+
        '<button class="fin-act" onclick="editarCadastro(\'empresas\',\''+e.id+'\')">Alterar empresa</button></div>'+
      '<div class="fin-cgrid">'+corpo+'</div>';
    primeiro=false; return h;
  }).join('');
  if(!grupos) return '<div class="card"><div class="empty">Nenhuma empresa. Comece por <b>+ Nova empresa</b>.</div></div>';
  return '<div class="fin-cad" id="fin-cad">'+grupos+'</div>'+(inativas.length?'<details class="fin-inativas"><summary>Contas inativas ('+inativas.length+')</summary><div class="fin-cgrid" style="margin-top:10px">'+inativas.map(finContaLinhaHtml).join('')+'</div></details>':'');
}
function finCadLinha(col,o,tds){
  var ativo=o.ativo!==false;
  return '<tr'+(ativo?'':' style="opacity:.5"')+' title="'+esc(finTrilha(o))+'">'+tds+
    '<td>'+(ativo?'<span class="badge b-venda">ativo</span>':'<span class="badge" style="background:var(--bd);color:var(--mt)">inativo</span>')+'</td>'+
    '<td style="white-space:nowrap">'+
      '<button class="fin-act" title="Alterar" onclick="editarCadastro(\''+col+'\',\''+o.id+'\')">Alterar</button>'+
      '<button class="fin-act" title="'+(ativo?'Inativar':'Reativar')+'" onclick="inativarCadastro(\''+col+'\',\''+o.id+'\','+(ativo?'false':'true')+')">'+(ativo?'Inativar':'Reativar')+'</button>'+
    '</td></tr>';
}

async function salvarCadastro(col){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode realizar esta ação.'); return; }
  function v(id){ var e=document.getElementById(id); return e?(e.value||'').trim():''; }
  var ed=_finCadEdit[col]?finCadById(col,_finCadEdit[col]):null;
  var o={nome:v('cad-nome'),obs:v('cad-obs'),ativo:ed?ed.ativo!==false:true};
  if(ed){ o.id=ed.id; o.createdAt=ed.createdAt; o.createdBy=ed.createdBy; if(ed.aberturaMotivo){ o.aberturaMotivo=ed.aberturaMotivo; o.aberturaAlteradaPor=ed.aberturaAlteradaPor; o.aberturaAlteradaEm=ed.aberturaAlteradaEm; } }
  var erros={};
  if(!o.nome && col!=='contas') erros['cad-nome']='Informe o nome.';
  if(col==='empresas'){
    o.codigo=v('cad-codigo').toUpperCase();
    if(!o.codigo) erros['cad-codigo']='Informe o código da empresa.';
    else if(finCad('empresas').some(function(e){return e.codigo===o.codigo&&e.id!==o.id;})) erros['cad-codigo']='Já existe empresa com o código '+o.codigo+'.';
  }else if(col==='contas'){
    o.banco=v('cad-banco'); o.numero=v('cad-numero'); o.apelido=v('cad-apelido'); o.titular=v('cad-titular');
    o.nome=finNomeConta(o.banco,o.numero,o.apelido);
    if(!o.nome) erros['cad-banco']='Informe o banco e o número da conta, ou um apelido.';
    o.empresaId=v('cad-empresa'); o.funcao=v('cad-funcao')||'operacional';
    o.fechamento=FIN_FECH_ROTULO[v('cad-fech')]?v('cad-fech'):'diario';
    o.fechDiaSemana=o.fechamento==='semanal'?(Number(v('cad-fechdow'))||5):'';
    var rawCod=v('cad-bancocodigo').trim();
    if(rawCod && !/^\d{1,3}$/.test(rawCod)) erros['cad-bancocodigo']='Use até 3 números. Ex: 125.';
    o.bancoCodigo=(rawCod&&/^\d{1,3}$/.test(rawCod))?('000'+rawCod).slice(-3):'';
    o.agencia=v('cad-agencia'); o.cnpj=finFormataDoc(v('cad-cnpj')); o.pixTipo=v('cad-pixtipo'); o.pixChave=v('cad-pixchave');
    if(!o.titular) erros['cad-titular']='Informe o titular (quem assina o extrato).';
    if(!o.empresaId) erros['cad-empresa']='Selecione a empresa.';
    var ddoc=o.cnpj.replace(/\D/g,''); if(o.cnpj && ddoc.length!==11 && ddoc.length!==14) erros['cad-cnpj']='Informe 11 dígitos (CPF) ou 14 (CNPJ).';
    if(o.pixChave && !o.pixTipo) erros['cad-pixchave']='Escolha o tipo da chave.';
    else if(o.pixTipo && !o.pixChave) erros['cad-pixchave']='Digite a chave Pix.';
    else if(o.pixTipo==='email' && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(o.pixChave)) erros['cad-pixchave']='E-mail inválido.';
    else if(o.pixTipo==='telefone' && (o.pixChave.replace(/\D/g,'').length<10 || o.pixChave.replace(/\D/g,'').length>13)) erros['cad-pixchave']='Telefone com DDD, só números. Ex: 48991342526.';
    else if(o.pixTipo==='cpfcnpj' && o.pixChave.replace(/\D/g,'').length!==11 && o.pixChave.replace(/\D/g,'').length!==14) erros['cad-pixchave']='Informe 11 dígitos (CPF) ou 14 (CNPJ).';
    if(o.funcao==='externa'){ o.saldoInicial=0; o.dataInicial=''; }
    else{
      o.saldoInicial=finParseVal(v('cad-saldo'));
      if(isNaN(o.saldoInicial)) erros['cad-saldo']='Valor não reconhecido. Digite como 1.234,56.';
      o.dataInicial=v('cad-datainicial');
    }
  }else if(col==='categorias'){
    o.sinal=v('cad-sinal');
  }
  if(Object.keys(erros).length){ finErros(erros); finErroEm('cad-salvar','Revise os campos marcados.'); return; }
  finErroEm('cad-salvar','');
  /* mudar o saldo de abertura ou a data inicial de uma conta com lançamentos muda o saldo de todos eles: pede confirmação e motivo */
  if(col==='contas' && ed && o.funcao!=='externa'){
    var mudou=Number(o.saldoInicial||0)!==Number(ed.saldoInicial||0) || String(o.dataInicial||'')!==String(ed.dataInicial||'');
    var n=finLancDaConta(ed.id);
    if(mudou && n>0){
      finDialogo({
        titulo:'Alterar o saldo de abertura?',
        texto:'A conta '+esc(ed.nome)+' tem '+n+' lançamento'+(n===1?'':'s')+'. Mudar o saldo de abertura ou a data do saldo muda o saldo de todos eles.',
        motivo:{rotulo:'Motivo da alteração',obrigatorio:true},
        rotuloOk:'Alterar saldo de abertura', perigo:true,
        onOk:function(motivo){ o.aberturaMotivo=motivo; o.aberturaAlteradaPor=currentUser.id; o.aberturaAlteradaEm=new Date().toISOString(); return finGravarCadastro(col,o,ed); }
      });
      return;
    }
  }
  return finGravarCadastro(col,o,ed);
}
async function finGravarCadastro(col,o,ed){
  try{
    await upsertCadastroFin(col,o);
    await fetchCadastrosFin();
    _finCadEdit[col]=null; _finCadAberto=false; _finEmpNova=false;
    showToast(ed?'Cadastro alterado.':'Cadastro criado.');
    navigate(currentPage); finCadVolta();
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}
/* Cadastros: o formulário abre no topo da página; a tela sobe até ele e o cursor vai para o primeiro campo.
   Ao salvar ou cancelar, a tela volta para onde estava (perto do que foi alterado). */
var _finCadScroll=null;
function finCadAbreForm(){
  if(_finCadScroll===null) _finCadScroll=finMainScroll();
  navigate(currentPage); finMainScroll(0);
  setTimeout(function(){ var f=document.querySelector('#main-content .fin-cadform input:not([type=hidden]):not([disabled]), #main-content .fin-cadform select'); if(f&&f.focus){ try{ f.focus({preventScroll:true}); }catch(e){ f.focus(); } } },0);
}
function finCadVolta(){ var y=_finCadScroll; _finCadScroll=null; if(y!==null) finMainScroll(y); }
function editarCadastro(col,id){ _finCadEdit={}; _finCadEdit[col]=id; _finCadAberto=false; _finEmpNova=false; finCadAbreForm(); }
function cancelarCadastro(col){ _finCadEdit[col]=null; _finCadAberto=false; _finEmpNova=false; navigate(currentPage); finCadVolta(); }
function inativarCadastro(col,id,ativo){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode realizar esta ação.'); return; }
  if(!ativo){
    var uso=0;
    if(col==='contas') uso=finLancDaConta(id);
    if(col==='categorias') uso=(S.financeiro||[]).filter(function(f){return f.categoriaId===id;}).length;
    if(col==='empresas') uso=finCad('contas').filter(function(c){return c.empresaId===id;}).length;
    if(uso){
      finDialogo({
        titulo:'Inativar cadastro?',
        texto:'Este cadastro aparece em '+uso+' registro(s). Ao inativar, ele deixa de aparecer nas listas de escolha, mas os registros existentes continuam como estão.',
        rotuloOk:'Inativar',
        onOk:function(){ return finInativarGravar(col,id,ativo); }
      });
      return;
    }
  }
  return finInativarGravar(col,id,ativo);
}
async function finInativarGravar(col,id,ativo){
  try{
    await toggleCadastroFin(col,id,ativo);
    await fetchCadastrosFin();
    navigate(currentPage);
  }catch(e){ showToast('Erro: '+(e.code||e.message)); }
}



// Salva os e-mails / edições do e-mail (assunto, corpo) sem enviar — preserva o histórico.
</script>
