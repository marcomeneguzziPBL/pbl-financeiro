// seção da multa 523 no editor. Estado inicial vem de calc.multa523_*; bases de calcBasesDisponiveis(lancs).
function calcRenderMulta523(calc, lancs){
  var aplicar = !!calc.multa523_aplicar;
  var hon = !!calc.multa523_incluir_honorarios;
  var basesSel = calc.multa523_bases || [];
  var disp = calcBasesDisponiveis(lancs);
  var baseChecks = disp.map(function(b){
    var ck = basesSel.indexOf(b.value)>=0 ? ' checked' : '';
    return '<label style="margin-right:14px;font-weight:400"><input type="checkbox" class="calc-m523-base" value="'+esc(b.value)+'"'+ck+'/> '+esc(b.label)+'</label>';
  }).join('') || '<span style="color:var(--mt)">Nenhuma verba elegível como base</span>';
  return '<div style="border:1px solid var(--bd);border-radius:8px;padding:10px 12px;margin-top:12px">'+
    '<div style="font-weight:700;margin-bottom:6px">Multa art. 523 (cumprimento de sentença)</div>'+
    '<label style="font-weight:400"><input type="checkbox" id="calc-m523-aplicar"'+(aplicar?' checked':'')+'/> Aplicar multa do art. 523</label>'+
    '<div style="margin-top:6px"><label style="font-weight:400"><input type="checkbox" id="calc-m523-hon"'+(hon?' checked':'')+'/> Incluir honorários (+10%)</label></div>'+
    '<div style="margin-top:6px;font-size:13px"><span style="color:var(--mt);margin-right:8px">Incide sobre:</span>'+baseChecks+'</div>'+
  '</div>';
}
// lê o estado da multa 523 dos controles do DOM.
function calcLerMulta523(){
  var ap=document.getElementById('calc-m523-aplicar');
  var ho=document.getElementById('calc-m523-hon');
  var bases=[], els=document.querySelectorAll('.calc-m523-base');
  for(var i=0;i<els.length;i++){ if(els[i].checked) bases.push(els[i].value); }
  return { aplicar: !!(ap&&ap.checked), incluir_honorarios: !!(ho&&ho.checked), bases: bases };
}
