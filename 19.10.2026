function calcPresetOptions(which, sel){
  var lista = (S.calcPresets && S.calcPresets[which]) || [];
  return lista.map(function(x){
    return '<option value="'+esc(x.codigo)+'"'+(x.codigo===sel?' selected':'')+'>'+esc(x.label)+'</option>';
  }).join('');
}
