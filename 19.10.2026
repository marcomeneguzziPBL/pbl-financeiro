}
function applyStoredTheme(){
  try{
    var t=localStorage.getItem('pbl_theme');
    if(t==='dark'){
      document.body.classList.add('dark');
      var btn=document.getElementById('btn-theme');
      if(btn) btn.textContent='☀️';
    }
  }catch(e){}
}
function normAdv(s){return String(s||'').trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');}

// Verifica se uma data (YYYY-MM-DD ou YYYY-MM) cai dentro do periodo selecionado no topo.
function inPeriodo(dataStr){
  if(!dataStr) return false;
  var s = String(dataStr).slice(0,10);
  var p = S.periodo || {};
  if(p.mode === 'ano'){
    return s.slice(0,4) === String(p.ano);
  } else if(p.mode === 'custom'){
    var di = p.dataIni || '';
    var df = p.dataFim || '';
    return (!di || s >= di) && (!df || s <= df);
  }
  // mes (default)
  return s.slice(0,7) === (p.mes || S.mes || '');
}

// Retorna array de meses (YYYY-MM) que compoem o periodo atual.
// Usado para iterar comissoes mes-a-mes em modo ano/custom.
function mesesDoPeriodo(){
  var p = S.periodo || {};
  if(p.mode === 'mes'){
    return [p.mes || S.mes];
  }
  if(p.mode === 'ano'){
    var ano = p.ano || new Date().getFullYear();
    var out = [];
    for(var m=1; m<=12; m++){ out.push(String(ano)+'-'+String(m).padStart(2,'0')); }
    return out;
  }
  // custom
  var di = p.dataIni || '';
  var df = p.dataFim || '';
  if(!di || !df) return [];
  var ini = new Date(di+'T00:00:00');
  var fim = new Date(df+'T00:00:00');
  if(isNaN(ini) || isNaN(fim) || ini > fim) return [];
  var out2 = [];
  var cur = new Date(ini.getFullYear(), ini.getMonth(), 1);
  var stop = new Date(fim.getFullYear(), fim.getMonth(), 1);
  while(cur <= stop){
    out2.push(cur.getFullYear()+'-'+String(cur.getMonth()+1).padStart(2,'0'));
    cur.setMonth(cur.getMonth()+1);
  }
  return out2;
}
function readXlsx(file,cb){var r=new FileReader();r.onload=function(e){var wb=XLSX.read(e.target.result,{type:'array',cellDates:true});var ws=wb.Sheets[wb.SheetNames[0]];cb(XLSX.utils.sheet_to_json(ws,{defval:''}));};r.readAsArrayBuffer(file);}
function fmtDate(d){if(!d)return'—';var dt=new Date(d+'T00:00:00');if(isNaN(dt))return d;return dt.toLocaleDateString('pt-BR');}
function todayStr(){return new Date().toISOString().slice(0,10);}
function closeModal(){_ppCur='';document.getElementById('modal-root').innerHTML='';}
function showModal(html,opts){opts=opts||{};var cls='modal'+(opts.wide?' modal-wide':'');var top=opts.top||!!document.getElementById('calc-editor-overlay');var bg='modal-bg'+(top?' mt':'');document.getElementById('modal-root').innerHTML='<div class="'+bg+'"><div class="'+cls+'">'+html+'</div></div>';}
function updPeriod(){
  var modeEl = document.getElementById('periodo-mode');
  var mesEl  = document.getElementById('periodo-mes');
  var anoEl  = document.getElementById('periodo-ano');
  var diEl   = document.getElementById('periodo-di');
  var dfEl   = document.getElementById('periodo-df');
  var lbl    = document.getElementById('period-lbl');
  if(!modeEl) return;
  var mode = modeEl.value || 'mes';
  S.periodo.mode = mode;
  // Toggle visibilidade dos inputs
  if(mesEl) mesEl.style.display = mode==='mes' ? '' : 'none';
  if(anoEl) anoEl.style.display = mode==='ano' ? '' : 'none';
  if(diEl)  diEl.style.display  = mode==='custom' ? '' : 'none';
  if(dfEl)  dfEl.style.display  = mode==='custom' ? '' : 'none';
  if(mode==='mes'){
    var m = (mesEl && mesEl.value) || S.periodo.mes || new Date().toISOString().slice(0,7);
    S.periodo.mes = m; S.mes = m;
    var d = new Date(m+'-02');
    if(lbl) lbl.textContent = d.toLocaleDateString('pt-BR',{month:'long',year:'numeric'});
  } else if(mode==='ano'){
    var ano = (anoEl && parseInt(anoEl.value,10)) || S.periodo.ano || new Date().getFullYear();
    S.periodo.ano = ano;
    if(lbl) lbl.textContent = 'Ano ' + ano;
  } else { // custom
    var di = (diEl && diEl.value) || S.periodo.dataIni || '';
    var df = (dfEl && dfEl.value) || S.periodo.dataFim || '';
    S.periodo.dataIni = di; S.periodo.dataFim = df;
    if(lbl) lbl.textContent = (di?fmtDate(di):'...')+' → '+(df?fmtDate(df):'...');
  }
  // Se estiver na dashboard, re-renderiza com filtro do novo mês
  if(document.getElementById('kpi-total')||document.getElementById('gn-kpi-proc')){
    if(_dashTab==='geracao'){renderGnDashCharts();}
    else{var data=buildDashData();renderDashCharts(data);}
  } else if(currentPage && currentPage!=='geracaonegocios'){
    // Demais páginas filtradas por período (Cumprimento de Sentença, Comissões, Reliquidados...):
    // trocar o mês/ano só muda o estado; sem re-render a página não atualiza e os dados parecem "sumir".
    navigate(currentPage);
  }
}

// ── LOGIN ──────────────────────────────────────────────────
function showLoginError(msg){
  var el=document.getElementById('login-err');
  if(el){el.textContent=msg;el.style.display='block';}
}
async function doLogin(){
  try{
    var provider=new fb.GoogleAuthProvider();
    provider.setCustomParameters({hd:'pblcompra.com'});
    var res=await fb.signInWithPopup(fb.auth,provider);
    var email=(res.user.email||'').toLowerCase();
    if(!email.endsWith('@pblcompra.com')){
      await fb.signOut(fb.auth);
      showLoginError('Acesso restrito a contas @pblcompra.com.');
    }
    // onAuthStateChanged cuida do restante do fluxo.
  }catch(e){
    showLoginError('Falha no login: '+(e.message||e.code||'erro desconhecido'));
  }
}
async function doLogout(){
  try{ unsubscribeAll(); }catch(e){}
  try{await fb.signOut(fb.auth);}catch(e){}
  currentUser=null;
}
async function fetchCollection(name){
  var snap=await fb.getDocs(fb.collection(fb.db,name));
  return snap.docs.map(function(d){return Object.assign({id:d.id}, d.data());});
}
// ── Realtime listeners (Plano 2C Fase E) ─────────────────────────
var _unsubs = [];
function subscribeCollection(name, applyFn, affectedPages, queryRef){
  var unsub = fb.onSnapshot(queryRef || fb.collection(fb.db, name), function(snap){
    var data = snap.docs.map(function(d){ return Object.assign({id:d.id}, d.data()); });
    applyFn(data);
    var modalEl = document.getElementById('modal-root');
    var modalOpen = modalEl ? (modalEl.innerHTML.trim() !== '') : false;
    if(!modalOpen && affectedPages.indexOf(currentPage) >= 0){
      try{ navigate(currentPage); }catch(e){ console.error('re-render snapshot:', e); }
    }
  }, function(err){
    // Alguns perfis (ex.: gestor_calculos, perito_contabil) não têm acesso a todas as coleções.
    // Negações de permissão são esperadas — ignora silenciosamente; loga outros erros.
    if(!err || err.code !== 'permission-denied') console.error('snapshot '+name+':', err);
  });
  _unsubs.push(unsub);
}
function unsubscribeAll(){
  _unsubs.forEach(function(u){ try{ u(); }catch(e){} });
  _unsubs = [];
}
function startCollectionListeners(){
  unsubscribeAll();
  subscribeCollection('processos',    function(a){ S.processos = a; },                                              ['processos','dashboard','resumo','reliquidados','distrib','previsao','relliq2','relcomp','relgeral','relpend']);
  subscribeCollection('leads',        function(a){ S.leads = a; },                                                   ['processos']);
  subscribeCollection('lawyers',      function(a){ S.lawyers = ordenaLawyers(a); },                                   ['operacional','advogados','usuarios','comissoesgestoras']);
  subscribeCollection('gestoras',     function(a){ S.gestoras = a; },                                               ['operacional','comissoesgestoras','usuarios','minhascomissoes']);
  subscribeCollection('liquidacoes',  function(a){ S.liqManual = a; },                                              ['reliquidados','resumo','dashboard']);
  subscribeCollection('lancamentos',  function(a){ S.financeiro = a; },                                             ['financeiro','fluxocaixa','resumo']);
  subscribeCollection('contas',       function(a){ S.contas = a; },                                                 ['financeiro']);
  // Advogado só enxerga as próprias validações (onde é o validador); demais perfis veem tudo.
  var _valQ = (currentUser && currentUser.role==='lawyer' && currentUser.lawyerId)
    ? fb.query(fb.collection(fb.db,'validacoes'), fb.where('advogadoId','==',currentUser.lawyerId))
    : null;
  subscribeCollection('validacoes',   function(a){ S.distribValidacao = a; },                                       ['distrib','comissoesgestoras'], _valQ);
  subscribeCollection('campanhas',    function(a){ S.campanhas = a; },                                              ['campanhas','comissoesgestoras','advogados']);
  subscribeCollection('entries',      function(a){ var m={}; a.forEach(function(e){m[e.id]=e;}); S.entries = m; },  ['operacional','dashboard','advogados','comissoesgestoras','resumo']);
  subscribeCollection('users',        function(a){ S.users = a; },                                                  ['usuarios']);
  subscribeCollection('pendingUsers', function(a){ S.pendingUsers = a; },                                           ['usuarios']);
  subscribeCollection('notificacoes', function(a){ S.notificacoes = a; },                                           ['notificacoes']);
  subscribeCollection('diligencias',  function(a){ S.diligencias = a; },                                            ['diligencias']);
  subscribeCollection('agenda',       function(a){ S.agenda = a; },                                                 ['agenda','processos']);
  subscribeCollection('skillObs',     function(a){ S.skillObs = a; },                                               ['processos']);
  // Canal disciplinar: coleção própria, legível só pela gestão. Assinar sem o teste de papel
  // só geraria um permission-denied silencioso para todo mundo — o handler de erro o engole.
  if(podeVerAtuacao(currentUser)) subscribeCollection('skillErros', function(a){ S.skillErros = a; }, ['processos']);
  subscribeCollection('notif1',       function(a){ S.notif1 = a; },                                                  ['notif1']);
  subscribeCollection('gnDilig',      function(a){ S.gnDilig = a; },                                                 ['dashboard']);
  subscribeCollection('manual',        function(a){ S.manual = a; },                                                 ['diligencias']);
  subscribeCollection('calculos',     function(a){ S.calculos = a; },                                                ['advogados','comissao','minhascomissoes','resumo','comissoesgestoras','cumprimentosentenca']);
  subscribeCollection('partes',       function(a){ S.partes = a; if(typeof refreshPartesDatalist==='function') refreshPartesDatalist(); }, ['partes']);
  subscribeCollection('analisesIA',   function(a){ S.analisesIA = a; }, ['ferramentas']);
  // Prazo de acompanhamento das diligências (config global).
  fb.getDoc(fb.doc(fb.db,'config','diligencias')).then(function(s){ if(s.exists()&&s.data().prazoDias) S.diligPrazoDias=s.data().prazoDias; }).catch(function(){});
  // Valor unitário do cálculo de cumprimento de sentença (config global).
  fb.getDoc(fb.doc(fb.db,'config','calculos')).then(function(s){ if(s.exists()&&s.data().valorUnit!=null) S.calcValorUnit=s.data().valorUnit; }).catch(function(){});
}
async function callFn(name, data){
  // timeout do cliente 15min (padrão do SDK é 70s) — a análise de IA por autos completos
  // pode levar vários minutos. Como o backend grava o resultado no Firestore, isto é só
  // uma folga para o .catch não marcar erro antes de a análise concluir.
  var fn = fb.httpsCallable(fb.fn, name, { timeout: 900000 });
  var res = await fn(data || {});
  return res.data;
}
var ROLE_OPTIONS = [
  {value:'admin',           label:'Admin'},
  {value:'gestora',         label:'Gestora'},
  {value:'supervisora',     label:'Supervisora'},
  {value:'lawyer',          label:'Advogado'},
  {value:'gestor_calculos', label:'Gestor de Cálculos'},
  {value:'perito_contabil', label:'Perito Contábil'},
  {value:'juridico',        label:'Jurídico'},
  {value:'comercial',       label:'Comercial'}
];
function roleLabel(r){var o=ROLE_OPTIONS.find(function(x){return x.value===r;});return o?o.label:r;}
function lawyerName(id){if(!id)return '—';var l=(S.lawyers||[]).find(function(x){return x.id===id;});return l?l.name:id;}
// Recebimentos agora vivem em subcoleção processos/{id}/recebimentos. Carregados globalmente via collectionGroup.
async function loadRecebimentos(){
  try{
    var qs=await fb.getDocs(fb.collectionGroup(fb.db,'recebimentos'));
    var map={};
    qs.forEach(function(d){ var pid=d.ref.parent.parent.id; (map[pid]=map[pid]||[]).push(Object.assign({id:d.id},d.data())); });
    S.recebByProc=map;
  }catch(e){ S.recebByProc=S.recebByProc||{}; console.error('loadRecebimentos:',e); }
}
// Leitura ÚNICA de recebimentos no app (dual-read: subcoleção quando houver; senão array legado do doc).
function recebOf(p){ if(!p) return []; var s=S.recebByProc&&S.recebByProc[p.id]; return (s&&s.length)?s:(p.recebimentos||[]); }
// Status EFETIVO: reflete "Liquidado Total" sempre que houver uma liquidação TOTAL do processo,
// mesmo que a gravação do status no processo tenha sido bloqueada pelas regras do banco.
function procStatusEff(p){
  if(!p) return 'pendente';
  if(p.status==='liquidado_total') return 'liquidado_total';
  var temTotal=(S.liqManual||[]).some(function(m){return (m.processoId===p.id||m.processo===p.numero) && String(m.liquidacao||'').toLowerCase()==='total';});
  if(!temTotal){ temTotal=(recebOf(p)||[]).some(function(r){var b=String(r.banco||'');return /liquida/i.test(b)&&/total/i.test(b);}); }
  return temTotal?'liquidado_total':(p.status||'pendente');
}
async function upsertProcesso(p){
  var id=p.id || fb.doc(fb.collection(fb.db,'processos')).id;
  var payload=Object.assign({}, p, {
    id:id,
    valor:Number(p.valor)||0,
    mes:p.mes || S.mes,
    updatedAt:fb.serverTimestamp(),
    updatedBy:currentUser.id
  });
  if(!p.createdAt){
    payload.createdAt=fb.serverTimestamp();
    payload.createdBy=currentUser.id;
  }
  await fb.setDoc(fb.doc(fb.db,'processos',id), payload, {merge:true});
  return id;
}
async function deleteProcesso(id){
  await fb.deleteDoc(fb.doc(fb.db,'processos',id));
}
async function persistProcessoFields(id, fields){
  var payload=Object.assign({}, fields, {
    updatedAt:fb.serverTimestamp(),
    updatedBy:currentUser.id
  });
  await fb.updateDoc(fb.doc(fb.db,'processos',id), payload);
}
// ── Helpers de write para Liquidações, Lançamentos, Entries, Validações ────
async function upsertLiquidacao(liq){
  var id = liq.id || fb.doc(fb.collection(fb.db,'liquidacoes')).id;
  var payload = Object.assign({}, liq, {
    id:id,
    valor: Number(liq.valor)||0,
    creditos: Math.max(0, parseInt(liq.creditos,10)||0),
    data: liq.data || '',
    updatedAt: fb.serverTimestamp(),
    updatedBy: currentUser.id
  });
  if(!liq.createdAt){ payload.createdAt=fb.serverTimestamp(); payload.createdBy=currentUser.id; }
  await fb.setDoc(fb.doc(fb.db,'liquidacoes',id), payload, {merge:true});
  return id;
}
async function deleteLiquidacao(id){
  await fb.deleteDoc(fb.doc(fb.db,'liquidacoes',id));
}
async function upsertLancamento(l){
  var id = l.id || fb.doc(fb.collection(fb.db,'lancamentos')).id;
  var payload = Object.assign({}, l, {
    id:id,
    valor: Number(l.valor)||0,
    updatedAt: fb.serverTimestamp(),
    updatedBy: currentUser.id
  });
  if(!l.createdAt){ payload.createdAt=fb.serverTimestamp(); payload.createdBy=currentUser.id; }
  await fb.setDoc(fb.doc(fb.db,'lancamentos',id), payload, {merge:true});
  return id;
}
async function deleteLancamento(id){
  await fb.deleteDoc(fb.doc(fb.db,'lancamentos',id));
}
async function persistEntry(lawyerId, fields){
  var ref = fb.doc(fb.db,'entries',lawyerId);
  var payload = Object.assign({}, fields, {
    id: lawyerId,
    updatedAt: fb.serverTimestamp(),
    updatedBy: currentUser.id
  });
  await fb.setDoc(ref, payload, {merge:true});
}
async function addDistribValidacao(d){
  var id = d.id || fb.doc(fb.collection(fb.db,'validacoes')).id;
  var payload = Object.assign({}, d, {
    id:id,
    createdAt: fb.serverTimestamp(),
    createdBy: currentUser.id
  });
  await fb.setDoc(fb.doc(fb.db,'validacoes',id), payload);
  return id;
}
async function deleteDistribValidacao(id){
  await fb.deleteDoc(fb.doc(fb.db,'validacoes',id));
}
async function upsertCampanha(c){
  var id = c.id || fb.doc(fb.collection(fb.db,'campanhas')).id;
  var payload = Object.assign({}, c, {
    id:id,
    valor: Number(c.valor)||0,
    updatedAt: fb.serverTimestamp(),
    updatedBy: currentUser.id
  });
  if(!c.createdAt){ payload.createdAt=fb.serverTimestamp(); payload.createdBy=currentUser.id; }
  await fb.setDoc(fb.doc(fb.db,'campanhas',id), payload, {merge:true});
  return id;
}
async function deleteCampanha(id){
  await fb.deleteDoc(fb.doc(fb.db,'campanhas',id));
}
async function persistGestoraMeta(mes, fields){
  var payload = Object.assign({}, fields, {
    id: mes,
    updatedAt: fb.serverTimestamp(),
    updatedBy: currentUser.id
  });
  await fb.setDoc(fb.doc(fb.db,'gestorasMetas',mes), payload, {merge:true});
}
async function persistGnSessao(data){
  await fb.setDoc(fb.doc(fb.db,'geracaoNegocios','current'), {
    data: data,
    updatedAt: fb.serverTimestamp(),
    updatedBy: currentUser.id
  });
}
function startAuthListener(){
  fb.onAuthStateChanged(fb.auth, async function(authUser){
    var loginScreen=document.getElementById('login-screen');
    var appScreen=document.getElementById('app-screen');
    if(!authUser){
      currentUser=null;
      if(appScreen)appScreen.style.display='none';
      if(loginScreen)loginScreen.style.display='flex';
      return;
    }
    try{
      var snap=await fb.getDoc(fb.doc(fb.db,'users',authUser.uid));
      if(!snap.exists() || snap.data().active!==true){
        await fb.signOut(fb.auth);
        showLoginError('Usuário não autorizado ou inativo. Contate o administrador.');
        return;
      }
      currentUser=Object.assign({id:authUser.uid}, snap.data());
      try{
        await fb.updateDoc(fb.doc(fb.db,'users',authUser.uid),{lastLoginAt:fb.serverTimestamp()});
      }catch(e){}
      try{ S.users=await fetchCollection('users'); }catch(e){ S.users=[]; }
      try{ S.pendingUsers=await fetchCollection('pendingUsers'); }catch(e){ S.pendingUsers=[]; }
      try{ S.notificacoes=await fetchCollection('notificacoes'); }catch(e){ S.notificacoes=[]; }
      if(loginScreen)loginScreen.style.display='none';
      if(appScreen)appScreen.style.display='flex';
      await loadData();
      initApp();
      try{ startCollectionListeners(); }catch(e){ console.error('listeners:', e); }
    }catch(e){
      showLoginError('Erro ao carregar perfil: '+(e.message||e.code));
    }
  });
}
if(window.fb){startAuthListener();}
else{window.addEventListener('fb-ready', startAuthListener);}

// ── INIT ───────────────────────────────────────────────────
function initApp(){
  applyStoredTheme();
  // Inicializa controles do seletor de periodo a partir do S.periodo persistido.
  var pp = S.periodo || {mode:'mes',mes:S.mes,ano:new Date().getFullYear(),dataIni:'',dataFim:''};
  var modeEl = document.getElementById('periodo-mode');
  var mesEl  = document.getElementById('periodo-mes');
  var anoEl  = document.getElementById('periodo-ano');
  var diEl   = document.getElementById('periodo-di');
  var dfEl   = document.getElementById('periodo-df');
  if(modeEl) modeEl.value = pp.mode || 'mes';
  if(mesEl)  mesEl.value  = pp.mes  || S.mes || new Date().toISOString().slice(0,7);
  if(anoEl)  anoEl.value  = pp.ano  || new Date().getFullYear();
  if(diEl)   diEl.value   = pp.dataIni || '';
  if(dfEl)   dfEl.value   = pp.dataFim || '';
  updPeriod();
  var badge='';
  if(isFullAccess(currentUser)) badge='<span class="admin-badge">Admin</span>';
  else if(currentUser.role==='gestora') badge='<span class="admin-badge" style="background:#185FA5">Gestora</span>';
  else if(currentUser.role==='supervisora') badge='<span class="admin-badge" style="background:#8b5cf6">Supervisora</span>';
  else if(currentUser.role==='gestor_calculos') badge='<span class="admin-badge" style="background:#0d9488">Gestor de Cálculos</span>';
  document.getElementById('hdr-user').innerHTML=currentUser.name+badge;
  document.getElementById('btn-calc-main').style.display=isFullAccess(currentUser)?'':'none';
  buildSidebar();navigate('dashboard');
  calcInjetarMenuGestor(); // menu "UFIR-RJ (TJRJ)" — só gestores do Cálculo (perfil do calc-service)
}

