<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PBL — Gestão de Créditos Judiciais</title>
<script>
(function(){
  "use strict";
  function nowTs(){ return { seconds: Math.floor(Date.now()/1000), nanoseconds:0, toDate:function(){return new Date();} }; }
  function genId(){ return "id"+Math.random().toString(36).slice(2,10)+Date.now().toString(36).slice(-4); }
  var COLS=Object.create(null);
  function coll(p){ if(!COLS[p])COLS[p]={}; return COLS[p]; }

      coll("users")["emu-fin"]={name:"Financeiro (standalone)",email:"financeiro@pblcompra.com",role:"admin",active:true};

  /* ---- helpers de path ---- */
  function partsOf(p){ return p.split("/"); }
  function parentColl(docPath){ var i=docPath.lastIndexOf("/"); return docPath.slice(0,i); }
  function idOf(docPath){ var i=docPath.lastIndexOf("/"); return docPath.slice(i+1); }
  function mkSnap(cp,id){ var c=COLS[cp]||{}; var has=Object.prototype.hasOwnProperty.call(c,id); var pa=partsOf(cp);
    return { id:id, exists:function(){return has;}, data:function(){return has?Object.assign({},c[id]):undefined;},
      ref:{ id:id, path:cp+"/"+id, parent:{ id:pa[pa.length-1], parent:{ id: pa.length>=2?pa[pa.length-2]:null } } } }; }
  function docsOf(cp){ var c=COLS[cp]||{}; return Object.keys(c).map(function(id){return mkSnap(cp,id);}); }
  function resolve(data){ if(data==null||typeof data!=="object")return data; var out=Array.isArray(data)?[]:{}; for(var k in data){ var v=data[k]; out[k]=(v&&v.__st)?nowTs():v; } return out; }

  function collection(db){ var s=[].slice.call(arguments,1); return {__c:true, path:s.join("/")}; }
  function doc(a){ if(a&&a.__c){ var id=arguments[1]||genId(); return {__d:true, path:a.path+"/"+id, id:id}; } var s=[].slice.call(arguments,1); return {__d:true, path:s.join("/"), id:s[s.length-1]}; }
  function getDoc(ref){ return Promise.resolve(mkSnap(parentColl(ref.path), idOf(ref.path))); }
  function setDoc(ref,data,opts){ var cp=parentColl(ref.path),id=idOf(ref.path),c=coll(cp),d=resolve(data); c[id]=(opts&&opts.merge)?Object.assign({},c[id]||{},d):d; return Promise.resolve(); }
  function updateDoc(ref,patch){ var cp=parentColl(ref.path),id=idOf(ref.path),c=coll(cp); c[id]=Object.assign({},c[id]||{},resolve(patch)); return Promise.resolve(); }
  function deleteDoc(ref){ var cp=parentColl(ref.path),id=idOf(ref.path); if(COLS[cp])delete COLS[cp][id]; return Promise.resolve(); }
  function getDocs(ref){ var docs=docsOf(ref.path); return Promise.resolve({docs:docs,size:docs.length,empty:docs.length===0,forEach:function(f){docs.forEach(f);}}); }
  function serverTimestamp(){ return {__st:true}; }
  function writeBatch(){ var ops=[]; return { set:function(r,d,o){ops.push(function(){return setDoc(r,d,o);});return this;}, update:function(r,p){ops.push(function(){return updateDoc(r,p);});return this;}, "delete":function(r){ops.push(function(){return deleteDoc(r);});return this;}, commit:function(){return Promise.all(ops.map(function(f){return f();}));} }; }

  var ADMIN={ uid:"emu-fin", displayName:"Financeiro (standalone)", email:"financeiro@pblcompra.com" };
  var auth={ currentUser:ADMIN };
  function onAuthStateChanged(a,cb){ setTimeout(function(){ cb(ADMIN); },0); return function(){}; }

  window.fb={ auth:auth, db:{__db:true},
    collection:collection, doc:doc, getDoc:getDoc, getDocs:getDocs,
    setDoc:setDoc, updateDoc:updateDoc, deleteDoc:deleteDoc,
    serverTimestamp:serverTimestamp, writeBatch:writeBatch, onAuthStateChanged:onAuthStateChanged };
  window.__STANDALONE__=true;
  window.dispatchEvent(new Event("fb-ready"));
})();
</script>
<style>@font-face{font-family:"Inter";font-style:normal;font-weight:400 700;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --v:#062E2B;--vt:#062E2B;--vd:#0B4540;--vl:#E4F2EB;
  --d:#CB974F;--dl:#FEF3E2;--dm:#D7AE76;
  --bd:#DFE9E4;--tx:#14231F;--mt:#5A6A66;
  --bg:#F4F8F6;--red:#A33A2E;--redl:#F8EEEC;
  --sb:240px;
  --sans:"Inter","Segoe UI",system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif;
  --card:#FFFFFF;--input:#FFFFFF;--row-alt:#F8FBF9;--row-hov:#EEF6F2;--shadow:rgba(6,46,43,.10);
  --blue:#0B4540;--bluel:#E4F2EB;--green:#1F6F50;--greenl:#E4F2EB;
  --divider:#EAF1ED;
  --amber:#835C27;--amberl:#FEF3E2;--novo:#FEF3E2;--diabg:#F2F8F5;
}
body.dark{
  /* Fundo geral mais claro que o quase-preto antigo, e tipografia bem mais clara */
  --v:#1E5A55;--vt:#8CCFC4;--vd:#17463F;--vl:#173431;
  --d:#D6A45C;--dl:#3a3016;--dm:#E4B66F;
  --bd:#2D403D;--tx:#f1f5f4;--mt:#a8bdb8;
  --bg:#0D1716;--red:#F29A8F;--redl:#33201E;
  --card:#15211F;--input:#1D2B29;--row-alt:#1A2725;--row-hov:#223230;--shadow:rgba(0,0,0,.5);
  --blue:#8CCFC4;--bluel:#173431;--green:#7DD3A9;--greenl:#142E24;
  --divider:#263634;
  --amber:#E4B66F;--amberl:#2E2818;--novo:#1C2B29;--diabg:#1F2B29;
}
/* Aplicações específicas para o tema dark — cobre elementos com cores hard-coded */
body.dark .card,
body.dark .filter-bar{background:var(--card)!important;border-color:var(--bd)!important;color:var(--tx)}
body.dark .sidebar{background:var(--card)!important;border-color:var(--bd)!important}
body.dark .nav-item{color:var(--tx)}
body.dark .nav-item:hover,body.dark .nav-item.active{background:var(--vl);color:var(--vt)}
body.dark .fg input,body.dark .fg select,body.dark .fg textarea,
body.dark input[type=text],body.dark input[type=number],body.dark input[type=password],body.dark input[type=email],body.dark input[type=date],body.dark input[type=month],body.dark .search-input{
  background:var(--input)!important;color:var(--tx)!important;border-color:var(--bd)!important
}
body.dark input::placeholder,body.dark textarea::placeholder{color:#7a918c}
body.dark .btn{background:var(--input);border-color:var(--bd);color:var(--tx)}
body.dark .btn:hover{background:var(--vl)}
body.dark .bp{background:var(--v);color:#fff;border-color:var(--v)}
body.dark .bp:hover{background:var(--vd)}
/* Tabelas */
body.dark .tbl{background:var(--card)}
body.dark .tbl td{color:var(--tx);border-bottom-color:var(--divider)}
body.dark .tbl th{background:transparent;color:var(--mt)}
body.dark .tbl tr:nth-child(even) td{background:var(--row-alt)}
body.dark .tbl tr:hover td{background:var(--row-hov)}

/* Métricas */
body.dark .mc{background:var(--vl)}
body.dark .mc.gold{background:var(--dl)}
body.dark .mc.blue{background:var(--bluel)}
body.dark .mc.red{background:var(--redl)}
body.dark .mc.green{background:var(--greenl)}
body.dark .mv.blue{color:var(--blue)}
body.dark .mv.green{color:var(--green)}
/* Badges */

body.dark .b-venda{background:var(--greenl);color:var(--green)}
body.dark .b-desp{background:var(--redl);color:var(--red)}
/* Linhas e divisórias */
body.dark .div{border-color:var(--divider)!important}

/* Toggle do dark mode no header */
body.dark .btn-logout{background:rgba(255,255,255,.12)}
body.dark .btn-logout:hover{background:rgba(255,255,255,.2)}
/* Garantir que elementos sem variáveis (cores codificadas) ainda fiquem legíveis */

body.dark [style*="background:var(--row-alt)"]{background:var(--row-alt)!important}

body{font-family:var(--sans);background:var(--bg);color:var(--tx);font-size:14px}

/* ── APP SHELL ──────────────────────────────────── */
.app-wrap{display:flex;flex-direction:column;height:100vh;overflow:hidden}

/* ── HEADER ─────────────────────────────────────── */
.hdr{background:var(--v);display:flex;align-items:stretch;height:56px;flex-shrink:0;z-index:300}
.hdr-brand{width:var(--sb);flex-shrink:0;display:flex;align-items:center;gap:10px;padding:0 16px;border-right:1px solid rgba(255,255,255,.12)}
.hdr-right{flex:1;display:flex;align-items:center;gap:10px;padding:0 20px}
.hdr-user{color:rgba(255,255,255,.85);font-size:12px;background:rgba(255,255,255,.15);padding:4px 12px;border-radius:20px}
input[type=month]{padding:5px 9px;border-radius:6px;border:none;font-size:12px;background:rgba(255,255,255,.18);color:#fff;outline:none;cursor:pointer}
input[type=month]::-webkit-calendar-picker-indicator{filter:invert(1);opacity:.7}
.btn-logout{background:rgba(255,255,255,.15);color:#fff;border:none;padding:6px 12px;border-radius:6px;font-size:12px;cursor:pointer}
.btn-logout:hover{background:rgba(255,255,255,.25)}
.admin-badge{background:var(--d);color:#fff;font-size:10px;font-weight:700;padding:2px 7px;border-radius:10px;margin-left:6px}

/* ── BODY ───────────────────────────────────────── */
.body-area{display:flex;flex:1;overflow:hidden}

/* ── SIDEBAR ────────────────────────────────────── */
.sidebar{width:var(--sb);background:var(--card);border-right:1px solid var(--bd);display:flex;flex-direction:column;overflow-y:auto;flex-shrink:0}
.sb-section{padding:16px 12px 4px;font-size:10px;font-weight:700;color:var(--mt);text-transform:uppercase;letter-spacing:.08em}
.nav-item{display:flex;align-items:center;gap:9px;padding:8px 14px;cursor:pointer;border-radius:7px;margin:1px 8px;font-size:13px;color:var(--tx);border:none;background:none;width:calc(100% - 16px);text-align:left;transition:background .12s,color .12s;white-space:nowrap}
.nav-item:hover{background:var(--vl);color:var(--vt)}
.nav-item.active{background:var(--vl);color:var(--vt);font-weight:700}
.nav-item svg{width:16px;height:16px;flex-shrink:0;opacity:.55}
.nav-item.active svg,.nav-item:hover svg{opacity:1}
.sb-children{display:none;padding-bottom:4px}
.sb-children.open{display:block}
.sb-children .nav-item{padding-left:36px;font-size:12px;margin-left:12px;width:calc(100% - 20px)}

/* Menu recolhido: faixa estreita só com os ícones; seções viram divisórias e os grupos se abrem. */
.sidebar{transition:width .18s ease}

/* ── MAIN ───────────────────────────────────────── */
.main{flex:1;overflow-y:auto;padding:24px 28px;min-width:0}

/* ── CARDS / FORM ───────────────────────────────── */
.page-title{font-size:22px;font-weight:600;letter-spacing:-.015em;color:var(--vt);display:flex;align-items:center;gap:10px;margin-bottom:18px}
.page-title svg{width:20px;height:20px;flex-shrink:0}
.st{font-size:12px;font-weight:700;color:var(--mt);text-transform:uppercase;letter-spacing:.08em;margin:22px 0 10px}
.st:first-child{margin-top:0}
.card{background:var(--card);border:.5px solid var(--bd);border-radius:10px;padding:16px 20px;margin-bottom:14px;color:var(--tx)}
.fg{display:flex;flex-direction:column;gap:4px;flex:1;min-width:110px}
.fg label{font-size:12px;color:var(--mt)}
.fg input,.fg select,.fg textarea{border:.5px solid var(--bd);border-radius:6px;padding:7px 10px;font-size:13px;color:var(--tx);background:var(--input);outline:none;width:100%;transition:border-color .15s}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--v)}
/* Checkbox/radio não são campos de largura total: mantêm tamanho natural e não herdam o estilo de input de texto. */
.fg input[type=checkbox],.fg input[type=radio]{width:16px;height:16px;flex:0 0 auto;padding:0;border-radius:4px;accent-color:var(--v);cursor:pointer}
.fg textarea{resize:vertical;min-height:70px}

.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}

/* ── BUTTONS ────────────────────────────────────── */
.btn{padding:7px 15px;border-radius:6px;font-size:13px;border:.5px solid var(--bd);background:var(--card);cursor:pointer;color:var(--tx);font-weight:500;white-space:nowrap}
.btn:hover{background:var(--vl)}
.bp{background:var(--v);color:#fff;border-color:var(--v)}
.bp:hover{background:var(--vd)}

/* ── TABLE ──────────────────────────────────────── */
.tbl{width:100%;border-collapse:collapse;font-size:12px}
.tbl th{background:transparent;color:var(--mt);font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:10px 12px;text-align:left;white-space:nowrap;border-bottom:1px solid var(--bd)}
.tbl th.r{text-align:right}
.tbl td{padding:7px 11px;border-bottom:.5px solid var(--divider);vertical-align:middle;color:var(--tx)}
.tbl td.r{text-align:right}
.tbl tr:last-child td{border-bottom:none}
.tbl tr:nth-child(even) td{background:var(--row-alt)}
.tbl tr:hover td{background:var(--row-hov)}

/* ── BADGES ─────────────────────────────────────── */
.badge{display:inline-block;font-size:10px;font-weight:700;padding:2px 7px;border-radius:8px}

.b-venda{background:var(--greenl);color:var(--green)}
.b-desp{background:var(--redl);color:var(--red)}

.mc{background:var(--vl);border-radius:8px;padding:13px 15px}
.mc.gold{background:var(--dl)}
.mc.blue{background:var(--bluel)}
.mc.red{background:var(--redl)}
.mc.green{background:var(--greenl)}
.ml{font-size:12px;color:var(--mt);margin-bottom:4px}
.mv{font-size:20px;font-weight:600;color:var(--vt)}
.mv.gold{color:var(--amber)}
.mv.blue{color:var(--blue)}
.mv.red{color:var(--red)}
.mv.green{color:var(--green)}

.empty{font-size:13px;color:var(--mt);padding:12px 0;text-align:center}
.toast{position:fixed;bottom:20px;right:20px;background:var(--v);color:#fff;padding:10px 18px;border-radius:8px;font-size:13px;font-weight:600;opacity:0;transition:opacity .3s;pointer-events:none;z-index:1200}
.toast.show{opacity:1}
.filter-bar{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin-bottom:14px;padding:14px 16px;background:var(--card);border:.5px solid var(--bd);border-radius:10px}
.search-input{border:.5px solid var(--bd);border-radius:6px;padding:7px 10px;font-size:13px;outline:none;flex:1;min-width:160px;background:var(--input);color:var(--tx)}
.search-input:focus{border-color:var(--v)}

/* ── PRINT ──────────────────────────────────────── */
@media print{
  .hdr,.sidebar,.no-print,.filter-bar,.btn{display:none!important}
  .body-area{display:block}
  .main{padding:0;overflow:visible}
  body{background:#fff}
  .card{border:1px solid #ccc;border-radius:0}
  .tbl th{background:#063D38!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
@media(max-width:768px){
  :root{--sb:200px}
  
  .g3{grid-template-columns:1fr 1fr}
  .main{padding:16px}
}

/* ── UX: erro ao lado do campo, ações com texto, números alinhados, diálogo próprio ── */
.fin-err{display:none;color:var(--red);font-size:12px;margin-top:3px;font-weight:600}
.fin-invalid{border-color:var(--red)!important;background:var(--redl)!important}
.tbl td.r,.tbl th.r{font-variant-numeric:tabular-nums}
.fin-act{background:none;border:0;color:var(--blue);cursor:pointer;font-size:12px;padding:3px 7px;border-radius:4px}
.fin-act:hover{background:var(--bluel)}
.fin-act.danger{color:var(--red)}
.fin-act.danger:hover{background:var(--redl)}
button:focus-visible,select:focus-visible,input:focus-visible,a:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
.fin-ov{position:fixed;top:0;right:0;bottom:0;left:0;background:rgba(15,23,20,.42);display:flex;align-items:center;justify-content:center;z-index:1000}
.fin-dlg{background:var(--card);color:var(--tx);border-radius:10px;padding:22px 24px;width:min(460px,92vw);box-shadow:0 12px 40px rgba(0,0,0,.25)}
.fin-dlg h3{margin:0 0 8px;font-size:16px}
.fin-dlg p{margin:0 0 14px;font-size:13px;line-height:1.5}
.fin-dlg .acoes{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}
.btn.danger{background:var(--red);border-color:var(--red);color:#fff}
body.dark .btn.danger{color:#2a0d0d}
.btn[style*="background:#eee"]{background:var(--card)!important;border:1px solid var(--bd)!important;color:var(--tx)!important}
/* cartões de saldo: uma linha quando cabe, para a lista aparecer sem rolar */
.fin-kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:14px}
.fin-kpis .mc{padding:10px 12px}
.fin-kpis .ml{font-size:12px}
.fin-kpis .mv{font-size:17px;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
@media(min-width:1100px){.fin-kpis{grid-template-columns:repeat(5,minmax(0,1fr))}}
@media(max-width:768px){.fin-kpis{grid-template-columns:1fr 1fr}}
.btn.ress{background:var(--card);border:1px solid var(--amber);color:var(--amber)}
.btn:disabled{opacity:.45;cursor:not-allowed}

/* campos dentro de tabelas com o mesmo desenho dos campos dos formulários */
.tbl input[type=text],.tbl input[type=date],.tbl input[type=month]{padding:7px 9px;border:1px solid var(--bd);border-radius:6px;background:var(--input);color:var(--tx);font:inherit;font-size:13px}
.tbl input[type=text]:focus,.tbl input[type=date]:focus{border-color:var(--v);outline:none}
.fin-filtros select,.fin-filtros .search-input{font-size:13px}
/* celular e tela estreita */
@media(max-width:900px){
  .body-area{flex-direction:column!important;overflow:visible}
  .sidebar{width:100%!important;flex-direction:row!important;overflow-x:auto;overflow-y:hidden;border-right:0!important;border-bottom:1px solid var(--bd);padding:4px 6px;flex-shrink:0}
  .sidebar .sb-section{display:none!important}
  .sidebar .sb-children{display:flex!important;padding:0}
  .sidebar .nav-item,.sidebar .sb-children .nav-item{width:auto!important;margin:0 2px!important;padding:8px 12px!important;white-space:nowrap;font-size:13px}
  .sidebar .nav-item svg{display:none}
  .main{padding:12px!important}
  .hdr-right{padding:0 10px!important;gap:6px!important}
  .hdr-user{max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
}
@media(max-width:700px){
  .fin-scroll{flex-wrap:nowrap!important;overflow-x:auto;padding-bottom:4px}
  .fin-scroll>*{flex-shrink:0}
  .card>table.tbl{min-width:640px}
}
@media(max-width:560px){
  .g5,.g3{grid-template-columns:1fr!important}
  .g3 .fg{grid-column:auto!important}
  .fin-kpis{grid-template-columns:1fr 1fr}
  .fin-kpis .mv{font-size:15px}
  .fin-seg button{padding:6px 9px!important;font-size:12px!important}
  .page-title{font-size:17px}
}

@media(max-width:560px){.hdr-user{display:none!important}}

#fcx-data{padding:8px 10px;border:1px solid var(--bd);border-radius:6px;background:var(--input);color:var(--tx);font:inherit}

#fcx-data:focus{border-color:var(--v);outline:none}

/* menu: Financeiro é o grupo; "Cadastros" é uma divisão dentro dele */
.sb-sub{margin:12px 12px 2px;padding-top:10px;border-top:1px solid var(--bd);font-size:10px;font-weight:700;color:var(--mt);text-transform:uppercase;letter-spacing:.08em}

@media(max-width:900px){.sidebar .sb-sub{display:none!important}}

/* paleta PBL: filete dourado no cabeçalho e no item de menu ativo */
.hdr{box-shadow:inset 0 -3px 0 var(--d)}
.nav-item.active{box-shadow:inset 3px 0 0 var(--d)}
.hdr-emp{display:flex;align-items:center;gap:8px;margin-right:auto;font-size:12px;color:rgba(255,255,255,.8)}
.hdr-emp select{background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.35);border-radius:8px;padding:6px 10px;font:inherit;font-size:13px;font-weight:600;cursor:pointer}
.hdr-emp select option{color:#1b1f1e;background:#fff}
.hdr-emp select:focus-visible{outline:2px solid var(--dm);outline-offset:1px}
/* cartões de conta */
.fin-cartao{text-align:left;padding:10px 14px;border:1px solid var(--bd);background:var(--card);color:var(--tx);border-radius:10px;cursor:pointer;min-width:176px;display:flex;flex-direction:column;gap:1px}
.fin-cartao:hover{border-color:var(--d)}
.fin-cartao:focus-visible{outline:2px solid var(--d);outline-offset:1px}
.fin-cartao.on{border:2px solid var(--v);padding:9px 13px;color:#fff}
.fin-cartao.on .n,.fin-cartao.on .s{color:#fff}
.fin-cartao.on .e{color:rgba(255,255,255,.72)}
.fin-cartao.on .fin-cx{color:#fff;border-color:rgba(255,255,255,.35)}
.fin-cartao.on .fin-cx:hover{border-color:#fff}
.fin-cartao .n{font-size:13px;font-weight:700;padding-right:24px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fin-cartao .e{font-size:12px;color:var(--mt)}
.fin-cartao .s{font-size:18px;font-weight:700;margin:5px 0 6px;font-variant-numeric:tabular-nums}
.fin-cx:hover{filter:brightness(.96)}
@media(max-width:560px){.hdr-emp label{display:none}.hdr-emp{min-width:0}.hdr-emp select{max-width:92px;padding:6px 4px;font-size:12px;text-overflow:ellipsis}.hdr-brand{padding:0 8px!important}.hdr-brand svg{width:86px;height:auto}.hdr-right .btn-logout{padding:5px 8px}.fin-cartao{min-width:150px}}

/* contas bancárias: cartões por empresa */
.fin-egrp{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:6px 0 10px;font-size:15px}
.fin-egrp .n{font-size:12px;color:var(--mt)}
.fin-egrp .fin-act{margin-left:auto;font-size:12px}
.fin-egrp.off{opacity:.6}

.fin-more{position:relative;flex-shrink:0}
.fin-more summary{list-style:none;cursor:pointer;padding:2px 8px;border-radius:6px;font-size:18px;line-height:1;color:var(--mt)}
.fin-more summary::-webkit-details-marker{display:none}
.fin-more summary:hover,.fin-more[open] summary{background:var(--row-hov)}
.fin-more-pop{position:absolute;right:0;top:100%;z-index:30;background:var(--card);border:1px solid var(--bd);border-radius:8px;box-shadow:0 6px 18px var(--shadow);padding:4px;min-width:130px;display:flex;flex-direction:column}
.fin-more-pop button{border:none;background:none;text-align:left;padding:7px 10px;border-radius:6px;cursor:pointer;font-size:13px;color:var(--tx);font-family:inherit}
.fin-more-pop button:hover{background:var(--row-hov)}
.fin-more-pop button.dg{color:var(--red)}

.fin-inativas{margin:0 0 18px}.fin-inativas summary{cursor:pointer;font-size:13px;color:var(--mt);margin-bottom:10px}

/* formulário da conta */
.fin-nomeprev{font-size:12px;color:var(--mt);margin:-2px 0 12px}.fin-nomeprev strong{color:var(--tx)}
.fin-sub{font-size:12px;font-weight:700;color:var(--mt);margin:2px 0 6px;text-transform:uppercase;letter-spacing:.06em}
.fin-radios{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px}
.fin-radio{display:flex;flex-direction:column;gap:2px;border:1px solid var(--bd);border-radius:10px;padding:9px 12px;cursor:pointer;position:relative}
.fin-radio input{position:absolute;opacity:0;pointer-events:none}
.fin-radio .t{font-size:13px;font-weight:700}.fin-radio .d{font-size:12px;color:var(--mt)}
.fin-radio.on{border:2px solid var(--vt);padding:8px 11px;background:var(--vl)}
.fin-radio:focus-within{outline:2px solid var(--d);outline-offset:1px}
.fin-obs{margin:2px 0 12px}.fin-obs summary{cursor:pointer;font-size:12px;color:var(--blue)}.fin-obs input[type=text]{margin-top:6px;width:100%;padding:8px 10px;border:1px solid var(--bd);border-radius:6px;background:var(--input);color:var(--tx);font:inherit}.fin-obs input[type=text]:focus{border-color:var(--v);outline:none}

/* saldo inicial e final, em negrito e à direita, antes e depois da lista */

.fin-dica{font-size:12px;color:var(--mt);margin:0 0 12px}
.fin-cartao{position:relative}
.fin-cartao .chk{position:absolute;top:9px;right:10px;width:18px;height:18px;border-radius:50%;border:1.5px solid var(--bd);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:transparent}
.fin-cartao.on .chk{background:#fff;border-color:#fff;color:var(--v)}
.fin-cartao.off{opacity:.6}
/* lista de lançamentos: colunas de largura fixa, texto longo quebra dentro da célula */
.fin-tbl{table-layout:fixed}
.card>table.fin-tbl{min-width:880px}
.card>table.fin-tbl-m{min-width:960px}
.fin-dt{white-space:nowrap;font-variant-numeric:tabular-nums}
.fin-tbl td.fin-dt,.fin-tbl th.fin-dt{padding-right:6px}
.fin-tbl{font-size:14px}
.fin-tbl th{font-size:12px;padding:12px 14px}
.fin-tbl td{padding:11px 14px}
.fin-tbl .fin-act{font-size:13px;padding:4px 8px}
.fin-cel{display:flex;align-items:center;gap:6px;min-width:0}
.fin-ell{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
.fin-cont{font-size:12px;color:var(--mt);margin-top:3px}
/* ações da linha: ícones discretos, à direita; ficam em destaque ao passar o mouse na linha */
.fin-ac{text-align:right;white-space:nowrap;padding-left:6px!important;padding-right:10px!important}
.fin-ic{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border:0;background:none;border-radius:6px;color:var(--mt);cursor:pointer;vertical-align:middle;opacity:.55;padding:0}
.fin-ic.vazio{cursor:default;opacity:0}

.fin-tbl tr:hover .fin-ic,.fin-ic:focus-visible{opacity:1}
.fin-ic:not(.vazio):hover{background:var(--row-hov);color:var(--tx)}
.fin-ic.dg:hover{background:var(--redl);color:var(--red)}
.fin-ic:focus-visible{outline:2px solid var(--d);outline-offset:1px}

/* Cores com uma regra só: marca (verde-escuro e dourado) = estrutura e ação; verde e vermelho = só o número do dinheiro; o resto é neutro. */
.fin-kpis .mc{background:var(--card);border:1px solid var(--bd);border-radius:12px}
.fin-kpis .ml{font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:var(--mt)}
.fin-kpis .mv{font-weight:600;color:var(--tx)}
.fin-kpis .mv.green{color:var(--green)}
.fin-kpis .mv.red{color:var(--red)}
.fin-kpis .mv.blue{color:var(--tx)}
.fin-kpis .mc.gold{box-shadow:inset 0 2px 0 var(--d)}
.fin-kpis .mv.gold{color:var(--vt);font-weight:700}
body.dark .fin-kpis .mc{background:var(--card)}
.btn.fin-nv{background:var(--card);border:1px solid var(--bd);color:var(--tx);display:inline-flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;height:32px;line-height:1;text-align:center}
.btn.fin-nv:hover{border-color:var(--v)}
.badge.b-venda,.badge.b-desp{background:none;padding:0;font-size:12px}
.badge.b-venda{color:var(--green)}
.badge.b-desp{color:var(--red)}
body.dark .badge.b-venda,body.dark .badge.b-desp{background:none}
.fin-tbl tbody tr:nth-child(even) td{background:transparent}
.fin-tbl tbody tr:hover td{background:var(--row-hov)}
/* situação do caixa: um ponto de cor e texto normal */
.fin-cx{display:inline-flex;align-items:center;gap:6px;align-self:flex-start;font-size:11px;font-weight:600;border:1px solid var(--bd);border-radius:999px;padding:3px 10px;background:none;color:var(--tx);cursor:pointer;font-family:inherit}
.fin-cx::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--bd);flex-shrink:0}
.fin-cx.pend::before{background:var(--d)}
.fin-cx.ok::before{background:var(--green)}
.fin-cx.ress::before{background:var(--red)}
.fin-cx:hover{border-color:var(--v)}
/* Tipografia por função: Inter em tudo (desenhada para tela); o que muda é o recurso da fonte para cada uso. */
.fin-dlg h3{font-weight:600;font-size:18px;letter-spacing:-.01em}
.sb-section,.sb-sub,.st,.tbl th,.fin-kpis .ml{font-weight:600;letter-spacing:.06em;text-transform:uppercase}
.fin-kpis .ml{font-size:12px}
.fin-tbl td.r,.fin-kpis .mv,.fin-cartao .s,.mv{font-variant-numeric:tabular-nums}
.fin-tbl td.r strong{font-weight:600}
.cod,#cad-agencia,#cad-numero,#cad-cnpj,#cad-pixchave{font-feature-settings:"ss02","zero","tnum","cv03","cv04"}
/* Fechar caixa */
.fcx-contas{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px;margin-bottom:14px}
.fcx-conta{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:12px 14px;cursor:pointer}
.fcx-conta.on{border:2px solid var(--v);padding:11px 13px;color:#fff}
.fcx-conta.on .n,.fcx-conta.on .s,.fcx-conta.on .cx{color:#fff}
.fcx-conta.on .e{color:rgba(255,255,255,.72)}
.fcx-conta.on .cx.info::before{background:rgba(255,255,255,.6)}
.fcx-conta .n{font-weight:700;font-size:14px}
.fcx-conta .e{font-size:12px;color:var(--mt)}
.fcx-conta .s{font-size:18px;font-weight:600;margin:4px 0;font-variant-numeric:tabular-nums}
.fcx-conta .cx{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600}
.fcx-conta .cx::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--bd);flex-shrink:0}
.fcx-conta .cx.pend::before{background:var(--d)}
.fcx-conta .cx.ok::before{background:var(--green)}
.fcx-conta .cx.ress::before{background:var(--red)}

.fcx-pn input[type=text]{width:100%;padding:9px 12px;border:1px solid var(--bd);border-radius:8px;background:var(--card);color:var(--tx);font-family:inherit;font-size:14px}
.fcx-pn input[type=text]:focus{outline:2px solid var(--d);outline-offset:1px;border-color:var(--v)}
.fcx-pn input.fcx-in{font-size:18px;text-align:right}
.fcx-topo select{padding:6px 10px;border:1px solid var(--bd);border-radius:8px;background:var(--card);color:var(--tx);font-family:inherit;font-size:13px}

.fcx-pn{padding:16px 18px}
.fcx-h{font-size:13px;font-weight:600;color:var(--mt);margin:0 0 10px}
.fcx-topo{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}
.fcx-link{font-size:13px;color:var(--blue)}

.fcx-lb{display:block;font-size:12px;color:var(--mt);margin:12px 0 4px}
.fcx-in{width:100%;font-size:18px;text-align:right;font-variant-numeric:tabular-nums}

.fcx-hint{font-size:12px;color:var(--mt);min-height:16px;margin-top:2px}
.fcx-acao{margin-top:12px}
.fcx-reg{font-size:12px;color:var(--mt);background:var(--vl);border-radius:8px;padding:8px 10px;margin-bottom:10px}

.fcx-th{table-layout:fixed;width:100%}
.fcx-th td{font-size:14px}
.fcx-th .fcx-link{font-size:14px}
.fcx-th td.r{font-variant-numeric:tabular-nums}
@media(max-width:1100px){.fcx-th{min-width:880px}}

/* Fechar caixa: título do dia, quadro do fim de mês e tabela do período */

.fcx-sub{font-size:12px;color:var(--mt)}
.fcx-mut{color:var(--mt)}

.fcx-ab{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600}
.fcx-ab::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--d)}

.fcx-fechar{padding:4px 12px;font-size:13px}
.fcx-th tbody tr:nth-child(even) td{background:transparent}
.fcx-th tbody tr.fcx-sel td{background:var(--vl)}

body.dark .fin-tbl tbody tr:nth-child(even) td,body.dark .fcx-th tbody tr:nth-child(even) td{background:transparent}
body.dark .fcx-th tbody tr.fcx-sel td{background:var(--vl)}

/* Fechar caixa: duas partes */
.fcx-nav{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.fcx-seta{width:34px;height:34px;border:1px solid var(--bd);border-radius:8px;background:var(--card);cursor:pointer;font-size:18px;color:var(--tx);line-height:1}
.fcx-seta:disabled{opacity:.4;cursor:default}
.fcx-nav input[type=date],.fcx-nav input[type=month]{padding:7px 10px;border:1px solid var(--bd);border-radius:8px;background:var(--card);color:var(--tx);font-family:inherit;font-size:14px}
.fcx-nav .fcx-link{margin-left:auto}
.fcx-pn>.fcx-nav{margin-bottom:6px}
.fcx-trio{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:14px}
.fcx-grande{font-size:26px;font-weight:600;line-height:42px;font-variant-numeric:tabular-nums}
.fcx-linha2{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:end;margin-top:14px}
@media(max-width:900px){.fcx-trio{grid-template-columns:minmax(0,1fr)}.fcx-linha2{grid-template-columns:minmax(0,1fr)}}

/* Exportar e Importar */
.fin-exp{position:relative;display:inline-block}
.fin-exp summary{list-style:none;cursor:pointer;user-select:none}
.fin-exp summary::-webkit-details-marker{display:none}
.fin-menu{position:absolute;right:0;top:calc(100% + 4px);min-width:270px;background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:6px;z-index:60;box-shadow:0 8px 24px rgba(0,0,0,.14)}
.fin-menu button{display:block;width:100%;text-align:left;background:none;border:0;border-radius:6px;padding:9px 12px;font:inherit;font-size:13px;color:var(--tx);cursor:pointer}
.fin-menu button:hover,.fin-menu button:focus-visible{background:var(--row-hov)}
.fin-imp-dlg{width:min(980px,94vw)}
.fin-imp-rol{max-height:52vh;overflow:auto;border:1px solid var(--bd);border-radius:8px}
.fin-imp td,.fin-imp th{padding:8px 10px}
.fin-imp td.r{white-space:nowrap}
.fin-imp-res{margin:6px 0 10px;font-size:14px}
/* os controles usam a mesma fonte do sistema (o navegador, por padrão, põe Arial nos botões) */
button,input,select,textarea{font-family:inherit;font-feature-settings:inherit}
.fin-exp summary::after{content:'';width:5px;height:5px;border:solid currentColor;border-width:0 1.5px 1.5px 0;transform:rotate(45deg) translate(-1px,-1px)}
/* Cadastros › Empresas e contas: uma linha por conta, só dados cadastrais */
.fin-tbtns{display:flex;gap:8px;flex-wrap:wrap}

.fin-cvazio{padding:16px 14px;font-size:13px;color:var(--mt)}

.g5{display:grid;grid-template-columns:1.3fr .8fr 1fr 1.2fr 1.3fr;gap:10px}
@media(max-width:900px){.g5{grid-template-columns:1fr 1fr}}
/* Lançar: formulário numa linha só, para a lista continuar à vista */
.fin-linb{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.fin-link{background:none;border:0;color:var(--blue);font-size:12px;cursor:pointer;padding:6px 8px;border-radius:4px}
.fin-link:hover{background:var(--bluel)}

/* Lançar: o formulário é a tela mais importante naquele momento; grande, no topo e com a cor do tipo */
.fin-formc{--fc:var(--mt);position:relative;padding:22px 28px 20px;margin:0 0 22px;border:1px solid var(--fc);border-top:6px solid var(--fc);border-radius:14px;background:var(--card);background:color-mix(in srgb,var(--fc) 4%,var(--card));box-shadow:0 14px 34px rgba(6,46,43,.16),0 2px 6px rgba(6,46,43,.08)}
.fin-formc.t-entrada{--fc:var(--green)}
.fin-formc.t-saida{--fc:var(--red)}
body.dark .fin-formc{border:1px solid var(--fc);border-top:6px solid var(--fc);border-color:var(--fc)!important;background:color-mix(in srgb,var(--fc) 9%,var(--card))!important;box-shadow:0 14px 34px rgba(0,0,0,.55)}   /* o tema escuro tem uma regra !important para todos os cartões; esta precisa do mesmo peso */

.fin-fh{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 18px}
.fin-ft{display:flex;align-items:center;gap:12px;min-width:0}
.fin-ft h2{margin:0;font-size:22px;font-weight:600;letter-spacing:-.01em}
.fin-fchip{display:inline-block;padding:4px 11px;border-radius:6px;background:var(--fc);color:#fff;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.fin-fx{width:38px;height:38px;border:0;border-radius:50%;background:none;color:var(--mt);font-size:26px;line-height:1;cursor:pointer;font-family:inherit}
.fin-fx:hover{background:var(--row-hov);color:var(--tx)}
.fin-formc .fg label{font-size:13px;font-weight:500;color:var(--tx)}
.fin-formc .fg input,.fin-formc .fg select{height:46px;padding:0 14px;font-size:15px;border:1px solid var(--bd);border-radius:8px}
.fin-formc .fg input:focus,.fin-formc .fg select:focus{border-color:var(--fc);box-shadow:0 0 0 3px color-mix(in srgb,var(--fc) 20%,transparent)}
.fin-formc .btn{height:48px;padding:0 28px;font-size:15px;border-radius:8px}
.fin-formc .fin-dica{margin-left:auto;font-size:12px;color:var(--mt)}

@media(max-width:900px){.fin-fg12>div{grid-column:span 12}.fin-formc .fin-dica{margin-left:0}}
/* Lista com busca (no lugar do select do navegador) */
.fin-cb{position:relative;width:100%}
.fin-cb-sel{position:absolute;left:0;top:0;width:1px;height:1px;opacity:0;pointer-events:none;border:0;padding:0}
.fin-cb-campo{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;box-sizing:border-box;min-height:34px;padding:7px 10px;border:.5px solid var(--bd);border-radius:6px;background:var(--input);color:var(--tx);font-size:13px;cursor:pointer;user-select:none}
.fin-cb-campo .txt{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fin-cb-campo .txt.ph{color:var(--mt)}
.fin-cb-campo .seta{flex:0 0 auto;width:6px;height:6px;border:solid var(--mt);border-width:0 1.5px 1.5px 0;transform:rotate(45deg) translate(-2px,-2px)}
.fin-cb-campo:focus,.fin-cb.aberto .fin-cb-campo{outline:none;border-color:var(--v)}
.fin-cb-campo.fin-invalid{border-color:var(--red)}
.fin-formc .fin-cb-campo{height:46px;padding:0 14px;font-size:15px;border:1px solid var(--bd);border-radius:8px}
.fin-formc .fin-cb-campo:focus,.fin-formc .fin-cb.aberto .fin-cb-campo{border-color:var(--fc);box-shadow:0 0 0 3px color-mix(in srgb,var(--fc) 20%,transparent)}
.fin-formc .fin-cb-campo.fin-invalid{border-color:var(--red)}
.fin-cb-pop{position:absolute;left:0;top:calc(100% + 6px);z-index:80;min-width:100%;width:max-content;max-width:min(520px,92vw);padding:8px;border:1px solid var(--bd);border-radius:12px;background:var(--card);box-shadow:0 14px 34px rgba(0,0,0,.2)}
.fin-cb-pop[hidden]{display:none}
.fin-cb-bi{width:100%;box-sizing:border-box;height:38px;padding:0 12px;border:1px solid var(--bd);border-radius:8px;background:var(--input);color:var(--tx);font:inherit;font-size:14px;outline:none}
.fin-cb-bi:focus{border-color:var(--v)}
.fin-cb-lst{max-height:260px;overflow:auto;margin-top:6px}
.fin-cb-op{padding:9px 10px;border-radius:8px;font-size:14px;color:var(--tx);cursor:pointer}
.fin-cb-op.atual{font-weight:600}
.fin-cb-op.ativo{background:var(--row-hov)}
.fin-cb-op mark{background:rgba(190,142,77,.32);color:inherit;border-radius:3px;padding:0 1px}
.fin-cb-vazio{padding:12px 10px;font-size:13px;color:var(--mt)}
.fin-cb-dica{margin-top:6px;padding:8px 10px 2px;border-top:1px solid var(--divider);font-size:12px;color:var(--mt)}
/* Lista: o cabeçalho das colunas fica à vista ao rolar (onde a tela é larga o bastante para não rolar de lado) */
.fin-tw{padding:0;overflow-x:auto}
@media(min-width:1140px){.fin-tw:not(.m){overflow:visible}}
@media(min-width:1260px){.fin-tw.m{overflow:visible}}
.fin-tw .fin-tbl thead th{position:sticky;top:-24px;z-index:6;height:40px;padding-top:0;padding-bottom:0;background:var(--card);border-bottom:0;box-shadow:inset 0 -1px 0 var(--bd)}
.fin-tw .fin-tbl thead th:first-child{border-top-left-radius:12px}
.fin-tw .fin-tbl thead th:last-child{border-top-right-radius:12px}
body.dark .fin-tw .fin-tbl thead th{background:var(--card)}
.fin-tbl tr.fin-dia td{padding:9px 14px;background:var(--diabg);font-size:12px;font-weight:700}
.fin-tbl tbody tr.fin-dia:hover td{background:var(--diabg)}
.fin-dia .n{font-weight:400;color:var(--mt)}
.fin-dia td.fin-ac{padding:0 8px;text-align:right}
.fin-sit{border:0;background:none;cursor:pointer;font:inherit;font-size:12px;font-weight:600;color:var(--tx);padding:3px 8px;border-radius:12px;white-space:nowrap}
.fin-sit::before{content:'';display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:var(--bd)}
.fin-sit.s-ok::before{background:var(--green)}
.fin-sit.s-ab::before{background:var(--d)}
.fin-sit.s-ress::before{background:var(--red)}
.fin-sit:hover{background:var(--row-hov)}
/* Formulário: o saldo atual e o último lançamento, antes de lançar */
.fin-ctx{display:flex;flex-wrap:wrap;gap:6px 32px;align-items:baseline;margin:0 0 16px;padding:11px 16px;border-radius:10px;background:var(--card);background:color-mix(in srgb,var(--fc) 7%,var(--card));font-size:13px;color:var(--mt)}
.fin-ctx b{color:var(--tx);font-weight:600;font-variant-numeric:tabular-nums}
.fin-ctx b.sd{font-size:16px}
.fin-ctx b.neg{color:var(--red)}
.fin-ctx .cn{color:var(--mt)}
.fin-ctx .v{font-weight:600;font-variant-numeric:tabular-nums}
.fin-ctx .v.ent{color:var(--green)}
.fin-ctx .v.sai{color:var(--red)}
/* Transferência: Enviada | Recebida, e a opção de registrar a outra ponta junto */
.fin-sent{display:inline-flex;border:1px solid var(--bd);border-radius:10px;overflow:hidden;margin:0 0 16px}
.fin-sent button{font:inherit;font-size:14px;padding:9px 24px;border:0;background:var(--card);color:var(--tx);cursor:pointer}
.fin-sent button+button{border-left:1px solid var(--bd)}
.fin-sent button.on{background:var(--v);color:#fff;font-weight:600}
.fin-par{display:flex;align-items:center;gap:10px;margin:0 0 16px;padding:11px 14px;border-radius:8px;background:color-mix(in srgb,var(--fc) 7%,var(--card));font-size:13px;color:var(--tx);cursor:pointer}
.fin-par input{width:16px;height:16px;margin:0;flex:none}
.fin-par .sub{color:var(--mt)}
.fin-semcp{color:var(--amber);font-weight:500}
/* Saldo final em destaque, como o cartão da conta marcada */
.fin-kpis .mc.hero,body.dark .fin-kpis .mc.hero{border-color:var(--v);box-shadow:none;position:relative;overflow:hidden}
.fin-kpis .mc.hero .ml{color:rgba(255,255,255,.72)}
.fin-kpis .mc.hero .mv{color:#fff}
/* Avisos: nos cartões e na faixa acima da lista */
.fin-cxs{display:flex;flex-wrap:wrap;gap:6px;align-self:flex-start}
.fin-cx.alerta{color:var(--amber);border-color:color-mix(in srgb,var(--amber) 45%,var(--bd))}
.fin-cx.alerta::before{background:var(--amber)}
.fin-cx.fixo{cursor:default}
.fin-cartao.on .fin-cx.alerta{color:#F3D9A9;border-color:rgba(243,217,169,.55)}
.fin-cartao.on .fin-cx.alerta::before{background:#F3D9A9}
.fin-aten{display:flex;align-items:center;flex-wrap:wrap;gap:8px 10px;margin:0 0 12px;padding:10px 14px;border:1px solid color-mix(in srgb,var(--amber) 35%,var(--bd));border-radius:12px;background:var(--amberl);color:var(--amber);font-size:13px}
.fin-aten .t{font-weight:600;margin-right:4px}
.fin-aten button{font:inherit;font-size:12px;border:1px solid var(--bd);background:var(--card);color:var(--tx);border-radius:999px;padding:4px 11px;cursor:pointer}
.fin-aten button:hover{border-color:var(--v)}
.fin-aten .mais{font-size:12px}
/* Cabeçalho da aba com as ações à direita */
.fin-topo{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:18px}
.fin-topo .page-title{margin-bottom:0}
.fin-acoes{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.fin-olho{display:inline-flex;align-items:center;gap:6px;border-color:transparent;background:none;color:var(--mt)}
.fin-olho:hover{color:var(--tx);border-color:var(--bd)}
body.dark .fin-olho{background:none;border-color:transparent;color:var(--mt)}
body.dark .fin-olho:hover{color:var(--tx);border-color:var(--bd)}
.fin-olho svg{width:16px;height:16px;flex:none}
/* Ocultar valores */
body.fin-oculto .fin-cartao .s,body.fin-oculto .fin-kpis .mv,body.fin-oculto #fin-lista td.r,body.fin-oculto .fin-ctx .sd,body.fin-oculto .fin-ctx .dep,body.fin-oculto .fin-ctx .v,body.fin-oculto .fin-mv,body.fin-oculto .fcx-grande,body.fin-oculto .fcx-th td.r{filter:blur(7px);user-select:none}
/* Algarismos: 6 e 9 abertos (mais fáceis de distinguir do 8 e do 0) */
body{font-feature-settings:"cv03" 1,"cv04" 1}
.fcx-feito{display:flex;align-items:center;gap:10px;margin-top:14px;padding:10px 14px;border-radius:10px;font-size:14px}
.fcx-feito.ok{background:color-mix(in srgb,var(--green) 9%,var(--card));color:var(--tx)}
.fcx-feito.ress{background:color-mix(in srgb,var(--red) 8%,var(--card));color:var(--tx)}
.fcx-feito .ic{width:22px;height:22px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#fff;flex:none}
.fcx-feito.ok .ic{background:var(--green)}
.fcx-feito.ress .ic{background:var(--red)}
.fcx-mudou{margin-top:12px;padding:10px 14px;border-radius:10px;background:var(--amberl);color:var(--amber);font-size:13px}
.fcx-feito-acao{margin-top:12px}
/* Copiar os dados da conta, discreto no canto do cartão */
.fin-copia{position:absolute;right:8px;bottom:8px;width:28px;height:28px;display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:7px;background:none;color:var(--mt);opacity:.7;cursor:pointer;padding:0}
.fin-copia svg{width:15px;height:15px}
.fin-cartao .fin-cxs{margin-right:30px}   /* o aviso do caixa nunca encosta no botão de copiar */
.fin-copia:hover,.fin-copia:focus-visible{opacity:1;color:var(--tx);background:color-mix(in srgb,var(--tx) 8%,transparent)}
.fin-cartao.on .fin-copia{color:#fff}
.fin-cartao.on .fin-copia:hover,.fin-cartao.on .fin-copia:focus-visible{background:rgba(255,255,255,.14)}

.fcx-acs{display:inline-flex;align-items:center;gap:6px}
.fin-sit.s-fer::before{background:var(--mt)}
.fin-orig{font:inherit;font-size:11px;font-weight:500;line-height:1.4;padding:1px 8px;margin-left:6px;border:1px solid var(--bd);border-radius:999px;background:var(--card);color:var(--mt);cursor:pointer;flex:none}
.fin-orig:hover,.fin-orig:focus-visible{border-color:var(--v);color:var(--tx)}
.fin-dlg-op{display:block;margin-top:12px;padding:8px 12px;border:1px solid var(--bd);border-radius:10px}
.fin-dlg-op label{display:flex;align-items:center;gap:8px;padding:5px 0;font-size:14px;color:var(--tx);cursor:pointer}
.fin-dlg-alerta{display:block;margin-top:10px;padding:8px 12px;border-radius:8px;background:var(--amberl);color:var(--amber);font-size:13px}
.fin-imp-dup{display:flex;align-items:flex-start;gap:10px;margin:2px 0 10px;padding:10px 14px;border:1px solid var(--bd);border-radius:10px;font-size:13px;color:var(--tx);cursor:pointer}
.fin-imp-dup input{width:16px;height:16px;margin:2px 0 0;flex:none}
.fin-imp-dup .sub{color:var(--mt)}
.fin-imp-alerta{margin:0 0 10px;padding:8px 12px;border-radius:8px;background:var(--amberl);color:var(--amber);font-size:13px}
/* Situação do caixa: bolinha e texto, igual em todo o sistema (Fechado, Fechado com ressalva, Em aberto, Feriado) */
.fcx-st{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--tx);white-space:nowrap}
.fcx-st::before{content:'';width:7px;height:7px;border-radius:50%;flex:none}
.fcx-st.ok::before{background:var(--green)}
.fcx-st.ress::before{background:var(--red)}
.fcx-st.ab::before{background:var(--d)}
.fcx-st.fer{color:var(--mt)}
.fcx-st.fer::before{background:var(--mt)}
/* As três ações do topo um pouco maiores (Importar e Exportar seguem com a altura dos filtros) */
.fin-acoes .btn.fin-nv{height:38px;padding:0 16px;font-size:14px;border-radius:9px}
.fin-acoes .fin-olho{height:38px}
/* Com espaço sobrando, a Categoria ganha a largura do nome mais longo (262px) e a Conta a do número mais longo (180px);
   a Descrição fica com o resto, que ainda cabe uma descrição de 60 caracteres. Em telas menores, vale a divisão em porcentagem. */
/* Empresas e contas em cartões, com a paleta da marca */
.fin-cgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px;margin-bottom:28px}
.fin-cad .fin-egrp{display:flex;align-items:center;gap:10px;margin:6px 0 12px}
.fin-cad .fin-egrp strong{position:relative;padding-left:14px;font-size:16px;color:var(--tx)}
.fin-cad .fin-egrp strong::before{content:'';position:absolute;left:0;top:2px;bottom:2px;width:4px;border-radius:2px;background:var(--d)}
.fin-cad .fin-egrp .n{font-size:12px;font-weight:600;color:var(--amber);background:var(--dl);padding:2px 10px;border-radius:999px}
.fin-cad .fin-egrp .fin-act{margin-left:auto}
.fin-ccard{position:relative;background:var(--card);border:1px solid var(--bd);border-radius:16px;display:flex;flex-direction:column;box-shadow:0 1px 2px rgba(6,46,43,.05);transition:box-shadow .2s,transform .2s}
.fin-ccard:hover{box-shadow:0 12px 28px rgba(6,46,43,.12);transform:translateY(-1px)}
.fin-ccard.off{opacity:.6}
.fin-cc-top{position:relative;display:flex;align-items:center;gap:14px;padding:18px 18px 20px;color:#fff;border-radius:15px 15px 0 0}
/* o menu ⋯ aberto fica por cima dos outros cartões (o cartão não corta mais o que sai dele) */
.fin-ccard:has(.fin-more[open]),.fin-ccard:focus-within{z-index:6}
.fin-cc-logo{position:relative;z-index:1;flex:none;height:46px;padding:0 14px;border-radius:12px;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 16px rgba(0,0,0,.22)}
.fin-cc-logo img{display:block;width:auto;height:auto;max-height:24px;max-width:112px}
.fin-cc-bk{position:relative;z-index:1;width:46px;height:46px;border-radius:12px;background:rgba(255,255,255,.08);border:1px solid rgba(214,164,92,.6);color:#E4B66F;font-weight:700;font-size:14px;letter-spacing:.03em;display:flex;align-items:center;justify-content:center;flex:none}
.fin-cc-id{position:relative;z-index:1;min-width:0}
.fin-cc-nm{font-size:16px;font-weight:600;color:#fff}
.fin-cc-bn{font-size:12px;color:rgba(255,255,255,.72);margin-top:2px}
.fin-cc-tags{display:flex;flex-wrap:wrap;gap:8px;margin:14px 18px 0}
.fin-cc-fun{display:inline-flex;align-items:center;font-size:12px;font-weight:600;color:var(--v);background:var(--vl);border-radius:999px;padding:6px 12px}
.fin-cc-fun.ext{color:var(--mt);background:var(--bd)}
.fin-cc-dl{display:grid;grid-template-columns:1fr 1fr;gap:12px 18px;margin:0;padding:16px 18px 4px}
.fin-cc-f{min-width:0}
.fin-cc-f.w{grid-column:1/-1}
.fin-cc-f dt{font-size:12px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--mt);margin:0 0 3px}
.fin-cc-f dd{margin:0;font-size:14px;color:var(--tx);overflow-wrap:anywhere}
.fin-cc-fe{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:var(--amber);background:var(--dl);border-radius:999px;padding:6px 12px}
.fin-cc-fe svg{width:15px;height:15px;flex:none}
.fin-cc-in{margin:8px 18px 0;font-size:12px;font-weight:600;color:var(--mt)}
.fin-cc-ft{display:flex;align-items:center;gap:4px;margin-top:auto;padding:8px 10px;border-top:1px solid var(--divider)}
.fin-cc-tags+.fin-cc-ft,.fin-cc-in+.fin-cc-ft{margin-top:auto}
.fin-ccard>.fin-cc-tags{margin-bottom:16px}
.fin-cc-ac{display:inline-flex;align-items:center;gap:6px;font:inherit;font-size:13px;font-weight:600;color:var(--mt);background:none;border:0;border-radius:8px;padding:7px 10px;cursor:pointer}
.fin-cc-ac svg{width:16px;height:16px}
.fin-cc-ac:hover,.fin-cc-ac:focus-visible{color:var(--v);background:var(--vl)}
.fin-cc-ft .fin-more{margin-left:auto}
.fin-cvazio{grid-column:1/-1;border:1px dashed var(--bd);border-radius:16px}
/* Fechar caixa: a regra da conta, quando não é diária */
.fcx-regra{margin:0 0 14px;padding:10px 14px;border-radius:10px;background:color-mix(in srgb,var(--d) 10%,var(--card));color:var(--tx);font-size:13px}
.fin-cx.info::before,.fcx-conta .cx.info::before{background:var(--mt)}
.fin-cx.info{color:var(--mt)}
.fin-sit.s-fer::before{background:var(--mt)}
/* Formulário da conta: dia da semana do fechamento semanal */
.fin-fech-dia{align-items:center;gap:10px;margin-top:10px;font-size:13px}
.fin-fech-dia label{font-weight:600}
.fin-fech-dia select{width:auto}
.fin-fech-dia span{color:var(--mt);font-size:12px}
/* Destaques da marca (topo do cartão de conta, conta marcada em Lançamentos e no Fechar caixa, Saldo final): degradê leve, da esquerda para a direita,
   no próprio verde da marca (#062E2B) e um tom dele só um pouco mais claro, misturado em OKLab para a passagem ficar uniforme */
.fin-cc-top,.fin-cartao.on,.fin-kpis .mc.hero,.fcx-conta.on{background:linear-gradient(90deg,#0B4540 0%,#062E2B 100%);background:linear-gradient(in oklab 90deg,#0B4540 0%,#062E2B 100%)}
body.dark .fin-cc-top,body.dark .fin-cartao.on,body.dark .fin-kpis .mc.hero,body.dark .fcx-conta.on{background:linear-gradient(90deg,#2B6560 0%,#1E5A55 100%);background:linear-gradient(in oklab 90deg,#2B6560 0%,#1E5A55 100%)}
.fin-cc-top::before{content:'';position:absolute;left:0;right:0;bottom:0;height:2px;background:linear-gradient(90deg,rgba(214,164,92,0) 0%,rgba(214,164,92,.9) 35%,rgba(228,182,111,.9) 65%,rgba(214,164,92,0) 100%);pointer-events:none}
/* Lista com cara de planilha: linhas de grade, linhas mais baixas, zebrado, cabeçalho cinza e linha de total */
#fin-lista .fin-tbl tbody tr:not(.fin-dia) td{padding-top:5px;padding-bottom:5px;border-bottom:1px solid var(--bd)}
#fin-lista .fin-tbl thead th{background:color-mix(in srgb,var(--v) 7%,var(--card));border-bottom:1px solid color-mix(in srgb,var(--v) 18%,var(--bd))}
body.dark body.dark #fin-lista .fin-tbl tbody tr:not(.fin-dia):hover td{background:color-mix(in srgb,#fff 8%,var(--card))}
#fin-lista .fin-tbl tbody tr:not(.fin-dia):hover td{background:color-mix(in srgb,var(--v) 8%,var(--card))}
#fin-lista .fin-tbl tbody tr[style*="--novo"] td{background:var(--novo)}
#fin-lista .fin-dia td{padding-top:6px;padding-bottom:6px}
#fin-lista .fin-ic{width:26px;height:26px}
#fin-lista .fin-tbl .fin-ell{white-space:normal;overflow:visible;text-overflow:clip;overflow-wrap:anywhere}
#fin-lista .fin-tot td{padding:9px 14px;border-top:2px solid color-mix(in srgb,var(--v) 18%,var(--bd));background:color-mix(in srgb,var(--v) 7%,var(--card));font-variant-numeric:tabular-nums}
#fin-lista .fin-tot .n{color:var(--mt);font-weight:400}
/* cabeçalho que ordena */
.fin-ord{font:inherit;color:inherit;letter-spacing:inherit;text-transform:inherit;background:none;border:0;padding:0;margin:0;cursor:pointer;display:inline-flex;align-items:center;gap:5px}
th.r .fin-ord{width:100%;justify-content:flex-end}
.fin-ord:hover,.fin-ord.on{color:var(--tx)}
.fin-ord .seta{font-size:9px;color:var(--v)}

/* ════ Tema PBL (paleta: #062E2B · #0B4540 · #E4F2EB · #FEF3E2 · #CB974F · #FFFFFF) ════
   Sofisticado e calmo para o dia inteiro: fundo claro levemente esverdeado, superfícies brancas,
   verde da marca na estrutura, menta nas seleções, creme nos avisos, dourado só como detalhe. */

body:not(.dark) .card{border:1px solid var(--bd);border-radius:14px;box-shadow:0 1px 2px rgba(6,46,43,.04),0 6px 16px rgba(6,46,43,.03)}
body:not(.dark) .page-title{font-size:24px;letter-spacing:-.02em;color:var(--v)}
body:not(.dark) .btn{border:1px solid var(--bd);border-radius:9px}
body:not(.dark) .btn:hover{background:var(--vl);border-color:#C9DDD3}
body:not(.dark) .bp,body:not(.dark) .btn.bp{background:var(--v);border-color:var(--v);color:#fff}
body:not(.dark) .bp:hover,body:not(.dark) .btn.bp:hover{background:#0B4540;border-color:#0B4540}
body:not(.dark) input:not([type=checkbox]):not([type=radio]),body:not(.dark) select,body:not(.dark) textarea{border-color:var(--bd);border-radius:9px}
body:not(.dark) input:not([type=checkbox]):not([type=radio]):focus,body:not(.dark) select:focus,body:not(.dark) textarea:focus{border-color:#0B4540;box-shadow:0 0 0 3px rgba(11,69,64,.12);outline:none}
body:not(.dark) .sidebar{background:#FFFFFF!important}
body:not(.dark) .nav-item:hover{background:#F1F7F4;color:var(--v)}
body:not(.dark) .nav-item.active{background:var(--vl);color:var(--v)}
.hdr{box-shadow:inset 0 -2px 0 var(--d)}
body:not(.dark) .fin-kpis .mc{border:1px solid var(--bd);border-radius:14px;box-shadow:0 1px 2px rgba(6,46,43,.04)}
body:not(.dark) .fin-cartao:not(.on),body:not(.dark) .fcx-conta:not(.on){border-color:var(--bd);border-radius:14px;box-shadow:0 1px 2px rgba(6,46,43,.04)}
body:not(.dark) .fin-cartao.on,body:not(.dark) .fcx-conta.on{border-radius:14px;border-color:#0B4540}
body:not(.dark) #fin-lista .fin-tbl thead th{background:#F1F7F4;color:#4E605B;border-bottom:1px solid #D7E5DE}
body:not(.dark) body:not(.dark) #fin-lista .fin-tbl tbody tr:not(.fin-dia):hover td{background:#EEF6F2}
body:not(.dark) #fin-lista .fin-tbl tbody tr:not(.fin-dia) td{border-bottom-color:#E6EEEA}
body:not(.dark) #fin-lista .fin-dia td{background:#F4F9F6;color:var(--v)}
body:not(.dark) #fin-lista .fin-tot td{background:#F1F7F4;border-top-color:#D7E5DE}
body:not(.dark) .fin-aten{background:var(--dl);border-color:#F0DDBD}
body:not(.dark) .fin-cc-fun{background:var(--vl);color:#0B4540}
body:not(.dark) .fin-cc-fe{background:var(--dl);color:var(--amber)}
body:not(.dark) .fin-cad .fin-egrp .n{background:var(--dl);color:var(--amber)}
body:not(.dark) .fin-ccard{border-color:var(--bd);box-shadow:0 1px 2px rgba(6,46,43,.04),0 6px 16px rgba(6,46,43,.03)}
/* resumo: uma bolinha colorida antes do rótulo diz o que é cada número */
.fin-kpis .mc .ml{display:flex;align-items:center;gap:7px}
.fin-kpis .mc .ml::before{content:'';width:8px;height:8px;border-radius:50%;background:#A9B8B3;flex:none}
.fin-kpis .mc.green .ml::before{background:var(--green)}
.fin-kpis .mc.red .ml::before{background:var(--red)}
.fin-kpis .mc.blue .ml::before,.fin-kpis .mc.hero .ml::before{background:var(--d)}
/* menu lateral: os itens de Cadastros alinhados com os de Financeiro */
.sb-children{padding-left:0!important;margin-left:0!important}
.sb-children{flex-direction:column}
.sb-children .nav-item{padding-left:14px!important;margin-left:8px!important;font-size:13px!important;width:calc(100% - 16px)!important}
/* "Ocultar valores" continua discreto */
body:not(.dark) .btn.fin-olho,body:not(.dark) .fin-olho{background:none;border-color:transparent}
body:not(.dark) .fin-olho:hover{background:none;border-color:var(--bd);color:var(--tx)}
/* Plano de contas em dois blocos */
.fin-plgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(420px,1fr));gap:16px;align-items:start}
.fin-pl{padding:6px 0 4px!important}
.fin-pl-hd{display:flex;align-items:center;gap:10px;padding:12px 18px 12px;border-bottom:1px solid var(--divider)}
.fin-pl-hd strong{font-size:16px;color:var(--vt)}
.fin-pl-hd .n{margin-left:auto;font-size:12px;color:var(--mt)}
.fin-pl-hd .fin-kic{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none}
.fin-pl-hd .fin-kic svg{width:16px;height:16px}
.fin-pl-hd .fin-kic.k-ent{background:var(--vl);color:var(--green)}
.fin-pl-hd .fin-kic.k-sai{background:var(--redl);color:var(--red)}
body.dark .fin-pl-hd .fin-kic.k-ent{background:rgba(255,255,255,.06)}
body.dark .fin-pl-hd .fin-kic.k-sai{background:rgba(220,90,80,.14)}
.fin-plrow{display:flex;align-items:center;gap:12px;padding:8px 10px 8px 18px;border-bottom:1px solid var(--divider)}
.fin-plrow:last-child{border-bottom:0}
.fin-plrow:hover{background:var(--row-hov)}
.fin-plrow.off{opacity:.6}
.fin-pl-nm{flex:1;min-width:0;display:flex;flex-direction:column}
.fin-pl-nm .nm{font-size:14px;font-weight:600;color:var(--tx)}
.fin-pl-nm .sub{font-size:12px;color:var(--mt)}
.fin-pl-n{font-size:12px;color:var(--mt);white-space:nowrap;font-variant-numeric:tabular-nums}
.fin-pl-st{font-size:12px;font-weight:600;color:var(--mt);background:var(--bd);border-radius:999px;padding:2px 8px}
.fin-pl-ac{display:flex;align-items:center;gap:2px}
/* tabelas das outras telas com o mesmo cabeçalho claro; data do histórico sem sublinhado fixo */
body:not(.dark) .tbl thead th{background:#F1F7F4;color:#4E605B}
.fcx-link{text-decoration:none}
.fcx-link:hover,.fcx-link:focus-visible{text-decoration:underline}
body.dark .fin-cc-fun{background:var(--vl);color:var(--vt)}
/* Lista: só linhas de grade horizontais; faixa do dia destacada; saldo inicial como 1ª linha; menu ⋮ */
#fin-lista .fin-dia td{background:color-mix(in srgb,var(--v) 9%,var(--card));border-top:1px solid color-mix(in srgb,var(--v) 16%,var(--bd));border-bottom:1px solid color-mix(in srgb,var(--v) 16%,var(--bd))}
#fin-lista .fin-dia td:first-child{box-shadow:inset 3px 0 0 var(--d)}

#fin-lista td.fin-sl{font-weight:500}

#fin-lista td.fin-ac{padding-left:4px;padding-right:6px;text-align:center}
.fin-lm{margin:0}
.fin-lm summary{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;padding:0;border-radius:7px;color:var(--mt)}
.fin-lm summary svg{width:18px;height:18px}
.fin-lm summary:hover,.fin-lm[open] summary{background:var(--vl);color:var(--v)}
.fin-lm .fin-more-pop{min-width:170px;z-index:400;padding:5px}
.fin-lm .fin-more-pop button{display:block;width:100%;padding:8px 12px;font-size:13px}
.fin-lm .fin-more-pop button.dg{border-top:1px solid var(--divider);border-radius:0 0 6px 6px;margin-top:3px}
.fin-lm .fin-more-pop button[disabled]{color:var(--mt);opacity:.55;cursor:not-allowed;background:none}
.fin-obsi{display:inline-flex;align-items:center;vertical-align:-3px;margin:0 0 0 4px;flex:none;padding:1px;border:0;background:none;color:var(--blue);cursor:pointer;border-radius:5px}
.fin-obsi svg{width:14px;height:14px}
.fin-obsi:hover{background:var(--vl)}
.fin-est{display:inline-block;margin-left:6px;padding:1px 7px;border-radius:999px;font-size:11px;font-weight:600;background:var(--dl);color:var(--amber);vertical-align:1px}
.fin-est.on{background:var(--bd);color:var(--mt)}
#fin-lista .fin-tbl.agr tbody tr:not(.fin-dia) td.fin-dt{color:var(--mt);font-size:13px}
/* Agrupar por dia (barra de filtros) e a divisória entre dias quando a lista fica corrida */
.fin-agr{display:inline-flex;align-items:center;gap:7px;font-size:13px;color:var(--tx);white-space:nowrap;cursor:pointer;padding:0 6px;user-select:none}
.fin-agr input{width:16px;height:16px;margin:0;accent-color:var(--v)}
#fin-lista .fin-tbl tbody tr.nd td{border-top:1px solid color-mix(in srgb,var(--v) 24%,var(--bd))}
/* Cartões do resumo: número um pouco maior e uma linha de contexto embaixo */
.fin-kpis .mc{padding:13px 16px 12px}
.fin-kpis .mv{font-size:clamp(17px,1.25vw,20px);margin-top:3px}
.fin-kpis .mc.hero .mv{font-size:clamp(18px,1.35vw,22px)}   /* acompanha a largura da tela: nunca corta o número */
.fin-trava{margin:0 0 12px;padding:9px 12px;border-radius:10px;background:var(--dl);color:var(--amber);font-size:13px}
#fin-form input:disabled,#fin-form select:disabled{opacity:.6;cursor:not-allowed}
.fin-aviso{display:none;margin-top:4px;font-size:12px;font-weight:600;color:var(--amber)}
/* ── Calendário próprio ── */
.fin-dp{position:relative;min-width:0}
.fin-dp-campo{display:flex;align-items:center;gap:8px;height:44px;padding:0 12px 0 8px;border:1px solid var(--bd);border-radius:10px;background:var(--input);color:var(--tx);box-sizing:border-box;width:100%;min-width:0}
.fin-dp-campo:focus-within,.fin-dp-bt:focus-visible{border-color:var(--v);box-shadow:0 0 0 3px color-mix(in srgb,var(--v) 14%,transparent);outline:0}
.fin-dp-campo.fin-invalid{border-color:var(--red);background:color-mix(in srgb,var(--red) 6%,var(--input))}
.fin-dp input.fin-dp-txt{border:0!important;outline:0!important;background:transparent!important;padding:0!important;margin:0;height:auto!important;min-height:0!important;width:6.6em;flex:0 0 auto;font:inherit;font-variant-numeric:tabular-nums;color:inherit;box-shadow:none!important}
.fin-dp-ic{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border:0;background:transparent;color:var(--mt);border-radius:7px;cursor:pointer;flex:0 0 auto;padding:0}
.fin-dp-ic:hover{color:var(--v);background:color-mix(in srgb,var(--v) 8%,transparent)}
.fin-dp-sem{font-size:13px;color:var(--mt);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.fin-dp-at{display:flex;gap:6px;margin-top:6px}
.fin-dp-at button{font:inherit;font-size:12px;padding:2px 10px;border-radius:999px;border:1px solid var(--bd);background:var(--card);color:var(--tx);cursor:pointer}
.fin-dp-at button:hover{border-color:var(--v);color:var(--v)}
.fin-dp.compacto{display:inline-block}
.fin-dp.compacto .fin-dp-campo{height:34px;border-radius:8px;padding:0 10px 0 4px;gap:6px;font-weight:600;width:auto}
.fin-dp.compacto input.fin-dp-txt{width:7.4em}   /* o número em negrito é mais largo: a data não pode ficar cortada */
.fin-dp-bt{font:inherit;cursor:pointer;text-align:left;white-space:nowrap}
.fin-dp-bt .fin-dp-ic{width:24px;height:24px}
.fin-dp-a{color:var(--mt);font-weight:400;margin:0 2px}
.fin-dp-pop{position:fixed;z-index:1200;background:var(--card);border:1px solid var(--bd);border-radius:14px;box-shadow:0 16px 40px rgba(6,46,43,.16),0 2px 6px rgba(6,46,43,.06);padding:12px;width:300px;box-sizing:border-box;font-weight:400}
.fin-dp.faixa .fin-dp-pop{width:auto}
.fin-dp-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
.fin-dp-hd strong{font-size:14px;font-weight:600}
.fin-dp-hd button{width:30px;height:30px;border:0;border-radius:8px;background:transparent;color:var(--tx);font-size:18px;line-height:1;cursor:pointer}
.fin-dp-hd button:hover:not(:disabled){background:color-mix(in srgb,var(--v) 8%,transparent)}
.fin-dp-hd button:disabled{opacity:.3;cursor:not-allowed}
.fin-dp-gr{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:2px}
.fin-dp-gr .sem{font-size:11px;font-weight:600;color:var(--mt);text-align:center;padding:2px 0 4px}
.fin-dp-gr button,.fin-dp-meses button{position:relative;height:36px;border:0;border-radius:8px;background:transparent;color:var(--tx);font:inherit;font-size:13px;font-variant-numeric:tabular-nums;cursor:pointer;padding:0}
.fin-dp-meses{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}
.fin-dp-meses button{height:40px;font-size:14px}
.fin-dp-gr button:hover:not(:disabled),.fin-dp-meses button:hover:not(:disabled){background:color-mix(in srgb,var(--v) 8%,transparent)}
.fin-dp-gr button.fds{color:var(--mt)}
.fin-dp-gr button.hj,.fin-dp-meses button.hj{box-shadow:inset 0 0 0 1.5px var(--v)}
.fin-dp-gr button.foco,.fin-dp-meses button.foco{outline:2px solid color-mix(in srgb,var(--v) 45%,transparent);outline-offset:-2px}
.fin-dp.faixa .fin-dp-gr,.fin-dp-pop .fin-dp-fx .fin-dp-gr{column-gap:0}
.fin-dp-gr button.meio{background:color-mix(in srgb,var(--green) 13%,var(--card));border-radius:0}
.fin-dp-gr button.meio:hover{background:color-mix(in srgb,var(--green) 22%,var(--card))}
.fin-dp-gr button.sel,.fin-dp-meses button.sel{background:var(--v);color:#fff;font-weight:600}
.fin-dp-gr button:disabled,.fin-dp-meses button:disabled{opacity:.28;cursor:not-allowed}
.fin-dp-fx{display:flex;gap:12px}
.fin-dp-fx>div:last-child{width:276px}
.fin-dp-pre{display:flex;flex-direction:column;gap:2px;min-width:140px;padding-right:12px;border-right:1px solid var(--bd)}
.fin-dp-pre button{text-align:left;border:0;background:transparent;padding:8px 10px;border-radius:8px;font:inherit;font-size:13px;color:var(--tx);cursor:pointer;white-space:nowrap}
.fin-dp-pre button:hover{background:color-mix(in srgb,var(--v) 8%,transparent)}
.fin-dp-dica{font-size:12px;color:var(--mt);margin-top:8px}
.fin-dp-hd .fin-dp-tit{display:inline-flex;align-items:center;gap:6px;border:0;background:transparent;font:inherit;font-size:14px!important;line-height:1.2;font-weight:600;color:var(--tx);padding:5px 10px;border-radius:8px;cursor:pointer;width:auto!important;height:auto!important}
.fin-dp-hd .fin-dp-tit:hover{background:color-mix(in srgb,var(--v) 8%,transparent)}
.fin-dp-car{font-size:10px;color:var(--mt)}
.fin-dp.faixa input.fin-dp-txt{width:17.5em}
.fin-dp-msg{display:none;position:absolute;left:0;top:calc(100% + 4px);z-index:5;font-size:12px;font-weight:600;color:var(--red);white-space:nowrap;background:var(--card);padding:2px 6px;border-radius:6px}
.fcx-mais{display:inline-block;margin-top:10px;border:0;background:transparent;padding:4px 2px;font:inherit;font-size:13px;font-weight:600;color:var(--vt);cursor:pointer;text-decoration:underline;text-underline-offset:3px;text-decoration-color:color-mix(in srgb,var(--vt) 35%,transparent)}
.fcx-mais:hover{text-decoration-color:currentColor}
/* Cartões do resumo: dica ao passar o mouse; Entradas, Saídas e Transferências filtram a lista */
.fin-kpis .mc{position:relative}
.fin-kpis .mc.hero{overflow:visible}
.fin-kpis .mc:focus-visible{outline:2px solid color-mix(in srgb,var(--v) 55%,transparent);outline-offset:2px}
.fin-kpis .mc.clic{cursor:pointer;transition:border-color .15s,box-shadow .15s}
.fin-kpis .mc.clic:hover{border-color:color-mix(in srgb,var(--v) 45%,var(--bd))}
.fin-kpis .mc.ativo{border-color:var(--v);box-shadow:0 0 0 2px color-mix(in srgb,var(--v) 28%,transparent)}
.fin-kx{display:none;position:absolute;right:10px;top:10px;font-size:11px;font-weight:600;color:var(--vt);background:color-mix(in srgb,var(--v) 9%,var(--card));padding:2px 8px;border-radius:999px}
.fin-kpis .mc.ativo .fin-kx{display:inline-block}
.fin-kdica{display:none;position:absolute;left:10px;top:calc(100% + 6px);z-index:30;width:max-content;max-width:300px;background:var(--tx);color:var(--card);font-size:12px;font-weight:500;line-height:1.45;padding:7px 10px;border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.18);pointer-events:none;white-space:normal;text-align:left}
.fin-kdica::before{content:'';position:absolute;left:16px;top:-5px;border:5px solid transparent;border-top:0;border-bottom-color:var(--tx)}
.fin-kd2{display:block;margin-top:3px;opacity:.75}
.fin-kdica .fin-mv{white-space:nowrap}
.fin-kpis .mc:hover .fin-kdica,.fin-kpis .mc:focus-visible .fin-kdica{display:block}
.fin-kpis .mc:last-child .fin-kdica{left:auto;right:10px}
.fin-kpis .mc:last-child .fin-kdica::before{left:auto;right:16px}
/* Formulário de lançamento: tipo no topo, duas linhas com larguras pelo conteúdo */
.fin-fg12{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px 16px;margin-bottom:16px}
.fin-c2{grid-column:span 2}.fin-c3{grid-column:span 3}.fin-c4{grid-column:span 4}.fin-c5{grid-column:span 5}
.fin-tipos{display:inline-flex;border:1px solid var(--bd);border-radius:10px;overflow:hidden;background:var(--card)}
.fin-tipos button{border:0;border-right:1px solid var(--bd);background:transparent;padding:8px 16px;font:inherit;font-size:14px;font-weight:600;color:var(--mt);cursor:pointer}
.fin-tipos button:last-child{border-right:0}
.fin-tipos button:hover:not(:disabled):not(.on){color:var(--tx);background:color-mix(in srgb,var(--v) 6%,var(--card))}
.fin-tipos button.on{background:var(--fc);color:#fff}
.fin-tipos button:disabled{opacity:.45;cursor:not-allowed}
.fin-copia{font-size:12px;font-weight:600;color:var(--mt);padding:3px 9px;border:1px solid var(--bd);border-radius:999px}
.fin-ft h2+.fin-tipos{margin-left:4px}
.fin-formc .fin-b2{background:var(--card);border:1px solid var(--bd);color:var(--tx)}
.fin-formc .fin-b2:hover{border-color:var(--v)}
.fin-cancelar{border:0;background:transparent;padding:8px 6px;font:inherit;font-size:14px;color:var(--mt);text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.fin-cancelar:hover{color:var(--tx)}
.fin-dp-at.dentro{margin:0 0 0 auto;display:flex;gap:4px;flex:0 0 auto}
.fin-dp-at.dentro button{padding:1px 8px}
.fin-cont{text-align:right}
.fin-ctx .seta{color:var(--mt);margin-left:6px}
.fin-ctx b.dep{font-size:16px;color:var(--green)}
.fin-ctx b.dep.neg{color:var(--red)}
.fin-ctx-a{display:inline-flex;flex-wrap:wrap;gap:4px 8px;align-items:baseline}
</style>
</head>
<body>
<script>try{ if(localStorage.getItem('pbl_theme')==='dark')document.body.classList.add('dark'); }catch(e){}</script>

<!-- LOGIN -->
