    await calcEditorReload(); calcEditorRender();
    return;
  }
  var ex = await calcFetch('/calculos/'+_calcId+'/executar', {method:'POST', body:{}});
  if(!ex.ok){ showToast('Falha ao recalcular (status '+ex.status+').'); return; }
  await calcEditorReload(); calcEditorRender();
}
