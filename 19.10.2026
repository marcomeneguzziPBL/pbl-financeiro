                    <path d="M38.7111457,17.1896 C38.9056443,17.179669 39.2827669,17.1730483 39.9330064,17.2057379 C41.1622376,17.259531 45.567324,17.8127724 48.1330677,19.0260138 C50.7295217,20.2839448 52.0459702,22.5482207 52.0459702,25.7563586 C52.0459702,29.9787034 48.7456359,33.4140138 44.6890092,33.4140138 C41.7232125,33.4140138 38.6566861,33.4140138 38.6566861,27.5422897 L38.7111457,17.1896 Z M46.077115,14.9232552 C44.5391429,15.8182897 43.4573212,15.7251862 42.5892432,15.6502897 C42.4602599,15.6391172 42.3365997,15.6287724 42.2293184,15.6225655 C41.7043769,15.5600828 39.966583,15.3639448 38.7119646,15.343669 L38.7119646,5.00711724 C38.7119646,2.99815172 40.2347864,1.70008276 42.5917,1.70008276 C45.4477585,1.70008276 46.6999201,2.65925517 47.6306471,3.69911724 C48.7374465,4.87884138 49.2308588,6.60642759 49.2308588,9.30187586 C49.2308588,12.9068414 46.3973212,14.7291862 46.077115,14.9232552 Z M53.8030092,18.6147034 C52.4108086,17.6249103 51.062012,17.2065655 50.1693657,16.9297379 L49.9232738,16.8531862 C49.3880955,16.7286345 48.8160649,16.6160828 48.2546805,16.5246345 C50.0272794,15.8447724 51.7880036,14.8032552 52.7306053,13.8502897 C53.6875384,12.8294621 54.828324,11.1246345 54.828324,8.7953931 C54.7705886,6.16242759 53.6433156,4.1158069 51.4776248,2.71304828 C49.2112042,1.24491034 46.3874939,0.560910345 42.5917,0.560910345 L29.4710287,0.560910345 L29.4710287,1.79897931 L29.662661,1.81097931 C30.6994409,1.87677241 31.4737501,2.01166897 31.8295802,2.08325517 C32.4532042,2.25497931 32.8155858,2.46477241 33.0633156,2.81028966 C33.3245579,3.07428966 33.4944883,3.48808276 33.6140538,4.1513931 C33.7246109,4.76670345 33.7762042,6.45704828 33.7762042,7.40504828 L33.7209256,27.7640828 C33.7209256,28.963669 33.6431262,29.9402207 33.5026777,30.463669 C33.359363,31.3347034 33.1087669,31.9930483 32.7873323,32.3592552 C32.4646694,32.6853241 31.9823128,32.9364966 31.3926749,33.0854621 C30.7600426,33.2451862 29.8501986,33.3014621 28.7270203,33.3585655 L28.5329312,33.3684966 L28.5329312,34.6086345 L44.3020593,34.6086345 C45.4977139,34.6086345 46.6270343,34.6086345 47.5159953,34.5523586 C49.0789451,34.4567724 50.7860287,34.2324966 52.6818783,33.243531 C54.233363,32.3658759 55.3430287,31.3702897 56.1775301,30.1053241 C57.0525691,28.6897379 57.4780092,27.2493241 57.4780092,25.7004966 C57.4780092,22.6450483 56.3101986,20.3931862 53.8030092,18.6147034 Z" id="hd-Fill-3" fill="#FFFFFF"></path>
