      (podeVerAdministrativo(currentUser) ? ni('notif1',I.notificacoes,'Administrativo') : '')+
      ni('diligencias',I.diligencias,'Diligências')+
      (hasSecRole(currentUser,'calculo_cs') ? ni('cumprimentosentenca',I.diligencias,'Cumprimento de Sentença') : '')+

      // advogado híbrido com canViewGeracaoNegocios:true vê apenas o card dele (scope 'own')
      (canViewGN(currentUser) ? ni('geracaonegocios',I.advogados,'Geração de Negócios') : '');
  }
  sb.insertAdjacentHTML('afterbegin','<button class="sb-toggle" id="btn-sb" onclick="toggleSidebar()"><span class="sb-toggle-ic">«</span><span class="nav-lbl">Recolher menu</span></button>');
  applyStoredSidebar();
}

function toggleGroup(id){
  var el=document.getElementById(id);
  var chv=document.getElementById('chv-'+id.replace('grp-',''));
  var open=el.classList.toggle('open');
  if(chv)chv.textContent=open?'▼':'▶';
}

function navigate(page){
  // UFIR-RJ (TJRJ): página dos gestores do Cálculo (ADMIN/DIRETORIA no calc-service), fora das listas por papel do app
  if(page==='ufirrj'){ if(!calcEhGestor()){ showToast('Acesso restrito aos gestores do Cálculo.'); return; } calcAbrirPaginaUfir(); return; }
  // Páginas restritas a admin (financeiro, fluxo, relatórios avançados, usuários, resumo consolidado)
  var FULL_ONLY=['financeiro','fluxocaixa','previsao','usuarios','auditlog','relliq2','relcomp','relgeral','relpend','resumo','partes','cnab'];
  // Administrativo (Habilitação/Cessão): todos os advogados usam; só a gestão exclui (24/09).
  // Esta guarda é a autoridade sobre o módulo — 'notif1' entra nas allowlists abaixo porque elas
  // são listas fechadas por papel, e sem constar ali o clique no menu parava em "Acesso restrito"
  // mesmo para quem pode (foi o caso da Margie, gestora). Comercial cai aqui e é barrado.
  if(page==='notif1' && !podeVerAdministrativo(currentUser)){ mc.innerHTML='<div class="card">Sem acesso a este módulo.</div>'; return; }
  // Páginas que a gestora (Margie/Jeanne) pode acessar — sem 'resumo' (só admin)
  var GESTORA_ALLOWED=['dashboard','distrib','processos','reliquidados','operacional','campanhas','advogados','comissoesgestoras','minhascomissoes','notificacoes','notif1','diligencias','relliqdiario','cumprimentosentenca','ferramentas'];
  // gestora com canViewGeracaoNegocios:true tem acesso adicional a geracaonegocios
  if(currentUser && canViewGN(currentUser)) GESTORA_ALLOWED=GESTORA_ALLOWED.concat(['geracaonegocios']);
  // Páginas que supervisora (Karen) pode acessar — sem comissões por gestora (regra: não vê de ninguém)
  var SUPERVISORA_ALLOWED=['dashboard','distrib','processos','reliquidados','notificacoes','notif1','minhascomissoes','diligencias','cumprimentosentenca'];
  // Páginas que advogado pode acessar
  var LAWYER_ALLOWED=['dashboard','distrib','processos','reliquidados','minhascomissoes','notificacoes','notif1','diligencias','cumprimentosentenca'];
  var GESTOR_CALCULOS_ALLOWED=['dashboard','distrib','processos','reliquidados','notificacoes','notif1','diligencias','cumprimentosentenca'];
  var PERITO_ALLOWED=['dashboard','processos','cumprimentosentenca','notif1'];
  // Jurídico e Comercial: só Dashboard, Processos e Liquidações (edita processo; não exclui nada)
  var JURIDICO_COMERCIAL_ALLOWED=['dashboard','processos','reliquidados','notif1'];
  // advogado híbrido com canViewGeracaoNegocios:true vê também geracaonegocios (mas só o card dele)
  if(currentUser && canViewGN(currentUser)) LAWYER_ALLOWED=LAWYER_ALLOWED.concat(['geracaonegocios']);

  if(currentUser.role==='gestora'){
    if(GESTORA_ALLOWED.indexOf(page)<0){showToast('Acesso restrito ao seu perfil.');return;}
  } else if(currentUser.role==='supervisora'){
    if(SUPERVISORA_ALLOWED.indexOf(page)<0){showToast('Acesso restrito ao seu perfil.');return;}
  } else if(currentUser.role==='lawyer'){
    if(LAWYER_ALLOWED.indexOf(page)<0){showToast('Acesso restrito. Contate o administrador.');return;}
  } else if(currentUser.role==='gestor_calculos'){
    if(GESTOR_CALCULOS_ALLOWED.indexOf(page)<0){showToast('Acesso restrito ao seu perfil.');return;}
  } else if(currentUser.role==='perito_contabil'){
    if(PERITO_ALLOWED.indexOf(page)<0){showToast('Acesso restrito ao seu perfil.');return;}
  } else if(currentUser.role==='juridico' || currentUser.role==='comercial'){
    if(JURIDICO_COMERCIAL_ALLOWED.indexOf(page)<0){showToast('Acesso restrito ao seu perfil.');return;}
  } else if(!isFullAccess(currentUser) && FULL_ONLY.indexOf(page)>=0){
    showToast('Acesso restrito. Contate o administrador.');return;
  }
  currentPage=page;
  document.querySelectorAll('.nav-item').forEach(function(e){e.classList.remove('active');});
  var el=document.getElementById('nav-'+page);if(el)el.classList.add('active');
  var mc=document.getElementById('main-content');
  switch(page){
    case 'dashboard':   mc.innerHTML=pageDashboard();afterDash();break;
    case 'processos':   mc.innerHTML=pageProcessos();break;
    case 'agenda':      mc.innerHTML=pageAgenda();break;
    case 'financeiro':  mc.innerHTML=pageFinanceiro();break;
    case 'fluxocaixa':  mc.innerHTML=pageFluxoCaixa();break;
    case 'operacional': mc.innerHTML=pageOperacional();break;
    case 'campanhas':   mc.innerHTML=pageCampanhas();break;
    case 'advogados':   mc.innerHTML=pageAdvogados();break;
    case 'comissoesgestoras':mc.innerHTML=pageComissoesGestoras();break;
    case 'geracaonegocios':mc.innerHTML=pageGeracaoNegocios();afterGeracaoNegocios();break;
    case 'resumo':      mc.innerHTML=pageResumo();break;
    case 'reliquidados':mc.innerHTML=pageRelLiquidados();break;
    case 'previsao':    mc.innerHTML=pagePrevisaoEntradas();break;
    case 'comissao':    mc.innerHTML=pageMinhaComissao();break;
    case 'minhascomissoes': mc.innerHTML=pageMinhasComissoes();break;
    case 'usuarios':    mc.innerHTML=pageUsuarios();break;
    case 'notificacoes':mc.innerHTML=pageNotificacoes();break;
    case 'cumprimentosentenca': mc.innerHTML=pageCumprimentoSentenca();break;
    case 'partes':      mc.innerHTML=pagePartes();break;
    case 'notif1':      mc.innerHTML=pageNotif1();break;
    case 'ferramentas': mc.innerHTML=pageFerramentasJuridicas();break;
    case 'auditlog':    pageAuditLog().then(function(html){mc.innerHTML=html;});break;
    case 'relliqdiario':mc.innerHTML=pageRelLiqDiario();afterRelLiqDiario();break;
    case 'relliq2':     mc.innerHTML=pageRelLiq2();break;
    case 'relcomp':     mc.innerHTML=pageRelComp();break;
    case 'relgeral':    mc.innerHTML=pageRelGeral();break;
    case 'relpend':     mc.innerHTML=pageRelPend();break;
    case 'distrib':     mc.innerHTML=pageDistrib();break;
    case 'diligencias': mc.innerHTML=pageDiligencias();afterDiligencias();break;
    case 'cnab':        mc.innerHTML=pageCnab();setTimeout(cnabCarregarHistorico,0);break;
  }
}

function recalc(){updPeriod();saveData();navigate('resumo');}

// ════════════════════════════════════════════════════════════
// DILIGÊNCIAS (Contencioso) — adaptado p/ Firestore + lawyers
// ════════════════════════════════════════════════════════════
var _diligTab='fila';
var _diligF={q:'',adv:'',resp:'',uf:'',comarca:'',de:'',ate:'',acima20k:false,status:''};
var _diligMonF={de:'',ate:''};
var _diligProd='hoje';
var _manualF={q:'',trib:'',comarca:''};
var DILIG_VALOR_LIMITE=20000;
var DILIG_MAT=['Precatório','RPV','Trabalhista','Comum'];
var DILIG_UF={1:'AC',2:'AL',3:'AP',4:'AM',5:'BA',6:'CE',7:'DF',8:'ES',9:'GO',10:'MA',11:'MT',12:'MS',13:'MG',14:'PA',15:'PB',16:'PR',17:'PE',18:'PI',19:'RJ',20:'RN',21:'RS',22:'RO',23:'RR',24:'SC',25:'SE',26:'SP',27:'TO'};
var DILIG_CAPITAIS={AC:'Rio Branco',AL:'Maceió',AP:'Macapá',AM:'Manaus',BA:'Salvador',CE:'Fortaleza',DF:'Brasília',ES:'Vitória',GO:'Goiânia',MA:'São Luís',MT:'Cuiabá',MS:'Campo Grande',MG:'Belo Horizonte',PA:'Belém',PB:'João Pessoa',PR:'Curitiba',PE:'Recife',PI:'Teresina',RJ:'Rio de Janeiro',RN:'Natal',RS:'Porto Alegre',RO:'Porto Velho',RR:'Boa Vista',SC:'Florianópolis',SE:'Aracaju',SP:'São Paulo',TO:'Palmas'};
var DILIG_TIPOS=[
 'Diligenciar expedição de alvará','Diligenciar saldo remanescente','Solicitar remessa para conclusão ao gabinete',
 'Diligenciar concluso para sentença de expedição','Protocolar novos dados bancários',
 'Intervenção junto à instituição bancária para liberação de valores expedidos',
 'Diligenciar desarquivamento e prosseguimento do feito','Diligenciar abertura de prazo','Juntada de custas',
 'Diligenciar liberação de certidão de trânsito em julgado / remessa dos autos à origem para ajuizamento de Cumprimento de Sentença (CS)','Outros'];
var DILIG_FASE={
  aprovacao:{lbl:'Aguardando aprovação',bg:'var(--dl)',fg:'var(--d)'},
  devolvida:{lbl:'Devolvida p/ correção',bg:'var(--redl)',fg:'var(--red)'},
  advogado:{lbl:'Com o advogado (tarefa)',bg:'var(--bluel)',fg:'var(--blue)'},
  concluida:{lbl:'Concluída',bg:'var(--greenl)',fg:'var(--green)'}
};
var DILIG_STF={
  a_fazer:{lbl:'A fazer',bg:'var(--bluel)',fg:'var(--blue)'},
  aguardando:{lbl:'Aguardando prazo',bg:'var(--dl)',fg:'var(--d)'},
  verificar:{lbl:'Verificar agora',bg:'var(--redl)',fg:'var(--red)'},
  cumprida:{lbl:'Cumprida',bg:'var(--greenl)',fg:'var(--green)'}
};
function tipoOptsDilig(id,sel){return '<select id="'+id+'">'+DILIG_TIPOS.map(function(t){return '<option value="'+esc(t)+'"'+(sel===t?' selected':'')+'>'+esc(t)+'</option>';}).join('')+'</select>';}
function diligParseCNJ(cnj){
  var d=String(cnj||'').replace(/\D/g,'');
  if(d.length!==20) return {trib:'',uf:'',orig:''};
  var seg=parseInt(d[13],10), tr=parseInt(d.slice(14,16),10), orig=d.slice(16,20);
  if(seg===8) return {trib:'TJ'+(DILIG_UF[tr]||'??'),uf:(DILIG_UF[tr]||'??'),orig:orig};
  if(seg===4) return {trib:'TRF'+tr,uf:'Federal',orig:orig};
  if(seg===5) return {trib:'TRT'+tr,uf:'Trabalho',orig:orig};
  return {trib:String(seg),uf:'',orig:orig};
}
function diligDiasEntre(a,b){ if(!a||!b)return null; var d1=new Date(a+'T00:00:00'), d2=new Date(b+'T00:00:00'); return Math.round((d2-d1)/86400000); }
function diligAddDias(s,n){ var d=new Date(s+'T00:00:00'); d.setDate(d.getDate()+n); return d.toISOString().slice(0,10); }
function diligPrazoDias(){ return S.diligPrazoDias||7; }
function diligPrazoDe(d){ return (d&&d.prazoDias)?d.prazoDias:diligPrazoDias(); }
function prazoSelectHTML(id,sel){
  sel=parseInt(sel,10)||diligPrazoDias(); if(sel<1)sel=1; if(sel>30)sel=30;
  return '<div style="display:flex;align-items:center;gap:6px"><input type="number" id="'+id+'" min="1" max="30" step="1" value="'+sel+'" style="max-width:78px"/><span style="font-size:11px;color:var(--mt)">dias (1–30)</span></div>';
}
function diligPrazoInputVal(id,fallback){
  var e=document.getElementById(id); var n=e?parseInt(e.value,10):NaN;
  if(!n||n<1) n=fallback||diligPrazoDias();
  if(n>30) n=30;
  return n;
}
function materiaSelectHTML(id,sel){
  return '<select id="'+id+'"><option value="">— não definida —</option>'+DILIG_MAT.map(function(m){return '<option value="'+m+'"'+(sel===m?' selected':'')+'>'+m+'</option>';}).join('')+'</select>';
}
var DILIG_MAT_COR={ 'Precatório':{bg:'var(--vl)',fg:'var(--v)'}, 'RPV':{bg:'var(--dl)',fg:'var(--d)'}, 'Trabalhista':{bg:'var(--bluel)',fg:'var(--blue)'}, 'Comum':{bg:'var(--row-alt)',fg:'var(--mt)'} };
function materiaBadge(m){ if(!m) return '<span style="color:var(--mt);font-size:11px">—</span>'; var c=DILIG_MAT_COR[m]||{bg:'var(--row-alt)',fg:'var(--mt)'}; return '<span class="badge" style="background:'+c.bg+';color:'+c.fg+'">'+esc(m)+'</span>'; }
function diligDiasRest(d){ if(!d.dataVerificar)return null; return diligDiasEntre(todayStr(), d.dataVerificar); }
function diligAging(d){ var ini=d.dataInicio||d.dataRealizacao; if(!ini)return null; return diligDiasEntre(ini, d.cumprida? d.dataCumprimento : todayStr()); }
// dropdown de advogados (mesma fonte para 'advogado' e 'responsável')
// `resp` guarda o NOME do advogado (de S.lawyers), e a identificação do diligente comparava
// esse nome com o nome da CONTA de usuário — dois cadastros diferentes. Funcionava por
// coincidência: em 30/09 os 13 usuários com lawyerId tinham nome de conta idêntico ao do
// cadastro de advogado. Bastava alguém corrigir um acento, casar e mudar o sobrenome, ou haver
// dois homônimos, para a pessoa deixar de ver as próprias diligências — sem erro, sem aviso.
// Agora a comparação é por lawyerId; o nome só decide para registros antigos, que não têm
// respId (841 deles em 30/09, todos casando com um advogado existente).
function diligRespId(nome){
  var n=String(nome||'').trim(); if(!n) return '';
  var l=(S.lawyers||[]).find(function(x){ return String(x.name||'').trim()===n; });
  return l?l.id:'';
}
function diligEhMinha(d, u){
  if(!d) return false;
  var rid=String(d.respId||'');
  if(rid) return rid===String((u&&u.lawyerId)||'');
  var r=String(d.resp||'');                       // legado: sem respId, cai no nome
  return r===String((u&&u.name)||'');
}
// Sem responsável definido, a diligência continua visível a todo diligente — é fila aberta.
function diligVisivelPara(d, u){ return String(d.resp||'')==='' || diligEhMinha(d,u); }
function diligLawyerOpts(sel){
  // Só advogados ativos; mantém o já-selecionado mesmo se inativou (marcado), p/ não perder atribuições existentes.
  return '<option value="">— selecione —</option>'+(S.lawyers||[]).filter(function(l){ return lawyerAtivo(l) || (sel && l.name===sel); }).map(function(l){ var inativo=!lawyerAtivo(l); return '<option value="'+esc(l.name)+'"'+(sel===l.name?' selected':'')+'>'+esc(l.name)+(inativo?' (inativo)':'')+'</option>';}).join('');
}
// casa um nome cru (planilha) ao nome canônico do lawyer por primeiro nome
function diligMatchLawyer(raw){
  var s=String(raw||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').trim();
  if(!s) return '';
  var fn=s.split(/\s+/)[0];
  var l=(S.lawyers||[]).find(function(x){
    var n=(x.name||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').trim();
    return n===s || n.split(/\s+/)[0]===fn || n.indexOf(fn)===0;
  });
  return l? l.name : String(raw||'').trim();
}

// ── Persistência (Firestore) ─────────────────────────────────
async function saveDiligencia(d){
  var id=d.id || fb.doc(fb.collection(fb.db,'diligencias')).id;
  d.id=id;
  var payload=Object.assign({}, d, { updatedAt:fb.serverTimestamp(), updatedBy:currentUser.id });
  if(!d.createdAt){ payload.createdAt=fb.serverTimestamp(); payload.createdBy=currentUser.id; }
  await fb.setDoc(fb.doc(fb.db,'diligencias',id), payload);
  return id;
}
async function deleteDiligenciaDoc(id){ await fb.deleteDoc(fb.doc(fb.db,'diligencias',id)); }

// ── Escopo por perfil (visibilidade da fila) ─────────────────
// Acesso total ao módulo: admin/gestora/supervisora + advogado-controller.
// Advogado sem controller = normal: só as roteadas a ele (destino='advogado' e advId = seu lawyerId); não edita nem aprova.
function isController(u){ return !!(u && u.role==='lawyer' && hasSecRole(u,'controller')); }
// Allowlist de aprovadores extras da Diligência (por e-mail) — libera a aba Aprovação
// para usuários que não têm papel de aprovador (ex.: advogado que também aprova).
var DILIG_APROVADOR_EMAILS = ['guilherme.souza@pblcompra.com'];
function ehAprovadorAllow(u){ return !!(u && u.email && DILIG_APROVADOR_EMAILS.indexOf(String(u.email).toLowerCase())>=0); }
// Controller SÓ é "restrito" (fila própria, sem Aprovação) se NÃO estiver na allowlist de aprovador.
// Um Controller na allowlist vira aprovador de equipe (vê Aprovação + tudo).
function isControllerRestrito(u){ return isController(u) && !ehAprovadorAllow(u); }
function podeAprovarDilig(u){ return !!(u && (isFullAccess(u)||isGestora(u)||u.role==='supervisora'||u.role==='gestor_calculos'||isController(u)||ehAprovadorAllow(u))); }
function isEquipeDilig(u){ return !!(u && podeAprovarDilig(u)); }
function isAdvDilig(u){ return !!(u && u.role==='lawyer' && !hasSecRole(u,'controller') && !ehAprovadorAllow(u)); }
function faseOf(d){ return d.fase||(d.cumprida?'concluida':'fila'); }
function statusFila(d){ if(d.cumprida)return'cumprida'; if(!d.dataRealizacao)return'a_fazer'; if(d.dataVerificar&&todayStr()>=d.dataVerificar)return'verificar'; return'aguardando'; }
function faseBadgeDe(d){ var f=faseOf(d); if(DILIG_FASE[f]){var c=DILIG_FASE[f];return '<span class="badge" style="background:'+c.bg+';color:'+c.fg+'">'+c.lbl+'</span>';} var s=statusFila(d),cs=DILIG_STF[s]||DILIG_STF.a_fazer; return '<span class="badge" style="background:'+cs.bg+';color:'+cs.fg+'">'+cs.lbl+'</span>'; }
function diligStatusKey(d){ var f=faseOf(d); return DILIG_FASE[f]?f:statusFila(d); }
function diligStatusLabel(k){ return (DILIG_FASE[k]&&DILIG_FASE[k].lbl)||(DILIG_STF[k]&&DILIG_STF[k].lbl)||k; }
function nowTs(){ return new Date().toISOString(); }
function fmtTs(ts){try{if(ts==null)return '—';var d=ts.toDate?ts.toDate():(typeof ts.seconds==='number'?new Date(ts.seconds*1000):new Date(ts));return isNaN(d.getTime())?'—':d.toLocaleDateString('pt-BR')+' '+d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});}catch(e){return '—';}}
function hist(d,texto,tag){ d.historico=d.historico||[]; d.historico.push({ts:nowTs(),autor:(currentUser&&currentUser.name)||'—',papel:(currentUser&&currentUser.role)||'',texto:texto,tag:tag||''}); }
function diligPrio(d){ return (Number(d.valor)||0)>DILIG_VALOR_LIMITE; }
function tagPrioDilig(d){ return diligPrio(d)?'<span class="badge" style="background:var(--redl);color:var(--red)" title="Valor > R$ 20.000">⏫ Alta prioridade</span>':''; }
function isCalculista(u){ return !!(u && u.role==='lawyer' && hasSecRole(u,'calculo_cs')); }
function isGestorCalculos(u){ return !!(u && u.role==='gestor_calculos'); }
function isPeritoContabil(u){ return !!(u && (u.role==='perito_contabil' || (u.role==='lawyer' && hasSecRole(u,'calculo_cs')))); }
// Quem enxerga a aba Cumprimento de Sentença.
function podeVerCumprimento(u){
  if(!u) return false;
  if(isFullAccess(u)||isGestora(u)||u.role==='supervisora'||u.role==='gestor_calculos'||u.role==='perito_contabil') return true;
  if(u.role==='lawyer' && hasSecRole(u,'calculo_cs')) return true;
  return false;
}
function diligNormProc(s){ return String(s||'').replace(/\D/g,''); }
function diligAdvNomePorId(id){ var l=(S.lawyers||[]).find(function(x){return x.id===id;}); return l?l.name:''; }
function diligAdvIdPorNome(nome){ var l=(S.lawyers||[]).find(function(x){return x.name===nome;}); return l?l.id:null; }

// Baixa automática: ao registrar liquidação, fecha as diligências abertas do processo.
// Total → cumprida. Parcial → cumprida + nova tarefa roteada ao advogado da liquidação.
// Retorna o nº de diligências fechadas. Persiste no Firestore (best-effort).
async function baixarDiligenciasPorLiquidacao(processo, liquidacao, advogadoId){
  var np=diligNormProc(processo); if(np.length<20) return 0;
  var hoje=todayStr(), tipoLiq=((liquidacao||'').toString().toUpperCase().indexOf('PARCIAL')>=0)?'PARCIAL':'TOTAL';
  var matches=(S.diligencias||[]).filter(function(d){ return !d.cumprida && diligNormProc(d.proc)===np; });
  if(!matches.length) return 0;
  var ops=[];
  matches.forEach(function(d){
    if(!d.dataInicio) d.dataInicio=hoje;
    if(!d.dataRealizacao) d.dataRealizacao=hoje;
    d.cumprida=true; d.fase='concluida'; d.dataCumprimento=d.dataCumprimento||hoje;
    d.diasCumprimento=diligDiasEntre(d.dataInicio||hoje, hoje);
    d.destino='advogado';
    hist(d,'Baixa automática por liquidação ('+liquidacao+').','liquidacao');
    ops.push(saveDiligencia(d));
  });
  if(tipoLiq==='PARCIAL'){
    var base=matches[0];
    var nova={ id:null, proc:base.proc, trib:base.trib, uf:base.uf, orig:base.orig,
      comarca:base.comarca||'', vara:base.vara||'',
      adv:diligAdvNomePorId(advogadoId)||base.adv||'', advId:advogadoId||null,
      criadorId:base.criadorId||null,
      tipo:'Verificar processo após liquidação PARCIAL — definir próximos passos',
      tipoCat:'Verificar processo após liquidação PARCIAL — definir próximos passos', tipoDetalhe:'',
      resp:'', valor:base.valor||0,
      obs:'Gerado automaticamente: liquidação parcial registrada em '+fmtDate(hoje)+'. Verificar saldo remanescente e o que falta diligenciar.',
      materia:base.materia||'', secao:base.secao||'',
      fase:'advogado', destino:'advogado',
      dataInicio:null, dataRealizacao:null, dataVerificar:null, ciclos:[],
      cumprida:false, dataCumprimento:null, diasCumprimento:null, historico:[] };
    hist(nova,'Tarefa criada por baixa de liquidação parcial ('+liquidacao+') — enviada ao advogado '+(nova.adv||'')+' para verificar próximos passos.','advogado');
    ops.push(saveDiligencia(nova));
  }
  try{ await Promise.all(ops); }catch(e){ console.error('baixarDiligencias:', e); }
  return matches.length;
}

// ── PÁGINA v2 ────────────────────────────────────────────────
function diligDono(d){ return (currentUser&&((d.advId&&d.advId===currentUser.lawyerId)||(d.criadorId&&d.criadorId===currentUser.lawyerId)||(d.criadorId&&d.criadorId===currentUser.id))); }
function diligTabsFor(u){
  if(isAdvDilig(u)) return [['minhas','Minhas solicitações'],['tarefas','Tarefas comigo'],['correcoes','Correções pendentes'],['concluidas','Concluídas (ciência)'],['manual','Manual dos Tribunais']];
  if(isControllerRestrito(u)){
    // Diligente (Controller) SEM allowlist: trabalha a PRÓPRIA fila e vê SÓ as suas Concluídas e Produtividade (sem Aprovação).
    return [['fila','Fila de trabalho'],['comadv','Com advogados'],['monit','Monitoramento'],['concluidas','Concluídas'],['prod','Produtividade'],['manual','Manual dos Tribunais']];
  }
  var t=[];
  if(podeAprovarDilig(u)) t.push(['aprovacao','Aprovação']);
  t.push(['fila','Fila de trabalho']);
  if(podeAprovarDilig(u)) t.push(['comadv','Com advogados']);
  t.push(['monit','Monitoramento'],['prod','Produtividade'],['concluidas','Concluídas'],['manual','Manual dos Tribunais']);
  return t;
}
function diligRowsFor(tab){
  var all=S.diligencias||[], adv=isAdvDilig(currentUser);
  var ctrl=isControllerRestrito(currentUser); var meNome=String((currentUser&&currentUser.name)||'');
  function meu(d){ if(!ctrl) return true; return diligVisivelPara(d,currentUser); } // diligente vê só a própria (+ sem responsável)
  if(tab==='aprovacao')return all.filter(function(d){return faseOf(d)==='aprovacao';});
  if(tab==='comadv')return all.filter(function(d){return faseOf(d)==='advogado'&&meu(d);});
  if(tab==='tarefas')return all.filter(function(d){return faseOf(d)==='advogado'&&diligDono(d);});
  if(tab==='concluidas')return all.filter(function(d){return faseOf(d)==='concluida'&&(!adv||diligDono(d))&&meu(d);});
  if(tab==='minhas')return all.filter(function(d){return diligDono(d)&&(faseOf(d)==='aprovacao'||faseOf(d)==='fila');});
  if(tab==='correcoes')return all.filter(function(d){return faseOf(d)==='devolvida'&&diligDono(d);});
  return all.filter(function(d){return faseOf(d)==='fila'&&meu(d);}); // fila
}
function diligKpisHTML(all){
  var fila=all.filter(function(d){return faseOf(d)==='fila';});
  var c={a_fazer:0,aguardando:0,verificar:0};fila.forEach(function(d){var s=statusFila(d);if(c[s]!=null)c[s]++;});
  var aprov=all.filter(function(d){return faseOf(d)==='aprovacao';}).length;
  var comadv=all.filter(function(d){return faseOf(d)==='advogado';}).length;
  var concl=all.filter(function(d){return faseOf(d)==='concluida';}).length;
  return '<div class="metrics">'+
    '<div class="mc gold"><div class="ml">Aguardando aprovação</div><div class="mv gold">'+aprov+'</div></div>'+
    '<div class="mc'+(c.verificar>0?' red':'')+'"><div class="ml">A verificar</div><div class="mv'+(c.verificar>0?' red':'')+'">'+c.verificar+'</div></div>'+
    '<div class="mc blue"><div class="ml">Fila / com advogado</div><div class="mv blue">'+(c.a_fazer+c.aguardando+comadv)+'</div></div>'+
    '<div class="mc"><div class="ml">Concluídas</div><div class="mv" style="color:var(--green)">'+concl+'</div></div>'+
  '</div>';
}
function diligKpisCtrl(){
  var me=String((currentUser&&currentUser.name)||'');
  function meu(d){ return diligVisivelPara(d,currentUser); }
  var mine=(S.diligencias||[]).filter(meu);
  var fila=mine.filter(function(d){return faseOf(d)==='fila';});
  var c={a_fazer:0,aguardando:0,verificar:0};fila.forEach(function(d){var s=statusFila(d);if(c[s]!=null)c[s]++;});
  var comadv=mine.filter(function(d){return faseOf(d)==='advogado';}).length;
  return '<div class="metrics">'+
    '<div class="mc'+(c.verificar>0?' red':'')+'"><div class="ml">A verificar</div><div class="mv'+(c.verificar>0?' red':'')+'">'+c.verificar+'</div></div>'+
    '<div class="mc"><div class="ml">A fazer</div><div class="mv">'+c.a_fazer+'</div></div>'+
    '<div class="mc gold"><div class="ml">Aguardando</div><div class="mv gold">'+c.aguardando+'</div></div>'+
    '<div class="mc blue"><div class="ml">Com advogado</div><div class="mv blue">'+comadv+'</div></div>'+
  '</div>';
}
function diligUniq(fn){var a=[];(S.diligencias||[]).forEach(function(d){var v=fn(d);if(v&&a.indexOf(v)<0)a.push(v);});a.sort();return a;}
function diligOptSel(arr,cur,ph){return '<option value="">'+ph+'</option>'+arr.map(function(x){return '<option'+(cur===x?' selected':'')+'>'+esc(x)+'</option>';}).join('');}
function dfSet(k,v){_diligF[k]=v;navigate('diligencias');}
function dfEndOfWeek(){var d=new Date();var day=d.getDay();var diff=(day===0?0:7-day);d.setDate(d.getDate()+diff);return d.toISOString().slice(0,10);}
function dfEndOfMonth(){var d=new Date();var e=new Date(d.getFullYear(),d.getMonth()+1,0);return e.toISOString().slice(0,10);}
// Na Fila, os atalhos filtram por DATA DE VERIFICAÇÃO com início aberto → HOJE/Semana/Mês incluem os vencidos.
// Nas demais abas, mantém o comportamento por data de referência (início do período → hoje).
function dfQuick(m){var t=todayStr(),fila=(_diligTab==='fila');
  if(m==='tudo'){_diligF.de='';_diligF.ate='';}
  else if(fila){_diligF.de='';_diligF.ate=(m==='hoje')?t:(m==='semana'?dfEndOfWeek():dfEndOfMonth());}
  else{_diligF.de=(m==='hoje')?t:(m==='semana'?diligStartWeek():(t.slice(0,7)+'-01'));_diligF.ate=t;}
  navigate('diligencias');}
function dfLimpar(){_diligF={q:'',adv:'',resp:'',uf:'',comarca:'',de:'',ate:'',acima20k:false,status:''};navigate('diligencias');}
function diligStartWeek(){var d=new Date();var day=d.getDay();var diff=(day===0?-6:1)-day;d.setDate(d.getDate()+diff);return d.toISOString().slice(0,10);}
function diligRefDate(d){return d.dataCumprimento||d.dataRealizacao||d.dataInicio||((d.historico&&d.historico[0])?String(d.historico[0].ts).slice(0,10):'')||'';}
function diligApplyFiltro(rows){
  if(_diligF.acima20k)rows=rows.filter(diligPrio);
  if(_diligF.status)rows=rows.filter(function(d){return diligStatusKey(d)===_diligF.status;});
  if(_diligF.adv)rows=rows.filter(function(d){return d.adv===_diligF.adv;});
  if(_diligF.resp)rows=rows.filter(function(d){return d.resp===_diligF.resp;});
  if(_diligF.uf)rows=rows.filter(function(d){return d.uf===_diligF.uf;});
  if(_diligF.comarca)rows=rows.filter(function(d){return d.comarca===_diligF.comarca;});
  if(_diligF.de||_diligF.ate)rows=rows.filter(function(d){
    var porVenc=(_diligTab==='fila');            // na Fila, a data relevante é a de verificação (vencimento)
    var r=porVenc?(d.dataVerificar||''):diligRefDate(d);
    if(!r)return porVenc?true:false;             // na Fila, item sem data de verificação (não iniciado) não é escondido
    if(_diligF.de&&r<_diligF.de)return false;
    if(_diligF.ate&&r>_diligF.ate)return false;
    return true;});
  return rows;
}
function diligFiltroBar(presentes){
  var quick=[['hoje','Hoje'],['semana','Semana'],['mes','Mês'],['tudo','Tudo']].map(function(q){return '<button class="btn" style="font-size:12px;padding:7px 10px" onclick="dfQuick(\''+q[0]+'\')">'+q[1]+'</button>';}).join('');
  var tem=_diligF.de||_diligF.ate||_diligF.adv||_diligF.resp||_diligF.uf||_diligF.comarca||_diligF.acima20k||_diligF.status||_diligF.q;
  var statusSel=(presentes&&presentes.length>1)?'<div class="fg" style="margin:0;max-width:190px"><label>Situação</label><select onchange="dfSet(\'status\',this.value)"><option value="">Todas as situações</option>'+presentes.map(function(k){return '<option value="'+esc(k)+'"'+(_diligF.status===k?' selected':'')+'>'+esc(diligStatusLabel(k))+'</option>';}).join('')+'</select></div>':'';
  return '<div class="filter-bar" style="align-items:flex-end;display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px">'+
    '<div class="fg" style="margin:0;max-width:150px"><label>De</label><input type="date" value="'+esc(_diligF.de||'')+'" onchange="dfSet(\'de\',this.value)"/></div>'+
    '<div class="fg" style="margin:0;max-width:150px"><label>Até</label><input type="date" value="'+esc(_diligF.ate||'')+'" onchange="dfSet(\'ate\',this.value)"/></div>'+
    '<div style="display:flex;gap:5px;flex-wrap:wrap;align-items:flex-end">'+quick+'</div>'+
    '<div class="fg" style="margin:0;max-width:170px"><label>Advogado</label><select onchange="dfSet(\'adv\',this.value)">'+diligOptSel(diligUniq(function(d){return d.adv;}),_diligF.adv,'Todos advogados')+'</select></div>'+
    '<div class="fg" style="margin:0;max-width:170px"><label>Responsável</label><select onchange="dfSet(\'resp\',this.value)">'+diligOptSel(diligUniq(function(d){return d.resp;}),_diligF.resp,'Todas responsáveis')+'</select></div>'+
    statusSel+
    '<div class="fg" style="margin:0;max-width:120px"><label>Estado</label><select onchange="dfSet(\'uf\',this.value)">'+diligOptSel(diligUniq(function(d){return d.uf;}),_diligF.uf,'Todos estados')+'</select></div>'+
    '<div class="fg" style="margin:0;max-width:180px"><label>Comarca</label><select onchange="dfSet(\'comarca\',this.value)">'+diligOptSel(diligUniq(function(d){return d.comarca;}),_diligF.comarca,'Todas comarcas')+'</select></div>'+
    '<label class="fg" style="flex-direction:row;align-items:center;gap:6px;margin:0"><input type="checkbox"'+(_diligF.acima20k?' checked':'')+' onchange="dfSet(\'acima20k\',this.checked)"/> &gt; R$ 20.000</label>'+
    (tem?'<button class="btn" style="font-size:12px" onclick="dfLimpar()">Limpar</button>':'')+
    '<div style="flex-basis:100%;height:0"></div>'+
    '<input class="search-input" id="dilig-busca" value="'+esc(_diligF.q||'')+'" placeholder="Buscar processo, advogado, tipo..." oninput="_diligF.q=this.value;diligFiltrarBusca()" style="flex:1;min-width:220px;border:1px solid var(--bd);border-radius:7px;padding:8px 10px;font-size:13px"/>'+
  '</div>';
}
function diligFiltrarBusca(){var q=(document.getElementById('dilig-busca').value||'').toLowerCase().trim();document.querySelectorAll('#dilig-tb tr').forEach(function(r){r.style.display=(!q||(r.getAttribute('data-b')||'').indexOf(q)>=0)?'':'none';});}
function diligAcoes(d,ctx){
  var id=d.id;
  var _edit=isEquipeDilig(currentUser)?'<button class="btn" style="font-size:11px;padding:4px 8px" title="Editar" onclick="modalEditDilig(\''+id+'\')">✏️</button>':'';
  var _del=isFullAccess(currentUser)?'<button class="btn" style="font-size:11px;padding:4px 8px;color:var(--red)" title="Excluir (admin)" onclick="deleteDilig(\''+id+'\')">×</button>':'';
  var h='<button class="btn" style="font-size:11px;padding:4px 8px" onclick="histModal(\''+id+'\')">🕑</button>'+_edit+_del;
  if(ctx==='aprovacao')return '<button class="btn bp" style="font-size:11px;padding:4px 9px;background:var(--green);border-color:var(--green)" onclick="aprovar(\''+id+'\')">✅ Aprovar</button><button class="btn" style="font-size:11px;padding:4px 9px;background:var(--redl);color:var(--red);border-color:var(--red)" onclick="reprovar(\''+id+'\')">↩️ Reprovar</button>'+h;
  if(ctx==='correcoes')return '<button class="btn bp" style="font-size:11px;padding:4px 9px" onclick="corrigir(\''+id+'\')">✏️ Corrigir e reenviar</button>'+h;
  if(ctx==='tarefas')return '<button class="btn bp" style="font-size:11px;padding:4px 9px" onclick="tarefaConcluir(\''+id+'\')">✅ Concluir e devolver</button>'+h;
  if(ctx==='concluidas'||ctx==='minhas'||ctx==='comadv')return h;
  var st=statusFila(d),a='';
  if(st==='a_fazer')a='<button class="btn bp" style="font-size:11px;padding:4px 9px" onclick="marcarFeita(\''+id+'\')">Registrar feita</button>';
  else a='<button class="btn'+(st==='verificar'?' bp':'')+'" style="font-size:11px;padding:4px 9px'+(st==='verificar'?';background:var(--red);border-color:var(--red)':'')+'" onclick="modalVerificar(\''+id+'\')">'+'Verificar</button>';
  return a+'<button class="btn" style="font-size:11px;padding:4px 8px;background:var(--bluel);color:var(--blue);border-color:var(--blue)" onclick="enviarAdv(\''+id+'\')" title="Enviar ao advogado">📨 Advogado</button><button class="btn" style="font-size:11px;padding:4px 8px" onclick="devolverLiq(\''+id+'\')" title="Devolver por liquidação">↩️ Liq.</button>'+h;
}
// Busca o objeto processo vinculado a uma diligência (por número normalizado).
function diligProcObj(d){ var num=String(d.proc||'').replace(/\D/g,''); if(!num)return null; return (S.processos||[]).find(function(x){return String(x.numero||'').replace(/\D/g,'')===num;})||null; }
function diligEhLiquidacao(d){
  if((d.historico||[]).some(function(h){return h.tag==='liquidacao';})) return true;
  var p=diligProcObj(d);
  return !!(p && /liquidado/.test(p.status||''));
}
// Valor para fins de LIQUIDAÇÃO = soma das liquidações (parcial/total) que a Karen lançou
// para o processo vinculado (S.liqManual). É esse valor que deve constar nos relatórios de
// diligências, e não o valor cadastrado (condenação/compra). Fallbacks: recebimentos do
// processo e, por fim, o valor gravado na diligência.
function diligRecebidoProc(d){
  var p=diligProcObj(d);
  var num=String(d.proc||'').replace(/\D/g,'');
  var soma=0, achou=false;
  (S.liqManual||[]).forEach(function(m){
    var mnum=String(m.processo||'').replace(/\D/g,'');
    if((p&&m.processoId===p.id) || (num&&mnum===num)){ soma+=Number(m.valor)||0; achou=true; }
  });
  if(achou) return soma;
  if(p) return recebOf(p).reduce(function(s,r){return s+(Number(r.valor)||0);},0);
  return Number(d.valor||0);
}
function diligResumo(rows){
  var n=rows.length, vTot=0, vLiq=0, nLiq=0, seen={};
  rows.forEach(function(d){
    vTot+=Number(d.valor||0);
    var concl=d.cumprida||faseOf(d)==='concluida';
    if(concl && diligEhLiquidacao(d)){
      nLiq++;
      var key=String(d.proc||'').replace(/\D/g,'')||('id:'+d.id); // 1x por processo (evita duplicar)
      if(!seen[key]){ seen[key]=1; vLiq+=diligRecebidoProc(d); }
    }
  });
  function c(lbl,val,cor,sub){ return '<div style="flex:1;min-width:150px;background:var(--card);border:.5px solid var(--bd);border-radius:8px;padding:9px 12px"><div style="font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--mt);font-weight:700">'+lbl+'</div><div style="font-size:17px;font-weight:800;color:'+(cor||'var(--v)')+';margin-top:2px;font-variant-numeric:tabular-nums">'+val+'</div>'+(sub?'<div style="font-size:10px;color:var(--mt);margin-top:1px">'+sub+'</div>':'')+'</div>'; }
  return '<div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px">'+
    c('Diligências (filtro)', n, 'var(--v)')+
    c('Concluídas por liquidação', nLiq, 'var(--blue)')+
    c('Valor liquidado (registrado)', fmt(vLiq), 'var(--green)', 'liquidações lançadas (parcial/total)')+
    c('Valor cadastrado (referência)', fmt(vTot), 'var(--mt)', 'condenação/compra (referência)')+
  '</div>';
}
async function tarefaConcluidaAdv(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;var n=(document.getElementById('tc-n')?document.getElementById('tc-n').value:'').trim();var t=d.tarefaAdvogado;d.tarefaAdvogado='';d.fase='concluida';d.cumprida=true;d.destino=null;d.dataCumprimento=todayStr();d.diasCumprimento=diligDiasEntre(d.dataInicio||d.dataRealizacao||todayStr(),todayStr());hist(d,'Advogado CONCLUIU a diligência'+(t?' ("'+t+'")':'')+' (concluída por ele, não devolvida).'+(n?' '+n:''),'aprovacao');try{await saveDiligencia(d);}catch(e){showToast('Erro: '+(e.code||e.message));return;}closeModal();navigate('diligencias');showToast('Diligência concluída pelo advogado.');}
function diligListaHTML(rows,ctx){
  var ORD_ST=['verificar','aguardando','a_fazer','cumprida','aprovacao','advogado','devolvida','concluida'];
  var presentes=[];rows.forEach(function(d){var k=diligStatusKey(d);if(presentes.indexOf(k)<0)presentes.push(k);});
  presentes.sort(function(a,b){return ORD_ST.indexOf(a)-ORD_ST.indexOf(b);});
  if(_diligF.status&&presentes.indexOf(_diligF.status)<0)_diligF.status='';
  var filtro=diligFiltroBar(presentes);
  rows=diligApplyFiltro(rows);
  if(!rows.length)return filtro+'<div class="card"><div class="empty">Nenhuma diligência com esses filtros.</div></div>';
  var ord={verificar:0,aguardando:1,a_fazer:2,cumprida:3};
  rows=rows.slice().sort(function(a,b){
    var va=statusFila(a)==='verificar'?0:1,vb=statusFila(b)==='verificar'?0:1;
    if(va!==vb)return va-vb;                                   // vencidos / a verificar no TOPO
    if(diligPrio(a)!==diligPrio(b))return diligPrio(a)?-1:1;   // depois prioridade (> R$ 20.000)
    var sa=ord[statusFila(a)]!=null?ord[statusFila(a)]:5,sb=ord[statusFila(b)]!=null?ord[statusFila(b)]:5;return sa-sb;});
  var _concl=(ctx==='concluidas');
  var trs=rows.map(function(d){
    var loc=(d.uf||'')+(d.comarca?' · '+d.comarca:'')+(d.vara?' · '+d.vara:'');
    // Nas concluídas, a coluna Valor mostra o valor de liquidação registrado (Karen), não o cadastrado.
    var valorCol=_concl?diligRecebidoProc(d):Number(d.valor||0);
    var st=statusFila(d),rest=diligDiasRest(d),pz='—';
    if(faseOf(d)==='fila'){if(st==='verificar')pz='<b style="color:var(--red)">venceu há '+(rest==null?0:-rest)+'d</b>';else if(st==='aguardando')pz='<span style="color:var(--d)">faltam '+rest+'d</span>';else if(st==='a_fazer')pz='<span style="color:var(--mt)">não iniciada</span>';}
    var tipoTxt=esc(d.tipo||'—')+(d.tipoDetalhe?' <span style="color:var(--mt)">('+esc(d.tipoDetalhe)+')</span>':'');
    var sub=(d.justificativaDevolucao&&faseOf(d)==='devolvida')?'<div style="color:var(--red);font-size:10px;max-width:250px;white-space:normal">↩ '+esc(d.justificativaDevolucao)+'</div>':'';
    sub+=(d.tarefaAdvogado&&faseOf(d)==='advogado')?'<div style="color:var(--blue);font-size:10px;max-width:250px;white-space:normal">📨 '+esc(d.tarefaAdvogado)+'</div>':'';
    sub+=(d.obs?'<div style="color:var(--mt);font-size:10px;max-width:250px;white-space:normal">'+esc(d.obs)+'</div>':'');
    return '<tr data-b="'+esc(((d.proc||'')+' '+(d.adv||'')+' '+(d.tipo||'')+' '+(d.resp||'')+' '+(d.trib||'')+' '+(d.comarca||'')).toLowerCase())+'">'+
      '<td style="font-size:11px;white-space:nowrap">'+esc(d.proc||'—')+(diligPrio(d)?'<div style="margin-top:3px">'+tagPrioDilig(d)+'</div>':'')+'</td>'+
      '<td style="font-size:11px"><b>'+esc(d.trib||'—')+'</b><div style="color:var(--mt);font-size:10px">'+esc(loc)+'</div></td>'+
      '<td style="font-size:12px">'+tipoTxt+sub+'</td>'+
      '<td style="font-size:11px">'+esc(d.adv||'—')+'</td>'+
      '<td style="font-size:11px">'+(d.resp?esc(d.resp):'<span style="color:var(--mt)">—</span>')+'</td>'+
      '<td class="r" style="font-size:11px">'+fmt(valorCol)+(_concl&&valorCol!==Number(d.valor||0)?'<div style="font-size:9px;color:var(--mt)">liquidação</div>':'')+'</td>'+
      '<td>'+faseBadgeDe(d)+'</td>'+
      '<td style="font-size:11px;white-space:nowrap">'+pz+'</td>'+
      '<td style="white-space:nowrap">'+diligAcoes(d,ctx)+'</td></tr>';
  }).join('');
  return filtro+diligResumo(rows)+'<div style="font-size:12px;color:var(--mt);margin-bottom:8px">'+rows.length+' diligência(s).</div><div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr><th>Processo</th><th>Tribunal / Local</th><th>Diligência</th><th>Advogado</th><th>Responsável</th><th class="r">Valor</th><th>Situação</th><th>Prazo</th><th></th></tr></thead><tbody id="dilig-tb">'+trs+'</tbody></table></div>';
}
function pageDiligencias(){
  var all=S.diligencias||[];
  var abas=diligTabsFor(currentUser);
  var validos=abas.map(function(a){return a[0];});
  if(validos.indexOf(_diligTab)<0)_diligTab=validos[0];
  var _meN=String((currentUser&&currentUser.name)||'');
  var cAprov=all.filter(function(d){return faseOf(d)==='aprovacao';}).length;
  var cDevol=all.filter(function(d){return faseOf(d)==='devolvida'&&(!isAdvDilig(currentUser)||diligDono(d));}).length;
  var cTar=all.filter(function(d){return faseOf(d)==='advogado'&&(!isAdvDilig(currentUser)||diligDono(d))&&(!isControllerRestrito(currentUser)||diligVisivelPara(d,currentUser));}).length;
  var head='<div class="page-title">'+I.diligencias+' Diligências <span class="badge" style="background:var(--v);color:#fff">'+all.length+'</span><span style="flex:1"></span>'+
    '<button class="btn bp" style="font-size:12px" onclick="modalNovaDilig()">+ '+(isAdvDilig(currentUser)?'Nova solicitação':'Nova diligência')+'</button></div>';
  var banner=(podeAprovarDilig(currentUser)&&!isControllerRestrito(currentUser)&&cAprov>0)?'<div class="card" style="background:var(--dl);border-color:var(--d);font-size:12px;padding:10px 13px;margin-bottom:14px">🗂️ <b>'+cAprov+'</b> solicitação(ões) aguardando aprovação.</div>':'';
  var kpis=isAdvDilig(currentUser)?'':(isControllerRestrito(currentUser)?diligKpisCtrl():diligKpisHTML(all));
  var tabs='<div class="tabs" style="display:flex;gap:4px;background:var(--row-alt);border:1px solid var(--bd);border-radius:8px;padding:4px;width:fit-content;margin-bottom:16px;flex-wrap:wrap">'+abas.map(function(a){
    var x=(a[0]==='aprovacao'&&cAprov)?' ('+cAprov+')':((a[0]==='correcoes'&&cDevol)?' ('+cDevol+')':(((a[0]==='tarefas'||a[0]==='comadv')&&cTar)?' ('+cTar+')':''));
    return '<button class="btn'+(_diligTab===a[0]?' bp':'')+'" style="font-size:13px;padding:6px 16px;border:none;border-radius:6px'+(_diligTab===a[0]?'':';background:none')+'" onclick="_diligTab=\''+a[0]+'\';navigate(\'diligencias\')">'+a[1]+x+'</button>';
  }).join('')+'</div>';
  var body;
  if(_diligTab==='manual'){ body=diligManualHTML(); banner=''; kpis=''; }
  else if(_diligTab==='monit') body=diligMonitView();
  else if(_diligTab==='prod') body=diligProdHTML();
  else body=diligListaHTML(diligRowsFor(_diligTab),_diligTab);
  return head+banner+kpis+tabs+body;
}
/* ===== Monitoramento ===== */
function _dmFirstOfMonth(){return todayStr().slice(0,7)+'-01';}
function _dmInRange(d){if(!_diligMonF.de&&!_diligMonF.ate)return true;var ref=d.cumprida?d.dataCumprimento:(d.dataRealizacao||d.dataInicio);if(!ref)return false;ref=String(ref).slice(0,10);if(_diligMonF.de&&ref<_diligMonF.de)return false;if(_diligMonF.ate&&ref>_diligMonF.ate)return false;return true;}
function _dmMonQuick(m){if(m==='hoje'){_diligMonF.de=todayStr();_diligMonF.ate=todayStr();}else if(m==='semana'){_diligMonF.de=diligStartWeek();_diligMonF.ate=todayStr();}else if(m==='mes'){_diligMonF.de=_dmFirstOfMonth();_diligMonF.ate=todayStr();}else{_diligMonF.de='';_diligMonF.ate='';}navigate('diligencias');}
function _dmSetDe(v){_diligMonF.de=v;navigate('diligencias');}
function _dmSetAte(v){_diligMonF.ate=v;navigate('diligencias');}
function _dmAgrupa(L,keyFn){
  var g={};
  L.forEach(function(d){var k=keyFn(d);if(!k)return;if(!g[k])g[k]={k:k,aberto:0,agSum:0,agN:0,cumpr:0,cSum:0,cN:0};
    if(d.cumprida){g[k].cumpr++;if(d.diasCumprimento!=null){g[k].cSum+=d.diasCumprimento;g[k].cN++;}}
    else if(d.dataRealizacao){g[k].aberto++;var a=diligAging(d);if(a!=null){g[k].agSum+=a;g[k].agN++;}}
  });
  return Object.keys(g).map(function(k){var o=g[k];o.agMed=o.agN?Math.round(o.agSum/o.agN):null;o.cMed=o.cN?Math.round(o.cSum/o.cN):null;return o;}).sort(function(a,b){return (b.agMed||0)-(a.agMed||0);});
}
function _dmTabela(titulo,sub,arr,colLabel){
  if(!arr.length)return '';
  var trs=arr.map(function(o){var al=(o.agMed!=null&&o.agMed>60)?' style="color:var(--red);font-weight:700"':'';return '<tr><td><b>'+esc(o.k)+'</b></td><td class="r">'+o.aberto+'</td><td class="r"'+al+'>'+(o.agMed!=null?o.agMed+' d':'—')+'</td><td class="r">'+o.cumpr+'</td><td class="r" style="color:var(--green)">'+(o.cMed!=null?o.cMed+' d':'—')+'</td></tr>';}).join('');
  return '<div class="card" style="padding:0;overflow-x:auto;margin-bottom:14px"><div style="padding:13px 16px 4px"><b style="color:var(--v)">'+titulo+'</b><div style="font-size:11px;color:var(--mt)">'+sub+'</div></div><table class="tbl"><thead><tr><th>'+(colLabel||'Grupo')+'</th><th class="r">Em aberto</th><th class="r">Tempo médio aberto</th><th class="r">Cumpridas</th><th class="r">Tempo médio cumprir</th></tr></thead><tbody>'+trs+'</tbody></table></div>';
}
function _dmHTML(L){
  if(!L.length)return '<div class="card"><div class="empty">Sem dados de monitoramento.</div></div>';
  var g={};
  L.forEach(function(d){var k=d.resp||'(sem responsável)';if(!g[k])g[k]={k:k,total:0,aberto:0,cumpr:0,cSum:0,cN:0};g[k].total++;
    if(d.cumprida){g[k].cumpr++;if(d.diasCumprimento!=null){g[k].cSum+=d.diasCumprimento;g[k].cN++;}}
    else if(d.dataRealizacao)g[k].aberto++;});
  var rArr=Object.keys(g).map(function(k){return g[k];}).sort(function(a,b){return b.total-a.total;});
  var rTr=rArr.map(function(o){var base=o.aberto+o.cumpr;var taxa=base?Math.round(100*o.cumpr/base):0;var tm=o.cN?Math.round(o.cSum/o.cN):null;
    return '<tr><td><b>'+esc(o.k)+'</b></td><td class="r">'+o.total+'</td><td class="r">'+o.aberto+'</td><td class="r" style="color:var(--green)">'+o.cumpr+'</td><td class="r">'+taxa+'%</td><td class="r">'+(tm!=null?tm+' d':'—')+'</td></tr>';}).join('');
  var tRes='<div class="card" style="padding:0;overflow-x:auto;margin-bottom:14px"><div style="padding:13px 16px 4px"><b style="color:var(--v)">Efetividade por responsável</b><div style="font-size:11px;color:var(--mt)">As diligências de cada uma estão surtindo efeito?</div></div><table class="tbl"><thead><tr><th>Responsável</th><th class="r">Total</th><th class="r">Em aberto</th><th class="r">Cumpridas</th><th class="r">Taxa cumprimento</th><th class="r">Tempo médio</th></tr></thead><tbody>'+rTr+'</tbody></table></div>';
  var comoLer='<div class="card" style="background:var(--bluel);border-color:var(--blue);font-size:12px;padding:11px 14px">Como ler: <i>Tempo médio aberto</i> mostra há quantos dias, em média, as diligências estão sem cumprimento naquele tribunal/comarca. <i>Tempo médio cumprir</i> mostra quantos dias levaram as já confirmadas como cumpridas. Linhas em vermelho passam de 60 dias em aberto.</div>';
  return comoLer+tRes+
    _dmTabela('Tempo processual por Tribunal','Tribunal de origem.',_dmAgrupa(L,function(d){return d.trib||'(sem tribunal)';}), 'Tribunal')+
    _dmTabela('Tempo processual por Comarca','Somente diligências com comarca preenchida.',_dmAgrupa(L,function(d){return d.comarca||'';}), 'Comarca')+
    _dmTabela('Tempo processual por Estado','Agrupado pela UF do número CNJ.',_dmAgrupa(L,function(d){return d.uf||'';}), 'Estado')+
    _dmTabela('Tempo processual por Vara','Somente diligências com vara preenchida.',_dmAgrupa(L,function(d){return d.vara||'';}), 'Vara');
}
function diligMonitView(){
  var base=(S.diligencias||[]).filter(function(d){return faseOf(d)==='fila'||faseOf(d)==='concluida';});
  if(isControllerRestrito(currentUser)){ var _me=String((currentUser&&currentUser.name)||''); base=base.filter(function(d){var r=String(d.resp||'');return r===''||r===_me;}); }
  var L=base.filter(_dmInRange);
  var rangeLbl=(_diligMonF.de||_diligMonF.ate)?('Período: '+(_diligMonF.de?fmtDate(_diligMonF.de):'início')+' a '+(_diligMonF.ate?fmtDate(_diligMonF.ate):'hoje')):'Todos os períodos';
  var quick='<div style="display:flex;gap:6px;flex-wrap:wrap;align-items:flex-end">'+[['hoje','Hoje'],['semana','Semana'],['mes','Mês'],['tudo','Tudo']].map(function(q){return '<button class="btn" style="font-size:12px;padding:7px 12px" onclick="_dmMonQuick(\''+q[0]+'\')">'+q[1]+'</button>';}).join('')+'</div>';
  var bar='<div class="filter-bar" style="align-items:flex-end">'+
    '<div class="fg" style="margin:0;max-width:180px"><label>De</label><input type="date" value="'+(_diligMonF.de||'')+'" onchange="_dmSetDe(this.value)"/></div>'+
    '<div class="fg" style="margin:0;max-width:180px"><label>Até</label><input type="date" value="'+(_diligMonF.ate||'')+'" onchange="_dmSetAte(this.value)"/></div>'+
    quick+'</div>';
  return bar+'<div style="font-size:12px;color:var(--mt);margin-bottom:10px">'+rangeLbl+' · '+L.length+' diligência(s) no recorte.</div>'+_dmHTML(L);
}

/* ===== Produtividade ===== */
// Semana passada: [segunda da semana passada, domingo da semana passada].
// diligStartWeek() = segunda desta semana; recua 7 dias (início) e 1 dia (fim).
function diligLastWeekRange(){var s=new Date(diligStartWeek()+'T00:00:00');var ini=new Date(s);ini.setDate(ini.getDate()-7);var fim=new Date(s);fim.setDate(fim.getDate()-1);return {de:ini.toISOString().slice(0,10),ate:fim.toISOString().slice(0,10)};}
function diligInProd(dateStr,mode){if(!dateStr)return false;var s=String(dateStr).slice(0,10),t=todayStr();if(mode==='hoje')return s===t;if(mode==='semana')return s>=diligStartWeek();if(mode==='semana_passada'){var r=diligLastWeekRange();return s>=r.de&&s<=r.ate;}if(mode==='mes')return s.slice(0,7)===t.slice(0,7);return true;}
function diligProdHTML(){
  var lbl={hoje:'Hoje',semana:'Esta semana',semana_passada:'Semana passada',mes:'Este mês'};
  var toggle='<div class="tabs" style="margin-bottom:14px">'+['hoje','semana','semana_passada','mes'].map(function(m){return '<button class="btn'+(_diligProd===m?' bp':'')+'" onclick="_diligProd=\''+m+'\';navigate(\'diligencias\')">'+lbl[m]+'</button>';}).join('')+'</div>';
  // Diligente restrito vê SÓ a própria produtividade (não a de outras responsáveis).
  var _ctrlProd=isControllerRestrito(currentUser); var _meProd=String((currentUser&&currentUser.name)||'');
  function _mineProd(d){ if(!_ctrlProd) return true; var r=String(d.resp||''); return r===''||r===_meProd; }
  var resps={};
  function _mk(r){return {r:r,real:0,concl:0,liq:0,valLiq:0};}
  if(_ctrlProd){ resps[_meProd]=_mk(_meProd); }
  else { diligUniq(function(d){return d.resp;}).forEach(function(r){resps[r]=_mk(r);}); }
  var _seenLiq={};
  (S.diligencias||[]).forEach(function(d){
    if(!_mineProd(d)) return;
    (d.ciclos||[]).forEach(function(c){if(c.resp&&diligInProd(c.data,_diligProd)&&(!_ctrlProd||c.resp===_meProd)){if(!resps[c.resp])resps[c.resp]=_mk(c.resp);resps[c.resp].real++;}});
    if(d.cumprida&&diligInProd(d.dataCumprimento,_diligProd)){var r=d.resp||'(sem responsável)';if(!resps[r])resps[r]=_mk(r);resps[r].concl++; if(diligEhLiquidacao(d)){resps[r].liq++; var key=String(d.proc||'').replace(/\D/g,'')||('id:'+d.id); if(!_seenLiq[key]){ _seenLiq[key]=1; resps[r].valLiq+=diligRecebidoProc(d); }}}
  });
  var arr=Object.keys(resps).map(function(k){return resps[k];}).sort(function(a,b){return (b.valLiq-a.valLiq)||((b.real+b.concl)-(a.real+a.concl));});
  var totR=arr.reduce(function(s,o){return s+o.real;},0),totC=arr.reduce(function(s,o){return s+o.concl;},0);
  var totL=arr.reduce(function(s,o){return s+o.liq;},0),totV=arr.reduce(function(s,o){return s+o.valLiq;},0);
  var eu=currentUser&&arr.find(function(o){return o.r===currentUser.name;});
  var kpiEu=eu?'<div class="metrics" style="grid-template-columns:repeat(3,minmax(0,1fr))"><div class="mc blue"><div class="ml">Você realizou ('+lbl[_diligProd].toLowerCase()+')</div><div class="mv blue">'+eu.real+'</div><div style="font-size:11px;color:var(--mt)">diligências trabalhadas</div></div><div class="mc"><div class="ml">Você concluiu</div><div class="mv" style="color:var(--green)">'+eu.concl+'</div><div style="font-size:11px;color:var(--mt)">cumpridas no período</div></div><div class="mc"><div class="ml">Valor liquidado (você)</div><div class="mv" style="color:var(--v)">'+fmt(eu.valLiq)+'</div><div style="font-size:11px;color:var(--mt)">'+eu.liq+' diligência(s) de liquidação</div></div></div>':'';
  var trs=arr.map(function(o){var me=currentUser&&o.r===currentUser.name?' style="background:var(--vl)"':'';return '<tr'+me+'><td><b>'+esc(o.r)+'</b></td><td class="r">'+o.real+'</td><td class="r" style="color:var(--green)">'+o.concl+'</td><td class="r" style="color:var(--blue)">'+o.liq+'</td><td class="r" style="font-weight:700">'+fmt(o.valLiq)+'</td></tr>';}).join('');
  return '<div class="page-title" style="font-size:14px;margin-bottom:8px">Produtividade & Liquidações — '+lbl[_diligProd]+'</div>'+toggle+kpiEu+
    '<div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr><th>Responsável</th><th class="r">Diligências realizadas</th><th class="r">Concluídas</th><th class="r">Conc. por liquidação</th><th class="r">Valor liquidado</th></tr></thead><tbody>'+trs+
    '<tr style="font-weight:800"><td>TOTAL</td><td class="r">'+totR+'</td><td class="r">'+totC+'</td><td class="r">'+totL+'</td><td class="r">'+fmt(totV)+'</td></tr></tbody></table></div>'+
    '<div style="font-size:11px;color:var(--mt);margin-top:8px">"Realizadas" conta cada execução/registro (inclui novas tentativas). "Concluídas" = cumpridas no período. <b>"Valor liquidado"</b> é o valor <b>efetivamente recebido</b> (lançado na liquidação, o que entrou na conta) nos processos das diligências concluídas que geraram liquidação — <b>não</b> o valor gravado de condenação/compra. Cada processo é somado uma única vez (evita duplicar quando há várias diligências no mesmo processo).</div>';
}
function afterDiligencias(){ /* hook p/ gráficos futuros */ }

// ── ABA: MANUAL DOS TRIBUNAIS ────────────────────────────────
function diligManualCanEdit(){ return !!currentUser; } // qualquer usuário logado (inclui advogados) pode cadastrar/editar
function diligManualHTML(){
  var all=(S.manual||[]).slice();
  var f=_manualF||{q:'',trib:'',comarca:''};
  var canEdit=diligManualCanEdit(), isFull=isFullAccess(currentUser);
  // opções de filtro
  var tribs=[]; all.forEach(function(m){ if(m.trib && tribs.indexOf(m.trib)<0) tribs.push(m.trib); }); tribs.sort();
  var comarcas=[]; all.forEach(function(m){ if((!f.trib||m.trib===f.trib) && m.comarca && comarcas.indexOf(m.comarca)<0) comarcas.push(m.comarca); }); comarcas.sort();
  // aplica filtros de dropdown (busca textual é client-side, live)
  var L=all.filter(function(m){
    if(f.trib && m.trib!==f.trib) return false;
    if(f.comarca && (m.comarca||'')!==f.comarca) return false;
    return true;
  });
  L.sort(function(a,b){ return (a.trib+' '+(a.comarca||'')+' '+(a.vara||'')).localeCompare(b.trib+' '+(b.comarca||'')+' '+(b.vara||'')); });

  var tribOpts='<option value="">Todos os tribunais</option>'+tribs.map(function(t){return '<option value="'+esc(t)+'"'+(f.trib===t?' selected':'')+'>'+esc(t)+'</option>';}).join('');
  var comOpts='<option value="">Todas as comarcas</option>'+comarcas.map(function(c){return '<option value="'+esc(c)+'"'+(f.comarca===c?' selected':'')+'>'+esc(c)+'</option>';}).join('');
  var filter='<div class="filter-bar no-print" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;margin-bottom:12px">'+
    '<input class="search-input" id="manual-search" placeholder="Buscar por tribunal, comarca, vara, sistema, texto..." oninput="diligManualFilter()" style="flex:2;min-width:220px"/>'+
    '<div class="fg" style="max-width:170px"><label>Tribunal</label><select onchange="_manualF.trib=this.value;_manualF.comarca=\'\';navigate(\'diligencias\')">'+tribOpts+'</select></div>'+
    '<div class="fg" style="max-width:200px"><label>Comarca</label><select onchange="_manualF.comarca=this.value;navigate(\'diligencias\')">'+comOpts+'</select></div>'+
    ((f.trib||f.comarca)?'<button class="btn no-print" style="font-size:12px" onclick="_manualF={q:\'\',trib:\'\',comarca:\'\'};navigate(\'diligencias\')">Limpar</button>':'')+
    (canEdit?'<button class="btn bp" style="font-size:12px;margin-left:auto" onclick="modalNovoManual()">+ Novo registro</button>':'')+
  '</div>';
  var intro='<div class="card" style="background:var(--bluel);border-color:var(--blue);margin-bottom:12px"><div style="font-size:12px;color:var(--tx)">'+
    '<b>Manual dos tribunais.</b> Filtre por tribunal, comarca ou vara (ou digite na busca — ex.: "Palhoça" ou "2ª vara cível"). Registros com comarca/vara em branco valem como orientação geral do tribunal. Qualquer pessoa da equipe pode cadastrar e editar; excluir é só admin. Evite guardar senhas compartilhadas — o campo de acesso fica salvo sem criptografia.'+
  '</div></div>';
  if(!L.length) return filter+intro+'<div class="card"><div class="empty" style="padding:20px;text-align:center;color:var(--mt)">Nenhum registro encontrado. Ajuste o filtro ou clique em "+ Novo registro".</div></div>';

  var trs=L.map(function(m){
    var acoes=canEdit?('<button class="ebtn" onclick="modalEditManual(\''+m.id+'\')">✏️</button>'+(isFull?'<button class="dbtn" onclick="deleteManual(\''+m.id+'\')">×</button>':'')):'';
    var notasHtml=m.notas? esc(m.notas).replace(/\n/g,'<br>') : '<span style="color:var(--mt)">—</span>';
    var credHtml=m.cred? '<div style="margin-top:6px;border-top:1px dashed var(--bd);padding-top:5px;font-size:11px"><b style="color:var(--d)">🔑 Acesso:</b> '+esc(m.cred).replace(/\n/g,'<br>')+'</div>':'';
    var msearch=esc((m.trib+' '+(m.comarca||'')+' '+(m.vara||'')+' '+(m.sistema||'')+' '+(m.notas||'')+' '+(m.cred||'')).toLowerCase());
    return '<tr data-msearch="'+msearch+'">'+
      '<td style="white-space:nowrap;vertical-align:top"><b>'+esc(m.trib)+'</b></td>'+
      '<td style="vertical-align:top;font-size:12px">'+(m.comarca?esc(m.comarca):'<span style="color:var(--mt)">geral</span>')+'</td>'+
      '<td style="vertical-align:top;font-size:12px">'+(m.vara?esc(m.vara):'<span style="color:var(--mt)">—</span>')+'</td>'+
      '<td style="vertical-align:top">'+(m.sistema?'<span class="badge" style="background:var(--vl);color:var(--v)">'+esc(m.sistema)+'</span>':'<span style="color:var(--mt)">—</span>')+'</td>'+
      '<td style="vertical-align:top;font-size:12px;line-height:1.5;min-width:280px;max-width:520px;white-space:normal">'+notasHtml+credHtml+'</td>'+
      '<td style="vertical-align:top;white-space:nowrap">'+acoes+'</td>'+
    '</tr>';
  }).join('');
  var table='<div class="card" style="padding:0;overflow-x:auto"><table class="tbl"><thead><tr>'+
    '<th>Tribunal</th><th>Comarca</th><th>Vara</th><th>Sistema</th><th>Informações</th><th></th>'+
    '</tr></thead><tbody id="manual-tbody">'+trs+'</tbody></table></div>';
  return filter+intro+table;
}
function diligManualFilter(){
  var el=document.getElementById('manual-search');
  var q=(el?el.value:'').toLowerCase().trim();
  document.querySelectorAll('#manual-tbody tr').forEach(function(r){
    var t=r.getAttribute('data-msearch')||'';
    r.style.display=(!q||t.indexOf(q)>=0)?'':'none';
  });
}
function modalNovoManual(){
  showModal('<div class="modal-title">Novo registro do manual</div>'+
    '<div style="display:flex;gap:10px"><div class="fg" style="flex:1"><label>Tribunal (sigla)</label><input id="mn-trib" placeholder="Ex: TJSC"/></div>'+
    '<div class="fg" style="flex:1"><label>Sistema (e-court)</label><input id="mn-sistema" placeholder="Ex: Eproc, PJe, SAJ..."/></div></div>'+
    '<div style="display:flex;gap:10px;margin-top:10px"><div class="fg" style="flex:1"><label>Comarca (opcional)</label><input id="mn-comarca" placeholder="Ex: Palhoça/SC"/></div>'+
    '<div class="fg" style="flex:1"><label>Vara (opcional)</label><input id="mn-vara" placeholder="Ex: 2ª Vara Cível"/></div></div>'+
    '<div class="fg" style="margin-top:10px"><label>Notas / procedimentos</label><textarea id="mn-notas" rows="6" placeholder="Petições, alvará, custas, exigências específicas da vara..."></textarea></div>'+
    '<div class="fg" style="margin-top:10px"><label>Acesso / credenciais (opcional — sem criptografia)</label><textarea id="mn-cred" rows="2" placeholder="Login / senha / observações de acesso"></textarea></div>'+
    '<div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="salvarNovoManual()">Salvar</button></div>');
}
// Persistência do Manual dos Tribunais (Firestore coleção 'manual').
async function saveManualDoc(m){
  var id=m.id || fb.doc(fb.collection(fb.db,'manual')).id; m.id=id;
  var payload=Object.assign({},m,{updatedAt:fb.serverTimestamp(),updatedBy:currentUser.id});
  if(!m.createdAt){ payload.createdAt=fb.serverTimestamp(); payload.createdBy=currentUser.id; }
  await fb.setDoc(fb.doc(fb.db,'manual',id), payload);
  return id;
}
async function salvarNovoManual(){
  if(!currentUser){ showToast('Sessão inválida.'); return; }
  var trib=document.getElementById('mn-trib').value.trim();
  if(!trib){ showToast('Informe a sigla do tribunal.'); return; }
  var m={id:null,trib:trib,comarca:document.getElementById('mn-comarca').value.trim(),vara:document.getElementById('mn-vara').value.trim(),sistema:document.getElementById('mn-sistema').value.trim(),notas:document.getElementById('mn-notas').value.trim(),cred:document.getElementById('mn-cred').value.trim()};
  try{ await saveManualDoc(m); S.manual=await fetchCollection('manual'); }catch(e){ showToast('Erro: '+(e.code||e.message)); return; }
  closeModal(); navigate('diligencias'); showToast('Registro cadastrado.');
}
function modalEditManual(id){
  var m=(S.manual||[]).find(function(x){return x.id===id;}); if(!m)return;
  showModal('<div class="modal-title">Editar registro</div>'+
    '<div style="display:flex;gap:10px"><div class="fg" style="flex:1"><label>Tribunal (sigla)</label><input id="mn-trib" value="'+esc(m.trib)+'"/></div>'+
    '<div class="fg" style="flex:1"><label>Sistema (e-court)</label><input id="mn-sistema" value="'+esc(m.sistema||'')+'"/></div></div>'+
    '<div style="display:flex;gap:10px;margin-top:10px"><div class="fg" style="flex:1"><label>Comarca (opcional)</label><input id="mn-comarca" value="'+esc(m.comarca||'')+'"/></div>'+
    '<div class="fg" style="flex:1"><label>Vara (opcional)</label><input id="mn-vara" value="'+esc(m.vara||'')+'"/></div></div>'+
    '<div class="fg" style="margin-top:10px"><label>Notas / procedimentos</label><textarea id="mn-notas" rows="7">'+esc(m.notas||'')+'</textarea></div>'+
    '<div class="fg" style="margin-top:10px"><label>Acesso / credenciais (opcional — sem criptografia)</label><textarea id="mn-cred" rows="2">'+esc(m.cred||'')+'</textarea></div>'+
    '<div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="salvarEditManual(\''+id+'\')">Salvar</button></div>');
}
async function salvarEditManual(id){
  var m=(S.manual||[]).find(function(x){return x.id===id;}); if(!m)return;
  var trib=document.getElementById('mn-trib').value.trim(); if(!trib){ showToast('Informe a sigla.'); return; }
  m.trib=trib; m.sistema=document.getElementById('mn-sistema').value.trim();
  m.comarca=document.getElementById('mn-comarca').value.trim(); m.vara=document.getElementById('mn-vara').value.trim();
  m.notas=document.getElementById('mn-notas').value.trim(); m.cred=document.getElementById('mn-cred').value.trim();
  try{ await saveManualDoc(m); S.manual=await fetchCollection('manual'); }catch(e){ showToast('Erro: '+(e.code||e.message)); return; }
  closeModal(); navigate('diligencias'); showToast('Atualizado.');
}
function deleteManual(id){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode excluir.'); return; }
  var m=(S.manual||[]).find(function(x){return x.id===id;}); if(!m)return;
  showModal('<div class="modal-title">Excluir registro?</div><p style="font-size:13px;color:var(--mt)">'+esc(m.trib)+(m.comarca?(' · '+esc(m.comarca)):'')+(m.vara?(' · '+esc(m.vara)):'')+'. Esta ação não pode ser desfeita.</p><div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" style="background:var(--red);border-color:var(--red)" onclick="confirmDeleteManual(\''+id+'\')">Excluir</button></div>');
}
async function confirmDeleteManual(id){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode excluir.'); return; }
  try{ await fb.deleteDoc(fb.doc(fb.db,'manual',id)); S.manual=(S.manual||[]).filter(function(x){return x.id!==id;}); }catch(e){ showToast('Erro: '+(e.code||e.message)); return; }
  closeModal(); navigate('diligencias'); showToast('Registro excluído.');
}

// ── MODAIS / AÇÕES ───────────────────────────────────────────
function modalNovaDilig(){
  var advCampo=isAdvDilig(currentUser)?
    '<input value="'+esc(currentUser.name)+'" disabled style="background:var(--row-alt)"/>':
    '<select id="nd-adv">'+diligLawyerOpts('')+'</select>';
  showModal('<div class="modal-title">'+(isAdvDilig(currentUser)?'Nova solicitação':'Nova diligência')+'</div>'+
    '<div class="note">Entra em <b>Aguardando aprovação</b> antes de ir à equipe.</div>'+
    '<div class="fg"><label>Número do processo (CNJ)</label><input id="nd-proc" placeholder="0000000-00.0000.0.00.0000" oninput="ndAutoLocal()"/><div id="nd-local" style="font-size:11px;color:var(--mt);margin-top:3px"></div></div>'+
    '<div style="display:flex;gap:10px"><div class="fg" style="flex:1"><label>Advogado solicitante</label>'+advCampo+'</div>'+
    '<div class="fg" style="flex:1"><label>Matéria</label>'+materiaSelectHTML('nd-materia','')+'</div></div>'+
    '<div class="fg" style="margin-top:8px"><label>Tipo de demanda</label>'+tipoOptsDilig('nd-tipo',DILIG_TIPOS[0])+'</div>'+
    '<div class="fg" id="nd-ow" style="display:none"><label>Detalhar (Outros)</label><input id="nd-o" placeholder="Descreva a demanda..."/></div>'+
    '<div style="display:flex;gap:10px;margin-top:8px"><div class="fg" style="flex:1"><label>Valor nos autos (R$)</label><input id="nd-valor" type="number" step="0.01" oninput="ndPrioHint()"/><div id="nd-prio" style="font-size:11px"></div></div>'+
    '<div class="fg" style="flex:1"><label>Comarca</label><input id="nd-comarca"/></div>'+
    '<div class="fg" style="flex:1"><label>Vara</label><input id="nd-vara"/></div></div>'+
    '<div class="fg" style="margin-top:8px"><label>Observações</label><textarea id="nd-obs" rows="2"></textarea></div>'+
    '<div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="salvarNovaDilig()">Enviar para aprovação</button></div>');
  document.getElementById('nd-tipo').onchange=function(){document.getElementById('nd-ow').style.display=this.value==='Outros'?'flex':'none';};
}
function ndAutoLocal(){
  var v=document.getElementById('nd-proc').value;
  var p=diligParseCNJ(v);
  var el=document.getElementById('nd-local');
  if(p.trib){
    el.innerHTML='Detectado: <b>'+p.trib+'</b>'+(p.uf?(' · '+p.uf):'')+(p.orig?(' · origem '+p.orig):'');
    var c=document.getElementById('nd-comarca');
    if(c && !c.value && DILIG_CAPITAIS[p.uf]){ c.value=DILIG_CAPITAIS[p.uf]; el.innerHTML+=' · <span style="color:var(--d)">comarca sugerida: '+DILIG_CAPITAIS[p.uf]+'</span>'; }
  } else { el.textContent=v?'CNJ incompleto — preencha os 20 dígitos.':''; }
}
function ndPrioHint(){ var v=parseFloat(document.getElementById('nd-valor').value)||0; document.getElementById('nd-prio').innerHTML=v>DILIG_VALOR_LIMITE?'<span style="color:var(--red);font-weight:700">⏫ Alta prioridade</span>':''; }
async function salvarNovaDilig(){
  var proc=document.getElementById('nd-proc').value.trim();
  if(!proc){ showToast('Informe o número do processo.'); return; }
  var cat=document.getElementById('nd-tipo').value;
  var outro=(document.getElementById('nd-o')&&document.getElementById('nd-o').value||'').trim();
  if(cat==='Outros'&&!outro){ showToast('Detalhe a demanda em "Outros".'); return; }
  var p=diligParseCNJ(proc);
  var advNome=isAdvDilig(currentUser)?currentUser.name:(document.getElementById('nd-adv')?document.getElementById('nd-adv').value:'');
  var d={
    id:null, proc:proc, trib:p.trib, uf:p.uf, orig:p.orig,
    comarca:document.getElementById('nd-comarca').value.trim(),
    vara:document.getElementById('nd-vara').value.trim(),
    adv:advNome, advId:diligAdvIdPorNome(advNome)||(isAdvDilig(currentUser)?currentUser.lawyerId:null),
    criadorId:currentUser.lawyerId||currentUser.id||null,
    tipo:cat==='Outros'?outro:cat, tipoCat:cat, tipoDetalhe:cat==='Outros'?outro:'',
    materia:document.getElementById('nd-materia').value,
    resp:'', valor:parseFloat(document.getElementById('nd-valor').value)||0,
    obs:document.getElementById('nd-obs').value.trim(), secao:'',
    fase:'aprovacao', destino:null,
    dataInicio:null, dataRealizacao:null, dataVerificar:null,
    ciclos:[], cumprida:false, dataCumprimento:null, diasCumprimento:null,
    historico:[]
  };
  hist(d,'Solicitação criada e enviada para aprovação.','criacao');
  try{ await saveDiligencia(d); S.diligencias.unshift(d); }catch(e){ showToast('Erro ao salvar: '+(e.code||e.message)); return; }
  closeModal(); navigate('diligencias');
  showToast('Solicitação enviada. Aguardando aprovação.');
}
async function marcarFeita(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;
  showModal('<div class="modal-title">Registrar diligência feita</div><div style="font-size:12px;color:var(--mt);margin-bottom:8px">'+esc(d.tipo||'')+'</div>'+
  '<div style="display:flex;gap:10px"><div class="fg" style="flex:1"><label>Responsável</label><select id="rf-resp">'+diligLawyerOpts(d.resp||'')+'</select></div>'+
  '<div class="fg" style="flex:1"><label>Data da realização</label><input type="date" id="rf-data" value="'+todayStr()+'"/></div></div>'+
  '<div class="fg"><label>Verificar em</label><input type="date" id="rf-ver" value="'+diligAddDias(todayStr(),diligPrazoDias())+'"/></div>'+
  '<div style="text-align:right;margin-top:8px"><button class="btn" onclick="closeModal()">Cancelar</button> <button class="btn bp" onclick="marcarFeitaOk(\''+id+'\')">Salvar</button></div>');}
async function marcarFeitaOk(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;
  var resp=document.getElementById('rf-resp').value,dr=document.getElementById('rf-data').value||todayStr(),dv=document.getElementById('rf-ver').value||diligAddDias(dr,diligPrazoDias());
  d.resp=resp||d.resp;d.respId=diligRespId(d.resp);d.dataInicio=d.dataInicio||dr;d.dataRealizacao=dr;d.dataVerificar=dv;(d.ciclos=d.ciclos||[]).push({data:dr,resp:resp,obs:''});
  hist(d,'Diligência realizada pela equipe'+(resp?' ('+resp+')':'')+'. Verificar em '+fmtDate(dv)+'.','andamento');
  try{await saveDiligencia(d);}catch(e){showToast('Erro: '+(e.code||e.message));return;} closeModal();navigate('diligencias');showToast('Registrada. Reaparece em '+fmtDate(dv)+'.');}
function modalVerificar(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;var aging=diligDiasEntre(d.dataInicio||d.dataRealizacao,todayStr());
  showModal('<div class="modal-title">Verificar diligência</div>'+
  '<div class="card" style="margin-bottom:12px"><div style="font-size:11px">'+esc(d.proc||'')+'</div><div style="margin:4px 0"><b>'+esc(d.tipo||'—')+'</b> '+tagPrioDilig(d)+'</div><div style="font-size:12px;color:var(--mt)">'+esc(d.trib||'')+' · Resp.: '+esc(d.resp||'—')+' · realizada '+fmtDate(d.dataRealizacao)+(aging!=null?' (há '+aging+'d)':'')+'</div></div>'+
  '<div class="fg"><label>Observação (opcional)</label><textarea id="vf-o" rows="2">'+esc(d.obs||'')+'</textarea></div>'+
  '<div class="fg" style="max-width:230px"><label>Data da próxima verificação</label><input type="date" id="vf-d" value="'+diligAddDias(todayStr(),diligPrazoDias())+'"/></div>'+
  '<div style="display:flex;flex-direction:column;gap:8px;margin-top:6px">'+
  '<button class="btn bp" style="background:var(--green);border-color:var(--green)" onclick="vfCumprida(\''+id+'\')">✅ Sim — diligência cumprida</button>'+
  '<button class="btn" style="background:var(--dl);color:var(--d);border-color:var(--d)" onclick="alvaraParcial(\''+id+'\')">🧾 Alvará parcial — concluir e enviar ao advogado (saldo remanescente)</button>'+
  '<button class="btn" onclick="vfNova(\''+id+'\')">🔄 Sim — realizar nova diligência</button>'+
  '<button class="btn" style="background:var(--redl);color:var(--red);border-color:var(--red)" onclick="vfNao(\''+id+'\')">⛔ Não — diligência não realizada</button>'+
  '<button class="btn" style="background:var(--bluel);color:var(--blue);border-color:var(--blue)" onclick="enviarAdv(\''+id+'\')">📨 Enviar ao advogado para realizar tarefa</button>'+
  '<button class="btn" style="opacity:.7" onclick="closeModal()">Cancelar</button></div>');}
function _vfO(){var e=document.getElementById('vf-o');return e?e.value.trim():'';}
function _vfD(){var e=document.getElementById('vf-d');return e&&e.value?e.value:diligAddDias(todayStr(),diligPrazoDias());}
async function vfCumprida(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;var o=_vfO();if(o)d.obs=o;d.cumprida=true;d.fase='concluida';d.dataCumprimento=todayStr();d.diasCumprimento=diligDiasEntre(d.dataInicio||d.dataRealizacao||todayStr(),todayStr());d.destino='advogado';d.advId=d.advId||diligAdvIdPorNome(d.adv);hist(d,'Diligência CUMPRIDA. Devolvida ao advogado '+(d.adv||'')+' para ciência.'+(o?' Obs.: '+o:''),'aprovacao');try{await saveDiligencia(d);}catch(e){showToast('Erro: '+(e.code||e.message));return;}closeModal();navigate('diligencias');showToast('Cumprida! Devolvida ao advogado.');}
async function vfNova(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;var o=_vfO(),dv=_vfD();d.dataRealizacao=todayStr();d.dataVerificar=dv;(d.ciclos=d.ciclos||[]).push({data:todayStr(),resp:d.resp||'',obs:o});hist(d,'Nova diligência realizada ('+d.ciclos.length+'ª). Próxima verificação em '+fmtDate(dv)+'.'+(o?' '+o:''),'andamento');try{await saveDiligencia(d);}catch(e){showToast('Erro: '+(e.code||e.message));return;}closeModal();navigate('diligencias');showToast('Nova diligência registrada.');}
function vfNao(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;
  showModal('<div class="modal-title">Diligência não realizada</div><div class="fg"><label>Justificativa do impedimento (obrigatória)</label><textarea id="nr-j" rows="3"></textarea></div><div class="fg" style="max-width:230px"><label>Reagendar verificação para</label><input type="date" id="nr-d" value="'+diligAddDias(todayStr(),diligPrazoDias())+'"/></div><div style="text-align:right;margin-top:8px"><button class="btn" onclick="closeModal()">Cancelar</button> <button class="btn bp" style="background:var(--red);border-color:var(--red)" onclick="vfNaoOk(\''+id+'\')">Registrar</button></div>');}
async function vfNaoOk(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;var j=(document.getElementById('nr-j').value||'').trim();if(!j){showToast('Informe a justificativa.');return;}var dv=document.getElementById('nr-d').value||diligAddDias(todayStr(),diligPrazoDias());d.obs=(d.obs?d.obs+' · ':'')+'Não realizada: '+j;d.dataVerificar=dv;hist(d,'NÃO realizada — '+j+'. Reagendada para '+fmtDate(dv)+'.','reprovacao');try{await saveDiligencia(d);}catch(e){showToast('Erro: '+(e.code||e.message));return;}closeModal();navigate('diligencias');showToast('Impedimento registrado.');}
function aprovar(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;showModal('<div class="modal-title">Aprovar diligência</div><div style="font-size:12px;color:var(--mt)">'+esc(d.proc||'')+'</div><div style="font-weight:600;margin-bottom:10px">'+esc(d.tipo||'—')+'</div><div class="fg"><label>Observações do aprovador (opcional)</label><textarea id="ap-obs" rows="3"></textarea></div><div style="text-align:right;margin-top:10px"><button class="btn" onclick="closeModal()">Cancelar</button> <button class="btn bp" style="background:var(--green);border-color:var(--green)" onclick="aprovarOk(\''+id+'\')">✅ Aprovar</button></div>');}
async function aprovarOk(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;var o=(document.getElementById('ap-obs').value||'').trim();d.fase='fila';d.obsAprovador=o;d.destino=null;if(o)d.obs=(d.obs?d.obs+' · ':'')+'Aprovação: '+o;hist(d,'Aprovada — enviada à fila da equipe.'+(o?' Obs.: '+o:''),'aprovacao');try{await saveDiligencia(d);}catch(e){showToast('Erro: '+(e.code||e.message));return;}closeModal();navigate('diligencias');showToast('Aprovada e enviada à fila.');}
function reprovar(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;showModal('<div class="modal-title">Reprovar / Devolver</div><div style="font-size:12px;color:var(--mt)">'+esc(d.proc||'')+'</div><div style="font-weight:600;margin-bottom:10px">'+esc(d.tipo||'—')+'</div><div class="fg"><label>Justificativa de devolução (obrigatória)</label><textarea id="rp-j" rows="3"></textarea></div><div style="text-align:right;margin-top:10px"><button class="btn" onclick="closeModal()">Cancelar</button> <button class="btn bp" style="background:var(--red);border-color:var(--red)" onclick="reprovarOk(\''+id+'\')">↩️ Devolver</button></div>');}
async function reprovarOk(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;var j=(document.getElementById('rp-j').value||'').trim();if(!j){showToast('Informe a justificativa.');return;}d.fase='devolvida';d.justificativaDevolucao=j;d.destino='advogado';d.advId=d.advId||diligAdvIdPorNome(d.adv);hist(d,'Reprovada/Devolvida ao advogado — '+j,'reprovacao');try{await saveDiligencia(d);}catch(e){showToast('Erro: '+(e.code||e.message));return;}closeModal();navigate('diligencias');showToast('Devolvida ao advogado.');}
function corrigir(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;var cat=d.tipoCat||'Outros';showModal('<div class="modal-title">Corrigir e reenviar</div><div class="card" style="background:var(--redl);border-color:var(--red);font-size:12px;padding:10px 13px;margin-bottom:12px"><b>Motivo:</b> '+esc(d.justificativaDevolucao||'—')+'</div><div class="fg"><label>Tipo de demanda</label>'+tipoOptsDilig('cr-tipo',cat)+'</div><div class="fg" id="cr-ow" style="display:'+(cat==='Outros'?'block':'none')+'"><label>Detalhe (Outros)</label><input id="cr-o" value="'+esc(d.tipoDetalhe||'')+'"/></div><div class="fg"><label>O que foi corrigido</label><textarea id="cr-n" rows="3"></textarea></div><div style="text-align:right;margin-top:10px"><button class="btn" onclick="closeModal()">Cancelar</button> <button class="btn bp" onclick="corrigirOk(\''+id+'\')">Reenviar</button></div>');document.getElementById('cr-tipo').onchange=function(){document.getElementById('cr-ow').style.display=this.value==='Outros'?'block':'none';};}
async function corrigirOk(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;var cat=document.getElementById('cr-tipo').value,o=(document.getElementById('cr-o')&&document.getElementById('cr-o').value||'').trim(),n=(document.getElementById('cr-n').value||'').trim();d.tipoCat=cat;d.tipo=cat==='Outros'?(o||'Outros'):cat;d.tipoDetalhe=cat==='Outros'?o:'';d.fase='aprovacao';d.destino=null;hist(d,'Advogado corrigiu e reenviou para aprovação.'+(n?' '+n:''),'correcao');try{await saveDiligencia(d);}catch(e){showToast('Erro: '+(e.code||e.message));return;}closeModal();navigate('diligencias');showToast('Reenviada para aprovação.');}
function alvaraParcial(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;showModal('<div class="modal-title">Alvará parcial recebido</div><div style="font-size:12px;color:var(--mt);margin-bottom:8px">A diligência será <b>concluída</b> e uma tarefa vai ao advogado <b>'+esc(d.adv||'')+'</b> verificar <b>saldo remanescente</b>.</div><div class="fg"><label>Valor recebido no alvará parcial (opcional)</label><input id="ap-val" type="number" step="0.01" placeholder="0,00"/></div><div class="fg"><label>Observação (opcional)</label><textarea id="ap-o2" rows="2"></textarea></div><div style="text-align:right;margin-top:8px"><button class="btn" onclick="closeModal()">Cancelar</button> <button class="btn bp" onclick="alvaraParcialOk(\''+id+'\')">Concluir e enviar ao advogado</button></div>');}
async function alvaraParcialOk(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;var val=parseFloat(document.getElementById('ap-val').value)||0,o=(document.getElementById('ap-o2').value||'').trim();
  d.cumprida=true;d.fase='concluida';d.dataCumprimento=todayStr();d.diasCumprimento=diligDiasEntre(d.dataInicio||d.dataRealizacao||todayStr(),todayStr());d.destino='advogado';d.advId=d.advId||diligAdvIdPorNome(d.adv);d.obs=(d.obs?d.obs+' · ':'')+'Alvará PARCIAL recebido'+(val?' ('+fmt(val)+')':'')+(o?' — '+o:'')+'.';hist(d,'Alvará PARCIAL recebido'+(val?' ('+fmt(val)+')':'')+' — concluída. Gerada tarefa ao advogado (saldo remanescente).','liquidacao');
  var nova={proc:d.proc,trib:d.trib,uf:d.uf,orig:d.orig,comarca:d.comarca,vara:d.vara,adv:d.adv,advId:d.advId||diligAdvIdPorNome(d.adv),criadorId:d.criadorId||null,tipo:'Diligenciar saldo remanescente',tipoCat:'Diligenciar saldo remanescente',tipoDetalhe:'',materia:d.materia,resp:d.resp,valor:d.valor,obs:'Gerada por alvará parcial. Verificar saldo remanescente.',fase:'advogado',destino:'advogado',tarefaAdvogado:'Verificar existência de saldo remanescente após o alvará parcial'+(val?' (parcial recebido: '+fmt(val)+')':'')+'.',dataInicio:null,dataRealizacao:null,dataVerificar:null,ciclos:[],cumprida:false,dataCumprimento:null,diasCumprimento:null,historico:[]};
  hist(nova,'Tarefa criada por alvará parcial — enviada ao advogado '+(d.adv||'')+' para verificar saldo remanescente.','advogado');
  try{await saveDiligencia(d);await saveDiligencia(nova);}catch(e){showToast('Erro: '+(e.code||e.message));return;}closeModal();navigate('diligencias');showToast('Concluída (alvará parcial). Tarefa enviada ao advogado.');}
function devolverLiq(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;showModal('<div class="modal-title">Devolver ao advogado — liquidação</div><div class="fg"><label>Tipo</label><select id="lq-t"><option>Resolução por liquidação (Total)</option><option>Liquidação Parcial</option></select></div><div class="fg"><label>Observação ao advogado</label><textarea id="lq-o" rows="3"></textarea></div><div style="text-align:right;margin-top:8px"><button class="btn" onclick="closeModal()">Cancelar</button> <button class="btn bp" onclick="devolverLiqOk(\''+id+'\')">Devolver</button></div>');}
async function devolverLiqOk(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;var t=document.getElementById('lq-t').value,o=(document.getElementById('lq-o').value||'').trim();d.fase='concluida';d.cumprida=true;d.dataCumprimento=todayStr();d.diasCumprimento=diligDiasEntre(d.dataInicio||d.dataRealizacao||todayStr(),todayStr());d.destino='advogado';d.advId=d.advId||diligAdvIdPorNome(d.adv);if(o)d.obs=(d.obs?d.obs+' · ':'')+o;hist(d,'Devolvida ao advogado — '+t+'.'+(o?' '+o:''),'liquidacao');try{await saveDiligencia(d);}catch(e){showToast('Erro: '+(e.code||e.message));return;}closeModal();navigate('diligencias');showToast('Devolvida ao advogado.');}
function enviarAdv(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;showModal('<div class="modal-title">Enviar ao advogado para realizar tarefa</div><div class="fg"><label>Advogado responsável pela tarefa</label><select id="ea-adv">'+diligLawyerOpts(d.adv||'')+'</select></div><div class="fg"><label>Tarefa — o que o advogado precisa fazer (obrigatório)</label><textarea id="ea-t" rows="3"></textarea></div><div style="text-align:right;margin-top:8px"><button class="btn" onclick="closeModal()">Cancelar</button> <button class="btn bp" onclick="enviarAdvOk(\''+id+'\')">📨 Enviar ao advogado</button></div>');}
async function enviarAdvOk(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;var adv=document.getElementById('ea-adv').value,t=(document.getElementById('ea-t').value||'').trim();if(!adv){showToast('Selecione o advogado.');return;}if(!t){showToast('Descreva a tarefa.');return;}d.fase='advogado';d.adv=adv;d.advId=diligAdvIdPorNome(adv);d.destino='advogado';d.tarefaAdvogado=t;d.obs=(d.obs?d.obs+' · ':'')+'Tarefa ao advogado: '+t;hist(d,'Enviada ao advogado '+adv+' para realizar tarefa: '+t,'advogado');try{await saveDiligencia(d);}catch(e){showToast('Erro: '+(e.code||e.message));return;}closeModal();navigate('diligencias');showToast('Enviada ao advogado. Saiu da fila.');}
function tarefaConcluir(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;showModal('<div class="modal-title">Concluir tarefa e devolver à equipe</div><div class="card" style="background:var(--bluel);border-color:var(--blue);font-size:12px;padding:10px 13px;margin-bottom:12px"><b>Tarefa:</b> '+esc(d.tarefaAdvogado||'—')+'</div><div class="fg"><label>O que foi feito (opcional)</label><textarea id="tc-n" rows="3"></textarea></div><div style="display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px;margin-top:8px"><button class="btn" onclick="closeModal()">Cancelar</button> <button class="btn" style="background:var(--greenl);color:var(--green);border-color:var(--green)" onclick="tarefaConcluidaAdv(\''+id+'\')">✔ Concluída por mim (não devolver)</button> <button class="btn bp" onclick="tarefaConcluirOk(\''+id+'\')">↩️ Concluir e devolver à equipe</button></div>');}
async function tarefaConcluirOk(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;var n=(document.getElementById('tc-n').value||'').trim();var t=d.tarefaAdvogado;d.tarefaAdvogado='';d.fase='fila';d.destino=null;d.dataRealizacao=todayStr();d.dataVerificar=diligAddDias(todayStr(),diligPrazoDias());hist(d,'Advogado concluiu a tarefa'+(t?' ("'+t+'")':'')+' e devolveu à equipe.'+(n?' '+n:''),'andamento');try{await saveDiligencia(d);}catch(e){showToast('Erro: '+(e.code||e.message));return;}closeModal();navigate('diligencias');showToast('Tarefa concluída. Devolvida à fila.');}
function histModal(id){var d=S.diligencias.find(function(x){return x.id===id;});if(!d)return;var linhas=(d.historico||[]).slice().sort(function(a,b){return String(a.ts).localeCompare(String(b.ts));}).map(function(h){var cor=h.tag==='reprovacao'?'var(--red)':(h.tag==='aprovacao'?'var(--green)':(h.tag==='liquidacao'||h.tag==='advogado'?'var(--blue)':'var(--v)'));return '<div style="border-left:3px solid '+cor+';padding:4px 0 8px 10px"><div style="font-size:11px;color:var(--mt)">'+fmtTs(h.ts)+' · <b>'+esc(h.autor)+'</b> ('+esc(h.papel)+')</div><div style="font-size:13px">'+esc(h.texto)+'</div></div>';}).join('')||'<div class="empty">Sem registros.</div>';showModal('<div class="modal-title">Histórico da diligência</div><div style="font-size:11px;color:var(--mt)">'+esc(d.proc||'')+'</div><div style="font-weight:600;margin-bottom:10px">'+esc(d.tipo||'—')+'</div><div style="max-height:340px;overflow:auto">'+linhas+'</div><div style="margin-top:14px;text-align:right"><button class="btn bp" onclick="closeModal()">Fechar</button></div>');}
function modalEditDilig(id){
  var d=S.diligencias.find(function(x){return x.id===id;}); if(!d)return;
  showModal('<div class="modal-title">Editar Diligência</div>'+
    '<div class="fg" style="margin-bottom:10px"><label>Processo (CNJ)</label><input id="ed-proc" value="'+esc(d.proc||'')+'"/></div>'+
    '<div style="display:flex;gap:10px"><div class="fg" style="flex:1"><label>Advogado</label><select id="ed-adv">'+diligLawyerOpts(d.adv||'')+'</select></div>'+
    '<div class="fg" style="flex:1"><label>Responsável</label><select id="ed-resp">'+diligLawyerOpts(d.resp||'')+'</select></div></div>'+
    '<div style="display:flex;gap:10px;margin-top:10px"><div class="fg" style="flex:2"><label>Diligência</label><input id="ed-tipo" value="'+esc(d.tipo||'')+'"/></div>'+
    '<div class="fg" style="flex:1"><label>Matéria</label>'+materiaSelectHTML('ed-materia',d.materia||'')+'</div></div>'+
    '<div style="display:flex;gap:10px;margin-top:10px"><div class="fg" style="flex:1"><label>Valor (R$)</label><input id="ed-valor" type="number" step="0.01" value="'+(d.valor||0)+'"/></div>'+
    '<div class="fg" style="flex:1"><label>Comarca</label><input id="ed-comarca" value="'+esc(d.comarca||'')+'"/></div>'+
    '<div class="fg" style="flex:1"><label>Vara</label><input id="ed-vara" value="'+esc(d.vara||'')+'"/></div>'+
    '<div class="fg" style="flex:1"><label>Prazo</label>'+prazoSelectHTML('ed-prazo',diligPrazoDe(d))+'</div></div>'+
    '<div class="fg" style="margin-top:10px"><label>Observações</label><textarea id="ed-obs" rows="2">'+esc(d.obs||'')+'</textarea></div>'+
    (d.cumprida?'<label style="display:flex;align-items:center;gap:7px;margin-top:8px;font-size:13px"><input type="checkbox" id="ed-reabrir"/> Reabrir (desfazer cumprimento)</label>':'')+
    '<div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="salvarEditDilig(\''+id+'\')">Salvar</button></div>');
}
async function salvarEditDilig(id){
  var d=S.diligencias.find(function(x){return x.id===id;}); if(!d)return;
  var proc=document.getElementById('ed-proc').value.trim(); var p=diligParseCNJ(proc);
  d.proc=proc; if(p.trib){d.trib=p.trib; d.uf=p.uf; d.orig=p.orig;}
  d.adv=document.getElementById('ed-adv').value;
  d.resp=document.getElementById('ed-resp').value; d.respId=diligRespId(d.resp);
  d.tipo=document.getElementById('ed-tipo').value.trim();
  d.materia=document.getElementById('ed-materia').value;
  d.valor=parseFloat(document.getElementById('ed-valor').value)||0;
  d.comarca=document.getElementById('ed-comarca').value.trim();
  d.vara=document.getElementById('ed-vara').value.trim();
  d.obs=document.getElementById('ed-obs').value.trim();
  var novoPrazo=diligPrazoInputVal('ed-prazo',diligPrazoDe(d));
  var prazoMudou=(novoPrazo!==diligPrazoDe(d)); d.prazoDias=novoPrazo;
  var reab=document.getElementById('ed-reabrir');
  if(reab && reab.checked){ d.cumprida=false; d.fase='fila'; d.dataCumprimento=null; d.diasCumprimento=null; d.dataVerificar=d.dataRealizacao?diligAddDias(d.dataRealizacao,novoPrazo):null; }
  else if(prazoMudou && d.dataRealizacao && !d.cumprida){ d.dataVerificar=diligAddDias(d.dataRealizacao,novoPrazo); }
  try{ await saveDiligencia(d); }catch(e){ showToast('Erro: '+(e.code||e.message)); return; }
  closeModal(); navigate('diligencias'); showToast('Diligência atualizada.');
}
function deleteDilig(id){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode excluir.'); return; }
  showModal('<div class="modal-title">Excluir diligência?</div><p style="font-size:13px;color:var(--mt)">Esta ação não pode ser desfeita.</p><div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" style="background:var(--red);border-color:var(--red)" onclick="confirmDeleteDilig(\''+id+'\')">Excluir</button></div>');
}
async function confirmDeleteDilig(id){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode excluir.'); return; }
  try{ await deleteDiligenciaDoc(id); S.diligencias=S.diligencias.filter(function(x){return x.id!==id;}); }catch(e){ showToast('Erro: '+(e.code||e.message)); return; }
  closeModal(); navigate('diligencias'); showToast('Diligência excluída.');
}
function modalConfigPrazo(){
  showModal('<div class="modal-title">Prazo de acompanhamento</div>'+
    '<p style="font-size:13px;color:var(--mt)">Dias após a realização da diligência até ela reaparecer para verificação.</p>'+
    '<div class="fg" style="max-width:140px"><label>Dias</label><input id="cp-dias" type="number" min="1" value="'+diligPrazoDias()+'"/></div>'+
    '<div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="salvarConfigPrazo()">Salvar</button></div>');
}
async function salvarConfigPrazo(){
  var n=parseInt(document.getElementById('cp-dias').value,10); if(!n||n<1){showToast('Valor inválido.');return;}
  S.diligPrazoDias=n;
  try{ await fb.setDoc(fb.doc(fb.db,'config','diligencias'), {prazoDias:n, updatedAt:fb.serverTimestamp(), updatedBy:currentUser.id}, {merge:true}); }catch(e){ showToast('Erro: '+(e.code||e.message)); return; }
  closeModal(); navigate('diligencias'); showToast('Prazo definido em '+n+' dias.');
}

// ── IMPORTAÇÃO DA PLANILHA (aba Diligências) ─────────────────
function diligParseValor(v){
  if(v==null||v==='') return 0;
  if(typeof v==='number') return Math.round(v*100)/100;
  var s=String(v).replace(/r\$/i,'').trim().replace(/\./g,'').replace(',','.');
  var n=parseFloat(s); return isNaN(n)?0:Math.round(n*100)/100;
}
function diligParseData(v){
  if(!v) return null;
  if(v instanceof Date && !isNaN(v)) return v.toISOString().slice(0,10);
  var s=String(v).trim();
  var m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})$/);
  if(m){ var y=m[3].length===2?('20'+m[3]):m[3]; return y+'-'+('0'+m[2]).slice(-2)+'-'+('0'+m[1]).slice(-2); }
  if(/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0,10);
  return null;
}
function diligIsCNJ(v){ var d=String(v||'').replace(/\D/g,''); return d.length===20 && String(v).indexOf('-')>=0; }
function modalImportarDiligencias(){
  showModal('<div class="modal-title">Importar diligências da planilha</div>'+
    '<p style="font-size:13px;color:var(--mt);margin-bottom:4px">Selecione um arquivo <b>.xlsx</b>. O sistema lê a aba <b>"Diligências"</b> e identifica automaticamente tribunal e estado pelo número CNJ.</p>'+
    '<p style="font-size:12px;color:var(--mt);margin-bottom:14px">Advogado e responsável são casados com o cadastro de advogados pelo nome. Linhas com data de realização <i>e</i> responsável já entram em acompanhamento.</p>'+
    '<div class="fg" style="margin-bottom:14px"><label>Como importar</label>'+
      '<label style="display:flex;align-items:center;gap:7px;font-size:13px;margin-top:4px"><input type="radio" name="imp-modo" value="substituir" checked/> Substituir tudo (apaga as diligências atuais)</label>'+
      '<label style="display:flex;align-items:center;gap:7px;font-size:13px;margin-top:4px"><input type="radio" name="imp-modo" value="adicionar"/> Adicionar às existentes</label>'+
    '</div>'+
    '<input type="file" id="imp-file" accept=".xlsx,.xls" style="font-size:13px"/>'+
    '<div id="imp-status" style="font-size:12px;color:var(--mt);margin-top:10px"></div>'+
    '<div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn bp" onclick="importarDiligenciasArquivo()">Importar</button></div>');
}
function importarDiligenciasArquivo(){
  if(!isFullAccess(currentUser)){ showToast('Apenas o administrador pode importar.'); return; }
  var inp=document.getElementById('imp-file');
  var st=document.getElementById('imp-status');
  if(!inp.files||!inp.files.length){ st.textContent='Selecione um arquivo primeiro.'; st.style.color='var(--red)'; return; }
  var modo=(document.querySelector('input[name="imp-modo"]:checked')||{}).value||'substituir';
  st.style.color='var(--mt)'; st.textContent='Lendo planilha...';
  var reader=new FileReader();
  reader.onload=async function(e){
    try{
      if(typeof XLSX==='undefined'){ st.textContent='Biblioteca de leitura não carregou. Recarregue a página.'; st.style.color='var(--red)'; return; }
      var wb=XLSX.read(e.target.result,{type:'array',cellDates:true});
      var nome=wb.SheetNames.find(function(n){ return n.toLowerCase().indexOf('dilig')===0; });
      if(!nome) nome=wb.SheetNames.find(function(n){ return n.toLowerCase().indexOf('dilig')>=0 && n.toLowerCase().indexOf('conclu')<0; });
      if(!nome){ st.textContent='Não encontrei aba "Diligências". Abas: '+wb.SheetNames.join(', '); st.style.color='var(--red)'; return; }
      var rows=XLSX.utils.sheet_to_json(wb.Sheets[nome],{header:1,defval:''});
      var secao='', novas=[], prazo=diligPrazoDias();
      rows.forEach(function(r){
        var c0=String(r[0]==null?'':r[0]).trim();
        if(!c0) return;
        if(!diligIsCNJ(c0)){
          var preenchidas=r.filter(function(x){return String(x==null?'':x).trim()!=='';}).length;
          if(preenchidas<=2 && c0.toUpperCase()===c0) secao=c0;
          return;
        }
        var p=diligParseCNJ(c0);
        var dt=diligParseData(r[5]);
        var resp=diligMatchLawyer(r[4]);
        var feita=!!(dt && resp);
        var novD={
          id:fb.doc(fb.collection(fb.db,'diligencias')).id, proc:c0, trib:p.trib||String(r[1]||'').trim(), uf:p.uf, orig:p.orig,
          comarca:'', vara:'',
          adv:diligMatchLawyer(r[2]), tipo:String(r[3]||'').trim(), tipoCat:String(r[3]||'').trim(), tipoDetalhe:'',
          resp:resp, respId:diligRespId(resp), criadorId:null,
          valor:diligParseValor(r[6]), obs:String(r[7]||'').trim(), secao:secao,
          fase:'fila',
          dataInicio: feita?dt:null, dataRealizacao: feita?dt:null,
          dataVerificar: feita?diligAddDias(dt,prazo):null,
          ciclos: feita?[{data:dt,resp:resp,obs:String(r[7]||'').trim()}]:[],
          cumprida:false, dataCumprimento:null, diasCumprimento:null, historico:[]
        };
        hist(novD,'Importada via planilha.','criacao');
        novas.push(novD);
      });
      if(!novas.length){ st.textContent='Nenhuma diligência com número CNJ válido na aba "'+nome+'".'; st.style.color='var(--red)'; return; }
      st.textContent='Gravando '+novas.length+' diligências...';
      // substituir: apaga as atuais em lote
      if(modo==='substituir'){
        var atuais=S.diligencias||[], b=fb.writeBatch(fb.db), k=0;
        for(var i=0;i<atuais.length;i++){ b.delete(fb.doc(fb.db,'diligencias',atuais[i].id)); k++; if(k%400===0){ await b.commit(); b=fb.writeBatch(fb.db); } }
        if(k%400!==0) await b.commit();
      }
      // grava as novas em lote
      var b2=fb.writeBatch(fb.db), n2=0;
      for(var j=0;j<novas.length;j++){
        var d=novas[j];
        b2.set(fb.doc(fb.db,'diligencias',d.id), Object.assign({},d,{createdAt:fb.serverTimestamp(),createdBy:currentUser.id,updatedAt:fb.serverTimestamp(),updatedBy:currentUser.id}));
        n2++; if(n2%400===0){ await b2.commit(); b2=fb.writeBatch(fb.db); }
      }
      if(n2%400!==0) await b2.commit();
      S.diligencias=await fetchCollection('diligencias');
      closeModal(); navigate('diligencias');
      showToast(novas.length+' diligências importadas da aba "'+nome+'".');
    }catch(err){ st.textContent='Erro ao importar: '+(err.code||err.message); st.style.color='var(--red)'; }
  };
  reader.readAsArrayBuffer(inp.files[0]);
}

