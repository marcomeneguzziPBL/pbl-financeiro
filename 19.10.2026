  var ch = await calcFetch('/calculos/'+_calcId);
  if(!ch.ok || !ch.data){ wrap.innerHTML='<div class="empty" style="padding:16px;color:var(--red)">Falha ao carregar o cálculo (status '+ch.status+').</div>'; return; }
  var ll = await calcFetch('/calculos/'+_calcId+'/lancamentos');
