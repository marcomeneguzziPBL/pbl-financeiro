    </div>
    <div class="hdr-right">
      <span class="hdr-period" id="period-lbl"></span>
      <select id="periodo-mode" onchange="updPeriod();saveData()" style="padding:5px 9px;border-radius:6px;border:none;font-size:12px;background:rgba(255,255,255,.18);color:#fff;outline:none;cursor:pointer">
        <option value="mes">Mês</option>
        <option value="ano">Ano</option>
        <option value="custom">Personalizado</option>
      </select>
      <input type="month"  id="periodo-mes"  oninput="updPeriod();saveData()" style="display:none"/>
      <input type="number" id="periodo-ano"  min="2000" max="2100" oninput="updPeriod();saveData()" style="display:none;width:90px"/>
      <input type="date"   id="periodo-di"   oninput="updPeriod();saveData()" style="display:none"/>
      <input type="date"   id="periodo-df"   oninput="updPeriod();saveData()" style="display:none"/>
      <button class="btn-calc" id="btn-calc-main" onclick="recalc()" style="display:none">⚡ Calcular</button>
      <span class="hdr-user" id="hdr-user"></span>
      <button class="btn-logout" onclick="toggleTheme()" id="btn-theme" title="Alternar tema" style="font-size:14px">🌙</button>
      <button class="btn-logout" onclick="doLogout()">Sair</button>
    </div>
  </div>
  <div class="body-area">
    <nav class="sidebar" id="sidebar"></nav>
    <div class="main" id="main-content"></div>
  </div>
</div>

<div class="toast" id="toast"></div>
<div id="modal-root"></div>

<script>
// ════════════════════════════════════════════════════════════
// AUTH — Google OAuth + Firestore users/{uid}
// ────────────────────────────────────────────────────────────
// Roles (stored in Firestore users/{uid}.role):
//   admin           → acesso total (administrador do sistema)
//   gestora         → dashboard, validações, processos, operacional, campanhas,
//                     comissões por adv. (todos), comissões por gestora (só a propria) — Margie / Jeanne
//   supervisora     → Principal completo + Comissões por Adv (travada nela)
//   lawyer          → Principal read-only + Comissões por Adv (travada nele) + Notificações
// ════════════════════════════════════════════════════════════
// Helpers de permissão
function isAdmin(u){return u && u.role==='admin';}
function isFullAccess(u){return u && u.role==='admin';}
function isGestora(u){return u && u.role==='gestora';}
// Venda ao FIDC: APENAS papel admin (decisão do usuário em 30/09). Antes era por regex de
// NOME — /\bevilyn\b/ ou /\bmarco\b/ — com dois defeitos: qualquer "Marco Antônio" ou
// "Marcos" que entrasse ganhava o poder de ceder crédito, e quem trocasse o nome de exibição
// perdia o acesso em silêncio. A flag permissions.canVenderFidc também saiu: ninguém a usava e
// ela ofereceria o botão a quem a regra do Firestore rejeita.
//
// Alinhamento, não restrição: firestore.rules já exigia isFullAccess() para mexer em
// vendidoFidc/valorVendaFidc/dataVendaFidc/vendasFidc. A UI é que estava mais permissiva que a
// regra — Evilyn e Marco só funcionavam porque ambos já são admin.
function canVenderFidc(u){ return isFullAccess(u); }
// Funções secundárias (múltiplas): cada uma exige um role primário específico.
var SEC_ROLES_DEF=[
  {key:'gestora',    label:'Gestora',                              role:'admin'},
  {key:'calculo_cs', label:'Perito Contábil (Cálculo de Cumprimento de Sentença)', role:'lawyer'},
  {key:'controller', label:'Controller de Diligências', role:'lawyer'}
];
function secRolesOf(u){ if(!u) return []; if(Array.isArray(u.secondaryRoles)) return u.secondaryRoles; return u.secondaryRole?[u.secondaryRole]:[]; }
function hasSecRole(u,key){ return secRolesOf(u).indexOf(key)>=0; }
function secRoleLabel(key){ var o=SEC_ROLES_DEF.find(function(x){return x.key===key;}); return o?o.label:key; }
// Advogado coringa "Outros" (placeholder): aparece nos selects (por último) mas NÃO gera comissão.
function isPlaceholderLawyer(l){ return !!(l && (l.placeholder===true || (l.name||'').trim().toLowerCase()==='outros')); }
// Mantém a ordem atual dos advogados normais e joga os placeholders ("Outros") para o fim.
function ordenaLawyers(arr){ var normais=[], outros=[]; (arr||[]).forEach(function(l){ (isPlaceholderLawyer(l)?outros:normais).push(l); }); return normais.concat(outros); }
// Lista de advogados que entram no cálculo de comissão (exclui placeholders).
function lawyerAtivo(l){
  if(!l) return false;
  if(l.active===false) return false;
  var u=(S.users||[]).find(function(x){return x.lawyerId===l.id;});
  if(u && u.active===false) return false;
  return true;
}
function lawyersComissao(){ return (S.lawyers||[]).filter(function(l){ return !isPlaceholderLawyer(l) && lawyerAtivo(l); }); }
// Quem pode escrever na Aba Principal (processos, validações). Liquidações tem regra própria.
function canWritePrincipal(u){return u && (u.role==='admin' || u.role==='gestora' || u.role==='supervisora' || u.role==='lawyer' || u.role==='gestor_calculos' || u.role==='juridico' || u.role==='comercial');}
// Processos (carteira, painel do processo, documentos, recebimentos): os papéis da Aba Principal + o perito
// contábil, que trabalha nos processos sem operar leads nem validações (06/10). Espelha a regra de /processos.
function canWriteProcessos(u){return canWritePrincipal(u) || !!(u && u.role==='perito_contabil');}
// Quem pode escrever em Liquidações (reliquidados/liquidacoes) — lawyer NÃO.
function canWriteLiquidacoes(u){return u && (u.role==='admin' || u.role==='gestora' || u.role==='supervisora' || u.role==='gestor_calculos');}
// Quem pode EXCLUIR liquidações — admin, gestora e supervisora.
function canDeleteLiquidacoes(u){return u && (u.role==='admin' || u.role==='gestora' || u.role==='supervisora' || u.role==='gestor_calculos');}
function canViewGN(u, scope){
  if(!u) return false;
  // Admin sempre tem acesso total (scope='all' implícito).
  if(isFullAccess(u)){
    if(!scope) return true;
    return scope === 'all';
  }
  // Demais roles dependem das flags em permissions.
  if(!u.permissions) return false;
  if(u.permissions.canViewGeracaoNegocios !== true) return false;
  if(!scope) return true;
  return u.permissions.geracaoNegociosScope === scope;
}

var AVC=[{bg:'#DDE9E7',c:'#063D38'},{bg:'#FDF6E3',c:'#7a5800'},{bg:'#EEF3FB',c:'#185FA5'},{bg:'#FCEBEB',c:'#A32D2D'},{bg:'#F0EFF9',c:'#534AB7'},{bg:'#E6F4EC',c:'#1D6B3A'},{bg:'#FFF0F3',c:'#993556'},{bg:'#F4F0FF',c:'#3C3489'}];
var PC=['#063D38','#B8860B','#2E6DB4','#A32D2D','#534AB7','#1D6B3A','#993556','#3C3489','#854F0B','#185FA5'];

// ── STATE ──────────────────────────────────────────────────
var S={
  agenda:[],
  skillObs:[],
  notif1:[],
  gnDilig:[],
  lawyers:[],gestoras:[],entries:{},campanhas:[],
  mes:new Date().toISOString().slice(0,7),
  // Período de filtragem aplicado em dashboards/comissões. mode = 'mes' | 'ano' | 'custom'.
  // Mantém S.mes em sincronia com periodo.mes para retrocompat (chaves em /gestorasMetas).
  periodo:{
    mode:'mes',
    mes:new Date().toISOString().slice(0,7),
    ano:new Date().getFullYear(),
    dataIni:'',
    dataFim:''
  },
  dashData:null,
  processos:[],
  leads:[],
  liqManual:[],
  distribValidacao:[],
  // financeiro: [{id,tipo:'compra'|'venda'|'despesa',data,descricao,valor,banco,processoId,categoria,obs}]
  financeiro:[],
  // contas: [{id,nome,banco,agencia,conta,titular,entidade:'PBL'|'FIDC'|'CERTJUD',tipo:'operacional'|'vinculada',saldoInicial,dataSaldoInicial,ativa}]
  contas:[],
  notificacoes:[],
  partes:[],
  analisesIA:[],
};
var currentUser=null;
